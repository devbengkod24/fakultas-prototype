{"nodes": [{"id": "docs_spec_readme_spesifikasi_teknis_mbkm_v2", "label": "Spesifikasi Teknis MBKM V2 (Index)", "file_type": "document", "source_file": "docs/spec/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Spec set derived from the 25 October 2026 prototype evaluation coordination meeting and business-flow alignment with the MBKM Coordinator and development team."}, {"id": "docs_spec_readme_enam_prinsip_kunci_revisi", "label": "6 Prinsip Kunci Revisi", "file_type": "concept", "source_file": "docs/spec/README.md", "source_location": "\ud83c\udfaf 6 Prinsip Kunci Revisi", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_readme_pemisahan_flow_dan_state_machine", "label": "Pemisahan Alur (Flow) dan State Machine", "file_type": "rationale", "source_file": "docs/spec/README.md", "source_location": "\ud83c\udfaf 6 Prinsip Kunci Revisi #1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Separating 'who does what, in what order' from 'which data states are legal and what guards transitions' into two independent files prevents logic confusion between development team members."}, {"id": "docs_spec_readme_pergeseran_pakta_integritas", "label": "Pergeseran Posisi Pakta Integritas Formal", "file_type": "rationale", "source_file": "docs/spec/README.md", "source_location": "\ud83c\udfaf 6 Prinsip Kunci Revisi #2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Initial registration (Stage 3) is only general-terms consent via checkbox; formal signing is deferred to post-acceptance by partner/supervisor before SKS conversion, so students are not bound to legal documents for programs they may never join."}, {"id": "docs_spec_readme_dualitas_pakta", "label": "Dualitas Pakta (General vs Kontributor Generated)", "file_type": "concept", "source_file": "docs/spec/README.md", "source_location": "\ud83c\udfaf 6 Prinsip Kunci Revisi #3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The contributor pacta is generated dynamically from the student profile and partner clauses so it carries legally specific force, unlike a static general consent checkbox."}, {"id": "docs_spec_readme_krs_gatekeeper_dospem", "label": "KRS Siadin sebagai Gatekeeper Penetapan Dosen Pembimbing", "file_type": "concept", "source_file": "docs/spec/README.md", "source_location": "\ud83c\udfaf 6 Prinsip Kunci Revisi #4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Partner selection results must be announced before the KRS period; a supervisor can only be assigned after course conversion reaches KRS_LOCKED_VERIFIED, so supervision always maps to courses actually taken."}, {"id": "docs_spec_readme_hicks_law_navigasi_mahasiswa", "label": "Penyederhanaan Navigasi Mahasiswa (Hick's Law)", "file_type": "rationale", "source_file": "docs/spec/README.md", "source_location": "\ud83c\udfaf 6 Prinsip Kunci Revisi #5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Removing the 'Dosen Pembimbing' sidebar item and merging it into a dashboard card (with official WAG link replacing personal WA contact) reduces menu items, per Hick's Law reducing decision time; Sidang Evaluasi stays a single menu with 2 sub-tabs."}, {"id": "docs_spec_readme_visibilitas_dospem_kontributor", "label": "Visibilitas Dosen Pembimbing di Profil Kontributor", "file_type": "concept", "source_file": "docs/spec/README.md", "source_location": "\ud83c\udfaf 6 Prinsip Kunci Revisi #6", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_spec_readme_spesifikasi_teknis_mbkm_v2", "target": "docs_spec_01_flow_mbkm_golden_flow", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/