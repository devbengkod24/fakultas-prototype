{"nodes": [{"id": "docs_spec_03_antarmuka_dan_navigasi_role", "label": "Spesifikasi Antarmuka & Navigasi Per Role", "file_type": "document", "source_file": "docs/spec/03-antarmuka-dan-navigasi-role.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_03_antarmuka_dan_navigasi_role_sidang_evaluasi_dual_tab", "label": "Sidang Evaluasi: 1 Menu dengan 2 Tab", "file_type": "concept", "source_file": "docs/spec/03-antarmuka-dan-navigasi-role.md", "source_location": "\u00a71.1 Restrukturisasi Menu Sidang Evaluasi", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The student sidebar already holds 11 items; adding separate 'Pengajuan Sidang' and 'Hasil Sidang' level-1 items would violate Hick's Law and force vertical scroll, reducing usability, so one parent menu with two tabs is used."}, {"id": "docs_spec_03_antarmuka_dan_navigasi_role_tab_pengajuan_sidang", "label": "Tab 1: Pengajuan Sidang", "file_type": "concept", "source_file": "docs/spec/03-antarmuka-dan-navigasi-role.md", "source_location": "\u00a71.1 Spesifikasi Tab 1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_03_antarmuka_dan_navigasi_role_tab_jadwal_hasil_sidang", "label": "Tab 2: Jadwal & Hasil Sidang", "file_type": "concept", "source_file": "docs/spec/03-antarmuka-dan-navigasi-role.md", "source_location": "\u00a71.1 Spesifikasi Tab 2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_03_antarmuka_dan_navigasi_role_bobot_penilaian_sidang", "label": "Bobot Penilaian Sidang (Dospem 40% / Penguji Mandiri 60%)", "file_type": "concept", "source_file": "docs/spec/03-antarmuka-dan-navigasi-role.md", "source_location": "\u00a71.1 Spesifikasi Tab 2 #3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_03_antarmuka_dan_navigasi_role_kartu_dospem_dashboard", "label": "Kartu Dosen Pembimbing di Dashboard Mahasiswa", "file_type": "concept", "source_file": "docs/spec/03-antarmuka-dan-navigasi-role.md", "source_location": "\u00a71.2 Dosen Pembimbing di Dashboard Mahasiswa", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Menu Dosen Pembimbing (/mahasiswa/dosen-pembimbing) is removed from the sidebar; the information moves to the main dashboard card so the student sees it in the place they already land."}, {"id": "docs_spec_03_antarmuka_dan_navigasi_role_komponen_grup_whatsapp", "label": "Komponen Grup WhatsApp Bimbingan", "file_type": "concept", "source_file": "docs/spec/03-antarmuka-dan-navigasi-role.md", "source_location": "\u00a71.2 State Aktif", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A group invite link replaces the personal phone number so coordination is institutional and does not expose a lecturer's private contact."}, {"id": "docs_spec_03_antarmuka_dan_navigasi_role_kontributor_detail_tab_dospem", "label": "KontributorDetail: Tab Mahasiswa & Dospem", "file_type": "concept", "source_file": "docs/spec/03-antarmuka-dan-navigasi-role.md", "source_location": "\u00a72.1 Menu Kontributor: Pemetaan Dosen Pembimbing", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Coordinators need fast visibility of which faculty supervisors accompany students at each partner; a joined relation table (NIM, student, position, supervisor, supervision status badge) answers that in one view."}, {"id": "docs_spec_03_antarmuka_dan_navigasi_role_cms_dropzone_upload", "label": "CMS Kontributor: Dropzone Upload Foto Profil & Banner", "file_type": "concept", "source_file": "docs/spec/03-antarmuka-dan-navigasi-role.md", "source_location": "\u00a72.2 CMS Kontributor", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Raw URL text input forced admins to host images externally first; a drag-and-drop uploader with URL.createObjectURL instant preview removes that dependency without requiring backend support."}, {"id": "docs_spec_03_antarmuka_dan_navigasi_role_export_excel_pelamar", "label": "Export Excel Data Pendaftar", "file_type": "concept", "source_file": "docs/spec/03-antarmuka-dan-navigasi-role.md", "source_location": "\u00a72.3 Fitur Export Excel", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_03_antarmuka_dan_navigasi_role_modal_detail_pelamar", "label": "ModalDetailPelamar (CV, Portofolio, Sertifikat)", "file_type": "concept", "source_file": "docs/spec/03-antarmuka-dan-navigasi-role.md", "source_location": "\u00a72.3 Penambahan Lampiran Berkas Sertifikat", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_spec_03_antarmuka_dan_navigasi_role", "target": "docs_spec_03_antarmuka_dan_navigasi_role_sidang_evaluasi_dual_tab", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/spec/03-antarmuka-dan-navigasi-role.md", "source_location": "\u00a71.1", "weight": 1.0}, {"source": "docs_spec_03_antarmuka_dan_navigasi_role", "target": "docs_spec_03_antarmuka_dan_navigasi_role_kartu_dospem_dashboard", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/spec/03-antarmuka-dan-navigasi-role.md", "source_location": "\u00a71.2", "weight": 1.0}, {"source": "docs_spec_03_antarmuka_dan_navigasi_role", "target": "docs_spec_03_antarmuka_dan_navigasi_role_kontributor_detail_tab_dospem", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/spec/03-antarmuka-dan-navigasi-role.md", "source_location": "\u00a72.1", "weight": 1.0}, {"source": "docs_spec_03_antarmuka_dan_navigasi_role", "target": "docs_spec_03_antarmuka_dan_navigasi_role_cms_dropzone_upload", "relation": "concept