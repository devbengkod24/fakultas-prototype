{"nodes": [{"id": "docs_spec_04_standar_komponen_dan_interaksi", "label": "Spesifikasi Standar Komponen & Interaksi UI MBKM", "file_type": "document", "source_file": "docs/spec/04-standar-komponen-dan-interaksi.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_04_standar_komponen_dan_interaksi_auto_scroll_daftar", "label": "Auto-Scroll Floating CTA Tombol Daftar (detail-mbkm.astro)", "file_type": "concept", "source_file": "docs/spec/04-standar-komponen-dan-interaksi.md", "source_location": "\u00a71 Komponen Auto-Scroll ke Tombol Daftar", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The long detail page puts the registration CTA far above the FAQ/footer, forcing tedious manual scrolling; a scroll-triggered floating pill (scrollY > 600px) keeps the primary action reachable and pulses the real button on click."}, {"id": "docs_spec_04_standar_komponen_dan_interaksi_numbering_column_convention", "label": "Standarisasi Penomoran Tabel (Kolom 'No.')", "file_type": "concept", "source_file": "docs/spec/04-standar-komponen-dan-interaksi.md", "source_location": "\u00a72 Standarisasi Penomoran Tabel Data", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Audit found mixed '#' / 'No' / no numbering, and paginated tables resetting to 1 each page; a single formula (currentPage-1)*pageSize+(index+1) plus a fixed w-12..w-14 center-aligned first column gives global, stable row indices."}, {"id": "docs_spec_04_standar_komponen_dan_interaksi_pakta_generator", "label": "Generator Dokumen Pakta Integritas Kontributor", "file_type": "concept", "source_file": "docs/spec/04-standar-komponen-dan-interaksi.md", "source_location": "\u00a73 Spesifikasi Generator Dokumen Pakta Integritas Kontributor", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The pacta is a tripartite agreement (stu