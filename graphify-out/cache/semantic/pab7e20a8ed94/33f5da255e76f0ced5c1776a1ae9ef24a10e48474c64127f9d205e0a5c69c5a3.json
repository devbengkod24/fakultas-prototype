{"nodes": [{"id": "docs_design_enterprise_academic_workflow_workspace", "label": "Design System: Enterprise Academic & Workflow Workspace", "file_type": "document", "source_file": "docs/DESIGN.md", "source_location": "\u00a71 Visual Theme & Atmosphere", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Visual identity must support dense multi-role administrative and academic workflows; depth is achieved via subtle surface contrast and 1px hairline borders rather than heavy shadows or gradients, to prevent visual fatigue in information-dense views."}, {"id": "docs_design_color_palette", "label": "Color Palette & Semantic Role Tokens", "file_type": "concept", "source_file": "docs/DESIGN.md", "source_location": "\u00a72 Color Palette & Roles", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Semantic color pairing (emerald/amber/rose/azure with 10% tint fills) acts as wayfinding through approval pipelines, letting status be read pre-attentively without heavy solid fills."}, {"id": "docs_design_typography_rules", "label": "Typography Rules (Inter / Geist Sans / JetBrains Mono)", "file_type": "concept", "source_file": "docs/DESIGN.md", "source_location": "\u00a73 Typography Rules", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Inter chosen for tall x-height and open apertures for legibility at small sizes in dense tables; JetBrains Mono with tabular numerals so numeric columns align mechanically."}, {"id": "docs_design_component_stylings", "label": "Component Stylings (Buttons, Cards, Navigation, Inputs)", "file_type": "concept", "source_file": "docs/DESIGN.md", "source_location": "\u00a74 Component Stylings", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_design_kpi_stat_cards", "label": "KPI Stat Cards", "file_type": "concept", "source_file": "docs/DESIGN.md", "source_location": "\u00a74 Domain-S