{"nodes": [{"id": "docs_spec_01_flow_mbkm_golden_flow", "label": "Golden Flow MBKM (6 Fase)", "file_type": "concept", "source_file": "docs/spec/01-flow-mbkm.md", "source_location": "\u00a72 Golden Flow (Alur Utama)", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_01_flow_mbkm_prinsip_dasar_alur", "label": "Prinsip Dasar Alur MBKM", "file_type": "rationale", "source_file": "docs/spec/01-flow-mbkm.md", "source_location": "\u00a71 Prinsip Dasar Alur", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Five principles: single entry stepper; no formal pacta at the start; one student one active program; KRS before Dospem; administrative failure is not selection failure (revision returns student to queue without voiding acceptance)."}, {"id": "docs_spec_01_flow_mbkm_pendaftaran_stepper_3_tahap", "label": "Form Pendaftaran 3 Tahap (Stepper)", "file_type": "concept", "source_file": "docs/spec/01-flow-mbkm.md", "source_location": "\u00a72 Golden Flow, Fase 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Academic data is pulled automatically from the study system and cannot be edited manually, removing input error surface at the source."}, {"id": "docs_spec_01_flow_mbkm_mahasiswa_role_journey", "label": "Role Journey: Mahasiswa", "file_type": "concept", "source_file": "docs/spec/01-flow-mbkm.md", "source_location": "\u00a73.1 Mahasiswa", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_01_flow_mbkm_kontributor_role_journey", "label": "Role Journey: Kontributor / Mitra", "file_type": "concept", "source_file": "docs/spec/01-flow-mbkm.md", "source_location": "\u00a73.2 Kontributor / Mitra", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_01_flow_mbkm_koordinator_role_journey", "label": "Role Journey: Koordinator MBKM", "file_type": "concept", "source_file": "docs/spec/01-flow-mbkm.md", "source_location": "\u00a73.3 Koordinator MBKM", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_01_flow_mbkm_dosen_pembimbing_role_journey", "label": "Role Journey: Dosen Pembimbing", "file_type": "concept", "source_file": "docs/spec/01-flow-mbkm.md", "source_location": "\u00a73.4 Dosen Pembimbing", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_01_flow_mbkm_dualitas_pakta_integritas", "label": "Dualitas Pakta Integritas (Persetujuan Umum vs Pakta Kontributor)", "file_type": "concept", "source_file": "docs/spec/01-flow-mbkm.md", "source_location": "\u00a74.1 Dualitas Pakta Integritas", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Splitting consent into an automatic 3-checkbox general agreement and a manually verified generated PDF lets legal obligations bind only after a student is actually accepted by a partner."}, {"id": "docs_spec_01_flow_mbkm_multi_application_auto_withdrawal", "label": "Multi-Application & Auto-Withdrawal (Maks. 3 Lamaran)", "file_type": "concept", "source_file": "docs/spec/01-flow-mbkm.md", "source_location": "\u00a74.2 Multi-Application & Auto-Withdrawal", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Allowing up to 3 parallel applications improves match rate, but accepting one offer auto-withdraws the rest and returns quota to the partner queue so a single student cannot hold multiple seats."}, {"id": "docs_spec_01_flow_mbkm_gatekeeper_krs_sebelum_plotting", "label": "Gatekeeper KRS sebelum Plotting Dospem", "file_type": "concept", "source_file": "docs/spec/01-flow-mbkm.md", "source_location": "\u00a74.3 Gatekeeper KRS sebelum Plotting Dospem", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The Assign Dosen Pembimbing button stays disabled until conversion reaches KRS_LOCKED_VERIFIED, preventing supervisors from being allocated to courses the student has not actually locked in Siadin."}, {"id": "docs_spec_01_flow_mbkm_representasi_dospem_dashboard", "label": "Representasi Dospem di Dashboard Mahasiswa", "file_type": "concept", "source_file": "docs/spec/01-flow-mbkm.md", "source_location": "\u00a74.4 Representasi Dospem di Dashboard Mahasiswa", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sidebar menu removed; a neutral empty-state card before plotting and a populated card (avatar, NIDN, institutional email, read-only WAG link) after plotting keeps the information discoverable where the student already looks."}, {"id": "docs_spec_01_flow_mbkm_exception_paths", "label": "Alur Alternatif (Exception Paths)", "file_type": "concept", "source_file": "docs/spec/01-flow-mbkm.md", "source_location": "\u00a75 Alur Alternatif (Exception Paths)", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_01_flow_mbkm_ghosting_monitoring", "label": "Ghosting Monitoring (>7 Hari Logbook Kosong)", "file_type": "concept", "source_file": "docs/spec/01-flow-mbkm.md", "source_location": "\u00a75 Alur Alternatif (Exception Paths)", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_spec_01_flow_mbkm_golden_flow", "target": "docs_spec_02_state_machine_mbkm_v2", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/spec/01-flow-mbkm.md", "source_location": "header 'Dokumen Pasangan: [[02-state-machine-mbkm]]'", "weight": 1.0}, {"source": "docs_spec_01_flow_mbkm_golden_flow", "target": "docs_spec_01_flow_mbkm_prinsip_dasar_alur", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/spec/01-flow-mbkm.md", "source_location": "\u00a71 and \u00a72", "weight": 1.0}, {"source": "docs_spec_01_flow_mbkm_golden_flow", "tar