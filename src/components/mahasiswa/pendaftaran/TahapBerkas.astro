---
// src/components/mahasiswa/pendaftaran/TahapBerkas.astro
import { cn } from "../../../utils/cn";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const programVerifications = [
  { id: "bk", nama: "Bengkel Koding", subnama: "Proyek Web & Mobile", skema: "Proyek Industri", status: "Lolos Berkas" },
  { id: "idss", nama: "IDSS Laboratory", subnama: "Riset Decision Support & AI", skema: "Publikasi & Riset", status: "Lolos Berkas" },
  { id: "dicoding", nama: "Dicoding Indonesia", subnama: "Asah AI & Software Engineering", skema: "Studi Independen", status: "Lolos Berkas" },
];
---

<div x-show="currentStage === 'berkas'" class={cn("rounded-xl border border-[#E2E8F0] bg-white p-5 sm:p-6 shadow-2xs space-y-5", className)}>
  <!-- Header Tahap 2 -->
  <div class="pb-3 border-b border-[#E2E8F0]">
    <h3 class="text-base font-semibold text-[#0F172A]">Tahap 2: Seleksi Berkas & Persyaratan Akademik</h3>
    <p class="text-sm text-[#64748B] mt-0.5">Data akademik dan dokumen persyaratan telah diverifikasi serta dinyatakan memenuhi syarat.</p>
  </div>

  <!-- Verifikasi Persyaratan Umum Mahasiswa -->
  <div class="p-4 rounded-lg bg-[#F8FAFC] border border-[#E2E8F0] space-y-3">
    <div class="flex items-center justify-between">
      <span class="text-xs font-semibold text-[#0F172A]">Verifikasi Persyaratan Umum</span>
      <span class="text-[11px] text-[#64748B]">Berdasarkan data pendaftaran</span>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-3">
      <!-- Semester -->
      <div class="p-3 bg-white rounded-md border border-[#E2E8F0] space-y-1">
        <div class="text-[11px] text-[#64748B]">Semester Aktif</div>
        <div class="text-sm font-bold text-[#0F172A]">Semester 7</div>
        <div class="text-[11px] text-[#64748B] pt-0.5 border-t border-[#F1F5F9] flex justify-between items-center">
          <span>Min. Sem. 5</span>
          <span class="font-medium text-[#0F172A]">Memenuhi syarat</span>
        </div>
      </div>

      <!-- IPK -->
      <div class="p-3 bg-white rounded-md border border-[#E2E8F0] space-y-1">
        <div class="text-[11px] text-[#64748B]">IPK Kumulatif</div>
        <div class="text-sm font-bold text-[#0F172A]">3.68</div>
        <div class="text-[11px] text-[#64748B] pt-0.5 border-t border-[#F1F5F9] flex justify-between items-center">
          <span>IPK ≥ 3.00</span>
          <span class="font-medium text-[#0F172A]">Memenuhi syarat</span>
        </div>
      </div>

      <!-- Status Cuti -->
      <div class="p-3 bg-white rounded-md border border-[#E2E8F0] space-y-1">
        <div class="text-[11px] text-[#64748B]">Riwayat Cuti</div>
        <div class="text-sm font-bold text-[#0F172A]">Tidak Pernah Cuti</div>
        <div class="text-[11px] text-[#64748B] pt-0.5 border-t border-[#F1F5F9] flex justify-between items-center">
          <span>Bebas Cuti</span>
          <span class="font-medium text-[#0F172A]">Memenuhi syarat</span>
        </div>
      </div>

      <!-- SKS Lulus -->
      <div class="p-3 bg-white rounded-md border border-[#E2E8F0] space-y-1">
        <div class="text-[11px] text-[#64748B]">SKS Lulus Tempuh</div>
        <div class="text-sm font-bold text-[#0F172A]">110 SKS</div>
        <div class="text-[11px] text-[#64748B] pt-0.5 border-t border-[#F1F5F9] flex justify-between items-center">
          <span>Min. 100 SKS</span>
          <span class="font-medium text-[#0F172A]">Memenuhi syarat</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Status Berkas per Program -->
  <div class="space-y-3">
    <h4 class="text-sm font-semibold text-[#0F172A]">Status Berkas per Program Pilihan (3 Program)</h4>
    <div class="divide-y divide-[#E2E8F0] border border-[#E2E8F0] rounded-lg overflow-hidden">
      {programVerifications.map((p, idx) => (
        <div class="p-3.5 bg-white flex flex-col sm:flex-row sm:items-center justify-between gap-3 hover:bg-[#F8FAFC] transition-colors">
          <div class="flex items-center gap-3">
            <span class="w-6 h-6 rounded-md bg-[#F1F5F9] text-[#0F172A] text-xs font-semibold flex items-center justify-center shrink-0">
              {idx + 1}
            </span>
            <div>
              <div class="text-sm font-semibold text-[#0F172A]">{p.nama}</div>
              <div class="text-xs text-[#64748B]">{p.subnama} • {p.skema}</div>
            </div>
          </div>
          <div class="shrink-0 self-end sm:self-center">
            <span class="inline-flex items-center px-2.5 py-1 rounded text-xs font-medium bg-[#F1F5F9] text-[#0F172A] border border-[#E2E8F0]">
              {p.status}
            </span>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Notification Banner Next Step -->
  <div class="p-4 rounded-lg bg-[#EFF6FF] border border-[#BFDBFE] flex flex-col sm:flex-row sm:items-center justify-between gap-3">
    <div class="flex items-start gap-3">
      <i data-lucide="info" class="w-4 h-4 text-[#1E40AF] shrink-0 mt-0.5"></i>
      <div class="text-xs text-[#1E3A8A] space-y-0.5">
        <p class="font-semibold text-[#1E40AF]">Seluruh berkas persyaratan telah terverifikasi.</p>
        <p class="text-[#1E3A8A] leading-relaxed">
          Tahap berikutnya adalah wawancara. Anda dijadwalkan mengikuti sesi wawancara untuk masing-masing program terdaftar.
        </p>
      </div>
    </div>
    <button
      type="button"
      @click="setStage('wawancara')"
      class="h-9 px-3.5 rounded-[6px] bg-[#1E40AF] hover:bg-[#1E3A8A] text-white text-xs font-medium shrink-0 transition-colors cursor-pointer flex items-center justify-center gap-1.5 shadow-2xs self-end sm:self-auto"
    >
      <span>Lihat Jadwal Wawancara</span>
      <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
    </button>
  </div>
</div>
