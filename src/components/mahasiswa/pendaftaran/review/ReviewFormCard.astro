---
// src/components/mahasiswa/pendaftaran/review/ReviewFormCard.astro
import { cn } from "../../../../utils/cn";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const coreDocFields = [
  { key: "cv", label: "CV", hasSpaceBeforeStar: false, placeholder: "https://drive.google.com/file/d/..." },
  { key: "portofolio", label: "Portofolio", hasSpaceBeforeStar: true, placeholder: "https://github.com/username atau https://behance.net/..." },
  { key: "sertifikat", label: "Sertifikat", hasSpaceBeforeStar: false, placeholder: "https://drive.google.com/file/d/..." },
] as const;
---

<!-- Card Program yang Diajukan (Persis PendaftarProgramTable di Dashboard + Drag Prioritas + Expand Form) -->
<div class={cn("rounded-xl border border-[#e4e4e7] bg-white text-[#09090b] shadow-none flex flex-col", className)}>
  <!-- Header Card (Selaras Dashboard) -->
  <div class="px-5 py-3.5 border-b border-[#e4e4e7] rounded-t-xl flex items-center gap-1.5 shrink-0">
    <h3 class="text-base font-semibold text-[#09090b]">
      Program yang diajukan
    </h3>
    <div
      class="relative flex items-center"
      x-data="{ showDragInfo: false }"
      @mouseenter="showDragInfo = true"
      @mouseleave="showDragInfo = false"
      @click.outside="showDragInfo = false"
    >
      <button
        type="button"
        @click="showDragInfo = !showDragInfo"
        aria-label="Informasi urutan prioritas"
        class="inline-flex items-center justify-center w-5 h-5 rounded-full text-[#71717a] hover:text-[#0655a7] hover:bg-[#f4f4f5] transition-colors cursor-pointer"
      >
        <i data-lucide="info" class="w-4 h-4"></i>
      </button>
      <div
        x-show="showDragInfo"
        x-transition
        x-cloak
        class="absolute left-0 top-full mt-2 sm:left-full sm:top-1/2 sm:-translate-y-1/2 sm:mt-0 sm:ml-2 z-20 w-max max-w-[240px] sm:max-w-none rounded-md border border-[#e4e4e7] bg-[#09090b] px-2.5 py-1.5 text-[11px] font-medium text-white shadow-sm pointer-events-none"
      >
        Seret ikon di samping logo untuk mengurutkan prioritas
      </div>
    </div>
  </div>

  <!-- List Items -->
  <div class="rounded-b-xl overflow-hidden">
    <template x-for="(program, idx) in daftarFormMBKM" :key="program.id">
      <div
        :draggable="dragEnabledId === program.id && !(stageIndex(currentStage) >= 1 && !program.screeningLolos)"
        @dragstart="dragStart($event, idx)"
        @dragover.prevent="dragOver($event, idx)"
        @dragleave="dragLeave($event, idx)"
        @drop.prevent="dragDrop($event, idx)"
        @dragend="dragEnd()"
        class="relative transition-all overflow-hidden"
        :class="(idx > 0 ? 'border-t border-[#e4e4e7] ' : '') + (draggedIndex === idx ? 'opacity-50 bg-white' : (isDragOver === idx && draggedIndex !== idx ? 'bg-blue-50/30 ring-2 ring-inset ring-[#0655a7]/40' : (stageIndex(currentStage) >= 1 && !program.screeningLolos ? 'bg-[#f4f4f5] opacity-65' : (expandedFormId !== program.id ? 'bg-white hover:bg-[#fafafa]' : 'bg-white'))))"
      >
        <!-- Indikator Bar Aksen Biru Sisi Kiri (Persis Dashboard) -->
        <div
          x-show="selectedProgram === program.id && !(stageIndex(currentStage) >= 1 && !program.screeningLolos)"
          class="absolute left-0 top-0 bottom-0 w-1 bg-[#0655a7] z-10"
          aria-hidden="true"
        ></div>

        <!-- Baris Ringkasan Program (Persis Dashboard) -->
        <div
          class="space-y-2 transition-colors"
          :class="(expandedFormId === program.id ? 'p-4 sm:p-5 ' : 'px-4 pt-4 pb-2.5 sm:px-5 sm:pt-5 sm:pb-3 ') + (stageIndex(currentStage) >= 1 && !program.screeningLolos ? 'cursor-default' : (expandedFormId === program.id ? 'cursor-pointer hover:bg-[#fafafa]' : 'cursor-pointer'))"
          @click="if (!(stageIndex(currentStage) >= 1 && !program.screeningLolos)) selectedProgram = program.id"
        >
          <!-- Baris Atas: Tombol Drag, Logo, Nama Program & Tombol Panah Expand -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div class="flex items-center gap-2.5 sm:gap-3">
              <!-- Tombol Drag di sebelah logo -->
              <button
                type="button"
                @mousedown="if (!(stageIndex(currentStage) >= 1 && !program.screeningLolos)) dragEnabledId = program.id"
                @click.stop
                :disabled="stageIndex(currentStage) >= 1 && !program.screeningLolos"
                class="p-1.5 -ml-1 rounded-md shrink-0 transition-colors"
                :class="stageIndex(currentStage) >= 1 && !program.screeningLolos ? 'text-[#d4d4d8] cursor-not-allowed' : 'text-[#a1a1aa] hover:text-[#09090b] hover:bg-[#f4f4f5] cursor-grab active:cursor-grabbing'"
                title="Seret untuk mengurutkan prioritas"
                aria-label="Seret untuk mengurutkan prioritas"
              >
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="9" cy="12" r="1"></circle>
                  <circle cx="9" cy="5" r="1"></circle>
                  <circle cx="9" cy="19" r="1"></circle>
                  <circle cx="15" cy="12" r="1"></circle>
                  <circle cx="15" cy="5" r="1"></circle>
                  <circle cx="15" cy="19" r="1"></circle>
                </svg>
              </button>

              <div
                class="w-10 h-10 rounded-lg border bg-white flex items-center justify-center p-1 shrink-0 overflow-hidden shadow-2xs transition-all"
                :class="stageIndex(currentStage) >= 1 && !program.screeningLolos ? 'border-[#e4e4e7] grayscale opacity-75' : (selectedProgram === program.id ? 'border-blue-300 ring-2 ring-blue-100' : 'border-[#e4e4e7]')"
              >
                <img
                  :src="program.logo"
                  :alt="'Logo ' + program.nama"
                  class="w-full h-full object-contain rounded"
                />
              </div>

              <div class="flex items-center gap-2 flex-wrap">
                <h4
                  class="text-sm font-semibold transition-colors"
                  :class="stageIndex(currentStage) >= 1 && !program.screeningLolos ? 'text-[#71717a]' : (selectedProgram === program.id ? 'text-[#0655a7]' : 'text-[#09090b]')"
                  x-text="program.nama"
                ></h4>
              </div>
            </div>

            <!-- Tombol Panah Kebawah untuk Expand/Collapse Form yang Diajukan -->
            <div class="flex items-center gap-2.5 shrink-0">
              <button
                type="button"
                @click.stop="toggleExpand(program.id)"
                :aria-expanded="expandedFormId === program.id"
                :aria-label="'Lihat formulir ' + program.nama"
                :title="expandedFormId === program.id ? 'Tutup formulir yang diajukan' : 'Lihat formulir yang diajukan'"
                class="inline-flex items-center justify-center w-8 h-8 rounded-md border border-[#e4e4e7] bg-white hover:bg-[#f4f4f5] text-[#09090b] transition-colors cursor-pointer"
              >
                <svg
                  class="w-4 h-4 text-[#71717a] transition-transform duration-200"
                  :class="expandedFormId === program.id ? 'rotate-180 text-[#0655a7]' : ''"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="m6 9 6 6 6-6"></path>
                </svg>
              </button>
            </div>
          </div>

          <!-- Baris Bawah: Jadwal & Timeline Inline (Sesuai Tahap Stepper) -->
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5 text-xs text-[#71717a] pt-0.5 pl-7 sm:pl-8">
            <div class="flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-[#71717a]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M8 2v4"></path><path d="M16 2v4"></path><rect width="18" height="18" x="3" y="4" rx="2"></rect><path d="M3 10h18"></path>
              </svg>
              <span>Diajukan: <strong class="font-medium text-[#09090b]" x-text="program.tglDaftar"></strong></span>
            </div>
            <span class="text-[#e4e4e7] hidden sm:inline">•</span>
            <div class="flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path><path d="M14 2v4a2 2 0 0 0 2 2h4"></path><path d="m9 15 2 2 4-4"></path>
              </svg>
              <span>Screening: <strong
                :class="stageIndex(currentStage) < 1 ? 'font-medium text-[#71717a]' : (program.screeningLolos ? 'font-semibold text-emerald-700' : 'font-semibold text-red-600')"
                x-text="stageIndex(currentStage) < 1 ? 'N/A' : (program.screeningLolos ? 'Lolos' : 'Tidak Lolos')"
              ></strong></span>
            </div>
            <span class="text-[#e4e4e7] hidden sm:inline">•</span>
            <div class="flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-[#0655a7]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 7.5V6a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h3.5"></path><path d="M16 2v4"></path><path d="M8 2v4"></path><path d="M3 10h5"></path><path d="M17.5 17.5 16 16.3V14"></path><circle cx="16" cy="16" r="6"></circle>
              </svg>
              <span>Wawancara: <strong :class="stageIndex(currentStage) >= 2 && program.screeningLolos ? 'font-medium text-[#09090b]' : 'font-medium text-[#71717a]'" x-text="stageIndex(currentStage) >= 2 && program.screeningLolos ? program.jadwalWawancaraDetail : 'N/A'"></strong></span>
            </div>
            <span class="text-[#e4e4e7] hidden sm:inline">•</span>
            <div class="flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m3 11 18-5v12L3 14v-3z"></path><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"></path>
              </svg>
              <span>Pengumuman: <strong :class="currentStage === 'hasil' && program.pengumuman !== 'N/A' ? 'font-medium text-[#09090b]' : 'font-medium text-[#71717a]'" x-text="currentStage === 'hasil' ? program.pengumuman : 'N/A'"></strong></span>
            </div>
          </div>
        </div>

        <!-- Drawer Form yang Diajukan (Expand saat tombol panah kebawah diklik) -->
        <div
          x-show="expandedFormId === program.id"
          x-transition
          x-cloak
          class="bg-white border-t border-[#e4e4e7] px-5 pt-5 pb-4 sm:px-6 sm:pt-6 sm:pb-4 space-y-5"
        >
          <div class="flex items-center justify-between gap-3">
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-[#0655a7] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path><path d="M14 2v4a2 2 0 0 0 2 2h4"></path><path d="M10 9H8"></path><path d="M16 13H8"></path><path d="M16 17H8"></path>
              </svg>
              <h5 class="text-sm font-semibold text-[#09090b]">Dokumen Pendaftaran</h5>
            </div>

            <!-- Tombol Edit Dokumen -->
            <div x-show="!program.isClosed" class="flex items-center gap-2 shrink-0">
              <button
                type="button"
                x-show="editingFormId !== program.id"
                @click="editingFormId = program.id"
                class="h-8 px-3 rounded-md bg-white border border-[#e4e4e7] hover:bg-[#f4f4f5] text-xs font-medium text-[#09090b] flex items-center gap-1.5 cursor-pointer shadow-none transition-colors"
              >
                <svg class="w-3.5 h-3.5 text-[#0655a7]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 20h9"></path><path d="M16.376 3.622a1 1 0 0 1 3.002 3.002L7.368 18.635a2 2 0 0 1-.855.506l-2.872.838a.5.5 0 0 1-.62-.62l.838-2.872a2 2 0 0 1 .506-.854z"></path>
                </svg>
                <span>Edit Berkas</span>
              </button>
            </div>
          </div>

          <!-- Daftar Input Dokumen (Grid 2 Kolom Lebih Lega) -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-x-5 gap-y-4 text-xs">
            {coreDocFields.map((field) => (
              <div class="space-y-1.5">
                <label class="block text-xs font-medium text-[#09090b]">
                  {field.label}{field.hasSpaceBeforeStar ? " " : ""}<span class="text-red-500">*</span>
                </label>
                <input
                  type="text"
                  placeholder={field.placeholder}
                  :readonly="editingFormId !== program.id"
                  x-model={`program.dokumen.${field.key}`}
                  class="w-full h-9 px-3 rounded-md border text-xs outline-none transition-all"
                  :class="editingFormId === program.id ? 'bg-white border-[#0655a7] text-[#09090b] ring-2 ring-blue-100' : 'bg-white border-[#e4e4e7] text-[#3f3f46]'"
                />
              </div>
            ))}

            <!-- Lampiran Dinamis (Maksimal 3) -->
            <template x-for="(lamp, lIdx) in program.dokumen.lampiran" :key="lIdx">
              <div class="space-y-1.5">
                <div class="flex items-center justify-between">
                  <label class="block text-xs font-medium text-[#09090b]" x-text="'Lampiran ' + (lIdx + 1)"></label>
                  <button
                    type="button"
                    x-show="editingFormId === program.id"
                    @click="hapusLampiran(program, lIdx)"
                    class="text-[#71717a] hover:text-red-600 transition-colors p-0.5 cursor-pointer"
                    :title="'Hapus Lampiran ' + (lIdx + 1)"
                  >
                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M3 6h18m-2 0v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6m3 0V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path>
                      <line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line>
                    </svg>
                  </button>
                </div>
                <input
                  type="text"
                  placeholder="https://drive.google.com/file/d/..."
                  :readonly="editingFormId !== program.id"
                  x-model="program.dokumen.lampiran[lIdx]"
                  class="w-full h-9 px-3 rounded-md border text-xs outline-none transition-all"
                  :class="editingFormId === program.id ? 'bg-white border-[#0655a7] text-[#09090b] ring-2 ring-blue-100' : 'bg-white border-[#e4e4e7] text-[#3f3f46]'"
                />
              </div>
            </template>
          </div>

          <!-- Tombol Tambah Lampiran (Maksimal 3 Lampiran) -->
          <div x-show="canAddLampiran(program)">
            <button
              type="button"
              @click="tambahLampiran(program)"
              class="h-8 px-3 rounded-md border border-dashed border-[#d4d4d8] hover:border-[#0655a7] hover:text-[#0655a7] bg-white text-xs font-medium text-[#09090b] inline-flex items-center gap-1.5 transition-colors cursor-pointer shadow-none"
            >
              <svg class="w-3.5 h-3.5 text-[#71717a]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
              <span>Tambah Lampiran</span>
            </button>
          </div>

          <!-- Aksi Simpan untuk Form Ini -->
          <div x-show="editingFormId === program.id" class="flex items-center justify-end gap-2 pt-1">
            <button
              type="button"
              @click="editingFormId = null"
              class="h-8 px-3.5 rounded-md bg-white border border-[#e4e4e7] text-xs font-medium text-[#09090b] hover:bg-[#f4f4f5] cursor-pointer shadow-none"
            >
              Batal
            </button>
            <button
              type="button"
              @click="saveDokumenProgram(program.id)"
              class="h-8 px-4 rounded-md bg-[#0655a7] hover:bg-[#114d91] text-white text-xs font-medium cursor-pointer shadow-none flex items-center gap-1.5"
            >
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M15.2 3a2 2 0 0 1 1.4.6l3.8 3.8a2 2 0 0 1 .6 1.4V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z"></path><path d="M17 21v-7a1 1 0 0 0-1-1H8a1 1 0 0 0-1 1v7"></path><path d="M7 3v4a1 1 0 0 0 1 1h7"></path>
              </svg>
              <span>Simpan Berkas</span>
            </button>
          </div>
        </div>

        <!-- Link Detail di Pojok Kanan Bawah Tiap Card Program -->
        <div
          class="flex items-center justify-end"
          :class="expandedFormId === program.id ? 'bg-white px-5 pb-5 sm:px-6 sm:pb-6' : 'px-4 pb-4 sm:px-5 sm:pb-5'"
        >
          <a
            href="/mahasiswa/pendaftaran-detail"
            @click.stop
            class="group inline-flex items-center gap-1 text-xs font-medium text-[#0655a7] hover:text-[#114d91] hover:underline transition-colors"
          >
            <span>Detail</span>
            <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14"></path>
              <path d="m12 5 7 7-7 7"></path>
            </svg>
          </a>
        </div>
      </div>
    </template>
  </div>
</div>
