---
// src/components/mahasiswa/pendaftaran/review/ReviewFormCard.astro
import { cn } from "../../../../utils/cn";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class={cn("space-y-4", className)}>
  <template x-for="(formItem, fIdx) in daftarFormMBKM" :key="formItem.id">
    <div
      class="rounded-xl border border-[#E2E8F0] bg-white overflow-hidden shadow-2xs space-y-4 transition-all"
    >
      <!-- Header Formulir Program & Metadata dari Halaman Pendaftaran -->
      <div class="p-4 sm:p-5 bg-[#F8FAFC] border-b border-[#E2E8F0] space-y-3">
        <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-3">
          <div class="flex items-start gap-3">
            <div class="w-10 h-10 rounded-lg bg-white border border-[#E2E8F0] p-1.5 flex items-center justify-center shrink-0 shadow-2xs">
              <img :src="formItem.logo" :alt="formItem.nama" class="w-full h-full object-contain" />
            </div>
            <div>
              <div class="flex items-center gap-2 flex-wrap">
                <h4 class="text-sm sm:text-base font-bold text-[#0F172A]" x-text="formItem.nama"></h4>
                <span class="text-[10px] font-semibold px-2 py-0.5 rounded bg-blue-50 text-[#1E40AF] border border-blue-100" x-text="formItem.skema + ' • 20 SKS'"></span>
              </div>
              <p class="text-xs text-[#64748B] mt-0.5" x-text="formItem.subnama"></p>
            </div>
          </div>

          <div class="flex items-center gap-2 self-start sm:self-auto text-xs">
            <div class="text-left sm:text-right">
              <span class="text-[#64748B] block text-[11px]">No. Registrasi:</span>
              <strong class="font-mono text-[#0F172A]" x-text="formItem.noPendaftaran"></strong>
            </div>
          </div>
        </div>

        <!-- Metadata Jadwal Pendaftaran Program (Selaras Screenshot) -->
        <div class="grid grid-cols-3 gap-2 pt-2 border-t border-[#E2E8F0] text-xs">
          <div class="space-y-0.5">
            <span class="text-[11px] text-[#64748B] block">Diajukan:</span>
            <span class="font-semibold text-[#0F172A]" x-text="formItem.tglDaftar"></span>
          </div>
          <div class="space-y-0.5">
            <span class="text-[11px] text-[#64748B] block">Jadwal Wawancara:</span>
            <span class="font-semibold text-[#0F172A]" x-text="formItem.jadwalWawancara"></span>
          </div>
          <div class="space-y-0.5">
            <span class="text-[11px] text-[#64748B] block">Pengumuman:</span>
            <span class="font-semibold text-[#0F172A]" x-text="formItem.pengumuman"></span>
          </div>
        </div>
      </div>

      <!-- Dokumen Berkas yang Diunggah untuk Program Ini -->
      <div class="p-4 sm:p-5 pt-0 space-y-4">
        <div class="flex items-center justify-between">
          <div>
            <h5 class="text-xs font-semibold text-[#0F172A] flex items-center gap-1.5">
              <i data-lucide="folder-check" class="w-3.5 h-3.5 text-[#1E40AF]"></i>
              <span>Berkas Persyaratan Program</span>
            </h5>
            <p class="text-[11px] text-[#64748B]">Tautan berkas yang diajukan untuk seleksi mitra ini.</p>
          </div>

          <!-- Tombol Edit Dokumen Form Spesifik -->
          <div class="flex items-center gap-2">
            <button
              type="button"
              x-show="!formItem.isClosed && editingFormId !== formItem.id"
              @click="editingFormId = formItem.id"
              class="h-7 px-2.5 rounded-[6px] bg-white border border-[#E2E8F0] hover:bg-[#F8FAFC] text-[11px] font-medium text-[#0F172A] flex items-center gap-1 cursor-pointer shadow-2xs transition-colors"
            >
              <i data-lucide="edit-3" class="w-3 h-3 text-[#1E40AF]"></i>
              <span>Edit Berkas</span>
            </button>

            <span
              x-show="formItem.isClosed"
              class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[11px] font-medium bg-[#F1F5F9] text-[#64748B] border border-[#E2E8F0]"
            >
              <i data-lucide="lock" class="w-3 h-3"></i>
              <span>Terkunci</span>
            </span>
          </div>
        </div>

        <!-- Grid 4 Dokumen -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
          <!-- CV -->
          <div class="space-y-1">
            <label class="text-[11px] font-medium text-[#475569]">
              Curriculum Vitae (ATS)
            </label>
            <div class="flex gap-1.5">
              <input
                type="text"
                :readonly="editingFormId !== formItem.id"
                x-model="formItem.dokumen.cv"
                class="flex-1 h-8 px-2.5 rounded-[6px] border text-xs text-[#0F172A] font-mono outline-none transition-all"
                :class="editingFormId === formItem.id ? 'bg-white border-[#2563EB] ring-2 ring-blue-100' : 'bg-[#F8FAFC] border-[#E2E8F0]'"
              />
              <a :href="formItem.dokumen.cv" target="_blank" class="h-8 px-2 rounded-[6px] border border-[#E2E8F0] bg-white hover:bg-[#F8FAFC] flex items-center justify-center shrink-0">
                <i data-lucide="external-link" class="w-3 h-3 text-[#64748B]"></i>
              </a>
            </div>
          </div>

          <!-- Portofolio -->
          <div class="space-y-1">
            <label class="text-[11px] font-medium text-[#475569]">
              Portofolio / Tautan Karya
            </label>
            <div class="flex gap-1.5">
              <input
                type="text"
                :readonly="editingFormId !== formItem.id"
                x-model="formItem.dokumen.portofolio"
                class="flex-1 h-8 px-2.5 rounded-[6px] border text-xs text-[#0F172A] font-mono outline-none transition-all"
                :class="editingFormId === formItem.id ? 'bg-white border-[#2563EB] ring-2 ring-blue-100' : 'bg-[#F8FAFC] border-[#E2E8F0]'"
              />
              <a :href="formItem.dokumen.portofolio" target="_blank" class="h-8 px-2 rounded-[6px] border border-[#E2E8F0] bg-white hover:bg-[#F8FAFC] flex items-center justify-center shrink-0">
                <i data-lucide="external-link" class="w-3 h-3 text-[#64748B]"></i>
              </a>
            </div>
          </div>

          <!-- Sertifikat -->
          <div class="space-y-1">
            <label class="text-[11px] font-medium text-[#475569]">
              Sertifikat Pendukung
            </label>
            <div class="flex gap-1.5">
              <input
                type="text"
                :readonly="editingFormId !== formItem.id"
                x-model="formItem.dokumen.sertifikat"
                class="flex-1 h-8 px-2.5 rounded-[6px] border text-xs text-[#0F172A] font-mono outline-none transition-all"
                :class="editingFormId === formItem.id ? 'bg-white border-[#2563EB] ring-2 ring-blue-100' : 'bg-[#F8FAFC] border-[#E2E8F0]'"
              />
              <a :href="formItem.dokumen.sertifikat" target="_blank" class="h-8 px-2 rounded-[6px] border border-[#E2E8F0] bg-white hover:bg-[#F8FAFC] flex items-center justify-center shrink-0">
                <i data-lucide="external-link" class="w-3 h-3 text-[#64748B]"></i>
              </a>
            </div>
          </div>

          <!-- SuReKom -->
          <div class="space-y-1">
            <label class="text-[11px] font-medium text-[#475569]">
              Surat Rekomendasi (SuReKom)
            </label>
            <div class="flex gap-1.5">
              <input
                type="text"
                :readonly="editingFormId !== formItem.id"
                x-model="formItem.dokumen.surekom"
                class="flex-1 h-8 px-2.5 rounded-[6px] border text-xs text-[#0F172A] font-mono outline-none transition-all"
                :class="editingFormId === formItem.id ? 'bg-white border-[#2563EB] ring-2 ring-blue-100' : 'bg-[#F8FAFC] border-[#E2E8F0]'"
              />
              <a :href="formItem.dokumen.surekom" target="_blank" class="h-8 px-2 rounded-[6px] border border-[#E2E8F0] bg-white hover:bg-[#F8FAFC] flex items-center justify-center shrink-0">
                <i data-lucide="external-link" class="w-3 h-3 text-[#64748B]"></i>
              </a>
            </div>
          </div>
        </div>

        <!-- Aksi Simpan untuk Form Ini -->
        <div x-show="editingFormId === formItem.id" class="flex items-center justify-end gap-2 pt-1">
          <button
            type="button"
            @click="editingFormId = null"
            class="h-7 px-3 rounded-[6px] bg-white border border-[#E2E8F0] text-xs font-medium text-[#0F172A] hover:bg-[#F8FAFC] cursor-pointer"
          >
            Batal
          </button>
          <button
            type="button"
            @click="saveDokumenProgram(formItem.id)"
            class="h-7 px-3.5 rounded-[6px] bg-[#1E40AF] hover:bg-[#1E3A8A] text-white text-xs font-medium cursor-pointer shadow-2xs flex items-center gap-1"
          >
            <i data-lucide="save" class="w-3 h-3"></i>
            <span>Simpan Berkas <span x-text="formItem.nama"></span></span>
          </button>
        </div>

        <!-- Pengganti Pernyataan Komitmen: Informasi Tanggal Tutup Pendaftaran MBKM Ini -->
        <div class="p-3 bg-[#F8FAFC] rounded-lg border border-[#E2E8F0] flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs">
          <div class="flex items-center gap-2 text-[#475569]">
            <i data-lucide="calendar" class="w-4 h-4 text-[#1E40AF] shrink-0"></i>
            <span>Batas Akhir Pendaftaran Program: <strong class="text-[#0F172A]" x-text="formItem.tglTutup"></strong></span>
          </div>
          <div>
            <span
              x-show="formItem.isClosed"
              class="px-2 py-0.5 rounded text-[10px] font-semibold bg-[#FEF2F2] text-[#991B1B] border border-[#FECACA] inline-flex items-center gap-1"
            >
              <i data-lucide="lock" class="w-2.5 h-2.5"></i>
              <span>Pendaftaran Telah Ditutup</span>
            </span>
            <span
              x-show="!formItem.isClosed"
              class="px-2 py-0.5 rounded text-[10px] font-semibold bg-[#ECFDF5] text-[#065F46] border border-[#A7F3D0] inline-flex items-center gap-1"
            >
              <i data-lucide="clock" class="w-2.5 h-2.5"></i>
              <span>Pendaftaran Masih Dibuka</span>
            </span>
          </div>
        </div>
      </div>
    </div>
  </template>
</div>
