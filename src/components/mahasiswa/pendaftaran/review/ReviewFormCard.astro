---
// src/components/mahasiswa/pendaftaran/review/ReviewFormCard.astro
import { cn } from "../../../../utils/cn";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class={cn("space-y-4", className)}>
  <template x-for="(formItem, fIdx) in daftarFormMBKM" :key="formItem.id">
    <div class="rounded-xl border border-[#E2E8F0] bg-white overflow-hidden shadow-2xs space-y-4 transition-all">
      <!-- Header Formulir Program & Metadata dari Halaman Pendaftaran -->
      <div class="p-4 sm:p-5 bg-[#F8FAFC] border-b border-[#E2E8F0] space-y-3">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-lg bg-white border border-[#E2E8F0] p-1.5 flex items-center justify-center shrink-0 shadow-2xs">
              <img :src="formItem.logo" :alt="formItem.nama" src="/assets/images/logo-bengkod.png" alt="Logo Program" class="w-full h-full object-contain" />
            </div>
            <h4 class="text-sm sm:text-base font-bold text-[#0F172A]" x-text="formItem.nama"></h4>
          </div>

          <div class="flex items-center gap-2 self-start sm:self-auto text-xs">
            <div class="text-left sm:text-right">
              <span class="text-[#64748B] block text-[11px]">No. Registrasi:</span>
              <strong class="font-semibold text-[#0F172A]" x-text="formItem.noPendaftaran"></strong>
            </div>
          </div>
        </div>

        <!-- Metadata Jadwal Pendaftaran Program -->
        <div class="grid grid-cols-3 gap-2 pt-2 border-t border-[#E2E8F0] text-xs">
          <div class="space-y-0.5">
            <span class="text-[11px] text-[#64748B] block">Diajukan:</span>
            <span class="font-semibold text-[#0F172A]" x-text="formItem.tglDaftar"></span>
          </div>
          <div class="space-y-0.5">
            <span class="text-[11px] text-[#64748B] block">Jadwal Wawancara:</span>
            <span class="font-semibold text-[#0F172A]" x-text="formItem.jadwalWawancara"></span>
          </div>
          <div class="space-y-0.5">
            <span class="text-[11px] text-[#64748B] block">Pengumuman:</span>
            <span class="font-semibold text-[#0F172A]" x-text="formItem.pengumuman"></span>
          </div>
        </div>
      </div>

      <!-- Dokumen Pendaftaran Sesuai Form Pendaftaran -->
      <div class="p-4 sm:p-5 pt-0 space-y-4">
        <div class="flex items-center justify-between">
          <div>
            <div class="flex items-center gap-1.5">
              <i data-lucide="file-text" class="w-4 h-4 text-[#1E40AF]"></i>
              <h5 class="text-xs sm:text-sm font-semibold text-[#0F172A]">Dokumen Pendaftaran</h5>
            </div>
            <p class="text-[11px] text-[#64748B] mt-0.5">Cantumkan tautan dokumen untuk proses pendaftaran. Pastikan akses tautan diatur ke publik.</p>
          </div>

          <!-- Tombol Edit Dokumen Form Spesifik -->
          <div class="flex items-center gap-2">
            <button
              type="button"
              x-show="!formItem.isClosed && editingFormId !== formItem.id"
              @click="editingFormId = formItem.id"
              class="h-7 px-2.5 rounded-[6px] bg-white border border-[#E2E8F0] hover:bg-[#F8FAFC] text-[11px] font-medium text-[#0F172A] flex items-center gap-1 cursor-pointer shadow-2xs transition-colors"
            >
              <i data-lucide="edit-3" class="w-3 h-3 text-[#1E40AF]"></i>
              <span>Edit Berkas</span>
            </button>

            <span
              x-show="formItem.isClosed"
              class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[11px] font-medium bg-[#F1F5F9] text-[#64748B] border border-[#E2E8F0]"
            >
              <i data-lucide="lock" class="w-3 h-3"></i>
              <span>Terkunci</span>
            </span>
          </div>
        </div>

        <!-- Daftar Input Dokumen (Selaras Gambar Form Pendaftaran) -->
        <div class="space-y-3 text-xs">
          <!-- CV* -->
          <div class="space-y-1">
            <label class="text-[11px] font-medium text-[#0F172A]">CV<span class="text-[#EF4444]">*</span></label>
            <div class="flex gap-1.5">
              <input type="text" placeholder="https://drive.google.com/file/d/..." :readonly="editingFormId !== formItem.id" x-model="formItem.dokumen.cv" class="flex-1 h-8 px-2.5 rounded-[6px] border text-xs text-[#0F172A] outline-none transition-all" :class="editingFormId === formItem.id ? 'bg-white border-[#2563EB] ring-2 ring-blue-100' : 'bg-[#F8FAFC] border-[#E2E8F0]'" />
              <a href="#" :href="formItem.dokumen.cv" target="_blank" rel="noopener noreferrer" class="h-8 px-2 rounded-[6px] border border-[#E2E8F0] bg-white hover:bg-[#F8FAFC] flex items-center justify-center shrink-0" title="Buka tautan dokumen"><i data-lucide="external-link" class="w-3 h-3 text-[#64748B]"></i></a>
            </div>
          </div>

          <!-- Portofolio * -->
          <div class="space-y-1">
            <label class="text-[11px] font-medium text-[#0F172A]">Portofolio <span class="text-[#EF4444]">*</span></label>
            <div class="flex gap-1.5">
              <input type="text" placeholder="https://github.com/username atau https://behance.net/..." :readonly="editingFormId !== formItem.id" x-model="formItem.dokumen.portofolio" class="flex-1 h-8 px-2.5 rounded-[6px] border text-xs text-[#0F172A] outline-none transition-all" :class="editingFormId === formItem.id ? 'bg-white border-[#2563EB] ring-2 ring-blue-100' : 'bg-[#F8FAFC] border-[#E2E8F0]'" />
              <a href="#" :href="formItem.dokumen.portofolio" target="_blank" rel="noopener noreferrer" class="h-8 px-2 rounded-[6px] border border-[#E2E8F0] bg-white hover:bg-[#F8FAFC] flex items-center justify-center shrink-0" title="Buka tautan dokumen"><i data-lucide="external-link" class="w-3 h-3 text-[#64748B]"></i></a>
            </div>
          </div>

          <!-- Sertifikat* -->
          <div class="space-y-1">
            <label class="text-[11px] font-medium text-[#0F172A]">Sertifikat<span class="text-[#EF4444]">*</span></label>
            <div class="flex gap-1.5">
              <input type="text" placeholder="https://drive.google.com/file/d/..." :readonly="editingFormId !== formItem.id" x-model="formItem.dokumen.sertifikat" class="flex-1 h-8 px-2.5 rounded-[6px] border text-xs text-[#0F172A] outline-none transition-all" :class="editingFormId === formItem.id ? 'bg-white border-[#2563EB] ring-2 ring-blue-100' : 'bg-[#F8FAFC] border-[#E2E8F0]'" />
              <a href="#" :href="formItem.dokumen.sertifikat" target="_blank" rel="noopener noreferrer" class="h-8 px-2 rounded-[6px] border border-[#E2E8F0] bg-white hover:bg-[#F8FAFC] flex items-center justify-center shrink-0" title="Buka tautan dokumen"><i data-lucide="external-link" class="w-3 h-3 text-[#64748B]"></i></a>
            </div>
          </div>

          <!-- Lampiran Dinamis (Maksimal 3) -->
          <template x-for="(lamp, lIdx) in formItem.dokumen.lampiran" :key="lIdx">
            <div class="space-y-1">
              <div class="flex items-center justify-between">
                <label class="text-[11px] font-medium text-[#0F172A]" x-text="'Lampiran ' + (lIdx + 1)"></label>
                <button
                  type="button"
                  x-show="editingFormId === formItem.id"
                  @click="hapusLampiran(formItem, lIdx)"
                  class="text-[#94A3B8] hover:text-[#EF4444] transition-colors p-0.5 cursor-pointer"
                  :title="'Hapus Lampiran ' + (lIdx + 1)"
                >
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 6h18m-2 0v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6m3 0V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path>
                    <line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line>
                  </svg>
                </button>
                <span x-show="editingFormId !== formItem.id" class="text-[#CBD5E1]">
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 6h18m-2 0v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6m3 0V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path>
                    <line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line>
                  </svg>
                </span>
              </div>
              <div class="flex gap-1.5">
                <input
                  type="text"
                  placeholder="https://drive.google.com/file/d/..."
                  :readonly="editingFormId !== formItem.id"
                  x-model="formItem.dokumen.lampiran[lIdx]"
                  class="flex-1 h-8 px-2.5 rounded-[6px] border text-xs text-[#0F172A] outline-none transition-all"
                  :class="editingFormId === formItem.id ? 'bg-white border-[#2563EB] ring-2 ring-blue-100' : 'bg-[#F8FAFC] border-[#E2E8F0]'"
                />
                <a href="#" :href="formItem.dokumen.lampiran[lIdx]" target="_blank" rel="noopener noreferrer" class="h-8 px-2 rounded-[6px] border border-[#E2E8F0] bg-white hover:bg-[#F8FAFC] flex items-center justify-center shrink-0" title="Buka tautan dokumen">
                  <svg class="w-3 h-3 text-[#64748B]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line>
                  </svg>
                </a>
              </div>
            </div>
          </template>

          <!-- Tombol Tambah Lampiran (Maksimal 3 Lampiran Sesuai Desain) -->
          <div x-show="canAddLampiran(formItem)" class="pt-1">
            <button
              type="button"
              @click="tambahLampiran(formItem)"
              class="h-8 px-3 rounded-[6px] border border-dashed border-[#CBD5E1] hover:border-[#1E40AF] hover:text-[#1E40AF] bg-white text-xs font-medium text-[#0F172A] inline-flex items-center gap-1.5 transition-colors cursor-pointer shadow-2xs"
            >
              <svg class="w-3.5 h-3.5 text-[#64748B]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
              <span>Tambah Lampiran</span>
            </button>
          </div>
        </div>

        <!-- Aksi Simpan untuk Form Ini -->
        <div x-show="editingFormId === formItem.id" class="flex items-center justify-end gap-2 pt-1">
          <button
            type="button"
            @click="editingFormId = null"
            class="h-7 px-3 rounded-[6px] bg-white border border-[#E2E8F0] text-xs font-medium text-[#0F172A] hover:bg-[#F8FAFC] cursor-pointer"
          >
            Batal
          </button>
          <button
            type="button"
            @click="saveDokumenProgram(formItem.id)"
            class="h-7 px-3.5 rounded-[6px] bg-[#1E40AF] hover:bg-[#1E3A8A] text-white text-xs font-medium cursor-pointer shadow-2xs flex items-center gap-1"
          >
            <i data-lucide="save" class="w-3 h-3"></i>
            <span>Simpan Berkas</span>
          </button>
        </div>

        <!-- Informasi Tanggal Tutup Pendaftaran MBKM Ini -->
        <div class="p-3 bg-[#F8FAFC] rounded-lg border border-[#E2E8F0] flex items-center gap-2 text-xs text-[#475569]">
          <i data-lucide="calendar" class="w-4 h-4 text-[#1E40AF] shrink-0"></i>
          <span>Batas Akhir Pendaftaran Program: <strong class="text-[#0F172A]" x-text="formItem.tglTutup"></strong></span>
        </div>
      </div>
    </div>
  </template>
</div>
