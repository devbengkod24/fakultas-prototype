---
// src/components/mahasiswa/pendaftaran/TahapWawancara.astro
import { cn } from "../../../utils/cn";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const interviewSessions = [
  {
    id: "bk",
    nama: "Bengkel Koding",
    subnama: "Proyek Web & Mobile",
    skema: "Proyek Industri",
    hari: "Rabu, 22 Okt 2025",
    jam: "09:00 - 09:45 WIB",
    lokasi: "Online (Google Meet)",
    tautan: "https://meet.google.com/bengkod-fik-2025",
  },
  {
    id: "idss",
    nama: "IDSS Laboratory",
    subnama: "Riset Decision Support & AI",
    skema: "Publikasi & Riset",
    hari: "Kamis, 23 Okt 2025",
    jam: "13:30 - 14:15 WIB",
    lokasi: "Ruang Riset Lab IDSS, Gedung H Lt. 5",
    tautan: "#",
  },
  {
    id: "dicoding",
    nama: "Dicoding Indonesia",
    subnama: "Asah AI & Software Engineering",
    skema: "Studi Independen",
    hari: "Jumat, 24 Okt 2025",
    jam: "10:00 - 10:45 WIB",
    lokasi: "Online (Zoom Meeting)",
    tautan: "https://zoom.us/j/dicoding-mbkm-interview",
  },
];
---

<div x-show="currentStage === 'wawancara'" class={cn("rounded-xl border border-[#E2E8F0] bg-white p-5 sm:p-6 shadow-2xs space-y-5", className)}>
  <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-3 border-b border-[#E2E8F0] gap-2">
    <div>
      <h3 class="text-base font-semibold text-[#0F172A]">Jadwal & Informasi Pelaksanaan Wawancara</h3>
    </div>
  </div>

  <!-- Kartu Sesi Wawancara Per Program -->
  <div class="space-y-4">
    <div class="space-y-3">
      {interviewSessions.map((session, idx) => (
        <div class="p-4 rounded-lg border border-[#E2E8F0] bg-[#FFFFFF] hover:border-slate-300 transition-colors space-y-3">
          <div class="flex items-center gap-2.5 border-b border-[#F1F5F9] pb-2.5">
            <span class="w-6 h-6 rounded-md bg-[#F1F5F9] text-[#0F172A] text-xs font-semibold flex items-center justify-center shrink-0">
              {idx + 1}
            </span>
            <h5 class="text-sm font-semibold text-[#0F172A]">{session.nama}</h5>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs pt-0.5">
            <!-- Kolom 1: Jadwal & Waktu -->
            <div class="space-y-1.5">
              <span class="text-[#64748B] block text-[11px] font-medium">Jadwal & Waktu:</span>
              <strong class="font-semibold text-[#0F172A] block text-sm">{session.hari}</strong>
              <div class="text-[#64748B] flex items-center gap-1.5">
                <i data-lucide="clock" class="w-3.5 h-3.5 text-[#94A3B8]"></i>
                <span>{session.jam}</span>
              </div>
            </div>

            <!-- Kolom 2: Media / Lokasi -->
            <div class="space-y-2 sm:border-l sm:border-[#E2E8F0] sm:pl-5 flex flex-col justify-between">
              <div class="space-y-1">
                <span class="text-[#64748B] block text-[11px] font-medium">Media / Lokasi:</span>
                <span class="font-semibold text-[#0F172A] block text-sm">{session.lokasi}</span>
              </div>
              <div class="pt-0.5">
                {session.tautan !== "#" ? (
                  <a
                    href={session.tautan}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="h-7 px-2.5 rounded-[6px] bg-white border border-[#E2E8F0] hover:bg-[#F8FAFC] hover:border-slate-300 text-[#0F172A] text-xs font-medium inline-flex items-center gap-1.5 transition-colors shadow-2xs self-start"
                  >
                    <span>Akses Ruang Sesi</span>
                    <i data-lucide="external-link" class="w-3 h-3 text-[#64748B]"></i>
                  </a>
                ) : (
                  <span class="text-[#64748B] text-xs flex items-center gap-1">
                    <i data-lucide="map-pin" class="w-3.5 h-3.5 text-[#94A3B8]"></i>
                    <span>Hadir langsung tepat waktu di lokasi</span>
                  </span>
                )}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Footer Aksi Tahap 3 -->
  <div class="p-4 rounded-lg bg-[#F8FAFC] border border-[#E2E8F0] flex items-center justify-end">
    <button
      type="button"
      @click="setStage('prioritas')"
      class="h-9 px-4 rounded-[6px] bg-[#1E40AF] hover:bg-[#1E3A8A] text-white text-xs font-medium transition-colors cursor-pointer inline-flex items-center justify-center gap-1.5 shadow-2xs"
    >
      <span>Atur Urutan Prioritas</span>
      <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
    </button>
  </div>
</div>
