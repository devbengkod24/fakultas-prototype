---
// src/components/mahasiswa/pendaftaran/TahapPendaftaranReview.astro
import { cn } from "../../../utils/cn";
import ReviewFormCard from "./review/ReviewFormCard.astro";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div x-show="currentStage === 'pendaftaran'" class={cn("rounded-xl border border-[#E2E8F0] bg-white p-5 sm:p-6 shadow-2xs space-y-6", className)}>
  <!-- Header Tahap 1: Icon sejajar dengan judul teks -->
  <div class="pb-3 border-b border-[#E2E8F0] flex items-center gap-2">
    <i data-lucide="clipboard-list" class="w-5 h-5 text-[#1E40AF] shrink-0"></i>
    <h3 class="text-base font-semibold text-[#0F172A]">Daftar Formulir Pendaftaran MBKM (<span x-text="daftarFormMBKM.length"></span> Program)</h3>
  </div>

  <!-- Render Kartu Formulir Pendaftaran MBKM Masing-Masing -->
  <ReviewFormCard />

  <!-- Footer Aksi Tahap 1 -->
  <div class="p-4 rounded-lg bg-[#F8FAFC] border border-[#E2E8F0] flex items-center justify-end">
    <button
      type="button"
      @click="setStage('berkas')"
      class="h-9 px-4 rounded-[6px] bg-[#1E40AF] hover:bg-[#1E3A8A] text-white text-xs font-medium transition-colors cursor-pointer inline-flex items-center justify-center gap-1.5 shadow-2xs"
    >
      <span>Lanjut ke Seleksi Berkas</span>
      <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
    </button>
  </div>
</div>
