---
// src/components/mahasiswa/pendaftaran/TahapPrioritas.astro
import { cn } from "../../../utils/cn";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div x-show="currentStage === 'prioritas'" class={cn("rounded-xl border border-[#E2E8F0] bg-white p-5 sm:p-6 shadow-2xs space-y-5", className)}>
  <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-3 border-b border-[#E2E8F0] gap-2">
    <div>
      <h3 class="text-base font-semibold text-[#0F172A]">Urutan Prioritas Program MBKM</h3>
      <span class="text-xs text-[#64748B]" x-text="prioritasSaved ? 'Status: Terkunci' : 'Tarik item ke atas atau bawah'"></span>
    </div>
  </div>

  <!-- Form Pengurutan Prioritas Interaktif (Drag and Drop via HTML5 & Alpine) -->
  <div class="space-y-3">

    <div class="space-y-3">
      <template x-for="(prog, index) in priorityPrograms" :key="prog.id">
        <div
          :draggable="!prioritasSaved"
          @dragstart="dragStart($event, index)"
          @dragover="$event.preventDefault(); dragOver($event, index)"
          @dragleave="dragLeave($event, index)"
          @drop="dragDrop($event, index)"
          @dragend="dragEnd($event)"
          class="p-4 rounded-lg border bg-white flex flex-col sm:flex-row sm:items-center justify-between gap-3 transition-all select-none"
          :class="isDragOver === index ? 'border-[#1E40AF] ring-2 ring-blue-100 bg-[#EFF6FF]' : draggedIndex === index ? 'opacity-40 border-dashed border-slate-400' : index === 0 ? 'border-[#1E40AF]/30 ring-1 ring-[#1E40AF]/10 bg-[#EFF6FF]/20' : 'border-[#E2E8F0] hover:border-slate-300'"
        >
          <!-- Identitas & Badge Prioritas -->
          <div class="flex items-center gap-3">
            <!-- Ikon Titik 6 (Grip) di samping kiri tanpa teks -->
            <div
              x-show="!prioritasSaved"
              class="text-[#94A3B8] hover:text-[#0F172A] cursor-grab active:cursor-grabbing shrink-0 p-0.5"
              title="Tarik untuk mengubah urutan prioritas"
            >
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="9" cy="12" r="1"></circle>
                <circle cx="9" cy="5" r="1"></circle>
                <circle cx="9" cy="19" r="1"></circle>
                <circle cx="15" cy="12" r="1"></circle>
                <circle cx="15" cy="5" r="1"></circle>
                <circle cx="15" cy="19" r="1"></circle>
              </svg>
            </div>

            <div
              class="w-8 h-8 rounded-full flex items-center justify-center font-bold text-xs shrink-0 shadow-2xs"
              :class="index === 0 ? 'bg-[#1E40AF] text-white' : index === 1 ? 'bg-[#2563EB] text-white' : 'bg-[#64748B] text-white'"
            >
              <span x-text="index + 1"></span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-sm font-semibold text-[#0F172A]" x-text="prog.nama"></span>
              <span
                x-show="index === 0"
                class="px-2 py-0.5 rounded text-[11px] font-medium bg-[#F1F5F9] text-[#0F172A] border border-[#E2E8F0]"
              >
                Prioritas Utama
              </span>
            </div>
          </div>

          <!-- Status Kunci saat disimpan -->
          <div
            x-show="prioritasSaved"
            class="flex items-center gap-1 px-2.5 py-1 rounded bg-[#F1F5F9] text-[#64748B] text-xs font-medium self-end sm:self-center shrink-0"
          >
            <svg class="w-3.5 h-3.5 text-[#64748B]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
            <span>Urutan Terkunci</span>
          </div>
        </div>
      </template>
    </div>
  </div>

  <!-- Aksi Simpan Prioritas -->
  <div class="p-4 rounded-lg bg-[#F8FAFC] border border-[#E2E8F0] flex flex-col sm:flex-row sm:items-center justify-between gap-3">
    <div class="text-xs text-[#64748B]">
      Batas akhir penetapan urutan preferensi: <strong class="text-[#0F172A]">25 Okt 2025, 23:59 WIB</strong>.
    </div>
    <div class="flex items-center gap-2.5">
      <button
        type="button"
        x-show="prioritasSaved"
        @click="prioritasSaved = false"
        class="h-9 px-3 rounded-[6px] bg-white border border-[#E2E8F0] text-[#0F172A] hover:bg-[#F8FAFC] text-xs font-medium transition-colors cursor-pointer"
      >
        Ubah Pilihan
      </button>

      <button
        type="button"
        @click="savePriority()"
        class="h-9 px-4 rounded-[6px] bg-[#1E40AF] hover:bg-[#1E3A8A] text-white text-xs font-medium shadow-2xs transition-all cursor-pointer flex items-center gap-1.5"
      >
        <i data-lucide="save" class="w-3.5 h-3.5"></i>
        <span x-text="prioritasSaved ? 'Prioritas Telah Disimpan' : 'Simpan & Kunci Urutan'"></span>
      </button>

      <button
        type="button"
        @click="setStage('hasil')"
        class="h-9 px-3 rounded-[6px] bg-white border border-[#1E40AF] text-[#1E40AF] hover:bg-[#EFF6FF] text-xs font-medium transition-colors cursor-pointer flex items-center gap-1"
        title="Lihat Pratinjau Pengumuman Hasil Seleksi"
      >
        <span>Lihat Hasil Seleksi</span>
        <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
      </button>
    </div>
  </div>
</div>
