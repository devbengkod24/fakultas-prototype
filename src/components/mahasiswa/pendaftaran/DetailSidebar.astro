---
// src/components/mahasiswa/pendaftaran/DetailSidebar.astro
import { cn } from "../../../utils/cn";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class={cn("flex flex-col gap-4", className)}>
  <!-- Status Program Aktif & Riwayat Pendaftaran -->
  <div class="rounded-xl border border-[#e4e4e7] bg-white text-[#09090b] shadow-none overflow-hidden">
    <div class="flex items-center justify-between px-4 py-3 border-b border-[#e4e4e7]">
      <h3 class="text-sm font-semibold text-[#09090b]">Status & Riwayat Program</h3>
      <i data-lucide="layers" class="w-4 h-4 text-[#71717a]"></i>
    </div>

    <div class="divide-y divide-[#f4f4f5]">
      <template x-for="prog in daftarFormMBKM" :key="prog.id">
        <div
          @click="if (!prog.isRejectedHistory) selectedProgram = prog.id; expandedFormId = prog.id"
          class="relative px-4 py-3 space-y-0.5 cursor-pointer transition-colors"
          :class="prog.isRejectedHistory ? 'bg-[#f4f4f5]/80 opacity-75 hover:bg-[#f4f4f5]' : 'bg-white hover:bg-[#fafafa]'"
        >
          <div
            x-show="selectedProgram === prog.id && !prog.isRejectedHistory"
            class="absolute left-0 top-0 bottom-0 w-0.5 bg-[#0655a7]"
            aria-hidden="true"
          ></div>

          <div class="flex items-center justify-between gap-2">
            <span
              class="text-xs font-semibold truncate transition-colors"
              :class="prog.isRejectedHistory ? 'text-[#71717a]' : (selectedProgram === prog.id ? 'text-[#0655a7]' : 'text-[#09090b]')"
              x-text="prog.nama"
            ></span>
            <span
              x-show="prog.isRejectedHistory"
              class="text-[10px] font-semibold px-1.5 py-0.5 rounded bg-zinc-200/80 text-[#52525b] border border-[#d4d4d8] shrink-0"
            >
              Ditolak
            </span>
            <span
              x-show="!prog.isRejectedHistory && currentStage === 'hasil' && hasilSubState === 'lolos'"
              class="text-[10px] font-semibold px-1.5 py-0.5 rounded bg-emerald-50 text-emerald-800 border border-emerald-200 shrink-0"
            >
              Diterima
            </span>
            <span
              x-show="!prog.isRejectedHistory && currentStage === 'hasil' && hasilSubState === 'belum_lolos'"
              class="text-[10px] font-semibold px-1.5 py-0.5 rounded bg-red-50 text-red-700 border border-red-200 shrink-0"
            >
              Tidak Lolos
            </span>
            <span
              x-show="!prog.isRejectedHistory && currentStage === 'wawancara'"
              class="text-[10px] font-medium px-1.5 py-0.5 rounded border shrink-0"
              :class="prog.screeningLolos ? 'bg-[#f4f4f5] text-[#3f3f46] border-[#e4e4e7]' : 'bg-red-50 text-red-700 border-red-200'"
              x-text="prog.screeningLolos ? 'Wawancara Selesai' : 'Tidak Lolos'"
            ></span>
            <span
              x-show="!prog.isRejectedHistory && currentStage === 'berkas'"
              class="text-[10px] font-semibold px-1.5 py-0.5 rounded border shrink-0"
              :class="prog.screeningLolos ? 'bg-emerald-50 text-emerald-700 border-emerald-200' : 'bg-red-50 text-red-700 border-red-200'"
              x-text="prog.screeningLolos ? 'Lolos Berkas' : 'Tidak Lolos'"
            ></span>
            <span
              x-show="!prog.isRejectedHistory && currentStage === 'pendaftaran'"
              class="text-[10px] font-semibold px-1.5 py-0.5 rounded bg-blue-50 text-[#0655a7] border border-blue-200 shrink-0"
            >
              Form Terdaftar
            </span>
          </div>
          <div class="text-[11px] text-[#71717a]" x-text="prog.skema + ' • 20 SKS'"></div>
        </div>
      </template>
    </div>
  </div>
</div>
