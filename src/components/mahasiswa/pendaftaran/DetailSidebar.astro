---
// src/components/mahasiswa/pendaftaran/DetailSidebar.astro
import { cn } from "../../../utils/cn";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class={cn("space-y-5", className)}>
  <!-- 1. Ringkasan Data Mahasiswa -->
  <div class="rounded-xl border border-[#E2E8F0] bg-white p-5 shadow-2xs space-y-3.5">
    <div class="flex items-center justify-between pb-2.5 border-b border-[#E2E8F0]">
      <div class="flex items-center gap-2">
        <i data-lucide="user-check" class="w-4 h-4 text-[#1E40AF]"></i>
        <h3 class="text-sm font-semibold text-[#0F172A]">Identitas Mahasiswa</h3>
      </div>
      <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold bg-[#ECFDF5] text-[#065F46] border border-[#A7F3D0]">
        Data Valid
      </span>
    </div>

    <div class="space-y-2 text-xs">
      <div class="flex justify-between items-center py-1 border-b border-[#F8FAFC]">
        <span class="text-[#64748B]">Nama Lengkap:</span>
        <strong class="font-semibold text-[#0F172A]">Ahmad Rizky Pratama</strong>
      </div>
      <div class="flex justify-between items-center py-1 border-b border-[#F8FAFC]">
        <span class="text-[#64748B]">NIM:</span>
        <span class="font-mono font-medium text-[#0F172A]">A11.2020.00001</span>
      </div>
      <div class="flex justify-between items-center py-1 border-b border-[#F8FAFC]">
        <span class="text-[#64748B]">Program Studi:</span>
        <span class="font-medium text-[#0F172A]">Teknik Informatika - S1</span>
      </div>
      <div class="flex justify-between items-center py-1 border-b border-[#F8FAFC]">
        <span class="text-[#64748B]">Semester / TA:</span>
        <span class="font-medium text-[#0F172A]">Semester 7 (2024/2025)</span>
      </div>
      <div class="flex justify-between items-center py-1">
        <span class="text-[#64748B]">IPK / SKS Lulus:</span>
        <span class="font-semibold text-[#0F172A]">3.68 / 110 SKS</span>
      </div>
    </div>
  </div>

  <!-- 2. Status Ringkas 3 Program yang Diajukan -->
  <div class="rounded-xl border border-[#E2E8F0] bg-white p-5 shadow-2xs space-y-3.5">
    <div class="flex items-center justify-between pb-2.5 border-b border-[#E2E8F0]">
      <div class="flex items-center gap-2">
        <i data-lucide="layers" class="w-4 h-4 text-[#1E40AF]"></i>
        <h3 class="text-sm font-semibold text-[#0F172A]">Program yang Dilamar (3)</h3>
      </div>
      <span class="text-xs text-[#64748B]">Maks 3 MBKM</span>
    </div>

    <div class="space-y-2.5">
      <template x-for="(prog, idx) in priorityPrograms" :key="prog.id">
        <div
          class="p-2.5 rounded-lg border bg-[#F8FAFC] space-y-1 transition-all"
          :class="selectedProgram === prog.id ? 'border-[#1E40AF] ring-2 ring-blue-100' : 'border-[#E2E8F0]'"
        >
          <div class="flex items-center justify-between">
            <span class="text-xs font-semibold text-[#0F172A]" x-text="(idx + 1) + '. ' + prog.nama"></span>
            <span
              x-show="currentStage === 'hasil' && hasilSubState === 'lolos'"
              x-text="idx === 0 ? 'Diterima' : 'Gugur'"
              class="text-[10px] font-semibold px-1.5 py-0.5 rounded border"
              :class="idx === 0 ? 'bg-[#ECFDF5] text-[#065F46] border-[#A7F3D0]' : 'bg-[#F1F5F9] text-[#475569] border-[#E2E8F0]'"
            ></span>
            <span
              x-show="currentStage === 'hasil' && hasilSubState === 'belum_lolos'"
              class="text-[10px] font-semibold px-1.5 py-0.5 rounded bg-[#FEF2F2] text-[#991B1B] border border-[#FECACA]"
            >
              Tidak Lolos
            </span>
            <span
              x-show="currentStage === 'prioritas'"
              class="text-[10px] font-semibold px-1.5 py-0.5 rounded border"
              :class="idx === 0 ? 'bg-[#ECFDF5] text-[#065F46] border-[#A7F3D0]' : 'bg-[#EFF6FF] text-[#1E40AF] border-[#BFDBFE]'"
              x-text="'Pilihan ' + (idx + 1)"
            ></span>
            <span
              x-show="currentStage === 'wawancara'"
              class="text-[10px] font-semibold px-1.5 py-0.5 rounded bg-[#ECFDF5] text-[#065F46] border border-[#A7F3D0]"
            >
              Wawancara Selesai
            </span>
            <span
              x-show="currentStage === 'berkas'"
              class="text-[10px] font-semibold px-1.5 py-0.5 rounded bg-[#ECFDF5] text-[#065F46] border border-[#A7F3D0]"
            >
              Lolos Berkas
            </span>
            <span
              x-show="currentStage === 'pendaftaran'"
              class="text-[10px] font-semibold px-1.5 py-0.5 rounded bg-blue-50 text-[#0655a7] border border-blue-100"
            >
              Form Terdaftar
            </span>
          </div>
          <div class="text-[11px] text-[#64748B]" x-text="prog.skema + ' • 20 SKS'"></div>
        </div>
      </template>
    </div>
  </div>

  <!-- 3. Informasi Penting & Bantuan Koordinator -->
  <div class="rounded-xl border border-[#E2E8F0] bg-white p-5 shadow-2xs space-y-3">
    <div class="flex items-center gap-2 pb-2.5 border-b border-[#E2E8F0]">
      <i data-lucide="help-circle" class="w-4 h-4 text-[#1E40AF]"></i>
      <h3 class="text-sm font-semibold text-[#0F172A]">Bantuan Koordinator MBKM</h3>
    </div>

    <p class="text-xs text-[#64748B] leading-relaxed">
      Jika mengalami kendala teknis atau memiliki pertanyaan seputar jadwal wawancara dan ploting Dosen Pembimbing, hubungi tim helpdesk fakultas:
    </p>

    <div class="space-y-2 text-xs pt-1">
      <div class="flex items-center gap-2 text-[#0F172A]">
        <i data-lucide="mail" class="w-3.5 h-3.5 text-[#64748B]"></i>
        <span class="font-medium">mbkm.fik@dinus.ac.id</span>
      </div>
      <div class="flex items-center gap-2 text-[#0F172A]">
        <i data-lucide="phone" class="w-3.5 h-3.5 text-[#64748B]"></i>
        <span class="font-medium">+62 812-3456-7890 (Helpdesk FIK)</span>
      </div>
      <div class="flex items-center gap-2 text-[#0F172A]">
        <i data-lucide="map-pin" class="w-3.5 h-3.5 text-[#64748B]"></i>
        <span class="font-medium">Ruang Koordinator MBKM, Gd. H Lt. 1</span>
      </div>
    </div>
  </div>
</div>
