---
// src/components/mahasiswa/sidang/DokumenPersyaratanSidang.astro
// 4 field inputs: Judul Laporan, File Laporan Akhir, Link Video Sosial Media, Foto Lembar Bimbingan MBKM
---

<div
  class="bg-white border border-[#e4e4e7] rounded-xl"
  x-data={`{
    judulLaporan: '',
    fileLaporan: '',
    linkVideo: '',
    fotoLembar: ''
  }`}
>
  <div class="px-5 py-4 border-b border-[#e4e4e7]">
    <h2 class="text-base font-semibold text-[#09090b]">Dokumen Persyaratan Sidang</h2>
    <p class="text-xs text-[#71717a] mt-0.5">Lengkapi seluruh dokumen berikut sebelum sidang dilaksanakan.</p>
  </div>

  <div class="px-5 py-5 space-y-4">
    <!-- 1. Judul Laporan -->
    <div class="space-y-1.5">
      <label for="judul-laporan" class="block text-xs font-medium text-[#09090b]">
        Judul Laporan <span class="text-red-500">*</span>
      </label>
      <input
        id="judul-laporan"
        type="text"
        x-model="judulLaporan"
        placeholder="Masukkan judul laporan akhir MBKM Anda"
        class="w-full h-9 px-3 rounded-md border border-[#e4e4e7] bg-white text-xs text-[#09090b] placeholder:text-[#a1a1aa] focus:outline-none focus:border-[#0655a7] focus:ring-2 focus:ring-blue-100 transition-all"
      />
    </div>

    <!-- 2. File Laporan Akhir -->
    <div class="space-y-1.5">
      <label for="file-laporan" class="block text-xs font-medium text-[#09090b]">
        File Laporan Akhir <span class="text-red-500">*</span>
      </label>
      <input
        id="file-laporan"
        type="text"
        x-model="fileLaporan"
        placeholder="https://drive.google.com/file/d/... (PDF)"
        class="w-full h-9 px-3 rounded-md border border-[#e4e4e7] bg-white text-xs text-[#09090b] placeholder:text-[#a1a1aa] focus:outline-none focus:border-[#0655a7] focus:ring-2 focus:ring-blue-100 transition-all"
      />
      <p class="text-[11px] text-[#71717a]">Unggah file PDF laporan ke Google Drive dan salin tautannya di sini.</p>
    </div>

    <!-- 3. Link Video Sosial Media -->
    <div class="space-y-1.5">
      <label for="link-video" class="block text-xs font-medium text-[#09090b]">
        Link Video Sosial Media <span class="text-red-500">*</span>
      </label>
      <input
        id="link-video"
        type="url"
        x-model="linkVideo"
        placeholder="https://www.instagram.com/reel/... atau https://youtube.com/shorts/..."
        class="w-full h-9 px-3 rounded-md border border-[#e4e4e7] bg-white text-xs text-[#09090b] placeholder:text-[#a1a1aa] focus:outline-none focus:border-[#0655a7] focus:ring-2 focus:ring-blue-100 transition-all"
      />
      <p class="text-[11px] text-[#71717a]">Tautan video dokumentasi kegiatan di Instagram, YouTube, atau TikTok.</p>
    </div>

    <!-- 4. Foto Lembar Bimbingan MBKM -->
    <div class="space-y-1.5">
      <label for="foto-lembar" class="block text-xs font-medium text-[#09090b]">
        Foto Lembar Bimbingan MBKM <span class="text-red-500">*</span>
      </label>
      <input
        id="foto-lembar"
        type="text"
        x-model="fotoLembar"
        placeholder="https://drive.google.com/file/d/... (JPG/PNG)"
        class="w-full h-9 px-3 rounded-md border border-[#e4e4e7] bg-white text-xs text-[#09090b] placeholder:text-[#a1a1aa] focus:outline-none focus:border-[#0655a7] focus:ring-2 focus:ring-blue-100 transition-all"
      />
      <p class="text-[11px] text-[#71717a]">Unggah foto lembar bimbingan ke Google Drive dan salin tautannya di sini.</p>
    </div>
  </div>

  <!-- Footer Action -->
  <div class="px-5 py-3.5 border-t border-[#e4e4e7] bg-[#fafafa] flex items-center justify-end gap-2">
    <button
      type="button"
      class="h-8 px-3.5 rounded-md border border-[#e4e4e7] bg-white hover:bg-[#f4f4f5] text-[#09090b] text-xs font-medium transition-colors cursor-pointer shadow-none"
    >
      Batal
    </button>
    <button
      type="button"
      @click="alert('Dokumen berhasil disimpan!')"
      class="h-8 px-4 rounded-md bg-[#0655a7] hover:bg-[#114d91] text-white text-xs font-medium transition-colors cursor-pointer shadow-none"
    >
      Simpan Dokumen
    </button>
  </div>
</div>
