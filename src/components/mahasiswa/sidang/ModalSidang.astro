---
// src/components/mahasiswa/sidang/ModalSidang.astro
import { cn } from "../../../utils/cn";
import type { SidangData } from "../../../data/mahasiswa/sidangData";

interface Props {
  data: SidangData;
}

const { data } = Astro.props;
---

<!-- Modal 1: Tata Tertib & Detail Jadwal Sidang -->
<div id="modal-jadwal" class={cn("hidden fixed inset-0 z-50 bg-black/50 flex items-center justify-center p-4")}>
  <div class="bg-white rounded-xl border border-[#e4e4e7] p-6 max-w-lg w-full space-y-4 shadow-xl">
    <div class="flex items-center justify-between pb-3 border-b border-[#e4e4e7]">
      <div class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-md bg-[#fafafa] border border-[#e4e4e7] text-[#0655a7] flex items-center justify-center shrink-0">
          <i data-lucide="info" class="w-4 h-4"></i>
        </div>
        <div>
          <h3 class="text-base font-semibold text-[#09090b]">Informasi & Tata Tertib Sidang</h3>
          <p class="text-xs text-[#71717a]">Ketentuan pelaksanaan sidang evaluasi akhir</p>
        </div>
      </div>
      <button type="button" onclick="closeJadwalModal()" class="text-[#71717a] hover:text-[#09090b] p-1.5 rounded-md transition-colors" aria-label="Tutup modal">
        <i data-lucide="x" class="w-4 h-4"></i>
      </button>
    </div>

    <div class="space-y-3 text-xs leading-relaxed">
      <div class="p-3 bg-[#fafafa] border border-[#e4e4e7] rounded-lg space-y-1">
        <span class="text-[#71717a] block">Waktu & Tempat:</span>
        <span class="font-semibold text-[#09090b] text-sm">{data.jadwal.tanggal} ({data.jadwal.waktu})</span>
        <p class="text-xs text-[#71717a]">{data.jadwal.lokasi}</p>
      </div>

      <div class="p-3 bg-amber-50 border border-amber-200 text-amber-800 rounded-lg space-y-1">
        <div class="font-semibold flex items-center gap-1.5 text-xs">
          <i data-lucide="alert-triangle" class="w-4 h-4"></i>
          <span>Ketentuan Wajib Peserta</span>
        </div>
        <ul class="list-disc pl-4 space-y-1 text-xs">
          <li>Hadir di ruang sidang 15 menit sebelum jadwal dimulai.</li>
          <li>Mengenakan jas almamater resmi, kemeja putih, dan celana/rok hitam.</li>
          <li>Menyiapkan materi presentasi maksimal 15 slide ringkas.</li>
          <li>Laporan telah diverifikasi oleh Dosen Pembimbing.</li>
        </ul>
      </div>
    </div>

    <div class="pt-3 border-t border-[#e4e4e7] flex items-center justify-end">
      <button type="button" onclick="closeJadwalModal()" class="h-9 px-4 rounded-md border border-[#e4e4e7] bg-white hover:bg-[#f4f4f5] text-[#09090b] text-xs font-medium transition-colors">
        Tutup
      </button>
    </div>
  </div>
</div>

<!-- Modal 2: Pengajuan Reschedule Sidang -->
<div id="modal-reschedule" class="hidden fixed inset-0 z-50 bg-black/50 flex items-center justify-center p-4">
  <div class="bg-white rounded-xl border border-[#e4e4e7] p-6 max-w-lg w-full space-y-4 shadow-xl">
    <div class="flex items-center justify-between pb-3 border-b border-[#e4e4e7]">
      <div>
        <h3 class="text-base font-semibold text-[#09090b]">Permohonan Reschedule Sidang</h3>
        <p class="text-xs text-[#71717a] mt-0.5">Pengajuan perubahan jadwal sidang ke koordinator program</p>
      </div>
      <button type="button" onclick="closeRescheduleModal()" class="text-[#71717a] hover:text-[#09090b] p-1.5 rounded-md transition-colors" aria-label="Tutup modal">
        <i data-lucide="x" class="w-4 h-4"></i>
      </button>
    </div>

    <form id="form-reschedule-sidang" class="space-y-4">
      <div>
        <label class="block text-xs font-semibold text-[#09090b] mb-1">
          Alasan Rescheduling <span class="text-rose-500">*</span>
        </label>
        <textarea rows="3" required placeholder="Tuliskan kendala atau alasan mendesak pengajuan jadwal ulang..." class="w-full px-3 py-2 bg-[#fafafa] border border-[#e4e4e7] rounded-md text-xs font-medium text-[#09090b] focus:outline-none focus:ring-1 focus:ring-[#0655a7] resize-none"></textarea>
      </div>

      <div>
        <label class="block text-xs font-semibold text-[#09090b] mb-1">
          Usulan Tanggal Baru <span class="text-rose-500">*</span>
        </label>
        <input type="date" required class="w-full px-3 py-2 bg-[#fafafa] border border-[#e4e4e7] rounded-md text-xs font-medium text-[#09090b] focus:outline-none focus:ring-1 focus:ring-[#0655a7]" />
      </div>

      <div class="pt-3 border-t border-[#e4e4e7] flex items-center justify-end gap-2">
        <button type="button" onclick="closeRescheduleModal()" class="h-9 px-4 rounded-md border border-[#e4e4e7] bg-white hover:bg-[#f4f4f5] text-[#09090b] text-xs font-medium transition-colors">
          Batal
        </button>
        <button type="submit" class="h-9 px-4 rounded-md bg-[#0655a7] hover:bg-[#114d91] text-white text-xs font-semibold shadow-none transition-colors">
          Kirim Permohonan
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Modal 3: Tambah Berkas Persyaratan Sidang -->
<div id="modal-upload-berkas" class="hidden fixed inset-0 z-50 bg-black/50 flex items-center justify-center p-4">
  <div class="bg-white rounded-xl border border-[#e4e4e7] p-6 max-w-lg w-full space-y-4 shadow-xl">
    <div class="flex items-center justify-between pb-3 border-b border-[#e4e4e7]">
      <div class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-md bg-[#fafafa] border border-[#e4e4e7] text-[#0655a7] flex items-center justify-center shrink-0">
          <i data-lucide="file-plus" class="w-4 h-4"></i>
        </div>
        <div>
          <h3 class="text-base font-semibold text-[#09090b]">Tambah Berkas Sidang</h3>
          <p class="text-xs text-[#71717a]">Unggah dokumen persyaratan evaluasi sidang</p>
        </div>
      </div>
      <button type="button" onclick="closeModalUploadBerkas()" class="text-[#71717a] hover:text-[#09090b] p-1.5 rounded-md transition-colors cursor-pointer" aria-label="Tutup modal">
        <i data-lucide="x" class="w-4 h-4"></i>
      </button>
    </div>

    <form id="form-upload-berkas" class="space-y-4">
      <div>
        <label class="block text-xs font-semibold text-[#09090b] mb-1">
          Pilih Berkas Dokumen <span class="text-rose-500">*</span>
        </label>
        <input id="upload-file-input" type="file" required accept=".pdf,.doc,.docx,.zip" class="w-full text-xs text-[#09090b] file:mr-3 file:py-1.5 file:px-3 file:rounded-md file:border file:border-[#e4e4e7] file:text-xs file:font-semibold file:bg-white file:text-[#09090b] hover:file:bg-[#f4f4f5] file:cursor-pointer p-1.5 border border-[#e4e4e7] rounded-md bg-[#fafafa]" />
        <span class="text-[10px] text-[#71717a] mt-1 block">Format: PDF, DOCX, ZIP (Maks. 25 MB)</span>
      </div>

      <div>
        <label class="block text-xs font-semibold text-[#09090b] mb-1">
          Catatan / Deskripsi Berkas
        </label>
        <textarea id="upload-deskripsi" rows="3" placeholder="Tuliskan catatan kelengkapan berkas jika ada..." class="w-full px-3 py-2 bg-[#fafafa] border border-[#e4e4e7] rounded-md text-xs font-medium text-[#09090b] focus:outline-none focus:ring-1 focus:ring-[#0655a7] resize-none"></textarea>
      </div>

      <div class="pt-3 border-t border-[#e4e4e7] flex items-center justify-end gap-2">
        <button type="button" onclick="closeModalUploadBerkas()" class="h-9 px-4 rounded-md border border-[#e4e4e7] bg-white hover:bg-[#f4f4f5] text-[#09090b] text-xs font-medium transition-colors cursor-pointer">
          Batal
        </button>
        <button type="submit" class="h-9 px-4 rounded-md bg-[#0655a7] hover:bg-[#114d91] text-white text-xs font-semibold shadow-none transition-colors cursor-pointer">
          Unggah Berkas
        </button>
      </div>
    </form>
  </div>
</div>
