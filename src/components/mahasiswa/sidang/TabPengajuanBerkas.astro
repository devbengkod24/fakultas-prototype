---
// src/components/mahasiswa/sidang/TabPengajuanBerkas.astro
import { cn } from "../../../utils/cn";
import type { SidangData } from "../../../data/mahasiswa/sidangData";

interface Props {
  data: SidangData;
}

const { data } = Astro.props;
---

<div class={cn("space-y-6")}>
  <!-- Card 1: Informasi Pelaksanaan Kegiatan -->
  <div class="bg-white border border-[#e4e4e7] rounded-xl p-6 space-y-5">
    <div class="flex items-center gap-3 pb-3 border-b border-[#e4e4e7]">
      <div class="w-9 h-9 rounded-lg bg-[#fafafa] border border-[#e4e4e7] text-[#0655a7] flex items-center justify-center shrink-0">
        <i data-lucide="file-text" class="w-4 h-4"></i>
      </div>
      <div>
        <h2 class="text-base font-semibold text-[#09090b]">Informasi Program & Bimbingan</h2>
        <p class="text-xs text-[#71717a] leading-relaxed">Rincian penugasan magang dan penetapan Dosen Pembimbing</p>
      </div>
    </div>

    <div class="space-y-4">
      <div>
        <label class="block text-xs font-semibold text-[#09090b] mb-1.5">Judul Kegiatan / Proyek</label>
        <input
          type="text"
          readonly
          value={data.judulKB}
          class="w-full px-3.5 py-2 bg-[#fafafa] border border-[#e4e4e7] rounded-md text-xs font-medium text-[#09090b] focus:outline-none"
        />
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold text-[#09090b] mb-1.5">Mitra Industri / Perusahaan</label>
          <input
            type="text"
            readonly
            value={data.perusahaan}
            class="w-full px-3.5 py-2 bg-[#fafafa] border border-[#e4e4e7] rounded-md text-xs font-medium text-[#09090b] focus:outline-none"
          />
        </div>
        <div>
          <label class="block text-xs font-semibold text-[#09090b] mb-1.5">Posisi Magang</label>
          <input
            type="text"
            readonly
            value={data.posisi}
            class="w-full px-3.5 py-2 bg-[#fafafa] border border-[#e4e4e7] rounded-md text-xs font-medium text-[#09090b] focus:outline-none"
          />
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold text-[#09090b] mb-1.5">Dosen Pembimbing</label>
          <input
            type="text"
            readonly
            value={data.dosenPembimbing}
            class="w-full px-3.5 py-2 bg-[#fafafa] border border-[#e4e4e7] rounded-md text-xs font-medium text-[#09090b] focus:outline-none"
          />
        </div>
        <div>
          <label class="block text-xs font-semibold text-[#09090b] mb-1.5">Periode Pelaksanaan</label>
          <input
            type="text"
            readonly
            value={`${data.periodeMulai} — ${data.periodeSelesai}`}
            class="w-full px-3.5 py-2 bg-[#fafafa] border border-[#e4e4e7] rounded-md text-xs font-medium text-[#09090b] focus:outline-none"
          />
        </div>
      </div>
    </div>
  </div>

  <!-- Card 2: Informasi Penyelia Mitra -->
  <div class="bg-white border border-[#e4e4e7] rounded-xl p-6 space-y-5">
    <div class="flex items-center gap-3 pb-3 border-b border-[#e4e4e7]">
      <div class="w-9 h-9 rounded-lg bg-[#fafafa] border border-[#e4e4e7] text-[#0655a7] flex items-center justify-center shrink-0">
        <i data-lucide="user-check" class="w-4 h-4"></i>
      </div>
      <div>
        <h2 class="text-base font-semibold text-[#09090b]">Informasi Penyelia Lapangan</h2>
        <p class="text-xs text-[#71717a] leading-relaxed">Mentor pembimbing dari pihak institusi mitra kerja</p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div>
        <label class="block text-xs font-semibold text-[#09090b] mb-1.5">Nama Penyelia</label>
        <input
          type="text"
          readonly
          value={data.penyelia.nama}
          class="w-full px-3.5 py-2 bg-[#fafafa] border border-[#e4e4e7] rounded-md text-xs font-medium text-[#09090b] focus:outline-none"
        />
      </div>
      <div>
        <label class="block text-xs font-semibold text-[#09090b] mb-1.5">Jabatan / Posisi</label>
        <input
          type="text"
          readonly
          value={data.penyelia.posisi}
          class="w-full px-3.5 py-2 bg-[#fafafa] border border-[#e4e4e7] rounded-md text-xs font-medium text-[#09090b] focus:outline-none"
        />
      </div>
      <div>
        <label class="block text-xs font-semibold text-[#09090b] mb-1.5">Nilai Evaluasi Mitra</label>
        <div class="flex items-center gap-2">
          <input
            type="text"
            readonly
            value={`${data.penyelia.nilaiEvaluasi} / 100`}
            class="w-full px-3.5 py-2 bg-[#fafafa] border border-[#e4e4e7] rounded-md text-xs font-bold text-emerald-700 focus:outline-none"
          />
        </div>
      </div>
    </div>
  </div>

  <!-- Card 3: Dokumen Persyaratan Sidang -->
  <div class="bg-white border border-[#e4e4e7] rounded-xl p-6 space-y-5">
    <div class="flex items-center justify-between pb-3 border-b border-[#e4e4e7] flex-wrap gap-2">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-lg bg-[#fafafa] border border-[#e4e4e7] text-[#0655a7] flex items-center justify-center shrink-0">
          <i data-lucide="folder-check" class="w-4 h-4"></i>
        </div>
        <div>
          <h2 class="text-base font-semibold text-[#09090b]">Dokumen Persyaratan Sidang</h2>
          <p class="text-xs text-[#71717a] leading-relaxed">Lengkapi berkas wajib persyaratan untuk kelayakan sidang</p>
        </div>
      </div>
    </div>

    <form id="form-persyaratan-sidang" class="space-y-5">
      <!-- Judul Laporan -->
      <div class="space-y-2">
        <label for="input-judul-laporan" class="block text-xs font-semibold text-[#09090b]">
          Judul Laporan
        </label>
        <input
          type="text"
          id="input-judul-laporan"
          value={data.judulKB}
          placeholder="Masukkan judul laporan akhir..."
          class="w-full h-9 px-3 rounded-md border border-[#e4e4e7] bg-white text-xs text-[#09090b] focus:border-[#0655a7] focus:ring-2 focus:ring-blue-100 outline-none"
        />
      </div>

      <!-- File Laporan Akhir (PDF) -->
      <div class="pt-4 border-t border-[#e4e4e7] space-y-2.5">
        <label for="upload-laporan-akhir" class="block text-xs font-semibold text-[#09090b]">
          File Laporan Akhir (PDF)
        </label>
        <input
          type="file"
          id="upload-laporan-akhir"
          accept=".pdf"
          class="w-full text-xs text-[#09090b] file:mr-3 file:py-1.5 file:px-3 file:rounded-md file:border file:border-[#e4e4e7] file:text-xs file:font-semibold file:bg-white file:text-[#09090b] hover:file:bg-[#f4f4f5] file:cursor-pointer p-1.5 border border-[#e4e4e7] rounded-md bg-[#fafafa]"
        />
        <div class="flex items-center justify-between gap-2">
          <span class="text-[10px] text-[#71717a]">
            Format: PDF (Maks. 25 MB)
          </span>
          <a
            href="https://bit.ly/laporan_akhir_kampus_berdampak_STI_UDINUS_genap_2025_2026"
            target="_blank"
            class="text-xs text-[#0655a7] hover:underline"
          >
            Unduh template laporan
          </a>
        </div>
        <div id="laporan-akhir-file-info" class="hidden text-xs text-[#09090b] bg-[#fafafa] border border-[#e4e4e7] rounded-md px-3 py-2"></div>
      </div>

      <!-- Link Video Sosial Media -->
      <div class="pt-4 border-t border-[#e4e4e7] space-y-2.5">
        <label for="input-link-video" class="block text-xs font-semibold text-[#09090b]">
          Link Video Sosial Media
        </label>
        <div class="flex items-center gap-2">
          <input
            type="url"
            id="input-link-video"
            value={data.linkVideoSosialMedia}
            placeholder="https://..."
            class="flex-1 h-9 px-3 rounded-md border border-[#e4e4e7] bg-white text-xs text-[#09090b] focus:border-[#0655a7] focus:ring-2 focus:ring-blue-100 outline-none"
          />
          <a
            href={data.linkVideoSosialMedia}
            target="_blank"
            class="h-9 px-3 rounded-md bg-[#0655a7] hover:bg-[#114d91] text-white text-xs font-semibold shadow-none transition-colors inline-flex items-center gap-1 shrink-0"
          >
            <i data-lucide="external-link" class="w-3.5 h-3.5"></i>
            <span>Buka</span>
          </a>
        </div>
        <p class="text-[10px] text-[#71717a]">
          Tautan video kegiatan di media sosial (Instagram Reels, TikTok, YouTube Shorts, dll.)
        </p>
      </div>

      <!-- Foto Lembar Bimbingan MBKM -->
      <div class="pt-4 border-t border-[#e4e4e7] space-y-2.5">
        <label for="upload-lembar-bimbingan" class="block text-xs font-semibold text-[#09090b]">
          Foto Lembar Bimbingan MBKM
        </label>
        <input
          type="file"
          id="upload-lembar-bimbingan"
          accept="image/*,.pdf"
          class="w-full text-xs text-[#09090b] file:mr-3 file:py-1.5 file:px-3 file:rounded-md file:border file:border-[#e4e4e7] file:text-xs file:font-semibold file:bg-white file:text-[#09090b] hover:file:bg-[#f4f4f5] file:cursor-pointer p-1.5 border border-[#e4e4e7] rounded-md bg-[#fafafa]"
        />
        <div class="flex items-center justify-between gap-2">
          <span class="text-[10px] text-[#71717a]">
            Format: JPG, PNG, PDF (Maks. 10 MB)
          </span>
        </div>
        <div id="lembar-bimbingan-file-info" class="hidden text-xs text-[#09090b] bg-[#fafafa] border border-[#e4e4e7] rounded-md px-3 py-2"></div>
      </div>

      <!-- Upload Nilai dari Mitra -->
      <div class="pt-4 border-t border-[#e4e4e7] space-y-2.5">
        <label for="upload-nilai-mitra" class="block text-xs font-semibold text-[#09090b]">
          Upload Nilai dari Mitra
        </label>
        <input
          type="file"
          id="upload-nilai-mitra"
          accept=".pdf,.doc,.docx"
          class="w-full text-xs text-[#09090b] file:mr-3 file:py-1.5 file:px-3 file:rounded-md file:border file:border-[#e4e4e7] file:text-xs file:font-semibold file:bg-white file:text-[#09090b] hover:file:bg-[#f4f4f5] file:cursor-pointer p-1.5 border border-[#e4e4e7] rounded-md bg-[#fafafa]"
        />
        <div class="flex items-center justify-between gap-2">
          <span class="text-[10px] text-[#71717a]">
            Format: PDF, DOCX (Maks. 25 MB)
          </span>
        </div>
        <div id="nilai-mitra-file-info" class="hidden text-xs text-[#09090b] bg-[#fafafa] border border-[#e4e4e7] rounded-md px-3 py-2"></div>
      </div>

      <!-- Upload Sertifikat -->
      <div class="pt-4 border-t border-[#e4e4e7] space-y-2.5">
        <label for="upload-sertifikat" class="block text-xs font-semibold text-[#09090b]">
          Upload Sertifikat
        </label>
        <input
          type="file"
          id="upload-sertifikat"
          accept=".pdf"
          class="w-full text-xs text-[#09090b] file:mr-3 file:py-1.5 file:px-3 file:rounded-md file:border file:border-[#e4e4e7] file:text-xs file:font-semibold file:bg-white file:text-[#09090b] hover:file:bg-[#f4f4f5] file:cursor-pointer p-1.5 border border-[#e4e4e7] rounded-md bg-[#fafafa]"
        />
        <div class="flex items-center justify-between gap-2">
          <span class="text-[10px] text-[#71717a]">
            Format: PDF (Maks. 25 MB)
          </span>
        </div>
        <div id="sertifikat-file-info" class="hidden text-xs text-[#09090b] bg-[#fafafa] border border-[#e4e4e7] rounded-md px-3 py-2"></div>
      </div>

      <!-- Tombol Simpan -->
      <div class="pt-4 border-t border-[#e4e4e7] flex justify-end">
        <button
          type="submit"
          class="inline-flex items-center gap-1.5 h-9 px-4 rounded-md bg-[#0655a7] hover:bg-[#114d91] text-white text-xs font-semibold shadow-none transition-colors cursor-pointer"
        >
          <i data-lucide="save" class="w-4 h-4"></i>
          <span>Simpan Persyaratan</span>
        </button>
      </div>
    </form>

    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const bindFileInfo = (inputId, infoId) => {
          const input = document.getElementById(inputId);
          const info = document.getElementById(infoId);
          if (!input || !info) return;
          input.addEventListener('change', () => {
            const file = input.files && input.files[0];
            if (file) {
              info.innerHTML = `
                <div class="flex items-center gap-2 text-xs">
                  <i data-lucide="file-check-2" class="w-3.5 h-3.5 text-emerald-600 shrink-0"></i>
                  <span class="truncate">${file.name}</span>
                  <span class="text-[#71717a] text-[10px] shrink-0">(${(file.size / 1024 / 1024).toFixed(2)} MB)</span>
                </div>
              `;
              info.classList.remove('hidden');
              if (window.lucide) window.lucide.createIcons();
            } else {
              info.classList.add('hidden');
              info.innerHTML = '';
            }
          });
        };

        bindFileInfo('upload-laporan-akhir', 'laporan-akhir-file-info');
        bindFileInfo('upload-lembar-bimbingan', 'lembar-bimbingan-file-info');
        bindFileInfo('upload-nilai-mitra', 'nilai-mitra-file-info');
        bindFileInfo('upload-sertifikat', 'sertifikat-file-info');

        const form = document.getElementById('form-persyaratan-sidang');
        if (form) {
          form.addEventListener('submit', (e) => {
            e.preventDefault();
            alert('Dokumen persyaratan sidang berhasil disimpan.');
          });
        }
      });
    </script>
  </div>
</div>
