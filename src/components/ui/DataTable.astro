---
// src/components/ui/DataTable.astro
import { Search } from 'lucide-astro';
import type { DataTableTab } from '../../types';

interface Props {
  searchPlaceholder?: string;
  searchModel?: string;
  tabs?: DataTableTab[];
  activeTabModel?: string;
  totalItems?: number;
  infoText?: string;
  class?: string;
}

const {
  searchPlaceholder = 'Cari data...',
  searchModel = 'searchQuery',
  tabs,
  activeTabModel = 'activeTab',
  totalItems,
  infoText,
  class: className = '',
} = Astro.props;
---

<div class={`space-y-4 ${className}`}>
  <!-- 1. Category Tabs Bar (Jika disediakan) -->
  {tabs && tabs.length > 0 && (
    <div class="w-full border-b border-[#e4e4e7] mb-2">
      <div class="flex gap-2 overflow-x-auto pb-0.5">
        {tabs.map((tab) => (
          <button
            type="button"
            @click={`${activeTabModel} = '${tab.id}'`}
            class="flex items-center gap-2 px-4 py-2.5 text-sm font-medium border-b-2 transition-colors shrink-0 cursor-pointer"
            :class={`${activeTabModel} === '${tab.id}' ? 'border-[#0655a7] text-[#0655a7] font-semibold' : 'border-transparent text-[#71717a] hover:text-[#09090b]'`}
          >
            <span>{tab.label}</span>
            {typeof tab.count === 'number' && (
              <span
                class="ml-1 px-1.5 py-0.5 text-xs rounded-full font-semibold transition-colors"
                :class={`${activeTabModel} === '${tab.id}' ? 'bg-blue-100 text-[#0655a7]' : 'bg-gray-100 text-[#71717a]'`}
              >
                {tab.count}
              </span>
            )}
          </button>
        ))}
      </div>
    </div>
  )}

  <!-- 2. Toolbar: Search Bar, Extra Filters, & Actions Slot -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
    <!-- Left: Search Box & Filter Slot -->
    <div class="flex flex-wrap items-center gap-2 w-full sm:w-auto flex-1">
      <div class="relative w-full sm:w-72 md:w-80">
        <Search class="w-4 h-4 text-[#71717a] absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none" />
        <input
          type="text"
          x-model={searchModel}
          placeholder={searchPlaceholder}
          class="h-9 w-full rounded-md border border-[#e4e4e7] bg-white pl-9 pr-3 text-sm text-[#09090b] placeholder:text-[#71717a] focus:outline-none focus:ring-1 focus:ring-[#0655a7] shadow-2xs transition-all"
        />
      </div>

      <!-- Slot untuk Filter Tambahan (dropdown prodi, status, dll.) -->
      {Astro.slots.has('filters') && (
        <div class="flex items-center gap-2">
          <slot name="filters" />
        </div>
      )}
    </div>

    <!-- Right: Actions Slot (Tombol Tambah, Export, Sync, dll.) -->
    {Astro.slots.has('actions') && (
      <div class="flex items-center gap-2 shrink-0">
        <slot name="actions" />
      </div>
    )}
  </div>

  <!-- 3. Tabel Container (Shadcn/Tailwind Card Style) -->
  <div class="rounded-lg border border-[#e4e4e7] overflow-hidden bg-white shadow-2xs">
    <div class="overflow-x-auto">
      <table class="w-full text-sm text-left border-collapse">
        <thead class="border-b border-[#e4e4e7] bg-[#fafafa] text-[#71717a] text-xs font-semibold uppercase tracking-wider">
          <slot name="head" />
        </thead>
        <tbody class="divide-y divide-[#e4e4e7] bg-white">
          <slot />
        </tbody>
      </table>
    </div>
  </div>

  <!-- 4. Footer Pagination & Status Info -->
  <div class="pt-2 flex flex-col md:flex-row items-center justify-between gap-3 text-xs text-[#71717a]">
    <div>
      {infoText ? infoText : (totalItems ? `Menampilkan ${totalItems} data` : 'Menampilkan data')}
    </div>
    <div class="flex items-center gap-1">
      <slot name="pagination" />
    </div>
  </div>
</div>
