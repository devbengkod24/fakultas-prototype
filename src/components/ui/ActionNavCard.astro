---
// src/components/ui/ActionNavCard.astro
interface Props {
  title: string;
  subtitle: string;
  icon?: string;
  iconColor?: string;
  href?: string;
  onclick?: string;
  actionLabel?: string;
  class?: string;
}

const {
  title,
  subtitle,
  icon = 'chevron-right',
  iconColor = 'text-orange-500',
  href,
  onclick,
  actionLabel = 'Lihat Selengkapnya',
  class: className = '',
} = Astro.props;
---

<div class={`rounded-xl border border-[#e4e4e7] bg-white shadow-none flex flex-col justify-between overflow-hidden ${className}`}>
  <!-- Card Header Content -->
  <div class="flex flex-col p-4 pb-2">
    <div class="flex items-center justify-between gap-2 font-medium text-gray-800">
      <p class="text-sm font-semibold text-[#09090b]">{title}</p>
      {icon && <i data-lucide={icon} class={`w-4 h-4 ${iconColor}`}></i>}
    </div>
    <div>
      <p class="text-xs text-[#71717a] mt-1">{subtitle}</p>
    </div>
  </div>

  <!-- Action Bottom Bar -->
  {href ? (
    <a href={href} class="cursor-pointer block">
      <div class="rounded-b-xl bg-blue-500/5 hover:bg-blue-500/10 transition-colors group">
        <div class="px-4 py-2 flex justify-between items-center text-[#0655a7] text-xs font-medium">
          <span>{actionLabel}</span>
          <i data-lucide="chevron-right" class="w-4 h-4 transition-transform group-hover:translate-x-1"></i>
        </div>
      </div>
    </a>
  ) : (
    <div onclick={onclick} class="cursor-pointer">
      <div class="rounded-b-xl bg-blue-500/5 hover:bg-blue-500/10 transition-colors group">
        <div class="px-4 py-2 flex justify-between items-center text-[#0655a7] text-xs font-medium">
          <span>{actionLabel}</span>
          <i data-lucide="chevron-right" class="w-4 h-4 transition-transform group-hover:translate-x-1"></i>
        </div>
      </div>
    </div>
  )}
</div>
