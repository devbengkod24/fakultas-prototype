---
// src/components/ui/LogbookChartCard.astro
// Chart Logbook Kegiatan: 24 slot minggu tetap, bar aktual mengikuti minggu berjalan.
import { cn } from '../../utils/cn';

interface Props {
  title?: string;
  /** Total kegiatan per minggu yang sudah berjalan (index 0 = M-1). Panjang array = minggu berjalan. */
  weeklyCounts: number[];
  /** Minggu berjalan (1-based). Bar minggu ini selalu tampil paling gelap. Default: panjang weeklyCounts. */
  currentWeek?: number;
  totalWeeks?: number;
  /** Batas atas skala sumbu Y agar tinggi bar konsisten antar minggu. */
  yMax?: number;
  onTimeRate?: string;
  rekapHref?: string;
  rekapOnclick?: string;
  class?: string;
}

const {
  title = 'Logbook Kegiatan',
  weeklyCounts,
  currentWeek: currentWeekProp,
  totalWeeks = 24,
  yMax = 10,
  onTimeRate = '92%',
  rekapHref,
  rekapOnclick,
  class: className = '',
} = Astro.props;

const currentWeek = Math.max(0, Math.min(currentWeekProp ?? weeklyCounts.length, weeklyCounts.length, totalWeeks));
const progressPct = Math.round((currentWeek / totalWeeks) * 100);
const axisLabels = [1, 4, 8, 12, 16, 20, 24].filter((w) => w <= totalWeeks);

const slots = Array.from({ length: totalWeeks }, (_, i) => {
  const week = i + 1;
  const isElapsed = week <= currentWeek;
  const count = isElapsed ? (weeklyCounts[i] ?? 0) : null;
  const heightPct = count ? Math.max(4, Math.min(100, (count / yMax) * 100)) : 0;
  // Tooltip di tepi kiri/kanan dirapatkan agar tidak keluar dari card.
  const tipAlign = week <= 3 ? 'left-0' : week > totalWeeks - 3 ? 'right-0' : 'left-1/2 -translate-x-1/2';
  const isCurrent = week === currentWeek;
  return { week, isElapsed, isCurrent, count, heightPct, tipAlign };
});
---

<div
  data-logbook-chart
  class={cn('rounded-xl border border-[#e4e4e7] bg-white p-5 flex flex-col justify-between shadow-none', className)}
>
  <div class="flex items-center justify-between gap-3 mb-4">
    <h3 class="font-semibold text-sm text-[#09090b]">{title}</h3>
    <div class="flex items-center gap-2 shrink-0" title={`Progres periode: minggu ${currentWeek} dari ${totalWeeks}`}>
      <div class="w-14 h-1.5 bg-[#f4f4f5] rounded-full overflow-hidden">
        <div class="h-full bg-[#0655a7] rounded-full" style={`width: ${progressPct}%`}></div>
      </div>
      <span class="text-xs text-[#71717a]"><strong class="font-semibold text-[#09090b]">{currentWeek}</strong>/{totalWeeks} minggu</span>
    </div>
  </div>

  <!-- Bar chart: 24 slot tetap -->
  <div class="h-28 flex items-end gap-[3px] sm:gap-1 border-b border-[#e4e4e7]" role="list" aria-label={`${title} per minggu`}>
    {slots.map((s) => (
      <div class="relative flex-1 min-w-0 h-full flex items-end group" role="listitem">
        {s.isElapsed ? (
          <button
            type="button"
            data-week={s.week}
            data-selected="false"
            aria-current={s.isCurrent ? 'date' : undefined}
            aria-label={`Minggu ke-${s.week}${s.isCurrent ? ' (minggu berjalan)' : ''}: ${s.count} mahasiswa`}
            class="peer group/bar w-full h-full flex items-end rounded-t-[3px] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0655a7]/30"
          >
            {s.count ? (
              <span
                class={cn(
                  'block w-full rounded-t-[3px] transition-colors',
                  s.isCurrent
                    ? 'bg-[#0655a7]'
                    : 'bg-blue-200 group-hover/bar:bg-blue-300 group-data-[selected=true]/bar:bg-blue-400'
                )}
                style={`height: ${s.heightPct}%`}
              ></span>
            ) : (
              <span
                class={cn(
                  'block w-full h-[3px] rounded-[1px]',
                  s.isCurrent ? 'bg-[#0655a7]' : 'bg-blue-300 group-data-[selected=true]/bar:bg-blue-400'
                )}
              ></span>
            )}
          </button>
        ) : (
          <span class="block w-full h-full rounded-t-[3px] bg-[#f4f4f5]/70" aria-label={`Minggu ke-${s.week}: belum berjalan`}></span>
        )}
        <div
          class={cn(
            'pointer-events-none absolute bottom-full mb-1.5 z-10 whitespace-nowrap rounded-md bg-[#09090b] px-2 py-1 text-[11px] leading-tight text-white shadow-sm',
            'opacity-0 transition-opacity group-hover:opacity-100 peer-focus-visible:opacity-100',
            s.tipAlign
          )}
        >
          <div class="font-semibold">Minggu ke-{s.week}{s.isCurrent && <span class="font-normal text-white/70"> · berjalan</span>}</div>
          <div class="text-white/70">{s.isElapsed ? `${s.count} mahasiswa submit` : 'Belum berjalan'}</div>
        </div>
      </div>
    ))}
  </div>

  <!-- Label sumbu X selektif -->
  <div class="grid pt-1.5" style={`grid-template-columns: repeat(${totalWeeks}, minmax(0, 1fr))`}>
    {axisLabels.map((w) => (
      <span
        class={cn(
          'text-[10px] text-center whitespace-nowrap',
          w === currentWeek ? 'font-semibold text-[#0655a7]' : 'text-[#71717a]'
        )}
        style={`grid-column: ${w}`}
      >M-{w}</span>
    ))}
  </div>

  <div class="flex items-center justify-between text-xs text-[#71717a] pt-3">
    <span>Rata-rata tepat waktu: <strong class="text-green-700">{onTimeRate}</strong></span>
    {rekapHref && (
      <a href={rekapHref} class="text-[#0655a7] hover:underline font-medium flex items-center gap-1">
        <span>Rekap</span>
        <span>&rarr;</span>
      </a>
    )}
    {!rekapHref && rekapOnclick && (
      <button type="button" onclick={rekapOnclick} class="text-[#0655a7] hover:underline font-medium">Rekap &rarr;</button>
    )}
  </div>
</div>

<script>
  // Pilih minggu: klik bar aktual untuk menandainya (biru sedang); minggu berjalan tetap biru tua.
  document.querySelectorAll<HTMLElement>('[data-logbook-chart]').forEach((chart) => {
    chart.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-week]');
      if (!btn) return;
      chart.querySelectorAll('button[data-week]').forEach((b) => b.setAttribute('data-selected', 'false'));
      btn.setAttribute('data-selected', 'true');
    });
  });
</script>
