---
interface Props {
  title: string;
  value: string | number;
  subtitle?: string;
  change?: string;
  changeType?: 'up' | 'down' | 'neutral';
  class?: string;
}

const {
  title,
  value,
  subtitle,
  change,
  changeType = 'neutral',
  class: className = '',
} = Astro.props;

const changeColors = {
  up: 'text-emerald-600 bg-emerald-50 border-emerald-200/50',
  down: 'text-rose-600 bg-rose-50 border-rose-200/50',
  neutral: 'text-slate-600 bg-slate-50 border-slate-200/50',
};
---

<div class={`bg-white rounded-xl border border-slate-200/80 p-5 shadow-xs flex flex-col justify-between ${className}`}>
  <div class="flex items-start justify-between">
    <div>
      <p class="text-xs font-medium text-slate-500 uppercase tracking-wider">{title}</p>
      <h3 class="text-2xl font-bold text-slate-900 mt-1">{value}</h3>
    </div>
    <div class="p-2.5 rounded-lg bg-slate-50 border border-slate-100 text-slate-600">
      <slot name="icon" />
    </div>
  </div>

  {(change || subtitle) && (
    <div class="mt-4 flex items-center gap-2 pt-3 border-t border-slate-100 text-xs">
      {change && (
        <span class={`inline-flex items-center px-1.5 py-0.5 rounded font-medium border ${changeColors[changeType]}`}>
          {change}
        </span>
      )}
      {subtitle && <span class="text-slate-500">{subtitle}</span>}
    </div>
  )}
</div>
