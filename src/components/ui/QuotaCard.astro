---
// src/components/ui/QuotaCard.astro
interface Props {
  title?: string;
  total: number | string;
  totalLabel?: string;
  used: number | string;
  usedLabel?: string;
  class?: string;
}

const {
  title = 'Informasi Kuota Bimbingan',
  total = 60,
  totalLabel = 'Total Alokasi',
  used = 48,
  usedLabel = 'Kuota Terpakai',
  class: className = '',
} = Astro.props;
---

<div class={`rounded-xl border border-[#e4e4e7] bg-white p-3 shadow-none ${className}`}>
  <p class="mb-3 text-sm font-medium text-[#09090b]">{title}</p>
  <div class="grid grid-cols-2 items-center gap-3">
    <!-- Total Alokasi -->
    <div class="bg-blue-500/10 rounded-xl p-2.5">
      <div class="flex items-center gap-3">
        <div class="rounded-lg p-2 bg-blue-500/10 text-blue-500 shrink-0">
          <i data-lucide="clipboard-list" class="h-4 w-4"></i>
        </div>
        <div class="min-w-0">
          <div class="font-bold text-sm text-blue-600">{total}</div>
          <div class="text-xs text-[#71717a] truncate">{totalLabel}</div>
        </div>
      </div>
    </div>

    <!-- Kuota Terpakai -->
    <div class="bg-orange-500/10 rounded-xl p-2.5">
      <div class="flex items-center gap-3">
        <div class="rounded-lg p-2 bg-orange-500/10 text-orange-500 shrink-0">
          <i data-lucide="user" class="h-4 w-4"></i>
        </div>
        <div class="min-w-0">
          <div class="font-bold text-sm text-orange-500">{used}</div>
          <div class="text-xs text-[#71717a] truncate">{usedLabel}</div>
        </div>
      </div>
    </div>
  </div>
</div>
