---
// src/components/dosen/MahasiswaDetailDrawer.astro
---
<!-- Overlay backdrop -->
<div
  x-show="drawerOpen"
  x-cloak
  x-transition:enter="transition ease-out duration-200"
  x-transition:enter-start="opacity-0"
  x-transition:enter-end="opacity-100"
  x-transition:leave="transition ease-in duration-150"
  x-transition:leave-start="opacity-100"
  x-transition:leave-end="opacity-0"
  class="fixed inset-0 z-40 bg-black/40"
  @click="closeDetail()"
  aria-hidden="true"
></div>

<!-- Panel Drawer Slide-over dari kanan -->
<div
  x-show="drawerOpen"
  x-cloak
  x-effect="if (drawerOpen && selectedStudent) { $nextTick(() => { if (window.lucide) window.lucide.createIcons(); }); }"
  @keydown.escape.window="if (drawerOpen) closeDetail()"
  x-transition:enter="transition ease-out duration-300"
  x-transition:enter-start="translate-x-full"
  x-transition:enter-end="translate-x-0"
  x-transition:leave="transition ease-in duration-200"
  x-transition:leave-start="translate-x-0"
  x-transition:leave-end="translate-x-full"
  class="fixed inset-y-0 right-0 z-50 w-full max-w-lg bg-white shadow-2xl flex flex-col overflow-hidden"
  role="dialog"
  aria-modal="true"
  aria-labelledby="drawer-detail-title"
>
  <!-- Header Drawer -->
  <div class="flex items-center justify-between px-6 py-4 border-b border-[#e2e8f0] shrink-0">
    <h2 id="drawer-detail-title" class="text-base font-semibold text-[#0f172a]">Detail Mahasiswa</h2>
    <button
      type="button"
      @click="closeDetail()"
      class="h-8 w-8 flex items-center justify-center rounded-md border border-[#e2e8f0] hover:bg-gray-50 text-[#64748b] hover:text-[#0f172a] transition-colors"
      aria-label="Tutup detail mahasiswa"
    >
      <i data-lucide="x" class="w-4 h-4"></i>
    </button>
  </div>

  <!-- Body Drawer (scrollable) -->
  <div class="flex-1 overflow-y-auto px-6 py-4 space-y-6" x-show="selectedStudent !== null">
    <!-- === SECTION 1: BIODATA === -->
    <div>
      <h3 class="text-xs font-semibold text-[#64748b] uppercase tracking-wider mb-3">Biodata</h3>
      <div class="flex items-center gap-4 mb-4">
        <div
          class="h-12 w-12 rounded-full bg-[#f4f4f5] border border-[#e4e4e7] text-[#09090b] flex items-center justify-center font-semibold text-sm shrink-0 tracking-wide"
          x-text="getInitials(selectedStudent?.nama)"
        ></div>
        <div>
          <div class="font-semibold text-[#09090b] text-sm" x-text="selectedStudent?.nama"></div>
          <div class="text-xs text-[#71717a] mt-0.5" x-text="selectedStudent?.nim"></div>
        </div>
      </div>
      <div class="space-y-2 text-sm">
        <div class="flex items-center gap-2 text-[#64748b]">
          <i data-lucide="mail" class="w-4 h-4 shrink-0"></i>
          <span x-text="selectedStudent?.email"></span>
        </div>
        <div class="flex items-center gap-2 text-[#64748b]">
          <i data-lucide="phone" class="w-4 h-4 shrink-0"></i>
          <span x-text="selectedStudent?.telepon"></span>
        </div>
      </div>
    </div>
    <div class="border-t border-[#f1f5f9]"></div>
    <!-- === SECTION 2: INFO MBKM === -->
    <div>
      <h3 class="text-xs font-semibold text-[#64748b] uppercase tracking-wider mb-3">Info MBKM</h3>
      <div class="grid grid-cols-2 gap-3 text-sm">
        <div>
          <div class="text-[11px] text-[#94a3b8] mb-0.5">Skema MBKM</div>
          <div class="font-medium text-[#0f172a]" x-text="selectedStudent?.skema || '-'"></div>
        </div>
        <div>
          <div class="text-[11px] text-[#94a3b8] mb-0.5">SKS Konversi</div>
          <div class="font-medium text-[#0f172a]" x-text="(selectedStudent?.sks || 0) + ' SKS'"></div>
        </div>
        <div>
          <div class="text-[11px] text-[#94a3b8] mb-0.5">Mitra / Tempat</div>
          <div class="font-medium text-[#0f172a]" x-text="selectedStudent?.mitra || '-'"></div>
        </div>
        <div>
          <div class="text-[11px] text-[#94a3b8] mb-0.5">Posisi</div>
          <div class="font-medium text-[#0f172a]" x-text="selectedStudent?.posisi || '-'"></div>
        </div>
        <div class="col-span-2">
          <div class="text-[11px] text-[#94a3b8] mb-0.5">Periode Aktif</div>
          <div class="font-medium text-[#0f172a]" x-text="selectedStudent?.periodeAktif || '-'"></div>
        </div>
      </div>
    </div>
    <div class="border-t border-[#f1f5f9]"></div>
    <!-- === SECTION 3: LOGBOOK KEGIATAN (Matrix 24 Minggu) === -->
    <div>
      <div class="flex items-center justify-between flex-wrap gap-2 mb-3">
        <h3 class="text-xs font-semibold text-[#64748b] uppercase tracking-wider">
          Logbook Kegiatan
          <span class="normal-case font-normal text-[#94a3b8]">(24 Minggu)</span>
        </h3>
        <!-- Status summary badges -->
        <div class="flex items-center gap-1.5 flex-wrap">
          <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-medium bg-emerald-50 text-emerald-700 border border-emerald-200">
            <span x-text="approvedCount"></span> Disetujui
          </span>
          <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-medium bg-amber-50 text-amber-700 border border-amber-200" x-show="pendingCount > 0">
            <span x-text="pendingCount"></span> Perlu Review
          </span>
          <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-medium bg-slate-50 text-slate-500 border border-slate-200">
            <span x-text="unsubmittedCount"></span> Belum Diisi
          </span>
        </div>
      </div>

      <!-- Matrix 24 Kotak Minggu -->
      <div class="mb-4">
        <div class="flex items-center justify-between text-[11px] text-[#64748b] mb-1.5">
          <span class="font-medium">Pilih Minggu:</span>
          <button
            type="button"
            x-show="pendingCount > 0"
            @click="nextPendingWeek()"
            class="text-xs text-amber-700 hover:text-amber-800 font-medium inline-flex items-center gap-1 hover:underline"
          >
            <span>Lompat ke Perlu Review</span>
            <i data-lucide="chevrons-right" class="w-3.5 h-3.5"></i>
          </button>
        </div>

        <!-- Grid 6 Kolom x 4 Baris -->
        <div class="grid grid-cols-6 gap-1.5 p-2 bg-[#f8fafc] rounded-lg border border-[#e2e8f0]">
          <template x-for="entry in (selectedStudent?.logbookEntries || [])" :key="entry.minggu">
            <button
              type="button"
              @click="selectWeek(entry.minggu)"
              :class="{
                'ring-2 ring-[#0655a7] ring-offset-1 font-bold z-10 shadow-sm': selectedWeek === entry.minggu,
                'bg-emerald-50 text-emerald-800 border-emerald-300 hover:bg-emerald-100': entry.status === 'Disetujui',
                'bg-amber-100 text-amber-900 border-amber-400 font-bold hover:bg-amber-200 ring-1 ring-amber-300': entry.status === 'Perlu Review',
                'bg-white text-slate-400 border-slate-200 hover:bg-slate-50': entry.status === 'Belum Diisi'
              }"
              class="relative h-9 rounded-md border flex flex-col items-center justify-center text-xs transition-all"
              :title="`Minggu ${entry.minggu}: ${entry.status}`"
            >
              <span class="leading-none" x-text="entry.minggu"></span>
              <!-- Status dot -->
              <span
                class="w-1.5 h-1.5 rounded-full mt-0.5"
                :class="{
                  'bg-emerald-500': entry.status === 'Disetujui',
                  'bg-amber-600': entry.status === 'Perlu Review',
                  'bg-slate-300': entry.status === 'Belum Diisi'
                }"
              ></span>
            </button>
          </template>
        </div>
      </div>

      <!-- Card Detail Minggu Terpilih -->
      <div class="border border-[#e2e8f0] rounded-xl bg-white overflow-hidden shadow-sm">
        <!-- Header Card -->
        <div class="px-4 py-3 bg-[#fafafa] border-b border-[#e2e8f0] flex items-center justify-between">
          <div>
            <div class="font-semibold text-sm text-[#0f172a] flex items-center gap-2">
              <span x-text="`Minggu ${selectedWeek}`"></span>
              <span class="text-xs font-normal text-[#64748b]" x-text="`${currentEntry?.tanggalMulai} – ${currentEntry?.tanggalSelesai}`"></span>
            </div>
          </div>
          <div>
            <template x-if="currentEntry?.status === 'Disetujui'">
              <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-50 text-emerald-700 border border-emerald-200">
                <i data-lucide="check-circle" class="w-3.5 h-3.5"></i>
                <span>Disetujui</span>
              </span>
            </template>
            <template x-if="currentEntry?.status === 'Perlu Review'">
              <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-50 text-amber-700 border border-amber-200">
                <i data-lucide="clock" class="w-3.5 h-3.5"></i>
                <span>Perlu Review</span>
              </span>
            </template>
            <template x-if="currentEntry?.status === 'Belum Diisi'">
              <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-medium bg-slate-50 text-slate-500 border border-slate-200">
                <span>Belum Diisi</span>
              </span>
            </template>
          </div>
        </div>

        <!-- Body Card -->
        <div class="p-4 space-y-4">
          <!-- State Belum Diisi -->
          <div x-show="currentEntry?.status === 'Belum Diisi'" class="py-8 text-center text-sm text-[#94a3b8]">
            <i data-lucide="file-clock" class="w-8 h-8 mx-auto mb-2 text-slate-300"></i>
            <p>Mahasiswa belum mengisi laporan kegiatan pada minggu ini.</p>
          </div>

          <!-- State Terisi (Perlu Review / Disetujui) -->
          <div x-show="currentEntry?.status !== 'Belum Diisi'" class="space-y-4">
            <!-- Deskripsi Kegiatan -->
            <div>
              <label class="text-[11px] font-semibold text-[#64748b] uppercase tracking-wider block mb-1">Kegiatan Mahasiswa</label>
              <div class="text-sm text-[#0f172a] leading-relaxed bg-[#f8fafc] p-3 rounded-lg border border-[#e2e8f0]" x-text="currentEntry?.deskripsi || '-'"></div>
            </div>

            <!-- Bukti Dokumen -->
            <div x-show="currentEntry?.buktiLink">
              <label class="text-[11px] font-semibold text-[#64748b] uppercase tracking-wider block mb-1">Bukti / Dokumen Luaran</label>
              <a
                :href="currentEntry?.buktiLink"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md border border-[#e2e8f0] text-xs font-medium text-blue-600 hover:bg-blue-50 transition-colors"
              >
                <i data-lucide="external-link" class="w-3.5 h-3.5"></i>
                <span>Buka Berkas Bukti (Google Drive)</span>
              </a>
            </div>

            <!-- Catatan Dosen -->
            <div>
              <label class="text-[11px] font-semibold text-[#64748b] uppercase tracking-wider block mb-1">Catatan / Umpan Balik Dosen</label>
              <textarea
                x-model="currentEntry.catatanDosen"
                placeholder="Tuliskan catatan evaluasi atau instruksi untuk mahasiswa..."
                rows="2"
                class="w-full border border-[#e2e8f0] rounded-lg px-3 py-2 text-xs text-[#0f172a] focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 resize-none bg-white"
              ></textarea>
            </div>

            <!-- Tombol Validasi -->
            <div class="flex items-center justify-end pt-1">
              <template x-if="currentEntry?.status !== 'Disetujui'">
                <button
                  type="button"
                  @click="currentEntry.status = 'Disetujui'; selectedStudent.logbookPendingReview = pendingCount; $nextTick(() => { if (window.lucide) window.lucide.createIcons(); });"
                  class="inline-flex items-center gap-1.5 px-4 py-2 bg-emerald-600 text-white text-xs font-semibold rounded-lg hover:bg-emerald-700 transition-colors shadow-sm"
                >
                  <i data-lucide="check" class="w-4 h-4"></i>
                  <span>Validasi Minggu Ini</span>
                </button>
              </template>
              <template x-if="currentEntry?.status === 'Disetujui'">
                <button
                  type="button"
                  @click="currentEntry.status = 'Perlu Review'; selectedStudent.logbookPendingReview = pendingCount; $nextTick(() => { if (window.lucide) window.lucide.createIcons(); });"
                  class="inline-flex items-center gap-1.5 px-4 py-2 border border-amber-300 bg-amber-50 text-amber-800 text-xs font-medium rounded-lg hover:bg-amber-100 transition-colors"
                >
                  <i data-lucide="rotate-ccw" class="w-4 h-4"></i>
                  <span>Batalkan Validasi</span>
                </button>
              </template>
            </div>
          </div>
        </div>

        <!-- Footer Card: Navigasi Minggu -->
        <div class="px-4 py-2.5 bg-[#f8fafc] border-t border-[#e2e8f0] flex items-center justify-between text-xs text-[#64748b]">
          <button
            type="button"
            @click="prevWeek()"
            :disabled="selectedWeek <= 1"
            :class="selectedWeek <= 1 ? 'opacity-40 cursor-not-allowed' : 'hover:text-[#0f172a] hover:bg-white'"
            class="inline-flex items-center gap-1 px-2.5 py-1 rounded border border-[#e2e8f0] transition-colors"
          >
            <i data-lucide="chevron-left" class="w-3.5 h-3.5"></i>
            <span>Sebelumnya</span>
          </button>

          <span class="font-medium text-[#0f172a]">
            Minggu <span x-text="selectedWeek"></span> dari 24
          </span>

          <button
            type="button"
            @click="nextWeek()"
            :disabled="selectedWeek >= 24"
            :class="selectedWeek >= 24 ? 'opacity-40 cursor-not-allowed' : 'hover:text-[#0f172a] hover:bg-white'"
            class="inline-flex items-center gap-1 px-2.5 py-1 rounded border border-[#e2e8f0] transition-colors"
          >
            <span>Selanjutnya</span>
            <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>
