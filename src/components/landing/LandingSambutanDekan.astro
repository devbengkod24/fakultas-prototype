        <!-- ===================================================================
         [Komponen: SambutanDekan]
         - Dot-matrix pattern di belakang foto (sesuai request)
         - Desain frame depan & foto ikut versi terbaru
         - Kapsul [ FTC | SAMBUTAN DEKAN ] sesuai Gambar 32
         - Tombol "Pelajari Lebih Lanjut" dengan panah kuning
         - Link "Lihat Struktur Organisasi"
    ==================================================================== -->
        <section class="py-20 lg:py-28">
            <div class="container grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
                <!-- Left: Foto Dekan dengan Dot-Matrix Background + Frame Terbaru -->
                <div class="lg:col-span-5">
                    <div class="relative isolate mx-auto max-w-sm">
                        <!-- Dot-Matrix Pattern Layer di belakang (inset dikecilkan di HP agar tidak keluar layar) -->
                        <div class="bg-dot-matrix absolute -inset-3 -z-20 rounded-3xl sm:-inset-5"></div>
                        <!-- Solid Gold Offset Block -->
                        <div class="absolute -bottom-3.5 -left-3.5 -z-10 h-full w-full rounded-xl bg-gold"></div>

                        <!-- Front Photo Card (Desain Terbaru) -->
                        <div class="relative overflow-hidden rounded-xl shadow-md">
                            <img src="https://images.unsplash.com/photo-1560250097-0b93528c311a?auto=format&fit=crop&w=800&q=80"
                                alt="Sri Winarno, M.Kom., Ph.D." loading="lazy" decoding="async"
                                class="h-[360px] w-full object-cover object-top sm:h-[410px]" />
                            <div class="border-t-4 border-gold bg-primary px-5 py-4 text-white">
                                <div class="text-base font-bold">Sri Winarno, M.Kom., Ph.D.</div>
                                <div class="text-xs font-medium text-white/80">Dekan Fakultas Teknologi Cerdas</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right: Konten Sambutan Dekan -->
                <div class="lg:col-span-7">
                    <div class="split-badge mb-4">
                        <span class="split-badge-left">FTC</span>
                        <span class="split-badge-right">SAMBUTAN DEKAN</span>
                    </div>

                    <h2 class="section-title text-deep">
                        FTC UDINUS: Semangat, Inovatif, Unggul!
                    </h2>
                    <p class="section-desc">
                        Transformasi Fakultas Ilmu Komputer menjadi Fakultas Teknologi Cerdas untuk menjawab tantangan
                        masa depan.
                    </p>

                    <blockquote
                        class="mt-7 rounded-r-xl border-l-4 border-gold bg-muted/70 py-5 pl-5 pr-5 text-base italic leading-relaxed text-foreground/90 sm:pl-6 sm:pr-6 sm:text-lg">
                        "Fakultas Teknologi Cerdas (FTC) UDINUS berperan penting dalam mencetak generasi muda yang
                        inovatif, berdaya saing global, dan siap memimpin perkembangan kecerdasan buatan serta teknologi
                        masa depan."
                    </blockquote>

                    <div class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-4">
                        <button data-go="profil" class="btn btn-default btn-lg">
                            Pelajari Lebih Lanjut
                            <i data-lucide="arrow-right" class="h-4 w-4 text-gold"></i>
                        </button>
                        <button data-go="profil"
                            class="inline-flex items-center gap-1.5 text-sm font-bold text-info transition-colors hover:text-deep">
                            Lihat Struktur Organisasi <i data-lucide="chevron-right" class="h-4 w-4"></i>
                        </button>
                    </div>
                </div>
            </div>
        </section>
