---
---
        <!-- [Komponen: QuickStatsBar] — 3 Metrik API dev-sti + 1 Kredibilitas Akreditasi -->
        <section class="container relative z-20 -mt-12 lg:-mt-14">
            <div class="card grid gap-px overflow-hidden bg-border shadow-md sm:grid-cols-2 lg:grid-cols-4">
                <div class="flex items-center gap-4 bg-card p-5 sm:p-6">
                    <div
                        class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary">
                        <i data-lucide="users" class="h-6 w-6"></i>
                    </div>
                    <div>
                        <div class="text-2xl font-extrabold tabular-nums tracking-tight text-primary"><span
                                data-count="15" data-suffix="K+">15K+</span></div>
                        <div class="text-xs font-medium text-muted-foreground sm:text-sm">Alumni Sukses</div>
                    </div>
                </div>

                <div class="flex items-center gap-4 bg-card p-5 sm:p-6">
                    <div
                        class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary">
                        <i data-lucide="graduation-cap" class="h-6 w-6"></i>
                    </div>
                    <div>
                        <div class="text-2xl font-extrabold tabular-nums tracking-tight text-primary"><span
                                data-count="95" data-suffix="%">95%</span></div>
                        <div class="text-xs font-medium text-muted-foreground sm:text-sm">Tingkat Kelulusan</div>
                    </div>
                </div>

                <div class="flex items-center gap-4 bg-card p-5 sm:p-6">
                    <div
                        class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary">
                        <i data-lucide="building-2" class="h-6 w-6"></i>
                    </div>
                    <div>
                        <div class="text-2xl font-extrabold tabular-nums tracking-tight text-primary"><span
                                data-count="150" data-suffix="+">150+</span></div>
                        <div class="text-xs font-medium text-muted-foreground sm:text-sm">Mitra Industri</div>
                    </div>
                </div>

                <div class="flex items-center gap-4 bg-card p-5 sm:p-6">
                    <div
                        class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-gold/25 text-gold-foreground">
                        <i data-lucide="award" class="h-6 w-6"></i>
                    </div>
                    <div>
                        <div class="text-base font-extrabold leading-tight text-primary">Akreditasi Unggul</div>
                        <div class="mt-0.5 text-xs font-medium text-muted-foreground">BAN-PT &amp; Standar IABEE</div>
                    </div>
                </div>
            </div>
        </section>
