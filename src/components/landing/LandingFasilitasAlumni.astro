---
---
        <!-- [Komponen: FasilitasFakultas] -->
        <section class="border-t border-border bg-muted/60 py-20">
            <div class="container">
                <div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-end">
                    <div>
                        <div class="split-badge mb-4">
                            <span class="split-badge-left">FTC</span>
                            <span class="split-badge-right">FASILITAS &amp; LABORATORIUM CERDAS</span>
                        </div>
                        <h2 class="section-title text-deep">Lebih dari Sekadar Ruang Kelas</h2>
                        <p class="section-desc">
                            Dilengkapi laboratorium kecerdasan buatan (AI), perangkat High-Performance Computing, studio
                            animasi &amp; broadcasting, serta ruang kolaborasi riset berstandar industri.
                        </p>
                    </div>
                    <button data-go="inovasi"
                        class="inline-flex items-center gap-1.5 self-start text-sm font-bold text-deep hover:text-info lg:self-end">
                        Lihat Ekosistem Inovasi FTC <i data-lucide="arrow-right" class="h-4 w-4 text-gold"></i>
                    </button>
                </div>

                <div class="mt-10 grid gap-5 lg:grid-cols-12">
                    <div
                        class="group relative min-h-[360px] overflow-hidden rounded-2xl bg-deep lg:col-span-7 lg:min-h-[430px]">
                        <img src="https://images.unsplash.com/photo-1581092160607-ee22621dd758?auto=format&fit=crop&w=1200&q=80"
                            alt="Intelligent System & AI Research Lab" loading="lazy" decoding="async"
                            class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
                        <div class="absolute inset-0 bg-gradient-to-t from-deep/90 via-deep/30 to-transparent"></div>
                        <div class="absolute inset-x-5 bottom-5 text-white sm:inset-x-6 sm:bottom-6">
                            <span class="badge badge-gold mb-2.5"><i data-lucide="cpu" class="h-3.5 w-3.5"></i>
                                Laboratorium Unggulan</span>
                            <h3 class="text-xl font-extrabold sm:text-2xl">Intelligent System &amp; AI Research Lab</h3>
                            <p class="mt-1.5 max-w-xl text-sm leading-relaxed text-white/80">
                                Pusat eksperimen Machine Learning, Computer Vision, dan IoT terintegrasi dengan dukungan
                                infrastruktur server GPU berkecepatan tinggi.
                            </p>
                        </div>
                    </div>

                    <!-- Di tablet (sm-md) dua kartu kecil berdampingan, di HP menumpuk, di desktop kembali menumpuk -->
                    <div class="flex flex-col gap-5 sm:flex-row lg:col-span-5 lg:flex-col">
                        <div class="group relative min-h-[220px] flex-1 overflow-hidden rounded-2xl bg-deep">
                            <img src="https://images.unsplash.com/photo-1598488035139-bdbb2231ce04?auto=format&fit=crop&w=800&q=80"
                                alt="Studio Animasi & Motion Capture" loading="lazy" decoding="async"
                                class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
                            <div class="absolute inset-0 bg-gradient-to-t from-deep/90 via-deep/25 to-transparent">
                            </div>
                            <div class="absolute inset-x-5 bottom-5 text-white">
                                <p class="font-mono text-xs font-bold uppercase tracking-wider text-gold">Creative &amp;
                                    Motion Studio</p>
                                <h3 class="mt-1 text-lg font-bold">Studio Animasi, Game &amp; Motion Capture</h3>
                            </div>
                        </div>

                        <div class="group relative min-h-[220px] flex-1 overflow-hidden rounded-2xl bg-deep">
                            <img src="https://images.unsplash.com/photo-1517245386807-bb43f82c33c4?auto=format&fit=crop&w=800&q=80"
                                alt="Bengkel Koding & Inkubator" loading="lazy" decoding="async"
                                class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
                            <div class="absolute inset-0 bg-gradient-to-t from-deep/90 via-deep/25 to-transparent">
                            </div>
                            <div class="absolute inset-x-5 bottom-5 text-white">
                                <p class="font-mono text-xs font-bold uppercase tracking-wider text-gold">Collaborative
                                    Hub</p>
                                <h3 class="mt-1 text-lg font-bold">Bengkel Koding &amp; Inkubator Technopreneur</h3>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

