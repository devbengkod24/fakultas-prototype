            </div>
        </div>
    </div>

    <!-- ===================================================================
       [Komponen: Navbar]
  ==================================================================== -->
    <header id="site-header" class="sticky top-0 z-50 border-b border-border bg-white">
        <div class="container flex h-[74px] items-center justify-between gap-3 sm:gap-4">
            {isSubpage ? (
                <a href="/" class="flex min-w-0 items-center gap-3 text-left focus:outline-none">
                    <div
                        class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-deep text-base font-extrabold tracking-tighter text-white shadow-sm">
                        <span class="text-gold">U</span>D
                    </div>
                    <div class="min-w-0 leading-tight">
                        <div class="flex items-center gap-2">
                            <span class="truncate text-[17px] font-extrabold tracking-tight text-deep">FTC UDINUS</span>
                        </div>
                        <span class="block truncate text-xs font-medium text-muted-foreground">Fakultas Teknologi
                            Cerdas</span>
                    </div>
                </a>
            ) : (
                <button data-go="beranda" class="flex min-w-0 items-center gap-3 text-left focus:outline-none">
                    <div
                        class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-deep text-base font-extrabold tracking-tighter text-white shadow-sm">
                        <span class="text-gold">U</span>D
                    </div>
                    <div class="min-w-0 leading-tight">
                        <div class="flex items-center gap-2">
                            <span class="truncate text-[17px] font-extrabold tracking-tight text-deep">FTC UDINUS</span>
                        </div>
                        <span class="block truncate text-xs font-medium text-muted-foreground">Fakultas Teknologi
                            Cerdas</span>
                    </div>
                </button>
            )}

            <nav class="hidden items-center gap-1 lg:flex" aria-label="Navigasi Utama">
                {navItems.map((item) => {
                    const active = isNavActive(item.id);
                    return isSubpage ? (
                        <a
                            href={item.href}
                            class="nav-link whitespace-nowrap"
                            data-active={active ? 'true' : undefined}
                            aria-current={active ? 'page' : undefined}
                        >
                            {item.label}
                        </a>
                    ) : (
                        <button
                            class="nav-link whitespace-nowrap"
                            data-go={item.id}
                            data-active={active ? 'true' : undefined}
                            aria-current={active ? 'page' : undefined}
                        >
                            {item.label}
                        </button>
                    );
                })}
            </nav>

            <div class="flex shrink-0 items-center gap-2 sm:gap-2.5">
                <a href="https://pmb.dinus.ac.id" target="_blank" rel="noopener"
                    class="btn btn-outline hidden sm:inline-flex">
                    Pendaftaran <i data-lucide="arrow-up-right" class="h-4 w-4 text-info"></i>
                </a>
                <a href="/login" class="btn btn-gold !px-3.5 sm:!px-5" aria-label="Login">
                    <i data-lucide="log-in" class="h-4 w-4"></i> <span class="hidden min-[400px]:inline">Login</span>
                </a>
                <button id="menu-toggle" class="btn btn-outline !w-10 !px-0 lg:hidden" aria-label="Buka Menu"
                    aria-expanded="false" aria-controls="mobile-nav">
                    <i data-lucide="menu" class="icon-open h-5 w-5"></i>
                    <i data-lucide="x" class="icon-close hidden h-5 w-5"></i>
                </button>
            </div>
        </div>

        <!-- Mobile Navigation (membuka dengan transisi tinggi halus) -->
        <div id="mobile-nav" class="mnav grid lg:hidden" aria-hidden="true">
            <div>
                <nav class="border-t border-border bg-background" aria-label="Navigasi Seluler">
                    <div class="container flex flex-col gap-1 py-3">
                        {navItems.map((item) => {
                            const active = isNavActive(item.id);
                            return isSubpage ? (
                                <a
                                    href={item.href}
                                    class="nav-link text-left"
                                    data-active={active ? 'true' : undefined}
                                    aria-current={active ? 'page' : undefined}
                                >
                                    {item.label}
                                </a>
                            ) : (
                                <button
                                    class="nav-link text-left"
                                    data-go={item.id}
                                    data-active={active ? 'true' : undefined}
                                    aria-current={active ? 'page' : undefined}
                                >
                                    {item.label}
                                </button>
                            );
                        })}
                        <a href="https://pmb.dinus.ac.id" target="_blank" rel="noopener"
                            class="btn btn-outline mt-2 sm:hidden">
                            Pendaftaran <i data-lucide="arrow-up-right" class="h-4 w-4 text-info"></i>
                        </a>
                        <!-- Mobile Drawer Social Media Icons (Req 6) -->
                        <div
                            class="mt-4 pt-3 border-t border-border flex items-center justify-between text-xs text-muted-foreground">
                            <span>Ikuti FTC UDINUS:</span>
                            <div class="flex items-center gap-3">
                                <a href="https://instagram.com/ftc_udinus" target="_blank" rel="noopener"
                                    class="text-slate-600 hover:text-gold transition-colors" aria-label="Instagram">
                                    <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
                                        <path
                                            d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
                                    </svg>
                                </a>
                                <a href="https://tiktok.com/@ftc_udinus" target="_blank" rel="noopener"
                                    class="text-slate-600 hover:text-gold transition-colors" aria-label="TikTok">
                                    <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
                                        <path
                                            d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64c.298 0 .59.043.87.126V9.36a6.37 6.37 0 0 0-.87-.06 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.34-6.34V8.75a8.28 8.28 0 0 0 4.84 1.57V6.87a4.84 4.84 0 0 1-1.07-.18z" />
                                    </svg>
                                </a>
                                <a href="https://facebook.com/ftcudinus" target="_blank" rel="noopener"
                                    class="text-slate-600 hover:text-gold transition-colors" aria-label="Facebook">
                                    <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
                                        <path
                                            d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
                                    </svg>
                                </a>
                            </div>
                        </div>
                    </div>
                </nav>
            </div>
        </div>
    </header>

{isSubpage && (
    <>
        <style is:global>
            #site-topbar,
            #site-header {
                font-family: 'Poppins', system-ui, -apple-system, sans-serif;
            }
            #site-topbar .container,
            #site-header .container {
                width: 100%;
                max-width: none;
                margin-left: auto;
                margin-right: auto;
                padding-left: 1rem;
                padding-right: 1rem;
            }
            @media (min-width: 640px) {
                #site-topbar .container,
                #site-header .container {
                    padding-left: 1.5rem;
                    padding-right: 1.5rem;
                }
            }
            @media (min-width: 1024px) {
                #site-topbar .container,
                #site-header .container {
                    padding-left: 2rem;
                    padding-right: 2rem;
                }
            }
            @media (min-width: 1536px) {
                #site-topbar .container,
                #site-header .container {
                    max-width: 1280px;
                }
            }
            @layer components {
                #scroll-progress.bg-gold { background-color: hsl(41 90% 57%); }
                #site-topbar.bg-deep { background-color: hsl(211 85% 20%); }
                #site-topbar .text-gold,
                #site-header .text-gold { color: hsl(41 90% 57%); }
                #site-topbar .hover\:text-gold:hover,
                #site-header .hover\:text-gold:hover { color: hsl(41 90% 57%); }
                #site-header.border-border,
                #site-header .border-border { border-color: hsl(214 20% 89%); }
                #site-header .bg-deep { background-color: hsl(211 85% 20%); }
                #site-header .text-deep { color: hsl(211 85% 20%); }
                #site-header .text-muted-foreground { color: hsl(215 16% 42%); }
                #site-header .text-info { color: hsl(207 88% 41%); }
                #site-header .bg-background { background-color: hsl(0 0% 100%); }
                #site-header .nav-link {
                    border-radius: 0.5rem;
                    padding: 0.5rem 0.875rem;
                    font-size: 0.875rem;
                    line-height: 1.25rem;
                    font-weight: 500;
                    color: #475569;
                    white-space: nowrap;
                    cursor: pointer;
                    transition: color 150ms cubic-bezier(0.4, 0, 0.2, 1), background-color 150ms cubic-bezier(0.4, 0, 0.2, 1), transform 150ms cubic-bezier(0.4, 0, 0.2, 1);
                }
                #site-header .nav-link:hover {
                    background-color: hsl(214 32% 94%);
                    color: hsl(212 79% 32%);
                }
                #site-header .nav-link:active {
                    transform: scale(0.97);
                }
                #site-header .nav-link[data-active="true"] {
                    background-color: hsl(214 32% 94% / 0.8);
                    font-weight: 700;
                    color: hsl(212 79% 32%);
                }
                #site-header .btn {
                    display: inline-flex;
                    height: 2.5rem;
                    align-items: center;
                    justify-content: center;
                    gap: 0.5rem;
                    white-space: nowrap;
                    cursor: pointer;
                    border-radius: 0.5rem;
                    padding-left: 1.25rem;
                    padding-right: 1.25rem;
                    font-size: 0.875rem;
                    line-height: 1.25rem;
                    font-weight: 600;
                    transition: all 150ms cubic-bezier(0.4, 0, 0.2, 1);
                }
                #site-header .btn:active {
                    transform: scale(0.97);
                }
                #site-header .btn-outline {
                    border: 1px solid hsl(214 20% 89%);
                    background-color: hsl(0 0% 100%);
                    color: hsl(215 35% 13%);
                }
                #site-header .btn-outline:hover {
                    background-color: hsl(214 32% 94%);
                    color: hsl(212 79% 32%);
                }
                #site-header .btn-gold {
                    background-color: hsl(41 90% 57%);
                    color: hsl(215 45% 12%);
                    font-weight: 700;
                    box-shadow: 0 1px 2px 0 rgb(0 0 0 / 0.05);
                }
                #site-header .btn-gold:hover {
                    filter: brightness(0.95);
                    box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
                }
                #site-header .btn:hover > svg[class*="lucide-arrow-up-right"] {
                    transform: translate(2px, -2px);
                    transition: transform 0.2s cubic-bezier(0.2, 0.7, 0.2, 1);
                }
                #site-header {
                    transition: box-shadow 0.25s ease;
                }
                #site-header.is-scrolled {
                    box-shadow: 0 6px 20px -10px rgba(8, 52, 96, 0.35);
                }
                #site-header .mnav {
                    grid-template-rows: 0fr;
                    transition: grid-template-rows 0.3s ease;
                }
                #site-header .mnav.open {
                    grid-template-rows: 1fr;
                }
                #site-header .mnav > div {
                    min-height: 0;
                    overflow: hidden;
                    visibility: hidden;
                    transition: visibility 0s linear 0.3s;
                }
                #site-header .mnav.open > div {
                    visibility: visible;
                    transition-delay: 0s;
                }
            }
        </style>
        <script is:inline>
            document.addEventListener('DOMContentLoaded', () => {
                const toggleBtn = document.getElementById('menu-toggle');
                const mobileNav = document.getElementById('mobile-nav');
                const iconOpen = toggleBtn?.querySelector('.icon-open');
                const iconClose = toggleBtn?.querySelector('.icon-close');
                const siteHeader = document.getElementById('site-header');
                const progressBar = document.getElementById('scroll-progress');

                const closeMobileNav = () => {
                    if (!mobileNav || !toggleBtn) return;
                    mobileNav.classList.remove('open');
                    mobileNav.setAttribute('aria-hidden', 'true');
                    toggleBtn.setAttribute('aria-expanded', 'false');
                    iconOpen?.classList.remove('hidden');
                    iconClose?.classList.add('hidden');
                };

                if (toggleBtn && mobileNav) {
                    toggleBtn.addEventListener('click', () => {
                        const isOpen = mobileNav.classList.toggle('open');
                        mobileNav.setAttribute('aria-hidden', String(!isOpen));
                        toggleBtn.setAttribute('aria-expanded', String(isOpen));
                        iconOpen?.classList.toggle('hidden', isOpen);
                        iconClose?.classList.toggle('hidden', !isOpen);
                    });
                    document.addEventListener('keydown', (e) => {
                        if (e.key === 'Escape') closeMobileNav();
                    });
                }

                let scrollTicking = false;
                const onScroll = () => {
                    if (scrollTicking) return;
                    scrollTicking = true;
                    requestAnimationFrame(() => {
                        const y = window.scrollY;
                        const max = document.documentElement.scrollHeight - window.innerHeight;
                        if (progressBar) {
                            progressBar.style.transform = `scaleX(${max > 0 ? Math.min(y / max, 1) : 0})`;
                        }
                        if (siteHeader) {
                            siteHeader.classList.toggle('is-scrolled', y > 8);
                        }
                        scrollTicking = false;
                    });
                };

                window.addEventListener('scroll', onScroll, { passive: true });
                window.addEventListener('resize', onScroll);
                onScroll();

                if (typeof lucide !== 'undefined') {
                    lucide.createIcons();
                }
            });
        </script>
    </>
)}

