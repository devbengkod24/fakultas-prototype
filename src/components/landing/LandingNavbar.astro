    <!-- Progress scroll (garis emas tipis di paling atas) -->
    <div id="scroll-progress" aria-hidden="true"
        class="pointer-events-none fixed inset-x-0 top-0 z-[60] h-[3px] origin-left bg-gold"
        style="transform:scaleX(0)"></div>

    <!-- ===================================================================
       [Komponen: TopBar]
  ==================================================================== -->
