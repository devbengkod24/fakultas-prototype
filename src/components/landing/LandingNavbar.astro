            </div>
            <div class="flex shrink-0 items-center gap-3 sm:gap-5">
                <a href="https://dinus.ac.id" target="_blank" rel="noopener"
                    class="hidden transition-colors hover:text-white sm:inline">Website UDINUS</a>
                <a href="https://alumni.dinus.id" target="_blank" rel="noopener"
                    class="hidden transition-colors hover:text-white sm:inline">Alumni</a>
                <span class="hidden h-3.5 w-px bg-white/20 sm:block"></span>
