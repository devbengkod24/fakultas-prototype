                        <button class="nav-link text-left" data-go="pengumuman">Pengumuman</button>
                        <button class="nav-link text-left" data-go="berita">Berita Kegiatan</button>
                        <a href="https://pmb.dinus.ac.id" target="_blank" rel="noopener"
                            class="btn btn-outline mt-2 sm:hidden">
                            Pendaftaran <i data-lucide="arrow-up-right" class="h-4 w-4 text-info"></i>
                        </a>
