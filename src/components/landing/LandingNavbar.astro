    <!-- ===================================================================
       [Komponen: Navbar]
  ==================================================================== -->
    <header id="site-header" class="sticky top-0 z-50 border-b border-border bg-white">
        <div class="container flex h-[74px] items-center justify-between gap-3 sm:gap-4">
            <button data-go="beranda" class="flex min-w-0 items-center gap-3 text-left focus:outline-none">
                <div
                    class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-deep text-base font-extrabold tracking-tighter text-white shadow-sm">
                    <span class="text-gold">U</span>D
                </div>
                <div class="min-w-0 leading-tight">
                    <div class="flex items-center gap-2">
                        <span class="truncate text-[17px] font-extrabold tracking-tight text-deep">FTC UDINUS</span>
                    </div>
                    <span class="block truncate text-xs font-medium text-muted-foreground">Fakultas Teknologi
                        Cerdas</span>
                </div>
            </button>

            <nav class="hidden items-center gap-1 lg:flex" aria-label="Navigasi Utama">
                <button class="nav-link" data-go="beranda" data-active="true" aria-current="page">Beranda</button>
                <button class="nav-link" data-go="profil">Profil</button>
                <button class="nav-link" data-go="unggulan">Unggulan</button>
                <button class="nav-link" data-go="inovasi">Inovasi</button>
                <button class="nav-link" data-go="publikasi">Publikasi</button>
                <button class="nav-link" data-go="pengumuman">Pengumuman</button>
                <button class="nav-link" data-go="berita">Berita Kegiatan</button>
            </nav>

            <div class="flex shrink-0 items-center gap-2 sm:gap-2.5">
                <a href="https://pmb.dinus.ac.id" target="_blank" rel="noopener"
                    class="btn btn-outline hidden sm:inline-flex">
                    Pendaftaran <i data-lucide="arrow-up-right" class="h-4 w-4 text-info"></i>
                </a>
                <a href="#" class="btn btn-gold !px-3.5 sm:!px-5" aria-label="Login">
                    <i data-lucide="log-in" class="h-4 w-4"></i> <span class="hidden min-[400px]:inline">Login</span>
                </a>
                <button id="menu-toggle" class="btn btn-outline !w-10 !px-0 lg:hidden" aria-label="Buka Menu"
                    aria-expanded="false" aria-controls="mobile-nav">
                    <i data-lucide="menu" class="icon-open h-5 w-5"></i>
                    <i data-lucide="x" class="icon-close hidden h-5 w-5"></i>
                </button>
            </div>
        </div>

        <!-- Mobile Navigation (membuka dengan transisi tinggi halus) -->
        <div id="mobile-nav" class="mnav grid lg:hidden" aria-hidden="true">
            <div>
                <nav class="border-t border-border bg-background" aria-label="Navigasi Seluler">
                    <div class="container flex flex-col gap-1 py-3">
                        <button class="nav-link text-left" data-go="beranda">Beranda</button>
                        <button class="nav-link text-left" data-go="profil">Profil</button>
                        <button class="nav-link text-left" data-go="unggulan">Unggulan</button>
                        <button class="nav-link text-left" data-go="inovasi">Inovasi</button>
