---
interface Props {
    isSubpage?: boolean;
    activeNav?: string;
}

const { isSubpage = false, activeNav = 'beranda' } = Astro.props;

const navItems = [
    { id: 'beranda', label: 'Beranda', href: '/' },
    { id: 'profil', label: 'Profil', href: '/#profil' },
    { id: 'unggulan', label: 'Unggulan', href: '/#unggulan' },
    { id: 'inovasi', label: 'Inovasi', href: '/#inovasi' },
    { id: 'publikasi', label: 'Publikasi', href: '/#publikasi' },
    { id: 'pengumuman', label: 'Pengumuman', href: '/#pengumuman' },
    { id: 'berita', label: 'Berita Kegiatan', href: '/#berita' },
];

const isNavActive = (id: string) =>
    activeNav === id || (activeNav === 'mbkm' && id === 'unggulan');
---
    <!-- Progress scroll (garis emas tipis di paling atas) -->
