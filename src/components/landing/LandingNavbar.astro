                <a href="https://alumni.dinus.id" target="_blank" rel="noopener"
                    class="hidden transition-colors hover:text-white sm:inline">Alumni</a>
                <span class="hidden h-3.5 w-px bg-white/20 sm:block"></span>
                <!-- Social Media Icons (Req 6) -->
                <div class="flex items-center gap-2.5">
                    <a href="https://instagram.com/ftc_udinus" target="_blank" rel="noopener"
                        aria-label="Instagram FTC UDINUS" class="text-white/80 hover:text-gold transition-colors">
                        <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
                            <path
