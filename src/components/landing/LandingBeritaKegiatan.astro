---
---
        <!-- [Komponen: BeritaTerbaru] -->
        <section class="py-20">
            <div class="container">
                <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
                    <div>
                        <div class="split-badge mb-4">
                            <span class="split-badge-left">FTC</span>
                            <span class="split-badge-right">SOROTAN UTAMA</span>
                        </div>
                        <h2 class="section-title text-deep">Berita Terbaru FTC UDINUS</h2>
                        <p class="section-desc">
                            Ikuti perkembangan terbaru seputar kegiatan akademik, prestasi, dan inovasi mahasiswa FTC
                            UDINUS.
                        </p>
                    </div>
                    <div class="flex items-center gap-2">
                        <button id="news-prev" class="btn btn-outline !w-11 !px-0" aria-label="Berita Sebelumnya">
                            <i data-lucide="arrow-left" class="h-4 w-4"></i>
                        </button>
                        <button id="news-next" class="btn btn-default !w-11 !px-0" aria-label="Berita Selanjutnya">
                            <i data-lucide="arrow-right" class="h-4 w-4 text-gold"></i>
                        </button>
                    </div>
                </div>

                <article id="news-article" class="card mt-10 grid overflow-hidden lg:grid-cols-12" aria-live="polite">
                    <div class="relative min-h-[240px] bg-muted sm:min-h-[340px] lg:col-span-6">
                        <img id="news-img" src="" alt="Berita Utama FTC"
                            class="img-fade absolute inset-0 h-full w-full object-cover" />
                        <span class="badge badge-gold absolute left-4 top-4 shadow-sm">Berita Terbaru</span>
                    </div>
                    <div class="flex flex-col justify-between gap-6 p-5 sm:p-10 lg:col-span-6">
                        <div class="news-fade">
                            <div class="flex flex-wrap items-center gap-2 text-xs font-semibold text-muted-foreground">
                                <span id="news-author" class="text-amber-700"></span>
                                <span>•</span>
                                <span id="news-date"></span>
                                <span>•</span>
                                <span id="news-cat" class="text-info"></span>
                            </div>
                            <h3 id="news-title"
                                class="mt-3 text-xl font-extrabold leading-snug text-deep sm:text-[26px]"></h3>
                            <p id="news-excerpt" class="mt-3.5 text-[15px] leading-relaxed text-muted-foreground"></p>
                        </div>
                        <div class="flex items-center justify-between gap-3 border-t border-border pt-5">
                            <div id="news-dots" class="flex items-center gap-1.5"></div>
                            <button id="news-readmore" class="btn btn-outline btn-sm">
                                Baca selengkapnya <i data-lucide="arrow-right" class="h-4 w-4 text-gold"></i>
                            </button>
                        </div>
                    </div>
                </article>
            </div>
        </section>

        <!-- [Komponen: KegiatanTerbaru] -->
        <section class="border-t border-border py-20">
            <div class="container">
                <div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-end">
                    <div>
                        <div class="split-badge mb-4">
                            <span class="split-badge-left">FTC</span>
                            <span class="split-badge-right">AGENDA &amp; PRESTASI</span>
                        </div>
                        <h2 class="section-title text-deep">Kegiatan Terbaru FTC UDINUS</h2>
                        <p class="section-desc">
                            Dapatkan informasi lengkap tentang kegiatan akademik dan kemahasiswaan di FTC UDINUS.
                        </p>
                    </div>
                    <div class="flex flex-wrap items-center gap-2" id="kegiatan-filter">
                        <button class="pill" data-state="active" data-filter="all">Semua</button>
                        <button class="pill" data-state="inactive" data-filter="prestasi">Prestasi</button>
                        <button class="pill" data-state="inactive" data-filter="kegiatan">Kegiatan kampus</button>
                        <button data-go="berita" class="btn btn-default btn-sm ml-1 !rounded-full">
                            Lihat semuanya <i data-lucide="arrow-right" class="h-3.5 w-3.5 text-gold"></i>
                        </button>
                    </div>
                </div>

                <div class="mt-10 grid gap-6 md:grid-cols-3">
                    <article data-cat="kegiatan"
                        class="kegiatan-card card group flex flex-col overflow-hidden transition-all hover:border-info/40 hover:shadow-md">
                        <div class="relative h-52 overflow-hidden bg-muted">
                            <img src="https://images.unsplash.com/photo-1540575467063-178a50c2df87?auto=format&fit=crop&w=800&q=80"
                                alt="iSemantic 2026" loading="lazy" decoding="async"
                                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
                            <span
                                class="badge absolute left-3.5 top-3.5 rounded-full bg-white px-3 py-1 font-extrabold uppercase tracking-wider text-deep shadow-sm">KEGIATAN</span>
                        </div>
                        <div class="flex flex-1 flex-col p-6">
                            <p class="text-xs font-medium text-muted-foreground">September 22, 2026</p>
                            <h3 class="mt-2 line-clamp-2 text-lg font-extrabold leading-snug text-deep group-hover:text-info cursor-pointer"
                                data-news-id="isemantic">
                                iSemantic 2026 Sukses Digelar, Wadahi Ratusan Paper Berstandar Internasional
                            </h3>
                            <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-muted-foreground">
                                International Seminar on Application for Technology of Information and Communication
                                (iSemantic) 2026 sukses mempertemukan peneliti global.
                            </p>
                            <a href="#" onclick="return false" data-news-id="isemantic"
                                class="mt-auto inline-flex items-center gap-1.5 border-t border-slate-100 pt-4 text-xs font-extrabold text-deep group-hover:text-info">
                                Baca Selengkapnya <i data-lucide="arrow-right" class="h-3.5 w-3.5 text-gold"></i>
                            </a>
                        </div>
                    </article>

                    <article data-cat="kegiatan"
                        class="kegiatan-card card group flex flex-col overflow-hidden transition-all hover:border-info/40 hover:shadow-md">
                        <div class="relative h-52 overflow-hidden bg-muted">
                            <img src="https://images.unsplash.com/photo-1523240795612-9a054b0db644?auto=format&fit=crop&w=800&q=80"
                                alt="Dinus Inside 2026" loading="lazy" decoding="async"
                                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
                            <span
                                class="badge absolute left-3.5 top-3.5 rounded-full bg-white px-3 py-1 font-extrabold uppercase tracking-wider text-deep shadow-sm">KEGIATAN</span>
                        </div>
                        <div class="flex flex-1 flex-col p-6">
                            <p class="text-xs font-medium text-muted-foreground">September 22, 2026</p>
                            <h3 class="mt-2 line-clamp-2 text-lg font-extrabold leading-snug text-deep group-hover:text-info cursor-pointer"
                                data-news-id="dinus-inside">
                                Dinus Inside 2026 Ajak 3.658 Maba Peduli Lingkungan Lewat Penebaran Benih
                            </h3>
                            <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-muted-foreground">
                                Universitas Dian Nuswantoro (Udinus) kembali mengajak mahasiswa baru mengenal pentingnya
                                kepedulian terhadap lingkungan.
                            </p>
                            <a href="#" onclick="return false" data-news-id="dinus-inside"
                                class="mt-auto inline-flex items-center gap-1.5 border-t border-slate-100 pt-4 text-xs font-extrabold text-deep group-hover:text-info">
                                Baca Selengkapnya <i data-lucide="arrow-right" class="h-3.5 w-3.5 text-gold"></i>
                            </a>
                        </div>
                    </article>

                    <article data-cat="prestasi"
                        class="kegiatan-card card group flex flex-col overflow-hidden transition-all hover:border-info/40 hover:shadow-md">
                        <div class="relative h-52 overflow-hidden bg-muted">
                            <img src="https://images.unsplash.com/photo-1515187029135-18ee286d815b?auto=format&fit=crop&w=800&q=80"
                                alt="Prestasi Humas FTC" loading="lazy" decoding="async"
                                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
                            <span
                                class="badge badge-gold absolute left-3.5 top-3.5 uppercase tracking-wider shadow-sm">PRESTASI</span>
                        </div>
                        <div class="flex flex-1 flex-col p-6">
                            <p class="text-xs font-medium text-muted-foreground">September 22, 2026</p>
                            <h3 class="mt-2 line-clamp-2 text-lg font-extrabold leading-snug text-deep group-hover:text-info cursor-pointer"
                                data-news-id="humas-award">
                                Koordinator Humas FTC Udinus, Heni Indrayani Raih Bronze Winner Nasional
                            </h3>
                            <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-muted-foreground">
                                Pengelolaan komunikasi menjadi bagian penting dalam membangun hubungan perguruan tinggi
                                dengan berbagai pihak industri dan masyarakat.
                            </p>
                            <a href="#" onclick="return false" data-news-id="humas-award"
                                class="mt-auto inline-flex items-center gap-1.5 border-t border-slate-100 pt-4 text-xs font-extrabold text-deep group-hover:text-info">
                                Baca Selengkapnya <i data-lucide="arrow-right" class="h-3.5 w-3.5 text-gold"></i>
                            </a>
                        </div>
                    </article>
                </div>
            </div>
        </section>
