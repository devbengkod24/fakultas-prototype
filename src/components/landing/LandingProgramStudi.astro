---
---
        <!-- ===================================================================
         [Komponen: ProgramStudi] (Revisi Tab Filter & Split-Badge)
    ==================================================================== -->
        <section id="prodi-section"
            class="relative scroll-mt-20 border-y border-slate-200/80 bg-slate-50 py-20 lg:py-24">

            <div class="container relative z-10">
                <!-- Header & Tabs Row -->
                <div class="flex flex-col justify-between gap-6 xl:flex-row xl:items-end">
                    <div>
                        <div class="split-badge mb-4">
                            <span class="split-badge-left">FTC</span>
                            <span class="split-badge-right">AKADEMIK &amp; KURIKULUM CERDAS</span>
                        </div>

                        <!-- 1 Warna Solid Biru Tua (Req 2) -->
                        <h2 class="section-title text-deep lg:!text-[32px] xl:!text-[36px]">
                            Program Studi Fakultas Teknologi Cerdas
                        </h2>

                        <p class="section-desc">
                            FTC UDINUS menawarkan beragam program pendidikan unggulan yang telah terakreditasi nasional
                            dan internasional.
                        </p>
                    </div>

                    <!-- 5 Tabs Filter Program Studi (Req 5 & Req 9) -->
                    <div class="inline-flex flex-nowrap overflow-x-auto max-w-full gap-1 rounded-xl border border-slate-200/90 bg-slate-100/90 p-1.5 backdrop-blur-sm shrink-0 self-start xl:self-end"
                        id="prodi-tabs" role="tablist" aria-label="Jenjang program studi">
                        <button class="prodi-trigger" data-state="active" data-tab="s1" role="tab"
                            aria-selected="true">Sarjana (S1)</button>
                        <button class="prodi-trigger" data-state="inactive" data-tab="vokasi" role="tab"
                            aria-selected="false">Vokasi</button>
                        <button class="prodi-trigger" data-state="inactive" data-tab="s2" role="tab"
                            aria-selected="false">Magister &amp; Doktor</button>
                        <button class="prodi-trigger" data-state="inactive" data-tab="pjj" role="tab"
                            aria-selected="false">PJJ Online</button>
                        <button class="prodi-trigger" data-state="inactive" data-tab="psdku" role="tab"
                            aria-selected="false">PSDKU</button>
                    </div>
                </div>

                <!-- Grid Kartu Program Studi (Dirender via JS) -->
                <div id="prodi-grid" class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4"></div>
            </div>
        </section>
