                            <h3 class="text-base sm:text-lg font-extrabold text-deep leading-snug">${data.name}</h3>
                            <p class="text-xs font-bold text-slate-600">Universitas Dian Nuswantoro Semarang</p>
                            
                            <div class="pt-1.5">
                                <span class="inline-block px-4 py-1.5 rounded-lg font-black text-xs sm:text-sm tracking-widest uppercase ${isIabee ? 'bg-sky-900 text-white shadow-sm' : 'bg-primary text-white shadow-sm'}">
