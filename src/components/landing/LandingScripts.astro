                        <span class="inline-flex items-center gap-1 text-xs text-slate-500">
                            <i data-lucide="calendar" class="h-3.5 w-3.5"></i> ${item.year}
                        </span>
                        ${item.citasi ? `
                            <span class="inline-flex items-center gap-1 text-xs text-slate-500">
                                <i data-lucide="quote" class="h-3.5 w-3.5"></i> ${item.citasi}
                            </span>
                        ` : ''}
                        ${item.dana ? `
                            <span class="inline-flex items-center gap-1 text-xs font-bold text-slate-700">
                                <i data-lucide="coins" class="h-3.5 w-3.5 text-gold"></i> ${item.dana}
                            </span>
                        ` : ''}
                        ${item.doi ? `
                            <span class="hidden sm:inline-flex items-center gap-1 text-xs text-slate-500">
                                <i data-lucide="link" class="h-3.5 w-3.5"></i> ${item.doi}
                            </span>
                        ` : ''}
                        <span class="ml-auto rounded-md px-2.5 py-1 text-[11px] font-bold font-mono ${sourceBadge}">
                            ${item.source}
                        </span>
                    </div>

                    ${item.author ? `
                        <p class="mt-3.5 text-xs font-bold text-slate-700 tracking-wide">${item.author}</p>
                    ` : ''}
                    ${item.ketua ? `
                        <div class="mt-3.5 space-y-0.5 text-xs">
                            <p class="font-bold text-deep">${item.ketua}</p>
                            <p class="text-slate-500 font-medium">${item.anggota}</p>
                        </div>
                    ` : ''}
                </article>
                `;
            }).join('');

            lucide.createIcons();
        }

        document.getElementById('pub-tabs').addEventListener('click', e => {
            const b = e.target.closest('[data-pubtab]');
            if (!b) return;
            activePubTab = b.dataset.pubtab;
            $$('.pub-tab').forEach(btn => {
                const on = btn === b;
                btn.setAttribute('aria-selected', String(on));
                btn.classList.toggle('bg-deep', on);
                btn.classList.toggle('text-white', on);
                btn.classList.toggle('shadow-sm', on);
                btn.classList.toggle('text-slate-600', !on);
            });
            renderPublikasi();
        });

        let pubDebounce;
        const pubSearchInput = document.getElementById('pub-search');
        if (pubSearchInput) {
            pubSearchInput.addEventListener('input', () => {
                clearTimeout(pubDebounce);
                pubDebounce = setTimeout(() => renderPublikasi(false), 150);
            });
        }

        // Dropdown Pemilih Tipe Pencarian (Judul / Penulis)
        const searchTypeBtn = document.getElementById('pub-search-type-btn');
        const searchTypeMenu = document.getElementById('pub-search-type-menu');
        const searchTypeLabel = document.getElementById('pub-search-type-label');
        const searchChevron = document.getElementById('pub-search-chevron');

        if (searchTypeBtn && searchTypeMenu) {
            searchTypeBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                const isOpen = !searchTypeMenu.classList.contains('hidden');
                searchTypeMenu.classList.toggle('hidden', isOpen);
                searchTypeBtn.setAttribute('aria-expanded', String(!isOpen));
                if (searchChevron) searchChevron.classList.toggle('rotate-180', !isOpen);
            });

            searchTypeMenu.addEventListener('click', (e) => {
                const opt = e.target.closest('[data-search-type]');
                if (!opt) return;
                activePubSearchType = opt.dataset.searchType;
                if (searchTypeLabel) {
                    searchTypeLabel.textContent = activePubSearchType === 'judul' ? 'Judul' : 'Penulis';
                }
                if (pubSearchInput) {
                    pubSearchInput.placeholder = activePubSearchType === 'judul'
                        ? 'Ketik untuk mencari artikel...'
                        : 'Ketik untuk mencari nama penulis / peneliti...';
                    pubSearchInput.focus();
                }
                searchTypeMenu.classList.add('hidden');
                searchTypeBtn.setAttribute('aria-expanded', 'false');
                if (searchChevron) searchChevron.classList.remove('rotate-180');
                renderPublikasi();
            });

            document.addEventListener('click', (e) => {
                if (!searchTypeBtn.contains(e.target) && !searchTypeMenu.contains(e.target)) {
                    searchTypeMenu.classList.add('hidden');
                    searchTypeBtn.setAttribute('aria-expanded', 'false');
                    if (searchChevron) searchChevron.classList.remove('rotate-180');
                }
            });
        }
        renderPublikasi(false);

        /* 7c. Halaman Pengumuman (Search + Popover Filter + Render Dinamis) */
        const pengumumanData = [
            {
                id: 'matrikulasi',
                title: 'Persiapan Matrikulasi Mahasiswa Baru FTC UDINUS',
                prodi: 'Teknik Informatika - S1',
                prodiKey: 'ti',
                cat: 'Umum',
                catKey: 'umum',
                badgeStyle: 'badge-soft',
                date: '22 September 2026',
                time: '21:04 WIB',
                content: 'Kegiatan matrikulasi Universitas Dian Nuswantoro untuk menyambut Mahasiswa Baru. Kegiatan Matrikulasi bertujuan untuk mempersiapkan adaptasi akademik dan pengenalan laboratorium cerdas di lingkungan Fakultas Teknologi Cerdas.'
            },
            {
                id: 'ta-pembimbing',
                title: 'Pengajuan Dosen Pembimbing TA Prodi STI',
                prodi: 'Teknik Informatika - S1',
                prodiKey: 'ti',
                cat: 'Tugas Akhir',
                catKey: 'ta',
                badgeStyle: 'badge-info',
                date: '22 September 2026',
                time: '14:47 WIB',
                content: 'Bagi mahasiswa Program Studi Sarjana Teknik Informatika yang mengambil Tugas Akhir. Kami membuka pengajuan permohonan perubahan Dosen Pembimbing melalui portal akademik mulai tanggal 23 September hingga 5 Oktober 2026.'
            },
            {
                id: 'sidang-kp',
                title: 'Pendaftaran Seminar & Sidang Kerja Praktek Gelombang II',
                prodi: 'Sistem Informasi - S1',
                prodiKey: 'si',
                cat: 'Kerja Praktek',
                catKey: 'kp',
                badgeStyle: 'badge-soft',
                date: '20 September 2026',
                time: '09:30 WIB',
                content: 'Diberitahukan kepada mahasiswa yang telah menyelesaikan laporan Kerja Praktek (KP) di industri mitra, pendaftaran sidang gelombang kedua resmi dibuka melalui portal akademik terpadu.'
            },
            {
                id: 'bimbingan-karir',
                title: 'Campus Hiring & Bimbingan Karir Bersama Mitra Industri Tech',
                prodi: 'Semua Program Studi',
                prodiKey: 'all',
                cat: 'Bimbingan Karir',
                catKey: 'karir',
                badgeStyle: 'badge-gold',
                date: '18 September 2026',
                time: '13:15 WIB',
                content: 'Pusat Karir FTC bekerjasama dengan perusahaan teknologi nasional menyelenggarakan sesi bimbingan karir dan rekrutmen langsung bagi lulusan baru dan mahasiswa tingkat akhir.'
            }
        ];

        let activeAnnProdi = 'all';
        let activeAnnCat = 'all';

        function renderPengumuman(animate = true) {
            const list = document.getElementById('pengumuman-list');
            if (!list) return;
            const q = (document.getElementById('pengumuman-search')?.value || '').trim().toLowerCase();

            const filtered = pengumumanData.filter(item => {
                const matchQuery = !q || item.title.toLowerCase().includes(q) || item.content.toLowerCase().includes(q) || item.prodi.toLowerCase().includes(q);
                const matchProdi = activeAnnProdi === 'all' || item.prodiKey === activeAnnProdi || item.prodiKey === 'all';
                const matchCat = activeAnnCat === 'all' || item.catKey === activeAnnCat;
                return matchQuery && matchProdi && matchCat;
            });

            // Update filter count badge & active chips
            let filterCount = 0;
            if (activeAnnProdi !== 'all') filterCount++;
            if (activeAnnCat !== 'all') filterCount++;

            const filterCountEl = document.getElementById('pengumuman-filter-count');
            if (filterCountEl) filterCountEl.textContent = String(filterCount);

            const chipsEl = document.getElementById('pengumuman-active-chips');
            if (chipsEl) {
                if (filterCount > 0) {
                    chipsEl.classList.remove('hidden');
                    chipsEl.innerHTML = `
                        <span class="text-muted-foreground font-medium">Filter aktif:</span>
                        ${activeAnnProdi !== 'all' ? `
                            <span class="inline-flex items-center gap-1 rounded-full border border-primary/20 bg-primary/10 px-2.5 py-0.5 font-semibold text-primary">
                                Prodi: ${activeAnnProdi.toUpperCase()}
                                <button type="button" onclick="resetAnnProdi()" class="hover:text-deep ml-0.5">&times;</button>
                            </span>
                        ` : ''}
                        ${activeAnnCat !== 'all' ? `
                            <span class="inline-flex items-center gap-1 rounded-full border border-primary/20 bg-primary/10 px-2.5 py-0.5 font-semibold text-primary">
                                Layanan: ${activeAnnCat.toUpperCase()}
                                <button type="button" onclick="resetAnnCat()" class="hover:text-deep ml-0.5">&times;</button>
                            </span>
                        ` : ''}
                        <button type="button" onclick="resetAllAnnFilters()" class="text-xs text-muted-foreground hover:text-deep underline ml-1">Reset Semua</button>
                    `;
                } else {
                    chipsEl.classList.add('hidden');
                    chipsEl.innerHTML = '';
                }
            }

            const totalCountEl = document.getElementById('pengumuman-total-count');
            if (totalCountEl) totalCountEl.textContent = String(filtered.length);

            if (!filtered.length) {
                list.innerHTML = `
                    <div class="card ${animate ? 'pop' : ''} p-8 text-center">
                        <p class="font-bold text-deep">Tidak ada pengumuman yang sesuai</p>
                        <p class="mt-1 text-sm text-muted-foreground">Coba ubah filter atau gunakan kata kunci pencarian yang lain.</p>
                    </div>`;
                lucide.createIcons();
                return;
            }

            list.innerHTML = filtered.map((item, i) => `
                <article style="--i:${i}" class="card ${animate ? 'pop' : ''} p-5 sm:p-6 transition-all hover:border-info/50 hover:shadow-sm">
                    <div class="flex flex-wrap items-center gap-2.5 text-xs text-muted-foreground">
                        <span class="badge ${item.badgeStyle}">${item.prodi}</span>
                        <span>•</span>
                        <span class="inline-flex items-center gap-1">
                            <i data-lucide="calendar" class="h-3.5 w-3.5"></i> ${item.date}
                        </span>
                        <span>•</span>
                        <span class="inline-flex items-center gap-1">
                            <i data-lucide="clock" class="h-3.5 w-3.5"></i> ${item.time}
                        </span>
                    </div>
                    <h3 class="mt-3 text-lg font-bold text-deep hover:text-info transition-colors">
                        <a href="#" onclick="return false">${item.title}</a>
                    </h3>
                    <p class="mt-2 text-sm leading-relaxed text-muted-foreground">${item.content}</p>
                </article>
            `).join('');

            lucide.createIcons();
        }

        window.resetAnnProdi = function () {
            activeAnnProdi = 'all';
            updateAnnMenuUI();
            renderPengumuman();
        };

        window.resetAnnCat = function () {
            activeAnnCat = 'all';
            updateAnnMenuUI();
            renderPengumuman();
        };

        window.resetAllAnnFilters = function () {
            activeAnnProdi = 'all';
            activeAnnCat = 'all';
            updateAnnMenuUI();
            renderPengumuman();
        };

        function updateAnnMenuUI() {
            $$('#pengumuman-filter-menu [data-ann-group]').forEach(btn => {
                const group = btn.dataset.annGroup;
                const val = btn.dataset.annVal;
                const isSelected = (group === 'prodi' && activeAnnProdi === val) || (group === 'cat' && activeAnnCat === val);
                const check = btn.querySelector('.ann-filter-check');
                if (check) check.classList.toggle('hidden', !isSelected);
                btn.classList.toggle('font-bold', isSelected);
                btn.classList.toggle('text-deep', isSelected);
                btn.classList.toggle('bg-slate-50', isSelected);
                btn.classList.toggle('text-slate-600', !isSelected);
            });
        }

        // Setup filter button & popover
        const annFilterBtn = document.getElementById('pengumuman-filter-btn');
        const annFilterMenu = document.getElementById('pengumuman-filter-menu');
        const annChevron = document.getElementById('pengumuman-filter-chevron');

        if (annFilterBtn && annFilterMenu) {
            annFilterBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                const isOpen = !annFilterMenu.classList.contains('hidden');
                annFilterMenu.classList.toggle('hidden', isOpen);
                annFilterBtn.setAttribute('aria-expanded', String(!isOpen));
                if (annChevron) annChevron.classList.toggle('rotate-180', !isOpen);
            });

            annFilterMenu.addEventListener('click', (e) => {
                const opt = e.target.closest('[data-ann-group]');
                if (!opt) return;
                const group = opt.dataset.annGroup;
                const val = opt.dataset.annVal;
                if (group === 'prodi') activeAnnProdi = val;
                if (group === 'cat') activeAnnCat = val;
                updateAnnMenuUI();
                renderPengumuman();
            });

            const resetBtn = document.getElementById('pengumuman-reset-filter');
            if (resetBtn) {
                resetBtn.addEventListener('click', () => {
                    resetAllAnnFilters();
                });
            }

            document.addEventListener('click', (e) => {
                if (!annFilterBtn.contains(e.target) && !annFilterMenu.contains(e.target)) {
                    annFilterMenu.classList.add('hidden');
                    annFilterBtn.setAttribute('aria-expanded', 'false');
                    if (annChevron) annChevron.classList.remove('rotate-180');
                }
            });
        }

        let annDebounce;
        const annSearchInput = document.getElementById('pengumuman-search');
        if (annSearchInput) {
            annSearchInput.addEventListener('input', () => {
                clearTimeout(annDebounce);
                annDebounce = setTimeout(() => renderPengumuman(false), 150);
            });
        }
        renderPengumuman(false);

        /* 8. Grid Berita dengan Pagination Terpadu */
        let beritaCurrentPage = 1;
        let beritaPerPage = 6;

        function renderBeritaGrid(page = 1) {
            beritaCurrentPage = page;
            const totalItems = newsData.length;
            const maxPage = Math.max(1, Math.ceil(totalItems / beritaPerPage));
            if (beritaCurrentPage > maxPage) beritaCurrentPage = maxPage;
            if (beritaCurrentPage < 1) beritaCurrentPage = 1;

            const startIndex = (beritaCurrentPage - 1) * beritaPerPage;
            const endIndex = startIndex + beritaPerPage;
            const currentSlice = newsData.slice(startIndex, endIndex);

            const gridEl = document.getElementById('berita-grid');
            if (gridEl) {
                gridEl.innerHTML = currentSlice.map((n, i) => `
                    <article data-news-id="${n.id}" style="--i:${i}" class="card group cursor-pointer overflow-hidden transition-all hover:border-info/40 hover:shadow-md flex flex-col justify-between pop">
                        <div>
                            <div class="relative h-48 overflow-hidden bg-muted">
                                <img src="${n.img}" alt="${n.title}" loading="lazy" decoding="async" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
                                <span class="badge absolute left-3 top-3 bg-white text-deep shadow-sm">${n.cat}</span>
                            </div>
                            <div class="p-6">
                                <p class="text-xs font-medium text-muted-foreground">${n.date}</p>
                                <h3 class="mt-2 line-clamp-2 text-base font-bold leading-snug text-deep group-hover:text-info">${n.title}</h3>
                                <p class="mt-2 line-clamp-2 text-sm text-muted-foreground">${n.excerpt}</p>
                                <span class="mt-4 inline-flex items-center gap-1 text-xs font-bold text-info group-hover:text-deep">
                                    Baca Selengkapnya <i data-lucide="arrow-right" class="h-3.5 w-3.5 text-gold"></i>
                                </span>
                            </div>
                        </div>
                    </article>
                `).join('');
            }

            // Update Pagination UI
            const curEl = document.getElementById('berita-page-current');
            const maxEl = document.getElementById('berita-page-max');
            const countEl = document.getElementById('berita-total-count');
            const prevBtn = document.getElementById('berita-prev-btn');
            const nextBtn = document.getElementById('berita-next-btn');
            const numbersEl = document.getElementById('berita-page-numbers');

            if (curEl) curEl.textContent = String(beritaCurrentPage);
            if (maxEl) maxEl.textContent = String(maxPage);
            if (countEl) countEl.textContent = String(totalItems);

            if (prevBtn) prevBtn.disabled = beritaCurrentPage <= 1;
            if (nextBtn) nextBtn.disabled = beritaCurrentPage >= maxPage;

            if (numbersEl) {
                let html = '';
                for (let p = 1; p <= maxPage; p++) {
                    const isActive = p === beritaCurrentPage;
                    html += `
                        <button type="button" data-berita-page="${p}"
                            class="h-8 w-8 rounded-lg font-bold text-xs flex items-center justify-center transition active:scale-95 ${isActive
                            ? 'bg-deep text-white shadow-sm'
                            : 'border border-border bg-white text-slate-700 hover:bg-slate-50'
                        }">
                            ${p}
                        </button>
                    `;
                }
                numbersEl.innerHTML = html;

                numbersEl.querySelectorAll('[data-berita-page]').forEach(btn => {
                    btn.addEventListener('click', () => {
                        const targetPage = Number(btn.dataset.beritaPage);
                        if (targetPage !== beritaCurrentPage) {
                            renderBeritaGrid(targetPage);
                            const section = document.getElementById('page-berita');
                            if (section) section.scrollIntoView({ behavior: 'smooth' });
                        }
                    });
                });
            }

            lucide.createIcons();
        }

        const beritaPrevBtn = document.getElementById('berita-prev-btn');
        const beritaNextBtn = document.getElementById('berita-next-btn');
        const beritaPerPageSelect = document.getElementById('berita-per-page');

        if (beritaPrevBtn) {
            beritaPrevBtn.addEventListener('click', () => {
                if (beritaCurrentPage > 1) {
                    renderBeritaGrid(beritaCurrentPage - 1);
                    const section = document.getElementById('page-berita');
                    if (section) section.scrollIntoView({ behavior: 'smooth' });
                }
            });
        }

        if (beritaNextBtn) {
            beritaNextBtn.addEventListener('click', () => {
                const maxPage = Math.ceil(newsData.length / beritaPerPage);
                if (beritaCurrentPage < maxPage) {
                    renderBeritaGrid(beritaCurrentPage + 1);
                    const section = document.getElementById('page-berita');
                    if (section) section.scrollIntoView({ behavior: 'smooth' });
                }
            });
        }

        if (beritaPerPageSelect) {
            beritaPerPageSelect.addEventListener('change', (e) => {
                beritaPerPage = Number(e.target.value) || 6;
                renderBeritaGrid(1);
            });
        }

        renderBeritaGrid(1);

        /* 9. Gambar fade-in setelah dimuat (untuk semua <img> yang belum selesai dimuat) */
        $$('img').forEach(img => {
            if (img.complete && img.naturalWidth) return;
            img.classList.add('img-fade');
            const ok = () => img.classList.add('loaded');
            img.addEventListener('load', ok, { once: true });
            img.addEventListener('error', ok, { once: true });
        });

        /* Inisialisasi otomatis jika URL memuat hash view (#unggulan, #profil, dll.) atau hash anchor Prodi */
        const viewHashes = ['beranda', 'profil', 'unggulan', 'inovasi', 'publikasi', 'pengumuman', 'berita'];
        const initialHash = window.location.hash ? window.location.hash.slice(1) : '';
        if (viewHashes.includes(initialHash)) {
            switchPage(initialHash, { scroll: false });
        } else if (window.location.hash && window.location.hash.startsWith('#prodi-')) {
            switchPage('prodi', { scroll: false });
            setTimeout(() => {
                const targetSec = document.querySelector(window.location.hash);
                if (targetSec) {
                    const headerH = document.getElementById('prodi-site-header')?.offsetHeight || 74;
                    const targetY = targetSec.getBoundingClientRect().top + window.scrollY - headerH + 2;
                    window.scrollTo({ top: targetY, behavior: 'instant' });
                }
                updateProdiScrollspy();
            }, 60);
        }

        lucide.createIcons();

</script>
