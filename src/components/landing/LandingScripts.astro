        }

        function renderKurikulumPeminatan() {
            const data = prodiTenants[currentProdiTenant] || prodiTenants['s1-ti'];
            const pemList = data.peminatanCourses || [];
            if (!pemList.length) return;
            const curPem = pemList[currentKurPeminatanIdx % pemList.length];

            const titleEl = document.getElementById('kur-peminatan-title');
            if (titleEl) titleEl.textContent = curPem.title;

            const pillsEl = document.getElementById('kur-peminatan-pills');
            if (pillsEl) {
                pillsEl.innerHTML = pemList.map((p, idx) => {
                    const active = idx === (currentKurPeminatanIdx % pemList.length);
                    return `
                        <button type="button" onclick="selectKurikulumPeminatan(${idx})"
                            class="rounded px-3 py-1 text-xs transition-all ${active ? 'bg-white text-deep font-bold shadow-xs' : 'text-slate-600 hover:text-deep font-semibold'}">
                            ${p.shortTitle || p.title.replace('Peminatan ', '')}
                        </button>
                    `;
                }).join('');
            }

            const tbody = document.getElementById('tenant-peminatan-tbody');
            const totalSksEl = document.getElementById('tenant-peminatan-total-sks');
            if (!tbody) return;

            let total = 0;
            tbody.innerHTML = curPem.courses.map((c, i) => {
                total += c.sks;
                return `
                    <tr class="hover:bg-slate-50/80 transition-colors">
                        <td class="px-5 py-3.5 text-center font-bold text-slate-400 text-xs">${i + 1}</td>
                        <td class="px-5 py-3.5 font-mono text-xs font-bold text-deep">${c.code}</td>
                        <td class="px-5 py-3.5 font-bold text-slate-800">${c.name}</td>
                        <td class="px-5 py-3.5 text-center font-extrabold text-primary">${c.sks}</td>
                        <td class="px-5 py-3.5"><span class="rounded bg-slate-100 px-2 py-0.5 text-xs font-semibold text-slate-700">${c.cat || 'Peminatan'}</span></td>
                        <td class="px-5 py-3.5 text-xs text-slate-600">${c.desc || '-'}</td>
                    </tr>
                `;
            }).join('');

            if (totalSksEl) totalSksEl.textContent = `${total} SKS`;
            lucide.createIcons();
        }

