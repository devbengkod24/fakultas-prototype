        function toggleAnnDetail(id) {
            if (expandedAnnSet.has(id)) {
                expandedAnnSet.delete(id);
            } else {
                expandedAnnSet.add(id);
            }

            const detailEl = document.getElementById(`ann-detail-${id}`);
            const labelEl = document.getElementById(`ann-toggle-label-${id}`);
            const iconEl = document.getElementById(`ann-icon-${id}`);

            if (detailEl) {
                const isExpanded = expandedAnnSet.has(id);
                detailEl.classList.toggle('hidden', !isExpanded);
                if (labelEl) {
                    labelEl.textContent = isExpanded ? 'Tutup Detail' : 'Lihat Detail Lengkap';
                }
                if (iconEl) {
                    iconEl.classList.toggle('rotate-180', isExpanded);
                }
            }
            lucide.createIcons();
        }

        function renderProdiAnnouncements() {
            const listEl = document.getElementById('tenant-announcement-list') || document.getElementById('announcement-list');
            const totalCountEl = document.getElementById('prodi-ann-total-count');
            const rangeEl = document.getElementById('ann-showing-range');
            const paginationEl = document.getElementById('ann-pagination-controls');
            if (!listEl) return;

            const data = prodiTenants[currentProdiTenant] || prodiTenants['s1-ti'];
            const prodiShort = data.code || 'STI';
            const prodiTag = `${prodiShort} - S1`;

            // Filter data
            const filtered = prodiAnnouncementsMaster.filter(a => {
                const matchCat = (currentAnnCat === 'all') || (a.cat === currentAnnCat);
                if (!matchCat) return false;
                if (!currentAnnSearch) return true;
                const haystack = `${a.title} ${a.excerpt} ${a.author} ${a.badge}`.toLowerCase();
                return haystack.includes(currentAnnSearch);
            });

            const total = filtered.length;
            const totalPages = Math.max(1, Math.ceil(total / annPerPage));
            if (currentAnnPage > totalPages) currentAnnPage = totalPages;

            const startIndex = (currentAnnPage - 1) * annPerPage;
            const endIndex = Math.min(startIndex + annPerPage, total);
            const currentItems = filtered.slice(startIndex, endIndex);

            // Update range & count
            if (totalCountEl) totalCountEl.textContent = total;
            if (rangeEl) {
                rangeEl.textContent = total === 0 ? '0-0' : `${startIndex + 1}-${endIndex}`;
            }

            // Render Empty State if no result
            if (total === 0) {
