        let prodiAutoSlideTimer = null;
        let prodiAutoSlidePaused = false;

        function updateProdiSlideDisplay() {
            const data = prodiTenants[currentProdiTenant] || prodiTenants['s1-ti'];
            const slides = data.sliderImgs || [];
            if (!slides.length) return;
            const cur = slides[currentProdiSlideIdx % slides.length];
            const imgEl = document.getElementById('prodi-slider-img');
            const capEl = document.getElementById('prodi-slider-caption');
            const tagEl = document.getElementById('prodi-slider-tag');
            const dotsEl = document.getElementById('prodi-slider-dots');

            if (imgEl) {
                imgEl.style.opacity = '0';
                setTimeout(() => {
                    imgEl.src = cur.src;
                    imgEl.style.opacity = '1';
                }, 140);
            }
            if (capEl) capEl.textContent = cur.caption;
            if (tagEl) {
                tagEl.textContent = (data.peminatanChips && data.peminatanChips[currentProdiSlideIdx % data.peminatanChips.length]) || 'Laboratorium Riset';
            }

            if (dotsEl) {
                dotsEl.innerHTML = slides.map((_, i) => `
                    <button type="button" onclick="showProdiSlide(${i})" aria-label="Slide ${i + 1}"
                        class="${i === (currentProdiSlideIdx % slides.length) ? 'w-5 bg-gold' : 'w-2 bg-white/40 hover:bg-white/70'} h-2 rounded-full transition-all duration-300"></button>
                `).join('');
            }

            // Sync visual active chip peminatan di kiri
            document.querySelectorAll('.hero-peminatan-chip').forEach((b, i) => {
                const on = i === (currentProdiSlideIdx % slides.length);
                b.className = `hero-peminatan-chip inline-flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-xs font-semibold border transition-all duration-200 text-left cursor-pointer ${on ? 'bg-deep text-white border-deep shadow-xs' : 'bg-white text-slate-700 border-slate-200 hover:border-gold hover:text-deep'}`;
                b.style.backgroundColor = on ? 'var(--theme-deep, #072f57)' : '';
                b.style.borderColor = on ? 'var(--theme-deep, #072f57)' : '';
                const dot = b.querySelector('span');
                if (dot) {
                    dot.className = `h-1.5 w-1.5 rounded-full ${on ? 'bg-gold' : 'bg-slate-400'}`;
                }
            });
        }

        window.selectHeroPeminatan = function (idx) {
            showProdiSlide(idx);
        };

        window.showProdiSlide = function (idx) {
            const data = prodiTenants[currentProdiTenant] || prodiTenants['s1-ti'];
            const total = (data.sliderImgs || []).length || 1;
            currentProdiSlideIdx = (idx + total) % total;
            updateProdiSlideDisplay();
        };

        window.prodiNextSlide = function () {
            const data = prodiTenants[currentProdiTenant] || prodiTenants['s1-ti'];
            const total = (data.sliderImgs || []).length || 1;
            currentProdiSlideIdx = (currentProdiSlideIdx + 1) % total;
            updateProdiSlideDisplay();
        };

        window.prodiPrevSlide = function () {
            const data = prodiTenants[currentProdiTenant] || prodiTenants['s1-ti'];
            const total = (data.sliderImgs || []).length || 1;
            currentProdiSlideIdx = (currentProdiSlideIdx - 1 + total) % total;
            updateProdiSlideDisplay();
        };

        function startProdiAutoSlide() {
            if (prodiAutoSlideTimer) clearInterval(prodiAutoSlideTimer);
            prodiAutoSlideTimer = setInterval(() => {
                if (!prodiAutoSlidePaused && currentView === 'prodi') {
                    prodiNextSlide();
                }
            }, 5000);
        }

        const prodiHeroSection = document.getElementById('prodi-beranda');
        if (prodiHeroSection) {
            prodiHeroSection.addEventListener('mouseenter', () => { prodiAutoSlidePaused = true; });
            prodiHeroSection.addEventListener('mouseleave', () => { prodiAutoSlidePaused = false; });
        }

        let kurikulumMode = 'umum';
        let currentKurPeminatanIdx = 0;

        function setKurikulumMode(mode) {
            kurikulumMode = mode;
            const btnUmum = document.getElementById('btn-kur-umum');
            const btnPem = document.getElementById('btn-kur-peminatan');
            const viewUmum = document.getElementById('kurikulum-view-umum');
            const viewPem = document.getElementById('kurikulum-view-peminatan');

            if (mode === 'umum') {
                if (btnUmum) {
                    btnUmum.className = 'inline-flex items-center gap-2 rounded-lg px-4 py-2 text-xs font-bold transition-all bg-white text-deep shadow-xs';
                }
                if (btnPem) {
                    btnPem.className = 'inline-flex items-center gap-2 rounded-lg px-4 py-2 text-xs font-semibold text-slate-600 hover:text-deep transition-all';
                }
                if (viewUmum) viewUmum.classList.remove('hidden');
                if (viewPem) viewPem.classList.add('hidden');
            } else {
                if (btnPem) {
                    btnPem.className = 'inline-flex items-center gap-2 rounded-lg px-4 py-2 text-xs font-bold transition-all bg-white text-deep shadow-xs';
                    btnPem.style.backgroundColor = '';
                }
                if (btnUmum) {
                    btnUmum.className = 'inline-flex items-center gap-2 rounded-lg px-4 py-2 text-xs font-semibold text-slate-600 hover:text-deep transition-all';
                }
                if (viewUmum) viewUmum.classList.add('hidden');
                if (viewPem) viewPem.classList.remove('hidden');
                renderKurikulumPeminatan();
            }
            lucide.createIcons();
        }

        function selectProdiSemester(sem) {
            $$('#curriculum-sem-tabs .sem-btn').forEach(b => {
                const on = +b.dataset.sem === +sem;
                b.classList.toggle('bg-white', on);
                b.classList.toggle('text-deep', on);
                b.classList.toggle('shadow-xs', on);
                b.classList.toggle('text-slate-600', !on);
            });
            const data = prodiTenants[currentProdiTenant] || prodiTenants['s1-ti'];
            const rows = (data.curriculum && data.curriculum[sem]) || [];
            const tbody = document.getElementById('tenant-curriculum-tbody');
            const totalSksEl = document.getElementById('tenant-curriculum-total-sks');
            if (!tbody) return;
            if (!rows.length) {
                tbody.innerHTML = `<tr><td colspan="6" class="p-6 text-center text-xs text-muted-foreground">Silabus kurikulum semester ini sedang dalam pemutakhiran akademik.</td></tr>`;
                if (totalSksEl) totalSksEl.textContent = '0 SKS';
                return;
            }
            let total = 0;
            tbody.innerHTML = rows.map((r, i) => {
                total += (r.sks || 0);
                return `
                <tr class="hover:bg-slate-50/80 transition-colors">
                    <td class="px-5 py-3.5 text-center font-bold text-slate-400 text-xs">${i + 1}</td>
                    <td class="px-5 py-3.5 font-mono text-xs font-bold text-deep">${r.code}</td>
                    <td class="px-5 py-3.5 font-bold text-slate-800">${r.name}</td>
                    <td class="px-5 py-3.5 text-center font-extrabold text-primary">${r.sks}</td>
                    <td class="px-5 py-3.5"><span class="rounded bg-slate-100 px-2 py-0.5 text-xs font-semibold text-slate-700">${r.cat}</span></td>
                    <td class="px-5 py-3.5 text-xs text-slate-600">${r.desc}</td>
                </tr>
            `;
            }).join('');
            if (totalSksEl) totalSksEl.textContent = `${total} SKS`;
        }

        function selectKurikulumPeminatan(idx) {
            currentKurPeminatanIdx = idx;
