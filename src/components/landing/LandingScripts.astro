        /* Modal Lightbox Sertifikat */
        window.openCertModal = function (idx) {
            const data = prodiTenants[currentProdiTenant] || prodiTenants['s1-ti'];
            const certs = data.certificates || [
                {
                    type: 'iabee',
                    title: 'Akreditasi Internasional',
                    badge: 'Internasional',
                    no: 'No. 00029.P',
                    level: 'Provisionally Accredited',
                    date: 'Jakarta, 13 Februari 2020',
                    validity: 'Diakui Secara Global (Washington Accord Signatory)',
                    desc: 'Provisionally Accredited dalam Disiplin Electrical, Computer, Communications, Telecommunication and Similarly-named Engineering Programs pada tahun 2019'
                },
                {
                    type: 'lam-infokom',
                    title: 'Akreditasi Unggul',
                    badge: 'UNGGUL',
                    no: 'No. 095/SK/LAM-INFOKOM/Ak/S/VIII/2025',
                    level: 'AKREDITASI UNGGUL',
                    date: 'Jakarta, 8 Agustus 2025',
                    validity: 'Berlaku sejak 8 Agustus 2025 sampai dengan 8 Agustus 2030',
                    desc: `Menyatakan bahwa program studi ${data.name} Universitas Dian Nuswantoro, Kota Semarang Memenuhi Syarat Peringkat AKREDITASI UNGGUL`
                }
            ];
            const cert = (typeof idx === 'string') ? (idx.includes('lam') ? (certs[1] || certs[0]) : certs[0]) : (certs[idx] || certs[0]);
            const modal = document.getElementById('cert-lightbox-modal');
            const titleEl = document.getElementById('cert-modal-title');
            const prodiEl = document.getElementById('cert-modal-prodi');
            const previewEl = document.getElementById('cert-modal-preview');

            if (!modal) return;
            if (titleEl) {
                titleEl.textContent = cert.type === 'iabee' ? 'Sertifikat Akreditasi Internasional (IABEE)' : 'Sertifikat Akreditasi Unggul (LAM INFOKOM)';
            }
            if (prodiEl) prodiEl.textContent = `${data.name} · Fakultas Teknologi Cerdas UDINUS`;

            if (previewEl) {
                const isIabee = cert.type === 'iabee';
                const prodiShort = data.name.replace('Sarjana Terapan ', '').replace('Sarjana ', '').replace('Diploma Tiga ', '');

                previewEl.innerHTML = `
                    <div class="space-y-4 text-center">
                        <div class="border-b border-slate-200 pb-3">
                            <span class="inline-block rounded-full bg-sky-50 border border-sky-200 px-3 py-0.5 text-xs font-bold text-sky-700 tracking-wider uppercase mb-1.5">
