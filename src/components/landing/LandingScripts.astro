<script is:inline>
        /* 0. Helper & preferensi gerak */
        const $ = (s, r = document) => r.querySelector(s);
        const $$ = (s, r = document) => [...r.querySelectorAll(s)];
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // Ulangi animasi CSS pada elemen (dipakai saat konten berganti)
        function replay(el, cls = 'pop') {
            el.classList.remove(cls);
            void el.offsetWidth;
            el.classList.add(cls);
        }

        // Ganti src gambar dengan fade-in setelah termuat
        function swapImg(img, src) {
            img.classList.add('img-fade');
            if (img.getAttribute('src') === src) { img.classList.add('loaded'); return; }
            img.classList.remove('loaded');
            const ok = () => img.classList.add('loaded');
            img.onload = ok;
            img.onerror = ok;
            img.src = src;
            if (img.complete && img.naturalWidth) ok();
        }

        // Gesture swipe untuk layar sentuh
        function addSwipe(el, onNext, onPrev) {
            let sx = 0, sy = 0;
            el.addEventListener('touchstart', e => { sx = e.touches[0].clientX; sy = e.touches[0].clientY; }, { passive: true });
            el.addEventListener('touchend', e => {
                const t = e.changedTouches[0], dx = t.clientX - sx, dy = t.clientY - sy;
                if (Math.abs(dx) > 48 && Math.abs(dx) > Math.abs(dy) * 1.5) (dx < 0 ? onNext : onPrev)();
            }, { passive: true });
        }

        // Toast
        let toastTimer;
        function showToast(msg) {
            const t = $('#toast');
            t.textContent = msg;
            t.classList.add('show');
            clearTimeout(toastTimer);
            toastTimer = setTimeout(() => t.classList.remove('show'), 2200);
        }

        // Lepas class intro setelah animasi hero selesai (supaya tidak diputar ulang saat kembali ke Beranda)
        setTimeout(() => document.documentElement.classList.remove('intro'), 1600);

        /* 1. Page Router Simulation */
        let currentView = 'beranda';
        let lastPageBeforeDetail = 'beranda';

        const mnav = $('#mobile-nav');
        const menuBtn = $('#menu-toggle');
        function setMobileNav(open) {
            mnav.classList.toggle('open', open);
            mnav.setAttribute('aria-hidden', String(!open));
            menuBtn.setAttribute('aria-expanded', String(open));
            menuBtn.setAttribute('aria-label', open ? 'Tutup Menu' : 'Buka Menu');
            $('.icon-open', menuBtn).classList.toggle('hidden', open);
            $('.icon-close', menuBtn).classList.toggle('hidden', !open);
        }
        const closeMobileNav = () => setMobileNav(false);
        // Controls Drawer Mobile Khusus Prodi
        const prodiMnav = $('#prodi-mobile-nav');
        const prodiMenuBtn = $('#prodi-menu-toggle');
        function setProdiMobileNav(open) {
            if (!prodiMnav || !prodiMenuBtn) return;
            prodiMnav.classList.toggle('open', open);
            prodiMnav.setAttribute('aria-hidden', String(!open));
            prodiMenuBtn.setAttribute('aria-expanded', String(open));
            $('.icon-open', prodiMenuBtn)?.classList.toggle('hidden', open);
            $('.icon-close', prodiMenuBtn)?.classList.toggle('hidden', !open);
        }
        const closeProdiMobileNav = () => setProdiMobileNav(false);
        if (prodiMenuBtn) {
            prodiMenuBtn.addEventListener('click', () => setProdiMobileNav(!prodiMnav.classList.contains('open')));
        }


        function updateProdiScrollspy() {
            if (currentView !== 'prodi') return;
            const prodiNavLinks = document.querySelectorAll('#prodi-site-header nav a[href^="#prodi-"], #prodi-mobile-nav nav a[href^="#prodi-"]');
            if (!prodiNavLinks.length) return;

            const header = document.getElementById('prodi-site-header');
            const headerHeight = (header ? header.offsetHeight : 74) + 40;
            const scrollPos = window.scrollY;
            const isBottom = (window.innerHeight + scrollPos) >= (document.documentElement.scrollHeight - 60);

            let activeTarget = '#prodi-beranda';

            if (isBottom) {
                activeTarget = '#prodi-layanan';
            } else {
                const sections = [
                    { id: 'prodi-beranda', target: '#prodi-beranda' },
                    { id: 'prodi-sambutan', target: '#prodi-sambutan' },
                    { id: 'prodi-profil', target: '#prodi-profil' },
                    { id: 'prodi-peminatan', target: '#prodi-peminatan' },
                    { id: 'prodi-akreditasi', target: '#prodi-peminatan' },
                    { id: 'prodi-kurikulum', target: '#prodi-kurikulum' },
                    { id: 'prodi-unggulan', target: '#prodi-unggulan' },
                    { id: 'prodi-direktori', target: '#prodi-direktori' },
                    { id: 'prodi-pengumuman', target: '#prodi-pengumuman' },
                    { id: 'prodi-layanan', target: '#prodi-layanan' }
                ];

                for (let i = 0; i < sections.length; i++) {
                    const sec = document.getElementById(sections[i].id);
                    if (sec) {
                        const rect = sec.getBoundingClientRect();
                        if (rect.top <= headerHeight) {
                            activeTarget = sections[i].target;
                        }
                    }
                }
            }

            prodiNavLinks.forEach(link => {
                const href = link.getAttribute('href');
                const isActive = (href === activeTarget);
                link.dataset.active = isActive;
                if (isActive) {
                    link.setAttribute('aria-current', 'page');
                } else {
                    link.removeAttribute('aria-current');
                }
            });
        }

        function switchPage(id, opts = {}) {
            const { scroll = true } = opts;
            $$('.page-view').forEach(el => el.classList.add('hidden'));
            const target = $('#page-' + id);
            if (target) target.classList.remove('hidden');
            currentView = id;

            // Jika di landing prodi, sembunyikan topbar, navbar, dan footer fakultas (tampilkan footer khusus prodi)
            const isProdi = id === 'prodi';
            const siteTopbar = $('#site-topbar');
            const siteHeader = $('#site-header');
            const siteFooter = $('#site-footer');
            if (siteTopbar) siteTopbar.classList.toggle('hidden', isProdi);
            if (siteHeader) siteHeader.classList.toggle('hidden', isProdi);
            if (siteFooter) siteFooter.classList.toggle('hidden', isProdi);

            const activeNavKey = (id === 'berita-detail') ? 'berita' : (id === 'prodi' ? 'beranda' : id);
            $$('#site-header .nav-link, #mobile-nav .nav-link').forEach(b => {
                const on = b.dataset.go === activeNavKey;
                b.dataset.active = on;
                if (on) b.setAttribute('aria-current', 'page'); else b.removeAttribute('aria-current');
            });
            closeMobileNav();
            closeProdiMobileNav();
            // Pindah halaman = langsung ke atas (bukan scroll halus, karena kontennya diganti)
            if (scroll) window.scrollTo({ top: 0, behavior: 'instant' });
            if (isProdi) {
                requestAnimationFrame(updateProdiScrollspy);
            }
        }

        document.addEventListener('click', e => {
            const newsTrigger = e.target.closest('[data-news-id]');
            if (newsTrigger) {
                e.preventDefault();
                openNewsDetail(newsTrigger.dataset.newsId);
                return;
            }

            // Klik link anchor internal Prodi di topbar/navbar prodi
            const prodiLink = e.target.closest('#prodi-site-header a[href^="#prodi-"], #prodi-mobile-nav a[href^="#prodi-"]');
            if (prodiLink) {
                const href = prodiLink.getAttribute('href');
                if (href && href.length > 1) {
                    const targetSec = document.querySelector(href);
                    if (targetSec) {
                        e.preventDefault();
                        closeProdiMobileNav();
                        const headerH = document.getElementById('prodi-site-header')?.offsetHeight || 74;
                        const targetY = targetSec.getBoundingClientRect().top + window.scrollY - headerH + 2;
                        window.scrollTo({
                            top: targetY,
                            behavior: (typeof reduceMotion !== 'undefined' && reduceMotion) ? 'auto' : 'smooth'
                        });
                        if (history.pushState) {
                            history.pushState(null, null, href);
                        }
                        const prodiNavLinks = document.querySelectorAll('#prodi-site-header nav a[href^="#prodi-"], #prodi-mobile-nav nav a[href^="#prodi-"]');
                        prodiNavLinks.forEach(link => {
                            const on = link.getAttribute('href') === href;
                            link.dataset.active = on;
                            if (on) link.setAttribute('aria-current', 'page');
                            else link.removeAttribute('aria-current');
                        });
                        return;
                    }
                }
            }

            const el = e.target.closest('[data-go]');
            if (el) {
                const href = el.getAttribute('href');
                if (href && href.length > 1 && href.startsWith('#')) {
                    // Link anchor (mis. footer -> Program Studi): pindah halaman lalu scroll halus ke section
                    e.preventDefault();
                    switchPage(el.dataset.go, { scroll: false });
                    requestAnimationFrame(() => {
                        const t = $(href);
                        if (t) t.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth' });
                    });
                } else {
                    switchPage(el.dataset.go);
                }
            }
            // Klik di luar header menutup menu mobile
            if (!e.target.closest('#site-header')) closeMobileNav();
            if (!e.target.closest('#prodi-site-header')) closeProdiMobileNav();
        });

        menuBtn.addEventListener('click', () => setMobileNav(!mnav.classList.contains('open')));
        document.addEventListener('keydown', e => { if (e.key === 'Escape') { closeMobileNav(); closeProdiMobileNav(); closeCertModal(); } });

        /* 1b. Scroll: progress bar, bayangan header, tombol kembali ke atas, scrollspy prodi */
        const siteHeader = $('#site-header');
        const prodiSiteHeader = $('#prodi-site-header');
        const progressBar = $('#scroll-progress');
        const toTopBtn = $('#to-top');
        let scrollTicking = false;
        function onScroll() {
            if (scrollTicking) return;
            scrollTicking = true;
            requestAnimationFrame(() => {
                const y = window.scrollY;
                const max = document.documentElement.scrollHeight - window.innerHeight;
                if (progressBar) progressBar.style.transform = `scaleX(${max > 0 ? Math.min(y / max, 1) : 0})`;
                if (siteHeader) siteHeader.classList.toggle('is-scrolled', y > 8);
                if (prodiSiteHeader) prodiSiteHeader.classList.toggle('shadow-md', y > 8);
                if (toTopBtn) toTopBtn.classList.toggle('show', y > 600);

                if (currentView === 'prodi') {
                    updateProdiScrollspy();
                }

                scrollTicking = false;
            });
        }
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll);
        toTopBtn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' }));
        onScroll();

        /* 1c. Count-up statistik saat terlihat di layar */
        (function initCountUp() {
            const els = $$('[data-count]');
            if (reduceMotion || !('IntersectionObserver' in window)) return;
            const run = el => {
                const end = +el.dataset.count, suf = el.dataset.suffix || '';
                const t0 = performance.now(), dur = 1300;
                const tick = now => {
                    const p = Math.min((now - t0) / dur, 1);
                    el.textContent = Math.round(end * (1 - Math.pow(1 - p, 3))) + suf;
                    if (p < 1) requestAnimationFrame(tick);
                };
                requestAnimationFrame(tick);
            };
            const io = new IntersectionObserver(entries => {
                entries.forEach(en => {
                    if (en.isIntersecting) { run(en.target); io.unobserve(en.target); }
                });
            }, { threshold: 0.6 });
            els.forEach(el => { el.textContent = '0' + (el.dataset.suffix || ''); io.observe(el); });
        })();

        /* 2. Hero Slider (crossfade, pause saat hover, swipe) */
        const heroSlides = [
            {
                img: 'https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?auto=format&fit=crop&w=1000&q=80',
                title: 'Laboratorium Kecerdasan Buatan (AI)',
                sub: 'Fasilitas riset mutakhir Fakultas Teknologi Cerdas'
            },
            {
                img: 'https://images.unsplash.com/photo-1531482615713-2afd69097998?auto=format&fit=crop&w=1000&q=80',
                title: 'Inkubasi Talenta Digital & Bengkel Koding',
                sub: 'Kolaborasi proyek nyata bersama praktisi industri'
            },
            {
                img: 'https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=1000&q=80',
                title: 'Kolaborasi Riset AI & Robotika',
                sub: 'Mahasiswa FTC meraih medali emas nasional'
            }
        ];
        let heroIdx = 0, heroTimer, heroPaused = false;
        const heroImg = $('#hero-img'), heroTitle = $('#hero-title'), heroSub = $('#hero-sub'), heroDots = $('#hero-dots');

        // Preload agar crossfade tidak berkedip
        heroSlides.forEach(s => { const im = new Image(); im.src = s.img; });

        heroDots.innerHTML = heroSlides.map((_, i) =>
            `<button type="button" data-hero="${i}" aria-label="Slide ${i + 1}" class="dot-hit relative h-2 rounded-full transition-all duration-300"></button>`
        ).join('');

        function paintHeroDots() {
            $$('#hero-dots button').forEach((b, i) => {
                const on = i === heroIdx;
                b.classList.toggle('w-6', on);
                b.classList.toggle('bg-gold', on);
                b.classList.toggle('w-2', !on);
                b.classList.toggle('bg-white/60', !on);
                b.setAttribute('aria-current', String(on));
            });
        }

        function showHero(i) {
            if (i === heroIdx) return;
            heroIdx = i;
            paintHeroDots();
            const s = heroSlides[i];
            const els = [heroImg, heroTitle, heroSub].filter(Boolean);
            els.forEach(e => e.classList.add('is-out'));
            setTimeout(() => {
                const done = () => els.forEach(e => e.classList.remove('is-out'));
                if (heroTitle) heroTitle.textContent = s.title;
                if (heroSub) heroSub.textContent = s.sub;
                if (heroImg) {
                    heroImg.onload = done;
                    heroImg.onerror = done;
                    heroImg.src = s.img;
                    if (heroImg.complete && heroImg.naturalWidth) done();
                } else {
                    done();
                }
                setTimeout(done, 1200); // pengaman
            }, reduceMotion ? 0 : 250);
        }

        function startHero() {
            clearInterval(heroTimer);
            if (reduceMotion) return; // tanpa autoplay bagi yang memilih reduce motion
            heroTimer = setInterval(() => {
                if (document.hidden || heroPaused) return;
                showHero((heroIdx + 1) % heroSlides.length);
            }, 5000);
        }
        const heroNext = () => { showHero((heroIdx + 1) % heroSlides.length); startHero(); };
        const heroPrev = () => { showHero((heroIdx - 1 + heroSlides.length) % heroSlides.length); startHero(); };

        heroDots.addEventListener('click', e => {
            const b = e.target.closest('[data-hero]');
            if (!b) return;
            showHero(+b.dataset.hero);
            startHero();
        });
        const heroCard = $('#hero-card');
        heroCard.addEventListener('mouseenter', () => heroPaused = true);
        heroCard.addEventListener('mouseleave', () => heroPaused = false);
        heroCard.addEventListener('focusin', () => heroPaused = true);
        heroCard.addEventListener('focusout', () => heroPaused = false);
        addSwipe(heroCard, heroNext, heroPrev);
        paintHeroDots();
        startHero();

        /* 3. Program Studi Cards (5 Tabs: Sarjana, Vokasi, Magister/Doktor, PJJ, PSDKU - Req 5 & 9) */
        const prodiData = {
            s1: [
                { id: 's1-ti', akreditasi: 'Unggul', lokasi: 'Semarang', name: 'Sarjana Teknik Informatika', deg: '(S.Kom)', desc: 'Program studi unggulan berfokus pada kecerdasan buatan (AI), rekayasa perangkat lunak modern, keamanan siber, dan komputasi awan.' },
                { id: 's1-si', akreditasi: 'Unggul', lokasi: 'Semarang', name: 'Sarjana Sistem Informasi', deg: '(S.Kom)', desc: 'Integrasi strategis teknologi informasi bisnis, analitik data cerdas, tata kelola TI enterprise, dan solusi transformasi digital industri.' },
                { id: 's1-dkv', akreditasi: 'Unggul', lokasi: 'Semarang', name: 'Sarjana Desain Komunikasi Visual', deg: '(S.Ds)', desc: 'Eksplorasi desain komunikasi kreatif, UI/UX interaktif, branding multimedia, dan media digital berbasis teknologi mutakhir.' },
                { id: 's1-ilkom', akreditasi: 'Unggul', lokasi: 'Semarang', name: 'Sarjana Ilmu Komunikasi', deg: '(S.I.Kom)', desc: 'Komunikasi strategis, jurnalisme multimedia digital, public relations, dan broadcasting kreatif berbasis ekosistem informasi cerdas.' }
            ],
            vokasi: [
                { id: 'd4-animasi', akreditasi: 'Unggul', lokasi: 'Semarang', name: 'Sarjana Terapan Animasi', deg: '(S.Tr.Anim)', desc: 'Pengembangan animasi 2D/3D industri, visual effects (VFX), asset modeling game interaktif, dan produksi film animasi berstandar bioskop.' },
                { id: 'd4-ftv', akreditasi: 'Baik Sekali', lokasi: 'Semarang', name: 'Sarjana Terapan Film dan Televisi', deg: '(S.Tr.Sn)', desc: 'Produksi sinematografi digital, penyutradaraan, penyiaran televisi kreatif, dan tata artistik multimedia berskala nasional.' },
                { id: 'd3-ti', akreditasi: 'Unggul', lokasi: 'Semarang', name: 'Diploma Tiga Teknik Informatika', deg: '(A.Md.Kom)', desc: 'Pendidikan vokasi intensif berfokus pada keahlian praktis pemrograman web fullstack, mobile apps, dan administrasi jaringan.' },
                { id: 'd3-penyiaran', akreditasi: 'Baik Sekali', lokasi: 'Semarang', name: 'Diploma Tiga Penyiaran', deg: '(A.Md.I.Kom)', desc: 'Keahlian teknis dan kreatif penyiaran radio/televisi, produksi audio-visual, dan content creation multimedia modern.' }
            ],
            s2: [
                { id: 's2-ti', akreditasi: 'Unggul', lokasi: 'Semarang', name: 'Magister Teknik Informatika', deg: '(M.Kom)', desc: 'Pendalaman riset lanjutan kecerdasan buatan, sains data tingkat lanjut, machine learning, dan arsitektur sistem cerdas enterprise.' },
                { id: 's3-ilkomp', akreditasi: 'Baik Sekali', lokasi: 'Semarang', name: 'Doktor Ilmu Komputer', deg: '(Dr.)', desc: 'Program doktoral pencetak ilmuwan dan inovator pencetus teori orisinal di bidang artificial intelligence dan komputasi masa depan.' }
            ],
            pjj: [
                { id: 'pjj-ti', akreditasi: 'Unggul', lokasi: 'Semarang', name: 'Sarjana Teknik Informatika PJJ', deg: '(S.Kom)', desc: 'Perkuliahan fleksibel 100% online dengan kurikulum setara reguler didukung Learning Management System (LMS) interaktif dan live mentoring.' },
                { id: 'pjj-si', akreditasi: 'Baik Sekali', lokasi: 'Semarang', name: 'Sarjana Sistem Informasi PJJ', deg: '(S.Kom)', desc: 'Program jarak jauh bidang analitik data dan sistem enterprise yang dirancang khusus bagi profesional dan praktisi kerja.' }
            ],
            psdku: [
                { id: 'psdku-ti', akreditasi: 'Baik Sekali', lokasi: 'Kediri', name: 'Sarjana Teknik Informatika (PSDKU)', deg: '(S.Kom)', desc: 'Penyelenggaraan Program Studi di Luar Kampus Utama Kota Kediri dengan kurikulum, dosen, dan fasilitas berstandar kampus utama.' },
                { id: 'psdku-si', akreditasi: 'Baik Sekali', lokasi: 'Kediri', name: 'Sarjana Sistem Informasi (PSDKU)', deg: '(S.Kom)', desc: 'Pendidikan sistem informasi berkualitas di Kampus Kediri untuk mempercepat transformasi digital kawasan Jawa Timur.' },
                { id: 'psdku-d3-mi', akreditasi: 'Baik Sekali', lokasi: 'Kediri', name: 'Diploma Tiga Manajemen Informatika', deg: '(A.Md.Kom)', desc: 'Program vokasi terapan di PSDKU Kediri yang mencetak tenaga ahli madya sistem informasi dan pemrograman siap kerja.' }
            ]
        };

        function renderProdi(key, animate = true) {
            $$('#prodi-tabs .prodi-trigger').forEach(b => {
                const on = b.dataset.tab === key;
                b.dataset.state = on ? 'active' : 'inactive';
                b.setAttribute('aria-selected', String(on));
            });
            const list = prodiData[key] || [];
            document.getElementById('prodi-grid').innerHTML = list.map((p, i) => `
                <article style="--i:${i}" onclick="navigateToProdi('${p.id}')" class="${animate ? 'pop' : ''} group relative flex flex-col justify-between overflow-hidden rounded-2xl border border-slate-200/90 bg-white p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-gold hover:shadow-xl cursor-pointer">
                    <div class="relative z-10">
                        <div class="mb-4 flex items-center justify-between gap-2">
                            <!-- Pojok Kiri Atas: Badge Akreditasi Warna Kuning Emas (Req 5) -->
                            <span class="rounded-full bg-[#f5a623] px-3 py-1 text-xs font-extrabold text-[#072f57] shadow-xs">${p.akreditasi}</span>
                            <!-- Pojok Kanan Atas: Badge Lokasi Kampus (Tanpa Emoji) (Req 5) -->
                            <span class="rounded-md border border-slate-200 bg-slate-100/90 px-2.5 py-1 text-xs font-semibold text-slate-700">${p.lokasi}</span>
                        </div>
                        <!-- Judul Utama: Jenjang Lengkap Diikuti Nama Prodi (Req 5) -->
                        <h3 class="text-lg font-extrabold leading-snug text-deep transition-colors group-hover:text-primary">${p.name}</h3>
                        <!-- Sub-judul di Bawah Judul: Gelar Lulusan di Dalam Kurung (Req 5) -->
                        <p class="mt-1 text-xs font-bold text-slate-500">${p.deg}</p>
                        <!-- Isi Bawah: Paragraf Deskripsi Singkat Prodi (Req 5) -->
                        <p class="mt-3 text-sm leading-relaxed text-slate-600">${p.desc}</p>
                    </div>

                    <div class="relative z-10 mt-6 border-t border-slate-100 pt-4">
                        <span class="inline-flex items-center gap-1.5 text-xs font-extrabold text-deep transition-colors hover:text-primary group-hover:text-primary">
                            Baca selengkapnya <span aria-hidden="true">&rarr;</span>
                        </span>
                    </div>
                </article>
            `).join('');
            lucide.createIcons();
        }

        document.getElementById('prodi-tabs').addEventListener('click', e => {
            const b = e.target.closest('[data-tab]');
            if (b) renderProdi(b.dataset.tab);
        });
        renderProdi('s1', false);

        /* 4. Data Berita & Detail Berita (Sesuai Gambar 34 & 35) */
        const newsData = [
            {
                id: 'riset-ai',
                img: 'https://images.unsplash.com/photo-1531482615713-2afd69097998?auto=format&fit=crop&w=1200&q=80',
                author: 'oleh Humas Udinus',
                authorShort: 'Humas FTC',
                date: 'September 23, 2026',
                dateIndo: '23 September 2026',
                cat: 'Berita Terbaru',
                badge: 'BERITA TERBARU',
                title: 'Tim Riset AI FTC UDINUS Kembangkan Sistem Deteksi Dini Berbasis Deep Learning',
                excerpt: 'Inovasi kolaboratif antara dosen dan mahasiswa Fakultas Teknologi Cerdas (FTC) berhasil menciptakan model kecerdasan buatan yang presisi dan siap dihilirisasi bersama mitra industri nasional.',
                caption: 'Tim Riset AI FTC UDINUS saat melakukan pengujian model Deep Learning di Laboratorium Unggulan. Foto: Dok. Humas FTC',
                lead: 'Universitas Dian Nuswantoro (Udinus) melalui tim peneliti Fakultas Teknologi Cerdas (FTC) kembali melahirkan terobosan teknologi berupa sistem deteksi dini berbasis Deep Learning yang dirancang untuk mendukung efisiensi industri dan layanan kesehatan nasional.',
                body: [
