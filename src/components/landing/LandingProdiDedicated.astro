                    </div>
                    <h2 class="section-title text-deep" style="color: var(--theme-deep);">
                        Profil, Visi &amp; Misi Program Studi
                    </h2>
                    <p class="section-desc">
                        Landasan legalitas, arah keilmuan, dan komitmen mutu Tridharma Program Studi Sarjana Teknik
                        Informatika UDINUS.
                    </p>
                </div>

                <!-- UNIFIED 3-BLOK CARD: Saling menyatu dalam satu panel terpadu -->
                <div
                    class="rounded-2xl border border-slate-200 bg-white shadow-xs overflow-hidden divide-y divide-slate-200">
                    <!-- BLOK 1 (ATAS): Landasan Hukum & Rekam Jejak Akreditasi (Data Deskripsi API) -->
                    <div class="p-6 sm:p-8 space-y-4 bg-white">
                        <div
                            class="inline-flex items-center gap-2 rounded-md bg-slate-100 border border-slate-200/80 px-3 py-1 text-xs font-bold text-deep shadow-2xs">
                            <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
                            Profil &amp; Legalitas
                        </div>

                        <h3 class="text-lg sm:text-xl font-bold text-deep leading-snug"
                            style="color: var(--theme-deep);">
                            Landasan Hukum &amp; Rekam Jejak Akreditasi
