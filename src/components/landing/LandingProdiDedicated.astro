        <!-- ================= 3. Hero Section Prodi ================= -->
        <section id="prodi-beranda"
            class="relative overflow-hidden py-14 sm:py-20 bg-gradient-to-b from-slate-50 via-white to-slate-50 border-b border-border">
            <!-- Subtle Tech Dot Matrix -->
            <div class="absolute inset-0 bg-dot-matrix-subtle opacity-40 pointer-events-none"></div>

            <div class="container relative z-10 grid items-center gap-12 lg:grid-cols-12">
                <!-- Kolom Kiri: Informasi Prodi -->
                <div class="lg:col-span-6 space-y-6">
                    <div class="flex flex-wrap items-center gap-2.5">
                        <!-- Soft Chip Opsi C (Hero Prodi) -->
                        <div
                            class="inline-flex items-center gap-2 rounded-full border border-sky-200/80 bg-sky-50/90 px-3.5 py-1 text-xs font-bold text-deep shadow-2xs">
                            <span class="h-2 w-2 rounded-full bg-gold"></span>
                            <span class="tenant-badge-code">STI</span>
                            <span class="text-slate-300">·</span>
                            <span class="tracking-wide text-slate-700">PROGRAM STUDI UNGGULAN</span>
                        </div>
                        <div class="flex items-center gap-1.5">
                            <span id="tenant-badge-akred" class="badge-gold text-xs font-bold">Unggul</span>
                            <span id="tenant-badge-lokasi"
                                class="rounded-md border border-slate-300 bg-white px-2.5 py-0.5 text-xs font-semibold text-slate-700">Semarang</span>
                        </div>
                    </div>

                    <div>
                        <h1 id="tenant-hero-title"
