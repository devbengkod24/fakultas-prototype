---
---
        <!-- [Komponen: HeroSection] — Slider Full Background Ala dinus.ac.id (Req 4) -->
        <section id="hero-slider-section"
            class="relative min-h-[580px] lg:min-h-[640px] flex items-center overflow-hidden bg-deep text-white">
            <!-- Full-Width Background Slider Image & Gradient Overlay -->
            <div id="hero-card" class="absolute inset-0 z-0">
                <img id="hero-img"
                    src="https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?auto=format&fit=crop&w=1920&q=80"
                    alt="Highlight FTC UDINUS" class="hero-fade h-full w-full object-cover object-center" />
                <!-- Dark blue gradient overlay dari kiri ke kanan agar teks sangat kontras & terbaca jelas -->
                <div
                    class="absolute inset-0 bg-gradient-to-r from-[#072f57]/95 via-[#072f57]/80 to-[#072f57]/35 lg:to-transparent">
                </div>
                <div class="absolute inset-0 bg-gradient-to-t from-[#072f57]/90 via-transparent to-black/20"></div>
            </div>

            <!-- Hero Left Content -->
            <div class="container relative z-10 py-16 pb-24 lg:py-24 lg:pb-28">
                <div class="max-w-2xl lg:max-w-3xl">
                    <!-- Soft Chip Opsi C (Hero Fakultas) -->
                    <div style="--i:0"
                        class="rise mb-5 inline-flex items-center gap-2.5 rounded-full border border-white/25 bg-white/10 px-4 py-1.5 backdrop-blur-md shadow-xs">
                        <span class="h-2 w-2 rounded-full bg-gold shadow-[0_0_8px_rgba(245,184,46,0.9)]"></span>
                        <span class="text-xs font-bold uppercase tracking-wider text-white">FAKULTAS TEKNOLOGI CERDAS ·
                            UDINUS</span>
                    </div>

                    <h1 style="--i:1"
                        class="rise text-4xl font-extrabold leading-[1.08] tracking-tight text-white sm:text-5xl lg:text-[54px]">
                        Universitas<br />
                        <span class="text-gold">Dian Nuswantoro</span>
                    </h1>

                    <h2 style="--i:2"
                        class="rise mt-4 max-w-2xl text-lg font-bold leading-snug text-white/95 sm:text-2xl">
                        Membangun Masa Depan Digital Bersama Fakultas Teknologi Cerdas UDINUS
                    </h2>

                    <!-- Garis Aksen 2 Warna (Opsi C) -->
                    <div style="--i:2.5" class="rise mt-4 flex items-center gap-2">
                        <span class="h-1.5 w-12 rounded-full bg-gold"></span>
                        <span class="h-1.5 w-4 rounded-full bg-white/70"></span>
                    </div>

                    <p style="--i:3" class="rise mt-4 max-w-xl text-[15px] leading-relaxed text-white/80 sm:text-base">
                        Mencetak talenta unggul di bidang kecerdasan buatan, rekayasa perangkat lunak, dan industri
                        kreatif digital yang berdaya saing tinggi. Bergabunglah bersama ribuan alumni sukses di seluruh
                        dunia.
                    </p>

                    <div style="--i:4" class="rise mt-8 flex flex-wrap items-center gap-3.5">
                        <a href="#prodi-section" class="btn btn-gold btn-lg">
                            Jelajahi Program <i data-lucide="arrow-right" class="h-4 w-4"></i>
                        </a>
                        <a href="https://pmb.dinus.ac.id" target="_blank" rel="noopener"
                            class="btn btn-outline-light btn-lg">
                            Daftar Sekarang
                        </a>
                    </div>
                </div>
            </div>

            <!-- Slider Controls: Panah Kiri & Kanan (Auto-slide 5s, pause on hover) -->
            <button type="button" id="hero-prev-btn" onclick="heroPrev()" aria-label="Slide Sebelumnya"
                class="absolute left-4 top-1/2 -translate-y-1/2 z-20 hidden sm:flex h-11 w-11 items-center justify-center rounded-full bg-deep/60 text-white backdrop-blur-md border border-white/20 hover:bg-gold hover:text-deep transition-all">
                <i data-lucide="chevron-left" class="h-6 w-6"></i>
            </button>
            <button type="button" id="hero-next-btn" onclick="heroNext()" aria-label="Slide Selanjutnya"
                class="absolute right-4 top-1/2 -translate-y-1/2 z-20 hidden sm:flex h-11 w-11 items-center justify-center rounded-full bg-deep/60 text-white backdrop-blur-md border border-white/20 hover:bg-gold hover:text-deep transition-all">
                <i data-lucide="chevron-right" class="h-6 w-6"></i>
            </button>

            <!-- Bottom Dots Indicator -->
            <div class="absolute bottom-16 sm:bottom-18 inset-x-0 z-20 flex justify-center items-center">
                <div id="hero-dots"
                    class="flex items-center gap-2 rounded-full bg-deep/70 px-3.5 py-1.5 backdrop-blur-md border border-white/10">
                </div>
            </div>
        </section>
