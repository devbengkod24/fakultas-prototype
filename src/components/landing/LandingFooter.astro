    <!-- ===================================================================
       [Komponen: Footer Fakultas]
  ==================================================================== -->
    <footer id="site-footer" class="border-t-4 border-gold bg-deep text-white">
        <div class="container py-16">
            <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-12">
                <div class="lg:col-span-4">
                    <div class="flex items-center gap-3">
                        <div
                            class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-white font-extrabold text-deep">
                            UD</div>
                        <div class="leading-tight">
                            <div class="text-sm font-extrabold tracking-tight">UNIVERSITAS DIAN NUSWANTORO</div>
                            <div class="mt-0.5 text-xs font-semibold text-gold">Fakultas Teknologi Cerdas (FTC)</div>
                        </div>
                    </div>
                    <p class="mt-4 max-w-sm text-sm leading-relaxed text-white/70">
                        Mempersiapkan generasi digital dan teknologi cerdas yang kompeten, inovatif, dan siap menghadapi
                        tantangan masa depan.
                    </p>
                    <ul class="mt-5 space-y-2.5 text-sm text-white/75">
                        <li class="flex items-start gap-2.5">
                            <i data-lucide="map-pin" class="mt-0.5 h-4 w-4 shrink-0 text-gold"></i>
                            <span>Jl. Imam Bonjol No.207, Pendrikan Kidul, Kec. Semarang Tengah, Kota Semarang, Jawa
                                Tengah 50131</span>
                        </li>
                        <li class="flex items-center gap-2.5">
                            <i data-lucide="phone" class="h-4 w-4 shrink-0 text-gold"></i>
                            <span>(024) 3517261</span>
                        </li>
                        <li class="flex items-center gap-2.5">
                            <i data-lucide="mail" class="h-4 w-4 shrink-0 text-gold"></i>
                            <span class="break-all">sekretariat@ftc.dinus.ac.id</span>
                        </li>
                    </ul>
                </div>

                <div class="lg:col-span-3">
                    <h4 class="mb-4 text-xs font-bold uppercase tracking-wider text-gold">Program Studi</h4>
                    <ul class="space-y-2.5 text-sm text-white/75">
                        <li><a href="#prodi-section" data-go="beranda" class="transition-colors hover:text-gold">Program
                                Studi Sarjana (S1)</a></li>
                        <li><a href="#prodi-section" data-go="beranda" class="transition-colors hover:text-gold">Program
                                Diploma &amp; Sarjana Terapan (D3 &amp; SST)</a></li>
                        <li><a href="#prodi-section" data-go="beranda" class="transition-colors hover:text-gold">Program
                                Magister (S2)</a></li>
                        <li><a href="#prodi-section" data-go="beranda" class="transition-colors hover:text-gold">Program
                                Studi Doktor (S3)</a></li>
                        <li><a href="#prodi-section" data-go="beranda" class="transition-colors hover:text-gold">Program
                                Pendidikan Jarak Jauh (PJJ)</a></li>
                    </ul>
                </div>

                <div class="space-y-7 lg:col-span-2">
                    <div>
                        <h4 class="mb-3 text-xs font-bold uppercase tracking-wider text-gold">Organisasi Mahasiswa</h4>
                        <ul class="space-y-2 text-sm text-white/75">
                            <li><a href="#" class="transition-colors hover:text-gold">BEM FTC</a></li>
                            <li><a href="#" class="transition-colors hover:text-gold">DPM FTC</a></li>
                        </ul>
                    </div>
                    <div>
                        <h4 class="mb-3 text-xs font-bold uppercase tracking-wider text-gold">Biro</h4>
                        <ul class="space-y-2 text-sm text-white/75">
                            <li><a href="#" class="transition-colors hover:text-gold">Biro Akademik</a></li>
                            <li><a href="#" class="transition-colors hover:text-gold">Biro Keuangan</a></li>
                            <li><a href="#" class="transition-colors hover:text-gold">Biro Mahasiswa</a></li>
                        </ul>
                    </div>
                </div>

                <div class="lg:col-span-3">
                    <h4 class="mb-4 text-xs font-bold uppercase tracking-wider text-gold">Unit</h4>
                    <ul class="space-y-2 text-sm text-white/75">
                        <li><a href="#" class="transition-colors hover:text-gold">UPT Perpustakaan</a></li>
                        <li><a href="#" class="transition-colors hover:text-gold">UPT Career Center</a></li>
                        <li><a href="#" class="transition-colors hover:text-gold">UPT Dinustek</a></li>
                        <li><a href="#" class="transition-colors hover:text-gold">UPT LSP</a></li>
                        <li><a href="#" class="transition-colors hover:text-gold">UPT Penerbitan</a></li>
                        <li><a href="#" class="transition-colors hover:text-gold">UPT Poliklinik</a></li>
                        <li><a href="#" class="transition-colors hover:text-gold">UPT TVKU</a></li>
                    </ul>
                </div>
            </div>

            <div
