---
import MbkmHero from '../mbkm/katalog/MbkmHero.astro';
import MbkmTypeFilter from '../mbkm/katalog/MbkmTypeFilter.astro';
import MbkmCardGrid from '../mbkm/katalog/MbkmCardGrid.astro';
---
    <!-- ===================================================================
       VIEW 2: SUB-HALAMAN PROFIL (/profil)
  ==================================================================== -->
    <section id="page-profil" class="page-view hidden">
        <div class="relative overflow-hidden bg-deep text-white">
            <img src="https://images.unsplash.com/photo-1562774053-701939374585?auto=format&fit=crop&w=1600&q=80"
                alt="Gedung Kampus UDINUS" loading="lazy" decoding="async"
                class="absolute inset-0 h-full w-full object-cover object-center opacity-20" />
            <div class="absolute inset-0 bg-gradient-to-r from-deep via-deep/90 to-primary/85"></div>
            <div class="container relative z-10 py-14 sm:py-16">
                <div class="split-badge mb-4"><span class="split-badge-left">FTC</span><span
                        class="split-badge-right">TENTANG FTC UDINUS</span></div>
                <h1 class="text-3xl font-extrabold tracking-tight sm:text-5xl">Profil Fakultas</h1>
                <p class="mt-2.5 text-white/80">Fakultas Teknologi Cerdas</p>
            </div>
        </div>

        <div class="container py-16">
            <div class="card grid items-center gap-8 p-5 sm:gap-10 sm:p-10 lg:grid-cols-12">
                <div class="lg:col-span-5">
                    <img src="https://images.unsplash.com/photo-1562774053-701939374585?auto=format&fit=crop&w=800&q=80"
                        alt="Gedung UDINUS" loading="lazy" decoding="async"
                        class="h-60 w-full rounded-xl object-cover sm:h-72" />
                </div>
                <div class="lg:col-span-7">
                    <div class="split-badge mb-4"><span class="split-badge-left">FTC</span><span
                            class="split-badge-right">PENGENALAN</span></div>
                    <h2 class="text-2xl font-extrabold text-deep sm:text-3xl">Mengenal FTC UDINUS</h2>
                    <p class="mt-4 leading-relaxed text-muted-foreground">
                        Fakultas Teknologi Cerdas (FTC) Universitas Dian Nuswantoro — sebelumnya dikenal sebagai
                        Fakultas Ilmu Komputer (FIK) — adalah salah satu fakultas terkemuka di Indonesia yang berfokus
                        pada pendidikan, penelitian, dan hilirisasi inovasi di bidang kecerdasan buatan, ilmu komputer,
                        dan media kreatif digital.
                    </p>
                    <p class="mt-3 leading-relaxed text-muted-foreground">
                        Berdiri sejak tahun 1986, FTC UDINUS telah meluluskan puluhan ribu profesional digital yang
                        berkiprah di berbagai perusahaan teknologi ternama, baik di tingkat nasional maupun
                        internasional.
                    </p>
                </div>
            </div>

            <div class="mt-20">
                <div class="mx-auto max-w-xl text-center">
                    <div class="split-badge mb-4"><span class="split-badge-left">FTC</span><span
                            class="split-badge-right">TIM KEPEMIMPINAN</span></div>
                    <h2 class="section-title">Struktur Organisasi</h2>
                    <p class="mt-2.5 text-sm text-muted-foreground sm:text-base">
                        Dipimpin oleh tenaga akademik berpengalaman dan berkomitmen tinggi terhadap kemajuan FTC UDINUS.
                    </p>
                </div>

                <div class="mx-auto mt-10 grid max-w-5xl gap-6 md:grid-cols-3">
                    <div class="card hover-lift overflow-hidden">
                        <img src="https://images.unsplash.com/photo-1560250097-0b93528c311a?auto=format&fit=crop&w=500&q=80"
                            alt="Sri Winarno, M.Kom., Ph.D." loading="lazy" decoding="async"
                            class="h-72 w-full bg-muted object-cover object-top" />
                        <div class="border-t-4 border-gold p-5">
                            <p class="text-xs font-bold uppercase tracking-wider text-info">Dekan</p>
                            <p class="mt-1 font-bold text-deep">Sri Winarno, M.Kom., Ph.D.</p>
                        </div>
                    </div>

                    <div class="card hover-lift overflow-hidden">
                        <img src="https://images.unsplash.com/photo-1519085360753-af0119f7cbe7?auto=format&fit=crop&w=500&q=80"
                            alt="Dr. Ir. Pujiono" loading="lazy" decoding="async"
                            class="h-72 w-full bg-muted object-cover object-top" />
                        <div class="border-t-4 border-gold p-5">
                            <p class="text-xs font-bold uppercase tracking-wider text-info">Wakil Dekan Bidang Akademik
                            </p>
                            <p class="mt-1 font-bold text-deep">Dr. Ir. Pujiono, S.Si., M.Kom., IPM, Asean Eng.</p>
                        </div>
                    </div>

                    <div class="card hover-lift overflow-hidden">
                        <img src="https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?auto=format&fit=crop&w=500&q=80"
                            alt="Affandy, M.Kom., Ph.D." loading="lazy" decoding="async"
                            class="h-72 w-full bg-muted object-cover object-top" />
                        <div class="border-t-4 border-gold p-5">
                            <p class="text-xs font-bold uppercase tracking-wider text-info">Wakil Dekan Bidang
                                Umum/Keu/SDM</p>
                            <p class="mt-1 font-bold text-deep">Affandy, M.Kom., Ph.D.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ===================================================================
       VIEW 3A: SUB-HALAMAN UNGGULAN / MBKM (Tanpa Refresh / SPA)
  ==================================================================== -->
    <section id="page-unggulan" class="page-view hidden">
        <MbkmHero />

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
            <MbkmTypeFilter />
            <MbkmCardGrid />
        </div>
    </section>

    <!-- ===================================================================
       VIEW 3B: SUB-HALAMAN INOVASI (/inovasi) - Req 7
  ==================================================================== -->
    <section id="page-inovasi" class="page-view hidden">
        <div class="relative overflow-hidden bg-deep text-white">
            <img src="https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?auto=format&fit=crop&w=1600&q=80"
                alt="Produk Inovasi FTC UDINUS" loading="lazy" decoding="async"
                class="absolute inset-0 h-full w-full object-cover object-center opacity-20" />
            <div class="absolute inset-0 bg-gradient-to-r from-deep via-deep/90 to-primary/85"></div>
            <div class="container relative z-10 py-14 sm:py-16">
                <div class="split-badge mb-4">
                    <span class="split-badge-left">FTC</span>
                    <span class="split-badge-right">PRODUK RISET &amp; INOVASI TEKNOLOGI</span>
                </div>
                <h1 class="text-3xl font-extrabold tracking-tight sm:text-5xl text-white">Karya Inovasi Sivitas
                    Akademika</h1>
                <p class="mt-2.5 max-w-2xl text-white/80">Hilirisasi riset terapan dosen dan mahasiswa: perangkat IoT,
                    model AI cerdas, aplikasi industri, hingga hak paten/HKI terdaftar.</p>
            </div>
        </div>

        <div class="container py-14">
            <!-- Filter Bar Prodi (Req 7) -->
            <div class="flex flex-wrap items-center gap-2 pb-8 border-b border-border" id="inovasi-prodi-filter">
                <button type="button" data-prodi-filter="all" class="pill" data-state="active">Semua Program
                    Studi</button>
                <button type="button" data-prodi-filter="ti" class="pill" data-state="inactive">Teknik
                    Informatika</button>
                <button type="button" data-prodi-filter="si" class="pill" data-state="inactive">Sistem
                    Informasi</button>
                <button type="button" data-prodi-filter="dkv" class="pill" data-state="inactive">Desain Komunikasi
                    Visual</button>
                <button type="button" data-prodi-filter="vokasi" class="pill" data-state="inactive">Vokasi (Animasi
                    &amp; FTV)</button>
            </div>

            <!-- Grid Card 3 Kolom Produk Inovasi (Req 7) -->
            <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3" id="inovasi-grid">
                <!-- Diisi secara dinamis via JS -->
            </div>
        </div>
    </section><!-- ===================================================================
       VIEW 4: SUB-HALAMAN PUBLIKASI (/publikasi)
  ==================================================================== -->
    <section id="page-publikasi" class="page-view hidden">
        <div class="relative overflow-hidden bg-deep text-white">
            <img src="https://images.unsplash.com/photo-1456513080510-7bf3a84b82f8?auto=format&fit=crop&w=1600&q=80"
                alt="Riset & Publikasi Ilmiah FTC UDINUS" loading="lazy" decoding="async"
                class="absolute inset-0 h-full w-full object-cover object-center opacity-20" />
            <div class="absolute inset-0 bg-gradient-to-r from-deep via-deep/90 to-primary/85"></div>
            <div class="container relative z-10 py-14 sm:py-16">
                <div class="split-badge mb-4"><span class="split-badge-left">FTC</span><span
                        class="split-badge-right">EKOSISTEM RISET CERDAS</span></div>
                <h1 class="text-3xl font-extrabold tracking-tight sm:text-5xl">Publikasi &amp; Penelitian</h1>
                <p class="mt-2.5 text-white/80">Fakultas Teknologi Cerdas UDINUS</p>
                <div
                    class="mt-6 flex max-w-xl items-center rounded-xl bg-white shadow-md ring-1 ring-black/5 focus-within:ring-2 focus-within:ring-gold">
                    <i data-lucide="search" class="pointer-events-none ml-3.5 h-4 w-4 shrink-0 text-slate-400"></i>
                    <input id="pub-search" type="search" placeholder="Ketik untuk mencari artikel..."
                        aria-label="Cari publikasi atau penelitian"
                        class="h-11 w-full bg-transparent px-3 text-sm text-foreground placeholder:text-muted-foreground focus:outline-none" />

                    <!-- Dropdown Pemilih Judul / Penulis Sesuai Screenshot -->
                    <div class="relative shrink-0 p-1">
                        <button id="pub-search-type-btn" type="button"
                            class="flex h-9 items-center gap-1.5 rounded-lg bg-info px-3.5 text-xs font-semibold text-white shadow-sm transition hover:bg-info/90 focus:outline-none"
                            aria-haspopup="listbox" aria-expanded="false">
                            <span id="pub-search-type-label">Judul</span>
                            <i data-lucide="chevron-down" id="pub-search-chevron"
                                class="h-3.5 w-3.5 transition-transform duration-200"></i>
                        </button>

                        <div id="pub-search-type-menu"
                            class="absolute right-1 top-[calc(100%+6px)] z-40 hidden min-w-[110px] overflow-hidden rounded-lg bg-info text-white shadow-xl ring-1 ring-black/10">
                            <button type="button" data-search-type="judul"
                                class="w-full px-3.5 py-2 text-left text-xs font-semibold transition-colors hover:bg-white/20">
                                Judul
                            </button>
                            <button type="button" data-search-type="penulis"
                                class="w-full px-3.5 py-2 text-left text-xs font-semibold transition-colors hover:bg-white/20">
                                Penulis
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="container grid gap-8 py-14 lg:grid-cols-12">
            <!-- Kolom Kiri: Filter & Chart Tren -->
            <aside class="space-y-6 lg:col-span-3">
                <div class="card space-y-5 p-5">
                    <!-- Indeks / Sumber (Dinamis: Artikel vs Sumber Pendanaan) -->
                    <div>
                        <h4 id="pub-filter-category-title"
                            class="mb-3 text-xs font-bold uppercase tracking-wider text-deep">Artikel</h4>
                        <div id="pub-filter-sources" class="space-y-2 text-sm text-muted-foreground">
                            <label class="flex items-center gap-2.5 cursor-pointer hover:text-deep transition-colors">
                                <input type="checkbox" checked class="h-4 w-4 rounded border-input accent-primary" />
                                SCOPUS
                            </label>
                            <label class="flex items-center gap-2.5 cursor-pointer hover:text-deep transition-colors">
                                <input type="checkbox" checked class="h-4 w-4 rounded border-input accent-primary" />
                                GARUDA
                            </label>
                            <label class="flex items-center gap-2.5 cursor-pointer hover:text-deep transition-colors">
                                <input type="checkbox" checked class="h-4 w-4 rounded border-input accent-primary" />
                                GOOGLE_SCHOLAR
                            </label>
                        </div>
                    </div>

                    <!-- Program Studi Lengkap Sesuai Inspirasi -->
                    <div class="border-t border-border pt-5">
                        <h4 class="mb-3 text-xs font-bold uppercase tracking-wider text-deep">Prodi</h4>
                        <div class="max-h-56 space-y-2 overflow-y-auto pr-1 text-sm text-muted-foreground">
                            <label class="flex items-center gap-2.5 cursor-pointer hover:text-deep"><input
                                    type="checkbox" class="h-4 w-4 rounded border-input accent-primary" /> TI S1</label>
                            <label class="flex items-center gap-2.5 cursor-pointer hover:text-deep"><input
                                    type="checkbox" class="h-4 w-4 rounded border-input accent-primary" /> SI S1</label>
                            <label class="flex items-center gap-2.5 cursor-pointer hover:text-deep"><input
                                    type="checkbox" class="h-4 w-4 rounded border-input accent-primary" /> Ilkom
                                S1</label>
                            <label class="flex items-center gap-2.5 cursor-pointer hover:text-deep"><input
                                    type="checkbox" class="h-4 w-4 rounded border-input accent-primary" /> DKV
                                S1</label>
                            <label class="flex items-center gap-2.5 cursor-pointer hover:text-deep"><input
                                    type="checkbox" class="h-4 w-4 rounded border-input accent-primary" /> PJJ TI
                                S1</label>
                            <label class="flex items-center gap-2.5 cursor-pointer hover:text-deep"><input
                                    type="checkbox" class="h-4 w-4 rounded border-input accent-primary" /> TI S2</label>
                            <label class="flex items-center gap-2.5 cursor-pointer hover:text-deep"><input
                                    type="checkbox" class="h-4 w-4 rounded border-input accent-primary" /> IK S3</label>
                            <label class="flex items-center gap-2.5 cursor-pointer hover:text-deep"><input
                                    type="checkbox" class="h-4 w-4 rounded border-input accent-primary" /> FTV
                                D4</label>
                            <label class="flex items-center gap-2.5 cursor-pointer hover:text-deep"><input
                                    type="checkbox" class="h-4 w-4 rounded border-input accent-primary" /> ANIMASI
                                D4</label>
                            <label class="flex items-center gap-2.5 cursor-pointer hover:text-deep"><input
                                    type="checkbox" class="h-4 w-4 rounded border-input accent-primary" /> TI D3</label>
                        </div>
                    </div>

                    <!-- Filter Rentang Tahun -->
                    <div class="border-t border-border pt-5">
                        <h4 class="mb-3 text-xs font-bold uppercase tracking-wider text-deep">Tahun</h4>
                        <div class="grid grid-cols-2 gap-2">
                            <div>
                                <label class="sr-only">Tahun Min</label>
                                <select
                                    class="h-9 w-full rounded-md border border-input bg-background px-2 text-xs text-foreground focus:outline-none focus:ring-1 focus:ring-primary">
                                    <option value="">Min</option>
                                    <option value="2021">2021</option>
                                    <option value="2022">2022</option>
                                    <option value="2023">2023</option>
                                    <option value="2024">2024</option>
                                    <option value="2025">2025</option>
                                    <option value="2026">2026</option>
                                </select>
                            </div>
                            <div>
                                <label class="sr-only">Tahun Maks</label>
                                <select
                                    class="h-9 w-full rounded-md border border-input bg-background px-2 text-xs text-foreground focus:outline-none focus:ring-1 focus:ring-primary">
                                    <option value="">Maks</option>
                                    <option value="2026" selected>2026</option>
                                    <option value="2025">2025</option>
                                    <option value="2024">2024</option>
                                    <option value="2023">2023</option>
                                    <option value="2022">2022</option>
                                    <option value="2021">2021</option>
                                </select>
                            </div>
                        </div>
                        <div class="mt-3 flex items-center gap-2">
                            <button type="button" class="btn btn-default !h-8 flex-1 text-xs">Apply</button>
                            <button type="button" class="btn btn-outline !h-8 flex-1 text-xs">Clear</button>
                        </div>
                    </div>
                </div>

                <!-- Card Chart Tren di Sidebar Kiri -->
                <div class="card p-5" id="pub-sidebar-chart-card">
                    <div class="flex items-center justify-between gap-2 border-b border-border pb-3">
                        <h4 id="pub-chart-title" class="text-xs font-bold uppercase tracking-wider text-deep">Artikel
                            Publikasi</h4>
                        <span id="pub-chart-period"
                            class="rounded border border-border bg-muted/60 px-2 py-0.5 text-[11px] font-semibold text-muted-foreground">5
                            Tahun</span>
                    </div>
                    <div class="mt-4" id="pub-chart-container">
                        <!-- SVG Chart Responsif yang Elegan -->
                        <div class="relative h-32 w-full">
                            <svg class="h-full w-full overflow-visible" viewBox="0 0 280 120"
                                preserveAspectRatio="none">
                                <line x1="0" y1="20" x2="280" y2="20" stroke="hsl(var(--border))" stroke-dasharray="2 2"
                                    stroke-width="1" />
                                <line x1="0" y1="60" x2="280" y2="60" stroke="hsl(var(--border))" stroke-dasharray="2 2"
                                    stroke-width="1" />
                                <line x1="0" y1="100" x2="280" y2="100" stroke="hsl(var(--border))" stroke-width="1" />

                                <!-- Green Line -->
                                <path d="M 10 95 Q 60 90, 110 82 T 210 25 T 270 55" fill="none" stroke="#10b981"
                                    stroke-width="2.5" stroke-linecap="round" />
                                <!-- Orange Line -->
                                <path d="M 10 102 Q 60 98, 110 88 T 210 50 T 270 95" fill="none" stroke="#f59e0b"
                                    stroke-width="2.5" stroke-linecap="round" />
                                <!-- Blue Line -->
                                <path d="M 10 108 Q 60 105, 110 95 T 210 75 T 270 92" fill="none" stroke="#0ea5e9"
                                    stroke-width="2.5" stroke-linecap="round" />
                            </svg>
                        </div>
                        <div class="mt-2.5 flex justify-between text-[11px] font-mono text-muted-foreground">
                            <span>2021</span>
                            <span>2022</span>
                            <span>2023</span>
                            <span>2024</span>
                            <span>2025</span>
                            <span>2026</span>
                        </div>
                    </div>
                </div>
            </aside>

            <!-- Kolom Tengah: Tab + List + Pagination -->
            <div class="space-y-4 lg:col-span-6">
                <!-- Tab Selector dengan Style Modern -->
                <div class="grid grid-cols-2 gap-2 rounded-xl border border-border bg-slate-100/90 p-1.5" id="pub-tabs"
                    role="tablist">
                    <button data-pubtab="artikel" role="tab" aria-selected="true"
                        class="pub-tab inline-flex items-center justify-center gap-2 rounded-lg py-2.5 text-xs sm:text-sm font-bold transition-all">
                        <i data-lucide="file-text" class="h-4 w-4"></i> Artikel
                    </button>
                    <button data-pubtab="penelitian" role="tab" aria-selected="false"
                        class="pub-tab inline-flex items-center justify-center gap-2 rounded-lg py-2.5 text-xs sm:text-sm font-bold transition-all">
                        <i data-lucide="flask-conical" class="h-4 w-4"></i> Penelitian
                    </button>
                </div>

                <!-- Container List Kartu Dinamis -->
                <div id="pub-list" class="space-y-4" aria-live="polite"></div>

                <!-- Pagination Bar Sesuai Gambar Inspirasi -->
                <div
                    class="card p-4 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-muted-foreground">
                    <div>
                        Page <span class="font-bold text-deep">1</span> of <span id="pub-page-max"
                            class="font-bold text-deep">1548</span> (<span id="pub-total-items"
                            class="font-semibold">7740</span> total items)
                    </div>
                    <div class="flex items-center gap-1">
                        <button
                            class="h-8 w-8 rounded-lg border border-border bg-white flex items-center justify-center text-muted-foreground hover:bg-slate-50 transition"
                            aria-label="Previous">
                            <i data-lucide="chevron-left" class="h-4 w-4"></i>
                        </button>
                        <button
                            class="h-8 w-8 rounded-lg bg-deep text-white font-bold flex items-center justify-center shadow-sm">1</button>
                        <button
                            class="h-8 w-8 rounded-lg border border-border bg-white flex items-center justify-center font-semibold text-deep hover:bg-slate-50 transition">2</button>
                        <button
                            class="h-8 w-8 rounded-lg border border-border bg-white flex items-center justify-center font-semibold text-deep hover:bg-slate-50 transition">3</button>
                        <span class="px-1 text-slate-400">...</span>
                        <button id="pub-last-page"
                            class="h-8 px-2 rounded-lg border border-border bg-white flex items-center justify-center font-semibold text-deep hover:bg-slate-50 transition">1548</button>
                        <button
                            class="h-8 w-8 rounded-lg border border-border bg-white flex items-center justify-center text-muted-foreground hover:bg-slate-50 transition"
                            aria-label="Next">
                            <i data-lucide="chevron-right" class="h-4 w-4"></i>
                        </button>
                    </div>
                    <div>
                        <select
                            class="h-8 rounded-lg border border-border bg-white px-2.5 text-xs text-slate-700 focus:outline-none">
                            <option>Show 5 items</option>
                            <option>Show 10 items</option>
                            <option>Show 25 items</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Kolom Kanan: Stat Cards + Top Contributors -->
            <div class="space-y-5 lg:col-span-3">
                <div class="grid grid-cols-2 gap-3">
                    <div class="card p-4 flex items-center gap-3">
                        <div
                            class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-primary/10 text-primary">
                            <i data-lucide="user" class="h-5 w-5"></i>
                        </div>
                        <div class="min-w-0">
                            <div id="pub-stat-author-num" class="text-xl font-extrabold text-deep">158</div>
                            <div id="pub-stat-author-label" class="truncate text-xs font-medium text-muted-foreground">
                                Author</div>
                        </div>
                    </div>
                    <div class="card p-4 flex items-center gap-3">
                        <div id="pub-stat-icon-wrap"
                            class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-amber-500/10 text-amber-600">
                            <i data-lucide="file-text" id="pub-stat-icon" class="h-5 w-5"></i>
                        </div>
                        <div class="min-w-0">
                            <div id="pub-stat-pub-num" class="text-xl font-extrabold text-deep">7740</div>
                            <div id="pub-stat-pub-label" class="truncate text-xs font-medium text-muted-foreground">
                                Publikasi</div>
                        </div>
                    </div>
                </div>

                <!-- Top Contributors Card (10 Kontributor Lengkap) -->
                <div class="card overflow-hidden" id="pub-contributors-card">
                    <div
                        class="flex items-center gap-2 bg-deep px-4 py-3 text-xs font-bold uppercase tracking-wider text-white">
                        <i data-lucide="trophy" class="h-4 w-4 text-gold"></i> Top Contributors
                    </div>
                    <ul class="divide-y divide-border text-xs">
                        <li class="flex items-center justify-between gap-3 bg-amber-50/70 px-3.5 py-2.5">
                            <div class="flex min-w-0 items-center gap-2.5">
                                <span class="w-4 text-center font-bold text-slate-500">1</span>
                                <div
                                    class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-amber-200/80 font-bold text-amber-900">
                                    E</div>
                                <div class="min-w-0">
