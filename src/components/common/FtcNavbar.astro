---
// src/components/common/FtcNavbar.astro
interface Props {
  activeNav?: string;
}

const { activeNav = 'mbkm' } = Astro.props;

const navItems = [
  { label: 'Beranda', href: '/', id: 'beranda' },
  { label: 'Profil', href: '/#profil', id: 'profil' },
  { label: 'Inovasi', href: '/#inovasi', id: 'inovasi' },
  { label: 'Publikasi', href: '/#publikasi', id: 'publikasi' },
  { label: 'Unggulan', href: '/mbkm', id: 'mbkm' },
  { label: 'Pengumuman', href: '/#pengumuman', id: 'pengumuman' },
  { label: 'Berita Kegiatan', href: '/#berita', id: 'berita' },
];
---

<header id="site-header" class="sticky top-0 z-50 border-b border-slate-200/80 bg-white/95 backdrop-blur-md shadow-xs transition-shadow">
  <div class="max-w-7xl mx-auto flex h-[74px] items-center justify-between gap-3 px-4 sm:px-6 lg:px-8">

    <!-- Logo Brand FTC UDINUS -->
    <a href="/" class="flex min-w-0 items-center gap-3 text-left focus:outline-none group">
      <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-[#072f57] text-base font-extrabold tracking-tighter text-white shadow-sm transition-transform group-hover:scale-105">
        <span class="text-[#f59e0b]">U</span>D
      </div>
      <div class="min-w-0 leading-tight">
        <div class="flex items-center gap-2">
          <span class="truncate text-[16px] sm:text-[17px] font-extrabold tracking-tight text-[#072f57]">FTC UDINUS</span>
        </div>
        <span class="block truncate text-xs font-medium text-slate-500">Fakultas Teknologi Cerdas</span>
      </div>
    </a>

    <!-- Navigasi Desktop -->
    <nav class="hidden lg:flex items-center gap-1" aria-label="Navigasi Utama">
      {navItems.map((item) => {
        const isActive = activeNav === item.id;
        return (
          <a
            href={item.href}
            class={`rounded-lg px-3.5 py-2 text-sm font-medium transition-all ${
              isActive
                ? 'bg-blue-50 font-bold text-[#0b4d8c] shadow-xs'
                : 'text-slate-600 hover:bg-slate-100/80 hover:text-[#072f57]'
            }`}
            aria-current={isActive ? 'page' : undefined}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <!-- Tombol Aksi Kanan -->
    <div class="flex shrink-0 items-center gap-2 sm:gap-2.5">
      <a
        href="https://pmb.dinus.ac.id"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:inline-flex items-center justify-center gap-1.5 h-10 px-4 rounded-xl border border-slate-200 bg-white text-slate-700 text-sm font-semibold hover:bg-slate-50 hover:text-[#072f57] transition shadow-xs"
      >
        <span>Pendaftaran</span>
        <i data-lucide="arrow-up-right" class="w-4 h-4 text-[#0b4d8c]"></i>
      </a>

      <a
        href="/apps"
        class="inline-flex items-center justify-center gap-1.5 h-10 px-4 sm:px-5 rounded-xl bg-[#f59e0b] hover:bg-[#d97706] text-[#072f57] hover:text-white text-sm font-bold shadow-xs transition-all"
        aria-label="Portal Apps"
      >
        <i data-lucide="layout-grid" class="w-4 h-4"></i>
        <span>Portal Apps</span>
      </a>

      <!-- Tombol Hamburger Mobile -->
      <button
        id="ftc-menu-toggle"
        type="button"
        class="lg:hidden inline-flex items-center justify-center w-10 h-10 rounded-xl border border-slate-200 bg-white text-slate-700 hover:bg-slate-50 focus:outline-none"
        aria-label="Buka Menu"
        aria-expanded="false"
        aria-controls="ftc-mobile-nav"
      >
        <i id="ftc-icon-open" data-lucide="menu" class="w-5 h-5"></i>
        <i id="ftc-icon-close" data-lucide="x" class="w-5 h-5 hidden"></i>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Navigation -->
  <div id="ftc-mobile-nav" class="hidden lg:hidden border-t border-slate-200 bg-white px-4 sm:px-6 py-4 shadow-lg">
    <nav class="flex flex-col gap-1" aria-label="Navigasi Seluler">
      {navItems.map((item) => {
        const isActive = activeNav === item.id;
        return (
          <a
            href={item.href}
            class={`rounded-lg px-3.5 py-2.5 text-sm font-medium transition-colors ${
              isActive
                ? 'bg-blue-50 font-bold text-[#0b4d8c]'
                : 'text-slate-700 hover:bg-slate-100'
            }`}
            aria-current={isActive ? 'page' : undefined}
          >
            {item.label}
          </a>
        );
      })}
      <div class="mt-3 pt-3 border-t border-slate-100 flex flex-col gap-2">
        <a
          href="https://pmb.dinus.ac.id"
          target="_blank"
          rel="noopener noreferrer"
          class="sm:hidden flex items-center justify-center gap-2 h-10 rounded-xl border border-slate-200 text-slate-700 text-sm font-semibold"
        >
          <span>Pendaftaran Mahasiswa Baru</span>
          <i data-lucide="arrow-up-right" class="w-4 h-4 text-[#0b4d8c]"></i>
        </a>
      </div>
    </nav>
  </div>
</header>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const toggleBtn = document.getElementById('ftc-menu-toggle');
    const mobileNav = document.getElementById('ftc-mobile-nav');
    const iconOpen = document.getElementById('ftc-icon-open');
    const iconClose = document.getElementById('ftc-icon-close');
    const siteHeader = document.getElementById('site-header');

    if (toggleBtn && mobileNav) {
      toggleBtn.addEventListener('click', () => {
        const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
        toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
        mobileNav.classList.toggle('hidden');
        if (iconOpen && iconClose) {
          iconOpen.classList.toggle('hidden');
          iconClose.classList.toggle('hidden');
        }
      });
    }

    if (siteHeader) {
      window.addEventListener('scroll', () => {
        if (window.scrollY > 10) {
          siteHeader.classList.add('shadow-md');
        } else {
          siteHeader.classList.remove('shadow-md');
        }
      }, { passive: true });
    }

    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });
</script>
