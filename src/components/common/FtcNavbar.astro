---
// src/components/common/FtcNavbar.astro
interface Props {
  activeNav?: string;
}

const { activeNav = 'mbkm' } = Astro.props;

const navItems = [
  { label: 'Beranda', href: '/', id: 'beranda' },
  { label: 'Profil', href: '/#profil', id: 'profil' },
  { label: 'Inovasi', href: '/#inovasi', id: 'inovasi' },
  { label: 'Publikasi', href: '/#publikasi', id: 'publikasi' },
  { label: 'Unggulan', href: '/#unggulan', id: 'mbkm' },
  { label: 'Pengumuman', href: '/#pengumuman', id: 'pengumuman' },
  { label: 'Berita Kegiatan', href: '/#berita', id: 'berita' },
];
---

<!-- TopBar Identitas FTC (sama dengan LandingNavbar) -->
<div id="site-topbar" class="border-b border-white/10 bg-[#083460] text-xs text-white/80">
  <div class="max-w-7xl mx-auto flex h-10 items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
    <div class="flex min-w-0 items-center gap-2">
      <span class="truncate text-[#f5b82e]">Fakultas Teknologi Cerdas, Universitas Dian Nuswantoro</span>
    </div>
    <div class="flex shrink-0 items-center gap-3 sm:gap-5">
      <a href="https://dinus.ac.id" target="_blank" rel="noopener noreferrer"
        class="hidden transition-colors hover:text-white sm:inline">Website UDINUS</a>
      <a href="https://alumni.dinus.id" target="_blank" rel="noopener noreferrer"
        class="hidden transition-colors hover:text-white sm:inline">Alumni</a>
      <span class="hidden h-3.5 w-px bg-white/20 sm:block"></span>
      <div class="flex items-center gap-2.5">
        <a href="https://instagram.com/ftc_udinus" target="_blank" rel="noopener noreferrer"
          aria-label="Instagram FTC UDINUS" class="text-white/80 hover:text-[#f5b82e] transition-colors">
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
          </svg>
        </a>
        <a href="https://tiktok.com/@ftc_udinus" target="_blank" rel="noopener noreferrer"
          aria-label="TikTok FTC UDINUS" class="text-white/80 hover:text-[#f5b82e] transition-colors">
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64c.298 0 .59.043.87.126V9.36a6.37 6.37 0 0 0-.87-.06 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.34-6.34V8.75a8.28 8.28 0 0 0 4.84 1.57V6.87a4.84 4.84 0 0 1-1.07-.18z" />
          </svg>
        </a>
        <a href="https://facebook.com/ftcudinus" target="_blank" rel="noopener noreferrer"
          aria-label="Facebook FTC UDINUS" class="text-white/80 hover:text-[#f5b82e] transition-colors">
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</div>

<header id="site-header" class="sticky top-0 z-50 border-b border-slate-200/80 bg-white/95 backdrop-blur-md shadow-xs transition-shadow">
  <div class="max-w-7xl mx-auto flex h-[74px] items-center justify-between gap-3 px-4 sm:px-6 lg:px-8">

    <!-- Logo Brand FTC UDINUS -->
    <a href="/" class="flex min-w-0 items-center gap-3 text-left focus:outline-none group">
      <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-[#072f57] text-base font-extrabold tracking-tighter text-white shadow-sm transition-transform group-hover:scale-105">
        <span class="text-[#f59e0b]">U</span>D
      </div>
      <div class="min-w-0 leading-tight">
        <div class="flex items-center gap-2">
          <span class="truncate text-[16px] sm:text-[17px] font-extrabold tracking-tight text-[#072f57]">FTC UDINUS</span>
        </div>
        <span class="block truncate text-xs font-medium text-slate-500">Fakultas Teknologi Cerdas</span>
      </div>
    </a>

    <!-- Navigasi Desktop -->
    <nav class="hidden lg:flex items-center gap-1" aria-label="Navigasi Utama">
      {navItems.map((item) => {
        const isActive = activeNav === item.id;
        return (
          <a
            href={item.href}
            class={`rounded-lg px-3.5 py-2 text-sm font-medium transition-all ${
              isActive
                ? 'bg-blue-50 font-bold text-[#0b4d8c] shadow-xs'
                : 'text-slate-600 hover:bg-slate-100/80 hover:text-[#072f57]'
            }`}
            aria-current={isActive ? 'page' : undefined}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <!-- Tombol Aksi Kanan -->
    <div class="flex shrink-0 items-center gap-2 sm:gap-2.5">
      <a
        href="https://pmb.dinus.ac.id"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:inline-flex items-center justify-center gap-1.5 h-10 px-4 rounded-xl border border-slate-200 bg-white text-slate-700 text-sm font-semibold hover:bg-slate-50 hover:text-[#072f57] transition shadow-xs"
      >
        <span>Pendaftaran</span>
        <i data-lucide="arrow-up-right" class="w-4 h-4 text-[#0b4d8c]"></i>
      </a>

      <a
        href="/apps"
        class="inline-flex items-center justify-center gap-1.5 h-10 px-4 sm:px-5 rounded-xl bg-[#f59e0b] hover:bg-[#d97706] text-[#072f57] hover:text-white text-sm font-bold shadow-xs transition-all"
        aria-label="Portal Apps"
      >
        <i data-lucide="layout-grid" class="w-4 h-4"></i>
        <span>Portal Apps</span>
      </a>

      <!-- Tombol Hamburger Mobile -->
      <button
        id="ftc-menu-toggle"
        type="button"
        class="lg:hidden inline-flex items-center justify-center w-10 h-10 rounded-xl border border-slate-200 bg-white text-slate-700 hover:bg-slate-50 focus:outline-none"
        aria-label="Buka Menu"
        aria-expanded="false"
        aria-controls="ftc-mobile-nav"
      >
        <i id="ftc-icon-open" data-lucide="menu" class="w-5 h-5"></i>
        <i id="ftc-icon-close" data-lucide="x" class="w-5 h-5 hidden"></i>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Navigation -->
  <div id="ftc-mobile-nav" class="hidden lg:hidden border-t border-slate-200 bg-white px-4 sm:px-6 py-4 shadow-lg">
    <nav class="flex flex-col gap-1" aria-label="Navigasi Seluler">
      {navItems.map((item) => {
        const isActive = activeNav === item.id;
        return (
          <a
            href={item.href}
            class={`rounded-lg px-3.5 py-2.5 text-sm font-medium transition-colors ${
              isActive
                ? 'bg-blue-50 font-bold text-[#0b4d8c]'
                : 'text-slate-700 hover:bg-slate-100'
            }`}
            aria-current={isActive ? 'page' : undefined}
          >
            {item.label}
          </a>
        );
      })}
      <div class="mt-3 pt-3 border-t border-slate-100 flex flex-col gap-2">
        <a
          href="https://pmb.dinus.ac.id"
          target="_blank"
          rel="noopener noreferrer"
          class="sm:hidden flex items-center justify-center gap-2 h-10 rounded-xl border border-slate-200 text-slate-700 text-sm font-semibold"
        >
          <span>Pendaftaran Mahasiswa Baru</span>
          <i data-lucide="arrow-up-right" class="w-4 h-4 text-[#0b4d8c]"></i>
        </a>
      </div>
    </nav>
  </div>
</header>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const toggleBtn = document.getElementById('ftc-menu-toggle');
    const mobileNav = document.getElementById('ftc-mobile-nav');
    const iconOpen = document.getElementById('ftc-icon-open');
    const iconClose = document.getElementById('ftc-icon-close');
    const siteHeader = document.getElementById('site-header');

    if (toggleBtn && mobileNav) {
      toggleBtn.addEventListener('click', () => {
        const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
        toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
        mobileNav.classList.toggle('hidden');
        if (iconOpen && iconClose) {
          iconOpen.classList.toggle('hidden');
          iconClose.classList.toggle('hidden');
        }
      });
    }

    if (siteHeader) {
      window.addEventListener('scroll', () => {
        if (window.scrollY > 10) {
          siteHeader.classList.add('shadow-md');
        } else {
          siteHeader.classList.remove('shadow-md');
        }
      }, { passive: true });
    }

    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });
</script>
