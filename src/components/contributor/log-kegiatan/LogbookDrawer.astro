---
// src/components/contributor/log-kegiatan/LogbookDrawer.astro
// Drawer logbook kegiatan satu mahasiswa (hanya lihat). Dibuka lewat event window `buka-logbook` ({ nim, nama }).
// Riwayat & modal dokumen dipakai ulang dari Logbook Kegiatan mahasiswa.
import KegiatanRiwayat from "../../mbkm/logbook-kegiatan/KegiatanRiwayat.astro";
import ModalDokumenKegiatan from "../../mbkm/logbook-kegiatan/ModalDokumenKegiatan.astro";
import { logbookMahasiswa } from "../../../data/contributor/logKegiatanData";
---

<div
  x-data={`{
    data: ${JSON.stringify(logbookMahasiswa)},
    selected: null,
    docItem: null,

    get entries() { return this.selected ? this.selected.entries : []; },
    get terbaru() { return [...this.entries].sort((a, b) => b.tanggal.localeCompare(a.tanggal)); },
    get terakhir() { return this.terbaru.length ? this.minggu(this.terbaru[0]) : '-'; },

    // Minggu ke-N dihitung dari minggu (Senin) kegiatan pertama mahasiswa.
    senin(iso) { const d = new Date(iso + 'T00:00:00'); d.setDate(d.getDate() - ((d.getDay() + 6) % 7)); return d; },
    minggu(item) {
      const awal = this.senin([...this.entries].map((e) => e.tanggal).sort()[0]);
      return 'Minggu ' + (Math.round((this.senin(item.tanggal) - awal) / 604800000) + 1);
    },
    fmt(iso) { return new Date(iso + 'T00:00:00').toLocaleDateString('id-ID', { weekday: 'long', day: 'numeric', month: 'short', year: 'numeric' }); },
    refreshIcons() { this.$nextTick(() => window.lucide && window.lucide.createIcons()); },
    buka({ nim, nama }) {
      this.selected = this.data[nim] || { nama: nama || 'Mahasiswa', nim, prodi: '-', dospem: '-', entries: [] };
      this.refreshIcons();
    },
    tutup() { this.selected = null; this.docItem = null; }
  }`}
  @buka-logbook.window="buka($event.detail)"
  @keydown.escape.window="docItem ? docItem = null : tutup()"
>
  <div x-show="selected" x-cloak class="fixed inset-0 z-40">
    <div class="absolute inset-0 bg-black/40" @click="tutup()"></div>

    <aside
      class="absolute right-0 top-0 h-full w-full max-w-2xl bg-[#fafafa] shadow-xl border-l border-[#e4e4e7] flex flex-col"
      role="dialog"
      aria-modal="true"
      aria-label="Logbook kegiatan mahasiswa"
    >
      <div class="flex items-center justify-between gap-3 px-5 py-3.5 border-b border-[#e4e4e7] bg-white">
        <h3 class="text-[15px] font-semibold text-[#09090b]">Logbook Kegiatan</h3>
        <button type="button" @click="tutup()" class="p-1 rounded hover:bg-gray-100 text-[#71717a] shrink-0" aria-label="Tutup logbook">
          <i data-lucide="x" class="w-4 h-4"></i>
        </button>
      </div>

      <div class="flex-1 overflow-y-auto p-5 space-y-5">
        <template x-if="selected">
          <div class="bg-white border border-[#e4e4e7] rounded-xl p-5 shadow-2xs space-y-1">
            <h2 class="text-[16px] font-semibold text-[#09090b] leading-tight" x-text="selected.nama"></h2>
            <p class="text-[12px] text-[#71717a]">
              <span x-text="selected.nim"></span>
              <span class="text-[#d4d4d8] mx-1">•</span>
              Dosen Pembimbing: <span class="text-[#3f3f46]" x-text="selected.dospem"></span>
            </p>
            <div class="pt-2 flex flex-wrap items-center gap-x-5 gap-y-1.5 text-[13px] text-[#3f3f46]">
              <span>Total Kegiatan: <strong class="font-semibold text-[#09090b]" x-text="entries.length"></strong></span>
              <span>Kegiatan Terakhir: <strong class="font-semibold text-[#09090b]" x-text="terakhir"></strong></span>
            </div>
          </div>
        </template>

        <KegiatanRiwayat waktu="minggu" emptyText="Mahasiswa ini belum mencatat kegiatan." />
      </div>
    </aside>

    <ModalDokumenKegiatan waktu="minggu" />
  </div>
</div>
