---
import { Menu, Bell, User } from 'lucide-astro';
import RoleSwitcher from './RoleSwitcher.astro';

interface Props {
  role: 'admin' | 'mahasiswa' | 'kontributor';
  title?: string;
  subtitle?: string;
}

const { role, title, subtitle } = Astro.props;

const userProfiles = {
  admin: { name: 'Dr. Nurul Anisa, M.Kom', roleLabel: 'Koordinator MBKM FIK' },
  mahasiswa: { name: 'Ahmad Faiz Robbani', roleLabel: 'A11.2023.14920' },
  kontributor: { name: 'Budi Santoso', roleLabel: 'PIC PT Telkom Indonesia' },
};

const currentProfile = userProfiles[role] || userProfiles.admin;
---

<header class="h-16 bg-white border-b border-slate-200/80 px-4 sm:px-6 flex items-center justify-between gap-4 sticky top-0 z-20 shrink-0">
  <!-- Left Side: Mobile toggle & Breadcrumb -->
  <div class="flex items-center gap-3">
    <!-- Hamburger button for mobile -->
    <button
      type="button"
      @click="sidebarOpen = !sidebarOpen"
      class="lg:hidden p-2 rounded-lg text-slate-500 hover:bg-slate-100 focus:outline-none"
    >
      <Menu class="w-5 h-5" />
      <span class="sr-only">Buka menu sidebar</span>
    </button>

    {title && (
      <div>
        <h1 class="text-base sm:text-lg font-bold text-slate-900 leading-tight truncate">{title}</h1>
        {subtitle && <p class="text-xs text-slate-400 hidden sm:block leading-none mt-0.5">{subtitle}</p>}
      </div>
    )}
  </div>

  <!-- Right Side: Role Switcher & User Profile -->
  <div class="flex items-center gap-3 sm:gap-4">
    <!-- Role switcher pill -->
    <div class="hidden md:block">
      <RoleSwitcher currentRole={role} />
    </div>

    <!-- Notification Bell -->
    <button
      type="button"
      class="p-2 rounded-lg text-slate-400 hover:text-slate-600 hover:bg-slate-100 relative transition-colors focus:outline-none"
    >
      <Bell class="w-4 h-4" />
      <span class="absolute top-1.5 right-1.5 w-2 h-2 rounded-full bg-rose-500"></span>
      <span class="sr-only">Notifikasi</span>
    </button>

    <!-- User Profile Dropdown Avatar -->
    <div class="flex items-center gap-2.5 pl-2 sm:pl-3 border-l border-slate-100">
      <div class="w-8 h-8 rounded-full bg-[#0655a7]/10 text-[#0655a7] font-semibold flex items-center justify-center text-xs border border-blue-200/60">
        <User class="w-4 h-4" />
      </div>
      <div class="hidden xl:block text-left">
        <p class="text-xs font-semibold text-slate-800 leading-tight">{currentProfile.name}</p>
        <p class="text-[11px] text-slate-400 leading-none mt-0.5">{currentProfile.roleLabel}</p>
      </div>
    </div>
  </div>
</header>
