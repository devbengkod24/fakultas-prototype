---
// src/components/mbkm/mahasiswa/AktifStatCards.astro
// Urutan: Status Pengajuan, Log Mahasiswa, Periode Aktif, Jadwal Sidang.
// Skala kartu diselaraskan dengan KPI dashboard Contributor (label xs, nilai seragam, catatan 12px).
const stats = [
  { label: 'Logbook Bimbingan', icon: 'graduation-cap', nilai: 'Diterima', nilaiCls: 'text-green-700', catatan: 'Terisi 5 Minggu' },
  { label: 'Log Bimbingan', icon: 'book-open', nilai: '5/5', nilaiCls: 'text-[#09090b]', catatan: 'Progress 100%' },
  { label: 'Periode Aktif', icon: 'calendar-range', nilai: '2026/2027', nilaiCls: 'text-[#09090b]', catatan: 'Gelombang 1 KB 2026/2027' },
  { label: 'Jadwal Sidang', icon: 'calendar', nilai: 'Selasa, 27 Okt 2026', nilaiCls: 'text-[#09090b]', catatan: 'Jam 09:00 - 09:45' }
];
---

<!-- 4 Stat Cards KB (State Aktif) -->
<section class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
  {stats.map((s) => (
    <div class="p-4 bg-white border border-[#e4e4e7] rounded-[12px] shadow-2xs flex flex-col justify-between">
      <div class="flex items-center justify-between text-[#71717a] text-xs mb-2">
        <span>{s.label}</span>
        <i data-lucide={s.icon} class="w-4 h-4"></i>
      </div>
      <div class={`text-lg font-semibold leading-7 ${s.nilaiCls}`}>{s.nilai}</div>
      <span class="text-[12px] mt-1 text-[#71717a]">{s.catatan}</span>
    </div>
  ))}
</section>
