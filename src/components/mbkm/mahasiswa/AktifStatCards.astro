---
// src/components/mbkm/mahasiswa/AktifStatCards.astro
// Tiga kartu menu ringkasan Dashboard Mahasiswa untuk state "diterima & aktif":
// Logbook Kegiatan, Logbook Bimbingan, dan Jadwal Sidang.
//
// Kartu memakai komponen & chrome yang sama dengan Dashboard Koordinator
// (ActionNavCard) dan diletakkan pada area 8 kolom dengan grid 3 kolom —
// persis seperti baris kartu menu pada Dashboard Koordinator.
import ActionNavCard from '../../ui/ActionNavCard.astro';

const kartu = [
  {
    title: 'Logbook Kegiatan',
    icon: 'graduation-cap',
    iconColor: 'text-emerald-500',
    href: '/mahasiswa/logbook-kegiatan',
    keterangan: 'Tercatat 5 Minggu',
  },
  {
    title: 'Logbook Bimbingan',
    icon: 'book-open-check',
    iconColor: 'text-amber-500',
    href: '/mahasiswa/logbook',
    keterangan: '3/5 Bimbingan',
  },
  {
    title: 'Jadwal Sidang',
    icon: 'calendar-clock',
    iconColor: 'text-orange-500',
    href: '/mahasiswa/sidang',
    keterangan: 'Selasa, 27 Okt 2026',
  },
];
---

<!-- Tiga Kartu Menu (Selaras Baris Kartu Menu Dashboard Koordinator) -->
<section class="grid grid-cols-1 gap-4 sm:grid-cols-3">
  {kartu.map((k) => (
    <ActionNavCard
      title={k.title}
      subtitle={k.keterangan}
      icon={k.icon}
      iconColor={k.iconColor}
      href={k.href}
    />
  ))}
</section>
