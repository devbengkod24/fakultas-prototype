---
// src/components/mbkm/mahasiswa/PendaftarSidebar.astro
---

<!-- Kolom Kanan: Pengumuman Seleksi MBKM & Akses Komunikasi -->
<div class="flex flex-col gap-4 h-full">
  <!-- Card 1: Pengumuman Seleksi Aktif (Selaras Admin Dashboard) -->
  <div class="rounded-xl border border-[#e4e4e7] bg-white text-[#09090b] shadow-none p-4 flex-1 flex flex-col justify-between">
    <div class="flex items-center justify-between pb-3 mb-3 border-b border-[#e4e4e7]">
      <h3 class="text-sm font-semibold text-[#09090b]">Pengumuman MBKM</h3>
      <a
        href="/mahasiswa/pengumuman"
        class="text-xs font-semibold text-[#0655a7] hover:underline"
      >
        Semua &rarr;
      </a>
    </div>

    <div class="space-y-3.5">
      <!-- Item 1: Pengumuman Mitra -->
      <div class="space-y-1">
        <div class="flex items-center justify-between gap-2">
          <h4 class="text-xs font-semibold text-[#09090b]">
            Konfirmasi Penawaran Mitra
          </h4>
          <span class="text-[10px] font-semibold text-amber-800 bg-amber-50 px-1.5 py-0.5 rounded border border-amber-200">
            Mitra
          </span>
        </div>
        <p class="text-xs text-[#71717a] leading-relaxed">
          Batas konfirmasi kelolosan adalah <strong>3×24 jam</strong> sejak penawaran diterbitkan mitra. Lamaran di mitra lain otomatis ditarik sistem.
        </p>
      </div>

      <div class="border-t border-[#f4f4f5]"></div>

      <!-- Item 2: Pengumuman Global MBKM -->
      <div class="space-y-1">
        <div class="flex items-center justify-between gap-2">
          <h4 class="text-xs font-semibold text-[#09090b]">
            Akses Konversi 20 SKS
          </h4>
          <span class="text-[10px] font-semibold text-[#0655a7] bg-blue-50 px-1.5 py-0.5 rounded border border-blue-200">
            Global
          </span>
        </div>
        <p class="text-xs text-[#71717a] leading-relaxed">
          Formulir ekuivalensi 20 SKS akan terbuka otomatis setelah dokumen <strong>Pakta Integritas</strong> disetujui Koordinator MBKM.
        </p>
      </div>
    </div>
  </div>

  <!-- Card 2: Link Group MBKM (Standar Resmi fakultas-fe) -->
  <div class="rounded-xl border border-[#e4e4e7] bg-white text-[#09090b] shadow-none p-4 shrink-0">
    <div class="flex items-center justify-between gap-2 text-sm font-semibold mb-3.5">
      <h3 class="text-sm font-semibold text-[#09090b]">Link Group MBKM</h3>
      <i data-lucide="link-2" class="w-4 h-4 text-[#71717a]"></i>
    </div>

    <div>
      <div class="flex items-start gap-3 mb-3">
        <div class="flex size-10 items-center justify-center rounded-full bg-blue-100 shrink-0">
          <i data-lucide="message-square" class="size-4 text-blue-600"></i>
        </div>
        <div class="min-w-0 flex-1">
          <h4 class="font-semibold text-sm text-[#09090b]">
            Grup Global MBKM
          </h4>
          <p class="text-xs text-[#71717a] mt-0.5">
            Diskusi bersama koordinator dan mahasiswa
          </p>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <div class="flex-1 bg-gray-50 rounded-md p-2.5 px-3 border border-gray-200 min-w-0">
          <p class="text-xs font-medium text-[#71717a] truncate overflow-hidden select-all">
            https://chat.whatsapp.com/MBKM-Calon-2025
          </p>
        </div>
        <div class="flex items-center gap-1 shrink-0">
          <button
            type="button"
            @click="copyLink('https://chat.whatsapp.com/MBKM-Calon-2025', 'global')"
            class="h-9 w-9 p-0 rounded-md border border-gray-200 bg-white hover:bg-gray-50 flex items-center justify-center text-[#3f3f46] cursor-pointer transition-colors"
            title="Salin tautan"
          >
            <i x-show="!copiedGlobal" data-lucide="copy" class="h-4 w-4"></i>
            <i
              x-show="copiedGlobal"
              data-lucide="check"
              class="h-4 w-4 text-emerald-600"
              x-cloak
            ></i>
          </button>
          <a
            href="https://chat.whatsapp.com/MBKM-Calon-2025"
            target="_blank"
            rel="noopener noreferrer"
            class="h-9 w-9 p-0 rounded-md bg-[#0655a7] hover:bg-[#114d91] text-white flex items-center justify-center transition-colors"
            title="Buka grup WhatsApp"
          >
            <i data-lucide="external-link" class="h-4 w-4"></i>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
