---
// src/components/mbkm/mahasiswa/AktifLogbookCard.astro
---

<!-- Kolom Kiri (2/3 width): Logbook Bimbingan -->
<div class="lg:col-span-2">
  <div
    class="rounded-xl border border-[#e4e4e7] bg-white text-[#09090b] shadow-none"
  >
    <div class="flex flex-col space-y-1.5 p-4 pb-2">
      <h3
        class="flex items-center gap-2 text-base font-semibold text-[#09090b]"
      >
        <i data-lucide="book-open" class="h-5 w-5 text-[#09090b]"></i>
        Logbook Bimbingan
      </h3>
      <p class="text-sm text-[#71717a]">
        Progress pengerjaan logbook dan checklist KB
      </p>
    </div>
    <div class="p-4 pt-0 space-y-5">
      <div class="space-y-2">
        <div class="flex items-center justify-between text-sm">
          <span class="text-[#09090b]">Progress checklist</span>
          <span class="font-medium text-[#09090b]">75%</span>
        </div>
        <div
          class="relative h-2 w-full overflow-hidden rounded-full bg-[#f4f4f5]"
        >
          <div
            class="h-full bg-[#0655a7] rounded-full w-[75%] transition-all"
          >
          </div>
        </div>
      </div>

      <div class="space-y-2.5">
        <!-- Item 1: Pengajuan ke dosen pembimbing -->
        <div
          class="flex items-start gap-3 rounded-2xl border border-[#e4e4e7] p-3"
        >
          <div
            class="mt-0.5 rounded-full p-1 bg-emerald-100 text-emerald-600 shrink-0"
          >
            <i data-lucide="check-circle-2" class="h-4 w-4"></i>
          </div>
          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-center gap-2">
              <p class="font-medium text-sm text-[#09090b]">
                Pengajuan ke dosen pembimbing
              </p>
              <span
                class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold bg-[#0655a7] text-white"
                >Selesai</span
              >
            </div>
            <p class="mt-1 text-xs text-[#71717a]">
              Pembimbing: Dosen A11
            </p>
          </div>
        </div>

        <!-- Item 2: Bab Sudah Diverifikasi -->
        <div
          class="flex items-start gap-3 rounded-2xl border border-[#e4e4e7] p-3"
        >
          <div
            class="mt-0.5 rounded-full p-1 bg-emerald-100 text-emerald-600 shrink-0"
          >
            <i data-lucide="check-circle-2" class="h-4 w-4"></i>
          </div>
          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-center gap-2">
              <p class="font-medium text-sm text-[#09090b]">
                Bab Sudah Diverifikasi
              </p>
              <span
                class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold bg-[#0655a7] text-white"
                >Selesai</span
              >
            </div>
            <p class="mt-1 text-xs text-[#71717a]">
              5/5 bab sudah diverifikasi
            </p>
          </div>
        </div>

        <!-- Item 3: Sudah mendapatkan jadwal sidang -->
        <div
          class="flex items-start gap-3 rounded-2xl border border-[#e4e4e7] p-3"
        >
          <div
            class="mt-0.5 rounded-full p-1 bg-emerald-100 text-emerald-600 shrink-0"
          >
            <i data-lucide="check-circle-2" class="h-4 w-4"></i>
          </div>
          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-center gap-2">
              <p class="font-medium text-sm text-[#09090b]">
                Sudah mendapatkan jadwal sidang
              </p>
              <span
                class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold bg-[#0655a7] text-white"
                >Selesai</span
              >
            </div>
            <p class="mt-1 text-xs text-[#71717a]">
              Jadwal: Selasa, 27 Oktober 2026 • 09:00 - 09:45
            </p>
          </div>
        </div>

        <!-- Item 4: Sidang KB sudah dinilai -->
        <div
          class="flex items-start gap-3 rounded-2xl border border-[#e4e4e7] p-3"
        >
          <div
            class="mt-0.5 rounded-full p-1 bg-[#f4f4f5] text-[#71717a] shrink-0"
          >
            <i data-lucide="circle" class="h-4 w-4"></i>
          </div>
          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-center gap-2">
              <p class="font-medium text-sm text-[#09090b]">
                Sidang KB sudah dinilai
              </p>
              <span
                class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold bg-[#fef3c7] text-[#b45309]"
              >
                Belum
              </span>
            </div>
            <p class="mt-1 text-xs text-[#71717a]">
              Sidang KB belum dinilai.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
