---
// src/components/mbkm/mahasiswa/PendaftarRoadmapCard.astro
---

<!-- CARD ROADMAP TAHAPAN MBKM (Rapi, Seimbang, & Presisi) -->
<div class="rounded-xl border border-[#e4e4e7] bg-white text-[#09090b] shadow-none py-4 px-4 sm:px-6">
  <!-- ========================================================================= -->
  <!-- KONDISI 1: SAAT BELUM DITERIMA (STEPPER SELEKSI PROGRAM: 4 TAHAP)         -->
  <!-- ========================================================================= -->
  <template x-if="!showOfferBanner && !paktaSubmitted">
    <div class="relative py-1 max-w-2xl sm:max-w-3xl mx-auto">
      <!-- Connecting Progress Track (Tepat di Tengah Kolom: 12.5% s/d 12.5%) -->
      <div class="absolute left-[12.5%] right-[12.5%] top-5 -translate-y-1/2 h-1 bg-gray-200 rounded-full z-0" aria-hidden="true">
        <div
          class="h-full bg-[#0655a7] rounded-full transition-all duration-500 ease-out"
          :style="activeMitraTab === 'idss' ? 'width: 33.33%' : 'width: 66.66%'"
        ></div>
      </div>

      <!-- 4 Step Nodes Grid -->
      <div class="relative z-10 grid grid-cols-4 text-center">
        <!-- Node 1: Pendaftaran (Selesai untuk semua) -->
        <div class="flex flex-col items-center">
          <div class="w-10 h-10 rounded-full flex items-center justify-center font-bold text-xs bg-[#0655a7] text-white shadow-2xs border-2 border-white ring-4 ring-blue-50">
            <i data-lucide="check" class="w-4 h-4 text-white"></i>
          </div>
          <span class="mt-2 text-xs font-semibold text-[#09090b] leading-tight">Pendaftaran</span>
        </div>

        <!-- Node 2: Seleksi Berkas (BK & Dicoding: Selesai Centang, IDSS: Sedang Berjalan Aktif) -->
        <div class="flex flex-col items-center">
          <div
            class="w-10 h-10 rounded-full flex items-center justify-center font-bold text-xs transition-all border-2 border-white"
            :class="activeMitraTab === 'idss'
              ? 'bg-[#0655a7] text-white ring-4 ring-blue-100'
              : 'bg-[#0655a7] text-white shadow-2xs ring-4 ring-blue-50'"
          >
            <span x-show="activeMitraTab !== 'idss'" class="inline-flex items-center justify-center">
              <i data-lucide="check" class="w-4 h-4 text-white"></i>
            </span>
            <span x-show="activeMitraTab === 'idss'">2</span>
          </div>
          <span
            class="mt-2 text-xs font-semibold leading-tight transition-colors"
            :class="activeMitraTab === 'idss' ? 'text-[#0655a7]' : 'text-[#09090b]'"
          >
            Seleksi Berkas
          </span>
        </div>

        <!-- Node 3: Wawancara (Standar Seragam Seluruh Mitra) -->
        <div class="flex flex-col items-center">
          <div
            class="w-10 h-10 rounded-full flex items-center justify-center font-bold text-xs transition-all border-2 border-white ring-4"
            :class="activeMitraTab === 'idss'
              ? 'bg-[#f4f4f5] text-[#71717a] ring-transparent'
              : 'bg-[#0655a7] text-white ring-blue-100'"
          >
            <span>3</span>
          </div>
          <span
            class="mt-2 text-xs font-semibold leading-tight transition-colors"
            :class="activeMitraTab === 'idss' ? 'text-[#71717a]' : 'text-[#0655a7]'"
          >
            Wawancara
          </span>
        </div>

        <!-- Node 4: Pengumuman (Menunggu) -->
        <div class="flex flex-col items-center">
          <div class="w-10 h-10 rounded-full flex items-center justify-center font-bold text-xs bg-[#f4f4f5] text-[#71717a] border-2 border-white ring-4 ring-transparent">
            <span>4</span>
          </div>
          <span class="mt-2 text-xs font-medium text-[#71717a] leading-tight">Pengumuman</span>
        </div>
      </div>
    </div>
  </template>

  <!-- ========================================================================= -->
  <!-- KONDISI 2: SAAT SUDAH DITERIMA (STEPPER AKADEMIK FAKULTAS: 4 TAHAP)       -->
  <!-- ========================================================================= -->
  <template x-if="showOfferBanner || paktaSubmitted">
    <div class="relative py-1 max-w-2xl sm:max-w-3xl mx-auto">
      <!-- Connecting Progress Track -->
      <div class="absolute left-[12.5%] right-[12.5%] top-5 -translate-y-1/2 h-1 bg-gray-200 rounded-full z-0" aria-hidden="true">
        <div class="h-full bg-[#0655a7] rounded-full w-1/3 transition-all duration-500 ease-out"></div>
      </div>

      <!-- 4 Step Nodes Grid -->
      <div class="relative z-10 grid grid-cols-4 text-center">
        <!-- Node 1: Pendaftaran (Selesai) -->
        <div class="flex flex-col items-center">
          <div class="w-10 h-10 rounded-full flex items-center justify-center font-bold text-xs bg-[#0655a7] text-white shadow-2xs border-2 border-white ring-4 ring-blue-50">
            <i data-lucide="check" class="w-4 h-4 text-white"></i>
          </div>
          <span class="mt-2 text-xs font-semibold text-[#09090b] leading-tight">Pendaftaran</span>
        </div>

        <!-- Node 2: Pakta (Aktif / Menunggu ACC) -->
        <div class="flex flex-col items-center">
          <div
            class="w-10 h-10 rounded-full flex items-center justify-center font-bold text-xs transition-all border-2 border-white ring-4"
            :class="!paktaSubmitted
              ? 'bg-[#0655a7] text-white ring-blue-100'
              : 'bg-[#0655a7] text-white ring-blue-50'"
          >
            <span x-show="!paktaSubmitted">2</span>
            <span x-show="paktaSubmitted" class="inline-flex items-center justify-center">
              <i data-lucide="clock" class="w-4 h-4 text-white"></i>
            </span>
          </div>
          <span class="mt-2 text-xs font-semibold text-[#0655a7] leading-tight">Pakta</span>
        </div>

        <!-- Node 3: Pengajuan Konversi (Terkunci) -->
        <div class="flex flex-col items-center opacity-60">
          <div class="w-10 h-10 rounded-full flex items-center justify-center font-bold text-xs bg-[#f4f4f5] text-[#71717a] border-2 border-white ring-4 ring-transparent">
            <i data-lucide="lock" class="w-3.5 h-3.5 text-[#71717a]"></i>
          </div>
          <span class="mt-2 text-xs font-medium text-[#71717a] leading-tight">Pengajuan Konversi</span>
        </div>

        <!-- Node 4: Dosen Pembimbing (Terkunci) -->
        <div class="flex flex-col items-center opacity-60">
          <div class="w-10 h-10 rounded-full flex items-center justify-center font-bold text-xs bg-[#f4f4f5] text-[#71717a] border-2 border-white ring-4 ring-transparent">
            <i data-lucide="lock" class="w-3.5 h-3.5 text-[#71717a]"></i>
          </div>
          <span class="mt-2 text-xs font-medium text-[#71717a] leading-tight">Dosen Pembimbing</span>
        </div>
      </div>
    </div>
  </template>
</div>
