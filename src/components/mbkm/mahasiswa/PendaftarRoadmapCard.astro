---
// src/components/mbkm/mahasiswa/PendaftarRoadmapCard.astro
import { cn } from "../../../utils/cn";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const steps = [
  { id: 1, key: "pendaftaran", label: "Pendaftaran" },
  { id: 2, key: "berkas", label: "Seleksi Berkas" },
  { id: 3, key: "wawancara", label: "Wawancara" },
  { id: 4, key: "prioritas", label: "Urutan Prioritas" },
  { id: 5, key: "hasil", label: "Hasil Seleksi" },
];
---

<!-- CARD ROADMAP TAHAPAN MBKM (5 TAHAP SELARAS PENDAFTARAN KB) -->
<div
  class={cn("rounded-xl border border-[#e4e4e7] bg-white text-[#09090b] shadow-none py-4 px-4 sm:px-6", className)}
  x-data="{
    get currentRoadmapStage() {
      if (showOfferBanner || paktaSubmitted) return 'hasil';
      if (activeMitraTab === 'idss') return 'berkas';
      return 'prioritas';
    },
    stages: ['pendaftaran', 'berkas', 'wawancara', 'prioritas', 'hasil'],
    stageIndex(k) { return this.stages.indexOf(k); },
    isDone(k) {
      if (paktaSubmitted && k === 'hasil') return true;
      return this.stageIndex(this.currentRoadmapStage) > this.stageIndex(k);
    },
    isActive(k) {
      if (paktaSubmitted && k === 'hasil') return false;
      return this.currentRoadmapStage === k;
    },
    isPending(k) {
      return this.stageIndex(this.currentRoadmapStage) < this.stageIndex(k);
    }
  }"
>
  <div class="relative py-1 max-w-3xl sm:max-w-4xl mx-auto">
    <!-- Connecting Progress Track (10% s/d 10% untuk 5 Kolom Grid) -->
    <div class="absolute left-[10%] right-[10%] top-5 -translate-y-1/2 h-1 bg-gray-200 rounded-full z-0" aria-hidden="true">
      <div
        class="h-full bg-[#0655a7] rounded-full transition-all duration-500 ease-out"
        :style="currentRoadmapStage === 'pendaftaran' ? 'width: 0%' : currentRoadmapStage === 'berkas' ? 'width: 25%' : currentRoadmapStage === 'wawancara' ? 'width: 50%' : currentRoadmapStage === 'prioritas' ? 'width: 75%' : 'width: 100%'"
      ></div>
    </div>

    <!-- 5 Step Nodes Grid -->
    <div class="relative z-10 grid grid-cols-5 text-center">
      {steps.map((step) => (
        <div class="flex flex-col items-center select-none">
          <!-- Node Selesai (Centang) -->
          <div
            x-show={`isDone('${step.key}')`}
            class="w-10 h-10 rounded-full flex items-center justify-center font-bold text-xs bg-[#0655a7] text-white shadow-2xs border-2 border-white ring-4 ring-blue-50 transition-all"
          >
            <i data-lucide="check" class="w-4 h-4 text-white"></i>
          </div>

          <!-- Node Aktif (Nomor + Ring Pendaran) -->
          <div
            x-show={`isActive('${step.key}')`}
            class="w-10 h-10 rounded-full flex items-center justify-center font-bold text-xs bg-[#0655a7] text-white ring-4 ring-blue-100 border-2 border-white shadow-2xs transition-all"
          >
            <span>{step.id}</span>
          </div>

          <!-- Node Pending (Netral Abu-abu) -->
          <div
            x-show={`isPending('${step.key}')`}
            class="w-10 h-10 rounded-full flex items-center justify-center font-bold text-xs bg-[#f4f4f5] text-[#71717a] border-2 border-white ring-4 ring-transparent transition-all"
          >
            <span>{step.id}</span>
          </div>

          <!-- Label Tahap -->
          <span
            class="mt-2 text-xs font-semibold leading-tight transition-colors"
            :class={`isActive('${step.key}') ? 'text-[#0655a7]' : isDone('${step.key}') ? 'text-[#09090b]' : 'text-[#71717a]'`}
          >
            {step.label}
          </span>
        </div>
      ))}
    </div>
  </div>
</div>
