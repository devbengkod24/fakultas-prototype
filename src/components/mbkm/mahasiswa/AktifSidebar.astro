---
// src/components/mbkm/mahasiswa/AktifSidebar.astro
---

<!-- Kolom Kanan (1/3 width): Pengumuman & Akses Komunikasi Dospem -->
<div class="space-y-4">
  <!-- Card 1: Pengumuman MBKM (Aktif) -->
  <div class="rounded-xl border border-[#e4e4e7] bg-white text-[#09090b] shadow-none p-4">
    <div class="flex items-center justify-between pb-3 mb-3 border-b border-[#e4e4e7]">
      <h3 class="text-sm font-semibold text-[#09090b]">Pengumuman MBKM</h3>
      <a
        href="/mahasiswa/pengumuman"
        class="text-xs font-semibold text-[#0655a7] hover:underline"
      >
        Semua &rarr;
      </a>
    </div>

    <div class="space-y-3.5">
      <div class="space-y-1">
        <div class="flex items-center justify-between gap-2">
          <h4 class="text-xs font-semibold text-[#09090b]">
            Pengisian Logbook Mingguan
          </h4>
          <span class="text-[10px] font-semibold text-emerald-800 bg-emerald-50 px-1.5 py-0.5 rounded border border-emerald-200">
            Rutin
          </span>
        </div>
        <p class="text-xs text-[#71717a] leading-relaxed">
          Logbook wajib diisi maksimal setiap hari Jumat pukul 23:59 WIB untuk diverifikasi oleh Dosen Pembimbing.
        </p>
      </div>

      <div class="border-t border-[#f4f4f5]"></div>

      <div class="space-y-1">
        <div class="flex items-center justify-between gap-2">
          <h4 class="text-xs font-semibold text-[#09090b]">
            Pendaftaran Sidang Evaluasi
          </h4>
          <span class="text-[10px] font-semibold text-[#0655a7] bg-blue-50 px-1.5 py-0.5 rounded border border-blue-200">
            Jadwal
          </span>
        </div>
        <p class="text-xs text-[#71717a] leading-relaxed">
          Pendaftaran sidang evaluasi dibuka setelah seluruh bab logbook dan lembar penilaian mitra terunggah lengkap.
        </p>
      </div>
    </div>
  </div>

  <!-- Card 2: Link Group MBKM & Dosen Pembimbing -->
  <div class="rounded-xl border border-[#e4e4e7] bg-white text-[#09090b] shadow-none p-4">
    <div class="flex items-center justify-between gap-2 text-sm font-semibold mb-3.5">
      <h3 class="text-sm font-semibold text-[#09090b]">Link Group MBKM</h3>
      <i data-lucide="link-2" class="w-4 h-4 text-[#71717a]"></i>
    </div>
    <div class="space-y-4">
      <!-- Grup Global -->
      <div>
        <div class="flex items-start gap-3 mb-2.5">
          <div
            class="flex size-9 items-center justify-center rounded-full bg-blue-100 shrink-0"
          >
            <i data-lucide="message-square" class="size-4 text-blue-600"></i>
          </div>
          <div class="min-w-0 flex-1">
            <h4 class="font-semibold text-xs text-[#09090b]">
              Grup Global MBKM
            </h4>
            <p class="text-xs text-[#71717a] mt-0.5">
              Diskusi koordinator dan mahasiswa
            </p>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <div
            class="flex-1 bg-gray-50 rounded-md p-2 px-3 border border-gray-200 min-w-0"
          >
            <p
              class="text-xs text-gray-600 font-medium truncate overflow-hidden"
            >
              https://chat.whatsapp.com/MBKM-Calon-2025
            </p>
          </div>
          <a
            href="https://chat.whatsapp.com/MBKM-Calon-2025"
            target="_blank"
            rel="noopener noreferrer"
            class="h-8.5 w-8.5 p-0 rounded-md bg-[#0655a7] hover:bg-[#114d91] text-white flex items-center justify-center shrink-0 transition-colors"
            title="Buka grup"
          >
            <i data-lucide="external-link" class="h-4 w-4"></i>
          </a>
        </div>
      </div>

      <div class="border-t border-[#e4e4e7]"></div>

      <!-- Grup Dosen Pembimbing -->
      <div>
        <div class="flex items-start gap-3 mb-2.5">
          <div
            class="flex size-9 items-center justify-center rounded-full bg-violet-100 shrink-0"
          >
            <i data-lucide="users" class="size-4 text-violet-600"></i>
          </div>
          <div class="min-w-0 flex-1">
            <h4 class="font-semibold text-xs text-[#09090b]">
              Grup Dosen Pembimbing
            </h4>
            <p class="text-xs text-[#71717a] mt-0.5">
              Bimbingan intensif bersama dospem
            </p>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <div
            class="flex-1 bg-gray-50 rounded-md p-2 px-3 border border-gray-200 min-w-0"
          >
            <p
              class="text-xs text-gray-600 font-medium truncate overflow-hidden select-all"
            >
              https://chat.whatsapp.com/demo-kp-a11
            </p>
          </div>
          <button
            type="button"
            @click="copyLink('https://chat.whatsapp.com/demo-kp-a11', 'dospem')"
            class="h-8.5 w-8.5 p-0 rounded-md border border-gray-200 bg-white hover:bg-gray-50 flex items-center justify-center text-[#3f3f46] cursor-pointer shrink-0 transition-colors"
            title="Salin tautan"
          >
            <i x-show="!copiedDospem" data-lucide="copy" class="h-4 w-4"></i>
            <i
              x-show="copiedDospem"
              data-lucide="check"
              class="h-4 w-4 text-emerald-600"
              x-cloak
            ></i>
          </button>
          <a
            href="https://chat.whatsapp.com/demo-kp-a11"
            target="_blank"
            rel="noopener noreferrer"
            class="h-8.5 w-8.5 p-0 rounded-md bg-[#0655a7] hover:bg-[#114d91] text-white flex items-center justify-center shrink-0 transition-colors"
            title="Buka grup WhatsApp"
          >
            <i data-lucide="external-link" class="h-4 w-4"></i>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
