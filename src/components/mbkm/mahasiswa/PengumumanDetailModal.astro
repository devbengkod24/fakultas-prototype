---
// src/components/mbkm/mahasiswa/PengumumanDetailModal.astro
// Popup detail pengumuman. Memakai scope Alpine halaman induk: `selected` (objek pengumuman).
---

<div
  x-show="selected"
  x-cloak
  x-transition.opacity
  @keydown.escape.window="selected = null"
  class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4"
>
  <div
    class="w-full max-w-lg rounded-xl border border-[#e4e4e7] bg-white p-6 shadow-xl space-y-4"
    @click.outside="selected = null"
    role="dialog"
    aria-modal="true"
  >
    <template x-if="selected">
      <div class="space-y-4">
        <div class="flex items-start justify-between gap-4 border-b border-[#e4e4e7] pb-3">
          <div class="space-y-1.5 min-w-0">
            <div class="flex items-center gap-2">
              <span
                class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-medium border"
                :class="selected.sumber === 'Global' ? 'bg-violet-50 text-violet-700 border-violet-200' : 'bg-teal-50 text-teal-700 border-teal-200'"
                x-text="selected.sumber"
              ></span>
              <span class="text-[12px] text-[#71717a]" x-text="selected.tanggal"></span>
            </div>
            <h3 class="text-base font-semibold text-[#09090b]" x-text="selected.judul"></h3>
          </div>
          <button
            type="button"
            @click="selected = null"
            class="shrink-0 rounded-md p-1 text-[#71717a] hover:bg-[#f4f4f5] transition-colors"
            aria-label="Tutup"
          >
            <i data-lucide="x" class="size-4"></i>
          </button>
        </div>

        <p class="text-sm leading-relaxed text-[#3f3f46]" x-text="selected.isi"></p>

        <div class="flex justify-end border-t border-[#e4e4e7] pt-3">
          <button
            type="button"
            @click="selected = null"
            class="px-3 py-1.5 rounded-lg border border-[#e4e4e7] bg-white hover:bg-[#f4f4f5] text-xs font-medium text-[#09090b] transition-colors"
          >
            Tutup
          </button>
        </div>
      </div>
    </template>
  </div>
</div>
