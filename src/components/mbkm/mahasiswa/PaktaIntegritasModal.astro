---
// src/components/mbkm/mahasiswa/PaktaIntegritasModal.astro
---

<div
  x-show="showPaktaModal"
  x-cloak
  x-transition
  class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/50"
>
  <div
    class="bg-white rounded-xl w-full max-w-md p-6 shadow-xl border border-[#e4e4e7] space-y-4 font-sans"
    @click.outside="showPaktaModal = false"
  >
    <div class="flex items-center justify-between pb-3 border-b border-[#e4e4e7]">
      <div class="flex items-center gap-2">
        <i data-lucide="file-signature" class="w-4 h-4 text-[#0655a7]"></i>
        <h3 class="text-base font-semibold text-[#09090b]">
          Konfirmasi Pakta Integritas
        </h3>
      </div>
      <button
        type="button"
        @click="showPaktaModal = false"
        class="text-[#71717a] hover:text-[#09090b] p-1 rounded-md hover:bg-[#f4f4f5] transition-colors cursor-pointer"
        title="Tutup"
      >
        <i data-lucide="x" class="w-4 h-4"></i>
      </button>
    </div>

    <div class="space-y-3">
      <p class="text-xs text-[#71717a] leading-relaxed">
        Unggah dokumen Pakta Integritas yang telah ditandatangani untuk mengonfirmasi penerimaan penawaran program Kampus Berdampak.
      </p>

      <div class="space-y-2">
        <label class="block text-xs font-semibold text-[#09090b]">
          Berkas Pakta Integritas (PDF)
        </label>
        <input
          type="file"
          accept=".pdf,.jpg,.jpeg,.png"
          class="w-full text-xs text-[#09090b] file:mr-3 file:py-1.5 file:px-3 file:rounded-md file:border file:border-[#e4e4e7] file:text-xs file:font-semibold file:bg-white file:text-[#09090b] hover:file:bg-[#f4f4f5] file:cursor-pointer p-1.5 border border-[#e4e4e7] rounded-md bg-[#fafafa]"
        />
        <p class="text-[11px] text-[#71717a]">
          Format: PDF, JPG, PNG (Maks. 5 MB)
        </p>
      </div>
    </div>

    <div class="flex items-center justify-end gap-2 pt-3 border-t border-[#e4e4e7]">
      <button
        type="button"
        @click="showPaktaModal = false"
        class="h-9 px-4 border border-[#e4e4e7] bg-white hover:bg-[#f4f4f5] rounded-md font-medium text-xs text-[#09090b] transition-colors cursor-pointer"
      >
        Batal
      </button>
      <button
        type="button"
        @click="submitPakta()"
        class="h-9 px-4 bg-[#0655a7] hover:bg-[#114d91] text-white rounded-md font-semibold text-xs transition-colors cursor-pointer"
      >
        Kirim Pakta Integritas
      </button>
    </div>
  </div>
</div>
