---
// src/components/mbkm/detail/DetailHero.astro
---

<!-- ==================== MAIN NAVBAR ==================== -->
<header class="w-full bg-[linear-gradient(92.386deg,#114D91_0%,#1E7FD9_100%)] shadow-[0_10px_13.125px_rgba(0,0,0,0.1),0_4px_5.25px_rgba(0,0,0,0.1)]">
  <div class="w-full max-w-[1920px] mx-auto flex items-center justify-between gap-4 px-4 sm:px-6 lg:px-8 xl:px-16 2xl:px-24 py-4 xl:py-5">
    <a href="/" class="flex items-center gap-3 shrink-0">
      <img src="/assets/images/logo-dinus.png" alt="Logo UDINUS" class="h-10 w-10 object-contain" />
      <div class="flex flex-col leading-[15px] font-extrabold tracking-[0.4px] text-white text-[12px] sm:text-[13px]">
        <span>UNIVERSITAS</span>
        <span>DIAN NUSWANTORO</span>
      </div>
    </a>

    <nav class="hidden lg:flex items-center gap-5 xl:gap-6 font-medium text-white/80 whitespace-nowrap text-[14px] xl:text-[15px]">
      <a href="/" class="hover:text-white transition-colors">Beranda</a>
      <a href="/#profil" class="hover:text-white transition-colors">Profil</a>
      <a href="/#inovasi" class="hover:text-white transition-colors">Inovasi</a>
      <a href="/#publikasi" class="hover:text-white transition-colors">Publikasi</a>
      <a href="/mbkm" class="text-[#F3BC45] hover:text-[#f8db8f] font-semibold transition-colors">Kampus Berdampak</a>
      <a href="/#pengumuman" class="hover:text-white transition-colors">Pengumuman</a>
      <a href="/#berita" class="hover:text-white transition-colors">Berita Kegiatan</a>
    </nav>

    <div class="hidden md:flex items-center gap-3 shrink-0 text-[13px] xl:text-[14px]">
      <a
        href="https://pmb.dinus.ac.id/"
        target="_blank"
        class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-white text-white hover:bg-white hover:text-[#114D91] transition-all font-medium whitespace-nowrap"
      >
        <span>Pendaftaran</span>
        <i data-lucide="arrow-up-right" class="w-3.5 h-3.5"></i>
      </a>
      <a
        href="/apps"
        class="inline-flex items-center gap-1.5 px-5 py-2 rounded-full bg-[#F3BC45] hover:bg-[#E0A832] text-white font-bold shadow-xs transition-all whitespace-nowrap"
      >
        <i data-lucide="layout-grid" class="w-3.5 h-3.5 text-white"></i>
        <span>Portal Apps</span>
      </a>
    </div>

    <button
      id="detailMenuBtn"
      type="button"
      class="lg:hidden inline-flex items-center justify-center w-10 h-10 rounded-lg border border-white/60 text-white hover:bg-white/10 transition"
      aria-label="Buka menu"
    >
      <i data-lucide="menu" class="w-5 h-5"></i>
    </button>
  </div>

  <div id="detailMobileMenu" class="hidden lg:hidden border-t border-white/20 bg-[#114D91] px-4 sm:px-6 py-4">
    <nav class="flex flex-col text-[14px] font-medium text-white space-y-3">
      <a href="/" class="hover:text-secondary-300">Beranda</a>
      <a href="/#profil" class="hover:text-secondary-300">Profil</a>
      <a href="/#inovasi" class="hover:text-secondary-300">Inovasi</a>
      <a href="/#publikasi" class="hover:text-secondary-300">Publikasi</a>
      <a href="/mbkm" class="text-[#F3BC45] font-semibold">Kampus Berdampak</a>
      <a href="/#pengumuman" class="hover:text-secondary-300">Pengumuman</a>
      <a href="/#berita" class="hover:text-secondary-300">Berita Kegiatan</a>
    </nav>
    <div class="flex gap-3 pt-3 border-t border-white/15 text-[13px] font-medium">
      <a href="https://pmb.dinus.ac.id/" target="_blank" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full border border-white text-white">
        <span>Pendaftaran</span>
        <i data-lucide="arrow-up-right" class="w-3.5 h-3.5"></i>
      </a>
      <a href="/apps" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-[#F3BC45] text-white font-bold">
        <i data-lucide="layout-grid" class="w-3.5 h-3.5"></i>
        <span>Portal Apps</span>
      </a>
    </div>
  </div>
</header>

<!-- ==================== HERO DETAIL PROGRAM ==================== -->
<section
  class="relative isolate overflow-hidden bg-[#0D2544] text-white"
  style='background-image: url("https://images.unsplash.com/photo-1521737711867-e3b97375f902?auto=format&fit=crop&w=2000&q=85"); background-size: cover; background-position: center;'
>
  <div class="absolute inset-0 pointer-events-none bg-gradient-to-r from-[#0D2544]/95 via-[#114D91]/85 to-[#1063B9]/70"></div>
  <div class="absolute inset-0 pointer-events-none bg-[#0D2544]/20"></div>

  <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20 lg:py-24">
    <div class="mx-auto flex max-w-4xl flex-col items-center text-center">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold leading-tight tracking-tight text-[#F3BC45] drop-shadow-lg">
        Dicoding ASAH 2026
      </h1>

      <p class="mt-5 max-w-3xl text-sm sm:text-base leading-7 text-blue-50 drop-shadow-sm">
        Program Dicoding ASAH (Akselerasi Talenta AI &amp; Software Engineering) merupakan program MBKM FIK UDINUS yang
        dirancang untuk membekali mahasiswa dengan keahlian industri tingkat lanjut di bidang Machine Learning, Full-Stack Engineering,
        dan Cloud Infrastructure.
      </p>

      <div class="mt-7 flex w-full flex-col justify-center gap-3 sm:w-auto sm:flex-row">
        <a
          href="#skema"
          class="focus-ring inline-flex items-center justify-center gap-2 rounded-lg bg-[#F3BC45] px-5 py-3 text-sm font-bold text-[#114D91] hover:bg-[#F8DB8F] transition-colors"
        >
          Jelajahi Kegiatan Program
          <i data-lucide="arrow-down" class="w-4 h-4"></i>
        </a>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  const detailMenuBtn = document.getElementById("detailMenuBtn");
  const detailMobileMenu = document.getElementById("detailMobileMenu");
  if (detailMenuBtn && detailMobileMenu) {
    detailMenuBtn.addEventListener("click", () => {
      detailMobileMenu.classList.toggle("hidden");
    });
  }
</script>

<style>
  .focus-ring:focus-visible {
    outline: 2px solid #1e7fd9;
    outline-offset: 2px;
    border-radius: 6px;
  }
</style>
