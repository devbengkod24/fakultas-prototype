---
// src/components/mbkm/detail/DetailHero.astro
---

<!-- ==================== HERO DETAIL PROGRAM ==================== -->
<section class="relative overflow-hidden bg-[#072f57] text-white py-16 sm:py-20 lg:py-24">
  <!-- Background Image Sesuai Header Sub-Halaman FTC v2 -->
  <img
    src="https://dinus.ac.id/_astro/Mahasiswa-Udinus-Raih-Prestasi-di-Ajang-Internasional-IMERCI-Konsistensi-Berbuah-Hasil_nuVAK.jpeg"
    alt="Detail Program MBKM Dicoding ASAH"
    loading="lazy"
    decoding="async"
    class="absolute inset-0 h-full w-full object-cover object-center opacity-25 pointer-events-none"
  />

  <!-- Gradient Overlay dari Deep Navy ke Primary Blue FTC v2 (Luminous & Tidak Terlalu Gelap) -->
  <div class="absolute inset-0 bg-gradient-to-r from-[#072f57] via-[#072f57]/85 to-[#0b4d8c]/75 pointer-events-none"></div>

  <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center flex flex-col items-center">
    <!-- Split-badge FTC v2 -->
    <div class="split-badge mb-5 inline-flex items-center rounded-lg overflow-hidden shadow-sm max-w-full">
      <span class="split-badge-left bg-[#f5a623] text-[#072f57] font-extrabold text-xs px-2.5 py-1.5 shrink-0 tracking-wider">MBKM</span>
      <span class="split-badge-right bg-[#0b4d8c] text-white font-semibold text-xs px-3.5 py-1.5 uppercase tracking-wider shrink-0">STUDI INDEPENDEN</span>
    </div>

    <!-- Judul Program -->
    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold leading-tight tracking-tight text-white drop-shadow-sm">
      Dicoding ASAH <span class="text-[#f59e0b]">2026</span>
    </h1>

    <!-- Deskripsi Singkat Program (100% Persis) -->
    <p class="mt-5 max-w-3xl text-sm sm:text-base leading-relaxed text-blue-50/90 font-normal">
      Program Dicoding ASAH (Akselerasi Talenta AI &amp; Software Engineering) merupakan program MBKM FIK UDINUS yang
      dirancang untuk membekali mahasiswa dengan keahlian industri tingkat lanjut di bidang Machine Learning, Full-Stack Engineering,
      dan Cloud Infrastructure.
    </p>

    <!-- Tombol Aksi Hero -->
    <div class="mt-8 flex w-full flex-col justify-center gap-3 sm:w-auto sm:flex-row">
      <a
        href="#skema"
        class="inline-flex items-center justify-center gap-2 rounded-xl bg-[#f59e0b] hover:bg-[#d97706] px-6 py-3 text-sm font-bold text-[#072f57] hover:text-white shadow-xs transition-all"
      >
        <span>Jelajahi Kegiatan Program</span>
        <i data-lucide="arrow-down" class="w-4 h-4"></i>
      </a>
    </div>
  </div>
</section>

<style>
  /* Split-block badge utility FTC v2 */
  .split-badge {
    display: inline-flex;
    align-items: center;
    border-radius: 0.5rem;
    overflow: hidden;
    box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
    max-width: 100%;
  }
  .split-badge-left {
    background-color: #f5a623;
    color: #072f57;
    font-weight: 800;
    font-size: 0.75rem;
    line-height: 1rem;
    padding: 0.375rem 0.625rem;
    flex-shrink: 0;
    letter-spacing: 0.05em;
  }
  .split-badge-right {
    background-color: #0b4d8c;
    color: #ffffff;
    font-weight: 600;
    font-size: 0.75rem;
    line-height: 1rem;
    padding: 0.375rem 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    flex-shrink: 0;
  }
</style>
