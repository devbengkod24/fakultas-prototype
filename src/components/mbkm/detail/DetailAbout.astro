---
// src/components/mbkm/detail/DetailAbout.astro
---

<!-- ==================== TENTANG PROGRAM ==================== -->
<section
  id="tentang-program"
  class="relative isolate overflow-x-clip pt-16 pb-8 sm:pt-20 sm:pb-10 lg:pt-24 lg:pb-12"
>
  <!-- Dekorasi latar -->
  <div class="pointer-events-none absolute -left-24 top-8 -z-10 h-72 w-72 rounded-full bg-[#F3BC45]/20 blur-2xl"></div>
  <div class="pointer-events-none absolute -bottom-32 right-0 -z-10 h-80 w-80 rounded-full bg-primary-100/70 blur-3xl"></div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:items-stretch lg:gap-14">
      <!-- KOLOM KIRI: FOTO -->
      <div class="min-w-0 lg:col-span-7 lg:flex">
        <div class="relative w-full">
          <!-- Dekorasi di belakang foto -->
          <div class="absolute -left-3 -top-3 h-36 w-36 rounded-tl-[2rem] border-l-4 border-t-4 border-[#F3BC45] sm:-left-4 sm:-top-4"></div>

          <div class="relative aspect-[16/10] overflow-hidden rounded-2xl bg-gray-200 shadow-lg lg:aspect-auto lg:h-full">
            <img
              src="/assets/images/DicodingAsah.jpg"
              alt="Mahasiswa dan mentor program Dicoding ASAH 2026"
              loading="lazy"
              class="h-full w-full object-cover transition-transform duration-700 hover:scale-105"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#0D2544]/40 via-transparent to-transparent"></div>
          </div>
        </div>
      </div>

      <!-- KOLOM KANAN: TEKS + TOMBOL -->
      <div class="flex min-w-0 flex-col lg:col-span-5">
        <!-- Eyebrow -->
        <div class="flex items-center gap-3">
          <span class="h-px w-10 bg-[#F3BC45]"></span>
          <p class="text-sm font-bold uppercase tracking-[0.16em] text-primary-700">
            Tentang Program
          </p>
        </div>

        <h2 class="mt-4 text-2xl font-extrabold leading-[1.2] tracking-tight text-gray-900 sm:text-3xl">
          Akselerasi Kompetensi Digital dan Talenta AI Masa Depan
        </h2>

        <p class="mt-4 text-[15px] leading-8 text-gray-600">
          Dicoding ASAH (Accelerated Skills &amp; Artificial Intelligence Hub)
          2026 merupakan program MBKM yang dirancang khusus untuk mempersiapkan
          mahasiswa menjadi talenta digital andal yang siap bersaing di industri
          global. Melalui kurikulum berstandar internasional, peserta tidak hanya
          mempelajari landasan pemrograman dan teknologi terkini, tetapi juga
          mengasah soft skills serta kepemimpinan. Pembelajaran dilakukan secara
          fleksibel namun terstruktur melalui kombinasi online self-paced
          learning, sesi live mentoring bersama praktisi industri, serta
          pengerjaan Capstone Project berbasis kasus nyata.
        </p>

        <!-- Tombol pendaftaran (menempel di dasar kolom) -->
        <div class="mt-8 lg:mt-auto lg:pt-8">
          <a
            href="/pendaftaran-mahasiswa"
            class="group inline-flex w-full items-center justify-center gap-2 rounded-xl bg-primary-700 px-5 py-3.5 text-sm font-bold text-white shadow-md transition-all hover:-translate-y-0.5 hover:bg-primary-900 hover:shadow-lg"
          >
            <span>Daftar</span>
            <i data-lucide="arrow-right" class="h-4 w-4 transition-transform group-hover:translate-x-1"></i>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
