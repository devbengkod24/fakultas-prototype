---
// src/components/mbkm/detail/DetailTabs.astro
---

<!-- ========================================== -->
<!-- TAB INFORMASI PROGRAM                      -->
<!-- ========================================== -->
<section
  id="informasi-program"
  class="relative isolate scroll-mt-24 overflow-x-clip pt-6 pb-16 sm:pt-8 sm:pb-20 lg:pt-10 lg:pb-24 bg-slate-50/70"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Container Tablist di Tengah -->
    <div class="mx-auto max-w-2xl border-b border-slate-200">
      <div role="tablist" aria-label="Informasi program" class="-mb-px flex justify-center gap-6 sm:gap-10">
        <button
          type="button"
          role="tab"
          id="tab-informasi"
          data-tab-target="panel-informasi"
          aria-selected="true"
          aria-controls="panel-informasi"
          class="tab-btn shrink-0 whitespace-nowrap pb-4 text-sm sm:text-base font-bold text-[#072f57] border-b-2 border-[#072f57] transition-all cursor-pointer"
        >
          Informasi
        </button>
        <button
          type="button"
          role="tab"
          id="tab-persyaratan"
          data-tab-target="panel-persyaratan"
          aria-selected="false"
          aria-controls="panel-persyaratan"
          class="tab-btn shrink-0 whitespace-nowrap pb-4 text-sm sm:text-base font-semibold text-slate-500 hover:text-[#072f57] border-b-2 border-transparent transition-all cursor-pointer"
        >
          Persyaratan
        </button>
        <button
          type="button"
          role="tab"
          id="tab-kontributor"
          data-tab-target="panel-kontributor"
          aria-selected="false"
          aria-controls="panel-kontributor"
          class="tab-btn shrink-0 whitespace-nowrap pb-4 text-sm sm:text-base font-semibold text-slate-500 hover:text-[#072f57] border-b-2 border-transparent transition-all cursor-pointer"
        >
          Kontributor
        </button>
      </div>
    </div>

    <!-- Panel 1: Informasi -->
    <div role="tabpanel" id="panel-informasi" aria-labelledby="tab-informasi" tabindex="0" class="tab-panel min-h-[220px] pt-8 sm:pt-10">
      <div class="mx-auto max-w-3xl grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
        <div class="flex items-center gap-4 rounded-xl border border-slate-200/80 bg-white p-4 shadow-xs">
          <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-[#0b4d8c]"><i data-lucide="users" class="h-5 w-5"></i></div>
          <div class="min-w-0"><p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Kuota Peserta</p><p class="mt-0.5 text-base font-bold font-mono text-[#072f57]">3 / 10 Mahasiswa</p></div>
        </div>
        <div class="flex items-center gap-4 rounded-xl border border-slate-200/80 bg-white p-4 shadow-xs">
          <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-[#0b4d8c]"><i data-lucide="calendar-days" class="h-5 w-5"></i></div>
          <div class="min-w-0"><p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Periode Pelaksanaan</p><p class="mt-0.5 text-base font-bold text-[#072f57]">Februari – Juni 2026</p></div>
        </div>
        <div class="flex items-center gap-4 rounded-xl border border-slate-200/80 bg-white p-4 shadow-xs">
          <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-[#0b4d8c]"><i data-lucide="map-pin" class="h-5 w-5"></i></div>
          <div class="min-w-0"><p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Lokasi Kegiatan</p><p class="mt-0.5 text-base font-bold text-[#072f57]">H.6 Nexa UDINUS</p></div>
        </div>
        <div class="flex items-center gap-4 rounded-xl border border-slate-200/80 bg-white p-4 shadow-xs">
          <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-[#0b4d8c]"><i data-lucide="layers" class="h-5 w-5"></i></div>
          <div class="min-w-0"><p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Usulan Konversi</p><p class="mt-0.5 text-base font-bold font-mono text-[#072f57]">20 SKS</p></div>
        </div>
      </div>
    </div>

    <!-- Panel 2: Persyaratan -->
    <div role="tabpanel" id="panel-persyaratan" aria-labelledby="tab-persyaratan" tabindex="0" hidden class="tab-panel min-h-[220px] pt-8 sm:pt-10">
      <div class="mx-auto max-w-3xl grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
        <div class="flex items-center gap-4 rounded-xl border border-slate-200/80 bg-white p-4 shadow-xs">
          <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-[#0b4d8c]"><i data-lucide="graduation-cap" class="h-5 w-5"></i></div>
          <div class="min-w-0"><p class="text-xs font-semibold uppercase tracking-wider text-slate-500">IPK Kumulatif</p><p class="mt-0.5 text-base font-bold font-mono text-[#072f57]">Minimal 3,00</p></div>
        </div>
        <div class="flex items-center gap-4 rounded-xl border border-slate-200/80 bg-white p-4 shadow-xs">
          <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-[#0b4d8c]"><i data-lucide="calendar-check" class="h-5 w-5"></i></div>
          <div class="min-w-0"><p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Semester Aktif</p><p class="mt-0.5 text-base font-bold font-mono text-[#072f57]">Minimal Semester 5</p></div>
        </div>
        <div class="flex items-center gap-4 rounded-xl border border-slate-200/80 bg-white p-4 shadow-xs">
          <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-[#0b4d8c]"><i data-lucide="book-check" class="h-5 w-5"></i></div>
          <div class="min-w-0"><p class="text-xs font-semibold uppercase tracking-wider text-slate-500">SKS Tempuh</p><p class="mt-0.5 text-base font-bold font-mono text-[#072f57]">Minimal 80 SKS</p></div>
        </div>
        <div class="flex items-center gap-4 rounded-xl border border-slate-200/80 bg-white p-4 shadow-xs">
          <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-[#0b4d8c]"><i data-lucide="file-text" class="h-5 w-5"></i></div>
          <div class="min-w-0"><p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Dokumen Pendukung</p><p class="mt-0.5 text-base font-bold text-[#072f57]">CV ATS &amp; Portofolio</p></div>
        </div>
      </div>
    </div>

    <!-- Panel 3: Kontributor -->
    <div role="tabpanel" id="panel-kontributor" aria-labelledby="tab-kontributor" tabindex="0" hidden class="tab-panel min-h-[220px] pt-8 sm:pt-10">
      <div class="mx-auto max-w-3xl grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
        <div class="flex items-center gap-4 rounded-xl border border-slate-200/80 bg-white p-4 shadow-xs">
          <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-[#0b4d8c]"><i data-lucide="user-round" class="h-5 w-5"></i></div>
          <div class="min-w-0"><p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Koordinator MBKM</p><p class="mt-0.5 text-base font-bold text-[#072f57]">Dr. M. Arief Soeleman, M.Kom</p></div>
        </div>
        <div class="flex items-center gap-4 rounded-xl border border-slate-200/80 bg-white p-4 shadow-xs">
          <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-[#0b4d8c]"><i data-lucide="user-round" class="h-5 w-5"></i></div>
          <div class="min-w-0"><p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Dosen Pembimbing</p><p class="mt-0.5 text-base font-bold text-[#072f57]">Eko Hari Rachmawanto, M.Kom</p></div>
        </div>
        <div class="flex items-center gap-4 rounded-xl border border-slate-200/80 bg-white p-4 shadow-xs">
          <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-[#0b4d8c]"><i data-lucide="user-round" class="h-5 w-5"></i></div>
          <div class="min-w-0"><p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Dosen Pembimbing</p><p class="mt-0.5 text-base font-bold text-[#072f57]">Christy Atika Sari, M.Kom</p></div>
        </div>
        <div class="flex items-center gap-4 rounded-xl border border-slate-200/80 bg-white p-4 shadow-xs">
          <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-[#0b4d8c]"><i data-lucide="user-round" class="h-5 w-5"></i></div>
          <div class="min-w-0"><p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Dosen Pembimbing</p><p class="mt-0.5 text-base font-bold text-[#072f57]">Ajib Susanto, M.Kom</p></div>
        </div>
      </div>
    </div>
  </div>
</section>

<script src="./tabs-switcher.ts"></script>

<style>
  .tab-btn { position: relative; transition: color 0.2s, border-color 0.2s; }
  .tab-btn[aria-selected="true"] { color: #072f57; border-bottom-color: #072f57; font-weight: 700; }
  .tab-panel[hidden] { display: none; }
  .tab-panel { min-height: 220px; }
</style>
