---
// src/components/mbkm/konversi/ModalGantiMatkul.astro
---

<!-- Modal Ganti / Tambah Mata Kuliah (Murni Flat Tanpa Card di Dalam Card Sesuai Prinsip YAGNI) -->
<div
  x-show="showEditModal"
  class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/50"
  x-transition
  x-cloak
>
  <div
    class="bg-white rounded-xl w-full max-w-md p-6 shadow-xl border border-[#e4e4e7] space-y-4 font-sans"
    @click.outside="showEditModal = false"
  >
    <!-- Modal Header -->
    <div class="flex items-center justify-between pb-3 border-b border-[#e4e4e7]">
      <div class="flex items-center gap-2 text-[#0655a7] font-semibold text-base">
        <i :data-lucide="modalMode === 'tambah' ? 'plus-circle' : (editTarget?.status === 'decline' ? 'refresh-cw' : 'pencil')" class="w-4 h-4"></i>
        <h3 class="text-base font-semibold text-[#09090b]" x-text="modalMode === 'tambah' ? 'Tambah Mata Kuliah Konversi' : (editTarget?.status === 'decline' ? 'Ganti Mata Kuliah Konversi' : 'Edit Mata Kuliah Konversi')"></h3>
      </div>
      <button
        type="button"
        @click="showEditModal = false"
        class="text-[#71717a] hover:text-[#09090b] p-1.5 rounded-md hover:bg-[#f4f4f5] transition-colors cursor-pointer"
        title="Tutup"
      >
        <i data-lucide="x" class="w-4 h-4"></i>
      </button>
    </div>

    <!-- Detail Matkul Yang Dipilih (Murni Flat, Tanpa Inner Card Box) -->
    <template x-if="modalMode === 'ganti'">
      <div class="space-y-1">
        <span
          class="text-xs font-medium block"
          :class="editTarget?.status === 'decline' ? 'text-rose-700 font-semibold' : 'text-[#71717a]'"
          x-text="editTarget?.status === 'decline' ? 'Mata Kuliah Ditolak:' : 'Mata Kuliah Saat Ini:'"
        ></span>
        <h4 class="text-sm font-semibold text-[#09090b]" x-text="editTarget?.nama"></h4>
        <p class="text-xs text-[#71717a]" x-text="`${editTarget?.kode} | ${editTarget?.sks} SKS`"></p>
        <template x-if="editTarget?.catatan">
          <p class="text-xs text-rose-600 mt-1" x-text="`Alasan: ${editTarget.catatan}`"></p>
        </template>
      </div>
    </template>

    <!-- Pemilihan Matkul -->
    <div class="space-y-1.5">
      <label for="select-matkul" class="text-xs font-semibold text-[#09090b] block">
        Pilih Mata Kuliah
      </label>
      <select
        id="select-matkul"
        x-model="selectedMatkul"
        class="w-full h-9 px-3 border border-[#e4e4e7] rounded-md bg-white text-xs font-medium text-[#09090b] focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
      >
        <option value="">-- Pilih Mata Kuliah --</option>
        <template x-for="m in unselectedMatkul" :key="m.kode">
          <option :value="m.kode" x-text="`${m.nama} (${m.sks} SKS) - ${m.kode}`"></option>
        </template>
      </select>
    </div>

    <!-- Footer Modal -->
    <div class="flex items-center justify-end gap-2.5 pt-3 border-t border-[#e4e4e7]">
      <button
        type="button"
        @click="showEditModal = false"
        class="h-9 px-4 border border-[#e4e4e7] bg-white hover:bg-[#f4f4f5] rounded-md font-medium text-xs text-[#09090b] transition-colors cursor-pointer"
      >
        Batal
      </button>
      <button
        type="button"
        @click="modalMode === 'tambah' ? addMatkul() : confirmEdit()"
        :disabled="!selectedMatkul"
        class="h-9 px-4 bg-[#0655a7] hover:bg-[#114d91] disabled:opacity-50 disabled:cursor-not-allowed text-white rounded-md font-semibold text-xs shadow-none transition-colors cursor-pointer"
        x-text="modalMode === 'tambah' ? 'Tambahkan' : (editTarget?.status === 'decline' ? 'Konfirmasi Ganti' : 'Simpan Perubahan')"
      >
      </button>
    </div>
  </div>
</div>
