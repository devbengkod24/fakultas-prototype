---
// src/components/mbkm/konversi/KonversiLockedNotice.astro
---

<!-- State: Akses Konversi SKS Terkunci Saat Masih Pendaftar -->
<div
  x-show="$store.mahasiswaSim?.state === 'belum_daftar'"
  x-cloak
  class="rounded-xl border border-[#e4e4e7] bg-white p-8 sm:p-12 text-center space-y-4 shadow-none"
>
  <div class="w-14 h-14 rounded-full bg-amber-50 border border-amber-200 text-amber-600 flex items-center justify-center mx-auto shadow-2xs">
    <i data-lucide="lock" class="w-7 h-7 text-amber-600"></i>
  </div>

  <div class="max-w-md mx-auto space-y-1.5">
    <h3 class="text-base font-semibold text-[#09090b]">
      Akses Konversi 20 SKS Belum Terbuka
    </h3>
    <p class="text-xs text-[#71717a] leading-relaxed">
      Formulir ekuivalensi 20 SKS dan penetapan Dosen Pembimbing hanya dapat diakses setelah Anda menerima penawaran mitra dan mengonfirmasi penerimaan dokumen Pakta Integritas di Dashboard.
    </p>
  </div>

  <div class="pt-2">
    <a
      href="/mahasiswa/dashboard"
      class="inline-flex items-center gap-2 h-9 px-4 rounded-md bg-[#0655a7] hover:bg-[#114d91] text-white text-xs font-semibold transition-colors shadow-none"
    >
      <i data-lucide="layout-dashboard" class="w-4 h-4"></i>
      <span>Buka Dashboard</span>
    </a>
  </div>
</div>
