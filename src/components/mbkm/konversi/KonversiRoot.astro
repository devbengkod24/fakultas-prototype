---
// src/components/mbkm/konversi/KonversiRoot.astro
// Pemegang state Alpine alur Konversi SKS (4 tahap). Seluruh turunan memakai scope ini lewat <slot />.
import {
  MAKS_SKS,
  katalogMatkul,
  buatPengajuan,
  pengajuanAwal,
  pengajuanLengkap,
} from "../../../data/mahasiswa/konversiData";

const json = (v: unknown) => JSON.stringify(v);
const lengkap = buatPengajuan(pengajuanLengkap, "accept");
const ditolak = lengkap.map((m, i) =>
  i === 0
    ? { ...m, status: "decline", catatan: "Capaian pembelajaran tidak relevan dengan fokus proyek mitra." }
    : m,
);
---

<div
  class="w-full space-y-4"
  x-data={`{
    currentStep: 1,
    kondisiSimulasi: 'pertama',
    maxSks: ${MAKS_SKS},
    katalog: ${json(katalogMatkul)},
    konversiList: ${json(buatPengajuan(pengajuanAwal, "draft"))},
    kelompokTersimpan: false,
    modalMode: 'ganti',
    showEditModal: false,
    editTargetIndex: null,
    editTarget: null,
    selectedMatkul: '',

    init() {
      this.$watch('currentStep', () => this.refreshIcons());
      this.$watch('kelompokTersimpan', () => this.refreshIcons());
    },
    refreshIcons() { this.$nextTick(() => window.lucide && window.lucide.createIcons()); },

    get hasDeclined() { return this.konversiList.some(m => m.status === 'decline'); },
    get unselectedMatkul() { return this.katalog.filter(m => !this.konversiList.some(k => k.kode === m.kode)); },
    get matkulBaru() { return this.unselectedMatkul.filter(m => !m.nilaiLama); },
    get matkulUlang() { return this.unselectedMatkul.filter(m => m.nilaiLama); },
    get selectedInfo() { return this.katalog.find(m => m.kode === this.selectedMatkul) || null; },
    get totalSks() { return this.konversiList.reduce((n, m) => n + (Number(m.sks) || 0), 0); },
    get kelompokLengkap() { return this.konversiList.every(m => Number(m.sks) > 0 && m.dosen); },
    get kelompokValid() { return this.kelompokLengkap && this.totalSks <= this.maxSks; },

    setKondisi(val) {
      this.kondisiSimulasi = val;
      this.kelompokTersimpan = false;
      if (val === 'pertama') { this.konversiList = ${json(buatPengajuan(pengajuanAwal, "draft"))}; this.currentStep = 1; }
      else if (val === 'menunggu') { this.konversiList = ${json(buatPengajuan(pengajuanAwal, "draft"))}; this.currentStep = 2; }
      else if (val === 'tolak') { this.konversiList = ${json(ditolak)}; this.currentStep = 1; }
      else { this.konversiList = ${json(lengkap)}; this.currentStep = 3; }
      this.refreshIcons();
    },
    openAddModal() { this.modalMode = 'tambah'; this.selectedMatkul = ''; this.showEditModal = true; this.refreshIcons(); },
    openEdit(idx) { this.modalMode = 'ganti'; this.editTargetIndex = idx; this.editTarget = { ...this.konversiList[idx] }; this.selectedMatkul = ''; this.showEditModal = true; this.refreshIcons(); },
    addMatkul() {
      const m = this.selectedInfo; if (!m) return;
      this.konversiList.push({ ...m, status: 'draft', catatan: '', sks: null, dosen: '' });
      this.showEditModal = false; this.selectedMatkul = ''; this.refreshIcons();
    },
    confirmEdit() {
      const m = this.selectedInfo; if (!m) return;
      this.konversiList[this.editTargetIndex] = { ...m, status: 'draft', catatan: '', sks: null, dosen: '' };
      this.showEditModal = false; this.refreshIcons();
    },
    removeMatkul(idx) { this.konversiList.splice(idx, 1); this.refreshIcons(); },
    submitPakta() { alert('Pakta Integritas berhasil diunggah. Proses konversi selesai.'); },
    submitKonversi() {
      if (this.hasDeclined || !this.konversiList.length) return;
      this.kondisiSimulasi = 'menunggu';
      this.currentStep = 2;
    },
    simpanKelompok() { if (this.kelompokValid) { this.kelompokTersimpan = true; this.currentStep = 4; } }
  }`}
>
  <slot />
</div>
