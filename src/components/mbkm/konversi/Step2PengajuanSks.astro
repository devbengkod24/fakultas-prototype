---
// src/components/mbkm/konversi/Step2PengajuanSks.astro
// Tahap 1: Pengajuan Matkul. Tiap baris ditandai Baru atau Mengulang (berdasarkan nilai lama di transkrip).
// SKS dan dosen diisi pada tahap 3 (Kelompok Matkul).
---

<div x-show="currentStep === 1" class="space-y-4" x-transition>
  <!-- Pemberitahuan saat ada matkul yang ditolak Koordinator -->
  <div
    x-show="hasDeclined"
    x-cloak
    class="flex items-start gap-2.5 rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-xs text-rose-800"
  >
    <i data-lucide="alert-circle" class="w-4 h-4 shrink-0 mt-px text-rose-600"></i>
    <p class="leading-relaxed">
      Koordinator MBKM tidak menyetujui sebagian mata kuliah. Ganti mata kuliah yang ditolak, lalu ajukan ulang.
    </p>
  </div>

  <div class="rounded-xl border border-[#e4e4e7] bg-white shadow-none">
    <div class="px-5 py-3.5 border-b border-[#e4e4e7] flex items-center justify-between gap-3">
      <h3 class="text-base font-semibold text-[#09090b]">Pengajuan Matkul</h3>

      <button
        x-show="kondisiSimulasi === 'pertama'"
        type="button"
        @click="openAddModal()"
        class="inline-flex items-center gap-1.5 h-8 px-3 rounded-md bg-[#0655a7] hover:bg-[#114d91] text-white text-xs font-semibold transition-colors shadow-none cursor-pointer"
      >
        <i data-lucide="plus" class="w-3.5 h-3.5"></i>
        <span>Tambah Mata Kuliah</span>
      </button>
    </div>

    <table class="w-full text-sm border-collapse">
      <thead class="bg-[#fafafa] border-b border-[#e4e4e7]">
        <tr>
          <th class="h-10 px-3 text-center font-medium text-[#71717a] text-xs w-12">No</th>
          <th class="h-10 px-4 text-left font-medium text-[#71717a] text-xs">Mata Kuliah</th>
          <th class="h-10 px-3 text-center font-medium text-[#71717a] text-xs w-40">Jenis</th>
          <th class="h-10 px-3 text-center font-medium text-[#71717a] text-xs w-44">Status</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-[#e4e4e7]">
        <template x-for="(row, idx) in konversiList" :key="row.kode">
          <tr class="hover:bg-[#fafafa] transition-colors">
            <td class="p-3 text-center align-middle text-xs font-medium text-[#71717a]" x-text="idx + 1"></td>

            <td class="p-4 align-middle">
              <div class="text-sm font-medium text-[#09090b]">
                <span x-text="row.kode"></span>
                <span class="text-[#71717a] font-normal mx-1">·</span>
                <span x-text="row.nama"></span>
              </div>
            </td>

            <!-- Jenis: Baru / Mengulang (dengan nilai lama) -->
            <td class="p-3 text-center align-middle">
              <span
                class="inline-flex items-center gap-1 text-xs font-medium px-2 py-0.5 rounded-md border"
                :class="row.nilaiLama ? 'border-amber-200 bg-amber-50 text-amber-800' : 'border-[#e4e4e7] bg-[#fafafa] text-[#3f3f46]'"
              >
                <span x-text="row.nilaiLama ? 'Mengulang' : 'Baru'"></span>
                <span x-show="row.nilaiLama" class="text-amber-700/80" x-text="'· Nilai ' + row.nilaiLama"></span>
              </span>
            </td>

            <td class="p-3 text-center align-middle">
              <span
                x-show="row.status === 'accept'"
                class="inline-flex items-center gap-1 text-xs font-semibold px-2.5 py-0.5 rounded-md border border-emerald-200 bg-emerald-50 text-emerald-800"
              >
                <i data-lucide="check" class="w-3.5 h-3.5 text-emerald-600"></i>
                <span>Disetujui</span>
              </span>

              <div x-show="row.status === 'decline'" class="inline-flex items-center gap-1.5">
                <span class="inline-flex items-center gap-1 text-xs font-semibold px-2 py-0.5 rounded-md border border-rose-200 bg-rose-50 text-rose-700">
                  <i data-lucide="x" class="w-3 h-3 text-rose-600"></i>
                  <span>Ditolak</span>
                </span>
                <button
                  type="button"
                  @click="openEdit(idx)"
                  class="inline-flex items-center gap-1 h-7 px-2 text-xs font-medium rounded-md border border-[#e4e4e7] bg-white hover:bg-[#f4f4f5] text-[#09090b] transition-colors cursor-pointer"
                  title="Pilih mata kuliah pengganti"
                >
                  <i data-lucide="refresh-cw" class="w-3 h-3 text-[#71717a]"></i>
                  <span>Ganti</span>
                </button>
              </div>

              <!-- Belum diajukan: menu Edit & Hapus -->
              <div x-show="row.status === 'draft'" class="relative inline-block text-left" x-data="{ openMenu: false }">
                <button
                  type="button"
                  @click="openMenu = !openMenu; $nextTick(() => window.lucide && window.lucide.createIcons())"
                  @click.outside="openMenu = false"
                  class="h-7 w-7 rounded-md border border-[#e4e4e7] bg-white hover:bg-[#f4f4f5] text-[#71717a] hover:text-[#09090b] inline-flex items-center justify-center transition-colors cursor-pointer shadow-2xs"
                  title="Menu opsi"
                >
                  <i data-lucide="more-horizontal" class="w-3.5 h-3.5"></i>
                </button>
                <div
                  x-show="openMenu"
                  x-cloak
                  x-transition
                  class="absolute right-0 top-full mt-1 w-28 rounded-md border border-[#e4e4e7] bg-white py-1 shadow-lg z-30 text-xs"
                >
                  <button
                    type="button"
                    @click="openMenu = false; openEdit(idx)"
                    class="w-full px-3 py-1.5 text-left text-[#09090b] hover:bg-[#f4f4f5] flex items-center gap-2 cursor-pointer transition-colors"
                  >
                    <i data-lucide="pencil" class="w-3.5 h-3.5 text-[#71717a]"></i>
                    <span>Edit</span>
                  </button>
                  <button
                    type="button"
                    @click="openMenu = false; removeMatkul(idx)"
                    class="w-full px-3 py-1.5 text-left text-rose-600 hover:bg-rose-50 flex items-center gap-2 cursor-pointer transition-colors"
                  >
                    <i data-lucide="trash-2" class="w-3.5 h-3.5 text-rose-600"></i>
                    <span>Hapus</span>
                  </button>
                </div>
              </div>
            </td>
          </tr>
        </template>
      </tbody>
    </table>

    <p x-show="!konversiList.length" class="px-5 py-8 text-center text-xs text-[#71717a]">
      Belum ada mata kuliah. Klik "Tambah Mata Kuliah" untuk mulai mengajukan.
    </p>
  </div>

  <div class="flex items-center justify-end pt-1">
    <button
      type="button"
      @click="submitKonversi()"
      :disabled="hasDeclined || !konversiList.length"
      class="inline-flex items-center gap-1.5 h-8 px-3.5 rounded-md bg-[#0655a7] hover:bg-[#114d91] text-white text-xs font-semibold transition-colors shadow-none cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
    >
      <span x-text="kondisiSimulasi === 'tolak' ? 'Ajukan Ulang' : 'Kirim Pengajuan'"></span>
      <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
    </button>
  </div>
</div>
