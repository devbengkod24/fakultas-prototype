---
// src/components/mbkm/konversi/Step2PengajuanSks.astro
---

<!-- Tahap 2: Matriks Konversi SKS (Persis Format Tabel Koordinator, Murni YAGNI Tanpa Card-in-Card) -->
<div x-show="currentStep === 2" class="space-y-4" x-transition>
  <!-- Tabel Utama Konversi (Langsung Container Tabel Tunggal Tanpa Card Bertingkat) -->
  <div class="rounded-xl border border-[#e4e4e7] bg-white shadow-none">
    <!-- Header Tabel: Pengajuan SKS & Tombol Tambah Mata Kuliah Space Between -->
    <div class="px-5 py-3.5 border-b border-[#e4e4e7] flex items-center justify-between gap-3">
      <h3 class="text-base font-semibold text-[#09090b]">
        Pengajuan SKS
      </h3>

      <!-- Tombol Tambah Mata Kuliah (Hanya Tampil saat Mahasiswa Pertama Kali Memasukkan Matkul) -->
      <template x-if="kondisiSimulasi === 'pertama'">
        <button
          type="button"
          @click="openAddModal()"
          class="inline-flex items-center gap-1.5 h-8 px-3 rounded-md bg-[#0655a7] hover:bg-[#114d91] text-white text-xs font-semibold transition-colors shadow-none cursor-pointer"
        >
          <i data-lucide="plus" class="w-3.5 h-3.5"></i>
          <span>Tambah Mata Kuliah</span>
        </button>
      </template>
    </div>

    <!-- Tabel Data (Sama Persis dengan Modal Verifikasi Koordinator) -->
    <table class="w-full text-sm border-collapse">
      <thead class="bg-[#fafafa] border-b border-[#e4e4e7]">
        <tr>
          <th class="h-10 px-3 text-center align-middle font-medium text-[#71717a] text-xs w-12 rounded-tl-xl">No</th>
          <th class="h-10 px-4 text-left align-middle font-medium text-[#71717a] text-xs">Mata Kuliah</th>
          <th class="h-10 px-3 text-center align-middle font-medium text-[#71717a] text-xs w-24">SKS</th>
          <th class="h-10 px-3 text-center align-middle font-medium text-[#71717a] text-xs w-36 rounded-tr-xl" x-text="kondisiSimulasi === 'pertama' ? 'Aksi' : 'Status'">Status</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-[#e4e4e7]">
        <template x-for="(row, idx) in konversiList" :key="row.kode">
          <tr class="hover:bg-[#fafafa] transition-colors">
            <!-- No -->
            <td class="p-3 text-center align-middle text-xs font-medium text-[#71717a]" x-text="idx + 1"></td>

            <!-- Mata Kuliah (Kode · Nama) & Catatan Penolakan jika Ditolak -->
            <td class="p-4 align-middle">
              <div class="text-sm font-medium text-[#09090b]">
                <span x-text="row.kode"></span>
                <span class="text-[#71717a] font-normal mx-1">·</span>
                <span x-text="row.nama"></span>
              </div>
              <template x-if="row.status === 'decline' && row.catatan">
                <div class="text-xs text-rose-600 mt-1 flex items-start gap-1">
                  <i data-lucide="info" class="w-3.5 h-3.5 shrink-0 mt-0.5"></i>
                  <span x-text="`Catatan: ${row.catatan}`"></span>
                </div>
              </template>
            </td>

            <!-- SKS -->
            <td class="p-3 text-center align-middle text-xs font-semibold text-[#0655a7]" x-text="`${row.sks} SKS`"></td>

            <!-- Status & Tombol Aksi -->
            <td class="p-3 text-center align-middle">
              <!-- Jika Disetujui -->
              <template x-if="row.status === 'accept'">
                <span class="inline-flex items-center gap-1 text-xs font-semibold px-2.5 py-0.5 rounded-md border border-emerald-200 bg-emerald-50 text-emerald-800">
                  <i data-lucide="check" class="w-3.5 h-3.5 text-emerald-600"></i>
                  <span>Disetujui</span>
                </span>
              </template>

              <!-- Jika Ditolak: Ada Tombol Ganti Matkul -->
              <template x-if="row.status === 'decline'">
                <div class="inline-flex items-center gap-1.5">
                  <span class="inline-flex items-center gap-1 text-xs font-semibold px-2 py-0.5 rounded-md border border-rose-200 bg-rose-50 text-rose-700">
                    <i data-lucide="x" class="w-3 h-3 text-rose-600"></i>
                    <span>Ditolak</span>
                  </span>
                  <button
                    type="button"
                    @click="openEdit(idx)"
                    class="inline-flex items-center gap-1 h-7 px-2 text-xs font-medium rounded-md border border-[#e4e4e7] bg-white hover:bg-[#f4f4f5] text-[#09090b] transition-colors cursor-pointer"
                    title="Pilih mata kuliah pengganti"
                  >
                    <i data-lucide="refresh-cw" class="w-3 h-3 text-[#71717a]"></i>
                    <span>Ganti</span>
                  </button>
                </div>
              </template>

              <!-- Jika Baru Pertama Memasukkan (Square Button "..." dengan Menu Dropdown Edit & Hapus) -->
              <template x-if="kondisiSimulasi === 'pertama'">
                <div class="relative inline-block text-left" x-data="{ openMenu: false }">
                  <button
                    type="button"
                    @click="openMenu = !openMenu; $nextTick(() => window.lucide && window.lucide.createIcons())"
                    @click.outside="openMenu = false"
                    class="h-7 w-7 rounded-md border border-[#e4e4e7] bg-white hover:bg-[#f4f4f5] text-[#71717a] hover:text-[#09090b] inline-flex items-center justify-center transition-colors cursor-pointer shadow-2xs"
                    title="Menu opsi"
                  >
                    <i data-lucide="more-horizontal" class="w-3.5 h-3.5"></i>
                  </button>

                  <div
                    x-show="openMenu"
                    x-cloak
                    x-transition
                    class="absolute right-0 top-full mt-1 w-28 rounded-md border border-[#e4e4e7] bg-white py-1 shadow-lg z-30 text-xs"
                  >
                    <button
                      type="button"
                      @click="openMenu = false; openEdit(idx)"
                      class="w-full px-3 py-1.5 text-left text-[#09090b] hover:bg-[#f4f4f5] flex items-center gap-2 cursor-pointer transition-colors"
                    >
                      <i data-lucide="pencil" class="w-3.5 h-3.5 text-[#71717a]"></i>
                      <span>Edit</span>
                    </button>
                    <button
                      type="button"
                      @click="openMenu = false; removeMatkul(idx)"
                      class="w-full px-3 py-1.5 text-left text-rose-600 hover:bg-rose-50 flex items-center gap-2 cursor-pointer transition-colors"
                    >
                      <i data-lucide="trash-2" class="w-3.5 h-3.5 text-rose-600"></i>
                      <span>Hapus</span>
                    </button>
                  </div>
                </div>
              </template>
            </td>
          </tr>
        </template>
      </tbody>
    </table>
  </div>

  <!-- Navigasi Bawah (Ukuran Tombol Seragam h-8 Sesuai Standar) -->
  <div class="flex items-center justify-between pt-1">
    <button
      type="button"
      @click="currentStep = 1; $nextTick(() => window.lucide && window.lucide.createIcons())"
      class="inline-flex items-center gap-1.5 h-8 px-3 rounded-md border border-[#e4e4e7] bg-white hover:bg-[#f4f4f5] text-[#09090b] text-xs font-medium transition-colors cursor-pointer"
    >
      <i data-lucide="arrow-left" class="w-3.5 h-3.5"></i>
      <span>Kembali</span>
    </button>

    <button
      type="button"
      @click="submitKonversi()"
      :disabled="hasDeclined"
      class="inline-flex items-center gap-1.5 h-8 px-3.5 rounded-md bg-[#0655a7] hover:bg-[#114d91] text-white text-xs font-semibold transition-colors shadow-none cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
    >
      <span x-text="kondisiSimulasi === 'pertama' ? 'Kirim Pengajuan SKS' : 'Selanjutnya'"></span>
      <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
    </button>
  </div>
</div>
