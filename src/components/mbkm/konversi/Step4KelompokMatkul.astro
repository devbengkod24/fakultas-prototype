---
// src/components/mbkm/konversi/Step4KelompokMatkul.astro
// Tahap 4: melengkapi SKS dan dosen pengampu untuk mata kuliah yang sudah disetujui (kode & nama terbawa dari tahap 2).
---

<div x-show="currentStep === 4" x-cloak class="space-y-4" x-transition>
  <div class="rounded-xl border border-[#e4e4e7] bg-white shadow-none">
    <div class="px-5 py-4 border-b border-[#e4e4e7] flex flex-col sm:flex-row sm:items-start justify-between gap-3">
      <div>
        <h3 class="text-base font-semibold text-[#09090b]">Kelompok Matkul</h3>
        <p class="text-xs text-[#71717a] mt-0.5 leading-relaxed">
          Seluruh mata kuliah telah disetujui. Lengkapi SKS dan dosen pengampu untuk tiap mata kuliah.
        </p>
      </div>
      <span
        x-show="kelompokTersimpan"
        x-cloak
        class="inline-flex items-center gap-1.5 self-start shrink-0 text-xs font-semibold px-2.5 py-1 rounded-md border border-emerald-200 bg-emerald-50 text-emerald-800"
      >
        <i data-lucide="check-circle-2" class="w-3.5 h-3.5 text-emerald-600"></i>
        Tersimpan
      </span>
    </div>

    <table class="w-full text-sm border-collapse">
      <thead class="bg-[#fafafa] border-b border-[#e4e4e7]">
        <tr>
          <th class="h-10 px-3 text-center font-medium text-[#71717a] text-xs w-12">No</th>
          <th class="h-10 px-4 text-left font-medium text-[#71717a] text-xs">Mata Kuliah</th>
          <th class="h-10 px-3 text-left font-medium text-[#71717a] text-xs w-28">SKS</th>
          <th class="h-10 px-3 text-left font-medium text-[#71717a] text-xs w-72">Dosen Pengampu</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-[#e4e4e7]">
        <template x-for="(row, idx) in konversiList" :key="row.kode">
          <tr>
            <td class="p-3 text-center align-middle text-xs font-medium text-[#71717a]" x-text="idx + 1"></td>
            <td class="p-4 align-middle">
              <div class="text-sm font-medium text-[#09090b]">
                <span x-text="row.kode"></span>
                <span class="text-[#71717a] font-normal mx-1">·</span>
                <span x-text="row.nama"></span>
              </div>
              <div x-show="row.nilaiLama" class="text-xs text-amber-700 mt-0.5" x-text="'Mengulang · Nilai sebelumnya ' + row.nilaiLama"></div>
            </td>
            <td class="p-3 align-middle">
              <input
                type="number"
                min="1"
                inputmode="numeric"
                placeholder="0"
                :name="'sks-' + row.kode"
                x-model.number="row.sks"
                :disabled="kelompokTersimpan"
                class="w-20 h-9 px-3 border border-[#e4e4e7] rounded-md bg-white text-xs font-medium text-[#09090b] focus:outline-none focus:ring-1 focus:ring-[#0655a7] disabled:bg-[#fafafa] disabled:text-[#52525b]"
              />
            </td>
            <td class="p-3 align-middle">
              <input
                type="text"
                autocomplete="off"
                placeholder="Ketik nama dosen pengampu"
                :name="'dosen-' + row.kode"
                x-model.trim="row.dosen"
                :disabled="kelompokTersimpan"
                class="w-full h-9 px-3 border border-[#e4e4e7] rounded-md bg-white text-xs font-medium text-[#09090b] placeholder:font-normal placeholder:text-[#a1a1aa] focus:outline-none focus:ring-1 focus:ring-[#0655a7] disabled:bg-[#fafafa] disabled:text-[#52525b]"
              />
            </td>
          </tr>
        </template>
      </tbody>
    </table>

    <div class="px-5 py-3.5 border-t border-[#e4e4e7] flex flex-col sm:flex-row sm:items-center justify-between gap-3">
      <div class="text-xs">
        <span class="text-[#71717a]">Total SKS</span>
        <span
          class="ml-1.5 font-semibold"
          :class="totalSks > maxSks ? 'text-rose-600' : 'text-[#09090b]'"
          x-text="totalSks + ' / ' + maxSks"
        ></span>
        <span x-show="totalSks > maxSks" x-cloak class="ml-2 text-rose-600">Melebihi batas program.</span>
      </div>

      <div class="flex items-center gap-2">
        <button
          x-show="kelompokTersimpan"
          x-cloak
          type="button"
          @click="kelompokTersimpan = false"
          class="inline-flex items-center gap-1.5 h-8 px-3 rounded-md border border-[#e4e4e7] bg-white hover:bg-[#f4f4f5] text-[#09090b] text-xs font-medium transition-colors cursor-pointer"
        >
          <i data-lucide="pencil" class="w-3.5 h-3.5 text-[#71717a]"></i>
          <span>Ubah</span>
        </button>
        <button
          x-show="!kelompokTersimpan"
          type="button"
          @click="simpanKelompok()"
          :disabled="!kelompokValid"
          class="inline-flex items-center gap-1.5 h-8 px-3.5 rounded-md bg-[#0655a7] hover:bg-[#114d91] text-white text-xs font-semibold transition-colors shadow-none cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
        >
          <span>Simpan Kelompok Matkul</span>
        </button>
      </div>
    </div>
  </div>
</div>
