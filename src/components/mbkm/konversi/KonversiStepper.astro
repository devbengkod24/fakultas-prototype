---
// src/components/mbkm/konversi/KonversiStepper.astro
// Stepper 4 tahap: Pengajuan Matkul -> Konfirmasi Matkul -> Kelompok Matkul -> Pakta Integritas
const steps = [
  { n: 1, label: "Pengajuan Matkul" },
  { n: 2, label: "Konfirmasi Matkul" },
  { n: 3, label: "Kelompok Matkul" },
  { n: 4, label: "Pakta Integritas" },
];
---

<div class="rounded-xl border border-[#e4e4e7] bg-white text-[#09090b] shadow-none py-4 px-4 sm:px-6">
  <div class="relative py-1 max-w-3xl mx-auto">
    <!-- Garis progres: sumbu node pertama di 12.5% dan terakhir di 87.5% -->
    <div class="absolute left-[12.5%] right-[12.5%] top-5 -translate-y-1/2 h-1 bg-[#e4e4e7] rounded-full z-0" aria-hidden="true">
      <div
        class="h-full bg-[#0655a7] rounded-full transition-all duration-500 ease-out"
        :style="`width: ${(currentStep - 1) / 3 * 100}%`"
      ></div>
    </div>

    <div class="relative z-10 grid grid-cols-4 text-center">
      {steps.map((s) => (
        <div class="flex flex-col items-center">
          <!-- Sementara (prototipe): semua node bisa diklik untuk berpindah tahap -->
          <button
            type="button"
            @click={`currentStep = ${s.n}`}
            class="w-10 h-10 rounded-full flex items-center justify-center font-bold text-xs transition-all border-2 border-white cursor-pointer"
            :class={`currentStep > ${s.n}
              ? 'bg-[#0655a7] text-white ring-4 ring-blue-50'
              : (currentStep === ${s.n} ? 'bg-[#0655a7] text-white ring-4 ring-blue-100' : 'bg-[#f4f4f5] text-[#71717a]')`}
            :aria-current={`currentStep === ${s.n} ? 'step' : null`}
          >
            <i x-show={`currentStep > ${s.n}`} data-lucide="check" class="w-4 h-4 text-white"></i>
            <span x-show={`currentStep <= ${s.n}`}>{s.n}</span>
          </button>
          <span
            class="mt-2 text-xs font-semibold leading-tight transition-colors"
            :class={`currentStep === ${s.n} ? 'text-[#0655a7]' : (currentStep > ${s.n} ? 'text-[#09090b]' : 'text-[#71717a]')`}
          >
            {s.label}
          </span>
        </div>
      ))}
    </div>
  </div>
</div>
