---
// src/components/mbkm/katalog/MbkmHero.astro
---

<!-- [Komponen: HeroSection MBKM] — Mengikuti format sub-halaman (Inovasi / Pengumuman) FTC Landing v2 -->
<section class="relative overflow-hidden bg-[#072f57] text-white">
  <!-- Background Image Sesuai Header Menu Inovasi FTC v2 -->
  <img
    src="https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?auto=format&fit=crop&w=1600&q=80"
    alt="Program MBKM FTC UDINUS"
    loading="lazy"
    decoding="async"
    class="absolute inset-0 h-full w-full object-cover object-center opacity-25 pointer-events-none"
  />

  <!-- Gradient Overlay dari Deep Navy ke Primary Blue yang luminous (tidak terlalu gelap) -->
  <div class="absolute inset-0 bg-gradient-to-r from-[#072f57] via-[#072f57]/85 to-[#0b4d8c]/75"></div>

  <!-- Kontainer Konten (Align dengan Grid Katalog di Bawah) -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 py-14 sm:py-16">
    <!-- Split-Block Badge FTC v2 (Persis Format Desain Inovasi / Pengumuman) -->
    <div class="split-badge mb-4 inline-flex items-center rounded-lg overflow-hidden shadow-sm max-w-full">
      <span class="split-badge-left bg-[#f5a623] text-[#072f57] font-extrabold text-xs px-2.5 py-1.5 shrink-0 tracking-wider">FTC</span>
      <span class="split-badge-right bg-[#0b4d8c] text-white font-semibold text-xs px-3.5 py-1.5 uppercase tracking-wider shrink-0">INFORMASI MBKM FTC</span>
    </div>

    <!-- Judul H1 -->
    <h1 class="text-3xl font-extrabold tracking-tight sm:text-5xl text-white">
      MBKM
    </h1>

    <!-- Paragraf Informasi Program (100% Persis Teks Asli) -->
    <p class="mt-3 max-w-3xl text-sm sm:text-base leading-relaxed text-white/80 font-normal">
      Program MBKM FTC UDINUS memberikan kesempatan mahasiswa untuk belajar di luar kelas melalui pengalaman langsung di industri, masyarakat, dan perguruan tinggi, dengan konversi kegiatan ke dalam SKS secara transparan.
    </p>
  </div>
</section>

<style>
  /* Split-block badge 2 bagian FTC v2 */
  .split-badge {
    display: inline-flex;
    align-items: center;
    border-radius: 0.5rem;
    overflow: hidden;
    box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
    max-width: 100%;
  }
  .split-badge-left {
    background-color: #f5a623;
    color: #072f57;
    font-weight: 800;
    font-size: 0.75rem;
    line-height: 1rem;
    padding: 0.375rem 0.625rem;
    flex-shrink: 0;
    letter-spacing: 0.05em;
  }
  .split-badge-right {
    background-color: #0b4d8c;
    color: #ffffff;
    font-weight: 600;
    font-size: 0.75rem;
    line-height: 1rem;
    padding: 0.375rem 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    flex-shrink: 0;
  }
</style>
