---

<div id="cardGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5 sm:gap-6">
  {programs.map((item) => (
    <MbkmProgramCard
      title={item.title}
      type={item.type}
      by={item.by}
      badge={item.badge}
      image={item.image}
      desc={item.desc}
      hidden={item.hidden}
    />
  ))}
</div>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const tabs = document.querySelectorAll(".type-tab");
    const typeTitle = document.getElementById("typeTitle");
    const cards = document.querySelectorAll(".program-card");

    const typeContent = {
      internal: { title: "MBKM Internal" },
      eksternal: { title: "MBKM Eksternal" }
    };

    const selectCard = (card) => {
      cards.forEach((item) => {
        const isSelected = item === card;
        item.classList.toggle("is-selected", isSelected);
        item.classList.toggle("ring-2", isSelected);
        item.classList.toggle("ring-[#0b4d8c]", isSelected);
        item.setAttribute("aria-pressed", isSelected ? "true" : "false");
      });
    };

    cards.forEach((card) => {
      card.addEventListener("click", () => selectCard(card));
      card.addEventListener("keydown", (event) => {
        if (event.key === "Enter" || event.key === " ") {
          event.preventDefault();
          selectCard(card);
        }
      });
    });

    const firstVisibleCard = [...cards].find((card) => !card.classList.contains("hidden"));
    if (firstVisibleCard) selectCard(firstVisibleCard);

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        tabs.forEach((t) => {
          t.classList.remove("active", "bg-[#072f57]", "text-white", "shadow-sm");
          t.classList.add("text-slate-500");
          t.setAttribute("aria-pressed", "false");
        });

        tab.classList.add("active", "bg-[#072f57]", "text-white", "shadow-sm");
        tab.classList.remove("text-slate-500");
        tab.setAttribute("aria-pressed", "true");

        const selectedType = typeContent[tab.dataset.type];
        if (selectedType && typeTitle) {
          typeTitle.textContent = selectedType.title;
          cards.forEach((card) => {
            const visible = card.dataset.type === tab.dataset.type;
            card.classList.toggle("hidden", !visible);
          });

          const nextVisibleCard = [...cards].find((card) => !card.classList.contains("hidden"));
          if (nextVisibleCard) selectCard(nextVisibleCard);
        }
      });
    });

    if (typeof lucide !== "undefined") {
      lucide.createIcons();
    }
  });
</script>

<style>
  .program-card.is-selected {
    border-color: #0b4d8c !important;
    box-shadow: 0 0 0 2px rgba(11, 77, 140, 0.25), 0 4px 6px -1px rgba(0, 0, 0, 0.1) !important;
  }
</style>
