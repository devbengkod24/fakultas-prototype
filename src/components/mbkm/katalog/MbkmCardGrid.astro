  {
    title: 'Bengkel Koding',
    type: 'internal',
    by: 'Kontributor',
    image: 'https://bengkelkoding.dinus.id/_next/image?url=%2Fimg%2Fabout-us.jpeg&w=3840&q=75',
    desc: 'Program pembelajaran dan pelatihan pemrograman internal dari Fakultas Ilmu Komputer yang dirancang untuk membekali mahasiswa dengan keterampilan praktis di bidang teknologi informasi.',
  },
  {
    title: 'PPKOrmawa',
    type: 'internal',
    by: 'Kontributor',
    image: 'https://ppkormawa.dinus.ac.id/wp-content/uploads/sites/55/2022/10/ppkofkes-627x376.jpg',
    desc: 'Program pengabdian dan pemberdayaan masyarakat oleh mahasiswa untuk membangun desa binaan yang solutif dan berkelanjutan.',
  },

  // MBKM Eksternal
  {
    title: 'Dicoding Asah',
    type: 'eksternal',
    by: 'Admin',
    badge: 'Studi Independen',
    image: 'https://fmipa.unud.ac.id/protected/storage/file_summernote/b037a0e96236da12fd560a72c255353e.03',
    desc: 'Program pelatihan intensif berbasis Studi Independen Bersertifikat Mandiri yang dapat diikuti oleh mahasiswa untuk menguasai pembuatan web modern, pengembangan perangkat lunak, hingga kecerdasan buatan.',
