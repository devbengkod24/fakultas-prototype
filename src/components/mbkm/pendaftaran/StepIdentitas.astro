---
// src/components/mbkm/pendaftaran/StepIdentitas.astro
---

<!-- TAHAP 1: IDENTITAS & DATA STUDI -->
<section id="step-1" class="step-content space-y-6">
  <!-- KELOMPOK 1: IDENTITAS MAHASISWA -->
  <div class="rounded-xl border border-gray-200 bg-white p-5 sm:p-7">
    <div class="border-b border-gray-100 pb-4">
      <h3 class="text-lg font-bold text-gray-900">Identitas Mahasiswa</h3>
      <p class="mt-1 text-sm text-gray-500">Lengkapi data diri mahasiswa.</p>
    </div>

    <!-- Grid 4 Fields: Nama, NIM, Email, No. Telepon -->
    <div class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2">
      <div>
        <label for="student-name" class="mb-2 block text-sm font-semibold text-gray-700">Nama Lengkap</label>
        <input id="student-name" name="studentName" type="text" value="Faisal Rahman" readonly tabindex="-1" aria-readonly="true" class="w-full cursor-not-allowed rounded-lg border border-gray-200 bg-gray-50 px-3.5 py-3 text-sm font-medium text-gray-800 focus:outline-none" />
      </div>

      <div>
        <label for="student-nim" class="mb-2 block text-sm font-semibold text-gray-700">NIM</label>
        <input id="student-nim" name="nim" type="text" value="A11.2022.13901" readonly tabindex="-1" aria-readonly="true" class="w-full cursor-not-allowed rounded-lg border border-gray-200 bg-gray-50 px-3.5 py-3 text-sm font-medium text-gray-800 focus:outline-none" />
      </div>

      <div>
        <label for="student-email" class="mb-2 block text-sm font-semibold text-gray-700">Email Mahasiswa</label>
        <input id="student-email" name="email" type="email" value="111202213901@mhs.dinus.ac.id" readonly tabindex="-1" aria-readonly="true" class="w-full cursor-not-allowed rounded-lg border border-gray-200 bg-gray-50 px-3.5 py-3 text-sm font-medium text-gray-800 focus:outline-none" />
      </div>

      <div>
        <label for="student-phone" class="mb-2 block text-sm font-semibold text-gray-700">Nomor Telepon / WhatsApp</label>
        <input id="student-phone" name="phone" type="tel" inputmode="tel" value="081234567890" placeholder="Contoh: 081234567890" class="w-full rounded-lg border border-gray-300 bg-white px-3.5 py-3 text-sm font-medium text-gray-900 transition focus:border-primary-600 focus:outline-none focus:ring-4 focus:ring-primary-100" />
      </div>
    </div>
  </div>

  <!-- KELOMPOK 2: DATA STUDI -->
  <div class="rounded-xl border border-gray-200 bg-white p-5 sm:p-7">
    <div class="border-b border-gray-100 pb-4">
      <h3 class="text-lg font-bold text-gray-900">Data Studi</h3>
      <p class="mt-1 text-sm text-gray-500">Lengkapi data akademik mahasiswa</p>
    </div>

    <!-- Grid 4 Fields: Program Studi, Semester, IPK, SKS -->
    <div class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2">
      <div>
        <label for="student-study" class="mb-2 block text-sm font-semibold text-gray-700">Program Studi</label>
        <input id="student-study" name="studyProgram" type="text" value="Teknik Informatika - S1" readonly tabindex="-1" aria-readonly="true" class="w-full cursor-not-allowed rounded-lg border border-gray-200 bg-gray-50 px-3.5 py-3 text-sm font-medium text-gray-800 focus:outline-none" />
      </div>

      <div>
        <label for="student-semester" class="mb-2 block text-sm font-semibold text-gray-700">Semester Aktif</label>
        <input id="student-semester" name="semester" type="text" value="Semester 5" readonly tabindex="-1" aria-readonly="true" class="w-full cursor-not-allowed rounded-lg border border-gray-200 bg-gray-50 px-3.5 py-3 text-sm font-medium text-gray-800 focus:outline-none" />
      </div>

      <div>
        <label for="student-ipk" class="mb-2 block text-sm font-semibold text-gray-700">IPK Kumulatif</label>
        <input id="student-ipk" name="ipk" type="text" value="3.68" readonly tabindex="-1" aria-readonly="true" class="w-full cursor-not-allowed rounded-lg border border-gray-200 bg-gray-50 px-3.5 py-3 text-sm font-medium text-gray-800 focus:outline-none" />
      </div>

      <div>
        <label for="student-sks" class="mb-2 block text-sm font-semibold text-gray-700">SKS Tempuh</label>
        <input id="student-sks" name="sks" type="text" value="92 SKS" readonly tabindex="-1" aria-readonly="true" class="w-full cursor-not-allowed rounded-lg border border-gray-200 bg-gray-50 px-3.5 py-3 text-sm font-medium text-gray-800 focus:outline-none" />
      </div>
    </div>
  </div>
</section>
