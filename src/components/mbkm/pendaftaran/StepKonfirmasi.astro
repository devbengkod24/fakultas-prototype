---
// src/components/mbkm/pendaftaran/StepKonfirmasi.astro
---

<!-- TAHAP 3: PERSETUJUAN UMUM PROGRAM -->
<section id="step-3" class="step-content space-y-6">
  <div class="rounded-xl border border-[#e4e4e7] bg-white p-5 sm:p-7 shadow-none">
    <div class="border-b border-[#e4e4e7] pb-4">
      <h3 class="text-lg font-semibold text-[#09090b]">Persetujuan Ketentuan Umum Program</h3>
      <p class="mt-1 text-sm text-[#71717a]">
        Centang seluruh pernyataan berikut untuk mengonfirmasi pengajuan pendaftaran Anda ke mitra.
      </p>
    </div>

    <div class="mt-6 space-y-4">
      <label class="flex items-start gap-3 rounded-lg border border-[#e4e4e7] p-4 cursor-pointer hover:bg-[#fafafa] transition-colors has-[:checked]:border-[#0655a7] has-[:checked]:bg-blue-50/30">
        <input
          id="agree-rights"
          name="agreeRights"
          type="checkbox"
          class="step-checkbox mt-1 h-4 w-4 shrink-0 rounded border-[#e4e4e7] text-[#0655a7] focus:ring-[#0655a7] cursor-pointer"
        />
        <span class="flex-1">
          <span class="block text-sm font-semibold text-[#09090b]">
            Saya menyetujui ketentuan umum program
          </span>
          <span class="mt-1 block text-xs leading-5 text-[#71717a]">
            Saya telah membaca dan memahami hak mahasiswa, aturan seleksi, serta ketentuan pelaksanaan program MBKM fakultas.
          </span>
        </span>
      </label>

      <label class="flex items-start gap-3 rounded-lg border border-[#e4e4e7] p-4 cursor-pointer hover:bg-[#fafafa] transition-colors has-[:checked]:border-[#0655a7] has-[:checked]:bg-blue-50/30">
        <input
          id="agree-obligations"
          name="agreeObligations"
          type="checkbox"
          class="step-checkbox mt-1 h-4 w-4 shrink-0 rounded border-[#e4e4e7] text-[#0655a7] focus:ring-[#0655a7] cursor-pointer"
        />
        <span class="flex-1">
          <span class="block text-sm font-semibold text-[#09090b]">
            Saya bersedia memenuhi kewajiban dan komitmen program
          </span>
          <span class="mt-1 block text-xs leading-5 text-[#71717a]">
            Saya bersedia mengikuti tahapan seleksi, mematuhi peraturan mitra dan kontributor, menjaga etika akademik, serta menyelesaikan laporan kegiatan sesuai ketentuan.
          </span>
        </span>
      </label>

      <label class="flex items-start gap-3 rounded-lg border border-[#e4e4e7] p-4 cursor-pointer hover:bg-[#fafafa] transition-colors has-[:checked]:border-[#0655a7] has-[:checked]:bg-blue-50/30">
        <input
          id="agree-data"
          name="agreeData"
          type="checkbox"
          class="step-checkbox mt-1 h-4 w-4 shrink-0 rounded border-[#e4e4e7] text-[#0655a7] focus:ring-[#0655a7] cursor-pointer"
        />
        <span class="flex-1">
          <span class="block text-sm font-semibold text-[#09090b]">
            Saya menyatakan data dan dokumen yang diberikan adalah benar
          </span>
          <span class="mt-1 block text-xs leading-5 text-[#71717a]">
            Saya memahami bahwa data atau dokumen yang tidak sesuai dapat membatalkan proses verifikasi pengajuan dan status keikutsertaan saya.
          </span>
        </span>
      </label>
    </div>
  </div>
</section>
