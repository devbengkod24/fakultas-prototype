---
// src/components/mbkm/pendaftaran/StepKonfirmasi.astro
---

<!-- TAHAP 3: PERSETUJUAN PROGRAM -->
<section id="step-3" class="step-content space-y-6">
  <div class="rounded-xl border border-gray-200 bg-white p-5 sm:p-7">
    <div class="border-b border-gray-100 pb-4">
      <h3 class="text-lg font-bold text-gray-900">Persetujuan Program</h3>
      <p class="mt-1 text-sm text-gray-500">
        Centang seluruh pernyataan berikut untuk menyelesaikan pengajuan pendaftaran.
      </p>
    </div>

    <div class="mt-6 space-y-4">
      <label class="flex items-start gap-3 rounded-lg border border-gray-200 p-4 cursor-pointer hover:bg-gray-50 has-[:checked]:border-primary-600 has-[:checked]:bg-primary-50">
        <input
          id="agree-rights"
          name="agreeRights"
          type="checkbox"
          class="mt-1 h-5 w-5 shrink-0 rounded border-gray-300 text-primary-600 focus:ring-primary-600"
        />
        <span class="flex-1">
          <span class="block text-sm font-semibold text-gray-900">
            Saya menyetujui ketentuan program
          </span>
          <span class="mt-1 block text-xs leading-5 text-gray-500">
            Saya telah membaca dan memahami hak mahasiswa serta aturan pelaksanaan program.
          </span>
        </span>
      </label>

      <label class="flex items-start gap-3 rounded-lg border border-gray-200 p-4 cursor-pointer hover:bg-gray-50 has-[:checked]:border-primary-600 has-[:checked]:bg-primary-50">
        <input
          id="agree-obligations"
          name="agreeObligations"
          type="checkbox"
          class="mt-1 h-5 w-5 shrink-0 rounded border-gray-300 text-primary-600 focus:ring-primary-600"
        />
        <span class="flex-1">
          <span class="block text-sm font-semibold text-gray-900">
            Saya bersedia memenuhi kewajiban program
          </span>
          <span class="mt-1 block text-xs leading-5 text-gray-500">
            Saya bersedia mengikuti kegiatan, mematuhi peraturan program dan kontributor, menjaga etika, serta menyelesaikan laporan dan luaran sesuai ketentuan.
          </span>
        </span>
      </label>

      <label class="flex items-start gap-3 rounded-lg border border-gray-200 p-4 cursor-pointer hover:bg-gray-50 has-[:checked]:border-primary-600 has-[:checked]:bg-primary-50">
        <input
          id="agree-data"
          name="agreeData"
          type="checkbox"
          class="mt-1 h-5 w-5 shrink-0 rounded border-gray-300 text-primary-600 focus:ring-primary-600"
        />
        <span class="flex-1">
          <span class="block text-sm font-semibold text-gray-900">
            Saya menyatakan data dan dokumen yang diberikan benar
          </span>
          <span class="mt-1 block text-xs leading-5 text-gray-500">
            Saya memahami bahwa data yang tidak sesuai dapat memengaruhi proses verifikasi pengajuan.
          </span>
        </span>
      </label>
    </div>
  </div>
</section>
