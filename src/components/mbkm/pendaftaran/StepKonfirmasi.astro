---
// src/components/mbkm/pendaftaran/StepKonfirmasi.astro
---

<!-- TAHAP 3: PERSETUJUAN UMUM PROGRAM -->
<section id="step-3" class="step-content space-y-6">
  <div class="rounded-2xl border border-slate-200/90 bg-white p-5 sm:p-7 shadow-xs">
    <div class="border-b border-slate-100 pb-4">
      <div class="flex items-center gap-2">
        <div class="h-4 w-1 rounded-full bg-[#f59e0b]"></div>
        <h3 class="text-lg font-extrabold text-[#072f57]">Persetujuan Ketentuan Umum Program</h3>
      </div>
      <p class="mt-1 text-sm text-slate-500">
        Centang seluruh pernyataan berikut untuk mengonfirmasi pengajuan pendaftaran Anda ke mitra.
      </p>
    </div>

    <div class="mt-6 space-y-4">
      <label class="flex items-start gap-3.5 rounded-xl border border-slate-200/90 bg-white p-4.5 cursor-pointer hover:bg-slate-50/80 transition-all has-[:checked]:border-[#0b4d8c] has-[:checked]:bg-blue-50/30 has-[:checked]:shadow-xs">
        <input
          id="agree-rights"
          name="agreeRights"
          type="checkbox"
          class="step-checkbox mt-0.5 h-4.5 w-4.5 shrink-0 rounded-md border-slate-300 text-[#072f57] focus:ring-[#0b4d8c] cursor-pointer accent-[#072f57]"
        />
        <span class="flex-1">
          <span class="block text-sm font-bold text-[#072f57]">
            Saya menyetujui ketentuan umum program
          </span>
          <span class="mt-1 block text-xs leading-relaxed text-slate-600">
            Saya telah membaca dan memahami hak mahasiswa, aturan seleksi, serta ketentuan pelaksanaan program MBKM fakultas.
          </span>
        </span>
      </label>

      <label class="flex items-start gap-3.5 rounded-xl border border-slate-200/90 bg-white p-4.5 cursor-pointer hover:bg-slate-50/80 transition-all has-[:checked]:border-[#0b4d8c] has-[:checked]:bg-blue-50/30 has-[:checked]:shadow-xs">
        <input
          id="agree-obligations"
          name="agreeObligations"
          type="checkbox"
          class="step-checkbox mt-0.5 h-4.5 w-4.5 shrink-0 rounded-md border-slate-300 text-[#072f57] focus:ring-[#0b4d8c] cursor-pointer accent-[#072f57]"
        />
        <span class="flex-1">
          <span class="block text-sm font-bold text-[#072f57]">
            Saya bersedia memenuhi kewajiban dan komitmen program
          </span>
          <span class="mt-1 block text-xs leading-relaxed text-slate-600">
            Saya bersedia mengikuti tahapan seleksi, mematuhi peraturan mitra dan kontributor, menjaga etika akademik, serta menyelesaikan laporan kegiatan sesuai ketentuan.
          </span>
        </span>
      </label>

      <label class="flex items-start gap-3.5 rounded-xl border border-slate-200/90 bg-white p-4.5 cursor-pointer hover:bg-slate-50/80 transition-all has-[:checked]:border-[#0b4d8c] has-[:checked]:bg-blue-50/30 has-[:checked]:shadow-xs">
        <input
          id="agree-data"
          name="agreeData"
          type="checkbox"
          class="step-checkbox mt-0.5 h-4.5 w-4.5 shrink-0 rounded-md border-slate-300 text-[#072f57] focus:ring-[#0b4d8c] cursor-pointer accent-[#072f57]"
        />
        <span class="flex-1">
          <span class="block text-sm font-bold text-[#072f57]">
            Saya menyatakan data dan dokumen yang diberikan adalah benar
          </span>
          <span class="mt-1 block text-xs leading-relaxed text-slate-600">
            Saya memahami bahwa data atau dokumen yang tidak sesuai dapat membatalkan proses verifikasi pengajuan dan status keikutsertaan saya.
          </span>
        </span>
      </label>
    </div>
  </div>
</section>
