---
// src/components/mbkm/pendaftaran/StepDokumen.astro
---

<!-- TAHAP 2: BERKAS & DOKUMEN PENDUKUNG -->
<section id="step-2" class="step-content space-y-6">
  <div class="rounded-2xl border border-slate-200/90 bg-white p-5 sm:p-7 shadow-xs">
    <div class="border-b border-slate-100 pb-4">
      <div class="flex items-center gap-2">
        <div class="h-4 w-1 rounded-full bg-[#f59e0b]"></div>
        <h3 class="text-lg font-extrabold text-[#072f57]">Dokumen Pendaftaran</h3>
      </div>
      <p class="mt-1 text-sm text-slate-500">
        Cantumkan tautan dokumen untuk proses pendaftaran. Pastikan akses tautan diatur ke publik.
      </p>
    </div>

    <!-- Form Berkas Utama -->
    <div class="mt-6 space-y-5">
      <!-- Dokumen 1: CV ATS (PDF) -->
      <div>
        <label for="cv-url" class="mb-2 block text-sm font-semibold text-slate-700">
          CV <span class="text-rose-500">*</span>
        </label>
        <input
          id="cv-url"
          name="cvUrl"
          type="url"
          inputmode="url"
          placeholder="https://drive.google.com/file/d/..."
          class="w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-sm font-medium text-slate-900 transition focus:border-[#0b4d8c] focus:outline-none focus:ring-3 focus:ring-[#0b4d8c]/15"
        />
      </div>

      <!-- Dokumen 2: Portofolio -->
      <div>
        <label for="portfolio-url" class="mb-2 block text-sm font-semibold text-slate-700">
          Portofolio <span class="text-rose-500">*</span>
        </label>
        <input
          id="portfolio-url"
          name="portfolioUrl"
          type="url"
          inputmode="url"
          placeholder="https://github.com/username atau https://behance.net/username"
          class="w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-sm font-medium text-slate-900 transition focus:border-[#0b4d8c] focus:outline-none focus:ring-3 focus:ring-[#0b4d8c]/15"
        />
      </div>

      <!-- Dokumen 3: Sertifikat / Bukti Pengalaman -->
      <div>
        <label for="certificate-url" class="mb-2 block text-sm font-semibold text-slate-700">
          Sertifikat <span class="text-rose-500">*</span>
        </label>
        <input
          id="certificate-url"
          name="certificateUrl"
          type="url"
          inputmode="url"
          placeholder="https://drive.google.com/file/d/..."
          class="w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-sm font-medium text-slate-900 transition focus:border-[#0b4d8c] focus:outline-none focus:ring-3 focus:ring-[#0b4d8c]/15"
        />
      </div>

      <!-- Container untuk Lampiran Tambahan Dinamis (Lampiran 1 s.d. 3) -->
      <div id="additional-attachments" class="hidden space-y-5"></div>

      <!-- Tombol Tambahkan Lampiran -->
      <div>
        <button
          type="button"
          id="add-attachment-btn"
          class="focus-ring inline-flex items-center gap-2 rounded-xl border border-dashed border-slate-300 bg-slate-50 hover:border-[#0b4d8c] hover:bg-blue-50/50 hover:text-[#0b4d8c] px-4 py-2.5 text-sm font-semibold text-slate-700 transition cursor-pointer"
        >
          <i data-lucide="plus" class="w-4 h-4"></i>
          <span>Tambah Lampiran</span>
        </button>
      </div>
    </div>
  </div>
</section>
