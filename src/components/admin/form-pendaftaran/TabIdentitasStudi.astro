---
// src/components/admin/form-pendaftaran/TabIdentitasStudi.astro
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

const defaultFields = [
  { id: 'f-1', name: 'Nama Lengkap', type: 'text', source: 'siakad', required: true },
  { id: 'f-2', name: 'NIM', type: 'text', source: 'siakad', required: true },
  { id: 'f-3', name: 'Email Mahasiswa', type: 'email', source: 'siakad', required: true },
  { id: 'f-4', name: 'Nomor Telepon / WhatsApp', type: 'text', source: 'manual', required: true },
  { id: 'f-5', name: 'Program Studi', type: 'select', source: 'siakad', required: true },
  { id: 'f-6', name: 'Semester Aktif', type: 'number', source: 'siakad', required: true },
  { id: 'f-7', name: 'IPK Kumulatif', type: 'number', source: 'siakad', required: true },
  { id: 'f-8', name: 'SKS Tempuh', type: 'number', source: 'siakad', required: true },
];

const inputTypes = [
  { val: 'text', label: 'Teks Singkat' },
  { val: 'number', label: 'Angka (Number)' },
  { val: 'email', label: 'Email' },
  { val: 'url', label: 'Tautan / URL (Google Drive / Web)' },
  { val: 'textarea', label: 'Teks Panjang (Textarea)' },
  { val: 'select', label: 'Pilihan (Dropdown)' },
];
---

<div class:list={['space-y-6 font-sans', className]}>
  <!-- CARD 1: FORM BUILDER IDENTITAS & DATA STUDI -->
  <div class="rounded-xl border border-gray-200 bg-white p-5 sm:p-7 shadow-xs">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-gray-100 pb-4 gap-3">
      <div>
        <h3 class="text-lg font-bold text-gray-900">
          Formulir Identitas &amp; Data Studi Mahasiswa
        </h3>
        <p class="mt-1 text-sm text-gray-500">
          Kelola daftar kolom masukan yang wajib diisi atau ditarik otomatis pada Tahap 1 formulir pendaftaran.
        </p>
      </div>
      <button
        type="button"
        onclick="tambahFieldIdentitas()"
        class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-[#1063B9] text-white text-xs font-semibold hover:bg-[#0E4F96] transition shadow-2xs shrink-0 cursor-pointer"
      >
        <i data-lucide="plus" class="w-3.5 h-3.5"></i>
        <span>Tambah Form Input</span>
      </button>
    </div>

    <!-- Container Daftar Form Fields Dinamis -->
    <div id="identitas-fields-container" class="mt-6 space-y-4">
      {defaultFields.map((field) => (
        <div class="field-item-card rounded-xl border border-gray-200 bg-white p-5 hover:border-gray-300 transition-all space-y-3.5 shadow-2xs">
          <!-- Top: Question Title (Editable input styled seamlessly as text) & Required indicator -->
          <div class="flex items-center justify-between gap-3">
            <div class="flex-1 flex items-center gap-1.5">
              <input
                type="text"
                value={field.name}
                placeholder="Judul pertanyaan..."
                class="field-name-input text-base font-semibold text-gray-900 bg-transparent border-b border-transparent hover:border-gray-300 focus:border-[#1063B9] focus:outline-none transition-colors px-0 py-0.5 w-full sm:max-w-md"
              />
              <span class:list={['required-asterisk text-rose-500 font-bold text-base select-none', !field.required && 'hidden']}>*</span>
            </div>
          </div>

          <!-- Middle: Question Preview (Google Forms style) -->
          <div class="pt-1 pb-2">
            <div class="w-full sm:max-w-md">
              <p class="field-placeholder-text text-sm text-gray-400 select-none font-normal">
                {field.type === 'number'
                  ? 'Angka (desimal / bulat)'
                  : field.type === 'email'
                  ? 'Teks email (jawaban singkat)'
                  : field.type === 'select'
                  ? 'Opsi pilihan dropdown'
                  : field.type === 'textarea'
                  ? 'Teks jawaban panjang'
                  : 'Teks jawaban singkat'}
              </p>
              <div class="mt-2 w-full border-b border-gray-200"></div>
            </div>
          </div>

          <!-- Bottom: Configuration Toolbar -->
          <div class="flex flex-wrap items-center justify-between border-t border-gray-100 pt-3 gap-3 text-xs">
            <!-- Left: Tipe Inputan Selector -->
            <div class="flex items-center gap-2">
              <span class="text-gray-400 text-xs">Tipe:</span>
              <select
                onchange="updateFieldTypePreview(this)"
                class="rounded-lg border border-gray-200 bg-gray-50/70 px-2.5 py-1.5 text-xs font-medium text-gray-700 hover:bg-white focus:outline-none focus:border-[#1063B9] transition-colors cursor-pointer"
              >
                {inputTypes.map((t) => (
                  <option value={t.val} selected={t.val === field.type}>{t.label}</option>
                ))}
              </select>
            </div>

            <!-- Right: Wajib Diisi & Hapus -->
            <div class="flex items-center gap-4">
              <label class="flex items-center gap-2 text-xs font-medium text-gray-700 cursor-pointer select-none">
                <span>Wajib diisi</span>
                <input
                  type="checkbox"
                  checked={field.required}
                  onchange="toggleAsterisk(this)"
                  class="h-4 w-4 rounded border-gray-300 text-[#1063B9] focus:ring-[#1063B9] cursor-pointer"
                />
              </label>
              <div class="h-4 w-px bg-gray-200"></div>
              <button
                type="button"
                onclick="hapusFieldItem(this)"
                class="p-1.5 rounded-lg text-gray-400 hover:text-rose-600 hover:bg-rose-50 transition cursor-pointer"
                title="Hapus Pertanyaan"
              >
                <i data-lucide="trash-2" class="w-4 h-4"></i>
              </button>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<script is:inline>
  function hapusFieldItem(btn) {
    const card = btn.closest('.field-item-card');
    if (card) card.remove();
  }

  function toggleAsterisk(checkbox) {
    const card = checkbox.closest('.field-item-card');
    if (!card) return;
    const asterisk = card.querySelector('.required-asterisk');
    if (asterisk) {
      if (checkbox.checked) {
        asterisk.classList.remove('hidden');
      } else {
        asterisk.classList.add('hidden');
      }
    }
  }

  function updateFieldTypePreview(select) {
    const card = select.closest('.field-item-card');
    if (!card) return;
    const preview = card.querySelector('.field-placeholder-text');
    if (!preview) return;
    const val = select.value;
    if (val === 'textarea') preview.textContent = 'Teks jawaban panjang';
    else if (val === 'number') preview.textContent = 'Angka (desimal / bulat)';
    else if (val === 'email') preview.textContent = 'Teks email (jawaban singkat)';
    else if (val === 'select') preview.textContent = 'Opsi pilihan dropdown';
    else if (val === 'url') preview.textContent = 'Tautan URL (Google Drive / Web)';
    else preview.textContent = 'Teks jawaban singkat';
  }

  function tambahFieldIdentitas() {
    const container = document.getElementById('identitas-fields-container');
    if (!container) return;

    const newCard = document.createElement('div');
    newCard.className = 'field-item-card rounded-xl border border-gray-200 bg-white p-5 hover:border-gray-300 transition-all space-y-3.5 shadow-2xs';
    newCard.innerHTML = `
      <div class="flex items-center justify-between gap-3">
        <div class="flex-1 flex items-center gap-1.5">
          <input
            type="text"
            placeholder="Judul pertanyaan baru..."
            class="field-name-input text-base font-semibold text-gray-900 bg-transparent border-b border-transparent hover:border-gray-300 focus:border-[#1063B9] focus:outline-none transition-colors px-0 py-0.5 w-full sm:max-w-md"
          />
          <span class="required-asterisk text-rose-500 font-bold text-base select-none">*</span>
        </div>
      </div>

      <div class="pt-1 pb-2">
        <div class="w-full sm:max-w-md">
          <p class="field-placeholder-text text-sm text-gray-400 select-none font-normal">Teks jawaban singkat</p>
          <div class="mt-2 w-full border-b border-gray-200"></div>
        </div>
      </div>

      <div class="flex flex-wrap items-center justify-between border-t border-gray-100 pt-3 gap-3 text-xs">
        <div class="flex items-center gap-2">
          <span class="text-gray-400 text-xs">Tipe:</span>
          <select
            onchange="updateFieldTypePreview(this)"
            class="rounded-lg border border-gray-200 bg-gray-50/70 px-2.5 py-1.5 text-xs font-medium text-gray-700 hover:bg-white focus:outline-none focus:border-[#1063B9] transition-colors cursor-pointer"
          >
            <option value="text" selected>Teks Singkat</option>
            <option value="number">Angka (Number)</option>
            <option value="email">Email</option>
            <option value="url">Tautan / URL (Google Drive / Web)</option>
            <option value="textarea">Teks Panjang (Textarea)</option>
            <option value="select">Pilihan (Dropdown)</option>
          </select>
        </div>

        <div class="flex items-center gap-4">
          <label class="flex items-center gap-2 text-xs font-medium text-gray-700 cursor-pointer select-none">
            <span>Wajib diisi</span>
            <input
              type="checkbox"
              checked
              onchange="toggleAsterisk(this)"
              class="h-4 w-4 rounded border-gray-300 text-[#1063B9] focus:ring-[#1063B9] cursor-pointer"
            />
          </label>
          <div class="h-4 w-px bg-gray-200"></div>
          <button
            type="button"
            onclick="hapusFieldItem(this)"
            class="p-1.5 rounded-lg text-gray-400 hover:text-rose-600 hover:bg-rose-50 transition cursor-pointer"
            title="Hapus Pertanyaan"
          >
            <i data-lucide="trash-2" class="w-4 h-4"></i>
          </button>
        </div>
      </div>
    `;
    container.appendChild(newCard);
    if (window.lucide) window.lucide.createIcons();
    const input = newCard.querySelector('input[type="text"]');
    if (input) input.focus();
  }
</script>
