---
// src/components/admin/form-pendaftaran/TabPersetujuanProgram.astro
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

const defaultAgreements = [
  {
    id: 'agr-1',
    title: 'Persetujuan Ketentuan Program',
    text: 'Saya telah membaca dan memahami hak mahasiswa serta aturan pelaksanaan program.',
    required: true,
  },
  {
    id: 'agr-2',
    title: 'Pemenuhan Kewajiban Program',
    text: 'Saya bersedia mengikuti kegiatan, mematuhi peraturan program dan kontributor, menjaga etika, serta menyelesaikan laporan dan luaran sesuai ketentuan.',
    required: true,
  },
  {
    id: 'agr-3',
    title: 'Kebenaran Data dan Dokumen',
    text: 'Saya menyatakan data dan dokumen yang diberikan benar dan memahami bahwa data yang tidak sesuai dapat memengaruhi proses verifikasi pengajuan.',
    required: true,
  },
];
---

<div class:list={['space-y-6 font-sans', className]}>
  <!-- CARD 1: FORM BUILDER BUTIR PERNYATAAN KOMITMEN -->
  <div class="rounded-xl border border-gray-200 bg-white p-5 sm:p-7 shadow-xs">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-gray-100 pb-4 gap-3">
      <div>
        <h3 class="text-lg font-bold text-gray-900">
          Formulir Butir Pernyataan &amp; Komitmen
        </h3>
        <p class="mt-1 text-sm text-gray-500">
          Kelola klausul persetujuan komitmen yang wajib dicentang pendaftar pada Tahap 3 sebelum mengirim formulir.
        </p>
      </div>
      <button
        type="button"
        onclick="tambahButirPersetujuan()"
        class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-[#1063B9] text-white text-xs font-semibold hover:bg-[#0E4F96] transition shadow-2xs shrink-0 cursor-pointer"
      >
        <i data-lucide="plus" class="w-3.5 h-3.5"></i>
        <span>Tambah Butir Pernyataan</span>
      </button>
    </div>

    <!-- Container Butir Persetujuan Dinamis -->
    <div id="persetujuan-items-container" class="mt-6 space-y-4">
      {defaultAgreements.map((agr) => (
        <div class="agr-item-card rounded-xl border border-gray-200 bg-white p-5 hover:border-gray-300 transition-all space-y-3 shadow-2xs">
          <!-- Top: Klausul Title & Asterisk -->
          <div class="flex items-center justify-between gap-3">
            <div class="flex-1 flex items-center gap-1.5">
              <input
                type="text"
                value={agr.title}
                placeholder="Judul klausul persetujuan..."
                class="agr-title-input text-base font-semibold text-gray-900 bg-transparent border-b border-transparent hover:border-gray-300 focus:border-[#1063B9] focus:outline-none transition-colors px-0 py-0.5 w-full sm:max-w-md"
              />
              <span class:list={['required-asterisk text-rose-500 font-bold text-base select-none', !agr.required && 'hidden']}>*</span>
            </div>
          </div>

          <!-- Middle: Textarea Klausul -->
          <div>
            <textarea
              rows="2"
              placeholder="Isi klausul pernyataan persetujuan pendaftar..."
              class="w-full rounded-lg border border-gray-200 bg-gray-50/50 p-3 text-sm text-gray-700 leading-relaxed transition focus:bg-white focus:border-[#1063B9] focus:outline-none"
            >{agr.text}</textarea>
          </div>

          <!-- Bottom Toolbar -->
          <div class="flex items-center justify-between border-t border-gray-100 pt-3 gap-3 text-xs">
            <span class="text-gray-400 text-xs">Format: Checklist Persetujuan</span>
            <div class="flex items-center gap-4">
              <label class="flex items-center gap-2 text-xs font-medium text-gray-700 cursor-pointer select-none">
                <span>Wajib dicentang</span>
                <input
                  type="checkbox"
                  checked={agr.required}
                  onchange="toggleAgrAsterisk(this)"
                  class="h-4 w-4 rounded border-gray-300 text-[#1063B9] focus:ring-[#1063B9] cursor-pointer"
                />
              </label>
              <div class="h-4 w-px bg-gray-200"></div>
              <button
                type="button"
                onclick="hapusAgrItem(this)"
                class="p-1.5 rounded-lg text-gray-400 hover:text-rose-600 hover:bg-rose-50 transition cursor-pointer"
                title="Hapus Butir Pernyataan"
              >
                <i data-lucide="trash-2" class="w-4 h-4"></i>
              </button>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<script is:inline>
  function hapusAgrItem(btn) {
    const card = btn.closest('.agr-item-card');
    if (card) card.remove();
  }

  function toggleAgrAsterisk(checkbox) {
    const card = checkbox.closest('.agr-item-card');
    if (!card) return;
    const asterisk = card.querySelector('.required-asterisk');
    if (asterisk) {
      if (checkbox.checked) {
        asterisk.classList.remove('hidden');
      } else {
        asterisk.classList.add('hidden');
      }
    }
  }

  function tambahButirPersetujuan() {
    const container = document.getElementById('persetujuan-items-container');
    if (!container) return;

    const count = container.querySelectorAll('.agr-item-card').length + 1;
    const newCard = document.createElement('div');
    newCard.className = 'agr-item-card rounded-xl border border-gray-200 bg-white p-5 hover:border-gray-300 transition-all space-y-3 shadow-2xs';
    newCard.innerHTML = `
      <div class="flex items-center justify-between gap-3">
        <div class="flex-1 flex items-center gap-1.5">
          <input
            type="text"
            placeholder="Judul klausul persetujuan ${count}..."
            class="agr-title-input text-base font-semibold text-gray-900 bg-transparent border-b border-transparent hover:border-gray-300 focus:border-[#1063B9] focus:outline-none transition-colors px-0 py-0.5 w-full sm:max-w-md"
          />
          <span class="required-asterisk text-rose-500 font-bold text-base select-none">*</span>
        </div>
      </div>

      <div>
        <textarea
          rows="2"
          placeholder="Isi klausul pernyataan persetujuan pendaftar..."
          class="w-full rounded-lg border border-gray-200 bg-gray-50/50 p-3 text-sm text-gray-700 leading-relaxed transition focus:bg-white focus:border-[#1063B9] focus:outline-none"
        ></textarea>
      </div>

      <div class="flex items-center justify-between border-t border-gray-100 pt-3 gap-3 text-xs">
        <span class="text-gray-400 text-xs">Format: Checklist Persetujuan</span>
        <div class="flex items-center gap-4">
          <label class="flex items-center gap-2 text-xs font-medium text-gray-700 cursor-pointer select-none">
            <span>Wajib dicentang</span>
            <input
              type="checkbox"
              checked
              onchange="toggleAgrAsterisk(this)"
              class="h-4 w-4 rounded border-gray-300 text-[#1063B9] focus:ring-[#1063B9] cursor-pointer"
            />
          </label>
          <div class="h-4 w-px bg-gray-200"></div>
          <button
            type="button"
            onclick="hapusAgrItem(this)"
            class="p-1.5 rounded-lg text-gray-400 hover:text-rose-600 hover:bg-rose-50 transition cursor-pointer"
            title="Hapus Butir Pernyataan"
          >
            <i data-lucide="trash-2" class="w-4 h-4"></i>
          </button>
        </div>
      </div>
    `;
    container.appendChild(newCard);
    if (window.lucide) window.lucide.createIcons();
    const input = newCard.querySelector('input[type="text"]');
    if (input) input.focus();
  }
</script>
