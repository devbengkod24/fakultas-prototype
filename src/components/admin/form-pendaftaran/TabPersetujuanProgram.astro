---
// src/components/admin/form-pendaftaran/TabPersetujuanProgram.astro
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

const defaultAgreements = [
  {
    id: 'agr-1',
    title: 'Kepatuhan Aturan Program & Kontributor',
    text: 'Saya bersedia mengikuti kegiatan, mematuhi peraturan program dan kontributor, menjaga etika, serta menyelesaikan laporan dan luaran sesuai ketentuan.',
    required: true,
  },
  {
    id: 'agr-2',
    title: 'Kebenaran Seluruh Data & Tautan Berkas',
    text: 'Saya menyatakan seluruh data dan tautan berkas yang saya cantumkan adalah benar dan dapat dipertanggungjawabkan.',
    required: true,
  },
];
---

<div class:list={['space-y-6 font-sans', className]}>
  <!-- CARD 1: FORM BUILDER BUTIR PERNYATAAN KOMITMEN -->
  <div class="rounded-xl border border-gray-200 bg-white p-5 sm:p-7 shadow-xs">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-gray-100 pb-4 gap-3">
      <div>
        <h3 class="text-lg font-bold text-gray-900">
          Formulir Butir Pernyataan &amp; Komitmen
        </h3>
        <p class="mt-1 text-sm text-gray-500">
          Kelola klausul persetujuan komitmen yang wajib dicentang pendaftar pada Tahap 3 sebelum mengirim formulir.
        </p>
      </div>
      <button
        type="button"
        onclick="tambahButirPersetujuan()"
        class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-[#1063B9] text-white text-xs font-semibold hover:bg-[#0E4F96] transition shadow-2xs shrink-0 cursor-pointer"
      >
        <i data-lucide="plus" class="w-3.5 h-3.5"></i>
        <span>Tambah Butir Pernyataan</span>
      </button>
    </div>

    <!-- Container Butir Persetujuan Dinamis -->
    <div id="persetujuan-items-container" class="mt-6 space-y-4">
      {defaultAgreements.map((agr) => (
        <div class="agr-item-row flex flex-col gap-3 p-4 rounded-xl border border-gray-200 bg-gray-50/50 hover:bg-white hover:border-gray-300 transition-all">
          <div class="flex items-center justify-between gap-3">
            <input
              type="text"
              value={agr.title}
              placeholder="Judul klausul persetujuan..."
              class="flex-1 rounded-lg border border-gray-300 bg-white px-3.5 py-2 text-sm font-bold text-gray-900 transition focus:border-primary-600 focus:outline-none focus:ring-4 focus:ring-primary-100"
            />
            <div class="flex items-center gap-3 shrink-0">
              <label class="flex items-center gap-2 text-xs font-semibold text-gray-700 cursor-pointer select-none">
                <input
                  type="checkbox"
                  checked={agr.required}
                  class="h-4 w-4 rounded border-gray-300 text-[#1063B9] focus:ring-[#1063B9]"
                />
                <span>Wajib Dicentang</span>
              </label>
              <button
                type="button"
                onclick="hapusAgrItem(this)"
                class="p-1.5 rounded-lg text-gray-400 hover:text-rose-600 hover:bg-rose-50 transition cursor-pointer"
                title="Hapus Butir Pernyataan"
              >
                <i data-lucide="trash-2" class="w-4 h-4"></i>
              </button>
            </div>
          </div>
          <div>
            <textarea
              rows="2"
              placeholder="Isi klausul pernyataan persetujuan pendaftar..."
              class="w-full rounded-lg border border-gray-300 bg-white p-3 text-sm text-gray-800 leading-relaxed transition focus:border-primary-600 focus:outline-none focus:ring-4 focus:ring-primary-100"
            >{agr.text}</textarea>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- CARD 2: PENGATURAN INTEGRITAS & SUBMIT -->
  <div class="rounded-xl border border-gray-200 bg-white p-5 sm:p-7 shadow-xs">
    <div class="border-b border-gray-100 pb-4">
      <h3 class="text-lg font-bold text-gray-900">
        Pakta Integritas &amp; Validasi Final
      </h3>
      <p class="mt-1 text-sm text-gray-500">
        Regulasi kepatuhan hukum dan penguncian formulir pendaftaran setelah mahasiswa melakukan submit.
      </p>
    </div>

    <div class="mt-6 divide-y divide-gray-100">
      <div class="py-4 flex items-center justify-between gap-4">
        <div>
          <span class="text-sm font-semibold text-gray-900">Wajib Menyetujui Seluruh Klausul Sebelum Submit</span>
          <p class="text-xs text-gray-500 mt-0.5">Tombol submit terkunci hingga seluruh kotak checklist persetujuan dicentang oleh pendaftar.</p>
        </div>
        <button
          type="button"
          onclick="toggleFormSetting('paktaIntegritas')"
          id="toggle-cfg-paktaIntegritas"
          class="relative inline-flex h-6 w-11 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none bg-[#0655a7]"
        >
          <span class="pointer-events-none inline-block h-5 w-5 transform rounded-full bg-white shadow-sm ring-0 transition duration-200 ease-in-out translate-x-5"></span>
        </button>
      </div>

      <div class="py-4 flex items-center justify-between gap-4">
        <div>
          <span class="text-sm font-semibold text-gray-900">Kunci Formulir Pasca-Submit (Anti-Manipulasi)</span>
          <p class="text-xs text-gray-500 mt-0.5">Mencegah perubahan tautan berkas dan data setelah status berkas masuk ke sistem.</p>
        </div>
        <button
          type="button"
          onclick="toggleFormSetting('wajibDrafMk')"
          id="toggle-cfg-wajibDrafMk"
          class="relative inline-flex h-6 w-11 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none bg-[#0655a7]"
        >
          <span class="pointer-events-none inline-block h-5 w-5 transform rounded-full bg-white shadow-sm ring-0 transition duration-200 ease-in-out translate-x-5"></span>
        </button>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  function hapusAgrItem(btn) {
    const row = btn.closest('.agr-item-row');
    if (row) row.remove();
  }

  function tambahButirPersetujuan() {
    const container = document.getElementById('persetujuan-items-container');
    if (!container) return;

    const count = container.querySelectorAll('.agr-item-row').length + 1;
    const newRow = document.createElement('div');
    newRow.className = 'agr-item-row flex flex-col gap-3 p-4 rounded-xl border border-gray-200 bg-gray-50/50 hover:bg-white hover:border-gray-300 transition-all';
    newRow.innerHTML = `
      <div class="flex items-center justify-between gap-3">
        <input
          type="text"
          placeholder="Judul klausul persetujuan ${count}..."
          class="flex-1 rounded-lg border border-gray-300 bg-white px-3.5 py-2 text-sm font-bold text-gray-900 transition focus:border-primary-600 focus:outline-none focus:ring-4 focus:ring-primary-100"
        />
        <div class="flex items-center gap-3 shrink-0">
          <label class="flex items-center gap-2 text-xs font-semibold text-gray-700 cursor-pointer select-none">
            <input
              type="checkbox"
              checked
              class="h-4 w-4 rounded border-gray-300 text-[#1063B9] focus:ring-[#1063B9]"
            />
            <span>Wajib Dicentang</span>
          </label>
          <button
            type="button"
            onclick="hapusAgrItem(this)"
            class="p-1.5 rounded-lg text-gray-400 hover:text-rose-600 hover:bg-rose-50 transition cursor-pointer"
            title="Hapus Butir Pernyataan"
          >
            <i data-lucide="trash-2" class="w-4 h-4"></i>
          </button>
        </div>
      </div>
      <div>
        <textarea
          rows="2"
          placeholder="Isi klausul pernyataan persetujuan pendaftar..."
          class="w-full rounded-lg border border-gray-300 bg-white p-3 text-sm text-gray-800 leading-relaxed transition focus:border-primary-600 focus:outline-none focus:ring-4 focus:ring-primary-100"
        ></textarea>
      </div>
    `;
    container.appendChild(newRow);
    if (window.lucide) window.lucide.createIcons();
  }
</script>
