---
// src/components/admin/form-pendaftaran/TabDokumenPendaftaran.astro
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

const defaultDocs = [
  { id: 'doc-1', name: 'Curriculum Vitae (CV ATS Format PDF)', type: 'url', required: true },
  { id: 'doc-2', name: 'Portofolio Karya & Repositori Proyek', type: 'url', required: true },
  { id: 'doc-3', name: 'Sertifikat / Bukti Pengalaman', type: 'url', required: true },
  { id: 'doc-4', name: 'Surat Pernyataan Komitmen & Izin Wali', type: 'url', required: false },
];

const inputTypes = [
  { val: 'url', label: 'Tautan / URL (Google Drive / Web)' },
  { val: 'file', label: 'Unggah Berkas Langsung (PDF / ZIP)' },
  { val: 'text', label: 'Teks Singkat' },
  { val: 'textarea', label: 'Teks Panjang (Textarea)' },
];
---

<div class:list={['space-y-6 font-sans', className]}>
  <!-- CARD 1: FORM BUILDER DOKUMEN PENDAFTARAN -->
  <div class="rounded-xl border border-gray-200 bg-white p-5 sm:p-7 shadow-xs">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-gray-100 pb-4 gap-3">
      <div>
        <h3 class="text-lg font-bold text-gray-900">
          Formulir Dokumen Pendaftaran
        </h3>
        <p class="mt-1 text-sm text-gray-500">
          Kelola daftar dokumen dan berkas yang harus diunggah mahasiswa pada Tahap 2 formulir pendaftaran.
        </p>
      </div>
      <button
        type="button"
        onclick="tambahFieldDokumen()"
        class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-[#1063B9] text-white text-xs font-semibold hover:bg-[#0E4F96] transition shadow-2xs shrink-0 cursor-pointer"
      >
        <i data-lucide="plus" class="w-3.5 h-3.5"></i>
        <span>Tambah Dokumen Input</span>
      </button>
    </div>

    <!-- Container Daftar Dokumen Dinamis -->
    <div id="dokumen-fields-container" class="mt-6 space-y-4">
      {defaultDocs.map((doc) => (
        <div class="doc-item-row flex flex-col sm:flex-row sm:items-center gap-4 p-4 rounded-xl border border-gray-200 bg-gray-50/50 hover:bg-white hover:border-gray-300 transition-all">
          <!-- Input Nama Dokumen -->
          <div class="flex-1 min-w-0">
            <label class="mb-1.5 block text-xs font-semibold text-gray-700">Nama Dokumen / Berkas</label>
            <input
              type="text"
              value={doc.name}
              placeholder="Contoh: Curriculum Vitae (CV ATS)"
              class="w-full rounded-lg border border-gray-300 bg-white px-3.5 py-2.5 text-sm font-medium text-gray-900 transition focus:border-primary-600 focus:outline-none focus:ring-4 focus:ring-primary-100"
            />
          </div>

          <!-- Select Tipe Inputan -->
          <div class="w-full sm:w-64 shrink-0">
            <label class="mb-1.5 block text-xs font-semibold text-gray-700">Tipe Inputan</label>
            <select
              class="w-full rounded-lg border border-gray-300 bg-white px-3.5 py-2.5 text-sm font-medium text-gray-900 transition focus:border-primary-600 focus:outline-none focus:ring-4 focus:ring-primary-100"
            >
              {inputTypes.map((t) => (
                <option value={t.val} selected={t.val === doc.type}>{t.label}</option>
              ))}
            </select>
          </div>

          <!-- Wajib Diisi Checkbox -->
          <div class="flex items-center gap-2 pt-2 sm:pt-5 shrink-0">
            <label class="flex items-center gap-2 text-xs font-semibold text-gray-700 cursor-pointer select-none">
              <input
                type="checkbox"
                checked={doc.required}
                class="h-4 w-4 rounded border-gray-300 text-[#1063B9] focus:ring-[#1063B9]"
              />
              <span>Wajib Diisi</span>
            </label>
          </div>

          <!-- Tombol Hapus -->
          <div class="pt-2 sm:pt-5 shrink-0 flex justify-end">
            <button
              type="button"
              onclick="hapusDocItem(this)"
              class="p-2 rounded-lg text-gray-400 hover:text-rose-600 hover:bg-rose-50 transition cursor-pointer"
              title="Hapus Dokumen Input"
            >
              <i data-lucide="trash-2" class="w-4 h-4"></i>
            </button>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- CARD 2: PENGATURAN LAMPIRAN DINAMIS -->
  <div class="rounded-xl border border-gray-200 bg-white p-5 sm:p-7 shadow-xs">
    <div class="border-b border-gray-100 pb-4">
      <h3 class="text-lg font-bold text-gray-900">
        Pengaturan Lampiran Tambahan Dinamis
      </h3>
      <p class="mt-1 text-sm text-gray-500">
        Konfigurasi batas maksimal slot "Tambahkan Lampiran" pada formulir pendaftaran mahasiswa.
      </p>
    </div>

    <div class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2">
      <div>
        <label for="cfg-max-attachments" class="mb-2 block text-sm font-semibold text-gray-700">
          Maksimal Jumlah Lampiran Tambahan <span class="text-rose-500">*</span>
        </label>
        <input
          type="number"
          id="cfg-max-attachments"
          value="3"
          min="1"
          max="5"
          class="w-full rounded-lg border border-gray-300 bg-white px-3.5 py-3 text-sm font-medium text-gray-900 transition focus:border-primary-600 focus:outline-none focus:ring-4 focus:ring-primary-100"
        />
      </div>

      <div>
        <label for="cfg-attachment-format" class="mb-2 block text-sm font-semibold text-gray-700">
          Format Masukan Tautan <span class="text-rose-500">*</span>
        </label>
        <input
          type="text"
          id="cfg-attachment-format"
          value="Tautan Google Drive / Cloud Publik (URL)"
          readonly
          class="w-full rounded-lg border border-gray-200 bg-gray-50 px-3.5 py-3 text-sm font-medium text-gray-700 focus:outline-none"
        />
      </div>
    </div>
  </div>
</div>

<script is:inline>
  function hapusDocItem(btn) {
    const row = btn.closest('.doc-item-row');
    if (row) row.remove();
  }

  function tambahFieldDokumen() {
    const container = document.getElementById('dokumen-fields-container');
    if (!container) return;

    const newRow = document.createElement('div');
    newRow.className = 'doc-item-row flex flex-col sm:flex-row sm:items-center gap-4 p-4 rounded-xl border border-gray-200 bg-gray-50/50 hover:bg-white hover:border-gray-300 transition-all';
    newRow.innerHTML = `
      <div class="flex-1 min-w-0">
        <label class="mb-1.5 block text-xs font-semibold text-gray-700">Nama Dokumen / Berkas</label>
        <input
          type="text"
          placeholder="Nama dokumen baru..."
          class="w-full rounded-lg border border-gray-300 bg-white px-3.5 py-2.5 text-sm font-medium text-gray-900 transition focus:border-primary-600 focus:outline-none focus:ring-4 focus:ring-primary-100"
        />
      </div>
      <div class="w-full sm:w-64 shrink-0">
        <label class="mb-1.5 block text-xs font-semibold text-gray-700">Tipe Inputan</label>
        <select
          class="w-full rounded-lg border border-gray-300 bg-white px-3.5 py-2.5 text-sm font-medium text-gray-900 transition focus:border-primary-600 focus:outline-none focus:ring-4 focus:ring-primary-100"
        >
          <option value="url" selected>Tautan / URL (Google Drive / Web)</option>
          <option value="file">Unggah Berkas Langsung (PDF / ZIP)</option>
          <option value="text">Teks Singkat</option>
          <option value="textarea">Teks Panjang (Textarea)</option>
        </select>
      </div>
      <div class="flex items-center gap-2 pt-2 sm:pt-5 shrink-0">
        <label class="flex items-center gap-2 text-xs font-semibold text-gray-700 cursor-pointer select-none">
          <input
            type="checkbox"
            checked
            class="h-4 w-4 rounded border-gray-300 text-[#1063B9] focus:ring-[#1063B9]"
          />
          <span>Wajib Diisi</span>
        </label>
      </div>
      <div class="pt-2 sm:pt-5 shrink-0 flex justify-end">
        <button
          type="button"
          onclick="hapusDocItem(this)"
          class="p-2 rounded-lg text-gray-400 hover:text-rose-600 hover:bg-rose-50 transition cursor-pointer"
          title="Hapus Dokumen Input"
        >
          <i data-lucide="trash-2" class="w-4 h-4"></i>
        </button>
      </div>
    `;
    container.appendChild(newRow);
    if (window.lucide) window.lucide.createIcons();
  }
</script>
