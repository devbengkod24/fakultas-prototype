---
// src/components/admin/form-pendaftaran/TabDokumenPendaftaran.astro
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

const defaultDocs = [
  { id: 'doc-1', name: 'Curriculum Vitae (CV ATS Format PDF)', type: 'url', required: true },
  { id: 'doc-2', name: 'Portofolio Karya & Repositori Proyek', type: 'url', required: true },
  { id: 'doc-3', name: 'Sertifikat / Bukti Pengalaman', type: 'url', required: true },
];

const inputTypes = [
  { val: 'url', label: 'Tautan / URL (Google Drive / Web)' },
  { val: 'file', label: 'Unggah Berkas Langsung (PDF / ZIP)' },
  { val: 'text', label: 'Teks Singkat' },
  { val: 'textarea', label: 'Teks Panjang (Textarea)' },
];
---

<div class:list={['space-y-6 font-sans', className]}>
  <!-- CARD 1: FORM BUILDER DOKUMEN PENDAFTARAN -->
  <div class="rounded-xl border border-gray-200 bg-white p-5 sm:p-7 shadow-xs">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-gray-100 pb-4 gap-3">
      <div>
        <h3 class="text-lg font-bold text-gray-900">
          Formulir Dokumen Pendaftaran
        </h3>
        <p class="mt-1 text-sm text-gray-500">
          Kelola daftar dokumen dan berkas yang harus diunggah mahasiswa pada Tahap 2 formulir pendaftaran.
        </p>
      </div>
      <button
        type="button"
        onclick="tambahFieldDokumen()"
        class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-[#1063B9] text-white text-xs font-semibold hover:bg-[#0E4F96] transition shadow-2xs shrink-0 cursor-pointer"
      >
        <i data-lucide="plus" class="w-3.5 h-3.5"></i>
        <span>Tambah Dokumen Input</span>
      </button>
    </div>

    <!-- Container Daftar Dokumen Dinamis -->
    <div id="dokumen-fields-container" class="mt-6 space-y-4">
      {defaultDocs.map((doc) => (
        <div class="doc-item-card rounded-xl border border-gray-200 bg-white p-5 hover:border-gray-300 transition-all space-y-3.5 shadow-2xs">
          <!-- Top: Document Title & Required indicator -->
          <div class="flex items-center justify-between gap-3">
            <div class="flex-1 flex items-center gap-1.5">
              <input
                type="text"
                value={doc.name}
                placeholder="Nama dokumen / berkas..."
                class="doc-name-input text-base font-semibold text-gray-900 bg-transparent border-b border-transparent hover:border-gray-300 focus:border-[#1063B9] focus:outline-none transition-colors px-0 py-0.5 w-full sm:max-w-md"
              />
              <span class:list={['required-asterisk text-rose-500 font-bold text-base select-none', !doc.required && 'hidden']}>*</span>
            </div>
          </div>

          <!-- Middle: Document Preview (Google Forms style) -->
          <div class="pt-1 pb-2">
            <div class="w-full sm:max-w-md">
              <p class="doc-placeholder-text text-sm text-gray-400 select-none font-normal">
                {doc.type === 'file'
                  ? 'Unggah berkas (PDF / ZIP maks. 10MB)'
                  : doc.type === 'textarea'
                  ? 'Teks jawaban panjang'
                  : doc.type === 'text'
                  ? 'Teks jawaban singkat'
                  : 'Tautan URL (Google Drive / Web publik)'}
              </p>
              <div class="mt-2 w-full border-b border-gray-200"></div>
            </div>
          </div>

          <!-- Bottom: Configuration Toolbar -->
          <div class="flex flex-wrap items-center justify-between border-t border-gray-100 pt-3 gap-3 text-xs">
            <!-- Left: Tipe Inputan Selector -->
            <div class="flex items-center gap-2">
              <span class="text-gray-400 text-xs">Format:</span>
              <select
                onchange="updateDocTypePreview(this)"
                class="rounded-lg border border-gray-200 bg-gray-50/70 px-2.5 py-1.5 text-xs font-medium text-gray-700 hover:bg-white focus:outline-none focus:border-[#1063B9] transition-colors cursor-pointer"
              >
                {inputTypes.map((t) => (
                  <option value={t.val} selected={t.val === doc.type}>{t.label}</option>
                ))}
              </select>
            </div>

            <!-- Right: Wajib Diisi & Hapus -->
            <div class="flex items-center gap-4">
              <label class="flex items-center gap-2 text-xs font-medium text-gray-700 cursor-pointer select-none">
                <span>Wajib diisi</span>
                <input
                  type="checkbox"
                  checked={doc.required}
                  onchange="toggleDocAsterisk(this)"
                  class="h-4 w-4 rounded border-gray-300 text-[#1063B9] focus:ring-[#1063B9] cursor-pointer"
                />
              </label>
              <div class="h-4 w-px bg-gray-200"></div>
              <button
                type="button"
                onclick="hapusDocItem(this)"
                class="p-1.5 rounded-lg text-gray-400 hover:text-rose-600 hover:bg-rose-50 transition cursor-pointer"
                title="Hapus Dokumen"
              >
                <i data-lucide="trash-2" class="w-4 h-4"></i>
              </button>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<script is:inline>
  function hapusDocItem(btn) {
    const card = btn.closest('.doc-item-card');
    if (card) card.remove();
  }

  function toggleDocAsterisk(checkbox) {
    const card = checkbox.closest('.doc-item-card');
    if (!card) return;
    const asterisk = card.querySelector('.required-asterisk');
    if (asterisk) {
      if (checkbox.checked) {
        asterisk.classList.remove('hidden');
      } else {
        asterisk.classList.add('hidden');
      }
    }
  }

  function updateDocTypePreview(select) {
    const card = select.closest('.doc-item-card');
    if (!card) return;
    const preview = card.querySelector('.doc-placeholder-text');
    if (!preview) return;
    const val = select.value;
    if (val === 'file') preview.textContent = 'Unggah berkas (PDF / ZIP maks. 10MB)';
    else if (val === 'textarea') preview.textContent = 'Teks jawaban panjang';
    else if (val === 'text') preview.textContent = 'Teks jawaban singkat';
    else preview.textContent = 'Tautan URL (Google Drive / Web publik)';
  }

  function tambahFieldDokumen() {
    const container = document.getElementById('dokumen-fields-container');
    if (!container) return;

    const newCard = document.createElement('div');
    newCard.className = 'doc-item-card rounded-xl border border-gray-200 bg-white p-5 hover:border-gray-300 transition-all space-y-3.5 shadow-2xs';
    newCard.innerHTML = `
      <div class="flex items-center justify-between gap-3">
        <div class="flex-1 flex items-center gap-1.5">
          <input
            type="text"
            placeholder="Nama dokumen baru..."
            class="doc-name-input text-base font-semibold text-gray-900 bg-transparent border-b border-transparent hover:border-gray-300 focus:border-[#1063B9] focus:outline-none transition-colors px-0 py-0.5 w-full sm:max-w-md"
          />
          <span class="required-asterisk text-rose-500 font-bold text-base select-none">*</span>
        </div>
      </div>

      <div class="pt-1 pb-2">
        <div class="w-full sm:max-w-md">
          <p class="doc-placeholder-text text-sm text-gray-400 select-none font-normal">Tautan URL (Google Drive / Web publik)</p>
          <div class="mt-2 w-full border-b border-gray-200"></div>
        </div>
      </div>

      <div class="flex flex-wrap items-center justify-between border-t border-gray-100 pt-3 gap-3 text-xs">
        <div class="flex items-center gap-2">
          <span class="text-gray-400 text-xs">Format:</span>
          <select
            onchange="updateDocTypePreview(this)"
            class="rounded-lg border border-gray-200 bg-gray-50/70 px-2.5 py-1.5 text-xs font-medium text-gray-700 hover:bg-white focus:outline-none focus:border-[#1063B9] transition-colors cursor-pointer"
          >
            <option value="url" selected>Tautan / URL (Google Drive / Web)</option>
            <option value="file">Unggah Berkas Langsung (PDF / ZIP)</option>
            <option value="text">Teks Singkat</option>
            <option value="textarea">Teks Panjang (Textarea)</option>
          </select>
        </div>

        <div class="flex items-center gap-4">
          <label class="flex items-center gap-2 text-xs font-medium text-gray-700 cursor-pointer select-none">
            <span>Wajib diisi</span>
            <input
              type="checkbox"
              checked
              onchange="toggleDocAsterisk(this)"
              class="h-4 w-4 rounded border-gray-300 text-[#1063B9] focus:ring-[#1063B9] cursor-pointer"
            />
          </label>
          <div class="h-4 w-px bg-gray-200"></div>
          <button
            type="button"
            onclick="hapusDocItem(this)"
            class="p-1.5 rounded-lg text-gray-400 hover:text-rose-600 hover:bg-rose-50 transition cursor-pointer"
            title="Hapus Dokumen"
          >
            <i data-lucide="trash-2" class="w-4 h-4"></i>
          </button>
        </div>
      </div>
    `;
    container.appendChild(newCard);
    if (window.lucide) window.lucide.createIcons();
    const input = newCard.querySelector('input[type="text"]');
    if (input) input.focus();
  }
</script>
