---
// Modals component containing all 21 modal dialogs from mbkm-v2 admin
---

    <!-- ================================================== -->
    <!-- MODALS UNTUK BAGIAN 2 [Issue #18]                 -->
    <!-- ================================================== -->

    <!-- 1. Modal Buat / Edit Pengumuman (Sesuai Dialog Pengumuman fakultas-fe) -->
    <div id="modal-buat-pengumuman" class="fixed inset-0 z-50 bg-black/50 flex items-center justify-center hidden p-4">
      <div class="bg-white rounded-lg border border-[#e4e4e7] shadow-lg max-w-lg w-full p-6 space-y-4 text-sm">
        <div class="flex items-center justify-between pb-3 border-b border-[#e4e4e7]">
          <h3 id="modal-pengumuman-title" class="text-lg font-semibold text-[#09090b]">Tambah Pengumuman</h3>
          <button type="button" onclick="closeBuatPengumumanModal()" class="text-[#71717a] hover:text-[#09090b] p-1 rounded-md">
            <i data-lucide="x" class="w-4 h-4"></i>
          </button>
        </div>
        <form onsubmit="handleSavePengumuman(event)" class="space-y-4">
          <input type="hidden" id="modal-pengumuman-id" value="" />
          <div class="space-y-1.5">
            <label class="font-medium text-[#09090b] text-sm">Judul Pengumuman *</label>
            <input
              type="text"
              id="modal-pengumuman-judul"
              required
              placeholder="Masukkan judul pengumuman..."
              class="h-9 w-full rounded-md border border-[#e4e4e7] bg-white px-3 text-sm focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
            />
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div class="space-y-1.5">
              <label class="font-medium text-[#09090b] text-sm">Sasaran Penerima *</label>
              <select
                id="modal-pengumuman-sasaran"
                class="h-9 w-full rounded-md border border-[#e4e4e7] bg-white px-3 text-sm focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
              >
                <option value="semua_mhs">Semua Mahasiswa MBKM</option>
                <option value="mitra_dpl">Mitra & DPL</option>
                <option value="magang">Peserta Magang Industri</option>
                <option value="studi_independen">Peserta Studi Independen</option>
              </select>
            </div>
            <div class="space-y-1.5">
              <label class="font-medium text-[#09090b] text-sm">Status Publikasi *</label>
              <select
                id="modal-pengumuman-status"
                class="h-9 w-full rounded-md border border-[#e4e4e7] bg-white px-3 text-sm focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
              >
                <option value="published">Dipublikasikan</option>
                <option value="draft">Draf</option>
                <option value="archived">Diarsipkan</option>
              </select>
            </div>
          </div>
          <div class="space-y-1.5">
            <label class="font-medium text-[#09090b] text-sm">Isi Pengumuman *</label>
            <textarea
              id="modal-pengumuman-isi"
              rows="4"
              required
              placeholder="Tuliskan isi pengumuman..."
              class="w-full rounded-md border border-[#e4e4e7] bg-white p-3 text-sm focus:outline-none focus:ring-1 focus:ring-[#0655a7] leading-relaxed"
            ></textarea>
          </div>
          <div class="space-y-1.5">
            <label class="font-medium text-[#09090b] text-sm">Lampiran Dokumen (Opsional)</label>
            <input
              type="text"
              id="modal-pengumuman-file"
              placeholder="Nama file lampiran atau URL..."
              class="h-9 w-full rounded-md border border-[#e4e4e7] bg-white px-3 text-sm focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
            />
          </div>
          <div class="flex items-center justify-end gap-2 pt-4 border-t border-[#e4e4e7]">
            <button
              type="button"
              onclick="closeBuatPengumumanModal()"
              class="inline-flex items-center justify-center h-9 px-4 text-sm font-medium rounded-md border border-[#e4e4e7] bg-white hover:bg-[#f4f4f5] text-[#09090b] transition-colors"
            >
              Batal
            </button>
            <button
              type="submit"
              class="inline-flex items-center justify-center gap-2 h-9 px-4 text-sm font-medium rounded-md bg-[#0655a7] hover:bg-[#0655a7]/90 text-white transition-colors"
            >
              Simpan
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- 2. Modal Hapus Pengumuman -->
    <div id="modal-delete-pengumuman" class="fixed inset-0 z-50 bg-black/50 flex items-center justify-center hidden p-4">
      <div class="bg-white rounded-lg border border-[#e4e4e7] shadow-lg max-w-sm w-full p-6 space-y-4 text-sm">
        <div class="space-y-1">
          <h3 class="text-lg font-semibold text-[#09090b]">Konfirmasi Hapus</h3>
          <p id="modal-delete-pengumuman-text" class="text-sm text-[#71717a] leading-relaxed">
            Apakah Anda yakin ingin menghapus pengumuman ini? Tindakan ini tidak dapat dibatalkan.
          </p>
        </div>
        <div class="flex items-center justify-end gap-2 pt-4 border-t border-[#e4e4e7]">
          <button
            type="button"
            onclick="closeDeletePengumumanModal()"
            class="inline-flex items-center justify-center h-9 px-4 text-sm font-medium rounded-md border border-[#e4e4e7] bg-white hover:bg-[#f4f4f5] text-[#09090b] transition-colors"
          >
            Batal
          </button>
          <button
            type="button"
            id="btn-confirm-delete-pengumuman"
            class="inline-flex items-center justify-center h-9 px-4 text-sm font-medium rounded-md bg-red-600 hover:bg-red-700 text-white transition-colors"
          >
            Hapus
          </button>
        </div>
      </div>
    </div>

    <!-- 1b. Modal Detail Pengumuman (Sesuai PengumumanDetailView di fakultas-fe) -->
    <div id="modal-detail-pengumuman" class="fixed inset-0 z-50 bg-black/50 flex items-center justify-center hidden p-4">
      <div class="bg-white rounded-lg border border-[#e4e4e7] shadow-lg max-w-2xl w-full p-6 space-y-4 text-sm max-h-[90vh] overflow-y-auto">
        <div class="flex items-start justify-between pb-3 border-b border-[#e4e4e7] gap-3">
          <div>
            <span id="detail-pengumuman-badge-pinned" class="hidden inline-flex items-center gap-1 rounded-md border border-blue-200 bg-blue-50 px-2 py-0.5 text-xs font-semibold text-[#0655a7] mb-1.5">
              <i data-lucide="pin" class="w-3 h-3"></i> Disematkan
            </span>
            <h3 id="detail-pengumuman-judul" class="text-lg sm:text-xl font-semibold text-[#09090b] leading-snug"></h3>
          </div>
          <button type="button" onclick="closeDetailPengumumanModal()" class="text-[#71717a] hover:text-[#09090b] p-1 rounded-md shrink-0">
            <i data-lucide="x" class="w-4 h-4"></i>
          </button>
        </div>

        <div class="flex flex-wrap items-center gap-2 text-xs text-[#71717a] pb-2 border-b border-[#f4f4f5]">
          <div class="flex items-center gap-1.5">
            <i data-lucide="user" class="h-3.5 w-3.5 text-[#71717a]"></i>
            <span id="detail-pengumuman-author" class="font-medium"></span>
          </div>
          <span class="text-gray-300">|</span>
          <div class="flex items-center gap-1.5">
            <i data-lucide="calendar" class="h-3.5 w-3.5 text-[#71717a]"></i>
            <span id="detail-pengumuman-tgl"></span>
          </div>
          <span class="text-gray-300">|</span>
          <div class="flex items-center gap-1.5">
            <i data-lucide="clock" class="h-3.5 w-3.5 text-[#71717a]"></i>
            <span id="detail-pengumuman-jam"></span>
          </div>
          <span class="text-gray-300">|</span>
          <span id="detail-pengumuman-status"></span>
          <span id="detail-pengumuman-sasaran" class="inline-flex items-center rounded-md border border-[#e4e4e7] bg-[#fafafa] px-2 py-0.5 text-xs font-medium text-[#71717a]"></span>
        </div>

        <div class="py-2">
          <p id="detail-pengumuman-isi" class="text-sm text-[#09090b] leading-relaxed whitespace-pre-line"></p>
        </div>

        <div id="detail-pengumuman-file-wrapper" class="pt-2">
          <div class="p-3 rounded-lg border border-[#e4e4e7] bg-[#fafafa] flex items-center justify-between gap-3">
            <div class="flex items-center gap-2.5 min-w-0">
              <div class="h-9 w-9 rounded-md bg-blue-50 border border-blue-200 flex items-center justify-center shrink-0">
                <i data-lucide="file-text" class="w-4 h-4 text-[#0655a7]"></i>
              </div>
              <div class="min-w-0">
                <p id="detail-pengumuman-file-name" class="text-xs font-semibold text-[#09090b] truncate"></p>
                <p class="text-[11px] text-[#71717a]">Lampiran Resmi MBKM</p>
              </div>
            </div>
            <button
              type="button"
              id="detail-pengumuman-download-btn"
              class="inline-flex items-center justify-center gap-1.5 h-8 px-3 text-xs font-medium rounded-md bg-[#0655a7] hover:bg-[#0655a7]/90 text-white shrink-0 transition-colors"
            >
              <i data-lucide="download" class="w-3.5 h-3.5"></i>
              <span>Unduh</span>
            </button>
          </div>
        </div>

        <div class="flex items-center justify-between pt-4 border-t border-[#e4e4e7]">
          <button
            type="button"
            id="detail-pengumuman-edit-btn"
            class="inline-flex items-center justify-center gap-1.5 h-9 px-3.5 text-sm font-medium rounded-md border border-[#e4e4e7] bg-white hover:bg-[#f4f4f5] text-[#09090b] transition-colors"
          >
            <i data-lucide="pencil" class="w-3.5 h-3.5"></i>
            <span>Edit Pengumuman</span>
          </button>
          <button
            type="button"
            onclick="closeDetailPengumumanModal()"
            class="inline-flex items-center justify-center h-9 px-4 text-sm font-medium rounded-md bg-[#0655a7] hover:bg-[#0655a7]/90 text-white transition-colors"
          >
            Tutup
          </button>
        </div>
      </div>
    </div>

    <!-- 3. Modal Tambah Kontributor (YAGNI & Clean Shadcn UI) -->
    <div id="modal-tambah-mitra" class="fixed inset-0 z-50 bg-black/50 flex items-center justify-center hidden p-4">
      <div class="bg-white rounded-lg border border-[#e4e4e7] shadow-lg max-w-md w-full p-6 space-y-4 text-sm">
        <!-- Dialog Header -->
        <div class="flex items-start justify-between">
          <div>
            <h3 id="modal-mitra-title" class="text-lg font-semibold text-[#09090b]">Tambah Kontributor</h3>
            <p id="modal-mitra-subtitle" class="text-sm text-[#71717a] mt-0.5">Tambahkan kontributor baru untuk program MBKM.</p>
          </div>
          <button type="button" onclick="closeTambahMitraModal()" class="text-[#71717a] hover:text-[#09090b] p-1 rounded-md -mt-1 cursor-pointer">
            <i data-lucide="x" class="w-4 h-4"></i>
          </button>
        </div>

        <!-- FORM INTERNAL: Nama Kontributor, Penanggung Jawab, Email Akun, Password, Deskripsi -->
        <div id="modal-form-mitra-internal" class="space-y-3 pt-1">
          <div class="space-y-1.5">
            <label class="font-medium text-[#09090b] text-sm">Nama Kontributor <span class="text-red-500">*</span></label>
            <input
              type="text"
              id="modal-internal-nama"
              placeholder="Contoh: PT Bengkel Koding Nusantara"
              class="h-9 w-full rounded-md border border-[#e4e4e7] bg-white px-3 text-sm focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
            />
          </div>
          <div class="space-y-1.5">
            <label class="font-medium text-[#09090b] text-sm">Nama Penanggung Jawab <span class="text-red-500">*</span></label>
            <input
              type="text"
              id="modal-internal-pic-nama"
              placeholder="Contoh: Dimas Wicaksono, M.T."
              class="h-9 w-full rounded-md border border-[#e4e4e7] bg-white px-3 text-sm focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
            />
          </div>
          <div class="space-y-1.5">
            <label class="font-medium text-[#09090b] text-sm">Email Akun <span class="text-red-500">*</span></label>
            <input
              type="email"
              id="modal-internal-pic-email"
              placeholder="dimas@bengkod.id"
              class="h-9 w-full rounded-md border border-[#e4e4e7] bg-white px-3 text-sm focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
            />
          </div>
          <div class="space-y-1.5">
            <label class="font-medium text-[#09090b] text-sm">Password Akun <span class="text-red-500">*</span></label>
            <input
              type="password"
              id="modal-internal-password"
              placeholder="Masukkan password akun kontributor..."
              class="h-9 w-full rounded-md border border-[#e4e4e7] bg-white px-3 text-sm focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
            />
          </div>
          <div class="space-y-1.5">
            <label class="font-medium text-[#09090b] text-sm">Deskripsi</label>
            <textarea
              id="modal-internal-deskripsi"
              rows="2"
              placeholder="Deskripsi singkat profil kontributor..."
              class="w-full rounded-md border border-[#e4e4e7] bg-white p-2.5 text-sm focus:outline-none focus:ring-1 focus:ring-[#0655a7] leading-relaxed"
            ></textarea>
          </div>
        </div>

        <!-- FORM EKSTERNAL: Nama Kontributor / Instansi, Penanggung Jawab, Deskripsi (Tanpa Email Akun & Password) -->
        <div id="modal-form-mitra-eksternal" class="space-y-3 pt-1 hidden">
          <div class="space-y-1.5">
            <label class="font-medium text-[#09090b] text-sm">Nama Kontributor / Instansi <span class="text-red-500">*</span></label>
            <input
              type="text"
              id="modal-eksternal-nama"
              placeholder="Contoh: PT Telekomunikasi Selular (Telkomsel)"
              class="h-9 w-full rounded-md border border-[#e4e4e7] bg-white px-3 text-sm focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
            />
          </div>
          <div class="space-y-1.5">
            <label class="font-medium text-[#09090b] text-sm">Nama Penanggung Jawab</label>
            <input
              type="text"
              id="modal-eksternal-pic-nama"
              placeholder="Contoh: Budi Santoso, M.Kom"
              class="h-9 w-full rounded-md border border-[#e4e4e7] bg-white px-3 text-sm focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
            />
          </div>
          <div class="space-y-1.5">
            <label class="font-medium text-[#09090b] text-sm">Deskripsi</label>
            <textarea
              id="modal-eksternal-deskripsi"
              rows="2"
              placeholder="Deskripsi singkat profil instansi..."
              class="w-full rounded-md border border-[#e4e4e7] bg-white p-2.5 text-sm focus:outline-none focus:ring-1 focus:ring-[#0655a7] leading-relaxed"
            ></textarea>
          </div>
        </div>

        <!-- Dialog Footer -->
        <div class="flex items-center justify-end gap-2 pt-3 border-t border-[#e4e4e7]">
          <button
            type="button"
            onclick="closeTambahMitraModal()"
            class="inline-flex items-center justify-center h-9 px-4 text-sm font-medium rounded-md border border-[#e4e4e7] bg-white hover:bg-[#f4f4f5] text-[#09090b] transition-colors"
          >
            Batal
          </button>
          <button
            type="button"
            onclick="handleSubmitTambahMitra()"
            class="inline-flex items-center justify-center gap-2 h-9 px-4 text-sm font-medium rounded-md bg-[#0655a7] hover:bg-[#0655a7]/90 text-white transition-colors"
          >
            Tambah
          </button>
        </div>
      </div>
    </div>

    <!-- 3b. Modal Tambah / Edit Proyek Showcase Mahasiswa -->
    <div id="modal-showcase-proyek" class="fixed inset-0 z-50 bg-black/50 flex items-center justify-center hidden p-4">
      <div class="bg-white rounded-lg border border-[#e4e4e7] shadow-lg max-w-lg w-full p-6 space-y-4 text-sm max-h-[90vh] overflow-y-auto">
        <div class="flex items-center justify-between pb-1 border-b border-[#e4e4e7]">
          <div>
            <h3 id="modal-showcase-title" class="text-lg font-semibold text-[#09090b]">Tambah Proyek Showcase</h3>
            <p class="text-xs text-[#71717a] mt-0.5">Pamerkan karya capstone project mahasiswa untuk halaman publik program.</p>
          </div>
          <button type="button" onclick="closeShowcaseModal()" class="text-[#71717a] hover:text-[#09090b] p-1 rounded-md">
            <i data-lucide="x" class="w-4 h-4"></i>
          </button>
        </div>

        <form onsubmit="handleSaveShowcase(event)" class="space-y-3.5">
          <input type="hidden" id="modal-showcase-idx" value="" />
          <div class="grid grid-cols-2 gap-3">
            <div class="space-y-1.5">
              <label class="font-medium text-[#09090b] text-xs">ID Proyek *</label>
              <input
                type="text"
                id="modal-showcase-id"
                required
                placeholder="PRJ-2026-04"
                class="h-9 w-full rounded-md border border-[#e4e4e7] bg-white px-3 text-sm focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
              />
            </div>
            <div class="space-y-1.5">
              <label class="font-medium text-[#09090b] text-xs">Batch MBKM *</label>
              <input
                type="text"
                id="modal-showcase-batch"
                required
                placeholder="Capstone Project Batch 6"
                class="h-9 w-full rounded-md border border-[#e4e4e7] bg-white px-3 text-sm focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
              />
            </div>
          </div>

          <div class="space-y-1.5">
            <label class="font-medium text-[#09090b] text-xs">Judul Proyek *</label>
            <input
              type="text"
              id="modal-showcase-judul"
              required
              placeholder="Contoh: Smart Energy & Air Quality Monitoring Campus FIK"
              class="h-9 w-full rounded-md border border-[#e4e4e7] bg-white px-3 text-sm focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
            />
          </div>

          <div class="space-y-1.5">
            <label class="font-medium text-[#09090b] text-xs">Kategori / Topik Utama *</label>
            <input
              type="text"
              id="modal-showcase-kategori"
              required
              placeholder="Contoh: IoT & Machine Learning"
              class="h-9 w-full rounded-md border border-[#e4e4e7] bg-white px-3 text-sm focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
            />
          </div>

          <div class="space-y-1.5">
            <label class="font-medium text-[#09090b] text-xs">Deskripsi Ringkas Hasil Karya *</label>
            <textarea
              id="modal-showcase-deskripsi"
              rows="3"
              required
              placeholder="Jelaskan inovasi sistem, dataset, atau integrasi sensor yang dibuat mahasiswa..."
              class="w-full rounded-md border border-[#e4e4e7] bg-white p-2.5 text-sm focus:outline-none focus:ring-1 focus:ring-[#0655a7] leading-relaxed"
            ></textarea>
          </div>

          <div class="space-y-1.5">
            <label class="font-medium text-[#09090b] text-xs">Teknologi / Tech Stack (Pisahkan dengan koma) *</label>
            <input
              type="text"
              id="modal-showcase-tech"
              required
              placeholder="Python, TensorFlow, React.js, Google Cloud"
              class="h-9 w-full rounded-md border border-[#e4e4e7] bg-white px-3 text-sm focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
            />
          </div>

          <div class="flex items-center justify-end gap-2 pt-3 border-t border-[#e4e4e7]">
            <button
              type="button"
              onclick="closeShowcaseModal()"
              class="inline-flex items-center justify-center h-9 px-4 text-sm font-medium rounded-md border border-[#e4e4e7] bg-white hover:bg-[#f4f4f5] text-[#09090b] transition-colors"
            >
              Batal
            </button>
            <button
              type="submit"
              class="inline-flex items-center justify-center gap-2 h-9 px-4 text-sm font-medium rounded-md bg-[#0655a7] hover:bg-[#0655a7]/90 text-white transition-colors"
            >
              Simpan Proyek
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- 4. Modal Detail Pelamar & Final Approval -->
    <div id="modal-detail-pelamar" class="fixed inset-0 z-50 bg-black/50 flex items-center justify-center hidden p-4">
      <div class="bg-white rounded-lg border border-[#e4e4e7] shadow-lg max-w-lg w-full p-6 space-y-4 text-sm">
        <div class="flex items-center justify-between pb-3 border-b border-[#e4e4e7]">
          <h3 class="text-lg font-semibold text-[#09090b]">Final Approval Pelamar Mitra</h3>
          <button type="button" onclick="closePelamarDetailModal()" class="text-[#71717a] hover:text-[#09090b] p-1 rounded-md">
            <i data-lucide="x" class="w-4 h-4"></i>
          </button>
        </div>
        <div class="space-y-4">
          <!-- Profil Mahasiswa -->
          <div class="flex items-center justify-between p-3.5 rounded-lg border border-[#e4e4e7] bg-[#fafafa]">
            <div class="flex items-center gap-3">
              <div id="modal-pelamar-avatar" class="h-9 w-9 rounded-full bg-muted text-[#71717a] font-medium text-xs flex items-center justify-center shrink-0">
                MHS
              </div>
              <div>
                <div id="modal-pelamar-nama" class="font-medium text-[#09090b] text-sm">-</div>
                <div id="modal-pelamar-meta" class="text-xs text-[#71717a]">-</div>
              </div>
            </div>
            <div id="modal-pelamar-status-badge">
              <span class="inline-flex items-center rounded-md border border-yellow-200 bg-yellow-50 px-2 py-0.5 text-xs font-semibold text-yellow-800">Menunggu</span>
            </div>
          </div>

          <!-- Rincian Mitra & Formasi -->
          <div class="grid grid-cols-2 gap-3 p-3.5 rounded-lg border border-[#e4e4e7]">
            <div>
              <span class="text-xs text-[#71717a]">Mitra Penempatan</span>
              <div id="modal-pelamar-mitra" class="font-medium text-[#09090b] text-sm mt-0.5">-</div>
            </div>
            <div>
              <span class="text-xs text-[#71717a]">Posisi / Formasi</span>
              <div id="modal-pelamar-posisi" class="font-medium text-[#09090b] text-sm mt-0.5">-</div>
            </div>
          </div>

          <!-- Hasil Rekomendasi Mitra -->
          <div class="p-3.5 rounded-lg border border-[#e4e4e7] bg-[#fafafa] space-y-1">
            <div class="flex items-center justify-between">
