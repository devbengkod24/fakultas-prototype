        <form onsubmit="handleSaveKuotaIndividual(event)" class="flex flex-col gap-3">
          <div class="p-2.5 bg-blue-50/70 border border-blue-100 rounded-lg text-[11px] text-[#0655a7]">
            <span class="font-semibold">Mahasiswa Terpakai Saat Ini:</span>
            <span id="modal-edit-dosen-terpakai" class="font-bold">6 Mahasiswa</span>
          </div>
          <div class="flex flex-col gap-1.5">
            <label class="font-medium text-[#3f3f46]">Batas Maksimal Kuota *</label>
            <input
              type="number"
              id="input-kuota-individual"
