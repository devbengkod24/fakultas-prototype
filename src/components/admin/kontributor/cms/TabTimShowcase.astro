---
interface Props {
  id?: string;
  class?: string;
}
const { id = "form-tab-content-tim-showcase", class: className = "" } = Astro.props;

const defaultShowcase = [
  {
    id: "PRJ-01",
    judul: "Smart Campus IoT Energy & Air Quality Monitoring",
    mahasiswa: "Ahmad Fauzi & Tim",
    batch: "Batch 5 (Gasal 2025/2026)",
    kategori: "IoT & AI",
    screenshot: "https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&fit=crop&w=600&q=80",
    tags: ["IoT Sensor", "TensorFlow", "React"],
    demoUrl: "https://demo.fik.udinus.ac.id/smart-campus",
  },
  {
    id: "PRJ-02",
    judul: "Platform E-Commerce Inklusif UMKM Ramah Disabilitas",
    mahasiswa: "Nadia Putri & Tim",
    batch: "Batch 6 (Genap 2025/2026)",
    kategori: "Web Platform",
    screenshot: "https://images.unsplash.com/photo-1555949963-aa79dcee981c?auto=format&fit=crop&w=600&q=80",
    tags: ["Next.js", "Tailwind", "Go REST API"],
    demoUrl: "https://demo.fik.udinus.ac.id/umkm-inklusif",
  },
];
---

<div id={id} class:list={["space-y-6", className]}>
  <!-- CARD: SHOWCASE HASIL KARYA MAHASISWA -->
  <div class="rounded-xl border border-gray-200 bg-white p-5 sm:p-7 shadow-xs">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-gray-100 pb-4 gap-3">
      <div>
        <h3 class="text-lg font-bold text-gray-900">
          Showcase Hasil Karya Mahasiswa
        </h3>
        <p class="mt-1 text-sm text-gray-500">
          Daftar proyek unggulan karya mahasiswa alumni program untuk tampilan 3D carousel.
        </p>
      </div>
      <button
        type="button"
        id="btn-tambah-showcase"
        onclick="openShowcaseModal && openShowcaseModal()"
        class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-[#1063B9] text-white text-xs font-semibold hover:bg-[#0E4F96] transition shadow-2xs shrink-0 cursor-pointer"
      >
        <i data-lucide="plus" class="w-3.5 h-3.5"></i>
        <span>Tambah Proyek Showcase</span>
      </button>
    </div>

    <div id="cms-showcase-grid" class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-5">
      {defaultShowcase.map((item) => (
        <div class="flex flex-col overflow-hidden rounded-xl border border-gray-200 bg-white shadow-2xs hover:shadow-md transition-all">
          <div class="relative h-44 w-full bg-gray-100 overflow-hidden">
            <img src={item.screenshot} alt={item.judul} class="h-full w-full object-cover" />
            <span class="absolute top-3 left-3 px-2.5 py-1 rounded-md bg-black/60 backdrop-blur-xs text-white text-xs font-semibold">
              {item.kategori}
            </span>
          </div>
          <div class="p-5 flex-1 flex flex-col justify-between">
            <div>
              <p class="text-xs font-medium text-gray-500">{item.batch}</p>
              <h4 class="mt-1 text-base font-bold text-gray-900 line-clamp-1">{item.judul}</h4>
              <p class="text-xs text-gray-600 mt-1">Oleh: <span class="font-medium">{item.mahasiswa}</span></p>

              <div class="mt-3 flex flex-wrap gap-1.5">
                {item.tags.map((tag) => (
                  <span class="px-2 py-0.5 rounded-md bg-gray-100 text-gray-600 text-[11px] font-medium">
                    {tag}
                  </span>
                ))}
              </div>
            </div>

            <div class="mt-5 pt-3.5 border-t border-gray-100 flex items-center justify-between">
              <a href={item.demoUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-xs font-semibold text-[#1063B9] hover:underline">
                <span>Lihat Live Demo</span>
                <i data-lucide="external-link" class="w-3 h-3"></i>
              </a>
              <div class="flex items-center gap-1">
                <button type="button" class="p-1.5 rounded-md text-gray-400 hover:text-gray-700 hover:bg-gray-100 transition" title="Edit">
                  <i data-lucide="pencil" class="w-3.5 h-3.5"></i>
                </button>
                <button type="button" class="p-1.5 rounded-md text-gray-400 hover:text-rose-600 hover:bg-rose-50 transition" title="Hapus">
                  <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                </button>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>
