---
// src/components/admin/kontributor/cms/TabProfilHero.astro
import TabbarDetailSection from './TabbarDetailSection.astro';
---

<div class="space-y-6">
  <!-- KELOMPOK 1: PROFIL & HERO PROGRAM -->
  <div class="rounded-xl border border-gray-200 bg-white p-5 sm:p-7 shadow-xs">
    <!-- Header Card -->
    <div class="border-b border-gray-100 pb-4">
      <h3 class="text-lg font-bold text-gray-900">
        Profil &amp; Hero Program
      </h3>
      <p class="mt-1 text-sm text-gray-500">
        Pengaturan identitas judul dan banner visual hero pada halaman detail program.
      </p>
    </div>

    <!-- Form Fields -->
    <div class="mt-6 space-y-5">
      <!-- Judul Program -->
      <div>
        <label for="hero-judul" class="mb-2 block text-sm font-semibold text-gray-700">
          Nama / Judul Program <span class="text-rose-500">*</span>
        </label>
        <input
          type="text"
          id="hero-judul"
          value="Dicoding ASAH 2026 (Akselerasi Talenta AI & Software Engineering)"
          class="w-full rounded-lg border border-gray-300 bg-white px-3.5 py-3 text-sm font-medium text-gray-900 transition focus:border-primary-600 focus:outline-none focus:ring-4 focus:ring-primary-100"
        />
      </div>

      <!-- URL Banner Background Hero -->
      <div>
        <label for="hero-banner-url" class="mb-2 block text-sm font-semibold text-gray-700">
          URL Foto / Banner Background Hero
        </label>
        <div class="flex items-center gap-3">
          <input
            type="text"
            id="hero-banner-url"
            value="https://images.unsplash.com/photo-1521737711867-e3b97375f902?auto=format&fit=crop&w=2000&q=85"
            oninput="document.getElementById('preview-hero-banner').src = this.value"
            class="flex-1 rounded-lg border border-gray-300 bg-white px-3.5 py-3 text-sm font-medium text-gray-900 transition focus:border-primary-600 focus:outline-none focus:ring-4 focus:ring-primary-100"
          />
          <div class="h-11 w-20 shrink-0 overflow-hidden rounded-lg border border-gray-200 bg-gray-50 shadow-2xs">
            <img
              id="preview-hero-banner"
              src="https://images.unsplash.com/photo-1521737711867-e3b97375f902?auto=format&fit=crop&w=2000&q=85"
              alt="Preview Banner"
              class="h-full w-full object-cover"
            />
          </div>
        </div>
      </div>

      <!-- Deskripsi Pembuka Hero -->
      <div>
        <label for="hero-deskripsi" class="mb-2 block text-sm font-semibold text-gray-700">
          Deskripsi Pembuka Hero <span class="text-rose-500">*</span>
        </label>
        <textarea
          id="hero-deskripsi"
          rows="3"
          class="w-full rounded-lg border border-gray-300 bg-white px-3.5 py-3 text-sm font-medium text-gray-900 leading-relaxed transition focus:border-primary-600 focus:outline-none focus:ring-4 focus:ring-primary-100"
        >Program Dicoding ASAH (Akselerasi Talenta AI & Software Engineering) merupakan program MBKM FIK UDINUS yang dirancang untuk membekali mahasiswa dengan keahlian industri tingkat lanjut di bidang Machine Learning, Full-Stack Engineering, dan Cloud Infrastructure.</textarea>
      </div>
    </div>
  </div>

  <!-- KELOMPOK 2: TENTANG PROGRAM -->
  <div class="rounded-xl border border-gray-200 bg-white p-5 sm:p-7 shadow-xs">
    <!-- Header Card -->
    <div class="border-b border-gray-100 pb-4">
      <h3 class="text-lg font-bold text-gray-900">
        Tentang Program
      </h3>
      <p class="mt-1 text-sm text-gray-500">
        Narasi lengkap silabus capaian pembelajaran dan dokumentasi visual kegiatan.
      </p>
    </div>

    <!-- Form Fields -->
    <div class="mt-6 space-y-5">
      <!-- Foto Dokumentasi Kegiatan -->
      <div>
        <label for="tentang-foto-url" class="mb-2 block text-sm font-semibold text-gray-700">
          Foto Dokumentasi Kegiatan
        </label>
        <div class="flex items-center gap-3">
          <input
            type="text"
            id="tentang-foto-url"
            value="/assets/images/DicodingAsah.jpg"
            oninput="document.getElementById('preview-tentang-foto').src = this.value"
            class="flex-1 rounded-lg border border-gray-300 bg-white px-3.5 py-3 text-sm font-medium text-gray-900 transition focus:border-primary-600 focus:outline-none focus:ring-4 focus:ring-primary-100"
          />
          <div class="h-11 w-20 shrink-0 overflow-hidden rounded-lg border border-gray-200 bg-gray-50 shadow-2xs">
            <img
              id="preview-tentang-foto"
              src="/assets/images/DicodingAsah.jpg"
              alt="Preview Foto Kegiatan"
              class="h-full w-full object-cover"
            />
          </div>
        </div>
      </div>

      <!-- Narasi Lengkap Program -->
      <div>
        <label for="tentang-narasi" class="mb-2 block text-sm font-semibold text-gray-700">
          Narasi Lengkap Program &amp; Capaian Belajar <span class="text-rose-500">*</span>
        </label>
        <textarea
          id="tentang-narasi"
          rows="4"
          class="w-full rounded-lg border border-gray-300 bg-white px-3.5 py-3 text-sm font-medium text-gray-900 leading-relaxed transition focus:border-primary-600 focus:outline-none focus:ring-4 focus:ring-primary-100"
        >Dicoding ASAH (Accelerated Skills & Artificial Intelligence Hub) 2026 merupakan program MBKM yang dirancang khusus untuk mempersiapkan mahasiswa menjadi talenta digital andal yang siap bersaing di industri global. Melalui kombinasi kurikulum internasional, bimbingan mentor industri, dan pengerjaan Capstone Project nyata, peserta mencapai penguasaan teknologi mutakhir dan kesiapan karir optimal.</textarea>
      </div>
    </div>
  </div>

  <!-- KELOMPOK 3: 3 TABBAR DETAIL (INFORMASI, PERSYARATAN, KONTRIBUTOR) -->
  <TabbarDetailSection />
</div>
