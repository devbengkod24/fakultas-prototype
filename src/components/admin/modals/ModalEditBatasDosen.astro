    <!-- Modal 4: Edit Kuota Individual Dosen -->
    <div id="modal-edit-batas-dosen" class="fixed inset-0 z-50 flex items-center justify-center hidden p-4 bg-black/40">
      <div
        class="bg-white rounded-2xl max-w-sm w-full p-5 shadow-2xl border border-[#e4e4e7] flex flex-col gap-3 text-xs animate-in fade-in zoom-in-95 duration-150"
      >
        <div class="flex items-center justify-between pb-2 border-b border-[#e4e4e7]">
          <div>
            <h3 class="text-sm font-bold text-[#09090b]">Sesuaikan Kuota Dosen</h3>
            <p id="modal-edit-dosen-subtitle" class="text-[11px] text-[#71717a]">Dr. M. Arief Soeleman</p>
          </div>
          <button type="button" onclick="closeModalEditBatasDosen()" class="text-[#71717a] hover:text-[#09090b]">
            <i data-lucide="x" class="w-4 h-4"></i>
          </button>
        </div>
        <form onsubmit="handleSaveKuotaIndividual(event)" class="flex flex-col gap-3">
          <div class="p-2.5 bg-blue-50/70 border border-blue-100 rounded-lg text-[11px] text-[#0655a7]">
            <span class="font-semibold">Mahasiswa Terpakai Saat Ini:</span>
            <span id="modal-edit-dosen-terpakai" class="font-bold">6 Mahasiswa</span>
          </div>
          <div class="flex flex-col gap-1.5">
            <label class="font-medium text-[#3f3f46]">Batas Maksimal Kuota *</label>
            <input
              type="number"
              id="input-kuota-individual"
              required
              min="1"
              max="25"
              value="8"
              class="px-3 py-2 rounded-lg border border-[#e4e4e7] focus:ring-1 focus:ring-[#0655a7] focus:outline-none"
            />
          </div>
          <div class="flex items-center justify-end gap-2 pt-2 border-t border-[#e4e4e7]">
            <button
              type="button"
              onclick="closeModalEditBatasDosen()"
              class="px-3 py-1.5 rounded-lg border border-[#e4e4e7] text-[#3f3f46] hover:bg-gray-50 font-medium"
            >
              Batal
            </button>
            <button
              type="submit"
              class="px-4 py-1.5 rounded-lg bg-[#0655a7] hover:bg-[#114d91] text-white font-semibold"
            >
              Simpan Perubahan
            </button>
          </div>
        </form>
      </div>
    </div>
