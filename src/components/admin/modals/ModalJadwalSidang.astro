      >
        <div class="flex items-center justify-between pb-2 border-b border-[#e4e4e7]">
          <div>
            <h3 class="text-sm font-bold text-[#09090b]">Jadwalkan Sidang Evaluasi MBKM</h3>
            <p class="text-[11px] text-[#71717a]">Jadwal kontinu/berkala per mahasiswa yang siap diuji.</p>
          </div>
          <button type="button" onclick="closeModalJadwalSidang()" class="text-[#71717a] hover:text-[#09090b]">
            <i data-lucide="x" class="w-4 h-4"></i>
          </button>
        </div>
        <form onsubmit="handleSaveJadwalSidang(event)" class="flex flex-col gap-3">
          <div class="flex flex-col gap-1.5">
            <label class="font-medium text-[#3f3f46]">Mahasiswa Peserta *</label>
            <select
              required
              class="px-3 py-2 rounded-lg border border-[#e4e4e7] bg-white focus:ring-1 focus:ring-[#0655a7] focus:outline-none"
            >
              <option value="">-- Pilih Mahasiswa Siap Sidang --</option>
              <option value="A11.2022.13901">A11.2022.13901 - Faisal Rahman (Bengkel Koding)</option>
              <option value="A12.2022.09842">A12.2022.09842 - Nabila Zahra Putri (Ryuje Tech)</option>
              <option value="A14.2022.05123">A14.2022.05123 - Dimas Anggara (Dicoding)</option>
            </select>
          </div>
          <div class="grid grid-cols-2 gap-2">
            <div class="flex flex-col gap-1.5">
              <label class="font-medium text-[#3f3f46]">Tanggal Sidang *</label>
              <input
                type="date"
                required
                value="2025-07-20"
                class="px-3 py-2 rounded-lg border border-[#e4e4e7] focus:ring-1 focus:ring-[#0655a7] focus:outline-none"
              />
            </div>
            <div class="flex flex-col gap-1.5">
              <label class="font-medium text-[#3f3f46]">Jam Sidang *</label>
              <input
                type="time"
                required
                value="09:00"
                class="px-3 py-2 rounded-lg border border-[#e4e4e7] focus:ring-1 focus:ring-[#0655a7] focus:outline-none"
              />
            </div>
          </div>
          <div class="flex flex-col gap-1.5">
            <label class="font-medium text-[#3f3f46]">Dosen Penguji Pendamping *</label>
            <select
              required
              class="px-3 py-2 rounded-lg border border-[#e4e4e7] bg-white focus:ring-1 focus:ring-[#0655a7] focus:outline-none"
            >
              <option value="affandy">Affandy, Ph.D</option>
              <option value="atika">Christy Atika Sari, M.Kom</option>
              <option value="eko">Eko Hari Rachmawanto, M.Kom</option>
            </select>
          </div>
          <div class="flex flex-col gap-1.5">
            <label class="font-medium text-[#3f3f46]">Ruangan / Tautan GMeet *</label>
            <input
              type="text"
              required
              placeholder="Contoh: Ruang H.5.2 atau link meet.google.com/..."
              value="Ruang H.5.2 (Hybrid)"
              class="px-3 py-2 rounded-lg border border-[#e4e4e7] focus:ring-1 focus:ring-[#0655a7] focus:outline-none"
            />
          </div>
          <div class="flex items-center justify-end gap-2 pt-2 border-t border-[#e4e4e7]">
            <button
              type="button"
              onclick="closeModalJadwalSidang()"
              class="px-3 py-1.5 rounded-lg border border-[#e4e4e7] text-[#3f3f46] hover:bg-gray-50 font-medium"
            >
              Batal
            </button>
            <button
              type="submit"
              class="px-4 py-1.5 rounded-lg bg-[#0655a7] hover:bg-[#114d91] text-white font-semibold"
            >
              Simpan Jadwal
            </button>
          </div>
        </form>
      </div>
    </div>

