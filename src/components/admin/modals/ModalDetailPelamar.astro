    <!-- ==================================================== -->
    <!-- 4. RIGHT SIDE DRAWER: DETAIL & EVALUASI WAWANCARA    -->
    <!-- 2 Navtab Internal: Semua Dokumen & Penilaian Wawancara-->
    <!-- ==================================================== -->
    <div id="modal-detail-pelamar" class="fixed inset-0 z-50 hidden overflow-hidden" aria-labelledby="slide-over-title" role="dialog" aria-modal="true">
      <!-- Backdrop Gelap -->
      <div
        id="drawer-backdrop-pelamar"
        onclick="closePelamarDetailModal()"
        class="fixed inset-0 transition-opacity cursor-pointer bg-black/50 backdrop-blur-xs"
      ></div>

      <!-- Slide-over Drawer Container -->
      <div class="fixed inset-y-0 right-0 flex max-w-full pl-10">
        <div class="w-screen max-w-lg md:max-w-xl bg-white border-l border-[#E2E8F0] shadow-2xl flex flex-col h-full transform transition ease-in-out duration-300">

          <!-- DRAWER HEADER: Judul & Close Button -->
          <div class="p-4 sm:p-5 border-b border-[#E2E8F0] bg-white flex items-center justify-between shrink-0">
            <div>
              <h3 id="slide-over-title" class="text-base font-semibold text-[#0F172A]">Review Berkas Pelamar</h3>
              <p class="text-xs text-[#64748B]">Verifikasi berkas persyaratan dan penjadwalan sesi wawancara</p>
            </div>
            <button
              type="button"
              onclick="closePelamarDetailModal()"
              class="text-[#64748B] hover:text-[#0F172A] hover:bg-slate-100 p-2 rounded-lg transition-colors cursor-pointer"
              title="Tutup Panel"
            >
              <i data-lucide="x" class="w-5 h-5"></i>
            </button>
          </div>

          <!-- PROFIL RINGKAS PELAMAR (Flat Typography Tanpa Card) -->
          <div class="px-5 py-3 border-b border-[#E2E8F0] bg-[#F8FAFC] shrink-0 space-y-2">
            <!-- Baris 1: Avatar, Identitas Utama, dan Mitra + Pilihan -->
            <div class="flex items-center justify-between gap-3">
              <div class="flex items-center min-w-0 gap-3">
                <div id="modal-pelamar-avatar" class="h-10 w-10 rounded-full bg-white border border-[#E2E8F0] text-[#1E40AF] font-bold text-xs flex items-center justify-center shrink-0 shadow-2xs overflow-hidden">
                  MHS
                </div>
                <div class="min-w-0">
                  <div class="flex items-center gap-2">
                    <span id="modal-pelamar-nama" class="font-bold text-[#0F172A] text-sm truncate">-</span>
                  </div>
                  <div id="modal-pelamar-meta" class="text-xs text-[#64748B] mt-0.5 truncate">
                    -
                  </div>
                </div>
              </div>

              <!-- Mitra Target Evaluasi & Pilihan Prioritas -->
              <div class="flex flex-col items-end shrink-0 text-right gap-1">
                <div>
                  <span class="text-[10px] font-semibold text-[#64748B] uppercase tracking-wider block">MITRA</span>
                  <span id="modal-pelamar-kontributor" class="text-xs font-bold text-[#1E40AF] max-w-[160px] truncate block" title="">-</span>
                </div>
                <span id="modal-pelamar-single-prioritas-badge" class="px-2 py-0.5 rounded text-[10px] font-semibold bg-blue-50 text-[#1E40AF] border border-blue-200">
                  Pilihan 1
                </span>
              </div>
            </div>

            <!-- Baris 2: Data Akademik Flat Inline (Bullet Separated) -->
            <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1 text-xs text-[#475569] pt-0.5">
              <span class="inline-flex items-center gap-1 font-semibold text-[#0F172A]">
                <span class="text-[#64748B] font-normal">IPK</span>
                <span id="modal-pelamar-ipk" class="text-[#1E40AF] font-bold">-</span>
              </span>
              <span class="text-[#CBD5E1]">•</span>
              <span class="inline-flex items-center gap-1">
                <span class="text-[#64748B]">SKS Lulus:</span>
                <span id="modal-pelamar-sks" class="font-semibold text-[#0F172A]">-</span>
              </span>
              <span class="text-[#CBD5E1]">•</span>
              <span class="inline-flex items-center gap-1">
                <span class="text-[#64748B]">Semester:</span>
                <span id="modal-pelamar-semester" class="font-semibold text-[#0F172A]">-</span>
              </span>
            </div>
          </div>

          <!-- INTERNAL NAVTAB: 2 Tab Navigation (Dokumen & Atur Jadwal) -->
          <div class="px-5 border-b border-[#E2E8F0] bg-white shrink-0">
            <div class="flex items-center gap-6">
              <button
                type="button"
                id="drawer-tab-btn-dokumen"
                onclick="switchDrawerDetailTab('dokumen')"
                class="flex items-center gap-2 py-2 text-xs font-semibold border-b-2 border-[#1E40AF] text-[#1E40AF] transition-colors cursor-pointer"
              >
                <i data-lucide="file-text" class="w-4 h-4"></i>
                <span>Dokumen</span>
              </button>
              <button
                type="button"
                id="drawer-tab-btn-jadwal"
                onclick="switchDrawerDetailTab('jadwal')"
                class="flex items-center gap-2 py-2 text-xs font-medium border-b-2 border-transparent text-[#64748B] hover:text-[#0F172A] transition-colors cursor-pointer"
              >
                <i data-lucide="calendar" class="w-4 h-4"></i>
                <span>Atur Jadwal</span>
              </button>
            </div>
          </div>

          <!-- DRAWER BODY CONTENT (Scrollable Area) -->
          <div class="flex-1 px-5 pt-3 pb-5 space-y-3 overflow-y-auto text-sm">

            <!-- PANEL TAB 1: DOKUMEN & VERIFIKASI AKADEMIK -->
            <div id="drawer-panel-dokumen" class="space-y-3.5">

              <!-- Daftar Dokumen Lengkap (List Interaktif) -->
              <div class="space-y-2">
                <!-- Kontainer Dinamis Link Dokumen -->
                <div id="drawer-dokumen-list" class="space-y-2">
                  <!-- Di-render via populateDrawerDokumenList() -->
                </div>
              </div>

              <!-- Pratinjau Transkrip Nilai SIADIN Trigger (Gaya Seragam dengan Item Berkas) -->
              <div class="flex items-center justify-between p-3 rounded-lg border border-[#E2E8F0] bg-white hover:bg-slate-50/80 transition-colors">
                <div class="flex items-center gap-2.5 min-w-0">
                  <div class="w-8 h-8 rounded-md bg-emerald-50 text-emerald-600 border border-emerald-200 flex items-center justify-center shrink-0">
                    <i data-lucide="graduation-cap" class="w-4 h-4"></i>
                  </div>
                  <div class="min-w-0">
                    <span class="text-xs font-semibold text-[#0F172A] block truncate">Transkrip Akademik SIADIN</span>
                  </div>
                </div>
                <button
                  type="button"
                  id="btn-drawer-lihat-transkrip"
                  onclick="triggerTranskripFromDetailModal()"
                  class="h-7 px-2.5 rounded border border-[#E2E8F0] bg-white hover:bg-slate-100 text-[#0F172A] text-xs font-medium inline-flex items-center gap-1.5 shrink-0 transition-colors shadow-2xs cursor-pointer"
                >
                  <i data-lucide="eye" class="w-3 h-3 text-[#64748B]"></i>
                  <span>Lihat Transkrip</span>
                </button>
              </div>

            </div>

            <!-- PANEL TAB 2: ATUR JADWAL / EVALUASI WAWANCARA -->
            <div id="drawer-panel-jadwal" class="hidden space-y-3.5">
              <!-- STATE 1: FORM ATUR JADWAL (Mode Review Berkas) -->
              <div id="drawer-subpanel-jadwal-flow">
                <div id="drawer-jadwal-locked-state" class="p-8 text-center rounded-xl border border-dashed border-[#E2E8F0] bg-[#F8FAFC]">
                  <div class="w-10 h-10 mx-auto rounded-full bg-amber-50 border border-amber-200 flex items-center justify-center text-[#F59E0B] mb-2.5">
                    <i data-lucide="lock" class="w-5 h-5"></i>
                  </div>
                  <h4 class="text-sm font-semibold text-[#0F172A]">Form Penjadwalan Masih Terkunci</h4>
                  <p class="text-xs text-[#64748B] mt-1 max-w-sm mx-auto">
                    Silakan periksa berkas di tab Dokumen, lalu klik <strong>Setujui Berkas</strong> untuk mengaktifkan pengaturan jadwal wawancara bagi kandidat ini.
                  </p>
                </div>

                <div id="drawer-jadwal-form-content" class="hidden">
                  <!-- Form Atur Jadwal Flat (Tanpa Card Pembungkus) -->
                  <div class="space-y-3.5">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                      <div>
                        <label class="block font-medium text-[#475569] text-xs mb-1">Tanggal Wawancara:</label>
                        <input
                          type="date"
                          id="input-jadwal-tanggal"
                          value="2026-10-22"
                          class="h-9 w-full rounded-md border border-[#E2E8F0] bg-white px-3 text-xs text-[#0F172A] focus:outline-none focus:ring-1 focus:ring-[#1E40AF]"
                        />
                      </div>
                      <div>
                        <label class="block font-medium text-[#475569] text-xs mb-1">Waktu / Jam (WIB):</label>
                        <input
                          type="time"
                          id="input-jadwal-jam"
                          value="09:00"
                          class="h-9 w-full rounded-md border border-[#E2E8F0] bg-white px-3 text-xs text-[#0F172A] focus:outline-none focus:ring-1 focus:ring-[#1E40AF]"
                        />
                      </div>
                    </div>

                    <!-- Metode Pelaksanaan: Radio Button Offline & Online -->
                    <div>
                      <label class="block font-medium text-[#475569] text-xs mb-1.5">Metode Wawancara:</label>
                      <div class="flex items-center gap-4 text-xs">
                        <label class="inline-flex items-center gap-2 cursor-pointer text-[#0F172A] font-medium">
                          <input
                            type="radio"
                            name="radio-metode-wawancara"
                            value="online"
                            checked
                            onchange="handleMetodeWawancaraChange(this.value)"
                            class="w-4 h-4 text-[#1E40AF] border-[#CBD5E1] focus:ring-[#1E40AF] cursor-pointer"
                          />
                          <span>Online (Daring)</span>
                        </label>
                        <label class="inline-flex items-center gap-2 cursor-pointer text-[#0F172A] font-medium">
                          <input
                            type="radio"
                            name="radio-metode-wawancara"
                            value="offline"
                            onchange="handleMetodeWawancaraChange(this.value)"
                            class="w-4 h-4 text-[#1E40AF] border-[#CBD5E1] focus:ring-[#1E40AF] cursor-pointer"
                          />
                          <span>Offline (Tatap Muka)</span>
                        </label>
                      </div>
                    </div>

                    <!-- Informasi Tempat / Tautan Pertemuan -->
                    <div>
                      <label id="label-jadwal-lokasi" class="block font-medium text-[#475569] text-xs mb-1">
                        Informasi Link Pertemuan (Google Meet / Zoom):
                      </label>
                      <input
                        type="text"
                        id="input-jadwal-catatan"
                        value="https://meet.google.com/bengkod-ai-eval"
                        placeholder="Contoh: meet.google.com/bengkod-ai-eval"
                        class="h-9 w-full rounded-md border border-[#E2E8F0] bg-white px-3 text-xs text-[#0F172A] focus:outline-none focus:ring-1 focus:ring-[#1E40AF]"
                      />
                    </div>
                  </div>
                </div>
              </div>

              <!-- STATE 2: FORM PENILAIAN & CATATAN WAWANCARA (Mode Evaluasi Wawancara) -->
              <div id="drawer-subpanel-wawancara-eval" class="hidden">
                <!-- Form Penilaian Flat (Tanpa Card Pembungkus) -->
                <div class="space-y-3.5">
                  <div>
                    <div class="flex items-center justify-between mb-1">
                      <label for="modal-pelamar-input-skor" class="block font-semibold text-[#0F172A] text-xs">
                        Skor Penilaian Wawancara (0 - 100):
                      </label>
                      <span class="text-[11px] text-[#64748B]">Batas Lulus: &ge; 75</span>
                    </div>
                    <div class="relative w-40">
                      <input
                        type="number"
                        id="modal-pelamar-input-skor"
                        min="0"
                        max="100"
                        placeholder="Contoh: 85"
                        class="h-9 w-full rounded-md border border-[#E2E8F0] bg-white px-3 text-sm text-[#0F172A] focus:outline-none focus:ring-1 focus:ring-[#1E40AF] font-bold"
                      />
                      <span class="absolute right-3 top-1/2 -translate-y-1/2 text-xs text-[#64748B]">/ 100</span>
                    </div>
                  </div>

                  <div>
                    <label for="modal-pelamar-catatan-koor" class="block font-semibold text-[#0F172A] text-xs mb-1">
                      Catatan Evaluasi / Rekomendasi Seleksi:
                    </label>
                    <textarea
                      id="modal-pelamar-catatan-koor"
                      rows="4"
                      placeholder="Tuliskan catatan teknis hasil wawancara, keaktifan, kesiapan komitmen..."
                      class="w-full rounded-md border border-[#E2E8F0] bg-white p-2.5 text-xs text-[#0F172A] focus:outline-none focus:ring-1 focus:ring-[#1E40AF]"
                    ></textarea>
                  </div>
                </div>
              </div>
            </div>

          </div>

          <!-- DRAWER FOOTER: Aksi Kontekstual Berdasarkan Tab Aktif -->
          <div class="p-4 sm:p-5 border-t border-[#E2E8F0] bg-white flex items-center justify-end gap-3 shrink-0">
            <!-- Aksi Tab Dokumen: Tolak Berkas & Setujui Berkas -->
            <div id="drawer-footer-actions-dokumen" class="flex items-center gap-2">
              <button
                type="button"
                id="btn-modal-pelamar-tolak-berkas"
                onclick="tolakBerkasPelamar()"
                class="inline-flex items-center justify-center gap-1.5 h-9 px-4 rounded-md border border-rose-200 bg-rose-50 text-rose-700 hover:bg-rose-100 text-xs font-semibold transition-colors cursor-pointer"
              >
                <i data-lucide="x" class="w-4 h-4"></i>
                <span>Tolak Berkas</span>
              </button>
              <button
                type="button"
                id="btn-modal-pelamar-setuju-berkas"
                onclick="setujuiBerkasPelamar()"
                class="inline-flex items-center justify-center gap-1.5 h-9 px-4 rounded-md bg-[#1E40AF] hover:bg-[#1E3A8A] text-white text-xs font-semibold shadow-none transition-colors cursor-pointer"
              >
                <i data-lucide="check" class="w-4 h-4"></i>
                <span>Setuju Berkas ></span>
              </button>
            </div>

            <!-- Aksi Tab Atur Jadwal: Simpan Jadwal & Lanjut Wawancara -->
            <div id="drawer-footer-actions-jadwal" class="hidden flex items-center gap-2">
              <button
                type="button"
                onclick="switchDrawerDetailTab('dokumen')"
                class="h-9 px-3 rounded-md border border-[#E2E8F0] bg-white hover:bg-slate-50 text-[#475569] text-xs font-medium transition-colors cursor-pointer"
              >
                &larr; Kembali ke Berkas
              </button>
              <button
                type="button"
                id="btn-modal-pelamar-simpan-jadwal"
                onclick="simpanJadwalWawancara()"
                class="inline-flex items-center justify-center gap-1.5 h-9 px-4 rounded-md bg-[#1E40AF] hover:bg-[#1E3A8A] text-white text-xs font-semibold shadow-none transition-colors cursor-pointer"
              >
                <i data-lucide="calendar-check" class="w-4 h-4"></i>
                <span>Simpan Jadwal Wawancara</span>
              </button>
            </div>

            <!-- Aksi Drawer Evaluasi Wawancara: Tolak Wawancara & Loloskan Seleksi -->
            <div id="drawer-footer-actions-evaluasi" class="hidden flex items-center gap-2">
              <button
                type="button"
                id="btn-modal-pelamar-tolak-wawancara"
                onclick="submitKeputusanWawancara('ditolak')"
                class="inline-flex items-center justify-center gap-1.5 h-9 px-4 rounded-md border border-rose-200 bg-rose-50 text-rose-700 hover:bg-rose-100 text-xs font-semibold transition-colors cursor-pointer"
              >
                <i data-lucide="x" class="w-4 h-4"></i>
                <span>Tolak</span>
              </button>
              <button
                type="button"
                id="btn-modal-pelamar-loloskan-wawancara"
                onclick="submitKeputusanWawancara('diterima')"
                class="inline-flex items-center justify-center gap-1.5 h-9 px-4 rounded-md bg-[#1E40AF] hover:bg-[#1E3A8A] text-white text-xs font-semibold shadow-none transition-colors cursor-pointer"
              >
                <i data-lucide="check" class="w-4 h-4"></i>
                <span>Loloskan / Diterima</span>
              </button>
            </div>
          </div>

        </div>
      </div>
    </div>
