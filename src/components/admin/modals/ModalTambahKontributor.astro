    <!-- 3. Modal Tambah Kontributor (YAGNI & Clean Shadcn UI) -->
    <div id="modal-tambah-kontributor" class="fixed inset-0 z-50 bg-black/50 flex items-center justify-center hidden p-4">
      <div class="bg-white rounded-lg border border-[#e4e4e7] shadow-lg max-w-md w-full p-6 space-y-4 text-sm">
        <!-- Dialog Header -->
        <div class="flex items-start justify-between">
          <div>
            <h3 id="modal-kontributor-title" class="text-lg font-semibold text-[#09090b]">Tambah Kontributor</h3>
            <p id="modal-kontributor-subtitle" class="text-sm text-[#71717a] mt-0.5">Tambahkan kontributor baru untuk program MBKM.</p>
          </div>
          <button type="button" onclick="closeTambahKontributorModal()" class="text-[#71717a] hover:text-[#09090b] p-1 rounded-md -mt-1 cursor-pointer">
            <i data-lucide="x" class="w-4 h-4"></i>
          </button>
        </div>

        <!-- FORM INTERNAL: Nama Kontributor, Penanggung Jawab, Email Akun, Password, Deskripsi -->
        <div id="modal-form-kontributor-internal" class="space-y-3 pt-1">
          <div class="space-y-1.5">
            <label class="font-medium text-[#09090b] text-sm">Nama Kontributor <span class="text-red-500">*</span></label>
            <input
              type="text"
              id="modal-internal-nama"
              placeholder="Contoh: PT Bengkel Koding Nusantara"
              class="h-9 w-full rounded-md border border-[#e4e4e7] bg-white px-3 text-sm focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
            />
          </div>
          <div class="space-y-1.5">
            <label class="font-medium text-[#09090b] text-sm">Nama Penanggung Jawab <span class="text-red-500">*</span></label>
            <input
              type="text"
              id="modal-internal-pic-nama"
              placeholder="Contoh: Dimas Wicaksono, M.T."
              class="h-9 w-full rounded-md border border-[#e4e4e7] bg-white px-3 text-sm focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
            />
          </div>
          <div class="space-y-1.5">
            <label class="font-medium text-[#09090b] text-sm">Email Akun <span class="text-red-500">*</span></label>
            <input
              type="email"
              id="modal-internal-pic-email"
              placeholder="dimas@bengkod.id"
              class="h-9 w-full rounded-md border border-[#e4e4e7] bg-white px-3 text-sm focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
            />
          </div>
          <div class="space-y-1.5">
            <label class="font-medium text-[#09090b] text-sm">Password Akun <span class="text-red-500">*</span></label>
            <input
              type="password"
              id="modal-internal-password"
              placeholder="Masukkan password akun kontributor..."
              class="h-9 w-full rounded-md border border-[#e4e4e7] bg-white px-3 text-sm focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
            />
          </div>
          <div class="space-y-1.5">
            <label class="font-medium text-[#09090b] text-sm">Deskripsi</label>
            <textarea
              id="modal-internal-deskripsi"
              rows="2"
              placeholder="Deskripsi singkat profil kontributor..."
              class="w-full rounded-md border border-[#e4e4e7] bg-white p-2.5 text-sm focus:outline-none focus:ring-1 focus:ring-[#0655a7] leading-relaxed"
            ></textarea>
          </div>
        </div>

        <!-- FORM EKSTERNAL: Nama Kontributor / Instansi, Penanggung Jawab, Deskripsi (Tanpa Email Akun & Password) -->
        <div id="modal-form-kontributor-eksternal" class="space-y-3 pt-1 hidden">
          <div class="space-y-1.5">
            <label class="font-medium text-[#09090b] text-sm">Nama Kontributor / Instansi <span class="text-red-500">*</span></label>
            <input
              type="text"
              id="modal-eksternal-nama"
              placeholder="Contoh: PT Telekomunikasi Selular (Telkomsel)"
              class="h-9 w-full rounded-md border border-[#e4e4e7] bg-white px-3 text-sm focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
            />
          </div>
          <div class="space-y-1.5">
            <label class="font-medium text-[#09090b] text-sm">Nama Penanggung Jawab</label>
            <input
              type="text"
              id="modal-eksternal-pic-nama"
              placeholder="Contoh: Budi Santoso, M.Kom"
              class="h-9 w-full rounded-md border border-[#e4e4e7] bg-white px-3 text-sm focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
            />
          </div>
          <div class="space-y-1.5">
            <label class="font-medium text-[#09090b] text-sm">Deskripsi</label>
            <textarea
              id="modal-eksternal-deskripsi"
              rows="2"
              placeholder="Deskripsi singkat profil instansi..."
              class="w-full rounded-md border border-[#e4e4e7] bg-white p-2.5 text-sm focus:outline-none focus:ring-1 focus:ring-[#0655a7] leading-relaxed"
            ></textarea>
          </div>
        </div>

        <!-- Dialog Footer -->
        <div class="flex items-center justify-end gap-2 pt-3 border-t border-[#e4e4e7]">
          <button
            type="button"
            onclick="closeTambahKontributorModal()"
            class="inline-flex items-center justify-center h-9 px-4 text-sm font-medium rounded-md border border-[#e4e4e7] bg-white hover:bg-[#f4f4f5] text-[#09090b] transition-colors"
          >
            Batal
          </button>
          <button
            type="button"
            onclick="handleSubmitTambahKontributor()"
            class="inline-flex items-center justify-center gap-2 h-9 px-4 text-sm font-medium rounded-md bg-[#0655a7] hover:bg-[#0655a7]/90 text-white transition-colors"
          >
            Tambah
          </button>
        </div>
      </div>
    </div>
