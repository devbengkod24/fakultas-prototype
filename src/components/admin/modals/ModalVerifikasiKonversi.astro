---
// src/components/admin/modals/ModalVerifikasiKonversi.astro
// Popup Modal Verifikasi Konversi SKS dengan Tabel Ber-thead, Penomoran di Kiri, Checklist di Kanan
---

<!-- Modal Popup Verifikasi Konversi -->
<div
  x-show="isVerifOpen"
  x-cloak
  class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4 animate-in fade-in duration-150"
  role="dialog"
  aria-modal="true"
>
  <div
    @click.outside="closeVerifikasi()"
    class="w-full max-w-3xl rounded-xl bg-white shadow-xl border border-[#e4e4e7] flex flex-col max-h-[90vh] font-sans"
  >
    <!-- Header Modal -->
    <div class="flex items-start justify-between gap-4 px-6 pt-6 pb-4 border-b border-[#e4e4e7] bg-white shrink-0">
      <div>
        <h3 class="text-base font-semibold leading-none tracking-tight text-[#09090b]">Verifikasi Konversi SKS</h3>
        <p class="text-xs sm:text-sm text-[#71717a] mt-1.5">Centang mata kuliah yang relevan dengan aktivitas MBKM mahasiswa.</p>
      </div>
      <button
        type="button"
        @click="closeVerifikasi()"
        class="rounded-md p-1.5 text-[#71717a] hover:text-[#09090b] hover:bg-[#f4f4f5] transition-colors cursor-pointer"
        aria-label="Tutup modal"
      >
        <i data-lucide="x" class="w-4 h-4"></i>
      </button>
    </div>

    <!-- Body Modal (Scrollable) -->
    <template x-if="verifTarget">
      <div class="px-6 py-5 space-y-5 overflow-y-auto flex-1">
        <!-- Ringkasan Mahasiswa (tanpa card) -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-x-4 gap-y-3">
          <div>
            <div class="text-[10px] uppercase tracking-wide text-[#71717a]">Mahasiswa</div>
            <div class="text-sm font-semibold text-[#09090b] mt-0.5" x-text="verifTarget.nama"></div>
          </div>
          <div>
            <div class="text-[10px] uppercase tracking-wide text-[#71717a]">NIM</div>
            <div class="text-sm font-medium text-[#3f3f46] mt-0.5" x-text="verifTarget.nim"></div>
          </div>
          <div class="min-w-0">
            <div class="text-[10px] uppercase tracking-wide text-[#71717a]">Mitra MBKM</div>
            <div class="text-sm font-medium text-[#3f3f46] mt-0.5 truncate" x-text="verifTarget.mitra"></div>
          </div>
          <div>
            <div class="text-[10px] uppercase tracking-wide text-[#71717a]">SKS Diusulkan</div>
            <div class="text-sm font-semibold text-[#0655a7] mt-0.5" x-text="`${verifTotalSks} SKS`"></div>
          </div>
        </div>

        <!-- Tabel Mata Kuliah (thead, No di kiri, Checklist di kanan) -->
        <div>
          <div class="rounded-lg border border-[#e4e4e7] overflow-hidden bg-white">
            <table class="w-full text-sm border-collapse">
              <thead class="bg-[#fafafa] border-b border-[#e4e4e7]">
                <tr>
                  <th class="h-10 px-3 text-center align-middle font-medium text-[#71717a] text-xs w-12">No</th>
                  <th class="h-10 px-4 text-left align-middle font-medium text-[#71717a] text-xs">Mata Kuliah</th>
                  <th class="h-10 px-3 text-center align-middle font-medium text-[#71717a] text-xs w-20">SKS</th>
                  <th class="h-10 px-3 text-center align-middle font-medium text-[#71717a] text-xs w-16">
                    <input
                      type="checkbox"
                      :checked="verifAllChecked"
                      @change="toggleAllVerif()"
                      class="h-4 w-4 rounded border-[#e4e4e7] accent-[#0655a7] cursor-pointer align-middle"
                      aria-label="Pilih semua mata kuliah"
                    />
                  </th>
                </tr>
              </thead>
              <tbody class="divide-y divide-[#e4e4e7]">
                <template x-for="(row, ri) in verifRows" :key="ri">
                  <tr class="transition-colors hover:bg-[#fafafa]">
                    <!-- 1. Penomoran di Paling Kiri -->
                    <td class="p-3 text-center align-middle text-xs font-medium text-[#71717a]" x-text="ri + 1"></td>

                    <!-- 2. Mata Kuliah (tanpa deskripsi) -->
                    <td class="p-4 align-middle">
                      <div class="text-sm font-medium text-[#09090b]">
                        <span x-text="row.kode"></span>
                        <span class="text-[#71717a] font-normal mx-1">·</span>
                        <span x-text="row.nama"></span>
                      </div>
                    </td>

                    <!-- 3. Bobot SKS -->
                    <td class="p-3 text-center align-middle text-xs font-semibold text-[#0655a7] whitespace-nowrap" x-text="`${row.sks} SKS`"></td>

                    <!-- 4. Checklist di Paling Kanan -->
                    <td class="p-3 text-center align-middle">
                      <input
                        type="checkbox"
                        x-model="row.checked"
                        class="h-4 w-4 rounded border-[#e4e4e7] accent-[#0655a7] cursor-pointer align-middle"
                      />
                    </td>
                  </tr>
                </template>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Catatan -->
        <div>
          <label for="verif-catatan-modal" class="mb-1.5 block text-xs font-semibold text-gray-700">
            Catatan
            <span class="font-normal text-[#71717a]" x-text="verifAllChecked ? '(opsional)' : '(wajib diisi)'"></span>
          </label>
          <textarea
            id="verif-catatan-modal"
            x-model="verifCatatan"
            rows="3"
            :placeholder="verifAllChecked ? 'Tambahkan catatan untuk mahasiswa...' : 'Jelaskan alasan mata kuliah yang tidak disetujui...'"
            class="w-full rounded-md border border-[#e4e4e7] bg-white px-3 py-2 text-sm text-[#09090b] placeholder:text-[#71717a] focus:outline-none focus:ring-1 focus:ring-[#0655a7] resize-none"
          ></textarea>
        </div>
      </div>
    </template>

    <!-- Footer Modal -->
    <div class="px-6 py-4 border-t border-[#e4e4e7] bg-white shrink-0 flex items-center justify-end gap-2.5">
      <button
        type="button"
        @click="closeVerifikasi()"
        class="h-9 px-4 rounded-md border border-[#e4e4e7] bg-white hover:bg-[#f4f4f5] text-xs font-medium text-[#09090b] transition-colors cursor-pointer"
      >
        Batal
      </button>
      <button
        type="button"
        @click="submitVerifikasi('revisi')"
        :disabled="verifAllChecked || verifCatatan.trim() === ''"
        class="h-9 px-4 rounded-md border border-amber-300 bg-amber-50 hover:bg-amber-100 text-xs font-semibold text-amber-700 transition-colors cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
      >
        Ajukan Revisi
      </button>
      <button
        type="button"
        @click="submitVerifikasi('setuju')"
        :disabled="!verifAllChecked"
        class="h-9 px-4 rounded-md bg-[#0655a7] hover:bg-[#114D91] text-xs font-semibold text-white transition-colors cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
      >
        Setujui Konversi
      </button>
    </div>
  </div>
</div>
