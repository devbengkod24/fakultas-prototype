    <!-- 1b. Modal Detail Pengumuman (Sesuai PengumumanDetailView di fakultas-fe) -->
    <div id="modal-detail-pengumuman" class="fixed inset-0 z-50 bg-black/50 flex items-center justify-center hidden p-4">
      <div class="bg-white rounded-lg border border-[#e4e4e7] shadow-lg max-w-2xl w-full p-6 space-y-4 text-sm max-h-[90vh] overflow-y-auto">
        <div class="flex items-start justify-between pb-3 border-b border-[#e4e4e7] gap-3">
          <div>
            <span id="detail-pengumuman-badge-pinned" class="hidden inline-flex items-center gap-1 rounded-md border border-blue-200 bg-blue-50 px-2 py-0.5 text-xs font-semibold text-[#0655a7] mb-1.5">
              <i data-lucide="pin" class="w-3 h-3"></i> Disematkan
            </span>
            <h3 id="detail-pengumuman-judul" class="text-lg sm:text-xl font-semibold text-[#09090b] leading-snug"></h3>
          </div>
          <button type="button" onclick="closeDetailPengumumanModal()" class="text-[#71717a] hover:text-[#09090b] p-1 rounded-md shrink-0">
            <i data-lucide="x" class="w-4 h-4"></i>
          </button>
        </div>

        <div class="flex flex-wrap items-center gap-2 text-xs text-[#71717a] pb-2 border-b border-[#f4f4f5]">
          <div class="flex items-center gap-1.5">
            <i data-lucide="user" class="h-3.5 w-3.5 text-[#71717a]"></i>
            <span id="detail-pengumuman-author" class="font-medium"></span>
          </div>
          <span class="text-gray-300">|</span>
          <div class="flex items-center gap-1.5">
            <i data-lucide="calendar" class="h-3.5 w-3.5 text-[#71717a]"></i>
            <span id="detail-pengumuman-tgl"></span>
          </div>
          <span class="text-gray-300">|</span>
          <div class="flex items-center gap-1.5">
            <i data-lucide="clock" class="h-3.5 w-3.5 text-[#71717a]"></i>
            <span id="detail-pengumuman-jam"></span>
          </div>
          <span class="text-gray-300">|</span>
          <span id="detail-pengumuman-status"></span>
          <span id="detail-pengumuman-sasaran" class="inline-flex items-center rounded-md border border-[#e4e4e7] bg-[#fafafa] px-2 py-0.5 text-xs font-medium text-[#71717a]"></span>
        </div>

        <div class="py-2">
          <p id="detail-pengumuman-isi" class="text-sm text-[#09090b] leading-relaxed whitespace-pre-line"></p>
        </div>

        <div id="detail-pengumuman-file-wrapper" class="pt-2">
          <div class="p-3 rounded-lg border border-[#e4e4e7] bg-[#fafafa] flex items-center justify-between gap-3">
            <div class="flex items-center gap-2.5 min-w-0">
              <div class="h-9 w-9 rounded-md bg-blue-50 border border-blue-200 flex items-center justify-center shrink-0">
                <i data-lucide="file-text" class="w-4 h-4 text-[#0655a7]"></i>
              </div>
              <div class="min-w-0">
                <p id="detail-pengumuman-file-name" class="text-xs font-semibold text-[#09090b] truncate"></p>
                <p class="text-[11px] text-[#71717a]">Lampiran Resmi MBKM</p>
              </div>
            </div>
            <button
              type="button"
              id="detail-pengumuman-download-btn"
              class="inline-flex items-center justify-center gap-1.5 h-8 px-3 text-xs font-medium rounded-md bg-[#0655a7] hover:bg-[#0655a7]/90 text-white shrink-0 transition-colors"
            >
              <i data-lucide="download" class="w-3.5 h-3.5"></i>
              <span>Unduh</span>
            </button>
          </div>
        </div>

        <div class="flex items-center justify-between pt-4 border-t border-[#e4e4e7]">
          <button
            type="button"
            id="detail-pengumuman-edit-btn"
            class="inline-flex items-center justify-center gap-1.5 h-9 px-3.5 text-sm font-medium rounded-md border border-[#e4e4e7] bg-white hover:bg-[#f4f4f5] text-[#09090b] transition-colors"
          >
            <i data-lucide="pencil" class="w-3.5 h-3.5"></i>
            <span>Edit Pengumuman</span>
          </button>
          <button
            type="button"
            onclick="closeDetailPengumumanModal()"
            class="inline-flex items-center justify-center h-9 px-4 text-sm font-medium rounded-md bg-[#0655a7] hover:bg-[#0655a7]/90 text-white transition-colors"
          >
            Tutup
          </button>
        </div>
      </div>
    </div>
