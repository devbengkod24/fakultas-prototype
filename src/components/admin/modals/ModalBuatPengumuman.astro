    <!-- 1. Modal Buat / Edit Pengumuman (Sesuai Dialog Pengumuman fakultas-fe) -->
    <div id="modal-buat-pengumuman" class="fixed inset-0 z-50 bg-black/50 flex items-center justify-center hidden p-4">
      <div class="bg-white rounded-lg border border-[#e4e4e7] shadow-lg max-w-lg w-full p-6 space-y-4 text-sm">
        <div class="flex items-center justify-between pb-3 border-b border-[#e4e4e7]">
          <h3 id="modal-pengumuman-title" class="text-lg font-semibold text-[#09090b]">Tambah Pengumuman</h3>
          <button type="button" onclick="closeBuatPengumumanModal()" class="text-[#71717a] hover:text-[#09090b] p-1 rounded-md">
            <i data-lucide="x" class="w-4 h-4"></i>
          </button>
        </div>
        <form onsubmit="handleSavePengumuman(event)" class="space-y-4">
          <input type="hidden" id="modal-pengumuman-id" value="" />
          <div class="space-y-1.5">
            <label class="font-medium text-[#09090b] text-sm">Judul Pengumuman *</label>
            <input
              type="text"
              id="modal-pengumuman-judul"
              required
              placeholder="Masukkan judul pengumuman..."
              class="h-9 w-full rounded-md border border-[#e4e4e7] bg-white px-3 text-sm focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
            />
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div class="space-y-1.5">
              <label class="font-medium text-[#09090b] text-sm">Sasaran Penerima *</label>
              <select
                id="modal-pengumuman-sasaran"
                class="h-9 w-full rounded-md border border-[#e4e4e7] bg-white px-3 text-sm focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
              >
                <option value="semua_mhs">Semua Mahasiswa MBKM</option>
                <option value="kontributor_dospem">Kontributor & Dosen Pembimbing</option>
                <option value="magang">Peserta Magang Industri</option>
                <option value="studi_independen">Peserta Studi Independen</option>
              </select>
            </div>
            <div class="space-y-1.5">
              <label class="font-medium text-[#09090b] text-sm">Status Publikasi *</label>
              <select
                id="modal-pengumuman-status"
                class="h-9 w-full rounded-md border border-[#e4e4e7] bg-white px-3 text-sm focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
              >
                <option value="published">Dipublikasikan</option>
                <option value="draft">Draf</option>
                <option value="archived">Diarsipkan</option>
              </select>
            </div>
          </div>
          <div class="space-y-1.5">
            <label class="font-medium text-[#09090b] text-sm">Isi Pengumuman *</label>
            <textarea
              id="modal-pengumuman-isi"
              rows="4"
              required
              placeholder="Tuliskan isi pengumuman..."
              class="w-full rounded-md border border-[#e4e4e7] bg-white p-3 text-sm focus:outline-none focus:ring-1 focus:ring-[#0655a7] leading-relaxed"
            ></textarea>
          </div>
          <div class="space-y-1.5">
            <label class="font-medium text-[#09090b] text-sm">Lampiran Dokumen (Opsional)</label>
            <input
              type="text"
              id="modal-pengumuman-file"
              placeholder="Nama file lampiran atau URL..."
              class="h-9 w-full rounded-md border border-[#e4e4e7] bg-white px-3 text-sm focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
            />
          </div>
          <div class="flex items-center justify-end gap-2 pt-4 border-t border-[#e4e4e7]">
            <button
              type="button"
              onclick="closeBuatPengumumanModal()"
              class="inline-flex items-center justify-center h-9 px-4 text-sm font-medium rounded-md border border-[#e4e4e7] bg-white hover:bg-[#f4f4f5] text-[#09090b] transition-colors"
            >
              Batal
            </button>
            <button
              type="submit"
              class="inline-flex items-center justify-center gap-2 h-9 px-4 text-sm font-medium rounded-md bg-[#0655a7] hover:bg-[#0655a7]/90 text-white transition-colors"
            >
              Simpan
            </button>
          </div>
        </form>
      </div>
    </div>
