---
// src/components/admin/modals/DrawerVerifikasiKonversi.astro
// Drawer slide-over dari sisi kanan untuk Verifikasi Konversi SKS
---

<!-- Backdrop Overlay -->
<div
  x-show="isVerifOpen"
  x-cloak
  x-transition:enter="transition-opacity ease-out duration-300"
  x-transition:enter-start="opacity-0"
  x-transition:enter-end="opacity-100"
  x-transition:leave="transition-opacity ease-in duration-200"
  x-transition:leave-start="opacity-100"
  x-transition:leave-end="opacity-0"
  class="fixed inset-0 z-50 bg-black/50"
  @click="closeVerifikasi()"
  aria-hidden="true"
></div>

<!-- Drawer Panel (Kanan) -->
<div
  x-show="isVerifOpen"
  x-cloak
  x-transition:enter="transform transition ease-out duration-300"
  x-transition:enter-start="translate-x-full"
  x-transition:enter-end="translate-x-0"
  x-transition:leave="transform transition ease-in duration-200"
  x-transition:leave-start="translate-x-0"
  x-transition:leave-end="translate-x-full"
  class="fixed inset-y-0 right-0 z-50 w-full sm:max-w-xl md:max-w-2xl bg-white shadow-2xl border-l border-[#e4e4e7] flex flex-col h-full font-sans"
  role="dialog"
  aria-modal="true"
>
  <!-- Header Drawer -->
  <div class="flex items-start justify-between gap-4 px-6 py-5 border-b border-[#e4e4e7] bg-white shrink-0">
    <div>
      <h3 class="text-base font-semibold leading-none tracking-tight text-[#09090b]">Verifikasi Konversi SKS</h3>
      <p class="text-xs sm:text-sm text-[#71717a] mt-1.5">Centang mata kuliah yang relevan dengan aktivitas MBKM mahasiswa.</p>
    </div>
    <button
      type="button"
      @click="closeVerifikasi()"
      class="rounded-md p-1.5 text-[#71717a] hover:text-[#09090b] hover:bg-[#f4f4f5] transition-colors cursor-pointer"
      aria-label="Tutup drawer"
    >
      <i data-lucide="x" class="w-4 h-4"></i>
    </button>
  </div>

  <!-- Body Drawer (Scrollable) -->
  <template x-if="verifTarget">
    <div class="flex-1 overflow-y-auto px-6 py-5 space-y-5">
      <!-- Ringkasan Mahasiswa -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 rounded-lg border border-[#e4e4e7] bg-[#fafafa] p-3.5">
        <div>
          <div class="text-[10px] uppercase tracking-wide text-[#71717a]">Mahasiswa</div>
          <div class="text-sm font-semibold text-[#09090b] mt-0.5" x-text="verifTarget.nama"></div>
        </div>
        <div>
          <div class="text-[10px] uppercase tracking-wide text-[#71717a]">NIM</div>
          <div class="text-sm font-medium text-[#3f3f46] mt-0.5" x-text="verifTarget.nim"></div>
        </div>
        <div class="min-w-0">
          <div class="text-[10px] uppercase tracking-wide text-[#71717a]">Mitra MBKM</div>
          <div class="text-sm font-medium text-[#3f3f46] mt-0.5 truncate" x-text="verifTarget.mitra"></div>
        </div>
        <div>
          <div class="text-[10px] uppercase tracking-wide text-[#71717a]">SKS Diusulkan</div>
          <div class="text-sm font-semibold text-[#0655a7] mt-0.5" x-text="`${verifTotalSks} SKS`"></div>
        </div>
      </div>

      <!-- Checklist Mata Kuliah -->
      <div class="space-y-2.5">
        <span class="block text-sm font-semibold text-[#09090b]">Mata Kuliah</span>

        <div class="rounded-lg border border-[#e4e4e7] divide-y divide-[#e4e4e7] overflow-hidden bg-white">
          <template x-for="(row, ri) in verifRows" :key="ri">
            <label class="flex items-start gap-3 px-4 py-3 hover:bg-[#fafafa] transition-colors cursor-pointer select-none">
              <input
                type="checkbox"
                x-model="row.checked"
                class="mt-0.5 h-4 w-4 shrink-0 rounded border-[#e4e4e7] accent-[#0655a7] cursor-pointer"
              />
              <div class="flex-1 min-w-0">
                <div class="flex items-start justify-between gap-3">
                  <div class="min-w-0">
                    <div class="text-sm font-medium text-[#09090b]">
                      <span x-text="row.kode"></span>
                      <span class="text-[#71717a] font-normal mx-1">·</span>
                      <span x-text="row.nama"></span>
                    </div>
                    <div class="text-xs text-[#71717a] mt-0.5 leading-relaxed" x-text="row.aktivitas"></div>
                  </div>
                  <span class="shrink-0 text-xs font-semibold text-[#0655a7] whitespace-nowrap" x-text="`${row.sks} SKS`"></span>
                </div>
              </div>
            </label>
          </template>
        </div>
      </div>

      <!-- Catatan -->
      <div>
        <label for="verif-catatan-drawer" class="mb-1.5 block text-xs font-semibold text-gray-700">
          Catatan
          <span class="font-normal text-[#71717a]" x-text="verifAllChecked ? '(opsional)' : '(wajib diisi)'"></span>
        </label>
        <textarea
          id="verif-catatan-drawer"
          x-model="verifCatatan"
          rows="3"
          :placeholder="verifAllChecked ? 'Tambahkan catatan untuk mahasiswa...' : 'Jelaskan alasan mata kuliah yang tidak disetujui...'"
          class="w-full rounded-md border border-[#e4e4e7] bg-white px-3 py-2 text-sm text-[#09090b] placeholder:text-[#71717a] focus:outline-none focus:ring-1 focus:ring-[#0655a7] resize-none"
        ></textarea>
      </div>
    </div>
  </template>

  <!-- Footer Drawer (Sticky di Bawah) -->
  <div class="px-6 py-4 border-t border-[#e4e4e7] bg-white shrink-0 flex items-center justify-end gap-2.5">
    <button
      type="button"
      @click="closeVerifikasi()"
      class="h-9 px-4 rounded-md border border-[#e4e4e7] bg-white hover:bg-[#f4f4f5] text-xs font-medium text-[#09090b] transition-colors cursor-pointer"
    >
      Batal
    </button>
    <button
      type="button"
      @click="submitVerifikasi('revisi')"
      :disabled="verifAllChecked || verifCatatan.trim() === ''"
      class="h-9 px-4 rounded-md border border-amber-300 bg-amber-50 hover:bg-amber-100 text-xs font-semibold text-amber-700 transition-colors cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
    >
      Ajukan Revisi
    </button>
    <button
      type="button"
      @click="submitVerifikasi('setuju')"
      :disabled="!verifAllChecked"
      class="h-9 px-4 rounded-md bg-[#0655a7] hover:bg-[#114D91] text-xs font-semibold text-white transition-colors cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
    >
      Setujui Konversi
    </button>
  </div>
</div>
