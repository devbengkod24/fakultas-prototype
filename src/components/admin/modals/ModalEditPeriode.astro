    <!-- 5. Modal Edit Periode MBKM (Sesuai EditPeriodeModal di bimbingan-karir & tugas-akhir) -->
    <div id="modal-edit-periode" class="fixed inset-0 z-50 bg-black/50 flex items-center justify-center hidden p-4">
      <div class="bg-white rounded-lg border border-[#e4e4e7] shadow-lg max-w-[425px] w-full p-6 space-y-4 text-sm">
        <div class="flex items-center justify-between pb-3 border-b border-[#e4e4e7]">
          <div>
            <h3 class="text-lg font-semibold text-[#09090b]">Edit Periode MBKM</h3>
            <p id="modal-edit-periode-subtitle" class="text-xs text-[#71717a] mt-0.5">
              Update tanggal periode MBKM
            </p>
          </div>
          <button type="button" onclick="closeEditPeriodeModal()" class="text-[#71717a] hover:text-[#09090b] p-1 rounded-md">
            <i data-lucide="x" class="w-4 h-4"></i>
          </button>
        </div>
        <form onsubmit="handleSaveEditPeriode(event)" class="space-y-4">
          <input type="hidden" id="modal-edit-periode-id" value="" />
          <div class="space-y-1.5">
            <label class="font-medium text-[#09090b] text-sm">Tanggal Mulai MBKM</label>
            <input
              type="date"
              id="modal-edit-periode-mulai"
              class="h-9 w-full rounded-md border border-[#e4e4e7] bg-white px-3 text-sm focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
            />
          </div>
          <div class="space-y-1.5">
            <label class="font-medium text-[#09090b] text-sm">Tanggal Akhir MBKM</label>
            <input
              type="date"
              id="modal-edit-periode-akhir"
              class="h-9 w-full rounded-md border border-[#e4e4e7] bg-white px-3 text-sm focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
            />
          </div>
          <div class="space-y-1.5">
            <label class="font-medium text-[#09090b] text-sm">Status Periode</label>
            <select
              id="modal-edit-periode-status"
              class="h-9 w-full rounded-md border border-[#e4e4e7] bg-white px-3 text-sm focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
            >
              <option value="1">Aktif</option>
              <option value="0">Nonaktif</option>
            </select>
          </div>
          <div class="flex items-center justify-end gap-2 pt-4 border-t border-[#e4e4e7]">
            <button
              type="button"
              onclick="closeEditPeriodeModal()"
              class="inline-flex items-center justify-center h-9 px-4 text-sm font-medium rounded-md border border-[#e4e4e7] bg-white hover:bg-[#f4f4f5] text-[#09090b] transition-colors"
            >
              Batal
            </button>
            <button
              type="submit"
              class="inline-flex items-center justify-center gap-2 h-9 px-4 text-sm font-medium rounded-md bg-[#0655a7] hover:bg-[#0655a7]/90 text-white transition-colors"
            >
              Simpan
            </button>
          </div>
        </form>
      </div>
    </div>
