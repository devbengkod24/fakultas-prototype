    <div id="modal-crud-kategori" class="fixed inset-0 z-50 flex items-center justify-center hidden p-4 bg-black/40">
      <div
        class="bg-white rounded-2xl max-w-lg w-full p-5 shadow-2xl border border-[#e4e4e7] flex flex-col gap-4 text-xs animate-in fade-in zoom-in-95 duration-150"
      >
        <div class="flex items-center justify-between pb-2 border-b border-[#e4e4e7]">
          <h3 id="modal-kategori-title" class="text-sm font-bold text-[#09090b]">Tambah Kategori Program</h3>
          <button type="button" onclick="closeKategoriModal()" class="text-[#71717a] hover:text-[#09090b]">
            <i data-lucide="x" class="w-4 h-4"></i>
          </button>
        </div>
        <form onsubmit="handleSaveKategori(event)" class="flex flex-col gap-3">
          <input type="hidden" id="modal-kategori-id" value="" />
          <div class="flex flex-col gap-1.5">
            <label class="font-medium text-[#3f3f46]">Nama Kategori Program *</label>
            <input
              type="text"
              id="modal-kategori-nama"
              required
              placeholder="Contoh: MBKM Eksternal - Studi Independen"
              class="px-3 py-2 rounded-lg border border-[#e4e4e7] focus:ring-1 focus:ring-[#0655a7] focus:outline-none"
            />
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div class="flex flex-col gap-1.5">
              <label class="font-medium text-[#3f3f46]">Tipe Klaster *</label>
              <select
                id="modal-kategori-type"
                class="px-3 py-2 rounded-lg border border-[#e4e4e7] focus:ring-1 focus:ring-[#0655a7] focus:outline-none"
              >
                <option value="internal">MBKM Internal</option>
                <option value="eksternal">MBKM Eksternal</option>
              </select>
            </div>
            <div class="flex flex-col gap-1.5">
              <label class="font-medium text-[#3f3f46]">Default SKS Konversi *</label>
              <select
                id="modal-kategori-sks"
                class="px-3 py-2 rounded-lg border border-[#e4e4e7] bg-white font-medium focus:ring-1 focus:ring-[#0655a7] focus:outline-none"
              >
                <option value="10">10 SKS</option>
                <option value="12">12 SKS</option>
                <option value="15">15 SKS</option>
                <option value="20" selected>20 SKS</option>
                <option value="24">24 SKS</option>
              </select>
            </div>
          </div>
          <div class="flex items-center justify-end gap-2 pt-3 border-t border-[#e4e4e7] mt-2">
            <button
              type="button"
              onclick="closeKategoriModal()"
              class="px-3 py-1.5 rounded-lg border border-[#e4e4e7] text-[#3f3f46] hover:bg-gray-50 font-medium"
            >
              Batal
            </button>
            <button
              type="submit"
              class="px-4 py-1.5 rounded-lg bg-[#0655a7] hover:bg-[#114d91] text-white font-semibold"
            >
              Simpan Kategori
            </button>
          </div>
        </form>
      </div>
    </div>
