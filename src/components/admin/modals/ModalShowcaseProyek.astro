    <!-- 3b. Modal Tambah / Edit Proyek Showcase Mahasiswa -->
    <div id="modal-showcase-proyek" class="fixed inset-0 z-50 flex items-center justify-center hidden p-4 bg-black/50">
      <div class="bg-white rounded-lg border border-[#e4e4e7] shadow-lg max-w-lg w-full p-6 space-y-4 text-sm max-h-[90vh] overflow-y-auto">
        <div class="flex items-start justify-between pb-2 border-b border-[#e4e4e7]">
          <div>
            <div class="flex items-center gap-2">
              <h3 id="modal-showcase-title" class="text-lg font-semibold text-[#09090b]">Tambah Proyek Showcase</h3>
              <span id="modal-showcase-id-badge" class="inline-flex items-center px-2 py-0.5 rounded bg-[#f4f4f5] border border-[#e4e4e7] text-[11px] font-medium text-[#52525b]">PRJ-2026-01</span>
            </div>
            <p class="text-xs text-[#71717a] mt-0.5">Pamerkan karya capstone project mahasiswa untuk halaman publik program.</p>
          </div>
          <button type="button" onclick="closeShowcaseModal()" class="text-[#71717a] hover:text-[#09090b] p-1 rounded-md cursor-pointer">
            <i data-lucide="x" class="w-4 h-4"></i>
          </button>
        </div>

        <form onsubmit="handleSaveShowcase(event)" class="space-y-3.5">
          <input type="hidden" id="modal-showcase-idx" value="" />
          <input type="hidden" id="modal-showcase-id" value="" />
          <input type="hidden" id="modal-showcase-foto-data" value="" />

          <div class="space-y-1.5">
            <label class="font-medium text-[#09090b] text-xs">Batch Kampus Berdampak *</label>
            <input
              type="text"
              id="modal-showcase-batch"
              required
              placeholder="Capstone Project Batch 6"
              class="h-9 w-full rounded-md border border-[#e4e4e7] bg-white px-3 text-sm focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
            />
          </div>

          <div class="space-y-1.5">
            <label class="font-medium text-[#09090b] text-xs">Judul Proyek *</label>
            <input
              type="text"
              id="modal-showcase-judul"
              required
              placeholder="Contoh: Smart Energy & Air Quality Monitoring Campus FIK"
              class="h-9 w-full rounded-md border border-[#e4e4e7] bg-white px-3 text-sm focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
            />
          </div>

          <div class="space-y-1.5">
            <label class="font-medium text-[#09090b] text-xs">Kategori / Topik Utama *</label>
            <input
              type="text"
              id="modal-showcase-kategori"
              required
              placeholder="Contoh: IoT & Machine Learning"
              class="h-9 w-full rounded-md border border-[#e4e4e7] bg-white px-3 text-sm focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
            />
          </div>

          <div class="space-y-1.5">
            <label class="font-medium text-[#09090b] text-xs">Deskripsi Ringkas Hasil Karya *</label>
            <textarea
              id="modal-showcase-deskripsi"
              rows="3"
              required
              placeholder="Jelaskan inovasi sistem, dataset, atau integrasi sensor yang dibuat mahasiswa..."
              class="w-full rounded-md border border-[#e4e4e7] bg-white p-2.5 text-sm focus:outline-none focus:ring-1 focus:ring-[#0655a7] leading-relaxed"
            ></textarea>
          </div>

          <div class="space-y-1.5">
            <label class="font-medium text-[#09090b] text-xs">Foto Proyek</label>
            <div
              id="modal-showcase-foto-dropzone"
              ondragover="event.preventDefault(); this.classList.add('border-[#0655a7]', 'bg-blue-50/40');"
              ondragleave="this.classList.remove('border-[#0655a7]', 'bg-blue-50/40');"
              ondrop="handleShowcaseFotoDrop(event)"
              class="rounded-lg border border-dashed border-[#d4d4d8] bg-white p-3 flex items-center gap-3.5 transition-colors"
            >
              <div class="w-36 h-24 rounded-md bg-[#f4f4f5] border border-[#e4e4e7] overflow-hidden flex items-center justify-center shrink-0">
                <img
                  id="modal-showcase-foto-preview"
                  src=""
                  alt="Preview Foto Proyek"
                  class="hidden object-cover w-full h-full"
                />
                <div id="modal-showcase-foto-empty" class="text-[#a1a1aa] flex items-center justify-center">
                  <i data-lucide="image" class="w-6 h-6"></i>
                </div>
              </div>

              <div class="flex-1 min-w-0 space-y-1">
                <p id="modal-showcase-foto-status" class="text-xs font-semibold text-[#09090b] truncate">Belum ada gambar</p>
                <p class="text-[11px] text-[#71717a] leading-relaxed">Tarik file ke sini atau klik Pilih File. PNG, JPG, atau WebP. Maksimal 2 MB.</p>
                <button
                  type="button"
                  id="modal-showcase-foto-clear"
                  onclick="clearShowcaseFoto()"
                  class="hidden text-[11px] font-medium text-rose-600 hover:underline cursor-pointer"
                >
                  Hapus gambar
                </button>
              </div>

              <div class="shrink-0">
                <input
                  type="file"
                  id="modal-showcase-foto-input"
                  accept="image/png,image/jpeg,image/webp"
                  class="hidden"
                  onchange="handleShowcaseFotoChange(event)"
                />
                <button
                  type="button"
                  onclick="document.getElementById('modal-showcase-foto-input')?.click()"
                  class="inline-flex items-center justify-center h-8 px-3 rounded-md bg-[#0655a7] hover:bg-[#114D91] text-white text-xs font-medium transition-colors cursor-pointer"
                >
                  Pilih File
                </button>
              </div>
            </div>
          </div>

          <div class="space-y-1.5">
            <label class="font-medium text-[#09090b] text-xs">Teknologi / Tech Stack (Pisahkan dengan koma) *</label>
            <input
              type="text"
              id="modal-showcase-tech"
              required
              placeholder="Python, TensorFlow, React.js, Google Cloud"
              class="h-9 w-full rounded-md border border-[#e4e4e7] bg-white px-3 text-sm focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
            />
          </div>

          <div class="flex items-center justify-end gap-2 pt-3 border-t border-[#e4e4e7]">
            <button
              type="button"
              onclick="closeShowcaseModal()"
              class="inline-flex items-center justify-center h-9 px-4 text-sm font-medium rounded-md border border-[#e4e4e7] bg-white hover:bg-[#f4f4f5] text-[#09090b] transition-colors"
            >
              Batal
            </button>
            <button
              type="submit"
              class="inline-flex items-center justify-center gap-2 h-9 px-4 text-sm font-medium rounded-md bg-[#0655a7] hover:bg-[#0655a7]/90 text-white transition-colors"
            >
              Simpan Proyek
            </button>
          </div>
        </form>
      </div>
    </div>
