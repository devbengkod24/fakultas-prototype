---
// src/components/admin/mitra/MitraTable.astro
import DataTable from '../../ui/DataTable.astro';
import Badge from '../../ui/Badge.astro';
import type { DataTableTab } from '../../../types';
import { partnersData } from '../../../data/partners/partners';

const tabs: DataTableTab[] = [
  { id: 'eksternal', label: 'Kontributor Eksternal', count: partnersData.filter((p) => p.tipe === 'eksternal').length },
  { id: 'all', label: 'Semua Kontributor', count: partnersData.length },
  { id: 'internal', label: 'Kontributor Internal', count: partnersData.filter((p) => p.tipe === 'internal').length },
];
---

<!-- Subview 1: Direktori Kontributor (Menggunakan Reusable DataTable) -->
<div id="subview-mitra-list" x-data="{ activeTab: 'eksternal', searchQuery: '' }">
  <DataTable
    tabs={tabs}
    activeTabModel="activeTab"
    searchPlaceholder="Cari nama kontributor, deskripsi, atau PIC..."
    searchModel="searchQuery"
    totalItems={partnersData.length}
    infoText={`Menampilkan 1 - ${partnersData.length} dari ${partnersData.length} data`}
  >
    <!-- Actions Slot: Tombol Tambah Kontributor hanya di tab Eksternal dan Internal -->
    <div slot="actions">
      <button
        type="button"
        x-show="activeTab !== 'all'"
        @click="window.showTambahMitraModal ? window.showTambahMitraModal(activeTab) : showTambahMitraModal(activeTab)"
        class="inline-flex items-center gap-2 h-9 px-4 text-sm font-medium rounded-md bg-[#0655a7] hover:bg-[#0655a7]/90 text-white transition-colors cursor-pointer"
      >
        <i data-lucide="plus" class="w-4 h-4"></i>
        <span>Tambah Kontributor</span>
      </button>
    </div>

    <!-- Table Header Slot -->
    <tr slot="head">
      <th class="h-10 w-12 px-3 text-center text-xs">No</th>
      <th class="h-10 px-4 text-left text-xs">Nama Kontributor & Deskripsi</th>
      <th class="h-10 px-4 text-left text-xs">Akun & PIC</th>
      <th class="h-10 px-4 text-center text-xs">Dosen DPL</th>
      <th class="h-10 px-4 text-center text-xs">Mahasiswa</th>
      <th class="h-10 px-4 text-center text-xs">Status</th>
      <th class="h-10 w-24 px-4 text-center text-xs">Aksi</th>
    </tr>

    <!-- Table Body Rows (Typed Partner) -->
    {partnersData.map((partner, idx) => (
      <tr
        class="hover:bg-slate-50/70 transition-colors"
        x-show={`(activeTab === 'all' || activeTab === '${partner.tipe}') && ('${partner.nama.toLowerCase()}'.includes(searchQuery.toLowerCase()) || '${partner.sektor.toLowerCase()}'.includes(searchQuery.toLowerCase()))`}
      >
        <td class="h-12 px-3 text-center text-slate-400 text-xs font-medium">
          {idx + 1}
        </td>
        <td class="h-12 px-4">
          <div class="flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-lg bg-blue-50 text-[#0655a7] font-bold text-xs flex items-center justify-center shrink-0 border border-blue-200/60">
              {partner.avatar || partner.nama.substring(0, 2).toUpperCase()}
            </div>
            <div>
              <p class="font-semibold text-sm text-[#09090b] leading-tight">{partner.nama}</p>
              <p class="text-xs text-[#71717a] mt-0.5 max-w-md truncate">{partner.deskripsi}</p>
            </div>
          </div>
        </td>
        <td class="h-12 px-4 text-xs">
          <p class="font-medium text-[#09090b]">{partner.picNama}</p>
          <p class="text-[#71717a]">{partner.picEmail}</p>
        </td>
        <td class="h-12 px-4 text-center text-xs font-semibold text-slate-700">
          <span class="inline-flex items-center px-2 py-0.5 rounded bg-slate-100 text-slate-700 border border-slate-200">
            {partner.dosen ? partner.dosen.length : 0} Dosen
          </span>
        </td>
        <td class="h-12 px-4 text-center text-xs font-semibold text-slate-700">
          <span class="inline-flex items-center px-2 py-0.5 rounded bg-slate-100 text-slate-700 border border-slate-200">
            {partner.mhs ? partner.mhs.length : 0} Mhs
          </span>
        </td>
        <td class="h-12 px-4 text-center">
          <Badge variant={partner.status === 'aktif' ? 'success' : 'neutral'} dot size="sm">
            {partner.status === 'aktif' ? 'Aktif' : 'Non-Aktif'}
          </Badge>
        </td>
        <td class="h-12 px-4 text-center">
          <button
            type="button"
            onclick={`showMitraDetail(${partner.id})`}
            class="inline-flex items-center justify-center gap-1.5 h-8 px-3 rounded-md border border-[#e4e4e7] bg-white hover:bg-[#f4f4f5] text-xs font-medium text-[#0655a7] transition-colors cursor-pointer"
          >
            <i data-lucide="eye" class="w-3.5 h-3.5 text-[#0655a7]"></i>
            <span>Detail</span>
          </button>
        </td>
      </tr>
    ))}

    <!-- Standard Pagination Slot (Sesuai Gambar 1) -->
    <div slot="pagination" class="flex items-center gap-2">
      <button
        type="button"
        disabled
        class="h-8 w-8 flex items-center justify-center rounded-md border border-[#e4e4e7] bg-white text-[#71717a] opacity-50 cursor-not-allowed hover:bg-gray-50"
      >
        <i data-lucide="chevron-left" class="w-4 h-4"></i>
      </button>
      <button
        type="button"
        class="h-8 w-8 flex items-center justify-center rounded-md bg-[#0655a7] text-white font-semibold text-xs shadow-none"
      >
        1
      </button>
      <button
        type="button"
        class="h-8 w-8 flex items-center justify-center rounded-md border border-[#e4e4e7] bg-white text-[#09090b] font-medium text-xs hover:bg-[#f4f4f5]"
      >
        2
      </button>
      <button
        type="button"
        class="h-8 w-8 flex items-center justify-center rounded-md border border-[#e4e4e7] bg-white text-[#09090b] font-medium text-xs hover:bg-[#f4f4f5]"
      >
        3
      </button>
      <button
        type="button"
        class="h-8 w-8 flex items-center justify-center rounded-md border border-[#e4e4e7] bg-white text-[#09090b] hover:bg-[#f4f4f5]"
      >
        <i data-lucide="chevron-right" class="w-4 h-4"></i>
      </button>
      <select
        class="h-8 rounded-md border border-[#e4e4e7] bg-white px-2 text-xs text-[#09090b] focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
      >
        <option value="10">Show 10 items</option>
        <option value="25">Show 25 items</option>
        <option value="50">Show 50 items</option>
      </select>
    </div>
  </DataTable>
</div>
