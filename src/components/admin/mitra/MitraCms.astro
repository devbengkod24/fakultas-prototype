---
// src/components/admin/mitra/MitraCms.astro
---

<!-- Subview 3: CMS Halaman Publik Detail Mitra (Hero, Profil & Showcase) -->
<div id="subview-program-cms" class="space-y-4 hidden">
  <!-- Top Navigation Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-3 border-b border-[#e4e4e7] gap-3">
    <div class="flex items-center gap-3">
      <button
        type="button"
        onclick="closeProgramCms()"
        class="inline-flex items-center justify-center h-8 w-8 rounded-md border border-[#e4e4e7] bg-white hover:bg-[#f4f4f5] text-[#71717a] transition-colors shrink-0"
        title="Kembali ke Detail Kontributor"
      >
        <i data-lucide="arrow-left" class="w-4 h-4"></i>
      </button>
      <div>
        <h2 id="cms-program-page-title" class="text-lg font-semibold text-[#09090b]">Kelola Program</h2>
        <p id="cms-program-page-subtitle" class="text-xs text-[#71717a] mt-0.5">Pengaturan profil kontributor, narasi hero, fasilitas mahasiswa, penanggung jawab/koordinator, dan showcase hasil karya.</p>
      </div>
    </div>
    <div id="cms-header-action-btn" class="flex items-center gap-2 shrink-0">
      <span id="cms-preview-badge" class="hidden inline-flex items-center gap-1.5 h-8 px-3 rounded-md border border-amber-200 bg-amber-50 text-xs font-medium text-amber-800">
        <i data-lucide="lock" class="w-3.5 h-3.5 text-amber-600"></i>
        <span>Mode Pratinjau (Read-Only)</span>
      </span>
      <button
        type="button"
        onclick="handleSaveCmsHero()"
        id="btn-save-cms-top"
        class="inline-flex items-center justify-center gap-2 h-9 px-4 text-xs font-medium rounded-md bg-[#0655a7] hover:bg-[#0655a7]/90 text-white transition-colors"
      >
        <i data-lucide="save" class="w-4 h-4"></i>
        <span>Simpan Perubahan</span>
      </button>
    </div>
  </div>

  <!-- Navigasi 2 Sub-tab CMS (Bersih Tanpa Angka Badge) -->
  <div class="w-full border-b border-[#e4e4e7]">
    <div class="flex gap-2">
      <button
        type="button"
        id="btn-subtab-cms-hero"
        onclick="switchCmsSubTab('hero')"
        class="flex items-center gap-2 px-4 py-2.5 text-sm font-medium border-b-2 border-[#0655a7] text-[#0655a7] transition-colors"
      >
        <i data-lucide="file-text" class="w-4 h-4"></i>
        <span>Informasi Utama & Hero Detail</span>
      </button>
      <button
        type="button"
        id="btn-subtab-cms-showcase"
        onclick="switchCmsSubTab('showcase')"
        class="flex items-center gap-2 px-4 py-2.5 text-sm font-medium border-b-2 border-transparent text-[#71717a] hover:text-[#09090b] transition-colors"
      >
        <i data-lucide="layout-grid" class="w-4 h-4"></i>
        <span>Showcase Hasil Karya Proyek Mahasiswa</span>
      </button>
    </div>
  </div>

  <!-- PANE 1: INFORMASI UTAMA & HERO DETAIL -->
  <div id="pane-cms-hero" class="space-y-4">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-start">
      <!-- Kolom Kiri: Atribut & Narasi Hero (7 Kolom) -->
      <div class="lg:col-span-7 space-y-4">
        <!-- Section Atribut Mitra -->
        <div class="rounded-xl border border-[#e4e4e7] bg-white p-5 space-y-3.5 shadow-none">
          <div class="border-b border-[#f4f4f5] pb-2">
            <h3 class="font-semibold text-sm text-[#09090b]">Atribut & Identitas Mitra MBKM</h3>
            <p class="text-xs text-[#71717a]">Informasi profil institusi mitra industri yang tampil di portal publik mahasiswa.</p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
            <div class="space-y-1 sm:col-span-2">
              <label class="font-medium text-[#09090b] text-xs">Nama Mitra Industri / Instansi <span class="text-red-500">*</span></label>
              <input
                type="text"
                id="cms-input-mitra"
                placeholder="Contoh: PT. Presentologics (Dicoding Indonesia)"
                class="cms-field h-9 w-full rounded-md border border-[#e4e4e7] bg-white px-3 text-sm focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
              />
            </div>
            <div class="space-y-1">
              <label class="font-medium text-[#09090b] text-xs">Sektor / Bidang Industri <span class="text-red-500">*</span></label>
              <input
                type="text"
                id="cms-input-klaster"
                placeholder="Teknologi Informasi & Software"
                class="cms-field h-9 w-full rounded-md border border-[#e4e4e7] bg-white px-3 text-sm focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
              />
            </div>
            <div class="space-y-1">
              <label class="font-medium text-[#09090b] text-xs">Moda & Lokasi Penempatan <span class="text-red-500">*</span></label>
              <input
                type="text"
                id="cms-input-moda"
                placeholder="Hybrid (Daring & Lab FIK UDINUS)"
                class="cms-field h-9 w-full rounded-md border border-[#e4e4e7] bg-white px-3 text-sm focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
              />
            </div>
            <div class="space-y-1">
              <label class="font-medium text-[#09090b] text-xs">Periode Semester <span class="text-red-500">*</span></label>
              <select
                id="cms-input-periode"
                class="cms-field h-9 w-full rounded-md border border-[#e4e4e7] bg-white px-3 text-sm focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
              >
                <option value="Semester Gasal 2026/2027">Semester Gasal 2026/2027</option>
                <option value="Semester Genap 2025/2026">Semester Genap 2025/2026</option>
              </select>
            </div>
            <div class="space-y-1">
              <label class="font-medium text-[#09090b] text-xs">Nomor Dokumen MoU / PKS <span class="text-red-500">*</span></label>
              <input
                type="text"
                id="cms-input-sks"
                placeholder="062/MoU/FIK-UDINUS/2026"
                class="cms-field h-9 w-full rounded-md border border-[#e4e4e7] bg-white px-3 text-sm focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
              />
            </div>
            <div class="space-y-1">
              <label class="font-medium text-[#09090b] text-xs">Badge Highlight Mitra</label>
              <input
                type="text"
                id="cms-input-badge"
                placeholder="Mitra Unggulan Nasional"
                class="cms-field h-9 w-full rounded-md border border-[#e4e4e7] bg-white px-3 text-sm focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
              />
            </div>
            <div class="space-y-1">
              <label class="font-medium text-[#09090b] text-xs">Batas Akhir Pendaftaran</label>
              <input
                type="text"
                id="cms-input-deadline"
                placeholder="25 Oktober 2026 • 23:59 WIB"
                class="cms-field h-9 w-full rounded-md border border-[#e4e4e7] bg-white px-3 text-sm focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
              />
            </div>
          </div>
        </div>

        <!-- Section Deskripsi Narasi Hero Mitra -->
        <div class="rounded-xl border border-[#e4e4e7] bg-white p-5 space-y-2.5 shadow-none">
          <div class="border-b border-[#f4f4f5] pb-2">
            <h3 class="font-semibold text-sm text-[#09090b]">Deskripsi Narasi Hero Mitra</h3>
            <p class="text-xs text-[#71717a]">Narasi profil mitra yang tampil di kotak utama halaman publik mahasiswa.</p>
          </div>
          <textarea
            id="cms-input-deskripsi-hero"
            rows="4"
            placeholder="Tuliskan narasi profil kemitraan..."
            class="cms-field w-full rounded-md border border-[#e4e4e7] bg-white p-3 text-sm focus:outline-none focus:ring-1 focus:ring-[#0655a7] leading-relaxed"
          ></textarea>
        </div>
      </div>

      <!-- Kolom Kanan: Fasilitas & Profil Koordinator/PIC (5 Kolom) -->
      <div class="lg:col-span-5 space-y-4">
        <!-- Section Poin Keunggulan / Fasilitas -->
        <div class="rounded-xl border border-[#e4e4e7] bg-white p-5 space-y-3 shadow-none">
          <div class="border-b border-[#f4f4f5] pb-2">
            <h3 class="font-semibold text-sm text-[#09090b]">Poin Keunggulan & Fasilitas</h3>
            <p class="text-xs text-[#71717a]">3 benefit utama yang diperoleh mahasiswa selama berkegiatan di mitra ini.</p>
          </div>
          <div class="space-y-2.5">
            <div class="space-y-1">
              <label class="font-medium text-[#71717a] text-xs">Poin Fasilitas 1</label>
              <input
                type="text"
                id="cms-input-poin-1"
                placeholder="Sertifikasi Global Industri"
                class="cms-field h-9 w-full rounded-md border border-[#e4e4e7] bg-white px-3 text-sm focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
              />
            </div>
            <div class="space-y-1">
              <label class="font-medium text-[#71717a] text-xs">Poin Fasilitas 2</label>
              <input
                type="text"
                id="cms-input-poin-2"
                placeholder="Uang Saku Pembinaan Mitra"
                class="cms-field h-9 w-full rounded-md border border-[#e4e4e7] bg-white px-3 text-sm focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
              />
            </div>
            <div class="space-y-1">
              <label class="font-medium text-[#71717a] text-xs">Poin Fasilitas 3</label>
              <input
                type="text"
                id="cms-input-poin-3"
                placeholder="Pendampingan Mentor Profesional"
                class="cms-field h-9 w-full rounded-md border border-[#e4e4e7] bg-white px-3 text-sm focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
              />
            </div>
          </div>
        </div>

        <!-- Section Profil Koordinator / PIC Mitra (Presisi & Rapi) -->
        <div class="rounded-xl border border-[#e4e4e7] bg-white p-5 space-y-3.5 shadow-none">
          <div class="border-b border-[#f4f4f5] pb-2">
            <h3 class="font-semibold text-sm text-[#09090b]">Profil Koordinator / PIC Mitra</h3>
            <p class="text-xs text-[#71717a]">Foto dan penanggung jawab yang tampil di kartu hero publik mitra.</p>
          </div>
          <div class="flex items-start gap-4">
            <!-- Wadah Foto Potret Persegi Presisi -->
            <div class="flex flex-col items-center gap-2 shrink-0">
              <div class="h-28 w-24 rounded-lg border border-[#e4e4e7] bg-[#f4f4f5] overflow-hidden flex items-center justify-center shadow-none">
                <img id="cms-koor-foto-preview" src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&q=80&w=256" alt="Koordinator" class="h-full w-full object-cover object-top" />
              </div>
              <label class="inline-flex items-center justify-center gap-1.5 h-7 px-2.5 rounded-md border border-[#e4e4e7] bg-white hover:bg-[#f4f4f5] text-[11px] font-medium text-[#09090b] cursor-pointer transition-colors whitespace-nowrap">
                <i data-lucide="upload" class="w-3 h-3 text-[#0655a7]"></i>
                <span>Ganti Foto</span>
                <input type="file" accept="image/*" onchange="handleCmsPhotoUpload(event)" class="hidden" id="cms-file-input" />
              </label>
            </div>

            <!-- Form Nama & Jabatan -->
            <div class="space-y-2.5 flex-1 min-w-0">
              <div class="space-y-1">
                <label class="font-medium text-[#71717a] text-xs">Nama Lengkap Koordinator *</label>
                <input
                  type="text"
                  id="cms-input-koor-nama"
                  placeholder="Nurul Anisa S.W., M.Cs"
                  class="cms-field h-9 w-full rounded-md border border-[#e4e4e7] bg-white px-3 text-sm focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
                />
              </div>
              <div class="space-y-1">
                <label class="font-medium text-[#71717a] text-xs">Jabatan / Posisi *</label>
                <input
                  type="text"
                  id="cms-input-koor-jabatan"
                  placeholder="Koordinator Kampus Berdampak FIK UDINUS"
                  class="cms-field h-9 w-full rounded-md border border-[#e4e4e7] bg-white px-3 text-sm focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
                />
              </div>
              <p id="cms-foto-status" class="text-[11px] text-[#71717a]">Format PNG transparan dianjurkan.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- PANE 2: SHOWCASE HASIL KARYA PROYEK MAHASISWA -->
  <div id="pane-cms-showcase" class="space-y-4 hidden">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 p-4 rounded-xl border border-[#e4e4e7] bg-white">
      <div>
        <h3 class="font-semibold text-sm text-[#09090b]">Portofolio Capstone Project Mahasiswa</h3>
        <p class="text-xs text-[#71717a] mt-0.5">Daftar produk, prototipe, dan riset mahasiswa binaan untuk dipamerkan di etalase publik program.</p>
      </div>
      <button
        type="button"
        onclick="openShowcaseModal()"
        id="btn-tambah-showcase"
        class="inline-flex items-center gap-2 h-9 px-4 text-xs font-medium rounded-md bg-[#0655a7] hover:bg-[#0655a7]/90 text-white transition-colors shrink-0"
      >
        <i data-lucide="plus" class="w-4 h-4"></i>
        <span>Tambah Proyek Showcase</span>
      </button>
    </div>

    <!-- Grid Kartu Showcase -->
    <div id="cms-showcase-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      <!-- Dynamically rendered via renderShowcaseGrid() -->
    </div>
  </div>
</div>
