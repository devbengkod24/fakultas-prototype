---
// src/layouts/MahasiswaShell.astro
// @ts-nocheck
interface Props {
  title?: string;
  pageTitle?: string;
  subtitle?: string;
  breadcrumb?: string;
  activeNav?:
    | "dashboard"
    | "pengumuman"
    | "katalog"
    | "pendaftaran"
    | "status"
    | "dosen-pembimbing"
    | "logbook"
    | "konversi-sks"
    | "sidang"
    | "sertifikat"
    | "log-aktivitas"
    | string;
}

const {
  activeNav = "dashboard",
  breadcrumb = activeNav === "dashboard"
    ? "Dashboard"
    : activeNav === "pengumuman"
      ? "Pengumuman"
      : activeNav === "pendaftaran"
        ? "Pendaftaran Kampus Berdampak"
        : activeNav === "status"
          ? "Status Pengajuan"
          : activeNav === "dosen-pembimbing"
            ? "Dosen Pembimbing"
            : activeNav === "logbook"
              ? "Logbook Kegiatan"
              : activeNav === "konversi-sks"
                ? "Pengajuan Konversi"
                : activeNav === "sidang"
                  ? "Sidang Evaluasi Akhir"
                  : activeNav === "sertifikat"
                    ? "Sertifikat & Luaran"
                    : activeNav === "log-aktivitas"
                      ? "Log Aktivitas"
                      : "Dashboard",
  pageTitle = breadcrumb,
  title = `${pageTitle} | Mahasiswa Kampus Berdampak - FIK Udinus`,
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    <!-- Google Fonts: Inter (Standar Selaras dengan Admin) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap"
      rel="stylesheet"
    />

    <!-- Tailwind CSS CDN (Tema Selaras dengan Admin) -->
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <script is:inline>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              sans: ["Inter", "system-ui", "-apple-system", "sans-serif"],
            },
            colors: {
              brand: {
                DEFAULT: "#0655a7",
                dark: "#114d91",
                light: "#f1f7fe",
              },
              primary: {
                50: "#F1F7FE",
                100: "#E2EEFC",
                200: "#BFDBF8",
                300: "#86BEF3",
                400: "#1E7FD9",
                500: "#1E7FD9",
                600: "#1063B9",
                700: "#114D91",
                800: "#10447C",
                900: "#133A67",
                950: "#0D2544",
              },
              secondary: {
                50: "#FEFAEC",
                100: "#FCEEC9",
                200: "#F8DB8F",
                300: "#F4BD45",
                400: "#F2AB2D",
                500: "#F3BC45",
                600: "#D0670F",
              },
            },
            boxShadow: {
              "2xs": "0 1px 2px 0 rgba(0, 0, 0, 0.05)",
            },
          },
        },
      };
    </script>

    <!-- Lucide Icons CDN -->
    <script is:inline src="https://unpkg.com/lucide@latest"></script>

    <!-- Alpine.js Core CDN (defer) -->
    <script
      is:inline
      defer
      src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.8/dist/cdn.min.js"
    ></script>

    <!-- Inisialisasi State Store Simulasi Mahasiswa -->
    <script is:inline>
      (function () {
        const STORAGE_KEY = "fik_mahasiswa_sim_state";

        function initMahasiswaStore() {
          if (!window.Alpine || window.Alpine.store("mahasiswaSim")) return;

          let savedState = "aktif";
          try {
            savedState = localStorage.getItem(STORAGE_KEY) || "aktif";
            if (savedState !== "belum_daftar" && savedState !== "aktif") {
              savedState = "aktif";
            }
          } catch (e) {
            console.warn("localStorage read error:", e);
          }

          window.Alpine.store("mahasiswaSim", {
            state: savedState,

            setState(newState) {
              if (newState !== "belum_daftar" && newState !== "aktif") return;
              this.state = newState;
              try {
                localStorage.setItem(STORAGE_KEY, newState);
              } catch (e) {
                console.warn("localStorage write error:", e);
              }
              window.dispatchEvent(
                new CustomEvent("mahasiswa-sim-changed", {
                  detail: { state: newState },
                }),
              );
              setTimeout(() => {
                if (window.lucide) {
                  window.lucide.createIcons();
                }
              }, 50);
            },

            isBelumDaftar() {
              return this.state === "belum_daftar";
            },

            isAktif() {
              return this.state === "aktif";
            },

            toggle() {
              this.setState(
                this.state === "belum_daftar" ? "aktif" : "belum_daftar",
              );
            },
          });
        }

        if (window.Alpine) {
          initMahasiswaStore();
        } else {
          document.addEventListener("alpine:init", initMahasiswaStore);
        }
      })();
    </script>

    <style is:global>
      [x-cloak] {
        display: none !important;
      }
      html,
      body {
        min-height: 100vh;
        margin: 0;
      }
      body {
        font-family:
          "Inter",
          system-ui,
          -apple-system,
          sans-serif;
      }
      .nav-active {
        color: #0655a7 !important;
        font-weight: 500 !important;
        background-color: rgba(6, 85, 167, 0.08) !important;
        position: relative;
      }
      .nav-active .active-bar {
        display: block !important;
      }
      .nav-active i {
        color: #0655a7 !important;
      }
      /* [DIHAPUS] Dosen Pembimbing */
      .nav-dospem-hide {
        display: none !important;
      }
    </style>
  </head>
  <body
    x-data
    class="min-h-screen bg-[#fafafa] text-[#09090b] antialiased overflow-x-hidden"
  >
    <div class="flex min-h-screen w-full bg-[#fafafa]">
      <!-- ==================================================== -->
      <!-- 1. SIDEBAR MAHASISWA (SELARAS 100% DENGAN ADMIN)     -->
      <!-- ==================================================== -->
      <aside
        id="sidebar"
        class="w-64 shrink-0 bg-[#fafafa] flex flex-col justify-between p-3 border-r border-[#e4e4e7]/60 min-h-screen sticky top-0 h-screen overflow-y-auto transition-all duration-200"
      >
        <div class="flex flex-col gap-2">
          <!-- Logo Institusi UDINUS -->
          <div class="flex items-center gap-2.5 p-2 mb-1">
            <img
              src="/assets/logo.png"
              alt="Logo UDINUS"
              class="object-contain w-9 h-9"
            />
            <div class="flex flex-col leading-tight">
              <span
                class="text-[11px] font-extrabold text-[#114d91] tracking-wider uppercase"
                >UNIVERSITAS</span
              >
              <span
                class="text-[11px] font-extrabold text-[#114d91] tracking-wider uppercase"
                >DIAN NUSWANTORO</span
              >
            </div>
          </div>

          <!-- Kartu Identitas Modul Sub-App (AppSwitcher) -->
          <div
            class="w-full h-12 p-2 flex items-center justify-between bg-white border border-[#e4e4e7] rounded-lg shadow-none"
          >
            <div class="flex items-center gap-2.5 overflow-hidden">
              <div
                class="w-8 h-8 rounded bg-[#114d91] text-white flex items-center justify-center shrink-0"
              >
                <i data-lucide="award" class="w-4 h-4"></i>
              </div>
              <div class="flex flex-col overflow-hidden leading-tight">
                <span class="text-[13px] font-semibold text-[#3f3f46] truncate"
                  >Kampus Berdampak</span
                >
                <span class="text-[11px] text-[#71717a] truncate"
                  >Mahasiswa</span
                >
              </div>
            </div>
            <i
              data-lucide="chevrons-up-down"
              class="w-4 h-4 text-[#71717a] shrink-0"></i>
          </div>

          <!-- Menu Navigasi Mahasiswa (Style Selaras Admin) -->
          <nav class="flex flex-col gap-1 mt-2">
            <!-- 1. Dashboard -->
            <a
              href="/mahasiswa/dashboard"
              id="nav-dashboard"
              class={`nav-item relative flex items-center gap-3 px-4 py-2.5 rounded-lg text-[14px] font-normal hover:bg-black/5 transition-colors text-left w-full ${
                activeNav === "dashboard"
                  ? "nav-active text-[#0655a7]"
                  : "text-[#3f3f46]"
              }`}
            >
              <span
                class={`active-bar absolute left-0 top-2 bottom-2 w-1 bg-[#0655a7] rounded-r-md ${activeNav === "dashboard" ? "" : "hidden"}`}
              ></span>
              <i
                data-lucide="layout-dashboard"
                class={`w-4 h-4 shrink-0 ${activeNav === "dashboard" ? "text-[#0655a7]" : "text-[#71717a]"}`}
              ></i>
              <span class="truncate">Dashboard</span>
            </a>

            <!-- 2. Pengumuman -->
            <a
              href="/mahasiswa/pengumuman"
              id="nav-pengumuman"
              class={`nav-item relative flex items-center gap-3 px-4 py-2.5 rounded-lg text-[14px] font-normal hover:bg-black/5 transition-colors text-left w-full ${
                activeNav === "pengumuman"
                  ? "nav-active text-[#0655a7]"
                  : "text-[#3f3f46]"
              }`}
            >
              <span
                class={`active-bar absolute left-0 top-2 bottom-2 w-1 bg-[#0655a7] rounded-r-md ${activeNav === "pengumuman" ? "" : "hidden"}`}
              ></span>
              <i
                data-lucide="megaphone"
                class={`w-4 h-4 shrink-0 ${activeNav === "pengumuman" ? "text-[#0655a7]" : "text-[#71717a]"}`}
              ></i>
              <span class="truncate">Pengumuman</span>
            </a>

            <!-- 3. Pendaftaran Kampus Berdampak -->
            <a
              href="/mahasiswa/pendaftaran"
              id="nav-pendaftaran"
              class={`nav-item relative flex items-center gap-3 px-4 py-2.5 rounded-lg text-[14px] font-normal hover:bg-black/5 transition-colors text-left w-full ${
                activeNav === "pendaftaran"
                  ? "nav-active text-[#0655a7]"
                  : "text-[#3f3f46]"
              }`}
            >
              <span
                class={`active-bar absolute left-0 top-2 bottom-2 w-1 bg-[#0655a7] rounded-r-md ${activeNav === "pendaftaran" ? "" : "hidden"}`}
              ></span>
              <i
                data-lucide="clipboard-list"
                class={`w-4 h-4 shrink-0 ${activeNav === "pendaftaran" ? "text-[#0655a7]" : "text-[#71717a]"}`}
              ></i>
              <span class="truncate">Pendaftaran KB</span>
            </a>

            <!-- 4. Dosen Pembimbing (DIHAPUS) -->
            <div class="nav-dospem-hide">
              <a
                href="/mahasiswa/dosen-pembimbing"
                id="nav-dosen-pembimbing"
                :class="$store.mahasiswaSim.state === 'belum_daftar' ? 'opacity-50 pointer-events-none select-none' : ''"
                class={`nav-item relative flex items-center gap-3 px-4 py-2.5 rounded-lg text-[14px] font-normal hover:bg-black/5 transition-colors text-left w-full ${
                  activeNav === "dosen-pembimbing"
                    ? "nav-active text-[#0655a7]"
                    : "text-[#3f3f46]"
                }`}
              >
                <span
                  class={`active-bar absolute left-0 top-2 bottom-2 w-1 bg-[#0655a7] rounded-r-md ${activeNav === "dosen-pembimbing" ? "" : "hidden"}`}
                ></span>
                <i
                  data-lucide="graduation-cap"
                  class={`w-4 h-4 shrink-0 ${activeNav === "dosen-pembimbing" ? "text-[#0655a7]" : "text-[#71717a]"}`}
                ></i>
                <span class="truncate flex-1">Dosen Pembimbing</span>
                <span
                  x-show="$store.mahasiswaSim.state === 'belum_daftar'"
                  class="text-[#71717a] ml-auto"
                >
                  <i data-lucide="lock" class="w-3.5 h-3.5"></i>
                </span>
              </a>
            </div>

            <!-- 5. Logbook Kegiatan (Terkunci jika belum aktif) -->
            <div
              :class="$store.mahasiswaSim.state === 'belum_daftar' ? 'cursor-not-allowed' : ''"
              title={activeNav !== "logbook"
                ? "Terkunci: Memerlukan status pendaftaran diterima"
                : undefined}
            >
              <a
                href="/mahasiswa/logbook"
                id="nav-logbook"
                :class="$store.mahasiswaSim.state === 'belum_daftar' ? 'opacity-50 pointer-events-none select-none' : ''"
                class={`nav-item relative flex items-center gap-3 px-4 py-2.5 rounded-lg text-[14px] font-normal hover:bg-black/5 transition-colors text-left w-full ${
                  activeNav === "logbook"
                    ? "nav-active text-[#0655a7]"
                    : "text-[#3f3f46]"
                }`}
              >
                <span
                  class={`active-bar absolute left-0 top-2 bottom-2 w-1 bg-[#0655a7] rounded-r-md ${activeNav === "logbook" ? "" : "hidden"}`}
                ></span>
                <i
                  data-lucide="book-open"
                  class={`w-4 h-4 shrink-0 ${activeNav === "logbook" ? "text-[#0655a7]" : "text-[#71717a]"}`}
                ></i>
                <span class="truncate flex-1">Logbook Kegiatan</span>
                <span
                  x-show="$store.mahasiswaSim.state === 'belum_daftar'"
                  class="text-[#71717a] ml-auto"
                >
                  <i data-lucide="lock" class="w-3.5 h-3.5"></i>
                </span>
              </a>
            </div>

            <!-- 6. Pengajuan Konversi (Terkunci jika belum aktif) -->
            <div
              :class="$store.mahasiswaSim.state === 'belum_daftar' ? 'cursor-not-allowed' : ''"
              title={activeNav !== "konversi-sks"
                ? "Terkunci: Memerlukan status pendaftaran diterima"
                : undefined}
            >
              <a
                href="/mahasiswa/konversi-sks"
                id="nav-konversi-sks"
                :class="$store.mahasiswaSim.state === 'belum_daftar' ? 'opacity-50 pointer-events-none select-none' : ''"
                class={`nav-item relative flex items-center gap-3 px-4 py-2.5 rounded-lg text-[14px] font-normal hover:bg-black/5 transition-colors text-left w-full ${
                  activeNav === "konversi-sks"
                    ? "nav-active text-[#0655a7]"
                    : "text-[#3f3f46]"
                }`}
              >
                <span
                  class={`active-bar absolute left-0 top-2 bottom-2 w-1 bg-[#0655a7] rounded-r-md ${activeNav === "konversi-sks" ? "" : "hidden"}`}
                ></span>
                <i
                  data-lucide="layers"
                  class={`w-4 h-4 shrink-0 ${activeNav === "konversi-sks" ? "text-[#0655a7]" : "text-[#71717a]"}`}
                ></i>
                <span class="truncate flex-1">Pengajuan Konversi</span>
                <span
                  x-show="$store.mahasiswaSim.state === 'belum_daftar'"
                  class="text-[#71717a] ml-auto"
                >
                  <i data-lucide="lock" class="w-3.5 h-3.5"></i>
                </span>
              </a>
            </div>

            <!-- 7. Sidang Evaluasi Akhir (Terkunci jika belum aktif) -->
            <div
              :class="$store.mahasiswaSim.state === 'belum_daftar' ? 'cursor-not-allowed' : ''"
              title={activeNav !== "sidang"
                ? "Terkunci: Memerlukan status pendaftaran diterima"
                : undefined}
            >
              <a
                href="/mahasiswa/sidang"
                id="nav-sidang"
                :class="$store.mahasiswaSim.state === 'belum_daftar' ? 'opacity-50 pointer-events-none select-none' : ''"
                class={`nav-item relative flex items-center gap-3 px-4 py-2.5 rounded-lg text-[14px] font-normal hover:bg-black/5 transition-colors text-left w-full ${
                  activeNav === "sidang"
                    ? "nav-active text-[#0655a7]"
                    : "text-[#3f3f46]"
                }`}
              >
                <span
                  class={`active-bar absolute left-0 top-2 bottom-2 w-1 bg-[#0655a7] rounded-r-md ${activeNav === "sidang" ? "" : "hidden"}`}
                ></span>
                <i
                  data-lucide="calendar-check"
                  class={`w-4 h-4 shrink-0 ${activeNav === "sidang" ? "text-[#0655a7]" : "text-[#71717a]"}`}
                ></i>
                <span class="truncate flex-1">Pengajuan Sidang</span>
                <span
                  x-show="$store.mahasiswaSim.state === 'belum_daftar'"
                  class="text-[#71717a] ml-auto"
                >
                  <i data-lucide="lock" class="w-3.5 h-3.5"></i>
                </span>
              </a>
            </div>
          </nav>
        </div>

        <!-- Footer Profil Mahasiswa (Selaras Admin / Koordinator) -->
        <div class="sticky bottom-0 z-10 mt-auto bg-[#fafafa] pt-2 pb-1 -mx-1 px-1 flex flex-col gap-2">
          <!-- Toggle Status Pengajuan: Belum Diterima / Sudah Diterima -->
          <div
            class="w-full h-10 p-2 flex items-center justify-between bg-white border border-[#e4e4e7] rounded-lg shadow-none"
            x-cloak
          >
            <button
              type="button"
              role="switch"
              aria-label="Ubah status pengajuan mahasiswa"
              :aria-checked="$store.mahasiswaSim.state === 'aktif'"
              @click="$store.mahasiswaSim.toggle()"
              class="flex items-center gap-2 cursor-pointer shrink-0"
              title="Ubah status: Belum Diterima / Sudah Diterima"
            >
              <span
                class="relative inline-flex h-[18px] w-[34px] shrink-0 items-center rounded-full transition-colors duration-200"
                :class="$store.mahasiswaSim.state === 'aktif'
                  ? 'bg-[#3f5f9e]'
                  : 'bg-[#d4d4d8]'"
              >
                <span
                  class="inline-block h-3 w-3 rounded-full bg-white shadow-sm transition-transform duration-200"
                  :class="$store.mahasiswaSim.state === 'aktif'
                    ? 'translate-x-[18px]'
                    : 'translate-x-[3px]'"
                ></span>
              </span>
              <span
                class="text-[11px] font-semibold transition-colors"
                :class="$store.mahasiswaSim.state === 'aktif'
                  ? 'text-[#4b9148]'
                  : 'text-[#a1a1aa]'"
                x-text="$store.mahasiswaSim.state === 'aktif'
                  ? 'Sudah Diterima'
                  : 'Belum Diterima'"
              ></span>
            </button>
          </div>

          <div
            class="w-full h-14 p-2 flex items-center justify-between bg-white border border-[#e4e4e7] rounded-lg shadow-sm"
          >
            <div class="flex items-center gap-2.5 overflow-hidden">
              <div
                class="w-8 h-8 rounded-full bg-[#114d91] text-white font-semibold text-xs flex items-center justify-center shrink-0"
              >
                N
              </div>
              <div class="flex flex-col overflow-hidden leading-tight">
                <span
                  class="text-[12px] font-semibold text-[#09090b] truncate"
                  title="Mhs TA KB A11"
                  >Mhs TA KB A11</span
                >
                <span
                  class="text-[10px] text-[#71717a] font-medium px-1.5 py-0.5 border border-[#e4e4e7] rounded bg-[#fafafa] w-fit truncate mt-0.5"
                >
                  Teknik Informatika (A11)
                </span>
              </div>
            </div>
            <a
              href="/login"
              title="Keluar / Logout"
              class="text-[#71717a] hover:text-[#09090b] p-1.5 rounded hover:bg-gray-100 transition-colors shrink-0"
            >
              <i data-lucide="log-out" class="w-4 h-4"></i>
            </a>
          </div>
        </div>
      </aside>

      <!-- ==================================================== -->
      <!-- 2. MAIN CANVAS CONTAINER (SELARAS 100% DENGAN KP)     -->
      <!-- ==================================================== -->
      <main
        class="flex flex-col flex-1 p-4 my-4 mr-4 ml-4 lg:ml-0 bg-white border border-[#e4e4e7] rounded-xl min-h-[calc(100vh-2rem)]"
      >
        <!-- Top Breadcrumb Header Bar 1 -->
        <header class="flex w-full items-center justify-between pb-3 shrink-0">
          <div class="flex items-center gap-2">
            <button
              type="button"
              onclick="document.getElementById('sidebar').classList.toggle('-ml-64')"
              class="h-7 w-7 flex items-center justify-center rounded-md border border-[#e4e4e7] bg-white text-[#09090b] hover:bg-[#f4f4f5] transition-colors"
              title="Toggle Sidebar"
            >
              <i data-lucide="panel-left" class="w-4 h-4 text-[#71717a]"></i>
            </button>
            <div class="h-4 w-[1px] bg-[#e4e4e7] mx-1"></div>
            <nav
              id="breadcrumb-container"
              class="flex items-center gap-2 text-sm text-[#71717a]"
            >
              <div
                class="bg-white border border-[#e4e4e7] py-1 px-2.5 rounded-lg text-xs font-medium text-[#09090b] shadow-none flex items-center gap-1.5"
              >
                Dashboard
              </div>
            </nav>
          </div>
        </header>

        <!-- Full-width Separator (Edge-to-Edge) -->
        <div
          class="w-[calc(100%+2rem)] -mx-4 border-b border-[#e4e4e7] my-3 shrink-0"
        >
        </div>

        <!-- Container Konten Halaman (Isi Asli Mahasiswa) -->
        <div class="flex-1 w-full flex flex-col">
          <slot />
        </div>
      </main>
    </div>

    <!-- Runtime Script Mahasiswa -->
    <script is:inline src="/mahasiswa/_mock-data.js"></script>
    <script is:inline src="/mahasiswa/_controller.js"></script>
    <script is:inline>
      document.addEventListener("DOMContentLoaded", () => {
        if (window.lucide) {
          window.lucide.createIcons();
        }
      });
    </script>
  </body>
</html>
