---
// src/layouts/MahasiswaShell.astro
interface Props {
  title?: string;
  pageTitle?: string;
  subtitle?: string;
  breadcrumb?: string;
  activeNav?: 'dashboard' | 'eksplorasi' | 'lamaran' | 'logbook' | 'laporan' | string;
}

const {
  title = "Dashboard Mahasiswa | Kampus Berdampak - FIK Udinus",
  pageTitle = "Dashboard Mahasiswa",
  subtitle = "Verifikasi data akademik Anda dari database dan mulai pendaftaran program MBKM.",
  breadcrumb = "Dashboard",
  activeNav = "dashboard"
} = Astro.props;
---

<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>

  <!-- Google Fonts: Inter (Standar Selaras dengan Admin) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap"
    rel="stylesheet"
  />

  <!-- Tailwind CSS CDN (Tema Selaras dengan Admin) -->
  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <script is:inline>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'system-ui', '-apple-system', 'sans-serif'],
          },
          colors: {
            brand: {
              DEFAULT: '#0655a7',
              dark: '#114d91',
              light: '#f1f7fe',
            },
            primary: {
              50: '#F1F7FE',
              100: '#E2EEFC',
              200: '#BFDBF8',
              300: '#86BEF3',
              400: '#1E7FD9',
              500: '#1E7FD9',
              600: '#1063B9',
              700: '#114D91',
              800: '#10447C',
              900: '#133A67',
              950: '#0D2544',
            },
            secondary: {
              50: '#FEFAEC',
              100: '#FCEEC9',
              200: '#F8DB8F',
              300: '#F4BD45',
              400: '#F2AB2D',
              500: '#F3BC45',
              600: '#D0670F',
            },
          },
          boxShadow: {
            '2xs': '0 1px 2px 0 rgba(0, 0, 0, 0.05)',
          },
        },
      },
    };
  </script>

  <!-- Lucide Icons CDN -->
  <script is:inline src="https://unpkg.com/lucide@latest"></script>

  <!-- Alpine.js Core CDN (defer) -->
  <script is:inline defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.8/dist/cdn.min.js"></script>

  <style is:global>
    [x-cloak] {
      display: none !important;
    }
    html,
    body {
      min-height: 100vh;
      margin: 0;
    }
    body {
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
    }
    .nav-active {
      color: #0655a7 !important;
      font-weight: 500 !important;
      background-color: rgba(6, 85, 167, 0.08) !important;
      position: relative;
    }
    .nav-active .active-bar {
      display: block !important;
    }
    .nav-active i {
      color: #0655a7 !important;
    }

    /* Helper Content Styles Khusus Halaman Mahasiswa */
    :root {
      --primary: #0655A7;
      --primary-light: #1e7fd9;
      --primary-subtle: #f1f7fe;
      --secondary: #f4bd45;
    }
    .status-hero {
      border-radius: 12px;
      padding: 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 20px;
    }
    .card {
      background: #ffffff;
      border: 1px solid #e4e4e7;
      border-radius: 12px;
      padding: 18px;
    }
    .card-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 12px;
    }
    .stat-value {
      font-size: 26px;
      font-weight: 700;
      color: #09090b;
    }
    .stat-card-accent {
      width: 32px;
      height: 32px;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .accent-blue { background: #eff6ff; color: #0655A7; }
    .accent-green { background: #f0fdf4; color: #16a34a; }
    .badge {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      font-size: 11px;
      font-weight: 600;
      padding: 3px 8px;
      border-radius: 6px;
    }
    .badge-success { background: #dcfce7; color: #15803d; border: 1px solid #bbf7d0; }
    .badge-warning { background: #fef3c7; color: #b45309; border: 1px solid #fde68a; }
    .badge-primary { background: #e0f2fe; color: #0369a1; border: 1px solid #bae6fd; }
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      font-size: 13px;
      font-weight: 600;
      padding: 8px 16px;
      border-radius: 8px;
      cursor: pointer;
      border: none;
      text-decoration: none;
      transition: all 0.15s ease;
    }
    .btn-primary { background: #0655A7; color: #fff; }
    .btn-primary:hover { background: #054587; }
    .btn-outline { background: #fff; color: #09090b; border: 1px solid #e4e4e7; }
    .btn-outline:hover { background: #f4f4f5; }
    .btn-lg { padding: 10px 20px; font-size: 14px; }
    .btn-sm { padding: 5px 10px; font-size: 12px; }
    .grid-2 { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
    .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
    .grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
    @media (max-width: 768px) {
      .grid-2, .grid-3, .grid-4 { grid-template-columns: 1fr; }
      .status-hero { flex-direction: column; align-items: flex-start; }
    }
    .alert {
      padding: 14px 18px;
      border-radius: 10px;
      display: flex;
      gap: 12px;
      align-items: flex-start;
      margin-bottom: 16px;
    }
    .alert-warning { background: #fffbeb; border: 1px solid #fef3c7; color: #92400e; }
    .alert-destructive { background: #fef2f2; border: 1px solid #fee2e2; color: #991b1b; }
    .alert-title { font-weight: 700; font-size: 14px; margin-bottom: 2px; }
    .alert-desc { font-size: 12.5px; opacity: 0.95; line-height: 1.5; }
  </style>
</head>
<body x-data class="min-h-screen bg-[#fafafa] text-[#09090b] antialiased overflow-x-hidden">
  <div class="flex min-h-screen w-full bg-[#fafafa]">

    <!-- ==================================================== -->
    <!-- 1. SIDEBAR MAHASISWA (SELARAS 100% DENGAN ADMIN)     -->
    <!-- ==================================================== -->
    <aside
      id="sidebar"
      class="w-64 shrink-0 bg-[#fafafa] flex flex-col justify-between p-3 border-r border-[#e4e4e7]/60 min-h-screen sticky top-0 h-screen overflow-y-auto transition-all duration-200"
    >
      <div class="flex flex-col gap-2">
        <!-- Logo Institusi UDINUS -->
        <div class="flex items-center gap-2.5 p-2 mb-1">
          <img
            src="/assets/logo.png"
            alt="Logo UDINUS"
            class="object-contain w-9 h-9"
            onerror="this.src = 'https://dinus.ac.id/img/logo-dinus.png'"
          />
          <div class="flex flex-col leading-tight">
            <span class="text-[11px] font-extrabold text-[#114d91] tracking-wider uppercase">UNIVERSITAS</span>
            <span class="text-[11px] font-extrabold text-[#114d91] tracking-wider uppercase">DIAN NUSWANTORO</span>
          </div>
        </div>

        <!-- Kartu Identitas Modul Sub-App -->
        <div class="w-full h-12 p-2 flex items-center justify-between bg-white border border-[#e4e4e7] rounded-lg shadow-none">
          <div class="flex items-center gap-2.5 overflow-hidden">
            <div class="w-8 h-8 rounded bg-[#114d91] text-white flex items-center justify-center shrink-0">
              <i data-lucide="graduation-cap" class="w-4 h-4"></i>
            </div>
            <div class="flex flex-col overflow-hidden leading-tight">
              <span class="text-[13px] font-semibold text-[#3f3f46] truncate">Kampus Berdampak</span>
              <span class="text-[11px] text-[#71717a] truncate">Portal Mahasiswa</span>
            </div>
          </div>
          <i data-lucide="chevrons-up-down" class="w-4 h-4 text-[#71717a] shrink-0"></i>
        </div>

        <!-- Menu Navigasi Mahasiswa (Style Selaras Admin) -->
        <nav class="flex flex-col gap-1 mt-2">
          <!-- 1. Dashboard -->
          <a
            href="/mahasiswa/dashboard"
            id="nav-dashboard"
            class={`nav-item relative flex items-center gap-3 px-4 py-2.5 rounded-lg text-[14px] font-normal hover:bg-black/5 transition-colors text-left w-full ${
              activeNav === 'dashboard' ? 'nav-active text-[#0655a7]' : 'text-[#3f3f46]'
            }`}
          >
            <span class={`active-bar absolute left-0 top-2 bottom-2 w-1 bg-[#0655a7] rounded-r-md ${activeNav === 'dashboard' ? '' : 'hidden'}`}></span>
            <i data-lucide="layout-dashboard" class={`w-4 h-4 shrink-0 ${activeNav === 'dashboard' ? 'text-[#0655a7]' : 'text-[#71717a]'}`}></i>
            <span class="truncate">Dashboard</span>
          </a>

          <!-- 2. Pengumuman -->
          <a
            href="/mahasiswa/dashboard#pengumuman"
            id="nav-pengumuman"
            class={`nav-item relative flex items-center gap-3 px-4 py-2.5 rounded-lg text-[14px] font-normal hover:bg-black/5 transition-colors text-left w-full ${
              activeNav === 'pengumuman' ? 'nav-active text-[#0655a7]' : 'text-[#3f3f46]'
            }`}
          >
            <span class={`active-bar absolute left-0 top-2 bottom-2 w-1 bg-[#0655a7] rounded-r-md ${activeNav === 'pengumuman' ? '' : 'hidden'}`}></span>
            <i data-lucide="megaphone" class={`w-4 h-4 shrink-0 ${activeNav === 'pengumuman' ? 'text-[#0655a7]' : 'text-[#71717a]'}`}></i>
            <span class="truncate">Pengumuman</span>
          </a>

          <!-- 3. Katalog Program (Pendaftaran MBKM) -->
          <a
            href="/mahasiswa/eksplorasi"
            id="nav-katalog"
            class={`nav-item relative flex items-center gap-3 px-4 py-2.5 rounded-lg text-[14px] font-normal hover:bg-black/5 transition-colors text-left w-full ${
              activeNav === 'eksplorasi' ? 'nav-active text-[#0655a7]' : 'text-[#3f3f46]'
            }`}
          >
            <span class={`active-bar absolute left-0 top-2 bottom-2 w-1 bg-[#0655a7] rounded-r-md ${activeNav === 'eksplorasi' ? '' : 'hidden'}`}></span>
            <i data-lucide="compass" class={`w-4 h-4 shrink-0 ${activeNav === 'eksplorasi' ? 'text-[#0655a7]' : 'text-[#71717a]'}`}></i>
            <span class="truncate">Katalog Program</span>
          </a>

          <!-- 4. Form Pendaftaran & Status Lamaran -->
          <a
            href="/mahasiswa/lamaran"
            id="nav-pendaftaran"
            class={`nav-item relative flex items-center gap-3 px-4 py-2.5 rounded-lg text-[14px] font-normal hover:bg-black/5 transition-colors text-left w-full ${
              activeNav === 'lamaran' ? 'nav-active text-[#0655a7]' : 'text-[#3f3f46]'
            }`}
          >
            <span class={`active-bar absolute left-0 top-2 bottom-2 w-1 bg-[#0655a7] rounded-r-md ${activeNav === 'lamaran' ? '' : 'hidden'}`}></span>
            <i data-lucide="clipboard-list" class={`w-4 h-4 shrink-0 ${activeNav === 'lamaran' ? 'text-[#0655a7]' : 'text-[#71717a]'}`}></i>
            <span class="truncate">Form Pendaftaran</span>
          </a>

          <!-- 5. Dosen Pembimbing -->
          <a
            href="/mahasiswa/dashboard#dosen-pembimbing"
            id="nav-dosen"
            class={`nav-item relative flex items-center gap-3 px-4 py-2.5 rounded-lg text-[14px] font-normal hover:bg-black/5 transition-colors text-left w-full ${
              activeNav === 'dosen' ? 'nav-active text-[#0655a7]' : 'text-[#3f3f46]'
            }`}
          >
            <span class={`active-bar absolute left-0 top-2 bottom-2 w-1 bg-[#0655a7] rounded-r-md ${activeNav === 'dosen' ? '' : 'hidden'}`}></span>
            <i data-lucide="user-check" class={`w-4 h-4 shrink-0 ${activeNav === 'dosen' ? 'text-[#0655a7]' : 'text-[#71717a]'}`}></i>
            <span class="truncate">Dosen Pembimbing</span>
          </a>

          <!-- 6. Logbook Mahasiswa -->
          <a
            href="/mahasiswa/logbook"
            id="nav-logbook"
            class={`nav-item relative flex items-center gap-3 px-4 py-2.5 rounded-lg text-[14px] font-normal hover:bg-black/5 transition-colors text-left w-full ${
              activeNav === 'logbook' ? 'nav-active text-[#0655a7]' : 'text-[#3f3f46]'
            }`}
          >
            <span class={`active-bar absolute left-0 top-2 bottom-2 w-1 bg-[#0655a7] rounded-r-md ${activeNav === 'logbook' ? '' : 'hidden'}`}></span>
            <i data-lucide="book-open" class={`w-4 h-4 shrink-0 ${activeNav === 'logbook' ? 'text-[#0655a7]' : 'text-[#71717a]'}`}></i>
            <span class="truncate">Logbook Kegiatan</span>
          </a>

          <!-- 7. Konversi SKS -->
          <a
            href="/mahasiswa/dashboard#konversi-sks"
            id="nav-konversi"
            class={`nav-item relative flex items-center gap-3 px-4 py-2.5 rounded-lg text-[14px] font-normal hover:bg-black/5 transition-colors text-left w-full ${
              activeNav === 'konversi' ? 'nav-active text-[#0655a7]' : 'text-[#3f3f46]'
            }`}
          >
            <span class={`active-bar absolute left-0 top-2 bottom-2 w-1 bg-[#0655a7] rounded-r-md ${activeNav === 'konversi' ? '' : 'hidden'}`}></span>
            <i data-lucide="arrow-left-right" class={`w-4 h-4 shrink-0 ${activeNav === 'konversi' ? 'text-[#0655a7]' : 'text-[#71717a]'}`}></i>
            <span class="truncate">Konversi SKS</span>
          </a>

          <!-- 8. Sidang & Laporan Akhir -->
          <a
            href="/mahasiswa/laporan"
            id="nav-sidang"
            class={`nav-item relative flex items-center gap-3 px-4 py-2.5 rounded-lg text-[14px] font-normal hover:bg-black/5 transition-colors text-left w-full ${
              activeNav === 'laporan' || activeNav === 'sidang' ? 'nav-active text-[#0655a7]' : 'text-[#3f3f46]'
            }`}
          >
            <span class={`active-bar absolute left-0 top-2 bottom-2 w-1 bg-[#0655a7] rounded-r-md ${activeNav === 'laporan' || activeNav === 'sidang' ? '' : 'hidden'}`}></span>
            <i data-lucide="award" class={`w-4 h-4 shrink-0 ${activeNav === 'laporan' || activeNav === 'sidang' ? 'text-[#0655a7]' : 'text-[#71717a]'}`}></i>
            <span class="truncate">Sidang & Laporan</span>
          </a>
        </nav>
      </div>

      <!-- Footer Profil Mahasiswa (Selaras Admin) -->
      <div class="pt-2 mt-auto">
        <div class="w-full h-14 p-2 flex items-center justify-between bg-white border border-[#e4e4e7] rounded-lg shadow-none">
          <div class="flex items-center gap-2.5 overflow-hidden">
            <div class="w-8 h-8 rounded-full bg-[#114d91] text-white font-semibold text-xs flex items-center justify-center shrink-0">
              AR
            </div>
            <div class="flex flex-col overflow-hidden leading-tight">
              <span class="text-[12px] font-semibold text-[#09090b] truncate">Ahmad Rizky Pratama</span>
              <span class="text-[10px] text-[#71717a] font-medium px-1.5 py-0.5 border border-[#e4e4e7] rounded bg-[#fafafa] w-fit truncate mt-0.5">
                A11.2021.13782
              </span>
            </div>
          </div>
          <a href="/apps" title="Kembali ke Portal Apps" class="text-[#71717a] hover:text-[#09090b] p-1.5 rounded hover:bg-gray-100 transition-colors">
            <i data-lucide="log-out" class="w-4 h-4"></i>
          </a>
        </div>
      </div>
    </aside>

    <!-- ==================================================== -->
    <!-- 2. MAIN CANVAS CONTAINER (SELARAS DENGAN ADMIN)      -->
    <!-- ==================================================== -->
    <main class="flex flex-col flex-1 p-6 my-4 mr-4 ml-4 lg:ml-0 bg-white border border-[#e4e4e7] rounded-xl min-h-[calc(100vh-2rem)]">
      <!-- Top Breadcrumb Header Bar 1 -->
      <header class="flex w-full items-center justify-between pb-3 shrink-0">
        <div class="flex items-center gap-2">
          <button
            type="button"
            onclick="document.getElementById('sidebar').classList.toggle('-ml-64')"
            class="h-8 w-8 flex items-center justify-center rounded-md border border-[#e4e4e7] bg-white text-[#09090b] hover:bg-[#f4f4f5] transition-colors"
            title="Toggle Sidebar"
          >
            <i data-lucide="panel-left" class="w-4 h-4"></i>
          </button>
          <div class="h-4 w-[1px] bg-[#e4e4e7] mx-1"></div>
          <nav id="breadcrumb-container" class="flex items-center gap-2 text-sm text-[#71717a]">
            <span class="bg-white border border-[#e4e4e7] py-1 px-3 rounded-lg text-sm font-medium text-[#09090b] shadow-none">
              <span>{breadcrumb}</span>
            </span>
          </nav>
        </div>

        <!-- Global Role Switcher Demo -->
        <div class="flex items-center gap-1 bg-[#f4f4f5] p-1 rounded-lg text-xs">
          <span class="px-2 py-0.5 font-medium text-[#71717a]">Demo Role:</span>
          <a href="/mahasiswa/dashboard" class="px-2.5 py-1 rounded bg-white font-semibold text-[#0655a7] border border-[#e4e4e7]">Mahasiswa</a>
          <a href="/mitra/dashboard" class="px-2.5 py-1 rounded text-[#71717a] font-medium hover:bg-white transition-colors">Dosen/Mitra</a>
          <a href="/admin/dashboard" class="px-2.5 py-1 rounded text-[#71717a] font-medium hover:bg-white transition-colors">Admin</a>
        </div>
      </header>

      <!-- Full-width Separator (Selaras Admin) -->
      <div class="w-[calc(100%+3rem)] -mx-6 border-b border-[#e4e4e7] mb-5 shrink-0"></div>

      <!-- Dynamic Title Header Bar 2 -->
      <header class="mb-5 flex items-start justify-between gap-4 shrink-0">
        <div>
          <h2 class="text-xl font-normal text-[#09090b] tracking-tight">{pageTitle}</h2>
          <p class="text-sm text-[#71717a] mt-0.5">{subtitle}</p>
        </div>
      </header>

      <!-- Container Konten Halaman (Isi Asli Mahasiswa) -->
      <div class="flex-1 w-full flex flex-col">
        <slot />
      </div>
    </main>
  </div>

  <!-- Runtime Script Mahasiswa -->
  <script is:inline src="/mahasiswa/_mock-data.js"></script>
  <script is:inline src="/mahasiswa/_controller.js"></script>
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      if (window.lucide) {
        window.lucide.createIcons();
      }
    });
  </script>
</body>
</html>
