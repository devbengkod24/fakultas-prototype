---
// src/layouts/DosenShell.astro

interface Props {
  title?: string;
  pageTitle?: string;
  subtitle?: string;
  breadcrumb?: string;
  activeNav?:
    | 'dashboard'
    | 'mahasiswa'
    | 'logbook'
    | 'laporan-akhir'
    | 'sidang'
    | 'log-aktivitas'
    | string;
}

const {
  activeNav = "dashboard",
  breadcrumb = activeNav === 'dashboard' ? 'Dashboard' :
               activeNav === 'mahasiswa' ? 'Mahasiswa Bimbingan' :
               activeNav === 'logbook' ? 'Logbook Mahasiswa' :
               activeNav === 'laporan-akhir' ? 'Laporan Akhir' :
               activeNav === 'sidang' ? 'Sidang' :
               activeNav === 'log-aktivitas' ? 'Log Aktivitas' :
               'Dashboard',
  pageTitle = activeNav === 'dashboard' ? 'Selamat Datang, ADHITYA NUGRAHA di prodi Teknik Informatika - S1' : breadcrumb,
  subtitle = activeNav === 'dashboard' ? 'Berikut adalah data-data yang dapat Anda akses.' :
             activeNav === 'mahasiswa' ? 'Berikut adalah daftar mahasiswa bimbingan yang menjadi tanggung jawab Anda sebagai dosen pembimbing.' :
             activeNav === 'logbook' ? 'Berikut adalah daftar logbook mahasiswa bimbingan.' :
             activeNav === 'laporan-akhir' ? 'Berikut adalah daftar laporan akhir mahasiswa bimbingan.' :
             activeNav === 'sidang' ? 'Kelola data pengajuan dan hasil sidang evaluasi MBKM.' :
             activeNav === 'log-aktivitas' ? 'Log aktivitas mahasiswa bimbingan.' :
             '',
  title = `${pageTitle} - MBKM`
} = Astro.props;
---

<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>

  <!-- Google Fonts: Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap"
    rel="stylesheet"
  />

  <!-- Tailwind CSS CDN -->
  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <script is:inline>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'system-ui', '-apple-system', 'sans-serif'],
          },
          colors: {
            primary: {
              DEFAULT: '#1063B9',
              600: '#1063B9',
            },
            muted: {
              foreground: '#64748B',
            }
          }
        },
      },
    };
  </script>

  <!-- Lucide Icons CDN -->
  <script is:inline src="https://unpkg.com/lucide@latest"></script>

  <!-- Alpine.js Core CDN (defer) -->
  <script is:inline defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.8/dist/cdn.min.js"></script>

  <style is:global>
    [x-cloak] {
      display: none !important;
    }
    html,
    body {
      min-height: 100vh;
      margin: 0;
      background-color: #f8fafc;
    }
    body {
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
    }
    .nav-active {
      color: #0655a7 !important;
      font-weight: 500 !important;
      position: relative;
    }
    .nav-active .active-bar {
      display: block !important;
    }
    .nav-active i {
      color: #0655a7 !important;
    }
  </style>
</head>
<body x-data class="min-h-screen bg-[#f8fafc] text-[#09090b] antialiased overflow-x-hidden">
  <div class="flex min-h-screen w-full bg-[#f8fafc]">

    <!-- ==================================================== -->
    <!-- 1. SIDEBAR DOSEN (SESUAI PERSIS SCREENSHOT KP)       -->
    <!-- ==================================================== -->
    <aside
      id="sidebar"
      class="w-64 shrink-0 bg-transparent flex flex-col justify-between p-3 min-h-screen sticky top-0 h-screen overflow-y-auto transition-all duration-200"
    >
      <div class="flex flex-col gap-2">
        <!-- Logo Institusi UDINUS -->
        <div class="flex items-center gap-2.5 p-2 mb-1">
          <img
            src="/assets/logo.png"
            alt="Logo UDINUS"
            class="object-contain w-8 h-8"
            onerror="this.src = 'https://dinus.ac.id/img/logo-dinus.png'"
          />
          <div class="flex flex-col leading-tight">
            <span class="text-[10px] font-extrabold text-[#114d91] tracking-wider uppercase">UNIVERSITAS</span>
            <span class="text-[10px] font-extrabold text-[#114d91] tracking-wider uppercase">DIAN NUSWANTORO</span>
          </div>
        </div>

        <!-- Kartu Identitas Modul Sub-App (MBKM / Dosen) -->
        <div class="w-full h-12 p-2 px-3 flex items-center justify-between bg-white border border-[#e2e8f0] rounded-xl shadow-none cursor-pointer hover:bg-gray-50/80 transition-colors">
          <div class="flex items-center gap-2.5 overflow-hidden">
            <div class="w-8 h-8 rounded-lg bg-[#1e40af] text-white flex items-center justify-center shrink-0">
              <i data-lucide="graduation-cap" class="w-4 h-4"></i>
            </div>
            <div class="flex flex-col overflow-hidden leading-tight">
              <span class="text-[13px] font-semibold text-[#0f172a] truncate">MBKM</span>
              <span class="text-[11px] text-[#64748b] truncate">Dosen</span>
            </div>
          </div>
          <i data-lucide="chevrons-up-down" class="w-4 h-4 text-[#94a3b8] shrink-0"></i>
        </div>

        <!-- Menu Navigasi Dosen (5 Menu Persis Screenshot KP) -->
        <nav class="flex flex-col gap-1 mt-2">
          <!-- 1. Dashboard -->
          <a
            href="/dosen/dashboard"
            id="nav-dashboard"
            class={`nav-item relative flex items-center gap-3 px-4 py-2.5 rounded-lg text-[14px] font-normal hover:bg-black/5 transition-colors text-left w-full ${
              activeNav === 'dashboard' ? 'nav-active text-[#0655a7]' : 'text-[#475569]'
            }`}
          >
            <span class={`active-bar absolute left-0 top-2 bottom-2 w-1 bg-[#0655a7] rounded-r-md ${activeNav === 'dashboard' ? '' : 'hidden'}`}></span>
            <i data-lucide="home" class={`w-4 h-4 shrink-0 ${activeNav === 'dashboard' ? 'text-[#0655a7]' : 'text-[#64748b]'}`}></i>
            <span class="truncate">Dashboard</span>
          </a>

          <!-- 2. Mahasiswa Bimbingan -->
          <a
            href="/dosen/mahasiswa"
            id="nav-mahasiswa"
            class={`nav-item relative flex items-center gap-3 px-4 py-2.5 rounded-lg text-[14px] font-normal hover:bg-black/5 transition-colors text-left w-full ${
              activeNav === 'mahasiswa' ? 'nav-active text-[#0655a7]' : 'text-[#475569]'
            }`}
          >
            <span class={`active-bar absolute left-0 top-2 bottom-2 w-1 bg-[#0655a7] rounded-r-md ${activeNav === 'mahasiswa' ? '' : 'hidden'}`}></span>
            <i data-lucide="users" class={`w-4 h-4 shrink-0 ${activeNav === 'mahasiswa' ? 'text-[#0655a7]' : 'text-[#64748b]'}`}></i>
            <span class="truncate">Mahasiswa Bimbingan</span>
          </a>

          <!-- 3. Logbook Mahasiswa -->
          <a
            href="/dosen/logbook"
            id="nav-logbook"
            class={`nav-item relative flex items-center gap-3 px-4 py-2.5 rounded-lg text-[14px] font-normal hover:bg-black/5 transition-colors text-left w-full ${
              activeNav === 'logbook' ? 'nav-active text-[#0655a7]' : 'text-[#475569]'
            }`}
          >
            <span class={`active-bar absolute left-0 top-2 bottom-2 w-1 bg-[#0655a7] rounded-r-md ${activeNav === 'logbook' ? '' : 'hidden'}`}></span>
            <i data-lucide="book-text" class={`w-4 h-4 shrink-0 ${activeNav === 'logbook' ? 'text-[#0655a7]' : 'text-[#64748b]'}`}></i>
            <span class="truncate">Logbook Mahasiswa</span>
          </a>

          <!-- 4. Laporan Akhir -->
          <a
            href="/dosen/laporan-akhir"
            id="nav-laporan-akhir"
            class={`nav-item relative flex items-center gap-3 px-4 py-2.5 rounded-lg text-[14px] font-normal hover:bg-black/5 transition-colors text-left w-full ${
              activeNav === 'laporan-akhir' ? 'nav-active text-[#0655a7]' : 'text-[#475569]'
            }`}
          >
            <span class={`active-bar absolute left-0 top-2 bottom-2 w-1 bg-[#0655a7] rounded-r-md ${activeNav === 'laporan-akhir' ? '' : 'hidden'}`}></span>
            <i data-lucide="file-text" class={`w-4 h-4 shrink-0 ${activeNav === 'laporan-akhir' ? 'text-[#0655a7]' : 'text-[#64748b]'}`}></i>
            <span class="truncate">Laporan Akhir</span>
          </a>

          <!-- 4. Sidang -->
          <a
            href="/dosen/sidang"
            id="nav-sidang"
            class={`nav-item relative flex items-center gap-3 px-4 py-2.5 rounded-lg text-[14px] font-normal hover:bg-black/5 transition-colors text-left w-full ${
              activeNav === 'sidang' ? 'nav-active text-[#0655a7]' : 'text-[#475569]'
            }`}
          >
            <span class={`active-bar absolute left-0 top-2 bottom-2 w-1 bg-[#0655a7] rounded-r-md ${activeNav === 'sidang' ? '' : 'hidden'}`}></span>
            <i data-lucide="calendar-check" class={`w-4 h-4 shrink-0 ${activeNav === 'sidang' ? 'text-[#0655a7]' : 'text-[#64748b]'}`}></i>
            <span class="truncate">Sidang</span>
          </a>

          <!-- 5. Log Aktivitas -->
          <a
            href="/dosen/log-aktivitas"
            id="nav-log-aktivitas"
            class={`nav-item relative flex items-center gap-3 px-4 py-2.5 rounded-lg text-[14px] font-normal hover:bg-black/5 transition-colors text-left w-full ${
              activeNav === 'log-aktivitas' ? 'nav-active text-[#0655a7]' : 'text-[#475569]'
            }`}
          >
            <span class={`active-bar absolute left-0 top-2 bottom-2 w-1 bg-[#0655a7] rounded-r-md ${activeNav === 'log-aktivitas' ? '' : 'hidden'}`}></span>
            <i data-lucide="scroll-text" class={`w-4 h-4 shrink-0 ${activeNav === 'log-aktivitas' ? 'text-[#0655a7]' : 'text-[#64748b]'}`}></i>
            <span class="truncate">Log Aktivitas</span>
          </a>
        </nav>
      </div>

      <!-- Footer Profil Dosen (Sesuai Persis Screenshot KP: ADHITYA NUGRAHA) -->
      <div class="pt-2 mt-auto">
        <div class="w-full p-2 px-3 flex items-center justify-between bg-white border border-[#e2e8f0] rounded-xl shadow-none">
          <div class="flex items-center gap-2.5 overflow-hidden">
            <div class="w-8 h-8 rounded-full bg-[#18181b] text-white font-semibold text-xs flex items-center justify-center shrink-0">
              N
            </div>
            <div class="flex flex-col overflow-hidden leading-tight">
              <span class="text-[12px] font-semibold text-[#0f172a] truncate uppercase">ADHITYA NUGRAHA</span>
              <span class="text-[11px] text-[#64748b] truncate mt-0.5">
                Teknik Informatika - S1 (A11)
              </span>
            </div>
          </div>
          <a
            href="/login"
            title="Keluar / Logout"
            class="text-[#64748b] hover:text-[#0f172a] p-1.5 rounded hover:bg-gray-100 transition-colors shrink-0"
          >
            <i data-lucide="log-out" class="w-4 h-4"></i>
          </a>
        </div>
      </div>
    </aside>

    <!-- ==================================================== -->
    <!-- 2. MAIN CANVAS CONTAINER (SESUAI PERSIS FAKULTAS-FE) -->
    <!-- ==================================================== -->
    <main class="lg:flex flex-col flex-1 p-4 my-4 mr-4 ml-4 lg:ml-0 bg-white border border-[#e2e8f0] rounded-xl min-h-[calc(100vh-2rem)]">
      <!-- 1. Top Breadcrumb Header Bar 1 -->
      <header class="flex w-full items-center justify-between shrink-0">
        <div class="flex items-center gap-2">
          <button
            type="button"
            onclick="document.getElementById('sidebar').classList.toggle('-ml-64')"
            class="h-8 w-8 flex items-center justify-center rounded-md border border-[#e2e8f0] bg-white text-[#0f172a] hover:bg-[#f8fafc] transition-colors"
            title="Toggle Sidebar"
          >
            <i data-lucide="panel-left" class="w-4 h-4"></i>
          </button>
          <nav id="breadcrumb-container" class="flex items-center gap-2 text-sm text-[#64748b]">
            <span class="bg-white border border-[#e2e8f0] py-1 px-3 rounded-lg text-sm text-[#0f172a] shadow-none flex items-center gap-1 font-normal">
              <span>{breadcrumb}</span>
            </span>
          </nav>
        </div>
      </header>

      <!-- Full-width Separator (W-[calc(100%+2rem)] -mx-4 mt-4 di fakultas-fe) -->
      <div class="w-[calc(100%+2rem)] -mx-4 border-b border-[#e2e8f0] mt-4 mb-4 shrink-0"></div>

      <!-- 2. Title Header Bar 2 (Persis DashboardHeader di fakultas-fe: h2 text-xl biasa TANPA bold) -->
      {(pageTitle || subtitle) && (
        <header id="dashboard-header-bar-2" class="mb-4 flex items-start justify-between gap-4 shrink-0">
          <div>
            {pageTitle && <h2 class="text-xl text-[#0f172a] font-normal">{pageTitle}</h2>}
            {subtitle && <p class="text-sm text-[#64748b] mt-1">{subtitle}</p>}
          </div>
          <slot name="header-actions" />
        </header>
      )}

      <!-- Container Konten Halaman Dosen -->
      <div class="flex-1 w-full flex flex-col">
        <slot />
      </div>
    </main>
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      if (window.lucide) {
        window.lucide.createIcons();
      }
    });
  </script>
</body>
</html>
