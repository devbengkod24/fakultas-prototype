---
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  pageTitle?: string;
  subtitle?: string;
  activeNav?: 'dashboard' | 'pengumuman' | 'program' | 'form' | 'dosen' | 'mahasiswa' | 'seleksi' | string;
  breadcrumbTitle?: string;
}

const {
  title = "Portal Contributor | Kampus Berdampak FIK UDINUS",
  activeNav = "dashboard",
  breadcrumbTitle = activeNav === 'dashboard' ? 'Dashboard' :
                    activeNav === 'pengumuman' ? 'Pengumuman' :
                    activeNav === 'program' ? 'Kelola Program Binaan' :
                    activeNav === 'form' ? 'Formulir Pendaftaran' :
                    activeNav === 'dosen' ? 'Anggota / Dosen Pembina' :
                    activeNav === 'mahasiswa' ? 'Anggota / Mahasiswa Binaan' :
                    activeNav === 'seleksi' ? 'Seleksi Pendaftar' :
                    'Dashboard',
  pageTitle = breadcrumbTitle,
  subtitle = "Ringkasan operasional program MBKM binaan, pendaftar baru, dan aktivitas bimbingan mahasiswa."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <ClientRouter />

  <!-- Google Fonts: Inter (Standar Selaras dengan Admin) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap"
    rel="stylesheet"
  />

  <!-- Tailwind CSS CDN (Tema Selaras dengan Admin) -->
  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <script is:inline>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'system-ui', '-apple-system', 'sans-serif'],
          },
          colors: {
            brand: {
              DEFAULT: '#0655a7',
              dark: '#114d91',
              light: '#f1f7fe',
            },
            primary: {
              50: '#F1F7FE',
              100: '#E2EEFC',
              200: '#BFDBF8',
              300: '#86BEF3',
              400: '#1E7FD9',
              500: '#1E7FD9',
              600: '#1063B9',
              700: '#114D91',
              800: '#10447C',
              900: '#133A67',
              950: '#0D2544',
            },
            secondary: {
              50: '#FEFAEC',
              100: '#FCEEC9',
              200: '#F8DB8F',
              300: '#F4BD45',
              400: '#F2AB2D',
              500: '#F3BC45',
              600: '#D0670F',
            },
          },
          boxShadow: {
            '2xs': '0 1px 2px 0 rgba(0, 0, 0, 0.05)',
          },
        },
      },
    };
  </script>

  <!-- Lucide Icons CDN -->
  <script is:inline src="https://unpkg.com/lucide@latest"></script>

  <!-- Alpine.js Core CDN (defer) -->
  <script is:inline defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.8/dist/cdn.min.js"></script>

  <style is:global>
    [x-cloak] {
      display: none !important;
    }
    html,
    body {
      min-height: 100vh;
      margin: 0;
    }
    body {
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
    }
    .nav-active {
      color: #0655a7 !important;
      font-weight: 500 !important;
      background-color: rgba(6, 85, 167, 0.08) !important;
      position: relative;
    }
    .nav-active .active-bar {
      display: block !important;
    }
    .nav-active i {
      color: #0655a7 !important;
    }

    /* Top Progress Bar Loading Indicator (Style NextTopLoader KP) */
    #top-loading-bar {
      position: fixed;
      top: 0;
      left: 0;
      width: 0%;
      height: 3px;
      background: linear-gradient(90deg, #0655a7, #1E7FD9, #38bdf8);
      box-shadow: 0 0 10px rgba(6, 85, 167, 0.7), 0 0 5px rgba(30, 127, 217, 0.5);
      z-index: 99999;
      pointer-events: none;
      transition: width 0.35s cubic-bezier(0.1, 0.05, 0.25, 1), opacity 0.3s ease;
      opacity: 0;
    }
    #top-loading-bar.loading {
      opacity: 1;
    }
  </style>
</head>
<body x-data class="min-h-screen bg-[#fafafa] text-[#09090b] antialiased overflow-x-hidden">
  <!-- Top loading bar indicator -->
  <div id="top-loading-bar" aria-hidden="true"></div>

  <div class="flex min-h-screen w-full bg-[#fafafa]">

    <!-- ==================================================== -->
    <!-- 1. SIDEBAR KONTRIBUTOR (SELARAS 100% DENGAN ADMIN)         -->
    <!-- ==================================================== -->
    <aside
      id="sidebar"
      class="w-64 shrink-0 bg-[#fafafa] flex flex-col justify-between p-3 border-r border-[#e4e4e7]/60 min-h-screen sticky top-0 h-screen overflow-y-auto transition-all duration-200"
    >
      <div class="flex flex-col gap-2">
        <!-- Logo Institusi UDINUS -->
        <div class="flex items-center gap-2.5 p-2 mb-1">
          <img
            src="/assets/logo.png"
            alt="Logo UDINUS"
            class="object-contain w-9 h-9"
            onerror="this.src = 'https://dinus.ac.id/img/logo-dinus.png'"
          />
          <div class="flex flex-col leading-tight">
            <span class="text-[11px] font-extrabold text-[#114d91] tracking-wider uppercase">UNIVERSITAS</span>
            <span class="text-[11px] font-extrabold text-[#114d91] tracking-wider uppercase">DIAN NUSWANTORO</span>
          </div>
        </div>

        <!-- Kartu Identitas Modul Sub-App -->
        <div class="w-full h-12 p-2 flex items-center justify-between bg-white border border-[#e4e4e7] rounded-lg shadow-none">
          <div class="flex items-center gap-2.5 overflow-hidden">
            <div class="w-8 h-8 rounded bg-[#114d91] text-white flex items-center justify-center shrink-0">
              <i data-lucide="building-2" class="w-4 h-4"></i>
            </div>
            <div class="flex flex-col overflow-hidden leading-tight">
              <span class="text-[13px] font-semibold text-[#3f3f46] truncate">Kampus Berdampak</span>
              <span class="text-[11px] text-[#71717a] truncate">Portal Contributor</span>
            </div>
          </div>
          <i data-lucide="chevrons-up-down" class="w-4 h-4 text-[#71717a] shrink-0"></i>
        </div>

        <!-- Menu Navigasi Kontributor (Style Selaras Admin) -->
        <nav class="flex flex-col gap-1 mt-2">
          <!-- 1. Dashboard -->
          <a
            href="/contributor/dashboard"
            id="nav-dashboard"
            class={`nav-item relative flex items-center gap-3 px-4 py-2.5 rounded-lg text-[14px] font-normal hover:bg-black/5 transition-colors text-left w-full ${
              activeNav === 'dashboard' ? 'nav-active text-[#0655a7]' : 'text-[#3f3f46]'
            }`}
          >
            <span class={`active-bar absolute left-0 top-2 bottom-2 w-1 bg-[#0655a7] rounded-r-md ${activeNav === 'dashboard' ? '' : 'hidden'}`}></span>
            <i data-lucide="layout-dashboard" class={`w-4 h-4 shrink-0 ${activeNav === 'dashboard' ? 'text-[#0655a7]' : 'text-[#71717a]'}`}></i>
            <span class="truncate">Dashboard</span>
          </a>

          <!-- 2. Pengumuman -->
          <a
            href="/contributor/pengumuman"
            id="nav-pengumuman"
            class={`nav-item relative flex items-center gap-3 px-4 py-2.5 rounded-lg text-[14px] font-normal hover:bg-black/5 transition-colors text-left w-full ${
              activeNav === 'pengumuman' ? 'nav-active text-[#0655a7]' : 'text-[#3f3f46]'
            }`}
          >
            <span class={`active-bar absolute left-0 top-2 bottom-2 w-1 bg-[#0655a7] rounded-r-md ${activeNav === 'pengumuman' ? '' : 'hidden'}`}></span>
            <i data-lucide="megaphone" class={`w-4 h-4 shrink-0 ${activeNav === 'pengumuman' ? 'text-[#0655a7]' : 'text-[#71717a]'}`}></i>
            <span class="truncate">Pengumuman</span>
          </a>

          <!-- 2. Kelola Program -->
          <a
            href="/contributor/program"
            id="nav-program"
            class={`nav-item relative flex items-center gap-3 px-4 py-2.5 rounded-lg text-[14px] font-normal hover:bg-black/5 transition-colors text-left w-full ${
              activeNav === 'program' ? 'nav-active text-[#0655a7]' : 'text-[#3f3f46]'
            }`}
          >
            <span class={`active-bar absolute left-0 top-2 bottom-2 w-1 bg-[#0655a7] rounded-r-md ${activeNav === 'program' ? '' : 'hidden'}`}></span>
            <i data-lucide="folder-kanban" class={`w-4 h-4 shrink-0 ${activeNav === 'program' ? 'text-[#0655a7]' : 'text-[#71717a]'}`}></i>
            <span class="truncate">Kelola Program</span>
          </a>

          <!-- 3. Form Pendaftaran -->
          <a
            href="/contributor/form"
            id="nav-form"
            class={`nav-item relative flex items-center gap-3 px-4 py-2.5 rounded-lg text-[14px] font-normal hover:bg-black/5 transition-colors text-left w-full ${
              activeNav === 'form' ? 'nav-active text-[#0655a7]' : 'text-[#3f3f46]'
            }`}
          >
            <span class={`active-bar absolute left-0 top-2 bottom-2 w-1 bg-[#0655a7] rounded-r-md ${activeNav === 'form' ? '' : 'hidden'}`}></span>
            <i data-lucide="clipboard-list" class={`w-4 h-4 shrink-0 ${activeNav === 'form' ? 'text-[#0655a7]' : 'text-[#71717a]'}`}></i>
            <span class="truncate">Form Pendaftaran</span>
          </a>

          <!-- 4. Group Anggota (Collapsible Accordion Sama Persis v2) -->
          <div class="space-y-0.5">
            <button
              type="button"
              onclick="document.getElementById('group-anggota-sub').classList.toggle('hidden'); document.getElementById('group-anggota-arrow').classList.toggle('rotate-180')"
              id="group-anggota-btn"
              class={`w-full flex items-center justify-between px-4 py-2.5 rounded-lg text-[14px] font-normal hover:bg-black/5 hover:text-[#09090b] transition-colors text-left ${
                ['dosen', 'mahasiswa'].includes(activeNav) ? 'text-[#0655a7] font-medium' : 'text-[#3f3f46]'
              }`}
            >
              <div class="flex items-center gap-3 truncate">
                <i data-lucide="users" class={`w-4 h-4 shrink-0 ${['dosen', 'mahasiswa'].includes(activeNav) ? 'text-[#0655a7]' : 'text-[#71717a]'}`}></i>
                <span class="truncate">Anggota</span>
              </div>
              <i id="group-anggota-arrow" data-lucide="chevron-down" class={`w-4 h-4 shrink-0 transition-transform duration-200 ${['dosen', 'mahasiswa'].includes(activeNav) ? 'rotate-180 text-[#0655a7]' : 'text-[#71717a]'}`}></i>
            </button>
            <div id="group-anggota-sub" class={`pl-3 space-y-0.5 ${['dosen', 'mahasiswa'].includes(activeNav) ? '' : 'hidden'}`}>
              <!-- Sub 1: Dosen -->
              <a
                href="/contributor/dosen"
                id="nav-dosen"
                class={`nav-item relative flex items-center gap-2.5 px-4 py-2 rounded-lg text-[13px] font-normal hover:bg-black/5 transition-colors w-full text-left ${
                  activeNav === 'dosen' ? 'nav-active text-[#0655a7]' : 'text-[#3f3f46]'
                }`}
              >
                <span class={`active-bar absolute left-0 top-1.5 bottom-1.5 w-1 bg-[#0655a7] rounded-r-md ${activeNav === 'dosen' ? '' : 'hidden'}`}></span>
                <i data-lucide="graduation-cap" class={`w-3.5 h-3.5 shrink-0 ${activeNav === 'dosen' ? 'text-[#0655a7]' : 'text-[#71717a]'}`}></i>
                <span class="truncate">Dosen</span>
              </a>
              <!-- Sub 2: Mahasiswa -->
              <a
                href="/contributor/mahasiswa"
                id="nav-mahasiswa"
                class={`nav-item relative flex items-center gap-2.5 px-4 py-2 rounded-lg text-[13px] font-normal hover:bg-black/5 transition-colors w-full text-left ${
                  activeNav === 'mahasiswa' ? 'nav-active text-[#0655a7]' : 'text-[#3f3f46]'
                }`}
              >
                <span class={`active-bar absolute left-0 top-1.5 bottom-1.5 w-1 bg-[#0655a7] rounded-r-md ${activeNav === 'mahasiswa' ? '' : 'hidden'}`}></span>
                <i data-lucide="user" class={`w-3.5 h-3.5 shrink-0 ${activeNav === 'mahasiswa' ? 'text-[#0655a7]' : 'text-[#71717a]'}`}></i>
                <span class="truncate">Mahasiswa</span>
              </a>
            </div>
          </div>

          <!-- 5. Seleksi Pendaftar -->
          <a
            href="/contributor/seleksi"
            id="nav-seleksi"
            class={`nav-item relative flex items-center gap-3 px-4 py-2.5 rounded-lg text-[14px] font-normal hover:bg-black/5 transition-colors text-left w-full ${
              activeNav === 'seleksi' ? 'nav-active text-[#0655a7]' : 'text-[#3f3f46]'
            }`}
          >
            <span class={`active-bar absolute left-0 top-2 bottom-2 w-1 bg-[#0655a7] rounded-r-md ${activeNav === 'seleksi' ? '' : 'hidden'}`}></span>
            <i data-lucide="user-check" class={`w-4 h-4 shrink-0 ${activeNav === 'seleksi' ? 'text-[#0655a7]' : 'text-[#71717a]'}`}></i>
            <span class="truncate">Seleksi Pendaftar</span>
          </a>
        </nav>
      </div>

      <!-- Footer Profil Kontributor (Selaras Admin) -->
      <div class="pt-2 mt-auto">
        <div class="w-full h-14 p-2 flex items-center justify-between bg-white border border-[#e4e4e7] rounded-lg shadow-none">
          <div class="flex items-center gap-2.5 overflow-hidden">
            <div class="w-8 h-8 rounded-full bg-[#114d91] text-white font-semibold text-xs flex items-center justify-center shrink-0">
              RA
            </div>
            <div class="flex flex-col overflow-hidden leading-tight">
              <span class="text-[12px] font-semibold text-[#09090b] truncate">Dr. Ricardus Anggi, M.Kom.</span>
              <span class="text-[10px] text-[#71717a] font-medium px-1.5 py-0.5 border border-[#e4e4e7] rounded bg-[#fafafa] w-fit truncate mt-0.5">
                Kontributor
              </span>
            </div>
          </div>
          <a href="/login" title="Keluar / Logout" class="text-[#71717a] hover:text-[#09090b] p-1.5 rounded hover:bg-gray-100 transition-colors">
            <i data-lucide="log-out" class="w-4 h-4"></i>
          </a>
        </div>
      </div>
    </aside>

    <!-- ==================================================== -->
    <!-- 2. MAIN CANVAS CONTAINER (SELARAS DENGAN ADMIN)      -->
    <!-- ==================================================== -->
    <main class="flex flex-col flex-1 p-6 my-4 mr-4 ml-4 lg:ml-0 bg-white border border-[#e4e4e7] rounded-xl min-h-[calc(100vh-2rem)]">
      <!-- Top Breadcrumb Header Bar 1 -->
      <header class="flex w-full items-center justify-between pb-3 shrink-0">
        <div class="flex items-center gap-2">
          <button
            type="button"
            onclick="document.getElementById('sidebar').classList.toggle('-ml-64')"
            class="h-8 w-8 flex items-center justify-center rounded-md border border-[#e4e4e7] bg-white text-[#09090b] hover:bg-[#f4f4f5] transition-colors"
            title="Toggle Sidebar"
          >
            <i data-lucide="panel-left" class="w-4 h-4"></i>
          </button>
          <div class="h-4 w-[1px] bg-[#e4e4e7] mx-1"></div>
          <nav id="breadcrumb-container" class="flex items-center gap-2 text-sm text-[#71717a]">
            <span class="bg-white border border-[#e4e4e7] py-1 px-3 rounded-lg text-sm font-medium text-[#09090b] shadow-none">
              <span>{breadcrumbTitle}</span>
            </span>
          </nav>
        </div>

        </header>

      <!-- Full-width Separator (Selaras Admin) -->
      <div class="w-[calc(100%+3rem)] -mx-6 border-b border-[#e4e4e7] mb-5 shrink-0"></div>



      <!-- Container Konten Halaman (Isi Asli Kontributor) -->
      <div class="flex-1 w-full flex flex-col">
        <slot />
      </div>
    </main>
  </div>

  <!-- ======================================================== -->
  <!-- MODAL 1: DIRECT ASSIGN MAHASISWA BINAAN                   -->
  <!-- ======================================================== -->
  <div id="directAssignModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/50 backdrop-blur-2xs">
    <div class="bg-white rounded-2xl border border-gray-200 max-w-lg w-full p-6 shadow-xl animate-in fade-in zoom-in-95 duration-200">
      <div class="flex items-center justify-between pb-3 border-b border-gray-100 mb-4">
        <div>
          <h3 class="text-base font-bold text-gray-900 flex items-center gap-2">
            <i data-lucide="user-plus" class="w-5 h-5 text-[#1063B9]"></i>
            <span>Direct Assign Mahasiswa Binaan</span>
          </h3>
          <p class="text-xs text-gray-500 mt-0.5">Penugasan langsung mahasiswa bimbingan Tugas Akhir ke program binaan.</p>
        </div>
        <button type="button" onclick="closeDirectAssignModal()" class="text-gray-400 hover:text-gray-600 p-1 rounded-lg">
          <i data-lucide="x" class="w-4 h-4"></i>
        </button>
      </div>

      <form id="directAssignForm" onsubmit="handleDirectAssignSubmit(event)" class="space-y-4 text-xs">
        <div>
          <label class="block font-semibold text-gray-700 mb-1">Nomor Induk Mahasiswa (NIM) <span class="text-red-500">*</span></label>
          <div class="flex gap-2">
            <input type="text" id="inputNim" required placeholder="Contoh: A11.2023.14999" class="flex-1 px-3 py-2 border border-gray-300 rounded-lg focus:border-[#1063B9] outline-none" />
            <button type="button" onclick="verifyNimSiakad()" class="px-3.5 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold rounded-lg transition-colors shrink-0">
              Cek SIAKAD
            </button>
          </div>
        </div>

        <!-- Box Verifikasi SIAKAD -->
        <div id="siakadResultBox" class="p-3 bg-gray-50 rounded-lg border border-gray-200 text-xs space-y-1">
          <div class="flex justify-between">
            <span class="text-gray-500">Nama Mahasiswa:</span>
            <span class="font-semibold text-gray-900" id="verifiedName">-</span>
          </div>
          <div class="flex justify-between">
            <span class="text-gray-500">Program Studi:</span>
            <span class="font-medium text-gray-800" id="verifiedProdi">-</span>
          </div>
          <div class="flex justify-between">
            <span class="text-gray-500">Status Validasi:</span>
            <span class="font-semibold text-gray-500" id="verifiedStatusText">Masukkan NIM untuk verifikasi</span>
          </div>
        </div>

        <div>
          <label class="block font-semibold text-gray-700 mb-1">Topik Bimbingan Riset / Judul Tugas Akhir <span class="text-red-500">*</span></label>
          <input type="text" id="assignTopic" required placeholder="Contoh: Implementasi YOLOv8 untuk Deteksi Kerusakan Jalan" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:border-[#1063B9] outline-none" />
        </div>

        <div>
          <label class="block font-semibold text-gray-700 mb-1">Dosen Pembimbing yang Ditugaskan <span class="text-red-500">*</span></label>
          <select class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:border-[#1063B9] outline-none bg-white">
            <option>Dr. Ricardus Anggi, M.Kom. (Sisa Kuota: 2)</option>
            <option>Dr. Aris Kusumawati, M.Cs. (Sisa Kuota: 2)</option>
          </select>
        </div>

        <div class="flex items-center justify-end gap-2.5 pt-3 border-t border-gray-100">
          <button type="button" onclick="closeDirectAssignModal()" class="px-4 py-2 border border-gray-300 text-gray-700 font-medium rounded-lg hover:bg-gray-50">
            Batal
          </button>
          <button type="submit" class="px-4 py-2 bg-[#1063B9] hover:bg-[#0E4F96] text-white font-semibold rounded-lg shadow-2xs">
            Tugaskan Mahasiswa
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- ======================================================== -->
  <!-- MODAL 2: PREVIEW DOKUMEN (TRANSKRIP / CV)                 -->
  <!-- ======================================================== -->
  <div id="previewDocModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/50 backdrop-blur-2xs">
    <div class="bg-white rounded-2xl border border-gray-200 max-w-md w-full p-6 shadow-xl animate-in fade-in zoom-in-95 duration-200">
      <div class="flex items-center justify-between pb-3 border-b border-gray-100 mb-4">
        <div>
          <h3 class="text-sm font-bold text-gray-900" id="previewModalTitle">Preview Berkas Mahasiswa</h3>
          <p class="text-xs text-gray-500 mt-0.5" id="previewFileName">Dokumen_Akademik.pdf</p>
        </div>
        <button type="button" onclick="closePreviewDocModal()" class="text-gray-400 hover:text-gray-600 p-1 rounded-lg">
          <i data-lucide="x" class="w-4 h-4"></i>
        </button>
      </div>

      <div class="p-8 border border-dashed border-gray-200 rounded-xl bg-gray-50 text-center space-y-3">
        <div class="w-12 h-12 rounded-full bg-blue-50 text-[#1063B9] mx-auto flex items-center justify-center">
          <i data-lucide="file-text" class="w-6 h-6"></i>
        </div>
        <div class="text-xs text-gray-600">
          <p class="font-semibold text-gray-900">Dokumen PDF Terverifikasi SIAKAD</p>
          <p class="text-gray-500 mt-1">Ukuran berkas: 1.4 MB • Format valid</p>
        </div>
      </div>

      <div class="flex items-center justify-end gap-2.5 pt-4 mt-4 border-t border-gray-100">
        <button type="button" onclick="closePreviewDocModal()" class="px-4 py-2 border border-gray-300 text-gray-700 text-xs font-semibold rounded-lg hover:bg-gray-50">
          Tutup
        </button>
        <button type="button" onclick="showToast('Unduh Dokumen', 'Berkas PDF berhasil diunduh.')" class="px-4 py-2 bg-[#1063B9] hover:bg-[#0E4F96] text-white text-xs font-semibold rounded-lg shadow-2xs">
          Unduh File Asli
        </button>
      </div>
    </div>
  </div>

  <!-- ======================================================== -->
  <!-- MODAL 3: TAMBAH DOSEN PEMBINA                            -->
  <!-- ======================================================== -->
  <div id="addDosenModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/50 backdrop-blur-2xs">
    <div class="bg-white rounded-2xl border border-gray-200 max-w-md w-full p-6 shadow-xl animate-in fade-in zoom-in-95 duration-200">
      <div class="flex items-center justify-between pb-3 border-b border-gray-100 mb-4">
        <div>
          <h3 class="text-base font-bold text-gray-900 flex items-center gap-2">
            <i data-lucide="graduation-cap" class="w-5 h-5 text-[#1063B9]"></i>
            <span>Tambah Dosen Pembina</span>
          </h3>
          <p class="text-xs text-gray-500 mt-0.5">Tugaskan dosen baru ke dalam tim pengampu program binaan ini.</p>
        </div>
