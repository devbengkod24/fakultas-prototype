                    "nav-sub-item relative px-3 py-2 rounded-lg text-[13px] hover:text-[#0655a7] hover:bg-blue-50/60 font-medium text-left transition-colors flex items-center",
                    activeTabKey === 'dosen-data' ? 'nav-sub-active' : 'text-[#71717a]'
                  ]}
                >
                  <span class:list={["sub-active-bar absolute left-0 top-1.5 bottom-1.5 w-1 bg-[#0655a7] rounded-r-md", activeTabKey === 'dosen-data' ? '' : 'hidden']}></span>
                  <span>Data Dosen</span>
                </a>
                <a
                  href="/admin/dosen-kuota"
                  id="nav-sub-dosen-kuota"
