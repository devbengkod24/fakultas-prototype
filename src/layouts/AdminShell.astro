    <!-- Modals Dialog (21 Modals Standar MBKM Admin) -->
    <Modals />

    <!-- Inisialisasi State Halaman Aktif untuk Controller -->
    <script is:inline define:vars={{ activeTabKey }}>
      window.__CURRENT_TAB__ = activeTabKey;
    </script>

    <!-- Script Standar: Mock Data & Controller (2 File JS) -->
    <script is:inline src="/admin/_mock-data.js"></script>
    <script is:inline src="/admin/_controller.js"></script>

    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        if (window.lucide) {
          window.lucide.createIcons();
        }
      });
    </script>
  </body>
</html>
