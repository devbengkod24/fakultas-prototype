    <script src="../scripts/admin/index.ts"></script>

    <script is:inline>
      (function () {
        let toastTimer = null;
        const TOAST_DURATION = 3000;
        const icons = {
          success: '<svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>',
          error: '<svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="12" x2="12" y1="6" y2="14"/><line x1="12" x2="12.01" y1="18" y2="18"/></svg>',
          info: '<svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M12 17v-6"/><path d="M12 7h.01"/></svg>',
        };
        const variantStyles = {
          success: { iconBg: 'bg-[#07bc0c]', trackBg: 'bg-[#07bc0c]/20', barBg: 'bg-[#07bc0c]' },
          error: { iconBg: 'bg-[#e74c3c]', trackBg: 'bg-[#e74c3c]/20', barBg: 'bg-[#e74c3c]' },
          info: { iconBg: 'bg-[#0655a7]', trackBg: 'bg-[#0655a7]/20', barBg: 'bg-[#0655a7]' },
        };

        window.hideAdminToast = function () {
          const el = document.getElementById('admin-global-toast');
          if (!el) return;
          el.classList.add('hidden');
          el.classList.remove('flex');
        };

        window.showAdminToast = function (message, type = 'success') {
          const el = document.getElementById('admin-global-toast');
          const iconEl = document.getElementById('admin-global-toast-icon');
          const msgEl = document.getElementById('admin-global-toast-msg');
          const trackEl = document.getElementById('admin-global-toast-track');
          const barEl = document.getElementById('admin-global-toast-bar');
          if (!el || !iconEl || !msgEl || !trackEl || !barEl) return;

          const variant = variantStyles[type] ? type : 'success';
          const st = variantStyles[variant];

          iconEl.className = `w-5 h-5 rounded-full flex items-center justify-center text-white shrink-0 ${st.iconBg}`;
          iconEl.innerHTML = icons[variant];
          msgEl.textContent = message;
          trackEl.className = `h-1 w-full ${st.trackBg}`;
          barEl.className = `h-full ${st.barBg}`;

          el.classList.remove('hidden');
          el.classList.add('flex');

          // Reset and trigger smooth countdown bar shrinking right-to-left
          barEl.style.transition = 'none';
          barEl.style.width = '100%';
          void barEl.offsetWidth;
          barEl.style.transition = `width ${TOAST_DURATION}ms linear`;
          barEl.style.width = '0%';

          if (toastTimer) window.clearTimeout(toastTimer);
          toastTimer = window.setTimeout(() => {
            window.hideAdminToast();
          }, TOAST_DURATION);
        };
      })();

      document.addEventListener('DOMContentLoaded', () => {
        if (window.lucide) {
          window.lucide.createIcons();
        }
      });
    </script>
