              <i data-lucide="log-out" class="w-4 h-4"></i>
            </a>
          </div>
        </div>
      </aside>

      <!-- ==================================================== -->
      <!-- 2. MAIN CONTENT CANVAS (STANDAR SUB-APP FAKULTAS-FE) -->
      <!-- ==================================================== -->
      <main class="flex flex-col flex-1 min-w-0 p-4 sm:p-6 my-4 mr-4 ml-4 lg:ml-0 bg-white border border-[#e4e4e7] rounded-xl min-h-[calc(100vh-2rem)]">
        <!-- 1. Top Breadcrumb Header (Sesuai DashboardHeader Baris 1 di fakultas-fe) -->
        <header class="flex w-full items-center justify-between pb-3 shrink-0">
          <div class="flex items-center gap-2">
            <button
              type="button"
              onclick="toggleSidebar()"
              class="h-8 w-8 flex items-center justify-center rounded-md border border-[#e4e4e7] bg-white text-[#09090b] hover:bg-[#f4f4f5] transition-colors"
              title="Toggle Sidebar"
            >
              <i data-lucide="panel-left" class="w-4 h-4"></i>
            </button>
            <div class="h-4 w-[1px] bg-[#e4e4e7] mx-1"></div>
            <nav id="breadcrumb-container" class="flex items-center gap-2 text-sm text-[#71717a]">
              {breadcrumbParts.map((part, index) => (
                <Fragment key={index}>
                  {index > 0 && <i data-lucide="chevron-right" class="w-3.5 h-3.5 text-[#71717a] shrink-0" />}
                  {index === breadcrumbParts.length - 1 ? (
                    <span
                      id="breadcrumb-badge"
                      class="bg-white border border-[#e4e4e7] py-1 px-3 rounded-lg text-sm font-medium text-[#09090b] shadow-none"
                    >
                      <span id="breadcrumb-text">{part}</span>
                    </span>
                  ) : (
                    <span class="text-[#71717a] font-normal cursor-default text-sm">{part}</span>
                  )}
                </Fragment>
              ))}
            </nav>
          </div>

          </header>

        <!-- Full-width Separator (Sesuai Separator di fakultas-fe) -->
        <div class="w-[calc(100%+3rem)] -mx-6 border-b border-[#e4e4e7] mb-5 shrink-0"></div>

        <!-- 2. Dynamic Title Header (Hanya tampil pada tab yang tidak memiliki inner header mandiri) -->
        {!['konversi', 'sidang', 'sertifikat', 'log-aktivitas', 'dosen-update', 'koordinator', 'program'].includes(activeTabKey) && (
          <header id="dashboard-header-bar-2" class="mb-5 flex items-start justify-between gap-4 shrink-0">
            <div>
              <h2 class="text-xl font-normal text-[#09090b] tracking-tight" id="header-page-title">
                {displayTitle}
              </h2>
              <p class="text-sm text-[#71717a] mt-0.5" id="header-page-subtitle">
                {displaySubtitle}
              </p>
            </div>
            <div id="header-action-slot" class="shrink-0 flex items-center gap-2">
              {displayActionButton && <Fragment set:html={displayActionButton} />}
            </div>
          </header>
        )}

        <!-- Container Konten Tab -->
        <div class="flex-1 w-full min-w-0 flex flex-col">
          <slot />
        </div>
