---
import Modals from '../components/admin/Modals.astro';

interface Props {
  currentTab?: string;
  title?: string;
  pageTitle?: string;
  subtitle?: string;
  actionButton?: string;
}

const {
  currentTab = 'dashboard',
  title = 'MBKM FIK UDINUS - Master Koordinator & Admin',
  pageTitle,
  subtitle,
  actionButton,
} = Astro.props;

// Normalisasi key tab untuk navigasi & metadata
let activeTabKey = currentTab;
if (activeTabKey === 'kontributor') activeTabKey = 'mitra';
if (activeTabKey === 'pelamar') activeTabKey = 'mhs-pelamar';
if (activeTabKey === 'surekom') activeTabKey = 'mhs-rekomendasi';
if (activeTabKey === 'semua-mahasiswa') activeTabKey = 'mhs-semua';
if (activeTabKey === 'data-mahasiswa') activeTabKey = 'mhs-data';

const tabMetaMap: Record<string, { label: string; title: string; subtitle: string; actionButton: string }> = {
  dashboard: {
    label: 'Dashboard',
    title: 'Selamat Datang, Koordinator MBKM di Fakultas Ilmu Komputer',
    subtitle: 'Berikut adalah data-data dan ringkasan operasional yang dapat Anda akses.',
    actionButton: '',
  },
  pengumuman: {
    label: 'Pengumuman',
    title: 'Pengumuman MBKM',
    subtitle: 'Broadcast siaran informasi resmi MBKM tingkat program studi dan fakultas.',
    actionButton: '<button type="button" onclick="showBuatPengumumanModal()" class="inline-flex items-center gap-2 h-9 px-4 text-sm font-medium rounded-md bg-[#0655a7] hover:bg-[#0655a7]/90 text-white transition-colors shadow-none"><i data-lucide="plus" class="w-4 h-4"></i><span>Tambah Pengumuman</span></button>',
  },
  periode: {
    label: 'MBKM / Periode MBKM',
    title: 'Periode MBKM',
    subtitle: 'Berikut data periode yang sinkron dengan database tahun ajaran pada SIADIN',
    actionButton: '',
  },
  'form-pendaftaran': {
    label: 'MBKM / Form Pendaftaran',
    title: 'Standarisasi Form Pendaftaran MBKM',
    subtitle: 'Konfigurasi syarat akademik EWS, berkas portofolio, konversi SKS, dan template SuReKom se-fakultas.',
    actionButton: '<button type="button" onclick="openPreviewMahasiswaModal()" class="inline-flex items-center gap-2 h-9 px-3.5 text-sm font-medium rounded-md border border-[#e4e4e7] bg-white hover:bg-[#f4f4f5] text-[#09090b] transition-colors"><i data-lucide="eye" class="w-4 h-4 text-[#71717a]"></i><span>Pratinjau Tampilan Mahasiswa</span></button>',
  },
  mitra: {
    label: 'Kontributor',
    title: 'Kontributor MBKM',
    subtitle: 'Kelola akun kontributor mitra industri, lembaga mitra, dan instansi magang/studi.',
    actionButton: '',
  },
  'mhs-pelamar': {
    label: 'Mahasiswa / Pendaftar',
    title: 'Daftar Pengajuan Mahasiswa Pendaftar',
    subtitle: 'Berikut ini adalah daftar semua pengajuan mahasiswa pendaftar ke program MBKM mitra eksternal.',
    actionButton: '<button type="button" class="inline-flex items-center gap-2 h-9 px-3.5 text-sm font-medium rounded-md border border-[#e4e4e7] bg-white hover:bg-[#f4f4f5] text-[#09090b] transition-colors"><i data-lucide="help-circle" class="w-4 h-4 text-[#71717a]"></i><span>Lihat Panduan</span></button>',
  },
  'mhs-rekomendasi': {
    label: 'Mahasiswa / Validasi Surekom',
    title: 'Validasi Surat Rekomendasi (SuReKom)',
    subtitle: 'Verifikasi dan setujui permohonan surat rekomendasi mitra mahasiswa.',
    actionButton: '',
  },
  'mhs-semua': {
    label: 'Mahasiswa / Semua Mahasiswa',
    title: 'Semua Mahasiswa MBKM',
    subtitle: 'Direktori seluruh mahasiswa yang sedang aktif menjalani program MBKM di mitra industri.',
    actionButton: '<button type="button" onclick="exportDataMahasiswa()" class="inline-flex items-center gap-2 h-9 px-3 text-sm font-medium rounded-md border border-[#e4e4e7] bg-white hover:bg-[#f4f4f5] text-[#09090b] transition-colors"><i data-lucide="download" class="w-4 h-4 text-[#71717a]"></i><span>Export Data</span></button>',
  },
  'mhs-data': {
    label: 'Mahasiswa / Data Mahasiswa',
    title: 'Data Mahasiswa MBKM',
    subtitle: 'Kelola data seluruh mahasiswa MBKM, sinkronisasi akademik, dan penugasan pembimbing.',
    actionButton: '',
  },
  'dosen-data': {
    label: 'Dosen Pembimbing / Data Dosen',
    title: 'Data Dosen Pembimbing',
    subtitle: 'Daftar dosen pembimbing yang ditarik dari basis data UDI.',
    actionButton: '<div class="flex items-center gap-2"><button type="button" onclick="syncDataDosenUdi()" class="px-3 py-1.5 rounded-lg border border-[#e4e4e7] bg-white hover:bg-gray-50 text-[#09090b] text-xs font-semibold flex items-center gap-1.5 shadow-2xs transition-colors shrink-0"><i data-lucide="refresh-cw" class="w-3.5 h-3.5 text-[#71717a]"></i><span>Sync Data UDI</span></button><button type="button" onclick="openModalTambahDosen()" class="px-3.5 py-1.5 rounded-lg bg-[#0655a7] hover:bg-[#114d91] text-white text-xs font-semibold flex items-center gap-1.5 shadow-2xs transition-colors shrink-0"><i data-lucide="user-plus" class="w-3.5 h-3.5"></i><span>Tambah Dosen</span></button></div>',
  },
  'dosen-kuota': {
    label: 'Dosen Pembimbing / Kuota Dosen',
    title: 'Kuota Dosen Pembimbing',
    subtitle: 'Monitoring beban bimbingan maksimal per dosen per semester.',
    actionButton: '',
  },
  'dosen-update': {
    label: 'Mahasiswa / Update Dosen',
    title: 'Update Dosen Pembimbing',
    subtitle: 'Ubah dosen pembimbing mahasiswa dan batalkan ACC dosen jika diperlukan.',
    actionButton: '',
  },
  'update-dosen': {
    label: 'Mahasiswa / Update Dosen',
    title: 'Update Dosen Pembimbing',
    subtitle: 'Ubah dosen pembimbing mahasiswa dan batalkan ACC dosen jika diperlukan.',
    actionButton: '',
  },
  logbook: {
    label: 'Logbook Mahasiswa',
    title: 'Daftar Logbook Mahasiswa',
    subtitle: 'Berikut adalah daftar logbook mahasiswa bimbingan.',
    actionButton: '<button type="button" class="inline-flex items-center gap-2 h-9 px-3.5 text-sm font-medium rounded-md border border-[#e4e4e7] bg-white hover:bg-[#f4f4f5] text-[#09090b] transition-colors"><i data-lucide="circle-help" class="w-4 h-4 text-[#71717a]"></i><span>Lihat panduan</span></button>',
  },
  konversi: {
    label: 'Validasi Konversi SKS',
    title: 'Validasi Konversi SKS',
    subtitle: 'Penyetujuan, revisi, dan penguncian konversi matkul/SKS mahasiswa terhadap CPL.',
    actionButton: '',
  },
  gelombang: {
    label: 'Sidang / Gelombang Sidang',
    title: 'Gelombang Sidang MBKM',
    subtitle: 'Kelola jadwal gelombang pendaftaran sidang evaluasi akhir program MBKM.',
    actionButton: '',
  },
  'data-pengajuan': {
    label: 'Sidang / Data Pengajuan',
    title: 'Data Pengajuan Sidang MBKM',
    subtitle: 'Verifikasi berkas persyaratan sidang dan kelengkapan dokumen mahasiswa.',
    actionButton: '',
  },
  'plotting-jadwal': {
    label: 'Sidang / Plotting Jadwal',
    title: 'Plotting Jadwal Sidang MBKM',
    subtitle: 'Atur jadwal sidang, ruangan, dan penetapan dosen penguji.',
    actionButton: '',
  },
  'hasil-sidang': {
    label: 'Sidang / Hasil Sidang',
    title: 'Hasil Sidang MBKM',
    subtitle: 'Berikut data sidang yang sudah diploting jadwalnya.',
    actionButton: '',
  },
  sidang: {
    label: 'Sidang',
    title: 'Sidang MBKM',
    subtitle: 'Penjadwalan sidang akhir, penginputan nilai gabungan, dan rekap kelulusan kegiatan.',
    actionButton: '',
  },
  laporan: {
    label: 'Laporan Akhir',
    title: 'Data Laporan Akhir',
    subtitle: 'Rekap berkas pertanggungjawaban dan laporan akhir program mahasiswa.',
    actionButton: '',
  },
  'log-aktivitas': {
    label: 'Log Aktivitas',
    title: 'Log Aktivitas Sistem',
    subtitle: 'Audit trail transaksional riwayat perubahan data penting pada sistem.',
    actionButton: '',
  },
  program: {
    label: 'Program',
    title: 'Data Program MBKM',
    subtitle: 'Daftar seluruh program MBKM internal dan skema asistensi mengajar terdaftar.',
    actionButton: '',
  },
};

const meta = tabMetaMap[activeTabKey] || tabMetaMap['dashboard'];
const displayBreadcrumb = meta.label;
const breadcrumbParts = displayBreadcrumb.includes('/')
  ? ['Dashboard', ...displayBreadcrumb.split('/').map(s => s.trim())]
  : (displayBreadcrumb.toLowerCase() === 'dashboard' ? ['Dashboard'] : ['Dashboard', displayBreadcrumb]);
const displayTitle = pageTitle || meta.title;
const displaySubtitle = subtitle || meta.subtitle;
const displayActionButton = actionButton !== undefined ? actionButton : meta.actionButton;

const isMbkmActive = ['mbkm', 'form-pendaftaran', 'periode'].includes(activeTabKey);
const isMahasiswaActive = ['semua-mahasiswa', 'data-mahasiswa', 'pelamar', 'surekom', 'mhs-semua', 'mhs-data', 'mhs-pelamar', 'mhs-rekomendasi', 'dosen-update', 'update-dosen'].includes(activeTabKey);
const isDosenActive = ['koordinator', 'dosen-data', 'dosen-kuota'].includes(activeTabKey);
const isSidangActive = ['sidang', 'gelombang', 'data-pengajuan', 'plotting-jadwal', 'hasil-sidang'].includes(activeTabKey);

const activeGroup = isMahasiswaActive ? 'mahasiswa' : isDosenActive ? 'dosen' : isSidangActive ? 'sidang' : isMbkmActive ? 'mbkm' : '';
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap"
      rel="stylesheet"
    />

    <!-- Tailwind CSS CDN -->
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <script is:inline>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              sans: ['Inter', 'system-ui', '-apple-system', 'sans-serif'],
            },
            colors: {
              brand: {
                DEFAULT: '#0655a7',
                dark: '#114d91',
                light: '#f1f7fe',
              },
              primary: {
                50: '#F1F7FE',
                100: '#E2EEFC',
                200: '#BFDBF8',
                300: '#86BEF3',
                400: '#1E7FD9',
                500: '#1E7FD9',
                600: '#1063B9',
                700: '#114D91',
                800: '#10447C',
                900: '#133A67',
                950: '#0D2544',
              },
              secondary: {
                50: '#FEFAEC',
                100: '#FCEEC9',
                200: '#F8DB8F',
                300: '#F4BD45',
                400: '#F2AB2D',
                500: '#F3BC45',
                600: '#D0670F',
              },
            },
            boxShadow: {
              '2xs': '0 1px 2px 0 rgba(0, 0, 0, 0.05)',
            },
          },
        },
      };
    </script>

    <!-- Lucide Icons CDN -->
    <script is:inline src="https://unpkg.com/lucide@latest"></script>

    <!-- Alpine.js Core CDN (defer) -->
    <script is:inline defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.8/dist/cdn.min.js"></script>

    <style is:global>
      [x-cloak] {
        display: none !important;
      }
      html,
      body {
        min-height: 100vh;
        margin: 0;
      }
      body {
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
      }
      .nav-active {
        color: #0655a7 !important;
        font-weight: 500 !important;
        background-color: rgba(6, 85, 167, 0.08) !important;
        position: relative;
      }
      .nav-active .active-bar {
        display: block !important;
      }
      .nav-active i {
        color: #0655a7 !important;
      }
      .nav-sub-active {
        color: #0655a7 !important;
        font-weight: 600 !important;
        background-color: rgba(6, 85, 167, 0.08) !important;
        position: relative;
      }
      .nav-sub-active .sub-active-bar {
        display: block !important;
      }
      /* Sembunyikan spin button default browser pada input number ber-badge */
      input[type='number'].no-spinner::-webkit-inner-spin-button,
      input[type='number'].no-spinner::-webkit-outer-spin-button {
        -webkit-appearance: none;
        margin: 0;
      }
      input[type='number'].no-spinner {
        -moz-appearance: textfield;
      }
    </style>
  </head>
  <body x-data class="min-h-screen bg-[#fafafa] text-[#09090b] antialiased overflow-x-hidden">
    <div class="flex min-h-screen w-full bg-[#fafafa]">
      <!-- ==================================================== -->
      <!-- 1. SIDEBAR (SESUAI DOKUMEN & SCREENSHOT CLIENT)      -->
      <!-- ==================================================== -->
      <aside
        id="sidebar"
        :class="$store.mbkm?.sidebarCollapsed ? '-ml-64' : ''"
        class="w-64 shrink-0 bg-[#fafafa] flex flex-col justify-between p-3 border-r border-[#e4e4e7]/60 min-h-screen sticky top-0 h-screen overflow-y-auto transition-all duration-200"
      >
        <div class="flex flex-col gap-2">
          <!-- Logo Institusi UDINUS -->
          <div class="flex items-center gap-2.5 p-2 mb-1">
            <img
              src="/assets/logo.png"
              alt="Logo UDINUS"
              class="object-contain w-9 h-9"
              onerror="this.src = 'https://dinus.ac.id/img/logo-dinus.png'"
            />
            <div class="flex flex-col leading-tight">
              <span class="text-[11px] font-extrabold text-[#114d91] tracking-wider uppercase">UNIVERSITAS</span>
              <span class="text-[11px] font-extrabold text-[#114d91] tracking-wider uppercase">DIAN NUSWANTORO</span>
            </div>
          </div>

          <!-- Kartu Identitas Modul Sub-App -->
          <div
            class="w-full h-12 p-2 flex items-center justify-between bg-white border border-[#e4e4e7] rounded-lg shadow-none"
          >
            <div class="flex items-center gap-2.5 overflow-hidden">
              <div class="w-8 h-8 rounded bg-[#114d91] text-white flex items-center justify-center shrink-0">
                <i data-lucide="award" class="w-4 h-4"></i>
              </div>
              <div class="flex flex-col overflow-hidden leading-tight">
                <span class="text-[13px] font-semibold text-[#3f3f46] truncate">Kampus Berdampak</span>
                <span class="text-[11px] text-[#71717a] truncate">Modul MBKM Terpadu</span>
              </div>
            </div>
            <i data-lucide="chevrons-up-down" class="w-4 h-4 text-[#71717a] shrink-0"></i>
          </div>

          <!-- Daftar Menu Navigasi Sidebar (Master MBKM Koordinator) -->
          <nav
            x-data={`{
              openMenus: (() => {
                try {
                  const saved = localStorage.getItem('sidebar-collapsed-state-admin');
                  const parsed = saved ? JSON.parse(saved) : null;
                  let list = Array.isArray(parsed) ? parsed : [];
                  const active = '${activeGroup}';
                  if (active && !list.includes(active)) {
                    list.push(active);
                  }
                  return list;
                } catch (e) {
                  return ['${activeGroup}'].filter(Boolean);
                }
              })(),
              isOpen(menu) {
                return this.openMenus.includes(menu);
              },
              toggle(menu) {
                if (this.isOpen(menu)) {
                  this.openMenus = this.openMenus.filter(m => m !== menu);
                } else {
                  this.openMenus.push(menu);
                }
                try {
                  localStorage.setItem('sidebar-collapsed-state-admin', JSON.stringify(this.openMenus));
                } catch (e) {}
              }
            }`}
            class="flex flex-col gap-1 mt-2"
          >
            <!-- 1. Dashboard -->
            <a
              href="/admin/dashboard"
              id="nav-dashboard"
              class:list={[
                "nav-item relative flex items-center gap-3 px-4 py-2.5 rounded-lg text-[14px] font-normal hover:bg-black/5 transition-colors text-left w-full",
                activeTabKey === 'dashboard' ? 'nav-active text-[#0655a7]' : 'text-[#3f3f46]'
              ]}
            >
              <span class:list={["active-bar absolute left-0 top-2 bottom-2 w-1 bg-[#0655a7] rounded-r-md", activeTabKey === 'dashboard' ? '' : 'hidden']}></span>
              <i data-lucide="layout-dashboard" class="w-4 h-4 text-[#71717a] shrink-0"></i>
              <span class="truncate">Dashboard</span>
            </a>

            <!-- 2. Pengumuman -->
            <a
              href="/admin/pengumuman"
              id="nav-pengumuman"
              class:list={[
                "nav-item relative flex items-center gap-3 px-4 py-2.5 rounded-lg text-[14px] font-normal hover:bg-black/5 transition-colors text-left w-full",
                activeTabKey === 'pengumuman' ? 'nav-active text-[#0655a7]' : 'text-[#3f3f46]'
              ]}
            >
              <span class:list={["active-bar absolute left-0 top-2 bottom-2 w-1 bg-[#0655a7] rounded-r-md", activeTabKey === 'pengumuman' ? '' : 'hidden']}></span>
              <i data-lucide="megaphone" class="w-4 h-4 text-[#71717a] shrink-0"></i>
              <span class="truncate">Pengumuman</span>
            </a>

            <!-- 3. Kontributor (Mandiri) -->
            <a
              href="/admin/kontributor"
              id="nav-kontributor"
              class:list={[
                "nav-item relative flex items-center gap-3 px-4 py-2.5 rounded-lg text-[14px] font-normal hover:bg-black/5 transition-colors text-left w-full",
                activeTabKey === 'mitra' || activeTabKey === 'kontributor' ? 'nav-active text-[#0655a7]' : 'text-[#3f3f46]'
              ]}
            >
              <span class:list={["active-bar absolute left-0 top-2 bottom-2 w-1 bg-[#0655a7] rounded-r-md", activeTabKey === 'mitra' || activeTabKey === 'kontributor' ? '' : 'hidden']}></span>
              <i data-lucide="building-2" class="w-4 h-4 text-[#71717a] shrink-0"></i>
              <span class="truncate">Kontributor</span>
            </a>

            <!-- 5. Mahasiswa (Sub-menu: Semua Mahasiswa, Data Mahasiswa, Pendaftar, Validasi Surekom) -->
            <div class="flex flex-col">
              <button
                type="button"
                @click="toggle('mahasiswa')"
                id="nav-mahasiswa"
                class:list={[
                  "nav-item relative flex items-center justify-between px-4 py-2.5 rounded-lg text-[14px] font-normal hover:bg-black/5 transition-colors text-left w-full",
                  isMahasiswaActive ? 'text-[#0655a7] font-medium' : 'text-[#3f3f46]'
                ]}
              >
                <div class="flex items-center gap-3">
                  <i data-lucide="graduation-cap" class:list={["w-4 h-4 shrink-0", isMahasiswaActive ? 'text-[#0655a7]' : 'text-[#71717a]']}></i>
                  <span class="truncate">Mahasiswa</span>
                </div>
                <i
                  id="mahasiswa-chevron"
                  data-lucide="chevron-down"
                  :class="isOpen('mahasiswa') ? 'rotate-180' : ''"
                  class:list={["w-3.5 h-3.5 transition-transform duration-200", isMahasiswaActive ? 'text-[#0655a7]' : 'text-[#71717a]']}
                ></i>
              </button>
              <div id="submenu-mahasiswa" x-show="isOpen('mahasiswa')" x-cloak class="flex flex-col gap-0.5 py-1 pr-2 pl-9">
                <a
                  href="/admin/semua-mahasiswa"
                  id="nav-sub-mhs-semua"
                  class:list={[
                    "nav-sub-item relative px-3 py-2 rounded-lg text-[13px] hover:text-[#0655a7] hover:bg-blue-50/60 font-medium text-left transition-colors flex items-center",
                    activeTabKey === 'mhs-semua' ? 'nav-sub-active' : 'text-[#71717a]'
                  ]}
                >
                  <span class:list={["sub-active-bar absolute left-0 top-1.5 bottom-1.5 w-1 bg-[#0655a7] rounded-r-md", activeTabKey === 'mhs-semua' ? '' : 'hidden']}></span>
                  <span>Semua Mahasiswa</span>
                </a>
                <a
                  href="/admin/data-mahasiswa"
                  id="nav-sub-mhs-data"
                  class:list={[
                    "nav-sub-item relative px-3 py-2 rounded-lg text-[13px] hover:text-[#0655a7] hover:bg-blue-50/60 font-medium text-left transition-colors flex items-center",
                    activeTabKey === 'mhs-data' || activeTabKey === 'data-mahasiswa' ? 'nav-sub-active' : 'text-[#71717a]'
                  ]}
                >
                  <span class:list={["sub-active-bar absolute left-0 top-1.5 bottom-1.5 w-1 bg-[#0655a7] rounded-r-md", activeTabKey === 'mhs-data' || activeTabKey === 'data-mahasiswa' ? '' : 'hidden']}></span>
                  <span>Data Mahasiswa</span>
                </a>
                <a
                  href="/admin/pelamar"
                  id="nav-sub-mhs-pelamar"
                  class:list={[
                    "nav-sub-item relative px-3 py-2 rounded-lg text-[13px] hover:text-[#0655a7] hover:bg-blue-50/60 font-medium text-left transition-colors flex items-center",
                    activeTabKey === 'mhs-pelamar' ? 'nav-sub-active' : 'text-[#71717a]'
                  ]}
                >
                  <span class:list={["sub-active-bar absolute left-0 top-1.5 bottom-1.5 w-1 bg-[#0655a7] rounded-r-md", activeTabKey === 'mhs-pelamar' ? '' : 'hidden']}></span>
                  <span>Pendaftar</span>
                </a>
                <a
                  href="/admin/surekom"
                  id="nav-sub-mhs-rekomendasi"
                  class:list={[
                    "nav-sub-item relative px-3 py-2 rounded-lg text-[13px] hover:text-[#0655a7] hover:bg-blue-50/60 font-medium text-left transition-colors flex items-center",
                    activeTabKey === 'mhs-rekomendasi' ? 'nav-sub-active' : 'text-[#71717a]'
                  ]}
                >
                  <span class:list={["sub-active-bar absolute left-0 top-1.5 bottom-1.5 w-1 bg-[#0655a7] rounded-r-md", activeTabKey === 'mhs-rekomendasi' ? '' : 'hidden']}></span>
                  <span>Validasi Surekom</span>
                </a>
                <a
                  href="/admin/dosen-update"
                  id="nav-sub-mhs-update-dosen"
                  class:list={[
                    "nav-sub-item relative px-3 py-2 rounded-lg text-[13px] hover:text-[#0655a7] hover:bg-blue-50/60 font-medium text-left transition-colors flex items-center",
                    (activeTabKey === 'dosen-update' || activeTabKey === 'update-dosen') ? 'nav-sub-active' : 'text-[#71717a]'
                  ]}
                >
                  <span class:list={["sub-active-bar absolute left-0 top-1.5 bottom-1.5 w-1 bg-[#0655a7] rounded-r-md", (activeTabKey === 'dosen-update' || activeTabKey === 'update-dosen') ? '' : 'hidden']}></span>
                  <span>Update Dosen</span>
                </a>
              </div>
            </div>

            <!-- 6. Dosen Pembimbing (Sub-menu: Data Dosen, Kuota Dosen) -->
            <div class="flex flex-col">
              <button
                type="button"
                @click="toggle('dosen')"
                id="nav-dosen"
                class:list={[
