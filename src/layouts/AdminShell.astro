                  isMbkmActive ? 'text-[#0655a7] font-medium' : 'text-[#3f3f46]'
                ]}
              >
                <div class="flex items-center gap-3">
                  <i data-lucide="briefcase" class:list={["w-4 h-4 shrink-0", isMbkmActive ? 'text-[#0655a7]' : 'text-[#71717a]']}></i>
