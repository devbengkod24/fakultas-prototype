---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Kampus Berdampak - MBKM FIK UDINUS",
  description = "Portal Prototipe Program MBKM Fakultas Ilmu Komputer Universitas Dian Nuswantoro"
} = Astro.props;
---

<!DOCTYPE html>
<html lang="id" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Google Fonts Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  </head>
  <body class="min-h-full flex flex-col bg-slate-50 text-slate-800 antialiased selection:bg-[#0655a7] selection:text-white">
    <slot />
  </body>
</html>
