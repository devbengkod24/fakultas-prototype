    function goToPelamarPage(p) {
      var totalPages = Math.ceil(getFilteredPelamarData().length / pelamarItemsPerPage) || 1;
      if (p < 1 || p > totalPages) return;
      pelamarCurrentPage = p;
      renderPelamarTable();
    }

    function terimaPelamar(id) {
      var item = pFind(id);
      if (!item) return;
      item.status = 'diterima';
      renderPelamarTable();
      if (typeof showToast === 'function') showToast('Pendaftar Diterima', item.nama + ' berhasil diterima.');
    }

    function tolakPelamar(id) {
      var item = pFind(id);
      if (!item) return;
      item.status = 'ditolak';
      renderPelamarTable();
      if (typeof showToast === 'function') showToast('Pendaftar Ditolak', item.nama + ' ditolak.');
    }

    function lihatTranskripPelamar(id) {
      var item = pFind(id);
      if (!item) return;
      var nama = document.getElementById('modal-transkrip-nama');
      var nim = document.getElementById('modal-transkrip-nim');
      var ipk = document.getElementById('modal-transkrip-ipk');
      var sks = document.getElementById('modal-transkrip-sks');
      if (nama) nama.textContent = item.nama;
      if (nim) nim.textContent = item.nim + ' • ' + item.prodi;
      if (ipk) ipk.textContent = 'IPK ' + item.ipk;
      if (sks) sks.textContent = item.sksLulus + ' SKS Lulus';
      var modal = document.getElementById('modal-transkrip-pelamar');
      if (modal) modal.classList.remove('hidden');
      pIcons();
    }

    function closeTranskripModal() {
      var modal = document.getElementById('modal-transkrip-pelamar');
      if (modal) modal.classList.add('hidden');
    }

    function exportDataPelamar() {
      alert('Mengunduh data pendaftar mahasiswa MBKM (Format: Excel .xlsx)...');
    }

    function pelamarInit() {
      if (!document.getElementById('section-mhs-pelamar')) return;
      renderPelamarTable();
      pIcons();
    }
    document.removeEventListener('astro:page-load', window.__pelamarInit);
    window.__pelamarInit = pelamarInit;
    document.addEventListener('astro:page-load', pelamarInit);
    document.removeEventListener('DOMContentLoaded', window.__pelamarInit);
    document.addEventListener('DOMContentLoaded', pelamarInit);

    document.removeEventListener('keydown', window.__pelamarEsc);
    window.__pelamarEsc = function (e) {
      if (e.key !== 'Escape') return;
      if (document.getElementById('modal-transkrip-pelamar')) closeTranskripModal();
    };
    document.addEventListener('keydown', window.__pelamarEsc);
  </script>
</KontributorShell>
