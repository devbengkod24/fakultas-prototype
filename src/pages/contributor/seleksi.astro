                <td class="py-2 px-3 font-medium text-[#09090b]">A11.54301 — Rekayasa Perangkat Lunak</td>
                <td class="py-2 px-3 text-center">3</td>
                <td class="py-2 px-3 text-center font-bold text-emerald-600">A</td>
              </tr>
              <tr>
                <td class="py-2 px-3 font-medium text-[#09090b]">A11.54402 — Basis Data Lanjut</td>
                <td class="py-2 px-3 text-center">4</td>
