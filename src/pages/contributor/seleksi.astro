          p.nama.toLowerCase().indexOf(pelamarSearchQuery) > -1 ||
          p.nim.toLowerCase().indexOf(pelamarSearchQuery) > -1 ||
          p.program.toLowerCase().indexOf(pelamarSearchQuery) > -1 ||
          p.kontributor.toLowerCase().indexOf(pelamarSearchQuery) > -1;

        var matchKontributor = true;
        if (pelamarFilterKontributor === 'eksternal') matchKontributor = p.kategoriKontributor === 'eksternal';
        else if (pelamarFilterKontributor === 'internal') matchKontributor = p.kategoriKontributor === 'internal';
        else if (pelamarFilterKontributor !== 'semua') matchKontributor = p.kontributor === pelamarFilterKontributor;

        var matchProdi = pelamarFilterProdi === 'semua' || p.prodi === pelamarFilterProdi;

        return matchStatus && matchQuery && matchKontributor && matchProdi;
