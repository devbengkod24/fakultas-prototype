              </tr>
              <tr>
                <td class="py-2 px-3 font-medium text-[#09090b]">A11.54503 — Pemrograman Web Framework</td>
                <td class="py-2 px-3 text-center">3</td>
                <td class="py-2 px-3 text-center font-bold text-emerald-600">A</td>
              </tr>
              <tr>
                <td class="py-2 px-3 font-medium text-[#09090b]">A11.54604 — Jaringan Komputer & Cloud</td>
                <td class="py-2 px-3 text-center">3</td>
                <td class="py-2 px-3 text-center font-bold text-blue-600">AB</td>
              </tr>
              <tr>
                <td class="py-2 px-3 font-medium text-[#09090b]">A11.54705 — Kecerdasan Buatan</td>
                <td class="py-2 px-3 text-center">3</td>
                <td class="py-2 px-3 text-center font-bold text-emerald-600">A</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <div class="flex items-center justify-between pt-2 border-t border-[#e4e4e7]">
        <span class="text-xs text-emerald-600 font-medium flex items-center gap-1">
          <i data-lucide="check-circle" class="w-3.5 h-3.5"></i>
          <span>Bebas Nilai E &amp; D</span>
        </span>
        <button
          type="button"
          onclick="closeTranskripModal()"
          class="px-4 py-2 text-xs font-medium rounded-md bg-[#0655a7] hover:bg-[#0655a7]/90 text-white transition-colors"
        >
          Tutup
        </button>
      </div>
    </div>
  </div>

