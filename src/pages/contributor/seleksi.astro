      if (pendaftarSort === 'ipk-tinggi') {
        list.sort(function (a, b) { return parseFloat(b.ipk) - parseFloat(a.ipk); });
      } else if (pendaftarSort === 'nama-asc') {
        list.sort(function (a, b) { return a.nama.localeCompare(b.nama); });
      } else {
        list.sort(function (a, b) { return b.id - a.id; });
