---
// src/pages/contributor/seleksi.astro  (menu: Pendaftar)
import KontributorShell from '../../layouts/KontributorShell.astro';

const pelamarActions = `
  <button
    type="button"
    class="inline-flex items-center gap-2 h-9 px-3.5 text-sm font-medium rounded-md border border-[#e4e4e7] bg-white hover:bg-[#f4f4f5] text-[#09090b] transition-colors"
  >
    <i data-lucide="help-circle" class="w-4 h-4 text-[#71717a]"></i>
    <span>Lihat Panduan</span>
  </button>
`;
---

<KontributorShell
  activeNav="seleksi"
  breadcrumbTitle={["Dashboard", "Kontributor"]}
  pageTitle="Daftar Pengajuan Mahasiswa Pendaftar"
  subtitle="Berikut ini adalah daftar semua pengajuan mahasiswa pendaftar ke program MBKM kontributor eksternal."
  actionButton={pelamarActions}
  hidePageHeader={false}
  title="Daftar Pengajuan Mahasiswa Pendaftar | Portal Kontributor"
>
  <section
    id="section-mhs-pelamar"
    class="flex flex-col flex-1 min-h-0 gap-4 pr-1 overflow-y-auto tab-content"
  >
    <div class="space-y-4">
      <!-- Status Tabs Row -->
      <div class="border-b border-[#e4e4e7] mb-2 flex items-center justify-between gap-4">
        <div class="flex items-center gap-6 overflow-x-auto pb-0">
          <button
            type="button"
            id="tab-pendaftar-baru"
            onclick="switchPendaftarStatusTab('baru')"
            class="flex items-center gap-2 pb-3 text-sm font-semibold border-b-2 border-[#0655a7] text-[#0655a7] transition-colors"
          >
            <i data-lucide="inbox" class="w-4 h-4"></i>
            <span>Baru</span>
            <span id="badge-count-pendaftar-baru" class="ml-1 px-2 py-0.5 text-xs font-semibold rounded-full bg-blue-100 text-[#0655a7]">10</span>
          </button>

          <button
            type="button"
            id="tab-pendaftar-diterima"
            onclick="switchPendaftarStatusTab('diterima')"
            class="flex items-center gap-2 pb-3 text-sm font-medium border-b-2 border-transparent text-[#71717a] hover:text-[#09090b] transition-colors"
          >
            <i data-lucide="check" class="w-4 h-4"></i>
            <span>Diterima</span>
            <span id="badge-count-pendaftar-diterima" class="ml-1 px-2 py-0.5 text-xs font-semibold rounded-full bg-emerald-50 text-emerald-700">0</span>
          </button>

          <button
            type="button"
            id="tab-pendaftar-ditolak"
            onclick="switchPendaftarStatusTab('ditolak')"
            class="flex items-center gap-2 pb-3 text-sm font-medium border-b-2 border-transparent text-[#71717a] hover:text-[#09090b] transition-colors"
          >
            <i data-lucide="x" class="w-4 h-4"></i>
            <span>Ditolak</span>
            <span id="badge-count-pendaftar-ditolak" class="ml-1 px-2 py-0.5 text-xs font-semibold rounded-full bg-red-50 text-red-700">0</span>
          </button>

          <button
            type="button"
            id="tab-pendaftar-dibatalkan"
            onclick="switchPendaftarStatusTab('dibatalkan')"
            class="flex items-center gap-2 pb-3 text-sm font-medium border-b-2 border-transparent text-[#71717a] hover:text-[#09090b] transition-colors"
          >
            <i data-lucide="ban" class="w-4 h-4"></i>
            <span>Dibatalkan</span>
            <span id="badge-count-pendaftar-dibatalkan" class="ml-1 px-2 py-0.5 text-xs font-semibold rounded-full bg-slate-100 text-slate-700">0</span>
          </button>
        </div>

        <!-- Tombol Export Excel -->
        <div class="pb-2.5 shrink-0">
          <button
            type="button"
            onclick="exportDataPelamar()"
            id="btn-export-pelamar"
            class="inline-flex items-center gap-2 h-8 px-3 text-xs font-medium rounded-md border border-[#e4e4e7] bg-white hover:bg-[#f4f4f5] text-[#09090b] transition-colors shadow-none cursor-pointer"
            title="Export Data Pendaftar ke Excel"
          >
            <i data-lucide="file-spreadsheet" class="w-3.5 h-3.5 text-emerald-600"></i>
            <span>Export Excel</span>
          </button>
        </div>
      </div>

      <!-- Filter & Search Toolbar -->
      <div class="mb-4 flex flex-col lg:flex-row lg:items-center justify-between gap-3">
        <!-- Search Box -->
        <div class="relative w-full lg:w-96">
          <i data-lucide="search" class="w-4 h-4 text-[#71717a] absolute left-3 top-1/2 -translate-y-1/2"></i>
          <input
            type="text"
            id="search-pelamar"
            oninput="handleSearchPelamar(this.value)"
            placeholder="Cari berdasarkan nama, NIM, atau judul..."
            class="h-9 w-full rounded-md border border-[#e4e4e7] bg-white pl-9 pr-3 text-sm text-[#09090b] placeholder:text-[#71717a] focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
          />
        </div>

        <!-- Controls Group: View Mode, Sort, Filters -->
        <div class="flex flex-wrap items-center gap-2">
          <select
            id="select-pendaftar-view"
            onchange="switchPendaftarViewMode(this.value)"
            class="h-9 px-3 rounded-md border border-[#e4e4e7] bg-white text-xs font-medium text-[#09090b] focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
          >
            <option value="kartu" selected>⊞ Kartu</option>
            <option value="tabel">☰ Tabel</option>
          </select>

          <select
            id="select-pendaftar-sort"
            onchange="handleSortPendaftar(this.value)"
            class="h-9 px-3 rounded-md border border-[#e4e4e7] bg-white text-xs font-medium text-[#09090b] focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
          >
            <option value="terbaru" selected>⏱ Terbaru</option>
            <option value="ipk-tinggi">🎖 IPK Tertinggi</option>
            <option value="nama-asc">🔤 Nama (A - Z)</option>
          </select>

          <select
            id="filter-pelamar-kontributor"
            onchange="handleFilterPelamarKontributor(this.value)"
            class="h-9 px-3 rounded-md border border-[#e4e4e7] bg-white text-xs font-medium text-[#09090b] focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
          >
            <option value="semua">Semua Kontributor</option>
            <option value="eksternal" selected>Kontributor Eksternal (Koordinator)</option>
            <option value="internal">Kontributor Internal (Read-Only)</option>
            <option value="Dicoding Indonesia">Dicoding Indonesia</option>
            <option value="Bangkit Academy">Bangkit Academy</option>
            <option value="PT Telkom Indonesia">PT Telkom Indonesia</option>
            <option value="Bengkel Koding">Bengkel Koding</option>
            <option value="Ryuje Tech Studio">Ryuje Tech Studio</option>
            <option value="IDSS Laboratory">IDSS Laboratory</option>
          </select>

          <select
            id="filter-pelamar-prodi"
            onchange="handleFilterPelamarProdi(this.value)"
            class="h-9 px-3 rounded-md border border-[#e4e4e7] bg-white text-xs font-medium text-[#09090b] focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
          >
            <option value="semua" selected>Semua Bidang / Prodi</option>
            <option value="S1 Teknik Informatika">S1 Teknik Informatika</option>
            <option value="S1 Sistem Informasi">S1 Sistem Informasi</option>
            <option value="S1 DKV">S1 DKV</option>
          </select>
        </div>
      </div>

      <!-- Container Tampilan Kartu (Default) -->
      <div id="pendaftar-cards-container" class="space-y-4"></div>

      <!-- Container Tampilan Tabel -->
      <div id="pendaftar-table-container" class="rounded-lg border border-[#e4e4e7] overflow-hidden bg-white hidden">
        <table class="w-full text-sm">
          <thead class="border-b border-[#e4e4e7] bg-[#fafafa]">
            <tr>
              <th class="h-11 px-4 font-medium text-sm w-16 text-center text-[#71717a]">No</th>
              <th class="h-11 px-4 font-medium text-sm text-left text-[#71717a]">Mahasiswa</th>
              <th class="h-11 px-4 font-medium text-sm text-left text-[#71717a]">Program & Kontributor MBKM</th>
              <th class="h-11 px-4 font-medium text-sm text-left text-[#71717a]">Akademik</th>
              <th class="h-11 px-4 font-medium text-sm text-left text-[#71717a]">Matakuliah Diambil</th>
              <th class="h-11 px-4 font-medium text-sm w-36 text-center text-[#71717a]">Aksi</th>
            </tr>
          </thead>
          <tbody id="pelamar-table-tbody" class="divide-y divide-[#e4e4e7]"></tbody>
        </table>
      </div>

      <!-- Pagination Footer -->
      <div class="pt-2 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-[#71717a]">
        <div id="pelamar-table-info">Menampilkan pendaftar</div>
        <div id="pelamar-pagination-controls" class="flex items-center gap-1"></div>
      </div>
    </div>
  </section>

  <!-- Modal: Transkrip Akademik -->
  <div id="modal-transkrip-pelamar" class="fixed inset-0 z-50 bg-black/50 flex items-center justify-center hidden p-4">
    <div class="bg-white rounded-xl border border-[#e4e4e7] shadow-xl max-w-lg w-full p-6 space-y-4 text-sm">
      <div class="flex items-center justify-between pb-3 border-b border-[#e4e4e7]">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-lg bg-blue-50 text-[#0655a7] flex items-center justify-center shrink-0">
            <i data-lucide="file-text" class="w-4 h-4"></i>
          </div>
          <div>
            <h3 class="text-base font-semibold text-[#09090b]">Transkrip Akademik Mahasiswa</h3>
            <p class="text-xs text-[#71717a]">Data resmi terverifikasi dari database akademik SIADIN</p>
          </div>
        </div>
        <button type="button" onclick="closeTranskripModal()" class="text-[#71717a] hover:text-[#09090b] p-1 rounded-md">
          <i data-lucide="x" class="w-4 h-4"></i>
        </button>
      </div>

      <div class="space-y-3">
        <div class="p-3 rounded-lg border border-[#e4e4e7] bg-[#fafafa] flex items-center justify-between">
          <div>
            <div id="modal-transkrip-nama" class="font-bold text-[#09090b]">-</div>
            <div id="modal-transkrip-nim" class="text-xs text-[#71717a]">-</div>
          </div>
          <div class="text-right">
            <div id="modal-transkrip-ipk" class="text-sm font-bold text-[#0655a7]">-</div>
            <div id="modal-transkrip-sks" class="text-xs text-[#71717a]">-</div>
          </div>
        </div>

        <div class="rounded-lg border border-[#e4e4e7] overflow-hidden">
          <table class="w-full text-xs">
            <thead class="bg-[#fafafa] border-b border-[#e4e4e7] text-[#71717a]">
              <tr>
                <th class="py-2 px-3 text-left">Kode & Mata Kuliah</th>
                <th class="py-2 px-3 text-center">SKS</th>
                <th class="py-2 px-3 text-center">Nilai</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[#e4e4e7]">
