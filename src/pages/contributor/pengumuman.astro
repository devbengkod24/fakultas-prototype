---
// src/pages/contributor/pengumuman.astro
import KontributorShell from '../../layouts/KontributorShell.astro';
---

<KontributorShell activeNav="pengumuman" breadcrumbTitle="Pengumuman" title="Pengumuman | Kampus Berdampak FIK UDINUS">
  <section id="view-pengumuman" class="view-panel mt-5 space-y-6">
    <!-- Page Header -->
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div>
        <h2 class="text-[20px] leading-[28px] font-normal text-[#09090b]">Pengumuman</h2>
        <p class="text-[14px] leading-[20px] text-[#71717a]">Siaran informasi resmi kontributor untuk peserta, pelamar, dan dosen pembimbing.</p>
      </div>
      <button type="button" onclick="kpgOpenModal()" class="inline-flex items-center gap-2 px-4 py-2 bg-[#1063B9] hover:bg-[#0E4F96] text-white text-xs font-semibold rounded-lg shadow-2xs transition-all active:scale-[0.98]">
        <i data-lucide="plus" class="w-4 h-4"></i>
        <span>Tambah Pengumuman</span>
      </button>
    </div>

    <!-- Tab Status -->
    <div id="kpg-tabs" role="tablist" class="flex items-center gap-1 border-b border-[#e4e4e7]">
      <button type="button" role="tab" data-status="published" onclick="kpgSetFilter('status', 'published')" class="kpg-tab"></button>
      <button type="button" role="tab" data-status="draft" onclick="kpgSetFilter('status', 'draft')" class="kpg-tab"></button>
    </div>

    <!-- Toolbar: Search & Filter -->
    <div class="flex flex-col sm:flex-row sm:items-center gap-3">
      <div class="relative w-full sm:w-72 md:w-80">
        <i data-lucide="search" class="w-4 h-4 text-[#71717a] absolute left-3 top-1/2 -translate-y-1/2"></i>
        <input
          type="text"
          id="kpg-search"
          oninput="kpgSetFilter('q', this.value)"
          placeholder="Cari pengumuman..."
          class="h-9 w-full rounded-md border border-[#e4e4e7] bg-white pl-9 pr-3 text-sm text-[#09090b] placeholder:text-[#71717a] focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
        />
      </div>
      <select
        id="kpg-filter-sasaran"
        onchange="kpgSetFilter('sasaran', this.value)"
        class="h-9 w-full sm:w-56 px-3 rounded-md border border-[#e4e4e7] bg-white text-sm text-[#09090b] focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
      >
        <option value="semua">Semua Sasaran</option>
        <option value="semua_peserta">Semua (Peserta &amp; Pelamar)</option>
        <option value="diterima">Peserta Diterima</option>
        <option value="dpl">DPL</option>
      </select>
    </div>

    <!-- Tabel Riwayat Pengumuman -->
    <div class="bg-white border border-[#e4e4e7] rounded-[12px] shadow-2xs overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs border-collapse">
          <thead>
            <tr class="bg-gray-50 text-[11px] font-semibold text-[#71717a] uppercase tracking-wider border-b border-[#e4e4e7]">
              <th class="py-2.5 px-4">Pengumuman</th>
              <th class="py-2.5 px-4">Sasaran</th>
              <th class="py-2.5 px-4">Lampiran</th>
              <th class="py-2.5 px-4">Tanggal Publikasi</th>
              <th class="py-2.5 px-4">Status</th>
              <th class="py-2.5 px-4 text-right">Aksi</th>
            </tr>
          </thead>
          <tbody id="kpg-tbody" class="divide-y divide-gray-100"></tbody>
        </table>
      </div>
      <div class="px-4 py-3 border-t border-[#e4e4e7] flex flex-col md:flex-row items-center justify-between gap-3 text-xs text-[#71717a]">
        <div id="kpg-info">Menampilkan pengumuman</div>
        <div id="kpg-pagination" class="flex items-center gap-1"></div>
      </div>
    </div>
  </section>

  <!-- Modal: Tambah / Edit Pengumuman -->
  <div id="kpg-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/40" onclick="if(event.target===this)kpgCloseModal()">
    <div class="bg-white w-full max-w-2xl max-h-[92vh] flex flex-col rounded-[12px] shadow-xl border border-[#e4e4e7]">
      <div class="flex items-center justify-between px-5 py-4 border-b border-[#e4e4e7]">
        <h3 id="kpg-modal-title" class="text-[15px] font-semibold text-[#09090b] flex items-center gap-2">Tambah Pengumuman</h3>
        <button type="button" onclick="kpgCloseModal()" class="p-1 rounded hover:bg-gray-100 text-[#71717a]" aria-label="Tutup">
          <i data-lucide="x" class="w-4 h-4"></i>
        </button>
      </div>

      <form id="kpg-form" class="flex-1 overflow-y-auto px-5 py-4 space-y-4" onsubmit="return false">
        <input type="hidden" id="kpg-id" />

        <div class="space-y-1.5">
          <label for="kpg-judul" class="block text-xs font-semibold text-gray-700">Judul <span class="text-red-500">*</span></label>
          <input type="text" id="kpg-judul" maxlength="150" placeholder="Contoh: Jadwal Wawancara Seleksi Batch 1" class="w-full px-3.5 py-2 text-xs border border-gray-300 rounded-lg focus:border-[#1063B9] outline-none" />
          <p id="kpg-err-judul" class="hidden text-[11px] text-red-600">Judul wajib diisi.</p>
        </div>

        <div class="space-y-1.5">
          <label class="block text-xs font-semibold text-gray-700">Isi Pengumuman <span class="text-red-500">*</span></label>
          <div class="border border-gray-300 rounded-lg overflow-hidden focus-within:border-[#1063B9]">
            <div class="flex flex-wrap items-center gap-0.5 px-2 py-1.5 bg-gray-50 border-b border-gray-200">
              <button type="button" onmousedown="event.preventDefault()" onclick="kpgFormat('bold')" title="Tebal" class="p-1.5 rounded hover:bg-gray-200 text-gray-700"><i data-lucide="bold" class="w-3.5 h-3.5"></i></button>
              <button type="button" onmousedown="event.preventDefault()" onclick="kpgFormat('italic')" title="Miring" class="p-1.5 rounded hover:bg-gray-200 text-gray-700"><i data-lucide="italic" class="w-3.5 h-3.5"></i></button>
              <button type="button" onmousedown="event.preventDefault()" onclick="kpgFormat('underline')" title="Garis bawah" class="p-1.5 rounded hover:bg-gray-200 text-gray-700"><i data-lucide="underline" class="w-3.5 h-3.5"></i></button>
              <span class="w-px h-4 bg-gray-300 mx-1"></span>
              <button type="button" onmousedown="event.preventDefault()" onclick="kpgFormat('insertUnorderedList')" title="Daftar poin" class="p-1.5 rounded hover:bg-gray-200 text-gray-700"><i data-lucide="list" class="w-3.5 h-3.5"></i></button>
              <button type="button" onmousedown="event.preventDefault()" onclick="kpgFormat('insertOrderedList')" title="Daftar nomor" class="p-1.5 rounded hover:bg-gray-200 text-gray-700"><i data-lucide="list-ordered" class="w-3.5 h-3.5"></i></button>
              <span class="w-px h-4 bg-gray-300 mx-1"></span>
              <button type="button" onmousedown="event.preventDefault()" onclick="kpgInsertLink()" title="Sisipkan tautan" class="p-1.5 rounded hover:bg-gray-200 text-gray-700"><i data-lucide="link" class="w-3.5 h-3.5"></i></button>
              <button type="button" onmousedown="event.preventDefault()" onclick="kpgFormat('removeFormat')" title="Hapus format" class="p-1.5 rounded hover:bg-gray-200 text-gray-700"><i data-lucide="remove-formatting" class="w-3.5 h-3.5"></i></button>
            </div>
            <div id="kpg-isi" contenteditable="true" role="textbox" aria-multiline="true" class="min-h-[160px] max-h-[280px] overflow-y-auto px-3.5 py-3 text-xs leading-relaxed text-[#09090b] outline-none [&_ul]:list-disc [&_ul]:pl-5 [&_ol]:list-decimal [&_ol]:pl-5 [&_a]:text-[#1063B9] [&_a]:underline"></div>
          </div>
          <p id="kpg-err-isi" class="hidden text-[11px] text-red-600">Isi pengumuman wajib diisi.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="space-y-1.5">
            <label for="kpg-sasaran" class="block text-xs font-semibold text-gray-700">Sasaran <span class="text-red-500">*</span></label>
            <select id="kpg-sasaran" class="w-full px-3.5 py-2 text-xs border border-gray-300 rounded-lg focus:border-[#1063B9] outline-none bg-white">
              <option value="semua_peserta">Semua (Peserta &amp; Pelamar)</option>
              <option value="diterima">Peserta Diterima</option>
              <option value="dpl">DPL</option>
            </select>
            <p id="kpg-sasaran-hint" class="text-[11px] text-[#71717a]"></p>
          </div>
          <div class="space-y-1.5">
            <label for="kpg-status" class="block text-xs font-semibold text-gray-700">Status</label>
            <select id="kpg-status" class="w-full px-3.5 py-2 text-xs border border-gray-300 rounded-lg focus:border-[#1063B9] outline-none bg-white">
              <option value="published">Dipublikasikan</option>
              <option value="draft">Simpan sebagai Draf</option>
            </select>
          </div>
        </div>

        <div class="space-y-1.5">
          <label for="kpg-lampiran" class="block text-xs font-semibold text-gray-700">Tautan Lampiran Google Drive <span class="text-[#71717a] font-normal">(opsional)</span></label>
          <input type="url" id="kpg-lampiran" placeholder="https://drive.google.com/..." class="w-full px-3.5 py-2 text-xs border border-gray-300 rounded-lg focus:border-[#1063B9] outline-none" />
          <p id="kpg-err-lampiran" class="hidden text-[11px] text-red-600">Gunakan tautan Google Drive atau Google Docs yang valid.</p>
        </div>
      </form>

      <div class="flex items-center justify-end gap-2 px-5 py-3 border-t border-[#e4e4e7] bg-gray-50 rounded-b-[12px]">
        <button type="button" onclick="kpgCloseModal()" class="px-4 py-2 text-xs font-medium text-gray-700 border border-gray-300 rounded-lg hover:bg-white">Batal</button>
        <button type="button" onclick="kpgSave()" class="px-4 py-2 text-xs font-semibold text-white bg-[#1063B9] hover:bg-[#0E4F96] rounded-lg">Simpan</button>
      </div>
    </div>
  </div>

  <!-- Modal: Detail Pengumuman -->
  <div id="kpg-detail" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/40" onclick="if(event.target===this)kpgCloseDetail()">
    <div class="bg-white w-full max-w-xl max-h-[88vh] flex flex-col rounded-[12px] shadow-xl border border-[#e4e4e7]">
      <div class="flex items-start justify-between gap-3 px-5 py-4 border-b border-[#e4e4e7]">
        <div class="min-w-0">
          <h3 id="kpg-detail-judul" class="text-[15px] font-semibold text-[#09090b]"></h3>
          <p id="kpg-detail-meta" class="text-[11px] text-[#71717a] mt-1"></p>
        </div>
        <button type="button" onclick="kpgCloseDetail()" class="p-1 rounded hover:bg-gray-100 text-[#71717a] shrink-0" aria-label="Tutup">
          <i data-lucide="x" class="w-4 h-4"></i>
        </button>
      </div>
      <div class="flex-1 overflow-y-auto px-5 py-4 space-y-4">
        <div id="kpg-detail-isi" class="text-xs leading-relaxed text-[#09090b] [&_ul]:list-disc [&_ul]:pl-5 [&_ol]:list-decimal [&_ol]:pl-5 [&_a]:text-[#1063B9] [&_a]:underline"></div>
        <div id="kpg-detail-lampiran"></div>
      </div>
    </div>
  </div>

  <!-- Modal: Konfirmasi Hapus -->
  <div id="kpg-delete" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/40" onclick="if(event.target===this)kpgCloseDelete()">
    <div class="bg-white w-full max-w-sm rounded-[12px] shadow-xl border border-[#e4e4e7] p-5 space-y-4">
      <div class="flex items-start gap-3">
        <div class="w-9 h-9 rounded-full bg-rose-50 text-rose-600 flex items-center justify-center shrink-0">
          <i data-lucide="trash-2" class="w-4 h-4"></i>
        </div>
        <div>
          <h3 class="text-[14px] font-semibold text-[#09090b]">Hapus pengumuman?</h3>
          <p class="text-xs text-[#71717a] mt-1">"<span id="kpg-delete-judul"></span>" akan dihapus dan tidak lagi tampil bagi sasarannya.</p>
        </div>
      </div>
      <div class="flex justify-end gap-2">
        <button type="button" onclick="kpgCloseDelete()" class="px-4 py-2 text-xs font-medium text-gray-700 border border-gray-300 rounded-lg hover:bg-gray-50">Batal</button>
        <button type="button" onclick="kpgConfirmDelete()" class="px-4 py-2 text-xs font-semibold text-white bg-rose-600 hover:bg-rose-700 rounded-lg">Hapus</button>
      </div>
    </div>
  </div>

  <script is:inline>
    /**
     * Pengumuman Kontributor — data mock di memori (reset saat halaman dimuat ulang).
     * Prefix `kpg` = kontributor pengumuman, agar tidak bentrok dengan fungsi shell.
     */
    var KPG_PER_PAGE = 5;
    var KPG_SASARAN = {
      semua_peserta: 'Semua (Peserta & Pelamar)',
      diterima: 'Peserta Diterima',
      dpl: 'DPL'
    };
    var KPG_SASARAN_HINT = {
      semua_peserta: 'Diterima oleh peserta aktif dan mahasiswa yang mendaftar tetapi belum diterima.',
      diterima: 'Hanya mahasiswa yang sudah resmi diterima di program ini.',
      dpl: 'Hanya Dosen Pembimbing Lapangan yang ditempatkan di program ini.'
    };

    var kpgData = [
      { id: 1, judul: 'Jadwal Wawancara Seleksi Batch 1', isi: '<p>Wawancara seleksi dilaksanakan pada <b>22–23 Oktober 2026</b> secara daring. Pelamar yang lolos tahap administrasi akan dihubungi melalui email.</p><ul><li>Siapkan portofolio</li><li>Hadir 10 menit lebih awal</li></ul>', sasaran: 'semua_peserta', status: 'published', tgl: '2026-10-18T09:00', lampiran: 'https://drive.google.com/file/d/jadwal-wawancara' },
      { id: 2, judul: 'Pembekalan Peserta Diterima', isi: '<p>Pembekalan peserta diterima diadakan Senin, 26 Oktober 2026 pukul 09.00 WIB. Tautan grup koordinasi akan dibagikan pada sesi ini.</p>', sasaran: 'diterima', status: 'published', tgl: '2026-10-16T14:30', lampiran: '' },
      { id: 3, judul: 'Format Laporan Bimbingan Mingguan untuk DPL', isi: '<p>Mohon DPL menggunakan format laporan terbaru pada lampiran dan mengumpulkannya setiap hari Jumat.</p>', sasaran: 'dpl', status: 'published', tgl: '2026-10-14T10:15', lampiran: 'https://docs.google.com/document/d/format-laporan-dpl' },
      { id: 4, judul: 'Perpanjangan Batas Pendaftaran Gelombang 1', isi: '<p>Batas pendaftaran diperpanjang hingga <i>25 Oktober 2026</i>.</p>', sasaran: 'semua_peserta', status: 'draft', tgl: '', lampiran: '' }
    ];
    var kpgState = { q: '', sasaran: 'semua', status: 'published', page: 1, deleteId: null };

    function kpgEsc(s) {
      return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
      });
    }

    // Sanitizer sederhana: hanya tag format dasar, href wajib http(s)
    function kpgSanitize(html) {
      var allowed = { P: 1, BR: 1, B: 1, STRONG: 1, I: 1, EM: 1, U: 1, UL: 1, OL: 1, LI: 1, A: 1, DIV: 1 };
      var doc = new DOMParser().parseFromString('<div>' + html + '</div>', 'text/html');
      (function walk(node) {
        Array.prototype.slice.call(node.childNodes).forEach(function (child) {
          if (child.nodeType === 8) { node.removeChild(child); return; }
          if (child.nodeType !== 1) return;
          if (!allowed[child.tagName]) {
            node.replaceChild(doc.createTextNode(child.textContent), child);
            return;
          }
          Array.prototype.slice.call(child.attributes).forEach(function (attr) {
            var keep = child.tagName === 'A' && attr.name === 'href' && /^https?:\/\//i.test(attr.value);
            if (!keep) child.removeAttribute(attr.name);
          });
          if (child.tagName === 'A') {
            child.setAttribute('target', '_blank');
            child.setAttribute('rel', 'noopener noreferrer');
          }
          walk(child);
        });
      })(doc.body.firstChild);
      return doc.body.firstChild.innerHTML;
    }

    function kpgPlain(html) {
      var d = document.createElement('div');
      d.innerHTML = kpgSanitize(html);
      return (d.textContent || '').replace(/\s+/g, ' ').trim();
    }

    function kpgFmtDate(iso) {
      if (!iso) return '—';
      var d = new Date(iso);
      if (isNaN(d)) return '—';
      return d.toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) + ' · ' +
        d.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }).replace('.', ':') + ' WIB';
    }

    function kpgIcons() {
      if (typeof lucide !== 'undefined') lucide.createIcons();
    }

    function kpgSetFilter(key, val) {
      kpgState[key] = key === 'q' ? String(val || '').toLowerCase().trim() : val;
      kpgState.page = 1;
      kpgRender();
    }

    function kpgFiltered() {
      return kpgData
        .filter(function (p) {
          var okQ = !kpgState.q || p.judul.toLowerCase().indexOf(kpgState.q) > -1 || kpgPlain(p.isi).toLowerCase().indexOf(kpgState.q) > -1;
          var okS = kpgState.sasaran === 'semua' || p.sasaran === kpgState.sasaran;
          var okT = kpgState.status === 'semua' || p.status === kpgState.status;
          return okQ && okS && okT;
        })
        .sort(function (a, b) {
          // draf (tanpa tanggal) di atas, lalu terbaru dulu
          return (b.tgl || '9999').localeCompare(a.tgl || '9999');
        });
    }

    function kpgRender() {
      var tbody = document.getElementById('kpg-tbody');
      if (!tbody) return;
      kpgRenderTabs();
      var list = kpgFiltered();
      var total = list.length;
      var pages = Math.ceil(total / KPG_PER_PAGE) || 1;
      if (kpgState.page > pages) kpgState.page = pages;
      var start = (kpgState.page - 1) * KPG_PER_PAGE;
      var end = Math.min(start + KPG_PER_PAGE, total);

      if (!total) {
        tbody.innerHTML = '<tr><td colspan="6" class="py-12 px-4 text-center">' +
          '<div class="flex flex-col items-center gap-1">' +
          '<i data-lucide="megaphone" class="w-6 h-6 text-[#a1a1aa]"></i>' +
          '<p class="text-sm font-semibold text-[#09090b]">' + (kpgData.length ? 'Tidak ada pengumuman yang cocok' : 'Belum ada pengumuman') + '</p>' +
          '<p class="text-xs text-[#71717a]">' + (kpgData.length ? 'Ubah kata kunci atau filter pencarian.' : 'Klik "Tambah Pengumuman" untuk membuat siaran pertama.') + '</p>' +
          '</div></td></tr>';
      } else {
        tbody.innerHTML = list.slice(start, end).map(function (p) {
          var published = p.status === 'published';
          var badge = published
            ? '<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[11px] font-medium bg-emerald-50 text-emerald-700 border border-emerald-200"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Dipublikasikan</span>'
            : '<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[11px] font-medium bg-gray-100 text-gray-700 border border-gray-200"><span class="w-1.5 h-1.5 rounded-full bg-gray-400"></span> Draf</span>';
          var lampiran = p.lampiran
            ? '<a href="' + kpgEsc(p.lampiran) + '" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-[#1063B9] hover:underline"><i data-lucide="paperclip" class="w-3.5 h-3.5"></i>Drive</a>'
            : '<span class="text-[#a1a1aa]">—</span>';
          return '<tr class="hover:bg-gray-50/70 transition-colors">' +
            '<td class="py-3 px-4 max-w-[340px]">' +
              '<button type="button" onclick="kpgOpenDetail(' + p.id + ')" class="text-left font-medium text-[13px] text-[#09090b] hover:text-[#0655a7] block max-w-full truncate">' + kpgEsc(p.judul) + '</button>' +
              '<div class="text-[12px] text-[#71717a] truncate">' + kpgEsc(kpgPlain(p.isi)) + '</div>' +
            '</td>' +
            '<td class="py-3 px-4 whitespace-nowrap">' + kpgEsc(KPG_SASARAN[p.sasaran]) + '</td>' +
            '<td class="py-3 px-4">' + lampiran + '</td>' +
            '<td class="py-3 px-4 whitespace-nowrap text-[#71717a]">' + kpgFmtDate(p.tgl) + '</td>' +
            '<td class="py-3 px-4">' + badge + '</td>' +
            '<td class="py-3 px-4 text-right whitespace-nowrap">' +
              '<button type="button" onclick="kpgOpenModal(' + p.id + ')" title="Edit" aria-label="Edit pengumuman" class="p-1.5 rounded hover:bg-blue-50 text-[#1063B9]"><i data-lucide="pencil" class="w-3.5 h-3.5"></i></button>' +
              '<button type="button" onclick="kpgOpenDelete(' + p.id + ')" title="Hapus" aria-label="Hapus pengumuman" class="p-1.5 rounded hover:bg-rose-50 text-rose-600"><i data-lucide="trash-2" class="w-3.5 h-3.5"></i></button>' +
            '</td></tr>';
        }).join('');
      }

      document.getElementById('kpg-info').textContent = total
        ? 'Menampilkan ' + (start + 1) + '–' + end + ' dari ' + total + ' pengumuman'
        : '0 pengumuman';

      var pag = document.getElementById('kpg-pagination');
      var btn = 'h-8 min-w-8 px-2 rounded-md border text-xs ';
      var html = '<button type="button" onclick="kpgGoto(' + (kpgState.page - 1) + ')" ' + (kpgState.page === 1 ? 'disabled' : '') + ' class="' + btn + 'border-[#e4e4e7] bg-white disabled:opacity-40">Sebelumnya</button>';
      for (var i = 1; i <= pages; i++) {
        html += '<button type="button" onclick="kpgGoto(' + i + ')" class="' + btn + (i === kpgState.page ? 'border-[#0655a7] bg-[#0655a7] text-white' : 'border-[#e4e4e7] bg-white') + '">' + i + '</button>';
      }
      html += '<button type="button" onclick="kpgGoto(' + (kpgState.page + 1) + ')" ' + (kpgState.page === pages ? 'disabled' : '') + ' class="' + btn + 'border-[#e4e4e7] bg-white disabled:opacity-40">Berikutnya</button>';
      pag.innerHTML = html;
      kpgIcons();
    }

    function kpgRenderTabs() {
      var counts = {
        published: kpgData.filter(function (p) { return p.status === 'published'; }).length,
        draft: kpgData.filter(function (p) { return p.status === 'draft'; }).length
      };
      var labels = { published: 'Dipublikasikan', draft: 'Draf' };
      document.querySelectorAll('#kpg-tabs .kpg-tab').forEach(function (b) {
        var key = b.getAttribute('data-status');
        var active = kpgState.status === key;
        b.setAttribute('aria-selected', active ? 'true' : 'false');
        b.className = 'kpg-tab -mb-px px-3.5 py-2 text-xs border-b-2 transition-colors ' +
          (active ? 'border-[#0655a7] text-[#0655a7] font-semibold' : 'border-transparent text-[#71717a] hover:text-[#09090b]');
        b.innerHTML = labels[key] + ' <span class="ml-1 px-1.5 py-0.5 rounded-full text-[10px] ' +
          (active ? 'bg-[#0655a7]/10 text-[#0655a7]' : 'bg-gray-100 text-[#71717a]') + '">' + counts[key] + '</span>';
      });
    }

    function kpgGoto(p) {
      var pages = Math.ceil(kpgFiltered().length / KPG_PER_PAGE) || 1;
      if (p < 1 || p > pages) return;
      kpgState.page = p;
      kpgRender();
    }

    // ---- Editor ----
    function kpgFormat(cmd) {
      document.getElementById('kpg-isi').focus();
      document.execCommand(cmd, false, null);
    }

    function kpgInsertLink() {
      var url = window.prompt('Masukkan tautan (https://...)');
      if (!url) return;
      if (!/^https?:\/\//i.test(url)) {
        showToast('Tautan Tidak Valid', 'Tautan harus diawali http:// atau https://');
        return;
      }
      document.getElementById('kpg-isi').focus();
      document.execCommand('createLink', false, url);
    }

    // ---- Modal tambah / edit ----
    function kpgShowErr(id, show) {
      var el = document.getElementById(id);
      if (el) el.classList.toggle('hidden', !show);
    }

    function kpgUpdateHint() {
      var v = document.getElementById('kpg-sasaran').value;
      document.getElementById('kpg-sasaran-hint').textContent = KPG_SASARAN_HINT[v] || '';
    }

    function kpgOpenModal(id) {
      var item = id ? kpgData.filter(function (p) { return p.id === id; })[0] : null;
      document.getElementById('kpg-modal-title').textContent = item ? 'Edit Pengumuman' : 'Tambah Pengumuman';
      document.getElementById('kpg-id').value = item ? item.id : '';
      document.getElementById('kpg-judul').value = item ? item.judul : '';
      document.getElementById('kpg-isi').innerHTML = item ? kpgSanitize(item.isi) : '';
      document.getElementById('kpg-sasaran').value = item ? item.sasaran : 'semua_peserta';
      document.getElementById('kpg-status').value = item ? item.status : 'published';
      document.getElementById('kpg-lampiran').value = item ? item.lampiran : '';
      ['kpg-err-judul', 'kpg-err-isi', 'kpg-err-lampiran'].forEach(function (e) { kpgShowErr(e, false); });
      kpgUpdateHint();
      document.getElementById('kpg-modal').classList.remove('hidden');
      document.getElementById('kpg-judul').focus();
      kpgIcons();
    }

    function kpgCloseModal() {
      document.getElementById('kpg-modal').classList.add('hidden');
    }

    function kpgSave() {
      var judul = document.getElementById('kpg-judul').value.trim();
      var isi = kpgSanitize(document.getElementById('kpg-isi').innerHTML).trim();
      var lampiran = document.getElementById('kpg-lampiran').value.trim();
      var okJudul = !!judul;
      var okIsi = !!kpgPlain(isi);
      var okLampiran = !lampiran || /^https:\/\/(drive|docs)\.google\.com\//i.test(lampiran);
      kpgShowErr('kpg-err-judul', !okJudul);
      kpgShowErr('kpg-err-isi', !okIsi);
      kpgShowErr('kpg-err-lampiran', !okLampiran);
      if (!okJudul || !okIsi || !okLampiran) return;

      var idVal = document.getElementById('kpg-id').value;
      var status = document.getElementById('kpg-status').value;
      var sasaran = document.getElementById('kpg-sasaran').value;
      var now = new Date();
      now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
      var nowIso = now.toISOString().slice(0, 16);

      if (idVal) {
        var item = kpgData.filter(function (p) { return p.id === Number(idVal); })[0];
        if (!item) return;
        // tanggal publikasi tetap bila sudah pernah terbit; terisi saat pertama kali dipublikasikan
        var tgl = status === 'published' ? (item.tgl || nowIso) : item.tgl;
        Object.assign(item, { judul: judul, isi: isi, sasaran: sasaran, status: status, lampiran: lampiran, tgl: tgl });
        showToast('Pengumuman Diperbarui', '"' + judul + '" berhasil disimpan.');
      } else {
        var nextId = kpgData.reduce(function (m, p) { return Math.max(m, p.id); }, 0) + 1;
        kpgData.push({ id: nextId, judul: judul, isi: isi, sasaran: sasaran, status: status, lampiran: lampiran, tgl: status === 'published' ? nowIso : '' });
        showToast(status === 'published' ? 'Pengumuman Dipublikasikan' : 'Draf Tersimpan', '"' + judul + '" ' + (status === 'published' ? 'dikirim ke ' + KPG_SASARAN[sasaran] + '.' : 'disimpan sebagai draf.'));
      }
      kpgCloseModal();
      kpgState.page = 1;
      kpgRender();
    }

    // ---- Detail ----
    function kpgOpenDetail(id) {
      var p = kpgData.filter(function (x) { return x.id === id; })[0];
      if (!p) return;
      document.getElementById('kpg-detail-judul').textContent = p.judul;
      document.getElementById('kpg-detail-meta').textContent = KPG_SASARAN[p.sasaran] + ' · ' + (p.status === 'published' ? kpgFmtDate(p.tgl) : 'Draf');
      document.getElementById('kpg-detail-isi').innerHTML = kpgSanitize(p.isi);
      document.getElementById('kpg-detail-lampiran').innerHTML = p.lampiran
        ? '<a href="' + kpgEsc(p.lampiran) + '" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-3 py-2 border border-gray-300 rounded-lg text-xs text-[#1063B9] hover:bg-gray-50"><i data-lucide="paperclip" class="w-3.5 h-3.5"></i>Buka lampiran di Google Drive</a>'
        : '';
      document.getElementById('kpg-detail').classList.remove('hidden');
      kpgIcons();
    }

    function kpgCloseDetail() {
      document.getElementById('kpg-detail').classList.add('hidden');
    }

    // ---- Hapus ----
    function kpgOpenDelete(id) {
      var p = kpgData.filter(function (x) { return x.id === id; })[0];
      if (!p) return;
      kpgState.deleteId = id;
      document.getElementById('kpg-delete-judul').textContent = p.judul;
      document.getElementById('kpg-delete').classList.remove('hidden');
    }

    function kpgCloseDelete() {
      kpgState.deleteId = null;
      document.getElementById('kpg-delete').classList.add('hidden');
    }

    function kpgConfirmDelete() {
      var p = kpgData.filter(function (x) { return x.id === kpgState.deleteId; })[0];
      kpgData = kpgData.filter(function (x) { return x.id !== kpgState.deleteId; });
      kpgCloseDelete();
      kpgRender();
      if (p) showToast('Pengumuman Dihapus', '"' + p.judul + '" telah dihapus.');
    }

    function kpgInit() {
      if (!document.getElementById('kpg-tbody')) return;
      var sel = document.getElementById('kpg-sasaran');
      if (sel) sel.onchange = kpgUpdateHint;
      // tautan dari dashboard: #draf-<id> membuka tab Draf dan form edit pengumuman itu
      var m = /^#draf-(\d+)$/.exec(location.hash || '');
      if (m && kpgData.some(function (p) { return p.id === Number(m[1]); })) {
        kpgState.status = 'draft';
        kpgRender();
        kpgOpenModal(Number(m[1]));
        return;
      }
      kpgRender();
    }
    document.removeEventListener('astro:page-load', window.__kpgInit);
    window.__kpgInit = kpgInit;
    document.addEventListener('astro:page-load', kpgInit);
    document.removeEventListener('keydown', window.__kpgEsc);
    window.__kpgEsc = function (e) {
      if (e.key !== 'Escape' || !document.getElementById('kpg-modal')) return;
      kpgCloseModal(); kpgCloseDetail(); kpgCloseDelete();
    };
    document.addEventListener('keydown', window.__kpgEsc);
  </script>
</KontributorShell>
