---
// src/pages/detail-mbkm.astro
import DetailHero from '../components/mbkm/detail/DetailHero.astro';
import DetailAbout from '../components/mbkm/detail/DetailAbout.astro';
import DetailTabs from '../components/mbkm/detail/DetailTabs.astro';
import DetailTimeline from '../components/mbkm/detail/DetailTimeline.astro';
import DetailShowcase from '../components/mbkm/detail/DetailShowcase.astro';
import DetailFaq from '../components/mbkm/detail/DetailFaq.astro';
import DetailFooter from '../components/mbkm/detail/DetailFooter.astro';
import DetailFloatingDaftar from '../components/mbkm/detail/DetailFloatingDaftar.astro';
---

<!doctype html>
<html lang="id" class="h-full scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Detail Program MBKM — FIK UDINUS</title>
    <meta
      name="description"
      content="Informasi program MBKM, persyaratan, showcase karya, dan pendaftaran mahasiswa FIK UDINUS."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <script is:inline>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: { sans: ["Inter", "system-ui", "-apple-system", "sans-serif"] },
            colors: {
              primary: { 50: "#F1F7FE", 100: "#E2EEFC", 200: "#BFDBF8", 300: "#86BEF3", 400: "#1E7FD9", 500: "#1E7FD9", 600: "#1063B9", 700: "#114D91", 800: "#10447C", 900: "#133A67", 950: "#0D2544" },
              secondary: { 50: "#FEFAEC", 100: "#FCEEC9", 200: "#F8DB8F", 300: "#F4BD45", 400: "#F2AB2D", 500: "#F3BC45", 600: "#D0670F" }
            }
          }
        }
      };
    </script>
    <script is:inline src="https://unpkg.com/lucide@latest"></script>
  </head>
  <body class="min-h-screen flex flex-col bg-[#FAFAFA] text-gray-900 antialiased">
    <DetailHero />
    <main class="flex-1">
      <DetailAbout />
      <DetailTabs />
      <DetailTimeline />
      <DetailShowcase />
      <DetailFaq />
    </main>
    <DetailFooter />
    <DetailFloatingDaftar />

    <script is:inline>
      const renderIcons = () => { if (typeof lucide !== "undefined") lucide.createIcons(); };
      renderIcons();
      document.addEventListener("DOMContentLoaded", renderIcons);
    </script>
  </body>
</html>
