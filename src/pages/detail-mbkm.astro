          rgba(0, 0, 0, 0) 100%
        );
        -webkit-mask-image: linear-gradient(
          to bottom,
          rgba(0, 0, 0, 1) 40%,
          rgba(0, 0, 0, 0.4) 75%,
          rgba(0, 0, 0, 0) 100%
