---
// src/pages/admin/hasil-sidang.astro
import AdminShell from '../../layouts/AdminShell.astro';
---

<AdminShell
  currentTab="hasil-sidang"
  pageTitle="Hasil Sidang Kampus Berdampak"
  subtitle="Berikut data sidang yang sudah diploting jadwalnya."
>
  <section
    id="section-hasil-sidang"
    class="flex flex-col flex-1 min-h-0 pr-1 space-y-4 overflow-y-auto font-sans tab-content"
    x-data="{
      searchQuery: '',
      currentPage: 1,
      pageSize: 10,
      isDownloadOpen: false,
      isPreviewTtdOpen: false,
      isTambahTtdOpen: false,
      isEditNilaiOpen: false,
      editNilaiTarget: null,
      editNilaiForm: { nilai_kontributor: '', nilai_penguji_1: '', nilai_penguji_2: '' },
      isDownloadingPDF: false,
      ttdSignatureUrl: '/assets/images/ttd-koordinator.png',
      toastMessage: '',
      showToast: false,

      hasilSidangList: [
        {
          sidang_id: 1,
          mahasiswa: { nama: 'Faisal Rahman', nim: 'A11.2022.13901' },
          pembimbing: { nama: 'Dr. M. Arief Soeleman, M.Kom' },
          penguji_1: { nama: 'Dr. M. Arief Soeleman, M.Kom' },
          penguji_2: { nama: 'Ajib Susanto, M.Kom' },
          jadwal_sidang: { tanggal: '2026-07-13', jam: '09:00 - 10:00' },
          nilai_kontributor: 92,
          nilai_penguji_1: 88,
          nilai_penguji_2: 90,
          nilai_akhir: 90.72,
          sidang_status: 'selesai'
        },
        {
          sidang_id: 2,
          mahasiswa: { nama: 'Tarissa Aura Azzahra', nim: 'A11.2020.13158' },
          pembimbing: { nama: 'Affandy, Ph.D' },
          penguji_1: { nama: 'Affandy, Ph.D' },
          penguji_2: { nama: 'Christy Atika Sari, M.Kom' },
          jadwal_sidang: { tanggal: '2026-07-13', jam: '10:00 - 11:00' },
          nilai_kontributor: 95,
          nilai_penguji_1: 90,
          nilai_penguji_2: 94,
          nilai_akhir: 93.64,
          sidang_status: 'selesai'
        },
        {
          sidang_id: 3,
          mahasiswa: { nama: 'Nabila Zahra Putri', nim: 'A12.2022.09842' },
          pembimbing: { nama: 'Christy Atika Sari, M.Kom' },
          penguji_1: { nama: 'Christy Atika Sari, M.Kom' },
          penguji_2: { nama: 'Affandy, Ph.D' },
          jadwal_sidang: { tanggal: '2026-07-15', jam: '09:00 - 10:00' },
          nilai_kontributor: 90,
          nilai_penguji_1: 85,
          nilai_penguji_2: 88,
          nilai_akhir: 88.48,
          sidang_status: 'selesai'
        },
        {
          sidang_id: 4,
          mahasiswa: { nama: 'Rizky Aditya Pratama', nim: 'A11.2022.14012' },
          pembimbing: { nama: 'Eko Hari Rachmawanto, M.Kom' },
          penguji_1: { nama: 'Eko Hari Rachmawanto, M.Kom' },
          penguji_2: { nama: 'Dr. Muljono, S.Si, M.Kom' },
          jadwal_sidang: { tanggal: '2026-07-21', jam: '13:00 - 14:00' },
          nilai_kontributor: 88,
          nilai_penguji_1: null,
          nilai_penguji_2: null,
          nilai_akhir: null,
          sidang_status: null
        }
      ],

      isComplete(item) {
        return (
          item.nilai_kontributor != null &&
          item.nilai_penguji_1 != null &&
          item.nilai_penguji_2 != null
        );
      },

      recalcNilai(item) {
        const nk = item.nilai_kontributor != null ? Number(item.nilai_kontributor) : null;
        const p1 = item.nilai_penguji_1 != null ? Number(item.nilai_penguji_1) : null;
        const p2 = item.nilai_penguji_2 != null ? Number(item.nilai_penguji_2) : null;

        if (nk !== null && p1 !== null && p2 !== null) {
          item.nilai_akhir = Number(((nk * 0.60) + (p1 * 0.24) + (p2 * 0.16)).toFixed(2));
          item.sidang_status = 'selesai';
        } else {
          item.nilai_akhir = null;
          item.sidang_status = null;
        }
      },

      openEditNilaiModal(row, focusField) {
        this.editNilaiTarget = row;
        this.editNilaiForm = {
          nilai_kontributor: row.nilai_kontributor !== null ? String(row.nilai_kontributor) : '',
          nilai_penguji_1: row.nilai_penguji_1 !== null ? String(row.nilai_penguji_1) : '',
          nilai_penguji_2: row.nilai_penguji_2 !== null ? String(row.nilai_penguji_2) : ''
        };
        this.isEditNilaiOpen = true;
        this.$nextTick(() => {
          if (typeof lucide !== 'undefined') lucide.createIcons();
          const el = document.getElementById('input-edit-' + focusField);
          if (el) el.focus();
        });
      },

      simpanEditNilai() {
        if (!this.editNilaiTarget) return;
        const parseScore = (raw) => {
          const s = String(raw ?? '').trim();
          if (s === '') return null;
          const n = Number(s);
          if (isNaN(n)) return null;
          return Math.min(100, Math.max(0, n));
        };
        this.editNilaiTarget.nilai_kontributor = parseScore(this.editNilaiForm.nilai_kontributor);
        this.editNilaiTarget.nilai_penguji_1 = parseScore(this.editNilaiForm.nilai_penguji_1);
        this.editNilaiTarget.nilai_penguji_2 = parseScore(this.editNilaiForm.nilai_penguji_2);
        this.recalcNilai(this.editNilaiTarget);
        this.isEditNilaiOpen = false;
        this.editNilaiTarget = null;
        this.triggerToast('Nilai sidang berhasil disimpan');
      },

      get filteredList() {
        return this.hasilSidangList.filter(item => {
          const q = this.searchQuery.trim().toLowerCase();
          const matchSearch = q === '' ||
            item.mahasiswa.nama.toLowerCase().includes(q) ||
            item.mahasiswa.nim.includes(q) ||
            (item.pembimbing?.nama && item.pembimbing.nama.toLowerCase().includes(q));
          return matchSearch;
        });
      },

      get paginatedList() {
        const start = (this.currentPage - 1) * this.pageSize;
        return this.filteredList.slice(start, start + this.pageSize);
      },

      get totalPages() {
        return Math.max(1, Math.ceil(this.filteredList.length / this.pageSize));
      },

      handleDownloadExcel() {
        this.isDownloadOpen = false;
        this.triggerToast('File Excel monitoring-sidang-kampus-berdampak.xlsx berhasil diunduh');
      },

      handleDownloadAllPDF() {
        this.isDownloadingPDF = true;
        setTimeout(() => {
          this.isDownloadingPDF = false;
          this.isDownloadOpen = false;
          this.triggerToast('File ZIP berita-acara-sidang-all.zip berhasil didownload');
        }, 1000);
      },

      handleUploadTtd(e) {
        const file = e.target.files?.[0];
        if (file) {
          this.ttdSignatureUrl = URL.createObjectURL(file);
          this.isTambahTtdOpen = false;
          this.triggerToast('Tanda tangan berhasil diunggah');
        }
      },

      triggerToast(msg, type = 'success') {
        if (typeof window.showAdminToast === 'function') {
          window.showAdminToast(msg, type);
        }
      },

      reinitLucide() {
        this.$nextTick(() => {
          if (typeof lucide !== 'undefined') lucide.createIcons();
        });
      }
    }"
  >
    <!-- Toolbar: Sesuai MonitoringSidangToolbar di fakultas-fe -->
    <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
      <!-- Search Input (w-full sm:w-1/4) -->
      <div class="w-full sm:w-1/4 min-w-[200px]">
        <div class="relative w-full">
          <i data-lucide="search" class="absolute left-3 top-1/2 transform -translate-y-1/2 w-4 h-4 text-[#71717a]"></i>
          <input
            type="text"
            x-model="searchQuery"
            @input="currentPage = 1; reinitLucide()"
            placeholder="Cari mahasiswa..."
            class="w-full h-10 pl-9 pr-9 rounded-md border border-[#e4e4e7] bg-white text-sm text-[#09090b] placeholder:text-[#71717a] focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
          />
          <button
            type="button"
            x-show="searchQuery.length > 0"
            @click="searchQuery = ''; currentPage = 1; reinitLucide()"
            class="absolute right-3 top-1/2 transform -translate-y-1/2 text-[#71717a] hover:text-[#09090b] cursor-pointer"
          >
            <i data-lucide="x" class="w-4 h-4"></i>
          </button>
        </div>
      </div>

      <!-- Action Group Kanan (Download Dropdown, Preview TTD, Tambah TTD) -->
      <div class="flex flex-wrap items-center gap-2 ml-auto">
        <!-- Dropdown Download Button (Excel / PDF) -->
        <div class="relative" @click.outside="isDownloadOpen = false">
          <button
            type="button"
            @click="isDownloadOpen = !isDownloadOpen; reinitLucide()"
            class="h-9 px-3.5 inline-flex items-center gap-2 rounded-md bg-[#0655a7] hover:bg-[#114D91] text-white text-sm font-medium shadow-none transition-colors cursor-pointer"
          >
            <i data-lucide="download" class="w-4 h-4"></i>
            <span x-text="isDownloadingPDF ? 'Downloading...' : 'Download'"></span>
            <template x-if="isDownloadOpen">
              <i data-lucide="chevron-down" class="w-4 h-4"></i>
            </template>
            <template x-if="!isDownloadOpen">
              <i data-lucide="chevron-right" class="w-4 h-4"></i>
            </template>
          </button>

          <!-- Dropdown Menu -->
          <div
            x-show="isDownloadOpen"
            x-cloak
            class="absolute right-0 mt-1.5 w-56 rounded-md bg-white border border-[#e4e4e7] shadow-lg py-1 z-30 text-sm animate-in fade-in zoom-in-95 duration-100"
          >
            <button
              type="button"
              @click="handleDownloadExcel()"
              class="w-full flex items-center gap-2 px-3 py-2 text-left hover:bg-[#f4f4f5] text-[#09090b] transition-colors cursor-pointer"
            >
              <i data-lucide="file-spreadsheet" class="h-4 w-4 mr-1 text-[#71717a]"></i>
              <span>Export Excel</span>
            </button>
            <button
              type="button"
              @click="handleDownloadAllPDF()"
              :disabled="isDownloadingPDF"
              class="w-full flex items-center gap-2 px-3 py-2 text-left hover:bg-[#f4f4f5] text-[#09090b] transition-colors border-t border-[#e4e4e7]/60 cursor-pointer"
            >
              <i data-lucide="file-text" class="h-4 w-4 mr-1 text-[#71717a]"></i>
              <span x-text="isDownloadingPDF ? 'Downloading...' : 'Download All PDF'"></span>
            </button>
          </div>
        </div>

        <!-- Tombol Preview TTD Koor -->
        <button
          type="button"
          @click="isPreviewTtdOpen = true; reinitLucide()"
          class="h-9 px-3.5 inline-flex items-center gap-2 rounded-md bg-[#0655a7] hover:bg-[#114D91] text-white text-sm font-medium shadow-none transition-colors cursor-pointer"
        >
          <i data-lucide="eye" class="w-4 h-4"></i>
          <span>Preview TTD Koor</span>
        </button>

        <!-- Tombol Tambah TTD Koor -->
        <button
          type="button"
          @click="isTambahTtdOpen = true; reinitLucide()"
          class="h-9 px-3.5 inline-flex items-center gap-2 rounded-md bg-[#0655a7] hover:bg-[#114D91] text-white text-sm font-medium shadow-none transition-colors cursor-pointer"
        >
          <i data-lucide="plus" class="w-4 h-4"></i>
          <span>Tambah TTD Koor</span>
        </button>
      </div>
    </div>

    <!-- Empty State jika tidak ada data -->
    <template x-if="filteredList.length === 0">
      <div class="flex flex-col items-center justify-center py-12 text-center h-[calc(100vh-320px)] bg-white rounded-md border border-[#e4e4e7]">
        <div class="rounded-full bg-[#f4f4f5] p-3 mb-4">
          <i data-lucide="calendar-check" class="h-6 w-6 text-[#71717a]"></i>
        </div>
        <h3 class="text-lg font-medium text-[#09090b]">Belum Ada Hasil Sidang</h3>
        <p class="text-sm text-[#71717a] mt-1 max-w-md">
          Data sidang akan muncul setelah jadwal dipasang di menu Plotting Jadwal.
        </p>
      </div>
    </template>

    <!-- Table View: DataTable Sesuai Columns di fakultas-fe -->
    <div class="rounded-lg border border-[#e4e4e7] overflow-hidden bg-white" x-show="filteredList.length > 0">
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="bg-[#fafafa] border-b border-[#e4e4e7]">
            <tr>
              <th class="h-11 px-4 font-semibold text-xs w-12 text-center text-[#71717a]">No.</th>
              <th class="h-11 px-4 font-semibold text-xs text-left text-[#71717a] min-w-[200px] max-w-[260px]">Mahasiswa</th>
              <th class="h-11 px-4 font-semibold text-xs text-left text-[#71717a] min-w-[180px] max-w-[240px]">Dosen Pembimbing</th>
              <th class="h-11 px-4 font-semibold text-xs text-center text-[#71717a] min-w-[130px]">Nilai Penyelia (60%)</th>
              <th class="h-11 px-4 font-semibold text-xs text-center text-[#71717a] min-w-[140px]">Nilai Penguji 1 (24%)</th>
              <th class="h-11 px-4 font-semibold text-xs text-center text-[#71717a] min-w-[130px]">Nilai Penguji 2 (16%)</th>
              <th class="h-11 px-4 font-semibold text-xs text-center text-[#71717a] min-w-[100px]">Nilai Akhir</th>
              <th class="h-11 px-4 font-semibold text-xs text-center text-[#71717a] min-w-[120px]">Status</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#e4e4e7]">
            <template x-for="(row, index) in paginatedList" :key="row.sidang_id">
              <tr class="hover:bg-[#f4f4f5]/60 transition-colors">
                <!-- No -->
                <td class="h-[68px] px-2 text-center text-xs font-medium text-[#71717a] w-12" x-text="((currentPage - 1) * pageSize) + (index + 1)"></td>

                <!-- Mahasiswa -->
                <td class="h-[68px] px-4 min-w-[200px] max-w-[260px]">
                  <div class="font-semibold truncate text-sm text-[#09090b]" x-text="row.mahasiswa?.nama ?? '—'"></div>
                  <div class="text-xs text-[#71717a]" x-text="row.mahasiswa?.nim ?? '—'"></div>
                </td>

                <!-- Pembimbing -->
                <td class="h-[68px] px-4 min-w-[180px] max-w-[240px] text-sm text-[#09090b]">
                  <div class="truncate font-medium text-sm text-[#09090b]" x-text="row.pembimbing?.nama ?? '—'"></div>
                </td>

                <!-- Nilai Kontributor 60% -->
                <td class="h-[68px] px-4 text-center min-w-[130px]">
                  <div class="flex justify-center">
                    <button
                      type="button"
                      @click="openEditNilaiModal(row, 'nilai_kontributor')"
                      class="h-8 min-w-[4rem] w-20 px-2 text-center tabular-nums rounded-md border border-[#e4e4e7] bg-white hover:border-[#0655a7] hover:bg-blue-50/30 text-sm font-medium transition-colors cursor-pointer"
                      :class="row.nilai_kontributor !== null ? 'text-[#09090b]' : 'text-[#71717a]'"
                      x-text="row.nilai_kontributor !== null ? row.nilai_kontributor : '-'"
                    ></button>
                  </div>
                </td>

                <!-- Nilai Penguji 1 / Pembimbing 24% -->
                <td class="h-[68px] px-4 text-center min-w-[140px]">
                  <div class="flex justify-center">
                    <button
                      type="button"
                      @click="openEditNilaiModal(row, 'nilai_penguji_1')"
                      class="h-8 min-w-[4rem] w-20 px-2 text-center tabular-nums rounded-md border border-[#e4e4e7] bg-white hover:border-[#0655a7] hover:bg-blue-50/30 text-sm font-medium transition-colors cursor-pointer"
                      :class="row.nilai_penguji_1 !== null ? 'text-[#09090b]' : 'text-[#71717a]'"
                      x-text="row.nilai_penguji_1 !== null ? row.nilai_penguji_1 : '-'"
                    ></button>
                  </div>
                </td>

                <!-- Nilai Penguji 2 16% -->
                <td class="h-[68px] px-4 text-center min-w-[130px]">
                  <div class="flex justify-center">
                    <button
                      type="button"
                      @click="openEditNilaiModal(row, 'nilai_penguji_2')"
                      class="h-8 min-w-[4rem] w-20 px-2 text-center tabular-nums rounded-md border border-[#e4e4e7] bg-white hover:border-[#0655a7] hover:bg-blue-50/30 text-sm font-medium transition-colors cursor-pointer"
                      :class="row.nilai_penguji_2 !== null ? 'text-[#09090b]' : 'text-[#71717a]'"
                      x-text="row.nilai_penguji_2 !== null ? row.nilai_penguji_2 : '-'"
                    ></button>
                  </div>
                </td>

                <!-- Nilai Akhir -->
                <td class="h-[68px] px-4 text-center min-w-[100px]">
                  <span class="font-semibold text-sm text-[#09090b]" x-text="row.nilai_akhir !== null ? Number(row.nilai_akhir).toFixed(2) : '-'"></span>
                </td>

                <!-- Status Badge (Selesai: success, Belum: secondary) -->
                <td class="h-[68px] px-4 text-center min-w-[120px]">
                  <div class="flex justify-center">
                    <template x-if="isComplete(row)">
                      <span class="inline-flex items-center rounded-md border border-emerald-200 bg-emerald-50 px-2.5 py-0.5 text-xs font-semibold text-emerald-800">
                        Selesai
                      </span>
                    </template>
                    <template x-if="!isComplete(row)">
                      <span class="inline-flex items-center rounded-md border border-[#e4e4e7] bg-[#f4f4f5] px-2.5 py-0.5 text-xs font-medium text-[#71717a]">
                        Belum
                      </span>
                    </template>
                  </div>
                </td>
              </tr>
            </template>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Standardized Pagination Sesuai Screenshot 1 & Design System -->
    <div class="flex flex-col items-center justify-between gap-2 pt-1 sm:flex-row" x-show="filteredList.length > 0">
      <div class="text-xs text-[#71717a]" x-text="'Menampilkan ' + (filteredList.length === 0 ? 0 : ((currentPage - 1) * pageSize + 1)) + ' - ' + Math.min(currentPage * pageSize, filteredList.length) + ' dari ' + filteredList.length + ' data'"></div>
      <div class="flex items-center gap-1.5">
        <button
          type="button"
          @click="if (currentPage > 1) { currentPage--; reinitLucide(); }"
          :disabled="currentPage <= 1"
          :class="currentPage <= 1 ? 'opacity-50 cursor-not-allowed hover:bg-white text-[#71717a]' : 'hover:bg-[#f4f4f5] text-[#09090b]'"
          class="h-8 w-8 flex items-center justify-center rounded-md border border-[#e4e4e7] bg-white text-xs transition-colors cursor-pointer"
          title="Halaman Sebelumnya"
        >
          <i data-lucide="chevron-left" class="w-4 h-4"></i>
        </button>

        <template x-for="p in totalPages" :key="p">
          <button
            type="button"
            @click="currentPage = p; reinitLucide()"
            :class="currentPage === p ? 'bg-[#0655a7] text-white font-semibold shadow-none' : 'border border-[#e4e4e7] bg-white text-[#09090b] font-medium hover:bg-[#f4f4f5]'"
            class="flex items-center justify-center w-8 h-8 text-xs transition-colors rounded-md cursor-pointer"
            x-text="p"
          ></button>
        </template>

        <button
          type="button"
          @click="if (currentPage < totalPages) { currentPage++; reinitLucide(); }"
          :disabled="currentPage >= totalPages"
          :class="currentPage >= totalPages ? 'opacity-50 cursor-not-allowed hover:bg-white text-[#71717a]' : 'hover:bg-[#f4f4f5] text-[#09090b]'"
          class="h-8 w-8 flex items-center justify-center rounded-md border border-[#e4e4e7] bg-white text-xs transition-colors cursor-pointer"
          title="Halaman Selanjutnya"
        >
          <i data-lucide="chevron-right" class="w-4 h-4"></i>
        </button>

        <select
          x-model.number="pageSize"
          @change="currentPage = 1; reinitLucide()"
          class="h-8 rounded-md border border-[#e4e4e7] bg-white px-2 text-xs text-[#09090b] focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
        >
          <option value="5">Show 5 items</option>
          <option value="10">Show 10 items</option>
          <option value="25">Show 25 items</option>
          <option value="50">Show 50 items</option>
        </select>
      </div>
    </div>

    <!-- ==================================================== -->
    <!-- MODAL 1: PREVIEW TTD KOORDINATOR (PreviewTtdKoor)    -->
    <!-- ==================================================== -->
    <div
      x-show="isPreviewTtdOpen"
      x-cloak
      class="fixed inset-0 z-50 flex items-center justify-center p-4 duration-150 bg-black/50 animate-in fade-in"
    >
      <div
        @click.outside="isPreviewTtdOpen = false"
        class="w-full max-w-md rounded-xl bg-white p-6 shadow-xl border border-[#e4e4e7] space-y-4"
      >
        <div class="flex items-center justify-between pb-2 border-b border-[#e4e4e7]">
          <h3 class="text-base font-semibold leading-none tracking-tight text-[#09090b]">Tanda Tangan Koordinator</h3>
          <button
            type="button"
            @click="isPreviewTtdOpen = false"
            class="rounded-sm opacity-70 transition-opacity hover:opacity-100 text-[#71717a] hover:text-[#09090b] p-1 cursor-pointer"
          >
            <i data-lucide="x" class="w-4 h-4"></i>
          </button>
        </div>

        <div class="flex justify-center py-4">
          <template x-if="ttdSignatureUrl">
            <div class="border border-[#e4e4e7] rounded-md p-4 w-64 h-64 relative flex items-center justify-center bg-[#fafafa]">
              <img :src="ttdSignatureUrl" alt="TTD Koordinator" class="object-contain max-w-full max-h-full" />
            </div>
          </template>
          <template x-if="!ttdSignatureUrl">
            <div class="p-4 text-center text-[#71717a] text-sm">
              Belum ada tanda tangan yang diunggah.
            </div>
          </template>
        </div>

        <div class="flex items-center justify-end pt-3 border-t border-[#e4e4e7]">
          <button
            type="button"
            @click="isPreviewTtdOpen = false"
            class="h-9 px-4 rounded-md border border-[#e4e4e7] bg-white hover:bg-[#f4f4f5] text-sm font-medium text-[#09090b] transition-colors cursor-pointer"
          >
            Tutup
          </button>
        </div>
      </div>
    </div>

    <!-- ==================================================== -->
    <!-- MODAL 2: TAMBAH TTD KOORDINATOR (TambahTtdKoor)      -->
    <!-- ==================================================== -->
    <div
      x-show="isTambahTtdOpen"
      x-cloak
      class="fixed inset-0 z-50 flex items-center justify-center p-4 duration-150 bg-black/50 animate-in fade-in"
    >
      <div
        @click.outside="isTambahTtdOpen = false"
        class="w-full max-w-md rounded-xl bg-white p-6 shadow-xl border border-[#e4e4e7] space-y-4"
      >
        <div class="flex items-center justify-between pb-2 border-b border-[#e4e4e7]">
          <h3 class="text-base font-semibold leading-none tracking-tight text-[#09090b]">Unggah Tanda Tangan</h3>
          <button
            type="button"
            @click="isTambahTtdOpen = false"
            class="rounded-sm opacity-70 transition-opacity hover:opacity-100 text-[#71717a] hover:text-[#09090b] p-1 cursor-pointer"
          >
            <i data-lucide="x" class="w-4 h-4"></i>
          </button>
        </div>

        <div class="py-2 space-y-3">
          <label class="block text-xs font-medium text-[#71717a]">
            Pilih berkas tanda tangan transparan (PNG/JPG, maks 2MB):
          </label>
          <label class="border-2 border-dashed border-[#e4e4e7] hover:border-[#0655a7] rounded-lg p-6 flex flex-col items-center justify-center text-center cursor-pointer transition-colors bg-[#fafafa]">
            <i data-lucide="upload" class="w-8 h-8 text-[#71717a] mb-2"></i>
            <span class="font-medium text-xs text-[#09090b]">Klik untuk memilih berkas</span>
            <span class="text-[11px] text-[#71717a] mt-0.5">PNG atau JPG transparan</span>
            <input type="file" accept="image/png, image/jpeg, image/jpg" class="hidden" @change="handleUploadTtd($event)" />
          </label>
        </div>

        <div class="flex items-center justify-end gap-2 pt-3 border-t border-[#e4e4e7]">
          <button
            type="button"
            @click="isTambahTtdOpen = false"
            class="h-9 px-4 rounded-md border border-[#e4e4e7] bg-white hover:bg-[#f4f4f5] text-sm font-medium text-[#09090b] transition-colors cursor-pointer"
          >
            Batal
          </button>
        </div>
      </div>
    </div>

    <!-- ==================================================== -->
    <!-- MODAL 3: EDIT NILAI SIDANG                           -->
    <!-- ==================================================== -->
    <div
      x-show="isEditNilaiOpen"
      x-cloak
      class="fixed inset-0 z-50 flex items-center justify-center p-4 duration-150 bg-black/50 animate-in fade-in"
    >
      <div
        @click.outside="isEditNilaiOpen = false"
        class="w-full max-w-md rounded-xl bg-white p-6 shadow-xl border border-[#e4e4e7] space-y-4"
      >
        <div class="flex items-start justify-between pb-2 border-b border-[#e4e4e7]">
          <div>
            <h3 class="text-base font-semibold text-[#09090b]">Edit Nilai Sidang</h3>
            <p class="text-xs text-[#71717a] mt-0.5" x-text="editNilaiTarget ? `${editNilaiTarget.mahasiswa?.nama} (${editNilaiTarget.mahasiswa?.nim})` : ''"></p>
          </div>
          <button
            type="button"
            @click="isEditNilaiOpen = false"
            class="rounded-sm opacity-70 transition-opacity hover:opacity-100 text-[#71717a] hover:text-[#09090b] p-1 cursor-pointer"
          >
            <i data-lucide="x" class="w-4 h-4"></i>
          </button>
        </div>

        <div class="space-y-3 text-xs">
          <div class="space-y-1.5">
            <label class="font-semibold text-[#09090b]">Nilai Kontributor (60%)</label>
            <input
              id="input-edit-nilai_kontributor"
              type="number"
              min="0"
              max="100"
              x-model="editNilaiForm.nilai_kontributor"
              placeholder="0 - 100"
              class="h-9 w-full rounded-md border border-[#e4e4e7] bg-white px-3 text-sm text-[#09090b] focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
            />
          </div>

          <div class="space-y-1.5">
            <label class="font-semibold text-[#09090b]">Nilai Penguji 1 / Pembimbing (24%)</label>
            <input
              id="input-edit-nilai_penguji_1"
              type="number"
              min="0"
              max="100"
              x-model="editNilaiForm.nilai_penguji_1"
              placeholder="0 - 100"
              class="h-9 w-full rounded-md border border-[#e4e4e7] bg-white px-3 text-sm text-[#09090b] focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
            />
          </div>

          <div class="space-y-1.5">
            <label class="font-semibold text-[#09090b]">Nilai Penguji 2 (16%)</label>
            <input
              id="input-edit-nilai_penguji_2"
              type="number"
              min="0"
              max="100"
              x-model="editNilaiForm.nilai_penguji_2"
              placeholder="0 - 100"
              class="h-9 w-full rounded-md border border-[#e4e4e7] bg-white px-3 text-sm text-[#09090b] focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
            />
          </div>
        </div>

        <div class="flex items-center justify-end gap-2 pt-3 border-t border-[#e4e4e7]">
          <button
            type="button"
            @click="isEditNilaiOpen = false"
            class="h-9 px-4 rounded-md border border-[#e4e4e7] bg-white hover:bg-[#f4f4f5] text-xs font-medium text-[#09090b] transition-colors cursor-pointer"
          >
            Batal
          </button>
          <button
            type="button"
            @click="simpanEditNilai()"
            class="h-9 px-4 rounded-md bg-[#0655a7] hover:bg-[#114D91] text-white text-xs font-medium transition-colors cursor-pointer"
          >
            Simpan Nilai
          </button>
        </div>
      </div>
    </div>
  </section>
</AdminShell>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    if (typeof lucide !== 'undefined') lucide.createIcons();
  });
</script>
