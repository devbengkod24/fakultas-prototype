      isScheduled(item) {
        return !!item.jadwal.tanggal;
      },

      get filteredRows() {
        return this.plottingData.filter(item => {
          if (!this.isScheduled(item)) return false;
          const isDone = item.sidang_status === 'selesai' || item.nilai_akhir != null;
          const matchStatus = this.statusFilter === 'semua' ||
            (this.statusFilter === 'selesai' ? isDone : !isDone);
          const q = this.searchQuery.trim().toLowerCase();
          const matchSearch = q === '' ||
            item.mahasiswa.nama.toLowerCase().includes(q) ||
            item.mahasiswa.nim.toLowerCase().includes(q) ||
            (item.pembimbing?.nama && item.pembimbing.nama.toLowerCase().includes(q)) ||
            (item.penguji_1?.nama && item.penguji_1.nama.toLowerCase().includes(q)) ||
            (item.penguji_2?.nama && item.penguji_2.nama.toLowerCase().includes(q)) ||
            (item.gmeet && item.gmeet.toLowerCase().includes(q));
          return matchStatus && matchSearch;
        });
      },

      get sortedRows() {
        if (!this.sortDir) return this.filteredRows;
        return [...this.filteredRows].sort((a, b) => {
          const da = `${a.jadwal.tanggal ?? ''} ${a.jadwal.jam ?? ''}`.trim();
          const db = `${b.jadwal.tanggal ?? ''} ${b.jadwal.jam ?? ''}`.trim();
          return this.sortDir === 'asc' ? da.localeCompare(db) : db.localeCompare(da);
        });
      },

      get paginatedRows() {
        const start = (this.currentPage - 1) * this.pageSize;
        return this.sortedRows.slice(start, start + this.pageSize);
      },

      get totalPages() {
        return Math.max(1, Math.ceil(this.sortedRows.length / this.pageSize));
      },

      getAvailableStudents(dosenId) {
        if (!dosenId) return [];
        const plottedNims = new Set(this.plottingData.map(p => p.mahasiswa.nim));
        return this.unplottedMahasiswa.filter(
          m => m.dosenId.toString() === dosenId.toString() && !plottedNims.has(m.nim)
        );
      },

      toggleBuatMhs(slot, nim) {
        const key = slot === 1 ? 'buatSelectedMhs1' : 'buatSelectedMhs2';
        if (this[key].includes(nim)) {
          this[key] = this[key].filter(x => x !== nim);
        } else if (this[key].length < 2) {
          this[key] = [...this[key], nim];
        }
      },

      openBuatJadwalModal() {
        this.buatTglSidang = '2026-07-23';
        this.buatJamMulai = '09:00';
        this.buatGmeet = '';
        this.buatDosen1Id = '';
        this.buatDosen2Id = '';
        this.buatSelectedMhs1 = [];
        this.buatSelectedMhs2 = [];
        this.isBuatModalOpen = true;
        this.reinitLucide();
      },

      simpanBuatJadwal() {
        if (!this.buatTglSidang || !this.buatJamMulai) {
          this.triggerToast('Tanggal dan waktu sidang wajib diisi.', 'error');
          return;
        }
        if (!this.buatDosen1Id || !this.buatDosen2Id) {
          this.triggerToast('Pilih 2 dosen penguji terlebih dahulu.', 'error');
          return;
        }
        if (this.buatDosen1Id === this.buatDosen2Id) {
          this.triggerToast('Dosen Penguji 1 dan Dosen Penguji 2 tidak boleh sama.', 'error');
          return;
        }
        if (this.buatSelectedMhs1.length < 1 || this.buatSelectedMhs1.length > 2) {
          this.triggerToast('Pilih minimal 1 dan maksimal 2 mahasiswa untuk Dosen Penguji 1.', 'error');
          return;
        }
        if (this.buatSelectedMhs2.length > 2) {
          this.triggerToast('Maksimal 2 mahasiswa untuk Dosen Penguji 2.', 'error');
          return;
        }

        const [h] = (this.buatJamMulai || '09:00').split(':').map(Number);
        const jamSelesai = `${String(h + 1).padStart(2, '0')}:00`;
        const dosen1 = this.dosenList.find(d => d.id.toString() === this.buatDosen1Id.toString()) || null;
        const dosen2 = this.dosenList.find(d => d.id.toString() === this.buatDosen2Id.toString()) || null;
        const picked = [
          ...this.buatSelectedMhs1.map(nim => ({ nim, pembimbing: dosen1 })),
          ...this.buatSelectedMhs2.map(nim => ({ nim, pembimbing: dosen2 })),
        ];

        let nextId = this.plottingData.reduce((m, s) => Math.max(m, s.sidang_id), 0) + 1;
        const createdRows = [];
        picked.forEach(({ nim, pembimbing }) => {
          const mhs = this.unplottedMahasiswa.find(m => m.nim === nim);
          if (!mhs) return;
          createdRows.push({
            sidang_id: nextId,
            pengajuan_sidang_id: 100 + nextId,
            skema: mhs.skema,
            pembimbing,
            mahasiswa: { id: 100 + nextId, nama: mhs.nama, nim: mhs.nim },
            jadwal: { tanggal: this.buatTglSidang, jam: `${this.buatJamMulai} - ${jamSelesai}`, status: 'terjadwal' },
            gmeet: '',
            penguji_1: dosen1,
            penguji_2: dosen2,
            gelombang: { id: 2, nama_gelombang: 'Gelombang 2' },
            nilai_penyelia: null,
            nilai_pembimbing: null,
            nilai_penguji_1: null,
            nilai_penguji_2: null,
            sidang_status: null,
          });
          nextId += 1;
        });

        this.plottingData = [...createdRows, ...this.plottingData];
        this.currentPage = 1;
        this.isBuatModalOpen = false;
        this.triggerToast(`Berhasil membuat jadwal sidang untuk ${createdRows.length} mahasiswa`);
        this.reinitLucide();
      },

      openEditJadwal(item) {
        this.editTarget = item;
        this.editTglSidang = item.jadwal.tanggal || '';
        this.editJamMulai = item.jadwal.jam ? item.jadwal.jam.split(' - ')[0] : '09:00';
        this.editGmeet = item.gmeet || '';
        this.editPengujiId = item.penguji_1?.id?.toString() || '';
        this.editPenguji2Id = item.penguji_2?.id?.toString() || '';
        this.isEditModalOpen = true;
        this.reinitLucide();
      },

      simpanEditJadwal() {
        if (!this.editTarget) return;
        const target = this.plottingData.find(s => s.sidang_id === this.editTarget.sidang_id);
        if (target) {
          const [h] = (this.editJamMulai || '09:00').split(':').map(Number);
          const jamSelesai = `${String(h + 1).padStart(2, '0')}:00`;
          target.jadwal = {
            tanggal: this.editTglSidang,
            jam: `${this.editJamMulai} - ${jamSelesai}`,
            status: 'terjadwal'
          };
          target.penguji_1 = this.dosenList.find(d => d.id.toString() === this.editPengujiId) || null;
          target.penguji_2 = this.dosenList.find(d => d.id.toString() === this.editPenguji2Id) || null;
        }
        this.triggerToast('Berhasil memperbarui jadwal sidang');
        this.isEditModalOpen = false;
        this.editTarget = null;
        this.reinitLucide();
      },

      formatTanggalIndo(dateStr) {
        if (!dateStr) return '-';
        const hari = ['Minggu', 'Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu'];
        const bulan = ['Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'];
        const [y, m, d] = dateStr.split('-').map(Number);
        const dt = new Date(y, m - 1, d);
        return `${hari[dt.getDay()]}, ${d} ${bulan[m - 1]} ${y}`;
      },

      loadExternalScript(src) {
        return new Promise((resolve, reject) => {
          const existing = Array.from(document.scripts).find((s) => s.src === src);
          if (existing) {
            if (existing.getAttribute('data-loaded') === 'true') return resolve();
            existing.addEventListener('load', () => resolve(), { once: true });
            existing.addEventListener('error', () => reject(new Error(`Gagal memuat ${src}`)), { once: true });
            return;
          }
          const script = document.createElement('script');
          script.src = src;
          script.async = true;
          script.onload = () => {
            script.setAttribute('data-loaded', 'true');
            resolve();
          };
          script.onerror = () => reject(new Error(`Gagal memuat ${src}`));
          document.head.appendChild(script);
        });
      },

      async ensurePdfZipLibs(needZip = false) {
        const resolveGlobals = () => {
          const h2p = window.__html2pdf || window.html2pdf;
          const jsz = window.__JSZip || window.JSZip;
          const html2pdfFn = h2p?.default || h2p;
          const jsZipCtor = jsz?.default || jsz;
          return {
            html2pdf: typeof html2pdfFn === 'function' ? html2pdfFn : null,
            JSZip: typeof jsZipCtor === 'function' ? jsZipCtor : null,
          };
        };

        let libs = resolveGlobals();
        // Tunggu sebentar jika script module masih dalam proses inisialisasi
        for (let i = 0; i < 15 && (!libs.html2pdf || (needZip && !libs.JSZip)); i++) {
          await new Promise((r) => setTimeout(r, 100));
          libs = resolveGlobals();
        }

        // Fallback otomatis ke CDN jika module lokal belum tersedia
        try {
          if (!libs.html2pdf) {
            await this.loadExternalScript('https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js');
          }
          if (needZip && !libs.JSZip) {
            await this.loadExternalScript('https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js');
          }
        } catch (err) {
          console.error('Fallback CDN PDF/ZIP gagal:', err);
        }

        libs = resolveGlobals();
        if (libs.html2pdf) window.__html2pdf = libs.html2pdf;
        if (libs.JSZip) window.__JSZip = libs.JSZip;
        return libs;
      },

