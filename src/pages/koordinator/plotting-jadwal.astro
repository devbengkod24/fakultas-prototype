      async renderUndanganPdfBlob(htmlString) {
        const html2pdf = window.__html2pdf;
        const container = document.createElement('div');
        container.style.position = 'fixed';
        container.style.left = '-99999px';
        container.style.top = '0';
        container.style.background = '#fff';
        container.innerHTML = htmlString;
        document.body.appendChild(container);

        const imgs = Array.from(container.querySelectorAll('img'));
        await Promise.all(imgs.map((img) => {
          if (img.complete) return Promise.resolve();
          return new Promise((res) => {
            img.onload = res;
            img.onerror = res;
          });
        }));

        try {
          const targetEl = container.querySelector('.undangan-doc') || container;
          const blob = await html2pdf()
            .set({
              margin: 8,
              image: { type: 'jpeg', quality: 0.96 },
              html2canvas: { scale: 2, useCORS: true, logging: false },
              jsPDF: { unit: 'mm', format: 'a4', orientation: 'landscape' },
              pagebreak: { mode: ['css', 'legacy'], before: '.page-break' }
            })
            .from(targetEl)
            .outputPdf('blob');
          return blob;
        } finally {
          container.remove();
        }
      },

      triggerBlobDownload(blob, filename) {
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = filename;
        document.body.appendChild(a);
        a.click();
        a.remove();
        setTimeout(() => URL.revokeObjectURL(url), 1000);
      },

      async handleDownloadUndangan() {
        if (!this.undanganKode.trim()) {
          this.triggerToast('Nomor SK / Kode Undangan wajib diisi.', 'error');
          return;
        }
        if (this.undanganMode === 'pilih' && !this.undanganDosenId) {
          this.triggerToast('Pilih dosen penguji terlebih dahulu.', 'error');
          return;
        }

        const targetDosenList = this.undanganMode === 'pilih'
          ? this.dosenList.filter(d => d.id.toString() === this.undanganDosenId.toString())
          : this.dosenList.filter(d =>
              this.plottingData.some(p => this.isScheduled(p) && (p.penguji_1?.id === d.id || p.penguji_2?.id === d.id))
            );

        if (targetDosenList.length === 0) {
          this.triggerToast('Tidak ada dosen penguji dengan jadwal sidang aktif.', 'error');
          return;
        }

        const { html2pdf, JSZip } = await this.ensurePdfZipLibs(this.undanganMode === 'personal');
        if (!html2pdf || (this.undanganMode === 'personal' && !JSZip)) {
          this.triggerToast('Komponen generator PDF/ZIP belum siap, coba muat ulang halaman.', 'error');
          return;
        }

        const bulan = ['Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'];
        let tglSuratText = '6 Juli 2026';
        if (this.undanganTgl) {
          const [y, m, d] = this.undanganTgl.split('-').map(Number);
          tglSuratText = `${d} ${bulan[m - 1]} ${y}`;
        }

        this.isDownloadingUndangan = true;
        try {
          if (this.undanganMode === 'pilih') {
            const dosen = targetDosenList[0];
            const safeName = dosen.nama.replace(/[\\/:*?<>|]/g, '_');
            const filename = `UNDANGAN PENGUJI KAMPUS BERDAMPAK - ${safeName}.pdf`;
            const markup = this.buildUndanganDosenMarkup(dosen, tglSuratText);
            const pdfBlob = await this.renderUndanganPdfBlob(markup);
            this.triggerBlobDownload(pdfBlob, filename);
            this.triggerToast(`Berhasil mengunduh ${filename}`, 'success');
          } else {
            const zip = new JSZip();
            for (const dosen of targetDosenList) {
              const safeName = dosen.nama.replace(/[\\/:*?<>|]/g, '_');
              const pdfName = `UNDANGAN PENGUJI KAMPUS BERDAMPAK - ${safeName}.pdf`;
              const markup = this.buildUndanganDosenMarkup(dosen, tglSuratText);
              const pdfBlob = await this.renderUndanganPdfBlob(markup);
              zip.file(pdfName, pdfBlob);
            }
            const zipBlob = await zip.generateAsync({ type: 'blob' });
            this.triggerBlobDownload(zipBlob, 'UNDANGAN PENGUJI KAMPUS BERDAMPAK.zip');
            this.triggerToast(`Berhasil mengunduh UNDANGAN PENGUJI KAMPUS BERDAMPAK.zip (${targetDosenList.length} file PDF)`, 'success');
          }
          this.isUndanganModalOpen = false;
        } catch (err) {
          console.error(err);
          this.triggerToast('Gagal membuat file undangan PDF/ZIP.', 'error');
        } finally {
          this.isDownloadingUndangan = false;
        }
      },

      formatDate(dateStr) {
        if (!dateStr) return '-';
        try {
          const [y, m, d] = dateStr.split('-');
          return `${d}/${m}/${y}`;
        } catch {
          return dateStr;
        }
      },

      triggerToast(msg, type = 'success') {
        if (typeof window.showAdminToast === 'function') {
          window.showAdminToast(msg, type);
        }
      },

      reinitLucide() {
        this.$nextTick(() => {
          if (typeof lucide !== 'undefined') lucide.createIcons();
        });
      }
    }"
  >
    <!-- Toolbar: Sesuai PlottingJadwalKoordinator di fakultas-fe -->
