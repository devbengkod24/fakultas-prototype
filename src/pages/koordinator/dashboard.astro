---
import AdminShell from '../../layouts/AdminShell.astro';
import ActionNavCard from '../../components/ui/ActionNavCard.astro';
import BorderInfoCard from '../../components/ui/BorderInfoCard.astro';
import QuickActionsCard from '../../components/ui/QuickActionsCard.astro';
import ActivityFeedCard from '../../components/ui/ActivityFeedCard.astro';
import LogbookChartCard from '../../components/ui/LogbookChartCard.astro';
---

<AdminShell currentTab="dashboard">
  <section
    id="section-dashboard"
    class="flex flex-col flex-1 min-h-0 gap-4 pr-1 overflow-y-auto tab-content"
  >
<!-- Main Dashboard Grid: 8 Cols Kiri + 4 Cols Kanan (Sesuai tugas-akhir & kerja-praktek fakultas-fe) -->
<div class="grid items-stretch grid-cols-1 gap-4 lg:grid-cols-12">
  <!-- SISI KIRI (8 Kolom) -->
  <div class="flex flex-col min-w-0 space-y-4 lg:col-span-8">
    <!-- 3 Menu Cards Grid (Diekstrak ke Global Component ActionNavCard) -->
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
      <!-- Card 1: Plotting Jadwal -->
      <ActionNavCard
        title="Plotting Jadwal"
        subtitle="Atur jadwal & undangan sidang"
        icon="calendar-clock"
        iconColor="text-orange-500"
        onclick="window.location.href='/koordinator/plotting-jadwal'"
      />

      <!-- Card 2: Logbook Bimbingan -->
      <ActionNavCard
        title="Logbook Bimbingan"
        subtitle="Verifikasi bimbingan mahasiswa"
        icon="book-open-check"
        iconColor="text-amber-500"
        onclick="window.location.href='/koordinator/dosen-data'"
      />

      <!-- Card 3: Hasil Sidang -->
      <ActionNavCard
        title="Hasil Sidang"
        subtitle="Nilai & rekap hasil sidang"
        icon="award"
        iconColor="text-emerald-500"
        onclick="window.location.href='/koordinator/hasil-sidang'"
      />
    </div>

    <!-- Charts Row (Statistik Logbook & Distribusi Mahasiswa) -->
    <div class="grid gap-4 xl:grid-cols-12">
      <!-- Statistik Logbook (24 slot minggu, bar mengikuti minggu berjalan) -->
      <LogbookChartCard
        class="col-span-12 xl:col-span-6"
        weeklyCounts={[18, 24, 31, 42, 29, 13, 0, 22]}
        currentWeek={8}
        onTimeRate="92%"
        rekapHref="/koordinator/logbook"
      />

      <!-- Distribusi Mahasiswa -->
      <div class="col-span-12 xl:col-span-6 rounded-xl border border-[#e4e4e7] bg-white p-5 flex flex-col justify-between shadow-none">
        <div class="flex items-center justify-between mb-2">
          <h3 class="font-semibold text-sm text-[#09090b]">Distribusi Mahasiswa Kampus Berdampak</h3>
          <span class="text-xs text-[#71717a]">48 Mahasiswa</span>
        </div>
        <div class="pt-2 space-y-3">
          <div>
            <div class="flex justify-between mb-1 text-xs">
              <span class="text-[#3f3f46]">Magang Berdampak & Industri</span>
              <span class="font-semibold text-[#09090b]">20 Mhs (42%)</span>
            </div>
            <div class="w-full h-2 overflow-hidden bg-gray-100 rounded-full">
              <div class="h-full bg-[#0655a7] rounded-full" style="width: 42%"></div>
            </div>
          </div>
          <div>
            <div class="flex justify-between mb-1 text-xs">
              <span class="text-[#3f3f46]">Studi Independen Bersertifikat</span>
              <span class="font-semibold text-[#09090b]">14 Mhs (29%)</span>
            </div>
            <div class="w-full h-2 overflow-hidden bg-gray-100 rounded-full">
              <div class="h-full rounded-full bg-sky-500" style="width: 29%"></div>
            </div>
          </div>
          <div>
            <div class="flex justify-between mb-1 text-xs">
              <span class="text-[#3f3f46]">Riset, Bela Negara & Wirausaha</span>
              <span class="font-semibold text-[#09090b]">9 Mhs (19%)</span>
            </div>
            <div class="w-full h-2 overflow-hidden bg-gray-100 rounded-full">
              <div class="h-full rounded-full bg-emerald-500" style="width: 19%"></div>
            </div>
          </div>
          <div>
            <div class="flex justify-between mb-1 text-xs">
              <span class="text-[#3f3f46]">Kampus Mengajar & Desa</span>
              <span class="font-semibold text-[#09090b]">5 Mhs (10%)</span>
            </div>
            <div class="w-full h-2 overflow-hidden bg-gray-100 rounded-full">
              <div class="h-full rounded-full bg-amber-500" style="width: 10%"></div>
            </div>
          </div>
        </div>
        <div class="flex items-center justify-between text-xs text-[#71717a] pt-3 border-t border-[#e4e4e7] mt-3">
          <span>Dominasi: <strong class="text-[#09090b]">Teknik Informatika</strong></span>
          <span class="font-medium text-[#0655a7]">5 Prodi</span>
        </div>
      </div>
    </div>

    <!-- Bottom Section: Pelamar Kampus Berdampak Terbaru -->
    <div class="rounded-xl border border-[#e4e4e7] bg-white p-5 flex flex-col flex-1 shadow-none">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-4">
        <div>
          <h2 class="font-semibold text-sm text-[#09090b]">Pelamar Kampus Berdampak Terbaru</h2>
          <p class="text-xs text-[#71717a] mt-0.5">Daftar pengajuan pelamar terbaru yang menunggu tinjauan berkas</p>
        </div>
        <a
          href="/koordinator/pelamar"
          class="inline-flex items-center gap-1 text-xs font-medium text-[#0655a7] hover:underline shrink-0 self-start sm:self-auto"
        >
          <span>Lihat Semua</span>
          <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
        </a>
      </div>

      <div class="rounded-lg border border-[#e4e4e7] overflow-hidden bg-white">
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="border-b border-[#e4e4e7] bg-[#fafafa]">
              <tr>
                <th class="h-10 px-4 font-semibold text-xs text-left text-[#71717a]">Mahasiswa</th>
                <th class="h-10 px-4 font-semibold text-xs text-left text-[#71717a]">Program / Kontributor</th>
                <th class="h-10 px-4 font-semibold text-xs text-left text-[#71717a] whitespace-nowrap">Akademik</th>
                <th class="h-10 px-4 font-semibold text-xs text-center text-[#71717a]">Status</th>
                <th class="h-10 px-4 font-semibold text-xs text-center text-[#71717a]">Aksi</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[#e4e4e7]">
              {[
                { init: 'CR', nama: 'Calvin Revianto', nim: 'A11.2021.13782', program: 'Inkubator Bisnis FIK', skema: 'Kegiatan Wirausaha', ipk: '3.42', sks: '112' },
                { init: 'NZ', nama: 'Nabila Zahra Putri', nim: 'A12.2022.09842', program: 'Dicoding Indonesia', skema: 'Studi Independen', ipk: '3.78', sks: '104' },
                { init: 'RA', nama: 'Rizky Aditya Pratama', nim: 'A11.2022.14012', program: 'PT Bank Central Asia', skema: 'Magang Industri (KKI)', ipk: '3.65', sks: '108' },
                { init: 'TA', nama: 'Tarissa Aura Azzahra', nim: 'A11.2020.13158', program: 'Bengkel Koding UDINUS', skema: 'Asistensi Mengajar', ipk: '3.84', sks: '118' },
              ].map((p) => (
                <tr class="hover:bg-[#fafafa] transition-colors">
                  <td class="h-[60px] px-4 text-sm">
                    <div class="flex items-center gap-2.5 min-w-0">
                      <div class="h-8 w-8 rounded-full bg-[#f4f4f5] text-[#0655a7] font-semibold text-xs flex items-center justify-center shrink-0 border border-[#e4e4e7]">
                        {p.init}
                      </div>
                      <div class="min-w-0">
                        <div class="font-semibold text-xs text-[#09090b] truncate">{p.nama}</div>
                        <div class="text-[11px] text-[#71717a]">{p.nim}</div>
                      </div>
                    </div>
                  </td>
                  <td class="h-[60px] px-4">
                    <div class="text-xs font-medium text-[#09090b] truncate">{p.program}</div>
                    <div class="text-[11px] text-[#71717a] truncate">{p.skema}</div>
                  </td>
                  <td class="h-[60px] px-4 text-xs text-[#52525b] whitespace-nowrap">
                    <span>IPK {p.ipk}</span>
                    <span class="mx-1 text-[#d4d4d8]">•</span>
                    <span>{p.sks} SKS</span>
                  </td>
                  <td class="h-[60px] px-4 text-center">
                    <span class="inline-flex items-center rounded-md border border-amber-200 bg-amber-50 px-2 py-0.5 text-[11px] font-semibold text-amber-800 whitespace-nowrap">Menunggu</span>
                  </td>
                  <td class="h-[60px] px-4 text-center">
                    <button
                      type="button"
                      onclick="window.location.href='/koordinator/pelamar'"
                      class="inline-flex items-center gap-1 h-7 px-2.5 text-xs font-medium rounded-md border border-[#e4e4e7] bg-white hover:border-[#0655a7] hover:bg-blue-50/40 text-[#0655a7] transition-colors cursor-pointer"
                    >
                      <i data-lucide="eye" class="w-3.5 h-3.5"></i>
                      <span>Tinjau</span>
                    </button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <!-- SISI KANAN (4 Kolom) (Diekstrak ke Global Components) -->
  <div class="flex flex-col gap-3 lg:col-span-4">
    <!-- Periode Aktif Card -->
    <BorderInfoCard
      label="Periode Aktif"
      value="2026/2027"
      icon="calendar"
      variant="blue"
    />

    <!-- Ringkasan Antrean Perlu Tindakan Koordinator -->
    <div class="rounded-xl border border-[#e4e4e7] bg-white p-3 shadow-none space-y-2">
      <div class="flex items-center justify-between">
        <p class="text-sm font-medium text-[#09090b]">Perlu Tindakan</p>
        <span class="text-[11px] font-medium text-[#71717a]">14 menunggu</span>
      </div>
      <div class="space-y-1 text-xs">
        <a
          href="/koordinator/pelamar"
          class="w-full flex items-center justify-between p-2 rounded-lg hover:bg-gray-50 text-[#3f3f46] hover:text-[#0655a7] transition-colors"
        >
          <span class="flex items-center gap-2 min-w-0">
            <i data-lucide="file-check" class="w-4 h-4 text-[#0655a7] shrink-0"></i>
            <span class="truncate">Pelamar Baru</span>
          </span>
          <span class="px-2 py-0.5 rounded-full text-[11px] font-semibold bg-blue-50 text-[#0655a7] shrink-0">4</span>
        </a>
        <a
          href="/koordinator/konversi"
          class="w-full flex items-center justify-between p-2 rounded-lg hover:bg-gray-50 text-[#3f3f46] hover:text-[#0655a7] transition-colors"
        >
          <span class="flex items-center gap-2 min-w-0">
            <i data-lucide="arrow-left-right" class="w-4 h-4 text-amber-600 shrink-0"></i>
            <span class="truncate">Konversi SKS Menunggu</span>
          </span>
          <span class="px-2 py-0.5 rounded-full text-[11px] font-semibold bg-amber-50 text-amber-700 shrink-0">5</span>
        </a>
        <a
          href="/koordinator/dosen-data"
          class="w-full flex items-center justify-between p-2 rounded-lg hover:bg-gray-50 text-[#3f3f46] hover:text-[#0655a7] transition-colors"
        >
          <span class="flex items-center gap-2 min-w-0">
            <i data-lucide="book-open-check" class="w-4 h-4 text-emerald-600 shrink-0"></i>
            <span class="truncate">Bimbingan Perlu Disetujui</span>
          </span>
          <span class="px-2 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-50 text-emerald-700 shrink-0">3</span>
        </a>
        <a
          href="/koordinator/plotting-jadwal"
          class="w-full flex items-center justify-between p-2 rounded-lg hover:bg-gray-50 text-[#3f3f46] hover:text-[#0655a7] transition-colors"
        >
          <span class="flex items-center gap-2 min-w-0">
            <i data-lucide="calendar-clock" class="w-4 h-4 text-orange-500 shrink-0"></i>
            <span class="truncate">Jadwal Sidang Belum Diplot</span>
          </span>
          <span class="px-2 py-0.5 rounded-full text-[11px] font-semibold bg-orange-50 text-orange-700 shrink-0">2</span>
        </a>
      </div>
    </div>

    <!-- Pintasan Operasional Cepat -->
    <QuickActionsCard
      title="Aksi Cepat"
      items={[
        { label: 'Buat Pengumuman', icon: 'megaphone', onclick: "window.location.href='/koordinator/pengumuman'" },
        { label: 'Tambah Kontributor', icon: 'building-2', onclick: "window.location.href='/koordinator/kontributor'" },
        { label: 'Atur Periode Ajaran', icon: 'calendar-range', onclick: "window.location.href='/koordinator/periode'" },
      ]}
    />

    <!-- Aktivitas Terkini -->
    <ActivityFeedCard
      title="Aktivitas Terkini"
      activities={[
        { text: 'Calvin Revianto mengajukan lamaran Kampus Berdampak', time: '10 menit lalu', color: 'blue' },
        { text: 'Budi Santoso direkomendasikan kontributor', time: '1 jam lalu', color: 'green' },
        { text: 'Periode 2026/2027 diperbarui oleh Koordinator', time: '3 jam lalu', color: 'amber' },
      ]}
    />
  </div>
</div>

  </section>
</AdminShell>
