---
// Form gabungan: Kelola Program + Kelola CMS untuk kontributor eksternal baru
import AdminShell from '../../../layouts/AdminShell.astro';
import FormSectionProgram from '../../../components/admin/kontributor/form/FormSectionProgram.astro';
import FormSectionCms from '../../../components/admin/kontributor/form/FormSectionCms.astro';

const formActions = `
  <div class="flex items-center gap-2.5 shrink-0">
    <a
      href="/koordinator/kontributor"
      class="inline-flex items-center gap-2 h-9 px-3.5 text-xs font-semibold rounded-lg border border-gray-300 bg-white hover:bg-gray-50 text-gray-700 transition-all shadow-2xs"
    >
      <i data-lucide="arrow-left" class="w-3.5 h-3.5 text-gray-500"></i>
      <span>Kembali</span>
    </a>
    <button
      type="button"
      onclick="handleSaveKontributorForm()"
      class="inline-flex items-center justify-center gap-2 h-9 px-4 text-xs font-bold rounded-lg bg-[#0655a7] hover:bg-[#114D91] text-white shadow-2xs transition-all active:scale-95 cursor-pointer"
    >
      <i data-lucide="save" class="w-3.5 h-3.5"></i>
      <span>Simpan Semua</span>
    </button>
  </div>
`;
---

<AdminShell
  currentTab="kontributor"
  pageTitle="Form Kontributor Baru"
  subtitle="Lengkapi data program dan konten CMS halaman publik dalam satu form."
  actionButton={formActions}
>
  <section id="section-kontributor-form" class="flex flex-col flex-1 min-h-0 pr-1 overflow-y-auto font-sans space-y-6">
    <div class="rounded-xl border border-[#e4e4e7] bg-white p-5 flex items-start sm:items-center gap-4 shadow-none">
      <div id="kf-partner-avatar" class="h-14 w-14 rounded-xl border border-[#e4e4e7] bg-[#f4f4f5] text-[#09090b] font-semibold text-lg flex items-center justify-center shrink-0">--</div>
      <div class="space-y-1">
        <div class="flex flex-wrap items-center gap-2">
          <h2 id="kf-partner-name" class="text-lg sm:text-xl font-semibold text-[#09090b]">Kontributor</h2>
          <span class="inline-flex items-center gap-1.5 rounded-md border border-[#e4e4e7] bg-[#f4f4f5] px-2.5 py-0.5 text-xs font-medium text-[#09090b]">
            <i data-lucide="globe" class="w-3.5 h-3.5 text-[#71717a]"></i>
            <span id="kf-partner-tipe">Kontributor Eksternal</span>
          </span>
        </div>
        <p id="kf-partner-deskripsi" class="text-xs text-[#71717a] max-w-2xl leading-relaxed">-</p>
        <div class="flex items-center gap-1.5 pt-1 text-xs text-[#71717a]">
          <i data-lucide="user" class="w-3.5 h-3.5"></i>
          <span id="kf-partner-pic">-</span>
        </div>
      </div>
    </div>

    <FormSectionProgram />
    <FormSectionCms />
  </section>
</AdminShell>
