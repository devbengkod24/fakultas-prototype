---
// src/pages/koordinator/logbook.astro
import AdminShell from '../../layouts/AdminShell.astro';
import { logbookKegiatanList } from '../../data/admin/logbook-kegiatan';

const logbookJson = JSON.stringify(logbookKegiatanList);
---

<AdminShell currentTab="logbook">
  <section
    id="section-logbook"
    class="flex flex-col flex-1 min-h-0 gap-4 pr-1 overflow-y-auto tab-content"
    x-data={`{
      viewMode: 'master',
      searchQuery: '',
      statusFilter: 'semua',
      currentPage: 1,
      pageSize: 10,
      selectedMhs: null,
      openWeeks: {},
      isDocModalOpen: false,
      docPreview: { minggu: '', tanggal: '', deskripsi: '', dokumenNama: '', catatanDospem: '' },
      students: ${logbookJson},

      get filteredStudents() {
        const q = (this.searchQuery || '').toLowerCase().trim();
        return this.students.filter(s => {
          const matchSearch = !q ||
            s.nama.toLowerCase().includes(q) ||
            s.nim.toLowerCase().includes(q) ||
            s.mitra.toLowerCase().includes(q) ||
            s.dosenPembimbing.toLowerCase().includes(q);
          const matchStatus = this.statusFilter === 'semua' || s.statusProgres === this.statusFilter;
          return matchSearch && matchStatus;
        });
      },
      get totalPages() {
        return Math.max(1, Math.ceil(this.filteredStudents.length / this.pageSize));
      },
      get paginatedStudents() {
        const start = (this.currentPage - 1) * this.pageSize;
        return this.filteredStudents.slice(start, start + this.pageSize);
      },
      progressPercent(mhs) {
        if (!mhs || !mhs.totalMinggu) return 0;
        return Math.min(100, Math.round((mhs.mingguAktif / mhs.totalMinggu) * 100));
      },
      progressBarColor(mhs) {
        if (!mhs || mhs.mingguAktif === 0) return 'bg-[#d4d4d8]';
        if (mhs.mingguAktif >= mhs.totalMinggu) return 'bg-emerald-600';
        return 'bg-[#0655a7]';
      },
      openDetail(mhs) {
        this.selectedMhs = mhs;
        this.openWeeks = {};
        (mhs?.weeks || []).forEach((w, i) => {
          this.openWeeks[w.minggu] = i < 2;
        });
        this.viewMode = 'detail';
      },
      init() {
        const params = new URLSearchParams(window.location.search);
        const nim = params.get('nim');
        if (!nim) return;
        const found = this.students.find((s) => s.nim === nim);
        if (found) {
          this.openDetail(found);
          return;
        }
        const skema = params.get('skema') || '';
        this.openDetail({
          id: 0,
          nama: params.get('nama') || nim,
          nim,
          prodi: '',
          mitra: skema && skema !== 'Belum Ada' ? skema : '-',
          program: skema,
          dosenPembimbing: params.get('dosen') || '-',
          mingguAktif: 0,
          totalMinggu: 24,
          statusProgres: 'belum',
          weeks: [],
        });
      },
      backToMaster() {
        if (new URLSearchParams(window.location.search).get('nim')) {
          window.location.href = '/koordinator/data-mahasiswa';
          return;
        }
        this.selectedMhs = null;
        this.viewMode = 'master';
      },
      toggleWeek(minggu) {
        this.openWeeks[minggu] = !this.openWeeks[minggu];
      },
      statusBadgeClass(status) {
        if (status === 'Diterima') return 'bg-[#ecfdf5] text-[#15803d] border-[#bbf7d0]';
        if (status === 'Menunggu') return 'bg-amber-50 text-amber-800 border-amber-200';
        return 'bg-rose-50 text-rose-700 border-rose-200';
      },
      initials(name) {
        if (!name) return 'M';
        return name.split(' ').filter(Boolean).slice(0, 2).map(w => w[0].toUpperCase()).join('');
      },
      totalEntries(mhs) {
        if (!mhs || !Array.isArray(mhs.weeks)) return 0;
        return mhs.weeks.reduce((sum, w) => sum + ((w.entries || []).length), 0);
      },
      progressPercent(mhs) {
        if (!mhs || !mhs.totalMinggu) return 0;
        return Math.min(100, Math.round(((mhs.mingguAktif || 0) / mhs.totalMinggu) * 100));
      },
      openDoc(week, entry) {
        this.docPreview = {
          minggu: 'Minggu ' + week.minggu,
          tanggal: entry.tanggal,
          deskripsi: entry.deskripsi,
          dokumenNama: entry.dokumenNama,
          catatanDospem: entry.catatanDospem || ''
        };
        this.isDocModalOpen = true;
      }
    }`}
    x-effect="(() => { const h = document.getElementById('dashboard-header-bar-2'); if (h) h.classList.toggle('hidden', viewMode === 'detail'); })()"
  >
    <!-- View 1: Tabel Daftar Mahasiswa (Logbook Mingguan per Rentang 6 Minggu) -->
    <div x-show="viewMode === 'master'" class="flex flex-col gap-4">
      <!-- Toolbar Pencarian & Filter Status -->
      <div class="flex flex-col items-start justify-between gap-3 sm:flex-row sm:items-center">
        <div class="relative w-full sm:w-96">
          <i data-lucide="search" class="w-4 h-4 text-[#71717a] absolute left-3 top-1/2 -translate-y-1/2"></i>
          <input
            type="text"
            x-model="searchQuery"
            @input="currentPage = 1"
            placeholder="Cari mahasiswa, NIM, mitra, atau dospem..."
            class="h-9 w-full rounded-md border border-[#e4e4e7] bg-white pl-9 pr-3 text-sm text-[#09090b] placeholder:text-[#71717a] focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
          />
        </div>

        <div class="flex items-center gap-2 ml-auto">
          <select
            x-model="statusFilter"
            @change="currentPage = 1"
            class="h-9 rounded-md border border-[#e4e4e7] bg-white px-3 text-xs text-[#09090b] focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
          >
            <option value="semua">Semua Status Progres</option>
            <option value="aktif">Sedang Berjalan</option>
            <option value="selesai">Lengkap (24 Minggu)</option>
            <option value="belum">Belum Mengisi</option>
          </select>
        </div>
      </div>

      <!-- Tabel 5 Kolom -->
      <div class="rounded-lg border border-[#e4e4e7] overflow-hidden bg-white">
        <div class="overflow-x-auto">
          <table class="w-full text-sm table-fixed">
            <thead class="border-b border-[#e4e4e7] bg-[#fafafa]">
              <tr>
                <th class="h-11 px-4 font-semibold text-xs w-14 text-center text-[#71717a]">No.</th>
                <th class="h-11 px-4 font-semibold text-xs text-center text-[#71717a] w-[24%]">Nama Mahasiswa</th>
                <th class="h-11 px-4 font-semibold text-xs text-center text-[#71717a] w-[26%]">Kontributor</th>
                <th class="h-11 px-4 font-semibold text-xs text-center text-[#71717a]">Progress</th>
                <th class="h-11 px-4 font-semibold text-xs text-center text-[#71717a] w-36">Detail</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[#e4e4e7]">
              <template x-for="(mhs, idx) in paginatedStudents" :key="mhs.id">
                <tr class="hover:bg-[#f4f4f5]/60 transition-colors">
                  <td class="h-[68px] px-2 text-center text-xs font-medium text-[#71717a]" x-text="((currentPage - 1) * pageSize) + (idx + 1)"></td>
                  <td class="h-[68px] px-4 text-sm">
                    <div class="flex items-center min-w-0 gap-3">
                      <div class="h-9 w-9 rounded-full bg-[#f4f4f5] text-[#0655a7] font-semibold text-xs flex items-center justify-center shrink-0 border border-[#e4e4e7]">
                        <span x-text="mhs.nama.charAt(0)"></span>
                      </div>
                      <div class="flex flex-col leading-tight gap-0.5 min-w-0">
                        <span class="font-semibold text-[#09090b] text-sm truncate" x-text="mhs.nama"></span>
                        <span class="text-xs text-[#71717a] truncate" x-text="mhs.nim"></span>
                      </div>
                    </div>
                  </td>

                  <!-- Mitra -->
                  <td class="h-[68px] px-4 text-sm text-center">
                    <span class="block font-medium text-[#09090b] text-sm truncate" x-text="mhs.mitra"></span>
                  </td>

                  <!-- Progress Bar + Keterangan Mingguan (angka/max) -->
                  <td class="h-[68px] px-4">
                    <div class="flex items-center gap-3 w-[82%] mx-auto">
                      <div class="flex-1 h-2 rounded-full bg-[#f4f4f5] overflow-hidden border border-[#e4e4e7]/60">
                        <div
                          class="h-full transition-all duration-300 rounded-full"
                          :class="progressBarColor(mhs)"
                          :style="`width: ${progressPercent(mhs)}%`"
                        ></div>
                      </div>
                      <span
                        class="text-xs font-semibold tabular-nums shrink-0 min-w-[44px] text-right"
                        :class="mhs.mingguAktif === mhs.totalMinggu ? 'text-emerald-700' : mhs.mingguAktif > 0 ? 'text-[#0655a7]' : 'text-[#71717a]'"
                        x-text="`${mhs.mingguAktif}/${mhs.totalMinggu}`"
                      ></span>
                    </div>
                  </td>

                  <!-- Detail -->
                  <td class="h-[68px] px-4 text-center">
                    <button
                      type="button"
                      @click="openDetail(mhs)"
                      :disabled="mhs.mingguAktif === 0"
                      :class="mhs.mingguAktif === 0 ? 'opacity-50 cursor-not-allowed border-[#e4e4e7] bg-[#f4f4f5] text-[#71717a]' : 'border-[#0655a7] bg-[#0655a7] hover:bg-[#114d91] text-white cursor-pointer'"
                      class="inline-flex items-center gap-1.5 h-8 px-3 rounded-md border text-xs font-medium transition-colors whitespace-nowrap"
                    >
                      <span>Lihat Semua</span>
                    </button>
                  </td>
                </tr>
              </template>
              <template x-if="paginatedStudents.length === 0">
                <tr>
                  <td colspan="5" class="h-28 text-center text-xs text-[#71717a]">
                    Tidak ada data logbook mahasiswa yang cocok dengan kriteria pencarian.
                  </td>
                </tr>
              </template>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Standardized Pagination -->
      <div class="flex flex-col items-center justify-between gap-2 pt-1 sm:flex-row">
        <div class="text-xs text-[#71717a]" x-text="'Menampilkan ' + (filteredStudents.length === 0 ? 0 : ((currentPage - 1) * pageSize + 1)) + ' - ' + Math.min(currentPage * pageSize, filteredStudents.length) + ' dari ' + filteredStudents.length + ' data'"></div>
        <div class="flex items-center gap-1.5">
          <button
            type="button"
            @click="if (currentPage > 1) currentPage--"
            :disabled="currentPage <= 1"
            :class="currentPage <= 1 ? 'opacity-50 cursor-not-allowed hover:bg-white text-[#71717a]' : 'hover:bg-[#f4f4f5] text-[#09090b]'"
            class="h-8 w-8 flex items-center justify-center rounded-md border border-[#e4e4e7] bg-white text-xs transition-colors"
            title="Halaman Sebelumnya"
          >
            <i data-lucide="chevron-left" class="w-4 h-4"></i>
          </button>

          <template x-for="p in totalPages" :key="p">
            <button
              type="button"
              @click="currentPage = p"
              :class="currentPage === p ? 'bg-[#0655a7] text-white font-semibold shadow-none' : 'border border-[#e4e4e7] bg-white text-[#09090b] font-medium hover:bg-[#f4f4f5]'"
              class="flex items-center justify-center w-8 h-8 text-xs transition-colors rounded-md"
              x-text="p"
            ></button>
          </template>

          <button
            type="button"
            @click="if (currentPage < totalPages) currentPage++"
            :disabled="currentPage >= totalPages"
            :class="currentPage >= totalPages ? 'opacity-50 cursor-not-allowed hover:bg-white text-[#71717a]' : 'hover:bg-[#f4f4f5] text-[#09090b]'"
            class="h-8 w-8 flex items-center justify-center rounded-md border border-[#e4e4e7] bg-white text-xs transition-colors"
            title="Halaman Selanjutnya"
          >
            <i data-lucide="chevron-right" class="w-4 h-4"></i>
          </button>

          <select
            x-model.number="pageSize"
            @change="currentPage = 1"
            class="h-8 rounded-md border border-[#e4e4e7] bg-white px-2 text-xs text-[#09090b] focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
          >
            <option value="5">Show 5 items</option>
            <option value="10">Show 10 items</option>
            <option value="25">Show 25 items</option>
            <option value="50">Show 50 items</option>
          </select>
        </div>
      </div>
    </div>

    <!-- View 2: Detail Logbook Mingguan (Style Riwayat Logbook) -->
    <div x-show="viewMode === 'detail'" class="flex flex-col gap-5" x-cloak>
      <!-- Tombol Kembali di Paling Atas -->
      <div class="flex items-center">
        <button
          type="button"
          @click="backToMaster()"
          class="inline-flex items-center gap-1.5 h-9 px-3 rounded-md border border-[#e4e4e7] bg-white hover:bg-[#f4f4f5] text-xs font-medium text-[#09090b] transition-colors cursor-pointer"
        >
          <i data-lucide="arrow-left" class="w-3.5 h-3.5"></i>
          <span>Kembali</span>
        </button>
      </div>

      <!-- Card Ringkasan Mahasiswa -->
      <div class="rounded-xl border border-[#e4e4e7] bg-white p-6">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
          <div class="flex items-start gap-6 min-w-0">
            <div class="h-20 w-20 rounded-full bg-[#f4f4f5] text-[#09090b] font-medium text-2xl flex items-center justify-center shrink-0">
              <span x-text="initials(selectedMhs?.nama)"></span>
            </div>
            <div class="min-w-0">
              <h2 class="text-lg font-semibold text-[#09090b] leading-snug" x-text="selectedMhs?.nama || ''"></h2>
              <p class="text-sm text-[#71717a]" x-text="selectedMhs?.nim || ''"></p>
              <p class="text-xs text-[#71717a] mt-1" x-text="`Dosen Pembimbing: ${selectedMhs?.dosenPembimbing || '-'}`"></p>
              <div class="mt-2.5 mb-2.5">
                <span
                  class="inline-flex items-center px-2.5 py-0.5 rounded-md text-xs font-medium"
                  :class="(selectedMhs?.mingguAktif || 0) >= (selectedMhs?.totalMinggu || 24) ? 'bg-emerald-50 text-emerald-700' : 'bg-amber-50 text-amber-700'"
                  x-text="(selectedMhs?.mingguAktif || 0) >= (selectedMhs?.totalMinggu || 24) ? 'Selesai' : 'Sedang Berjalan'"
                ></span>
              </div>
              <div class="space-y-1 text-xs text-[#09090b]">
                <p class="flex items-center gap-2">
                  <i data-lucide="file-text" class="w-3.5 h-3.5 text-[#71717a] shrink-0"></i>
                  <span>Total Logbook: <strong x-text="totalEntries(selectedMhs)"></strong></span>
                </p>
                <p class="flex items-center gap-2">
                  <i data-lucide="book-open" class="w-3.5 h-3.5 text-[#71717a] shrink-0"></i>
                  <span>Minggu Terakhir: <strong x-text="selectedMhs?.mingguAktif || 0"></strong></span>
                </p>
              </div>
            </div>
          </div>

          <div class="w-full md:w-[46%] shrink-0 space-y-2 pb-1">
            <div class="flex items-center justify-between text-xs">
              <span class="text-[#52525b]">Progress Kampus Berdampak</span>
              <span class="font-medium text-[#09090b] tabular-nums" x-text="`${progressPercent(selectedMhs)}%`"></span>
            </div>
            <div class="h-2 w-full bg-[#f4f4f5] rounded-full overflow-hidden">
              <div
                class="h-full bg-[#0655a7] rounded-full transition-all duration-300"
                :style="`width: ${progressPercent(selectedMhs)}%`"
              ></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Timeline Riwayat Logbook -->
      <div class="space-y-4 pt-1">
        <h3 class="text-lg font-bold text-[#09090b]">Riwayat Logbook</h3>

        <template x-if="(selectedMhs?.weeks || []).length === 0">
          <div class="rounded-xl border border-dashed border-[#e4e4e7] bg-white p-10 text-center text-xs text-[#71717a]">
            Belum ada entri logbook kegiatan.
          </div>
        </template>

        <div class="space-y-5">
          <template x-for="(week, wIdx) in (selectedMhs?.weeks || [])" :key="week.minggu">
            <div class="relative">
              <!-- Garis Vertikal Timeline -->
              <div
                x-show="wIdx < (selectedMhs?.weeks || []).length - 1"
                class="absolute left-[18px] top-9 bottom-[-20px] w-[1px] bg-[#e4e4e7]"
              ></div>

              <div class="flex items-start gap-4">
                <!-- Node Lingkaran Bernomor -->
                <div class="relative z-10 size-9 rounded-full bg-blue-50 border border-blue-200 text-[#0655a7] text-xs font-semibold flex items-center justify-center shrink-0">
                  <span x-text="week.minggu"></span>
                </div>

                <!-- Card Logbook -->
                <div class="flex-1 rounded-xl border border-[#e4e4e7] bg-white overflow-hidden">
                  <!-- Header Kartu Accordion -->
                  <div
                    class="px-5 py-4 flex items-start justify-between gap-4 cursor-pointer hover:bg-[#fafafa] transition-colors"
                    @click="toggleWeek(week.minggu)"
                  >
                    <div class="space-y-1">
                      <div class="flex items-center gap-2.5 flex-wrap">
                        <span class="text-sm font-bold text-[#09090b]" x-text="`Minggu ${week.minggu}`"></span>
                        <span
                          class="inline-flex items-center px-2 py-0.5 rounded-md text-[11px] font-semibold border"
                          :class="statusBadgeClass(week.status)"
                          x-text="week.status"
                        ></span>
                      </div>
                      <p class="text-xs text-[#71717a]" x-text="`Terakhir: ${week.terakhir}`"></p>
                      <p class="text-xs text-[#71717a]" x-text="`${week.entries.length}x catatan kegiatan`"></p>
                    </div>

                    <button
                      type="button"
                      class="p-1 rounded-md text-[#71717a] hover:bg-[#f4f4f5] shrink-0 cursor-pointer"
                    >
                      <svg class="w-4 h-4 transition-transform duration-200" :class="openWeeks[week.minggu] ? 'rotate-180' : ''" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
                    </button>
                  </div>

                  <!-- Isi Entri Mingguan -->
                  <div x-show="openWeeks[week.minggu]" x-cloak class="border-t border-[#e4e4e7] divide-y divide-[#e4e4e7]">
                    <template x-for="entry in week.entries" :key="entry.id">
                      <div class="px-5 py-4 space-y-3 bg-white">
                        <div class="flex items-center justify-between gap-3">
                          <div class="flex items-center gap-1.5 text-xs text-[#71717a]">
                            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                            <span x-text="entry.tanggal"></span>
                          </div>
                          <span
                            class="inline-flex items-center px-2 py-0.5 rounded-md text-[11px] font-semibold border shrink-0"
                            :class="statusBadgeClass(entry.status)"
                            x-text="entry.status"
                          ></span>
                        </div>

                        <p class="text-sm text-[#09090b] leading-relaxed" x-text="entry.deskripsi"></p>

                        <template x-if="entry.catatanDospem">
                          <p class="text-xs text-[#71717a]">
                            <span class="font-medium text-[#09090b]">Catatan Dosen Pembimbing: </span>
                            <span x-text="entry.catatanDospem"></span>
                          </p>
                        </template>

                        <div class="pt-1">
                          <button
                            type="button"
                            @click="openDoc(week, entry)"
                            class="inline-flex items-center gap-1.5 h-8 px-3 rounded-md border border-[#e4e4e7] bg-white hover:bg-[#f4f4f5] text-xs font-medium text-[#09090b] transition-colors cursor-pointer"
                          >
                            <svg class="w-3.5 h-3.5 text-[#71717a]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/></svg>
                            <span>Lihat Dokumen</span>
                          </button>
                        </div>
                      </div>
                    </template>
                  </div>
                </div>
              </div>
            </div>
          </template>
        </div>
      </div>
    </div>

    <!-- Modal Pratinjau Dokumen Logbook -->
    <div
      x-show="isDocModalOpen"
      x-cloak
      class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/50"
    >
      <div
        @click.outside="isDocModalOpen = false"
        class="w-full max-w-md rounded-2xl bg-white p-6 shadow-2xl border border-[#e4e4e7] space-y-4"
      >
        <div class="flex items-start justify-between">
          <div>
            <h3 class="text-base font-bold text-[#09090b]" x-text="`Dokumen Logbook — ${docPreview.minggu}`"></h3>
            <p class="text-xs text-[#71717a] mt-0.5" x-text="docPreview.tanggal"></p>
          </div>
          <button
            type="button"
            @click="isDocModalOpen = false"
            class="h-7 w-7 rounded-md hover:bg-[#f4f4f5] text-[#71717a] flex items-center justify-center cursor-pointer"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
          </button>
        </div>

        <div class="rounded-lg bg-[#fafafa] border border-[#e4e4e7] p-3.5 space-y-2">
          <p class="text-xs font-semibold text-[#09090b]">Ringkasan Kegiatan</p>
          <p class="text-xs text-[#52525b] leading-relaxed" x-text="docPreview.deskripsi"></p>
        </div>

        <div class="flex items-center justify-between rounded-lg border border-[#e4e4e7] px-3.5 py-2.5 bg-white">
          <div class="flex items-center min-w-0 gap-2">
            <svg class="w-4 h-4 text-[#0655a7] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/></svg>
            <span class="text-xs font-medium text-[#09090b] truncate" x-text="docPreview.dokumenNama"></span>
          </div>
          <span class="text-[11px] font-medium text-[#0655a7] shrink-0 ml-2">Lampiran PDF</span>
        </div>

        <div class="flex justify-end pt-1">
          <button
            type="button"
            @click="isDocModalOpen = false"
            class="h-9 px-4 rounded-lg bg-[#0655a7] hover:bg-[#0655a7]/90 text-white text-xs font-semibold transition-colors cursor-pointer"
          >
            Tutup
          </button>
        </div>
      </div>
    </div>
  </section>
</AdminShell>
