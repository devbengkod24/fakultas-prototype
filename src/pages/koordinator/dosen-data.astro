---
// src/pages/koordinator/dosen-data.astro
import AdminShell from "../../layouts/AdminShell.astro";
---

<AdminShell currentTab="dosen-data">
  <section
    id="section-dosen-data"
    class="flex flex-col flex-1 min-h-0 gap-4 pr-1 overflow-y-auto tab-content"
    x-data="{
      searchQuery: '',
      sortOption: 'nama_asc',
      currentPage: 1,
      pageSize: 5,
      isDetailOpen: false,
      selectedDosen: null,
      dosenList: [
        {
          id: 1,
          nama: 'Dr. M. Arief Soeleman, M.Kom',
          npp: '0612047801',
          aktifPeriode: true,
          mahasiswa: [
            { nama: 'Faisal Rahman', nim: 'A11.2022.13901', program: 'Bengkel Koding' },
            { nama: 'Rizky Aditya Pratama', nim: 'A11.2022.14012', program: 'Dicoding Indonesia' },
            { nama: 'Bagas Prasetyo', nim: 'A11.2022.14105', program: 'IDDS' },
          ]
        },
        {
          id: 2,
          nama: 'Affandy, Ph.D',
          npp: '0617087502',
          aktifPeriode: true,
          mahasiswa: [
            { nama: 'Tarissa Aura Azzahra', nim: 'A11.2020.13158', program: 'Bengkel Koding' },
            { nama: 'Dimas Bagus Setiawan', nim: 'A12.2022.09915', program: 'IDDS' },
          ]
        },
        {
          id: 3,
          nama: 'Christy Atika Sari, M.Kom',
          npp: '0629038401',
          aktifPeriode: true,
          mahasiswa: [
            { nama: 'Nabila Zahra Putri', nim: 'A12.2022.09842', program: 'Dicoding Indonesia' },
          ]
        },
        {
          id: 4,
          nama: 'Eko Hari Rachmawanto, M.Kom',
          npp: '0615028201',
          aktifPeriode: true,
          mahasiswa: [
            { nama: 'Siti Aminah', nim: 'A12.2022.09911', program: 'Bengkel Koding' },
            { nama: 'Hendra Wijaya', nim: 'A11.2022.14220', program: 'Lab IntSys' },
          ]
        },
        {
          id: 5,
          nama: 'Ajib Susanto, M.Kom',
          npp: '0621057901',
          aktifPeriode: false,
          mahasiswa: []
        },
        {
          id: 6,
          nama: 'Dr. Muljono, S.Si, M.Kom',
          npp: '0619087201',
          aktifPeriode: true,
          mahasiswa: [
            { nama: 'Annisa Tri Rahayu', nim: 'A11.2022.14201', program: 'IDDS' },
            { nama: 'Dimas Wahyu Nugroho', nim: 'A11.2021.13450', program: 'PT Bank Central Asia' },
            { nama: 'Dewi Lestari Kusuma', nim: 'A14.2022.03211', program: 'Ryuje Tech' },
          ]
        },
        {
          id: 7,
          nama: 'Dr. Ricardus Anggi, M.Kom',
          npp: '0624018602',
          aktifPeriode: true,
          mahasiswa: [
            { nama: 'Putra Mahendra', nim: 'A11.2022.14308', program: 'Bengkel Koding' },
          ]
        },
      ],
      get filteredDosen() {
        const q = (this.searchQuery || '').toLowerCase();
        let list = this.dosenList.filter(d =>
          (d.nama || '').toLowerCase().includes(q) || (d.npp || '').includes(q)
        );
        if (this.sortOption === 'nama_asc') {
          list = [...list].sort((a, b) => a.nama.localeCompare(b.nama));
        } else if (this.sortOption === 'nama_desc') {
          list = [...list].sort((a, b) => b.nama.localeCompare(a.nama));
        }
        return list;
      },
      get totalPages() {
        return Math.max(1, Math.ceil(this.filteredDosen.length / this.pageSize));
      },
      get paginatedDosen() {
        const start = (this.currentPage - 1) * this.pageSize;
        return this.filteredDosen.slice(start, start + this.pageSize);
      },
      openDetailDrawer(dosen) {
        this.selectedDosen = dosen;
        this.isDetailOpen = true;
      },
      closeDetailDrawer() {
        this.isDetailOpen = false;
      },
      toggleStatus(dosen) {
        if (!dosen) return;
        dosen.aktifPeriode = !dosen.aktifPeriode;
        window.showAdminToast?.(
          `Status ${dosen.nama} diubah menjadi ${dosen.aktifPeriode ? 'Aktif' : 'Nonaktif'}`,
          dosen.aktifPeriode ? 'success' : 'info'
        );
      }
    }"
    @keydown.escape.window="closeDetailDrawer()"
  >
    <!-- Toolbar -->
    <div class="flex flex-col md:flex-row gap-2 items-start md:items-center justify-between">
      <!-- Search Input -->
      <div class="relative w-full sm:w-72 md:w-80">
        <i data-lucide="search" class="w-4 h-4 text-[#71717a] absolute left-3 top-1/2 -translate-y-1/2"></i>
        <input
          type="text"
          x-model="searchQuery"
          @input="currentPage = 1"
          placeholder="Cari Dosen..."
          class="h-9 w-full rounded-md border border-[#e4e4e7] bg-white pl-9 pr-3 text-sm text-[#09090b] placeholder:text-[#71717a] focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
        />
      </div>

      <!-- Action Buttons Right -->
      <div class="flex items-center gap-2 ml-auto flex-wrap">
        <select
          x-model="sortOption"
          @change="currentPage = 1"
          class="h-9 rounded-md border border-[#e4e4e7] bg-white px-3 text-xs text-[#09090b] focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
        >
          <option value="nama_asc">Nama (A - Z)</option>
          <option value="nama_desc">Nama (Z - A)</option>
        </select>

        <button
          type="button"
          onclick="syncDataDosenUdi()"
          class="inline-flex items-center gap-2 h-9 px-3.5 text-xs font-medium rounded-md border border-[#e4e4e7] bg-white hover:bg-[#f4f4f5] text-[#09090b] shadow-none transition-colors cursor-pointer"
        >
          <i data-lucide="refresh-cw" class="w-4 h-4 text-[#71717a]"></i>
          <span>Sync Data UDI</span>
        </button>

        <button
          type="button"
          onclick="openModalTambahDosen()"
          class="inline-flex items-center gap-2 h-9 px-4 text-xs font-semibold rounded-md bg-[#0655a7] hover:bg-[#114d91] text-white shadow-none transition-colors cursor-pointer"
        >
          <i data-lucide="user-plus" class="w-4 h-4"></i>
          <span>Tambah Dosen</span>
        </button>
      </div>
    </div>

    <!-- Tabel Data Dosen (4 Kolom: No., Nama Dosen Pembimbing, Mahasiswa, Aksi) -->
    <div class="rounded-lg border border-[#e4e4e7] overflow-hidden bg-white">
      <div class="overflow-x-auto">
        <table class="w-full table-fixed text-sm">
          <thead class="border-b border-[#e4e4e7] bg-[#fafafa]">
            <tr>
              <th class="h-11 px-4 font-semibold text-xs w-14 text-center text-[#71717a]">No.</th>
              <th class="h-11 px-4 font-semibold text-xs text-left text-[#71717a] w-[20%]">Nama Dosen Pembimbing</th>
              <th class="h-11 px-4 font-semibold text-xs text-center text-[#71717a]">Mahasiswa</th>
              <th class="h-11 px-4 font-semibold text-xs text-center text-[#71717a] w-36">Aksi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#e4e4e7]">
            <template x-for="(dosen, idx) in paginatedDosen" :key="dosen.id">
              <tr class="hover:bg-[#f4f4f5]/60 transition-colors">
                <td class="h-[68px] px-2 text-center text-xs font-medium text-[#71717a]" x-text="((currentPage - 1) * pageSize) + (idx + 1)"></td>
                <td class="h-[68px] px-4 text-sm">
                  <div class="flex items-center gap-3 min-w-0">
                    <div class="h-9 w-9 rounded-full bg-[#f4f4f5] text-[#0655a7] font-semibold text-xs flex items-center justify-center shrink-0 border border-[#e4e4e7]">
                      <span x-text="dosen.nama.charAt(0)"></span>
                    </div>
                    <div class="flex flex-col min-w-0">
                      <div class="flex items-center gap-2 min-w-0">
                        <span class="font-semibold text-[#09090b] text-sm truncate" x-text="dosen.nama"></span>
                        <span
                          class="h-2 w-2 rounded-full shrink-0"
                          :class="dosen.aktifPeriode ? 'bg-emerald-500' : 'bg-[#d4d4d8]'"
                          :title="dosen.aktifPeriode ? 'Aktif' : 'Nonaktif'"
                        ></span>
                      </div>
                      <span class="text-xs text-[#71717a]" x-text="dosen.npp"></span>
                    </div>
                  </div>
                </td>
                <td class="h-[68px] px-4 text-center text-sm font-medium text-[#09090b]" x-text="dosen.mahasiswa.length"></td>
                <td class="h-[68px] px-4 text-center text-sm">
                  <button
                    type="button"
                    @click="openDetailDrawer(dosen)"
                    class="inline-flex items-center justify-center h-8 px-3 rounded-md border border-[#e4e4e7] bg-white hover:border-[#0655a7] hover:bg-blue-50/40 text-xs font-medium text-[#09090b] hover:text-[#0655a7] transition-colors cursor-pointer"
                  >
                    Detail
                  </button>
                </td>
              </tr>
            </template>
            <template x-if="paginatedDosen.length === 0">
              <tr>
                <td colspan="4" class="h-28 text-center text-xs text-[#71717a]">
                  Tidak ada data dosen pembimbing yang cocok dengan kriteria pencarian.
                </td>
              </tr>
            </template>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Standardized Pagination -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-2 pt-1">
      <div class="text-xs text-[#71717a]" x-text="'Menampilkan ' + (filteredDosen.length === 0 ? 0 : ((currentPage - 1) * pageSize + 1)) + ' - ' + Math.min(currentPage * pageSize, filteredDosen.length) + ' dari ' + filteredDosen.length + ' data'"></div>
      <div class="flex items-center gap-1.5">
        <button
          type="button"
          @click="if (currentPage > 1) currentPage--"
          :disabled="currentPage <= 1"
          :class="currentPage <= 1 ? 'opacity-50 cursor-not-allowed hover:bg-white text-[#71717a]' : 'hover:bg-[#f4f4f5] text-[#09090b]'"
          class="h-8 w-8 flex items-center justify-center rounded-md border border-[#e4e4e7] bg-white text-xs transition-colors"
          title="Halaman Sebelumnya"
        >
          <i data-lucide="chevron-left" class="w-4 h-4"></i>
        </button>

        <template x-for="p in totalPages" :key="p">
          <button
            type="button"
            @click="currentPage = p"
            :class="currentPage === p ? 'bg-[#0655a7] text-white font-semibold shadow-none' : 'border border-[#e4e4e7] bg-white text-[#09090b] font-medium hover:bg-[#f4f4f5]'"
            class="h-8 w-8 flex items-center justify-center rounded-md text-xs transition-colors"
            x-text="p"
          ></button>
        </template>

        <button
          type="button"
          @click="if (currentPage < totalPages) currentPage++"
          :disabled="currentPage >= totalPages"
          :class="currentPage >= totalPages ? 'opacity-50 cursor-not-allowed hover:bg-white text-[#71717a]' : 'hover:bg-[#f4f4f5] text-[#09090b]'"
          class="h-8 w-8 flex items-center justify-center rounded-md border border-[#e4e4e7] bg-white text-xs transition-colors"
          title="Halaman Selanjutnya"
        >
          <i data-lucide="chevron-right" class="w-4 h-4"></i>
        </button>

        <select
          x-model.number="pageSize"
          @change="currentPage = 1"
          class="h-8 rounded-md border border-[#e4e4e7] bg-white px-2 text-xs text-[#09090b] focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
        >
          <option value="5">Show 5 items</option>
          <option value="10">Show 10 items</option>
          <option value="25">Show 25 items</option>
          <option value="50">Show 50 items</option>
        </select>
      </div>
    </div>

    <!-- Right-Side Drawer Detail Dosen Pembimbing -->
    <div
      x-show="isDetailOpen"
      x-cloak
      class="fixed inset-0 z-50 flex justify-end bg-black/40 backdrop-blur-[1px]"
    >
      <div class="fixed inset-0" @click="closeDetailDrawer()"></div>

      <div
        class="relative z-10 w-full max-w-lg bg-white h-full shadow-2xl border-l border-[#e4e4e7] flex flex-col"
        x-transition:enter="transition ease-out duration-200"
        x-transition:enter-start="translate-x-full"
        x-transition:enter-end="translate-x-0"
        x-transition:leave="transition ease-in duration-150"
        x-transition:leave-start="translate-x-0"
        x-transition:leave-end="translate-x-full"
      >
        <!-- Header Drawer: Kiri (Foto + Nama + NPP), Kanan (Toggle Status + Close) -->
        <div class="px-6 py-5 flex items-center justify-between gap-4">
          <div class="flex items-center gap-3.5 min-w-0">
            <div class="h-11 w-11 rounded-full bg-[#f4f4f5] text-[#0655a7] font-bold text-sm flex items-center justify-center shrink-0 border border-[#e4e4e7]">
              <span x-text="selectedDosen?.nama?.charAt(0) || 'D'"></span>
            </div>
            <div class="flex flex-col min-w-0">
              <h3 class="text-sm font-bold text-[#09090b] truncate" x-text="selectedDosen?.nama || ''"></h3>
              <p class="text-xs text-[#71717a]" x-text="selectedDosen?.npp || ''"></p>
            </div>
          </div>

          <div class="flex items-center gap-3 shrink-0">
            <div class="flex items-center gap-2">
              <button
                type="button"
                role="switch"
                :aria-checked="selectedDosen?.aktifPeriode"
                @click="toggleStatus(selectedDosen)"
                class="relative inline-flex h-[22px] w-[40px] shrink-0 items-center rounded-full transition-colors duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0655a7]/40 focus-visible:ring-offset-2 cursor-pointer"
                :class="selectedDosen?.aktifPeriode ? 'bg-[#0655a7]' : 'bg-[#d4d4d8]'"
              >
                <span
                  class="inline-block h-[18px] w-[18px] rounded-full bg-white shadow-sm transition-transform duration-200"
                  :class="selectedDosen?.aktifPeriode ? 'translate-x-[20px]' : 'translate-x-[2px]'"
                ></span>
              </button>
              <span
                class="text-xs font-medium min-w-[50px]"
                :class="selectedDosen?.aktifPeriode ? 'text-emerald-700' : 'text-[#71717a]'"
                x-text="selectedDosen?.aktifPeriode ? 'Aktif' : 'Nonaktif'"
              ></span>
            </div>

            <button
              type="button"
              @click="closeDetailDrawer()"
              class="h-8 w-8 rounded-md hover:bg-[#f4f4f5] text-[#71717a] flex items-center justify-center transition-colors cursor-pointer"
              title="Tutup"
            >
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
            </button>
          </div>
        </div>

        <!-- Garis Lurus Pemisah -->
        <hr class="border-[#e4e4e7]" />

        <!-- Body Drawer: Mahasiswa yang Dibimbing -->
        <div class="flex-1 overflow-y-auto p-6 space-y-3">
          <div class="flex items-center justify-between">
            <h4 class="text-xs font-semibold uppercase tracking-wider text-[#71717a]">
              Mahasiswa yang Dibimbing
            </h4>
            <span
              class="text-xs font-medium text-[#71717a]"
              x-text="`${selectedDosen?.mahasiswa?.length || 0} Mahasiswa`"
            ></span>
          </div>

          <template x-if="(selectedDosen?.mahasiswa?.length || 0) > 0">
            <div class="rounded-xl border border-[#e4e4e7] bg-white divide-y divide-[#e4e4e7] overflow-hidden">
              <template x-for="mhs in (selectedDosen?.mahasiswa || [])" :key="mhs.nim">
                <div class="p-4 flex items-center gap-3.5 hover:bg-[#fafafa] transition-colors">
                  <div class="h-9 w-9 rounded-full bg-[#eff6ff] text-[#0655a7] font-semibold text-xs flex items-center justify-center shrink-0 border border-[#bfdbfe]">
                    <span x-text="mhs.nama.charAt(0)"></span>
                  </div>
                  <div class="flex flex-col min-w-0 gap-0.5">
                    <p class="text-sm font-semibold text-[#09090b] truncate">
                      <span x-text="mhs.nama"></span>
                      <span class="font-normal text-[#71717a]"> - </span>
                      <span class="font-medium text-[#0655a7]" x-text="mhs.program"></span>
                    </p>
                    <p class="text-xs text-[#71717a]" x-text="mhs.nim"></p>
                  </div>
                </div>
              </template>
            </div>
          </template>

          <template x-if="(selectedDosen?.mahasiswa?.length || 0) === 0">
            <div class="rounded-xl border border-dashed border-[#e4e4e7] bg-[#fafafa] p-8 text-center text-xs text-[#71717a]">
              Belum ada mahasiswa yang dibimbing pada periode ini.
            </div>
          </template>
        </div>
      </div>
    </div>
  </section>
</AdminShell>
