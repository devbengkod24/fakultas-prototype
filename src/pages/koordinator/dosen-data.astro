---
// src/pages/koordinator/dosen-data.astro
import AdminShell from "../../layouts/AdminShell.astro";
---

<AdminShell currentTab="dosen-data">
  <section
    id="section-dosen-data"
    class="flex flex-col flex-1 min-h-0 gap-4 pr-1 overflow-y-auto tab-content"
    x-data="{
      searchQuery: '',
      sortOption: 'nama_asc',
      currentPage: 1,
      pageSize: 5,
      dosenList: [
        {
          id: 1,
          nama: 'Dr. M. Arief Soeleman, M.Kom',
          npp: '0612047801',
          telepon: '081228110401',
          email: 'arief.soeleman@dsn.dinus.ac.id',
          aktifPeriode: true,
          mahasiswa: [
            { nama: 'Faisal Rahman', nim: 'A11.2022.13901', program: 'Bengkel Koding' },
            { nama: 'Rizky Aditya Pratama', nim: 'A11.2022.14012', program: 'Dicoding Indonesia' },
            { nama: 'Bagas Prasetyo', nim: 'A11.2022.14105', program: 'IDDS' },
          ]
        },
        {
          id: 2,
          nama: 'Affandy, Ph.D',
          npp: '0617087502',
          telepon: '081325220502',
          email: 'affandy@dsn.dinus.ac.id',
          aktifPeriode: true,
          mahasiswa: [
            { nama: 'Tarissa Aura Azzahra', nim: 'A11.2020.13158', program: 'Bengkel Koding' },
            { nama: 'Dimas Bagus Setiawan', nim: 'A12.2022.09915', program: 'IDDS' },
          ]
        },
        {
          id: 3,
          nama: 'Christy Atika Sari, M.Kom',
          npp: '0629038401',
          telepon: '081565330401',
          email: 'christy.atika@dsn.dinus.ac.id',
          aktifPeriode: true,
          mahasiswa: [
            { nama: 'Nabila Zahra Putri', nim: 'A12.2022.09842', program: 'Dicoding Indonesia' },
          ]
        },
        {
          id: 4,
          nama: 'Eko Hari Rachmawanto, M.Kom',
          npp: '0615028201',
          telepon: '085640440201',
          email: 'eko.hari@dsn.dinus.ac.id',
          aktifPeriode: true,
          mahasiswa: [
            { nama: 'Siti Aminah', nim: 'A12.2022.09911', program: 'Bengkel Koding' },
            { nama: 'Hendra Wijaya', nim: 'A11.2022.14220', program: 'Lab IntSys' },
          ]
        },
        {
          id: 5,
          nama: 'Ajib Susanto, M.Kom',
          npp: '0621057901',
          telepon: '081229550901',
          email: 'ajib.susanto@dsn.dinus.ac.id',
          aktifPeriode: false,
          mahasiswa: []
        },
        {
          id: 6,
          nama: 'Dr. Muljono, S.Si, M.Kom',
          npp: '0619087201',
          telepon: '081127660201',
          email: 'muljono@dsn.dinus.ac.id',
          aktifPeriode: true,
          mahasiswa: [
            { nama: 'Annisa Tri Rahayu', nim: 'A11.2022.14201', program: 'IDDS' },
            { nama: 'Dimas Wahyu Nugroho', nim: 'A11.2021.13450', program: 'PT Bank Central Asia' },
            { nama: 'Dewi Lestari Kusuma', nim: 'A14.2022.03211', program: 'Ryuje Tech' },
          ]
        },
        {
          id: 7,
          nama: 'Dr. Ricardus Anggi, M.Kom',
          npp: '0624018602',
          telepon: '081745770602',
          email: 'ricardus.anggi@dsn.dinus.ac.id',
          aktifPeriode: true,
          mahasiswa: [
            { nama: 'Putra Mahendra', nim: 'A11.2022.14308', program: 'Bengkel Koding' },
          ]
        },
      ],
      get filteredDosen() {
        const q = (this.searchQuery || '').toLowerCase();
        let list = this.dosenList.filter(d =>
          (d.nama || '').toLowerCase().includes(q) ||
          (d.npp || '').includes(q) ||
          (d.email || '').toLowerCase().includes(q)
        );
        if (this.sortOption === 'nama_asc') {
          list = [...list].sort((a, b) => a.nama.localeCompare(b.nama));
        } else if (this.sortOption === 'nama_desc') {
          list = [...list].sort((a, b) => b.nama.localeCompare(a.nama));
        }
        return list;
      },
      get totalPages() {
        return Math.max(1, Math.ceil(this.filteredDosen.length / this.pageSize));
      },
      get paginatedDosen() {
        const start = (this.currentPage - 1) * this.pageSize;
        return this.filteredDosen.slice(start, start + this.pageSize);
      },
      goToLogbookBimbingan(dosen) {
        if (!dosen) return;
        const params = new URLSearchParams({
          dosenId: String(dosen.id),
          dosenNama: dosen.nama || '',
          npp: dosen.npp || '',
          telepon: dosen.telepon || '',
          email: dosen.email || '',
          aktif: dosen.aktifPeriode ? '1' : '0',
        });
        window.location.href = `/koordinator/logbook-bimbingan?${params.toString()}`;
      }
    }"
  >
    <!-- Toolbar -->
    <div class="flex flex-col items-start justify-between gap-2 md:flex-row md:items-center">
      <!-- Search Input -->
      <div class="relative w-full sm:w-72 md:w-80">
        <i data-lucide="search" class="w-4 h-4 text-[#71717a] absolute left-3 top-1/2 -translate-y-1/2"></i>
        <input
          type="text"
          x-model="searchQuery"
          @input="currentPage = 1"
          placeholder="Cari Dosen..."
          class="h-9 w-full rounded-md border border-[#e4e4e7] bg-white pl-9 pr-3 text-sm text-[#09090b] placeholder:text-[#71717a] focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
        />
      </div>

      <!-- Action Buttons Right -->
      <div class="flex flex-wrap items-center gap-2 ml-auto">
        <select
          x-model="sortOption"
          @change="currentPage = 1"
          class="h-9 rounded-md border border-[#e4e4e7] bg-white px-3 text-xs text-[#09090b] focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
        >
          <option value="nama_asc">Nama (A - Z)</option>
          <option value="nama_desc">Nama (Z - A)</option>
        </select>

        <button
          type="button"
          onclick="syncDataDosenUdi()"
          class="inline-flex items-center gap-2 h-9 px-3.5 text-xs font-medium rounded-md border border-[#e4e4e7] bg-white hover:bg-[#f4f4f5] text-[#09090b] shadow-none transition-colors cursor-pointer"
        >
          <i data-lucide="refresh-cw" class="w-4 h-4 text-[#71717a]"></i>
          <span>Sync Data UDI</span>
        </button>

        <button
          type="button"
          onclick="openModalTambahDosen()"
          class="inline-flex items-center gap-2 h-9 px-4 text-xs font-semibold rounded-md bg-[#0655a7] hover:bg-[#114d91] text-white shadow-none transition-colors cursor-pointer"
        >
          <i data-lucide="user-plus" class="w-4 h-4"></i>
          <span>Tambah Dosen</span>
        </button>
      </div>
    </div>

    <!-- Tabel Data Dosen (6 Kolom: No., Nama Dosen Pembimbing, Email, Status mahasiswa, Mahasiswa, Aksi) -->
    <div class="rounded-lg border border-[#e4e4e7] overflow-hidden bg-white">
      <div class="overflow-x-auto">
        <table class="w-full text-sm table-fixed">
          <thead class="border-b border-[#e4e4e7] bg-[#fafafa]">
            <tr>
              <th class="h-11 px-4 font-semibold text-xs w-14 text-center text-[#71717a]">No.</th>
              <th class="h-11 px-4 font-semibold text-xs text-left text-[#71717a] w-[28%]">Nama Dosen Pembimbing</th>
              <th class="h-11 px-4 font-semibold text-xs text-left text-[#71717a] w-[25%]">Email</th>
              <th class="h-11 px-4 font-semibold text-xs text-center text-[#71717a] whitespace-nowrap w-40">Status</th>
              <th class="h-11 px-4 font-semibold text-xs text-center text-[#71717a] w-36">Mahasiswa</th>
              <th class="h-11 px-4 font-semibold text-xs text-center text-[#71717a] w-32">Aksi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#e4e4e7]">
            <template x-for="(dosen, idx) in paginatedDosen" :key="dosen.id">
              <tr class="hover:bg-[#f4f4f5]/60 transition-colors">
                <td class="h-[68px] px-2 text-center text-xs font-medium text-[#71717a]" x-text="((currentPage - 1) * pageSize) + (idx + 1)"></td>
                <td class="h-[68px] px-4 text-sm">
                  <div class="flex items-center min-w-0 gap-3">
                    <div class="h-9 w-9 rounded-full bg-[#f4f4f5] text-[#0655a7] font-semibold text-xs flex items-center justify-center shrink-0 border border-[#e4e4e7]">
                      <span x-text="dosen.nama.charAt(0)"></span>
                    </div>
                    <div class="flex flex-col min-w-0">
                      <span class="font-semibold text-[#09090b] text-sm truncate" x-text="dosen.nama"></span>
                      <span class="text-xs text-[#71717a]" x-text="dosen.npp"></span>
                    </div>
                  </div>
                </td>
                <td class="h-[68px] px-4 text-xs text-[#52525b] whitespace-nowrap truncate" x-text="dosen.email"></td>
                <td class="h-[68px] px-4 text-center text-sm">
                  <template x-if="dosen.aktifPeriode">
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-xs font-semibold bg-blue-50 border border-blue-200 text-[#0655a7] whitespace-nowrap">
                      Aktif
                    </span>
                  </template>
                  <template x-if="!dosen.aktifPeriode">
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-xs font-medium bg-[#f4f4f5] border border-[#e4e4e7] text-[#71717a] whitespace-nowrap">
                      Nonaktif
                    </span>
                  </template>
                </td>
                <td class="h-[68px] px-4 text-center text-sm font-medium text-[#09090b]" x-text="dosen.mahasiswa.length"></td>
                <td class="h-[68px] px-4 text-center text-sm">
                  <button
                    type="button"
                    @click="goToLogbookBimbingan(dosen)"
                    class="inline-flex items-center justify-center h-8 px-3 rounded-md border border-[#e4e4e7] bg-white hover:border-[#0655a7] hover:bg-blue-50/40 text-xs font-medium text-[#09090b] hover:text-[#0655a7] transition-colors cursor-pointer"
                  >
                    Detail
                  </button>
                </td>
              </tr>
            </template>
            <template x-if="paginatedDosen.length === 0">
              <tr>
                <td colspan="6" class="h-28 text-center text-xs text-[#71717a]">
                  Tidak ada data dosen pembimbing yang cocok dengan kriteria pencarian.
                </td>
              </tr>
            </template>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Standardized Pagination -->
    <div class="flex flex-col items-center justify-between gap-2 pt-1 sm:flex-row">
      <div class="text-xs text-[#71717a]" x-text="'Menampilkan ' + (filteredDosen.length === 0 ? 0 : ((currentPage - 1) * pageSize + 1)) + ' - ' + Math.min(currentPage * pageSize, filteredDosen.length) + ' dari ' + filteredDosen.length + ' data'"></div>
      <div class="flex items-center gap-1.5">
        <button
          type="button"
          @click="if (currentPage > 1) currentPage--"
          :disabled="currentPage <= 1"
          :class="currentPage <= 1 ? 'opacity-50 cursor-not-allowed hover:bg-white text-[#71717a]' : 'hover:bg-[#f4f4f5] text-[#09090b]'"
          class="h-8 w-8 flex items-center justify-center rounded-md border border-[#e4e4e7] bg-white text-xs transition-colors"
          title="Halaman Sebelumnya"
        >
          <i data-lucide="chevron-left" class="w-4 h-4"></i>
        </button>

        <template x-for="p in totalPages" :key="p">
          <button
            type="button"
            @click="currentPage = p"
            :class="currentPage === p ? 'bg-[#0655a7] text-white font-semibold shadow-none' : 'border border-[#e4e4e7] bg-white text-[#09090b] font-medium hover:bg-[#f4f4f5]'"
            class="flex items-center justify-center w-8 h-8 text-xs transition-colors rounded-md"
            x-text="p"
          ></button>
        </template>

        <button
          type="button"
          @click="if (currentPage < totalPages) currentPage++"
          :disabled="currentPage >= totalPages"
          :class="currentPage >= totalPages ? 'opacity-50 cursor-not-allowed hover:bg-white text-[#71717a]' : 'hover:bg-[#f4f4f5] text-[#09090b]'"
          class="h-8 w-8 flex items-center justify-center rounded-md border border-[#e4e4e7] bg-white text-xs transition-colors"
          title="Halaman Selanjutnya"
        >
          <i data-lucide="chevron-right" class="w-4 h-4"></i>
        </button>

        <select
          x-model.number="pageSize"
          @change="currentPage = 1"
          class="h-8 rounded-md border border-[#e4e4e7] bg-white px-2 text-xs text-[#09090b] focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
        >
          <option value="5">Show 5 items</option>
          <option value="10">Show 10 items</option>
          <option value="25">Show 25 items</option>
          <option value="50">Show 50 items</option>
        </select>
      </div>
    </div>
  </section>
</AdminShell>
