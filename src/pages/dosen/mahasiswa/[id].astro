---
// src/pages/dosen/mahasiswa/[id].astro
import DosenShell from '../../../layouts/DosenShell.astro';
import { students, type Student, type LogbookEntry } from '../../../data/dosenMahasiswaData';

export function getStaticPaths() {
  return students.map((student) => ({
    params: { id: student.id.toString() },
    props: { student },
  }));
}

interface Props {
  student: Student;
}

const { student } = Astro.props;
const studentJson = JSON.stringify(student);
---

<DosenShell
  activeNav="mahasiswa"
  breadcrumb="Mahasiswa Bimbingan"
  pageTitle="Logbook Mahasiswa"
  subtitle={`Detail dan riwayat logbook bimbingan MBKM mahasiswa.`}
>
  <div
    class="w-full flex flex-col"
    x-data={`{
      studentData: ${studentJson},
      openWeeks: { 14: true, 10: true, 8: true },
      modalOpen: false,
      modalType: 'accepted', // 'accepted' | 'revised'
      selectedEntry: null,
      feedbackNote: '',
      showToast: false,
      toastMessage: '',
      toastType: 'success',

      // Modal Terpisah untuk Detail Logbook Mingguan (Kegiatan, Hasil, Lampiran)
      detailModalOpen: false,
      activeDetailEntry: null,

      openDetailModal(entry) {
        this.activeDetailEntry = entry;
        this.detailModalOpen = true;
        this.$nextTick(() => {
          if (window.lucide) window.lucide.createIcons();
        });
      },

      closeDetailModal() {
        this.detailModalOpen = false;
        this.activeDetailEntry = null;
      },

      // Lightbox preview sertifikat/bukti
      previewModalOpen: false,
      previewImage: '',
      previewTitle: '',

      openPreview(imgUrl, title) {
        this.previewImage = imgUrl;
        this.previewTitle = title;
        this.previewModalOpen = true;
      },

      closePreview() {
        this.previewModalOpen = false;
        this.previewImage = '';
        this.previewTitle = '';
      },

      init() {
        // Secara default buka minggu teratas (minggu terbaru)
        const entries = this.filledEntries;
        this.openWeeks = {};
        if (entries && entries.length > 0) {
          this.openWeeks[entries[0].minggu] = true;
        }
        this.$nextTick(() => {
          if (window.lucide) window.lucide.createIcons();
        });
      },

      toggleWeek(week) {
        this.openWeeks[week] = !this.openWeeks[week];
        this.$nextTick(() => {
          if (window.lucide) window.lucide.createIcons();
        });
      },

      get progressPercent() {
        return Math.round((this.studentData.logbookProgress / this.studentData.logbookTotal) * 100);
      },

      get filledEntries() {
        // Menampilkan riwayat bimbingan yang ada dari minggu terbaru
        return this.studentData.logbookEntries
          .filter(e => e.status !== 'Belum Diisi')
          .sort((a, b) => b.minggu - a.minggu);
      },

      openActionModal(entry, type) {
        this.selectedEntry = entry;
        this.modalType = type;
        this.feedbackNote = entry.catatanDosen || '';
        this.modalOpen = true;
        this.$nextTick(() => {
          if (window.lucide) window.lucide.createIcons();
        });
      },

      closeModal() {
        this.modalOpen = false;
        this.selectedEntry = null;
        this.feedbackNote = '';
      },

      submitAction() {
        if (!this.selectedEntry) return;

        const target = this.studentData.logbookEntries.find(e => e.minggu === this.selectedEntry.minggu);
        if (target) {
          if (this.modalType === 'accepted') {
            target.status = 'Disetujui';
            target.catatanDosen = this.feedbackNote.trim() || 'Logbook diterima dan disetujui.';
            if (this.studentData.logbookPendingReview > 0) {
              this.studentData.logbookPendingReview--;
            }
            this.toastType = 'success';
            this.toastMessage = \`Logbook Minggu ke-\${target.minggu} berhasil disetujui.\`;
          } else {
            target.status = 'Ditolak';
            target.catatanDosen = this.feedbackNote.trim() || 'Logbook ditolak pembimbing.';
            if (this.studentData.logbookPendingReview > 0) {
              this.studentData.logbookPendingReview--;
            }
            this.toastType = 'warning';
            this.toastMessage = \`Logbook Minggu ke-\${target.minggu} telah ditolak.\`;
          }
        }

        this.closeModal();
        this.showToast = true;
        setTimeout(() => {
          this.showToast = false;
        }, 3500);

        this.$nextTick(() => {
          if (window.lucide) window.lucide.createIcons();
        });
      }
    }`}
  >
    <!-- Back Button (Parity dengan KP) -->
    <div class="mb-4">
      <a
        href="/dosen/mahasiswa"
        class="inline-flex items-center gap-2 text-sm text-[#71717a] hover:text-[#0655a7] transition-colors"
      >
        <i data-lucide="arrow-left" class="h-4 w-4"></i>
        <span>Kembali ke Daftar Mahasiswa</span>
      </a>
    </div>

    <!-- Student Header Card (Parity Persis LogbookHeaderMhs di KP, diperkaya data MBKM) -->
    <div class="rounded-lg border border-[#e4e4e7] bg-white p-6 shadow-none">
      <div class="flex flex-col md:flex-row gap-6">
        <!-- Avatar Foto / Inisial Mahasiswa -->
        <div class="flex flex-col items-center gap-2">
          <div class="h-24 w-24 rounded-full border border-[#e4e4e7] bg-[#f4f4f5] text-[#0655a7] text-2xl font-semibold flex items-center justify-center shrink-0">
            {student.nama.split(" ").map((n) => n[0]).join("").substring(0, 2)}
          </div>
        </div>

        <!-- Detail Mahasiswa & Tombol Folder MBKM -->
        <div class="flex-1 space-y-4">
          <div class="flex justify-between items-start flex-col sm:flex-row gap-4">
            <div>
              <h1 class="text-xl font-semibold capitalize text-[#09090b]">
                {student.nama.toLowerCase()}
              </h1>
              <p class="text-gray-500 font-normal text-sm mt-0.5">
                {student.nim} <span class="mx-1">•</span> {student.prodi || 'S1 Teknik Informatika'}
              </p>
              <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-[#71717a] mt-1">
                <span class="flex items-center gap-1">
                  <i data-lucide="mail" class="w-3.5 h-3.5 text-gray-400"></i>
                  {student.email}
                </span>
                <span class="flex items-center gap-1">
                  <i data-lucide="phone" class="w-3.5 h-3.5 text-gray-400"></i>
                  {student.telepon}
                </span>
              </div>
              <p class="text-sm text-gray-600 mt-1.5">
                Dosen Pembimbing: <strong class="text-[#09090b] font-medium">{student.dosenPembimbing}</strong>
              </p>
            </div>

            <!-- Tombol Folder MBKM -->
            <div class="flex gap-2 flex-wrap">
              <a
                href={student.linkFolder}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center h-8 px-3 rounded-md text-xs font-medium border border-[#0655a7] bg-transparent text-[#0655a7] hover:bg-[#0655a7] hover:text-white transition-colors"
              >
                <i data-lucide="external-link" class="mr-2 h-4 w-4"></i>
                Folder MBKM
              </a>
            </div>
          </div>

          <!-- Badge Status (Parity dengan KP: Badge variant="secondary") -->
          <div>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-[#f4f4f5] text-[#18181b] border border-[#e4e4e7]">
              Sedang Berjalan
            </span>
          </div>

          <!-- Grid 2 Kolom (Style Persis Layout Grid KP, Lengkap Data MBKM Sesuai Gambar) -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-2.5 pt-1">
            <!-- Kolom Kiri: Info Tempat, Skema & Posisi -->
            <div class="space-y-2">
              <div class="flex items-center gap-2 text-sm text-gray-800">
                <i data-lucide="award" class="size-4 text-gray-500 shrink-0"></i>
                <span>Skema: <strong>{student.skema}</strong></span>
              </div>
              <div class="flex items-center gap-2 text-sm text-gray-800">
                <i data-lucide="building-2" class="size-4 text-gray-500 shrink-0"></i>
                <span>Mitra: <strong>{student.mitra}</strong></span>
              </div>
              <div class="flex items-center gap-2 text-sm text-gray-800">
                <i data-lucide="briefcase" class="size-4 text-gray-500 shrink-0"></i>
                <span>Posisi: <strong>{student.posisi}</strong></span>
              </div>
            </div>

            <!-- Kolom Kanan: Total Bimbingan, Konversi & Progress -->
            <div class="space-y-2">
              <div class="flex items-center gap-2 text-sm text-gray-800">
                <i data-lucide="file-text" class="size-4 text-gray-500 shrink-0"></i>
                <span>Total Bimbingan: <strong>{student.logbookProgress}</strong> (dari {student.logbookTotal} Minggu)</span>
              </div>
              <div class="flex items-center gap-2 text-sm text-gray-800">
                <i data-lucide="check-circle-2" class="size-4 text-gray-500 shrink-0"></i>
                <span>Konversi SKS: <strong>{student.sks} SKS</strong></span>
              </div>
              <div class="pt-1 space-y-1.5">
                <div class="flex justify-between text-sm text-gray-800">
                  <span>Progress MBKM</span>
                  <span>{Math.round((student.logbookProgress / student.logbookTotal) * 100)}%</span>
                </div>
                <div class="h-2 w-full bg-[#f4f4f5] rounded-full overflow-hidden">
                  <div
                    class="bg-[#0655a7] h-full rounded-full transition-all duration-300"
                    style={`width: ${Math.round((student.logbookProgress / student.logbookTotal) * 100)}%`}
                  ></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Timeline Riwayat Bimbingan (Parity Persis KPLogbookTimeline & LogbookTimelineView di KP) -->
    <div class="mt-8">
      <h2 class="text-xl font-semibold mb-6 text-[#09090b]">Riwayat Bimbingan</h2>

      <!-- Daftar Timeline Menggunakan Struktur Collapsible Persis KP -->
      <div class="space-y-8">
        <template x-for="(entry, idx) in filledEntries" :key="entry.minggu">
          <div class="relative">
            <!-- Garis Vertikal Timeline (Parity KP: absolute left-5 top-10 bottom-[-32px] w-[0.5px] bg-[#e4e4e7]) -->
            <div
              x-show="idx < filledEntries.length - 1"
              class="absolute left-5 top-10 bottom-[-32px] w-[0.5px] bg-[#e4e4e7]"
            ></div>

            <div class="flex gap-4 items-start">
              <!-- Node Lingkaran Kiri (Parity KP: size-10 rounded-full bg-blue-50 border border-blue-200 text-primary font-medium) -->
              <div class="flex-shrink-0 size-10 rounded-full bg-blue-50 flex items-center justify-center z-10 border border-blue-200">
                <span class="text-sm font-medium text-[#0655a7]" x-text="entry.minggu"></span>
              </div>

              <!-- Card Bimbingan Bersih & Terpadu -->
              <div class="flex-1 bg-white rounded-lg border border-[#e4e4e7] shadow-none overflow-hidden">
                <!-- Header Card (Trigger Accordion) -->
                <div
                  @click="toggleWeek(entry.minggu)"
                  class="p-4 cursor-pointer hover:bg-[#fafafa] flex items-center justify-between transition-colors select-none"
                >
                  <div class="flex flex-col gap-1">
                    <div class="flex items-center gap-2.5">
                      <h3 class="text-base font-semibold text-[#09090b]">
                        Bimbingan Minggu <span x-text="entry.minggu"></span>
                      </h3>

                      <!-- Status Badge -->
                      <template x-if="entry.status === 'Disetujui'">
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                          Diterima
                        </span>
                      </template>
                      <template x-if="entry.status === 'Perlu Review'">
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-200">
                          Menunggu Review
                        </span>
                      </template>
                      <template x-if="entry.status === 'Ditolak'">
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-red-50 text-red-700 border border-red-200">
                          Ditolak
                        </span>
                      </template>
                    </div>

                    <!-- Tanggal Periode Mingguan -->
                    <p class="text-xs text-[#71717a] flex items-center gap-1.5 mt-0.5">
                      <i data-lucide="calendar" class="w-3.5 h-3.5 text-[#71717a]"></i>
                      <span x-text="`${entry.tanggalMulai} – ${entry.tanggalSelesai}`"></span>
                    </p>
                  </div>

                  <!-- Chevron Arrow Down -->
                  <div class="p-1 text-[#71717a]">
                    <i
                      data-lucide="chevron-down"
                      class="h-5 w-5 transition-transform duration-200"
                      :class="openWeeks[entry.minggu] ? 'rotate-180' : ''"
                    ></i>
                  </div>
                </div>

                <!-- Collapsible Content (Bersih & Ringkas: Uraian Singkat + Tombol Aksi) -->
                <div x-show="openWeeks[entry.minggu]" class="border-t border-[#e4e4e7]">
                  <div class="p-4 space-y-3">
                    <!-- Ringkasan Uraian Logbook Mingguan -->
                    <p class="text-gray-800 text-sm leading-relaxed" x-text="entry.deskripsi"></p>

                    <!-- Footer Action Bar: Tombol LIHAT DETAIL, DOKUMEN & AKSI REVIEW DOSEN -->
                    <div class="flex justify-between items-center pt-2 border-t border-[#f4f4f5] flex-wrap gap-2">
                      <div class="flex items-center gap-2 flex-wrap">
                        <!-- Tombol LIHAT DETAIL (Primary CTA Fill Biru) -->
                        <button
                          type="button"
                          @click="openDetailModal(entry)"
                          class="inline-flex items-center justify-center h-8 px-3 rounded-md text-xs font-medium bg-[#0655a7] hover:bg-[#054487] text-white transition-colors shadow-xs"
                        >
                          <i data-lucide="eye" class="mr-1.5 h-3.5 w-3.5"></i>
                          Lihat Detail
                        </button>

                        <!-- Tombol Lihat Dokumen (Google Drive) -->
                        <a
                          :href="entry.buktiLink"
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex items-center justify-center h-8 px-3 rounded-md text-xs font-medium border border-[#e4e4e7] bg-white hover:bg-[#f4f4f5] text-[#09090b] transition-colors"
                        >
                          <i data-lucide="file-text" class="mr-1.5 h-3.5 w-3.5 text-[#71717a]"></i>
                          Lihat Dokumen
                        </a>
                      </div>

                      <!-- Tombol Dosen (Tolak & Terima) -->
                      <div class="flex gap-1.5">
                        <template x-if="entry.status === 'Perlu Review'">
                          <div class="flex items-center gap-1.5">
                            <button
                              type="button"
                              @click="openActionModal(entry, 'rejected')"
                              class="inline-flex items-center h-8 px-3 rounded-md text-xs font-medium border border-red-200 text-red-600 hover:bg-red-50 hover:text-red-700 transition-colors"
                            >
                              <i data-lucide="x" class="h-3.5 w-3.5 mr-1"></i>
                              Tolak
                            </button>
                            <button
                              type="button"
                              @click="openActionModal(entry, 'accepted')"
                              class="inline-flex items-center h-8 px-3 rounded-md text-xs font-medium border border-green-200 text-green-600 hover:bg-green-50 hover:text-green-700 transition-colors"
                            >
                              <i data-lucide="check" class="h-3.5 w-3.5 mr-1"></i>
                              Terima
                            </button>
                          </div>
                        </template>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </template>
      </div>
    </div>

    <!-- MODAL DETAIL TERPISAH: Rincian Lengkap Logbook (Kegiatan, Hasil, Lampiran Bukti) -->
    <div
      x-show="detailModalOpen"
      x-cloak
      class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/50 backdrop-blur-xs"
      @keydown.escape.window="closeDetailModal()"
    >
      <div
        class="bg-white rounded-lg border border-[#e4e4e7] max-w-2xl w-full max-h-[85vh] flex flex-col shadow-2xl overflow-hidden"
        @click.outside="closeDetailModal()"
      >
        <!-- Modal Header -->
        <div class="px-6 py-4 border-b border-[#e4e4e7] flex items-center justify-between shrink-0 bg-[#fafafa]">
          <div class="flex items-center gap-3">
            <div class="size-8 rounded-full bg-blue-50 border border-blue-200 text-[#0655a7] font-semibold text-xs flex items-center justify-center">
              <span x-text="activeDetailEntry?.minggu"></span>
            </div>
            <div>
              <h3 class="text-base font-semibold text-[#09090b]">
                Detail Logbook Minggu ke-<span x-text="activeDetailEntry?.minggu"></span>
              </h3>
            </div>
          </div>

          <div class="flex items-center gap-2">
            <template x-if="activeDetailEntry?.status === 'Disetujui'">
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                Diterima
              </span>
            </template>
            <template x-if="activeDetailEntry?.status === 'Perlu Review'">
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-200">
                Menunggu Review
              </span>
            </template>
            <template x-if="activeDetailEntry?.status === 'Ditolak'">
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-red-50 text-red-700 border border-red-200">
                Ditolak
              </span>
            </template>
            <button
              type="button"
              @click="closeDetailModal()"
              class="h-7 w-7 ml-2 flex items-center justify-center rounded-md border border-[#e4e4e7] text-[#71717a] hover:text-[#09090b] hover:bg-white transition-colors"
            >
              <i data-lucide="x" class="w-4 h-4"></i>
            </button>
          </div>
        </div>

        <!-- Modal Scrollable Content: Format Flat Editorial Bersih (Tanpa Box / Card Bersarang) -->
        <div class="p-6 overflow-y-auto flex-1 text-left">
          <!-- 1. KEGIATAN -->
          <div>
            <h4 class="text-xs font-semibold uppercase tracking-wider text-[#71717a] mb-2.5">
              Kegiatan
            </h4>
            <ul class="list-disc pl-5 space-y-2 text-sm text-[#09090b] leading-relaxed">
              <template x-for="item in (activeDetailEntry?.kegiatan || [activeDetailEntry?.deskripsi])" :key="item">
                <li x-text="item"></li>
              </template>
            </ul>
          </div>

          <!-- Divider Halus -->
          <div class="border-t border-[#e4e4e7] my-5"></div>

          <!-- 2. HASIL -->
          <div>
            <h4 class="text-xs font-semibold uppercase tracking-wider text-[#71717a] mb-2.5">
              Hasil
            </h4>
            <ul class="list-disc pl-5 space-y-2 text-sm text-[#09090b] leading-relaxed">
              <template x-for="item in (activeDetailEntry?.hasil || ['Menuntaskan seluruh target capaian dan deliverables mingguan.'])" :key="item">
                <li x-text="item"></li>
              </template>
            </ul>
          </div>

          <!-- Divider Halus & 3. LAMPIRAN BUKTI (Link Bersih) -->
          <template x-if="activeDetailEntry?.lampiran && activeDetailEntry?.lampiran.length > 0">
            <div>
              <div class="border-t border-[#e4e4e7] my-5"></div>
              <div>
                <h4 class="text-xs font-semibold uppercase tracking-wider text-[#71717a] mb-2.5">
                  Lampiran Bukti / Sertifikat
                </h4>
                <div class="flex flex-col gap-2">
                  <template x-for="(lamp, lIdx) in activeDetailEntry?.lampiran" :key="lIdx">
                    <button
                      type="button"
                      @click="openPreview(lamp.gambarUrl, lamp.judul)"
                      class="inline-flex items-center gap-2 text-sm text-[#0655a7] hover:underline cursor-pointer py-0.5 text-left w-fit"
                    >
                      <i data-lucide="file-text" class="w-4 h-4 text-[#71717a] shrink-0"></i>
                      <span class="font-medium" x-text="lamp.judul"></span>
                      <span class="text-xs text-[#71717a]">(Lihat Pratinjau)</span>
                    </button>
                  </template>
                </div>
              </div>
            </div>
          </template>

          <!-- Divider Halus & 4. CATATAN PEMBIMBING -->
          <template x-if="activeDetailEntry?.catatanDosen && activeDetailEntry?.catatanDosen.trim().length > 0">
            <div>
              <div class="border-t border-[#e4e4e7] my-5"></div>
              <div>
                <h4 class="text-xs font-semibold uppercase tracking-wider text-[#71717a] mb-2">
                  Catatan Pembimbing
                </h4>
                <p class="text-sm text-gray-700 italic leading-relaxed" x-text="activeDetailEntry?.catatanDosen"></p>
              </div>
            </div>
          </template>
        </div>

        <!-- Modal Footer: Hanya Tolak dan Terima Saja -->
        <div class="px-6 py-3.5 bg-[#fafafa] border-t border-[#e4e4e7] flex items-center justify-end shrink-0 gap-2.5">
          <button
            type="button"
            @click="closeDetailModal(); openActionModal(activeDetailEntry, 'rejected')"
            class="inline-flex items-center justify-center h-8 px-4 rounded-md text-xs font-medium border border-red-200 text-red-600 hover:bg-red-50 hover:text-red-700 transition-colors"
          >
            <i data-lucide="x" class="h-3.5 w-3.5 mr-1.5"></i>
            Tolak
          </button>
          <button
            type="button"
            @click="closeDetailModal(); openActionModal(activeDetailEntry, 'accepted')"
            class="inline-flex items-center justify-center h-8 px-4 rounded-md text-xs font-medium bg-[#0655a7] hover:bg-[#054487] text-white transition-colors shadow-xs"
          >
            <i data-lucide="check" class="h-3.5 w-3.5 mr-1.5"></i>
            Terima
          </button>
        </div>
      </div>
    </div>

    <!-- Modal Konfirmasi Terima / Tolak (Parity dengan AlertDialog di KP) -->
    <div
      x-show="modalOpen"
      x-cloak
      class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/40"
      @keydown.escape.window="closeModal()"
    >
      <div
        class="bg-white rounded-lg border border-[#e4e4e7] max-w-md w-full p-6 shadow-xl space-y-4"
        @click.outside="closeModal()"
      >
        <div>
          <h3 class="text-base font-semibold text-[#09090b]">
            <span x-text="modalType === 'accepted' ? 'Setujui Logbook' : 'Tolak Logbook'"></span>
            Minggu <span x-text="selectedEntry?.minggu"></span>
          </h3>
          <p class="text-xs text-[#71717a] mt-1">
            <span x-text="modalType === 'accepted' ? 'Apakah Anda yakin ingin menyetujui logbook bimbingan minggu ini?' : 'Tuliskan catatan evaluasi atau alasan penolakan untuk mahasiswa.'"></span>
          </p>
        </div>

        <div>
          <label class="block text-xs font-medium text-[#09090b] mb-1.5">
            Catatan Pembimbing (Opsional)
          </label>
          <textarea
            x-model="feedbackNote"
            rows="3"
            placeholder="Tulis catatan evaluasi untuk mahasiswa..."
            class="w-full text-xs rounded-md border border-[#e4e4e7] p-2.5 text-[#09090b] focus:outline-none focus:border-[#0655a7]"
          ></textarea>
        </div>

        <div class="flex justify-end gap-2 pt-2">
          <button
            type="button"
            @click="closeModal()"
            class="h-8 px-3 rounded-md text-xs font-medium border border-[#e4e4e7] bg-white text-[#71717a] hover:bg-[#f4f4f5] transition-colors"
          >
            Batal
          </button>
          <button
            type="button"
            @click="submitAction()"
            :class="modalType === 'accepted' ? 'bg-[#0655a7] text-white hover:bg-[#054487]' : 'bg-red-600 text-white hover:bg-red-700'"
            class="h-8 px-4 rounded-md text-xs font-medium transition-colors shadow-sm"
          >
            <span x-text="modalType === 'accepted' ? 'Konfirmasi Terima' : 'Konfirmasi Tolak'"></span>
          </button>
        </div>
      </div>
    </div>

    <!-- Lightbox Modal Preview Sertifikat / Bukti -->
    <div
      x-show="previewModalOpen"
      x-cloak
      class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60"
      @keydown.escape.window="closePreview()"
    >
      <div
        class="bg-white rounded-lg border border-[#e4e4e7] max-w-2xl w-full p-4 shadow-2xl space-y-3"
        @click.outside="closePreview()"
      >
        <div class="flex items-center justify-between border-b border-[#e4e4e7] pb-2">
          <h4 class="text-sm font-semibold text-[#09090b]" x-text="previewTitle"></h4>
          <button
            type="button"
            @click="closePreview()"
            class="h-7 w-7 flex items-center justify-center rounded-md border border-[#e4e4e7] text-[#71717a] hover:text-[#09090b]"
          >
            <i data-lucide="x" class="w-4 h-4"></i>
          </button>
        </div>
        <div class="bg-[#fafafa] rounded-md p-2 flex items-center justify-center max-h-[70vh] overflow-hidden">
          <img :src="previewImage" :alt="previewTitle" class="max-h-[65vh] w-auto object-contain rounded" />
        </div>
      </div>
    </div>

    <!-- Toast Notification (Parity dengan react-hot-toast di KP) -->
    <div
      x-show="showToast"
      x-cloak
      x-transition:enter="transition ease-out duration-200"
      x-transition:enter-start="opacity-0 translate-y-2"
      x-transition:enter-end="opacity-100 translate-y-0"
      x-transition:leave="transition ease-in duration-150"
      x-transition:leave-start="opacity-100 translate-y-0"
      x-transition:leave-end="opacity-0 translate-y-2"
      class="fixed bottom-6 right-6 z-50 flex items-center gap-2 px-4 py-3 rounded-lg shadow-lg text-xs font-medium text-white"
      :class="toastType === 'success' ? 'bg-emerald-600' : 'bg-amber-600'"
    >
      <i data-lucide="check-circle" class="w-4 h-4"></i>
      <span x-text="toastMessage"></span>
    </div>
  </div>
</DosenShell>
