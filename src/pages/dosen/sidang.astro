---
// src/pages/dosen/sidang.astro
import DosenShell from '../../layouts/DosenShell.astro';

// Data jadwal sidang MBKM (100% selaras dengan struktur Kerja Praktek)
const jadwalSidang = [
  {
    id: 1,
    nama: "Wanda Putri Lestari",
    nim: "A11.2023.15257",
    pembimbing: "Adhitya Nugraha, M.Kom",
    nilaiPenyelia: 85,          // nilai dari mitra (wewenang koor/mitra, disabled bagi dosen)
    nilaiPembimbing: "",        // nilai Pembimbing & Penguji 1, editable oleh dosen pembimbing
    nilaiPenguji2: 78,          // diisi koordinator
  },
  {
    id: 2,
    nama: "Evan William Setyawan",
    nim: "A11.2023.15006",
    pembimbing: "Adhitya Nugraha, M.Kom",
    nilaiPenyelia: 80,
    nilaiPembimbing: "85",
    nilaiPenguji2: 82,
  }
];

const jadwalJson = JSON.stringify(jadwalSidang);
---

<DosenShell
  activeNav="sidang"
  breadcrumb="Sidang"
  pageTitle="Sidang"
  subtitle="Daftar jadwal sidang evaluasi MBKM yang telah diplot oleh Koordinator."
>
  <div
    class="w-full flex flex-col"
    x-data={`{
      search: '',
      previewTtdOpen: false,
      tambahTtdOpen: false,
      jadwalList: ${jadwalJson},

      get filteredJadwal() {
        if (!this.search.trim()) return this.jadwalList;
        const q = this.search.toLowerCase();
        return this.jadwalList.filter(j =>
          j.nama.toLowerCase().includes(q) ||
          j.nim.toLowerCase().includes(q) ||
          (j.pembimbing && j.pembimbing.toLowerCase().includes(q))
        );
      },

      calcRowNilaiAkhir(item) {
        const p = parseFloat(item.nilaiPembimbing);
        const penyelia = parseFloat(item.nilaiPenyelia);
        const u2 = parseFloat(item.nilaiPenguji2);
        const values = [penyelia, p, u2].filter(v => !isNaN(v));
        if (!values.length) return '-';
        return (values.reduce((a, b) => a + b, 0) / values.length).toFixed(2);
      },

      isComplete(item) {
        const p = parseFloat(item.nilaiPembimbing);
        return !isNaN(p) && item.nilaiPenyelia != null && item.nilaiPenguji2 != null;
      }
    }`}
  >
    <!-- Top Action Row: Search Input on Left, Action Buttons on Right (Sesuai Persis Kerja Praktek) -->
    <div class="flex flex-col sm:flex-row gap-2 sm:gap-4 mb-4 items-stretch sm:items-center justify-between">
      <!-- Search Input -->
      <div class="relative w-full sm:w-80 md:w-96">
        <div class="absolute left-3 top-1/2 transform -translate-y-1/2 flex items-center pointer-events-none text-[#71717a]">
          <i data-lucide="search" class="w-4 h-4"></i>
        </div>
        <input
          type="text"
          x-model="search"
          placeholder="Cari berdasarkan nama, NIM, atau judul..."
          class="w-full pl-10 pr-4 h-10 border border-[#e4e4e7] rounded-md text-sm bg-white placeholder-[#71717a] text-[#09090b] focus:outline-none focus:ring-1 focus:ring-[#0655a7] focus:border-[#0655a7] transition-all"
        />
      </div>

      <!-- Action Buttons TTD (Sesuai ttd-dosen-actions.tsx di kerja-praktek) -->
      <div class="flex items-center gap-2 ml-auto flex-wrap">
        <button
          type="button"
          @click="previewTtdOpen = true"
          class="inline-flex items-center justify-center gap-2 h-10 px-4 rounded-md bg-[#0655a7] hover:bg-[#05468b] text-white text-sm font-medium transition-colors shadow-none cursor-pointer"
        >
          <i data-lucide="eye" class="w-4 h-4"></i>
          <span>Preview TTD Dosen</span>
        </button>

        <button
          type="button"
          @click="tambahTtdOpen = true"
          class="inline-flex items-center justify-center gap-2 h-10 px-4 rounded-md bg-[#0655a7] hover:bg-[#05468b] text-white text-sm font-medium transition-colors shadow-none cursor-pointer"
        >
          <i data-lucide="plus" class="w-4 h-4"></i>
          <span>Tambah TTD Dosen</span>
        </button>
      </div>
    </div>

    <!-- Tabel 100% Sesuai DataTable & Columns Kerja Praktek -->
    <div class="rounded-md border border-[#e4e4e7] bg-white overflow-hidden shadow-none">
      <div class="overflow-x-auto">
        <table class="w-full text-sm text-left border-collapse min-w-[1050px]">
          <thead>
            <tr class="border-b border-[#e4e4e7] bg-transparent text-[#71717a] h-10">
              <th class="w-[50px] px-2 text-center text-sm font-medium">No</th>
              <th class="min-w-[200px] max-w-[260px] px-2 text-left text-sm font-medium">Mahasiswa</th>
              <th class="min-w-[180px] max-w-[240px] px-2 text-left text-sm font-medium">Pembimbing</th>
              <th class="min-w-[130px] px-2 text-center text-sm font-medium">Nilai Penyelia</th>
              <th class="min-w-[130px] px-2 text-center text-sm font-medium">Nilai Pembimbing & Penguji 1</th>
              <th class="min-w-[130px] px-2 text-center text-sm font-medium">Nilai Penguji 2</th>
              <th class="min-w-[110px] px-2 text-center text-sm font-medium">Nilai Akhir</th>
              <th class="min-w-[140px] px-2 text-center text-sm font-medium">Status</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#e4e4e7]">
            <template x-for="(row, idx) in filteredJadwal" :key="row.id">
              <tr class="hover:bg-[#f4f4f5]/60 transition-colors">
                <!-- No -->
                <td class="p-2 text-center text-sm text-[#71717a]" x-text="idx + 1"></td>

                <!-- Mahasiswa (nama & nim truncate) -->
                <td class="p-2 min-w-[200px] max-w-[260px]">
                  <div class="font-medium text-sm text-[#09090b] truncate" x-text="row.nama"></div>
                  <div class="text-sm text-[#71717a]" x-text="row.nim"></div>
                </td>

                <!-- Pembimbing -->
                <td class="p-2 min-w-[180px] max-w-[240px] text-sm text-[#09090b]" x-text="row.pembimbing"></td>


                <!-- Nilai Penyelia (Disabled Input w-24 persis KP) -->
                <td class="p-2">
                  <div class="flex justify-center min-w-[90px]">
                    <input
                      type="text"
                      disabled
                      :value="row.nilaiPenyelia ?? '-'"
                      class="h-8 min-w-[4rem] w-24 px-2 text-center tabular-nums text-sm border border-[#e4e4e7] rounded-md bg-white disabled:cursor-not-allowed disabled:opacity-50 text-[#09090b]"
                      placeholder="-"
                    />
                  </div>
                </td>

                <!-- Nilai Pembimbing & Penguji 1 (Editable Input w-24 tanpa spinbutton persis KP) -->
                <td class="p-2">
                  <div class="flex justify-center min-w-[90px]">
                    <input
                      type="text"
                      inputmode="numeric"
                      pattern="[0-9]*"
                      x-model="row.nilaiPembimbing"
                      class="h-8 min-w-[4rem] w-24 px-2 text-center tabular-nums text-sm border border-[#e4e4e7] rounded-md bg-white text-[#09090b] focus:outline-none focus:ring-1 focus:ring-[#0655a7] focus:border-[#0655a7] transition-all [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none"
                      placeholder="-"
                    />
                  </div>
                </td>

                <!-- Nilai Penguji 2 (Disabled Input w-24 persis KP) -->
                <td class="p-2">
                  <div class="flex justify-center min-w-[90px]">
                    <input
                      type="text"
                      disabled
                      :value="row.nilaiPenguji2 ?? '-'"
                      class="h-8 min-w-[4rem] w-24 px-2 text-center tabular-nums text-sm border border-[#e4e4e7] rounded-md bg-white disabled:cursor-not-allowed disabled:opacity-50 text-[#09090b]"
                      placeholder="-"
                    />
                  </div>
                </td>

                <!-- Nilai Akhir (Kalkulasi 2 Desimal Persis KP) -->
                <td class="p-2">
                  <div class="text-center font-medium text-sm text-[#09090b] min-w-[90px]" x-text="calcRowNilaiAkhir(row)"></div>
                </td>

                <!-- Status (Badge variant: success / secondary Persis KP) -->
                <td class="p-2">
                  <div class="flex justify-center min-w-[120px]">
                    <template x-if="isComplete(row)">
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-xs font-semibold bg-green-100 text-green-700 border border-green-300">
                        Selesai
                      </span>
                    </template>
                    <template x-if="!isComplete(row)">
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-200">
                        Belum
                      </span>
                    </template>
                  </div>
                </td>
              </tr>
            </template>
          </tbody>
        </table>

        <!-- Empty state -->
        <div x-show="filteredJadwal.length === 0" class="py-16 text-center">
          <div class="w-12 h-12 rounded-lg bg-[#fafafa] border border-[#e4e4e7] flex items-center justify-center text-[#71717a] mx-auto mb-3">
            <i data-lucide="calendar-check" class="w-6 h-6 stroke-[1.5]"></i>
          </div>
          <h3 class="text-sm font-semibold text-[#09090b]">Belum Ada Hasil Sidang</h3>
          <p class="text-xs text-[#71717a] mt-1">Data sidang akan muncul setelah jadwal dipasang di menu Plotting Jadwal.</p>
        </div>
      </div>
    </div>

    <!-- Pagination Controls (Sesuai Persis components/pagination-control.tsx di fakultas-fe) -->
    <div class="pt-4 bg-white">
      <div class="flex flex-col md:flex-row items-center justify-between gap-4">
        <span class="text-sm text-[#71717a]" x-text="`Page 1 of 1 (${filteredJadwal.length} total items)`"></span>

        <div class="flex gap-4 items-center">
          <div class="flex items-center gap-1">
            <button
              type="button"
              disabled
              class="h-9 w-9 inline-flex items-center justify-center rounded-md border border-[#e4e4e7] bg-white text-[#71717a] opacity-50 cursor-not-allowed"
            >
              <i data-lucide="chevron-left" class="w-4 h-4"></i>
            </button>
            <button
              type="button"
              class="h-9 w-9 inline-flex items-center justify-center rounded-md bg-[#0655a7] text-white text-sm font-medium shadow-none"
            >
              1
            </button>
            <button
              type="button"
              disabled
              class="h-9 w-9 inline-flex items-center justify-center rounded-md border border-[#e4e4e7] bg-white text-[#71717a] opacity-50 cursor-not-allowed"
            >
              <i data-lucide="chevron-right" class="w-4 h-4"></i>
            </button>
          </div>
          <div class="inline-flex items-center justify-between w-[145px] h-10 px-3 bg-white border border-[#e4e4e7] rounded-md text-sm text-[#09090b]">
            <span>Show 10 items</span>
            <i data-lucide="chevron-down" class="w-4 h-4 text-[#71717a]"></i>
          </div>
        </div>
      </div>
    </div>

    <!-- Modal Dialog Preview TTD Dosen -->
    <div
      x-show="previewTtdOpen"
      x-cloak
      class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/50"
      @click.self="previewTtdOpen = false"
    >
      <div class="bg-white rounded-xl shadow-lg border border-[#e2e8f0] w-full max-w-md p-6">
        <div class="flex justify-between items-center mb-4 pb-2 border-b border-[#e2e8f0]">
          <h3 class="text-base font-semibold text-[#0f172a]">Preview Tanda Tangan Dosen</h3>
          <button @click="previewTtdOpen = false" class="text-slate-400 hover:text-slate-600">
            <i data-lucide="x" class="w-4 h-4"></i>
          </button>
        </div>
        <div class="flex flex-col items-center justify-center p-6 border border-dashed border-slate-300 rounded-lg bg-slate-50">
          <div class="h-32 flex items-center justify-center">
            <span class="font-serif italic text-3xl text-slate-700 font-bold select-none">Adhitya Nugraha</span>
          </div>
          <p class="text-xs text-slate-500 mt-2">Tanda tangan digital tersimpan di sistem.</p>
        </div>
        <div class="mt-4 flex justify-end">
          <button
            type="button"
            @click="previewTtdOpen = false"
            class="px-4 py-2 text-xs font-medium rounded-md bg-[#0655a7] text-white hover:bg-[#05468b]"
          >
            Tutup
          </button>
        </div>
      </div>
    </div>

    <!-- Modal Dialog Tambah TTD Dosen -->
    <div
      x-show="tambahTtdOpen"
      x-cloak
      class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/50"
      @click.self="tambahTtdOpen = false"
    >
      <div class="bg-white rounded-xl shadow-lg border border-[#e2e8f0] w-full max-w-md p-6">
        <div class="flex justify-between items-center mb-4 pb-2 border-b border-[#e2e8f0]">
          <h3 class="text-base font-semibold text-[#0f172a]">Unggah Tanda Tangan Dosen</h3>
          <button @click="tambahTtdOpen = false" class="text-slate-400 hover:text-slate-600">
            <i data-lucide="x" class="w-4 h-4"></i>
          </button>
        </div>
        <div class="space-y-4">
          <p class="text-xs text-slate-600">
            Unggah berkas gambar tanda tangan berlatar belakang transparan (format PNG disarankan).
          </p>
          <div class="border-2 border-dashed border-slate-300 rounded-lg p-6 text-center hover:bg-slate-50 cursor-pointer">
            <i data-lucide="upload-cloud" class="w-8 h-8 text-slate-400 mx-auto mb-2"></i>
            <span class="text-xs text-slate-600 block">Klik atau seret file gambar ke sini</span>
            <span class="text-[10px] text-slate-400 block mt-1">PNG, JPG maksimal 2MB</span>
          </div>
        </div>
        <div class="mt-6 flex justify-end gap-2">
          <button
            type="button"
            @click="tambahTtdOpen = false"
            class="px-4 py-2 text-xs font-medium rounded-md border border-slate-300 text-slate-700 hover:bg-slate-50"
          >
            Batal
          </button>
          <button
            type="button"
            @click="tambahTtdOpen = false"
            class="px-4 py-2 text-xs font-medium rounded-md bg-[#0655a7] text-white hover:bg-[#05468b]"
          >
            Simpan TTD
          </button>
        </div>
      </div>
    </div>
  </div>
</DosenShell>
