---
// src/pages/dosen/sidang.astro
import DosenShell from '../../layouts/DosenShell.astro';

// Data pengajuan sidang mahasiswa
const pengajuanList = [
  {
    id: 1,
    nama: "WANDA PUTRI LESTARI",
    nim: "A11.2023.15257",
    judul: "PENGEMBANGAN SISTEM INFORMASI AKADEMIK FAKULTAS BERBASIS CLOUD",
    gelombang: "Gelombang 1 - 2026/2027 Gasal",
    tanggal: "18 Oktober 2026",
    status: "Menunggu Penjadwalan"
  },
  {
    id: 2,
    nama: "EVAN WILLIAM SETYAWAN",
    nim: "A11.2023.15006",
    judul: "IMPLEMENTASI ARSITEKTUR MICROSERVICES PADA PLATFORM MBKM",
    gelombang: "Gelombang 1 - 2026/2027 Gasal",
    tanggal: "15 Oktober 2026",
    status: "Menunggu Penjadwalan"
  }
];

const pengajuanJson = JSON.stringify(pengajuanList);
---

<DosenShell
  activeNav="sidang"
  breadcrumb="Sidang"
  pageTitle="Sidang"
  subtitle="Kelola data pengajuan dan hasil sidang MBKM."
>
  <div
    class="w-full flex flex-col"
    x-data={`{
      activeTab: 'hasil',
      search: '',
      previewTtdOpen: false,
      tambahTtdOpen: false,
      pengajuanList: ${pengajuanJson},
      get filteredPengajuan() {
        if (!this.search.trim()) return this.pengajuanList;
        const q = this.search.toLowerCase();
        return this.pengajuanList.filter(p =>
          p.nama.toLowerCase().includes(q) ||
          p.nim.toLowerCase().includes(q) ||
          p.judul.toLowerCase().includes(q)
        );
      }
    }`}
  >
    <!-- Top Action Row: Search Input on Left, Action Buttons on Right (Persis Screenshot 1) -->
    <div class="flex flex-col sm:flex-row gap-4 mb-4 items-stretch sm:items-center justify-between">
      <!-- Search Input -->
      <div class="relative w-full sm:w-80 md:w-96">
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-[#94a3b8]">
          <i data-lucide="search" class="w-4 h-4"></i>
        </div>
        <input
          type="text"
          x-model="search"
          placeholder="Cari berdasarkan nama, NIM, atau judul..."
          class="w-full pl-9 pr-4 py-2 border border-[#e2e8f0] rounded-md text-sm bg-white placeholder-[#94a3b8] text-[#0f172a] focus:outline-none focus:border-blue-500"
        />
      </div>

      <!-- Action Buttons TTD (Persis Screenshot 1) -->
      <div class="flex items-center gap-2 flex-wrap">
        <button
          type="button"
          @click="previewTtdOpen = true"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-[#0655a7] hover:bg-[#05468b] text-white text-sm font-medium transition-colors shadow-none"
        >
          <i data-lucide="eye" class="w-4 h-4"></i>
          <span>Preview TTD Dosen</span>
        </button>

        <button
          type="button"
          @click="tambahTtdOpen = true"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-[#0655a7] hover:bg-[#05468b] text-white text-sm font-medium transition-colors shadow-none"
        >
          <i data-lucide="plus" class="w-4 h-4"></i>
          <span>Tambah TTD Dosen</span>
        </button>
      </div>
    </div>

    <!-- Tab Bar: Data Pengajuan & Hasil (Persis CustomTabs di Screenshot 1) -->
    <div class="w-full border-b border-[#e2e8f0] mb-6">
      <div class="flex overflow-x-auto gap-2">
        <!-- Tab 1: Data Pengajuan -->
        <button
          type="button"
          @click="activeTab = 'pengajuan'"
          :class="activeTab === 'pengajuan' ? 'text-[#0655a7] border-b-2 border-[#0655a7]' : 'text-[#64748b] hover:text-[#0655a7]'"
          class="flex items-center gap-2 px-4 py-2 text-sm font-medium transition-colors relative -mb-px"
        >
          <i data-lucide="file-text" class="w-4 h-4"></i>
          <span>Data Pengajuan</span>
        </button>

        <!-- Tab 2: Hasil (Default Active di Screenshot 1) -->
        <button
          type="button"
          @click="activeTab = 'hasil'"
          :class="activeTab === 'hasil' ? 'text-[#0655a7] border-b-2 border-[#0655a7]' : 'text-[#64748b] hover:text-[#0655a7]'"
          class="flex items-center gap-2 px-4 py-2 text-sm font-medium transition-colors relative -mb-px"
        >
          <i data-lucide="calendar-check" class="w-4 h-4"></i>
          <span>Hasil</span>
        </button>
      </div>
    </div>

    <!-- Content Tab 1: Data Pengajuan -->
    <div x-show="activeTab === 'pengajuan'" x-cloak>
      <div class="rounded-md border border-[#e2e8f0] bg-white overflow-hidden shadow-none">
        <table class="w-full text-sm text-left border-collapse">
          <thead>
            <tr class="border-b border-[#e2e8f0] bg-white">
              <th class="w-12 px-4 py-3 text-xs font-medium text-[#64748b] text-center">No</th>
              <th class="px-4 py-3 text-xs font-medium text-[#64748b]">Mahasiswa</th>
              <th class="px-4 py-3 text-xs font-medium text-[#64748b] text-center">NIM</th>
              <th class="px-4 py-3 text-xs font-medium text-[#64748b]">Judul Laporan</th>
              <th class="px-4 py-3 text-xs font-medium text-[#64748b] text-center">Gelombang</th>
              <th class="px-4 py-3 text-xs font-medium text-[#64748b] text-center">Status</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#e2e8f0]">
            <template x-for="(item, idx) in filteredPengajuan" :key="item.id">
              <tr class="hover:bg-slate-50/50 transition-colors">
                <td class="px-4 py-3 text-xs text-[#64748b] text-center" x-text="idx + 1"></td>
                <td class="px-4 py-3 font-medium text-sm text-[#0f172a]" x-text="item.nama"></td>
                <td class="px-4 py-3 text-center text-sm text-[#0f172a]" x-text="item.nim"></td>
                <td class="px-4 py-3 text-sm text-[#0f172a]" x-text="item.judul"></td>
                <td class="px-4 py-3 text-center text-xs text-[#64748b]" x-text="item.gelombang"></td>
                <td class="px-4 py-3 text-center">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-xs font-medium bg-[#fef3c7] text-[#b45309] border border-[#fde68a]" x-text="item.status"></span>
                </td>
              </tr>
            </template>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Content Tab 2: Hasil (Persis Screenshot 1: EmptyState) -->
    <div x-show="activeTab === 'hasil'">
      <div class="flex flex-col items-center justify-center py-28 text-center">
        <div class="w-12 h-12 rounded-lg bg-slate-100 flex items-center justify-center text-slate-400 mb-3">
          <i data-lucide="calendar-check" class="w-6 h-6 stroke-[1.5]"></i>
        </div>
        <h3 class="text-base font-semibold text-[#0f172a]">
          Belum Ada Hasil Sidang
        </h3>
        <p class="text-xs text-[#64748b] mt-1 max-w-sm leading-relaxed">
          Data sidang akan muncul setelah jadwal dipasang di menu Plotting Jadwal.
        </p>
      </div>
    </div>

    <!-- Modal Dialog Preview TTD Dosen -->
    <div
      x-show="previewTtdOpen"
      x-cloak
      class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/50"
      @click.self="previewTtdOpen = false"
    >
      <div class="bg-white rounded-xl shadow-lg border border-[#e2e8f0] w-full max-w-md p-6">
        <div class="flex justify-between items-center mb-4 pb-2 border-b border-[#e2e8f0]">
          <h3 class="text-base font-semibold text-[#0f172a]">Preview Tanda Tangan Dosen</h3>
          <button @click="previewTtdOpen = false" class="text-slate-400 hover:text-slate-600">
            <i data-lucide="x" class="w-4 h-4"></i>
          </button>
        </div>
        <div class="flex flex-col items-center justify-center p-6 border border-dashed border-slate-300 rounded-lg bg-slate-50">
          <div class="h-32 flex items-center justify-center">
            <span class="font-serif italic text-3xl text-slate-700 font-bold select-none">Adhitya Nugraha</span>
          </div>
          <p class="text-xs text-slate-500 mt-2">Tanda tangan digital tersimpan di sistem.</p>
        </div>
        <div class="mt-4 flex justify-end">
          <button
            type="button"
            @click="previewTtdOpen = false"
            class="px-4 py-2 text-xs font-medium rounded-md bg-[#0655a7] text-white hover:bg-[#05468b]"
          >
            Tutup
          </button>
        </div>
      </div>
    </div>

    <!-- Modal Dialog Tambah TTD Dosen -->
    <div
      x-show="tambahTtdOpen"
      x-cloak
      class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/50"
      @click.self="tambahTtdOpen = false"
    >
      <div class="bg-white rounded-xl shadow-lg border border-[#e2e8f0] w-full max-w-md p-6">
        <div class="flex justify-between items-center mb-4 pb-2 border-b border-[#e2e8f0]">
          <h3 class="text-base font-semibold text-[#0f172a]">Unggah Tanda Tangan Dosen</h3>
          <button @click="tambahTtdOpen = false" class="text-slate-400 hover:text-slate-600">
            <i data-lucide="x" class="w-4 h-4"></i>
          </button>
        </div>
        <div class="space-y-4">
          <p class="text-xs text-slate-600">
            Unggah berkas gambar tanda tangan berlatar belakang transparan (format PNG disarankan).
          </p>
          <div class="border-2 border-dashed border-slate-300 rounded-lg p-6 text-center hover:bg-slate-50 cursor-pointer">
            <i data-lucide="upload-cloud" class="w-8 h-8 text-slate-400 mx-auto mb-2"></i>
            <span class="text-xs text-slate-600 block">Klik atau seret file gambar ke sini</span>
            <span class="text-[10px] text-slate-400 block mt-1">PNG, JPG maksimal 2MB</span>
          </div>
        </div>
        <div class="mt-6 flex justify-end gap-2">
          <button
            type="button"
            @click="tambahTtdOpen = false"
            class="px-4 py-2 text-xs font-medium rounded-md border border-slate-300 text-slate-700 hover:bg-slate-50"
          >
            Batal
          </button>
          <button
            type="button"
            @click="tambahTtdOpen = false"
            class="px-4 py-2 text-xs font-medium rounded-md bg-[#0655a7] text-white hover:bg-[#05468b]"
          >
            Simpan TTD
          </button>
        </div>
      </div>
    </div>
  </div>
</DosenShell>
