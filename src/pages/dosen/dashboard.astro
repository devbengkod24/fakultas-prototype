---
// src/pages/dosen/dashboard.astro
import DosenShell from '../../layouts/DosenShell.astro';

// Data disesuaikan persis dengan tampilan live KP (ADHITYA NUGRAHA)
const kuotaData = {
  total_kuota: 3,
  sisa_kuota: 0,
  total_pengajuan: 3,
  ajuan_diterima: 3
};

const cardKuotaData = [
  {
    title: "Total Kuota",
    count: kuotaData.total_kuota,
    icon: "graduation-cap",
    bg: "bg-blue-500/10",
    iconBg: "bg-blue-500/10 text-blue-500",
    titleColor: "text-blue-500",
  },
  {
    title: "Sisa Kuota",
    count: kuotaData.sisa_kuota,
    icon: "user",
    bg: "bg-orange-500/10",
    iconBg: "bg-orange-500/10 text-orange-500",
    titleColor: "text-orange-500",
  },
  {
    title: "Total Pengajuan",
    count: kuotaData.total_pengajuan,
    icon: "clipboard-list",
    bg: "bg-yellow-500/10",
    iconBg: "bg-yellow-500/10 text-yellow-500",
    titleColor: "text-yellow-500",
  },
  {
    title: "Jumlah Diterima",
    count: kuotaData.ajuan_diterima,
    icon: "check-circle",
    bg: "bg-green-500/10",
    iconBg: "bg-green-500/10 text-green-500",
    titleColor: "text-green-500",
  },
];

const logbookBabs = [
  { bab: "Bab 1", students: 0 },
  { bab: "Bab 2", students: 0 },
  { bab: "Bab 3", students: 0 },
  { bab: "Bab 4", students: 0 },
  { bab: "Bab 5", students: 0 },
];

const groupedActivities = [
  {
    date: "Kamis, 23 Juli 2026",
    logs: [
      {
        id: 1,
        lecture: "logbook_mbkm",
        activity: "Mahasiswa YOSEP ALVIN DIONIVIO memperbarui link folder MBKM",
        time: "22:36"
      },
      {
        id: 2,
        lecture: "logbook_mbkm",
        activity: "Mahasiswa YOSEP ALVIN DIONIVIO memperbarui link folder MBKM",
        time: "22:35"
      },
      {
        id: 3,
        lecture: "logbook_kp",
        activity: "Dosen ADHITYA NUGRAHA menerima logbook BAB 5 dari mahasiswa SINDU ADITYA JANADI",
        time: "03:41"
      }
    ]
  },
  {
    date: "Rabu, 15 Juli 2026",
    logs: []
  }
];
---

<DosenShell activeNav="dashboard">
  <!-- DashboardLayout: grid grid-cols-1 lg:grid-cols-12 gap-4 -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 w-full">

    <!-- ========================================================= -->
    <!-- SISI KIRI (span={8})                                      -->
    <!-- ========================================================= -->
    <div class="col-span-1 lg:col-span-8 flex flex-col">

      <!-- 1. DashboardDosenMenu: grid grid-cols-3 gap-4 -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <!-- Card 1: Mahasiswa Bimbingan -->
        <div class="text-sm rounded-md border border-[#e2e8f0] bg-white shadow-none">
          <div class="flex flex-row gap-4 p-4 pb-2">
            <div class="flex items-center">
              <i data-lucide="users" class="w-5 h-5 text-[#2563eb]"></i>
            </div>
            <div class="flex flex-col">
              <div class="font-semibold text-sm text-[#0f172a]">Mahasiswa Bimbingan</div>
              <div class="text-xs text-[#64748b] mt-1">Data Mahasiswa Bimbingan</div>
            </div>
          </div>
          <a href="/dosen/mahasiswa">
            <div class="flex justify-between p-2 px-4 bg-blue-500/5 items-center border-t border-[#f1f5f9]">
              <p class="text-[#2563eb] text-xs">View details</p>
              <i data-lucide="arrow-right" class="w-3.5 h-3.5 text-[#64748b]"></i>
            </div>
          </a>
        </div>

        <!-- Card 2: Logbook Mahasiswa -->
        <div class="text-sm rounded-md border border-[#e2e8f0] bg-white shadow-none">
          <div class="flex flex-row gap-4 p-4 pb-2">
            <div class="flex items-center">
              <i data-lucide="book-text" class="w-5 h-5 text-[#f59e0b]"></i>
            </div>
            <div class="flex flex-col">
              <div class="font-semibold text-sm text-[#0f172a]">Logbook Mahasiswa</div>
              <div class="text-xs text-[#64748b] mt-1">Progress Logbook Mahasiswa</div>
            </div>
          </div>
          <a href="/dosen/logbook">
            <div class="flex justify-between p-2 px-4 bg-blue-500/5 items-center border-t border-[#f1f5f9]">
              <p class="text-[#2563eb] text-xs">View details</p>
              <i data-lucide="arrow-right" class="w-3.5 h-3.5 text-[#64748b]"></i>
            </div>
          </a>
        </div>

        <!-- Card 3: Sidang -->
        <div class="text-sm rounded-md border border-[#e2e8f0] bg-white shadow-none">
          <div class="flex flex-row gap-4 p-4 pb-2">
            <div class="flex items-center">
              <i data-lucide="calendar-check" class="w-5 h-5 text-[#f97316]"></i>
            </div>
            <div class="flex flex-col">
              <div class="font-semibold text-sm text-[#0f172a]">Sidang</div>
              <div class="text-xs text-[#64748b] mt-1">Data Pengajuan & Hasil Sidang</div>
            </div>
          </div>
          <a href="/dosen/sidang">
            <div class="flex justify-between p-2 px-4 bg-blue-500/5 items-center border-t border-[#f1f5f9]">
              <p class="text-[#2563eb] text-xs">View details</p>
              <i data-lucide="arrow-right" class="w-3.5 h-3.5 text-[#64748b]"></i>
            </div>
          </a>
        </div>
      </div>

      <!-- 2. DashboardDosenLinkWa: Card className="mt-4 rounded-md" -->
      <div
        class="rounded-md border border-[#e2e8f0] bg-white mt-4 shadow-none"
        x-data="{
          isDialogOpen: false,
          linkWa: '',
          draftLinkWa: '',
          saveLink() {
            this.linkWa = this.draftLinkWa;
            this.isDialogOpen = false;
          }
        }"
      >
        <div class="flex flex-row gap-4 p-4 pb-2">
          <div class="flex items-center">
            <i data-lucide="message-circle" class="w-6 h-6 text-[#22c55e]"></i>
          </div>
          <div class="flex flex-col flex-1">
            <div class="flex items-center justify-between gap-2">
              <span class="font-semibold text-sm text-[#0f172a]">Link WhatsApp Group</span>
              <button
                type="button"
                @click="draftLinkWa = linkWa; isDialogOpen = true"
                class="h-8 w-8 p-0 border border-[#e2e8f0] rounded-md inline-flex items-center justify-center hover:bg-[#f8fafc] text-[#64748b] hover:text-[#0f172a] transition-colors"
                title="Edit Link WhatsApp"
              >
                <i data-lucide="edit" class="h-4 w-4"></i>
              </button>
            </div>
            <div class="text-xs text-[#64748b] mt-1">
              Link grup WhatsApp untuk mahasiswa bimbingan
            </div>
          </div>
        </div>
        <div class="p-4 pt-2">
          <div class="rounded-md border border-[#e2e8f0] bg-[#f8fafc] px-3 py-2 text-sm text-[#94a3b8] break-all">
            <span x-text="linkWa || 'Link belum ditambahkan'"></span>
          </div>
        </div>

        <!-- Dialog Modal Edit Link WA -->
        <div
          x-show="isDialogOpen"
          x-cloak
          class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4"
        >
          <div
            @click.away="isDialogOpen = false"
            class="w-full max-w-md rounded-lg bg-white p-6 shadow-xl space-y-4"
          >
            <div class="space-y-1">
              <h3 class="text-lg font-semibold text-[#0f172a]">Edit Link WhatsApp Group</h3>
              <p class="text-xs text-[#64748b]">Perbarui tautan grup koordinasi bimbingan mahasiswa.</p>
            </div>
            <div class="space-y-2">
              <label for="inputWa" class="text-sm font-medium text-[#0f172a]">URL WhatsApp Group</label>
              <input
                id="inputWa"
                type="url"
                x-model="draftLinkWa"
                placeholder="Tempel link WhatsApp di sini"
                class="w-full rounded-md border border-[#e2e8f0] px-3 py-2 text-sm focus:border-blue-500 focus:outline-none"
              />
            </div>
            <div class="flex justify-end gap-2 pt-2">
              <button
                type="button"
                @click="isDialogOpen = false"
                class="px-4 py-2 border border-[#e2e8f0] text-sm font-medium rounded-md hover:bg-gray-50 text-[#0f172a]"
              >
                Batal
              </button>
              <button
                type="button"
                @click="saveLink()"
                class="px-4 py-2 bg-[#2563eb] text-white text-sm font-medium rounded-md hover:bg-[#1d4ed8]"
              >
                OK
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- 3. Grid 2 Kolom: Chart Logbook & Jadwal Sidang (mt-3) -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mt-3">

        <!-- Chart Logbook: Card className="rounded-md" -->
        <div class="rounded-md border border-[#e2e8f0] bg-white shadow-none">
          <div class="p-4 pb-2">
            <div class="font-semibold text-base text-[#0f172a]">Logbook Mahasiswa</div>
            <div class="text-sm text-[#64748b] mt-1">
              Jumlah mahasiswa yang mengisi logbook per bab
            </div>
          </div>
          <div class="p-4">
            <div class="h-64 w-full flex flex-col justify-end">
              <!-- Recharts Empty / Base Grid Area -->
              <div class="flex-1 flex flex-col justify-between py-2 border-b border-[#e2e8f0]">
                <div class="w-full border-b border-dashed border-[#e2e8f0]/80"></div>
                <div class="w-full border-b border-dashed border-[#e2e8f0]/80"></div>
                <div class="w-full border-b border-dashed border-[#e2e8f0]/80"></div>
                <div class="w-full border-b border-dashed border-[#e2e8f0]/80"></div>
                <!-- Zero values above axis -->
                <div class="flex justify-between items-end gap-3 px-3 pt-4">
                  {logbookBabs.map((item) => (
                    <div class="flex-1 flex flex-col items-center">
                      <span class="text-xs text-[#0f172a] font-normal mb-1">{item.students}</span>
                      <div class="w-full max-w-[42px] h-[2px] bg-transparent"></div>
                    </div>
                  ))}
                </div>
              </div>
              <!-- XAxis Labels -->
              <div class="flex justify-between gap-3 px-3 pt-2 text-xs text-[#64748b]">
                {logbookBabs.map((item) => (
                  <div class="flex-1 text-center">{item.bab}</div>
                ))}
              </div>
            </div>
          </div>
        </div>

        <!-- Jadwal Sidang Mendatang: Card className="shadow-none border" -->
        <div class="rounded-md border border-[#e2e8f0] bg-white shadow-none flex flex-col">
          <div class="p-4 pb-2">
            <div class="flex items-center gap-2 text-base font-semibold text-[#0f172a]">
              <i data-lucide="calendar" class="h-5 w-5 text-[#0f172a]"></i>
              <span>Jadwal Sidang Mendatang</span>
            </div>
            <div class="text-sm text-[#64748b] mt-1">
              Sidang MBKM yang akan datang (peran dosen: pembimbing/penguji)
            </div>
          </div>
          <!-- Empty State persis seperti di screenshot -->
          <div class="p-4 pt-0 flex-1 flex flex-col items-center justify-center py-12 text-center">
            <i data-lucide="calendar" class="h-10 w-10 text-[#cbd5e1] mb-2 stroke-[1.5]"></i>
            <p class="text-sm font-medium text-[#64748b]">
              Belum ada jadwal sidang
            </p>
            <p class="text-xs text-[#94a3b8] mt-1">
              Sidang yang sudah di-plot akan muncul di sini
            </p>
          </div>
        </div>

      </div>

    </div>

    <!-- ========================================================= -->
    <!-- SISI KANAN (span={4})                                     -->
    <!-- ========================================================= -->
    <div class="col-span-1 lg:col-span-4 flex flex-col">
      <div class="space-y-4">

        <!-- 1. PeriodeKP: Card border-l-4 border-l-blue-500 -->
        <div class="overflow-hidden border-l-4 border-l-blue-500 shadow-none border border-[#e2e8f0] rounded-md bg-white">
          <div class="p-3">
            <div class="flex items-center space-x-3">
              <div class="flex h-10 w-10 items-center justify-center rounded-full bg-blue-100 shrink-0">
                <i data-lucide="calendar" class="h-5 w-5 text-blue-600"></i>
              </div>
              <div>
                <p class="text-sm text-[#64748b]">Periode Aktif</p>
                <p class="text-lg font-semibold text-[#0f172a] leading-tight">Tidak ada periode aktif</p>
              </div>
            </div>
          </div>
        </div>

        <!-- 2. GelombangAktifKoor: Card border-l-4 border-l-gray-400 -->
        <div class="overflow-hidden shadow-none border border-[#e2e8f0] rounded-md bg-white">
          <div class="p-3">
            <div class="flex items-center space-x-3">
              <div class="flex h-10 w-10 items-center justify-center rounded-full bg-gray-100 shrink-0">
                <i data-lucide="waves" class="size-4 text-gray-500"></i>
              </div>
              <div>
                <p class="text-sm font-medium text-[#64748b]">Gelombang Aktif</p>
                <p class="text-sm italic text-[#64748b]">Tidak ada gelombang aktif</p>
              </div>
            </div>
          </div>
        </div>

        <!-- 3. DashboardDosenInfoKuota: Card p-4 mt-2 rounded-md -->
        <div class="shadow-none border border-[#e2e8f0] rounded-md bg-white p-4">
          <p class="font-medium text-sm mb-4 text-[#0f172a]">Informasi Kuota Bimbingan</p>
          <div class="grid grid-cols-2 gap-3 items-center">
            <!-- Box 1: Total Kuota -->
            <div class="bg-blue-500/10 rounded-xl p-2.5">
              <div class="flex items-center gap-3">
                <div class="p-2 rounded-lg bg-blue-500/10 text-blue-500 shrink-0">
                  <i data-lucide="graduation-cap" class="w-4 h-4"></i>
                </div>
                <div>
                  <div class="text-blue-500 font-bold text-lg leading-tight">{kuotaData.total_kuota}</div>
                  <div class="text-xs text-[#64748b] mt-0.5">Total Kuota</div>
                </div>
              </div>
            </div>

            <!-- Box 2: Sisa Kuota -->
            <div class="bg-orange-500/10 rounded-xl p-2.5">
              <div class="flex items-center gap-3">
                <div class="p-2 rounded-lg bg-orange-500/10 text-orange-500 shrink-0">
                  <i data-lucide="user" class="w-4 h-4"></i>
                </div>
                <div>
                  <div class="text-orange-500 font-bold text-lg leading-tight">{kuotaData.sisa_kuota}</div>
                  <div class="text-xs text-[#64748b] mt-0.5">Sisa Kuota</div>
                </div>
              </div>
            </div>

            <!-- Box 3: Total Pengajuan -->
            <div class="bg-yellow-500/10 rounded-xl p-2.5">
              <div class="flex items-center gap-3">
                <div class="p-2 rounded-lg bg-yellow-500/10 text-yellow-500 shrink-0">
                  <i data-lucide="clipboard-list" class="w-4 h-4"></i>
                </div>
                <div>
                  <div class="text-yellow-500 font-bold text-lg leading-tight">{kuotaData.total_pengajuan}</div>
                  <div class="text-xs text-[#64748b] mt-0.5">Total Pengajuan</div>
                </div>
              </div>
            </div>

            <!-- Box 4: Jumlah Diterima -->
            <div class="bg-green-500/10 rounded-xl p-2.5">
              <div class="flex items-center gap-3">
                <div class="p-2 rounded-lg bg-green-500/10 text-green-500 shrink-0">
                  <i data-lucide="check-circle" class="w-4 h-4"></i>
                </div>
                <div>
                  <div class="text-green-500 font-bold text-lg leading-tight">{kuotaData.ajuan_diterima}</div>
                  <div class="text-xs text-[#64748b] mt-0.5">Jumlah Diterima</div>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- 4. DashboardLogAktivitas (type="dosen") -->
      <div class="col-span-2 flex h-full flex-col p-4 shadow-none border border-[#e2e8f0] rounded-md bg-white mt-4">
        <div class="mb-2 flex items-center gap-2 text-sm font-medium text-[#0f172a]">
          <i data-lucide="history" class="size-4 text-[#0f172a]"></i>
          <span>Log Aktivitas Mahasiswa</span>
        </div>
        <div class="flex flex-col justify-center divide-y divide-slate-200 py-6">
          <div class="mt-2 w-full">
            <div class="scrollbar-thin scrollbar-thumb-gray-400 scrollbar-track-gray-100 scrollbar-thumb-rounded-full -my-7 overflow-y-scroll max-h-64 space-y-4">
              {groupedActivities.map((activityDay) => (
                <div>
                  <div class="border-b border-gray-200 bg-blue-500/5 px-2 py-1 text-xs font-medium text-[#2563eb]">
                    {activityDay.date}
                  </div>
                  {activityDay.logs.length === 0 ? (
                    <div class="py-2 pl-8 sm:pl-10 text-xs text-[#64748b] italic">
                      Tidak ada aktivitas pada tanggal ini
                    </div>
                  ) : (
                    activityDay.logs.map((log) => (
                      <div class="group relative py-2 pl-8 sm:pl-10">
                        <!-- Bullet dot and timeline line exactly as in screenshot -->
                        <div class="mb-1 flex flex-col items-start before:absolute before:left-2 before:h-full before:w-[1px] before:-translate-x-1/2 before:translate-y-3 before:self-start before:bg-slate-300 after:absolute after:left-2 after:box-content after:h-2 after:w-2 after:-translate-x-1/2 after:translate-y-1.5 after:rounded-full after:border-2 after:border-slate-50 after:bg-[#2563eb] group-last:before:hidden sm:flex-row sm:before:left-0 sm:before:ml-[1rem] sm:after:left-0 sm:after:ml-[1rem]"></div>
                        <div class="text-xs text-[#64748b] leading-relaxed">
                          <span class="font-semibold text-[#0f172a]">{log.lecture}</span>{" "}
                          <span>{log.activity}</span>
                        </div>
                        <div class="text-xs text-[#94a3b8] mt-0.5">{log.time}</div>
                      </div>
                    ))
                  )}
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>

    </div>

  </div>
</DosenShell>
