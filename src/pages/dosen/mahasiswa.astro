---
// src/pages/dosen/mahasiswa.astro
import DosenShell from '../../layouts/DosenShell.astro';

// Data mahasiswa bimbingan persis sesuai tampilan screenshot
const students = [
  {
    id: 1,
    nama: "WANDA PUTRI LESTARI",
    nim: "A11.2023.15257",
    email: "111202315257@mhs.dinus.ac.id",
    telepon: "082328498200",
    terakhirBimbingan: "Belum ada",
    statusMbkm: "Konversi",
    statusVariant: "konversi"
  },
  {
    id: 2,
    nama: "EVAN WILLIAM SETYAWAN",
    nim: "A11.2023.15006",
    email: "111202315006@mhs.dinus.ac.id",
    telepon: "081231083446",
    terakhirBimbingan: "Belum ada",
    statusMbkm: "Reguler",
    statusVariant: "reguler"
  },
  {
    id: 3,
    nama: "SELFI CHOIRIYAH",
    nim: "A11.2023.15154",
    email: "111202315154@mhs.dinus.ac.id",
    telepon: "088803904628",
    terakhirBimbingan: "Belum ada",
    statusMbkm: "Reguler",
    statusVariant: "reguler"
  }
];

const studentsJson = JSON.stringify(students);
---

<DosenShell activeNav="mahasiswa">
  <div
    class="w-full flex flex-col"
    x-data={`{
      search: '',
      allStudents: ${studentsJson},
      get filteredStudents() {
        if (!this.search.trim()) return this.allStudents;
        const q = this.search.toLowerCase();
        return this.allStudents.filter(s =>
          s.nama.toLowerCase().includes(q) ||
          s.nim.toLowerCase().includes(q) ||
          s.email.toLowerCase().includes(q)
        );
      }
    }`}
  >
    <!-- 1. Search Bar (Persis seperti di screenshot) -->
    <div class="relative w-full mb-4">
      <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
        <i data-lucide="search" class="w-4 h-4 text-[#94a3b8]"></i>
      </div>
      <input
        type="text"
        x-model="search"
        placeholder="Cari berdasarkan nama, NIM, atau judul..."
        class="w-full pl-9 pr-4 py-2 border border-[#e2e8f0] rounded-md text-sm bg-white placeholder-[#94a3b8] text-[#0f172a] focus:outline-none focus:border-blue-500"
      />
    </div>

    <!-- 2. Tabel Mahasiswa Bimbingan (Langsung tanpa tabbar redundan) -->
    <div class="rounded-md border border-[#e2e8f0] bg-white overflow-hidden shadow-none">
      <div class="overflow-x-auto">
        <table class="w-full text-sm text-left border-collapse">
          <thead>
            <tr class="border-b border-[#e2e8f0] bg-white">
              <th class="w-12 px-4 py-3 text-xs font-medium text-[#64748b] text-center">No</th>
              <th class="px-4 py-3 text-xs font-medium text-[#64748b]">Nama</th>
              <th class="px-4 py-3 text-xs font-medium text-[#64748b]">Kontak</th>
              <th class="px-4 py-3 text-xs font-medium text-[#64748b]">Terakhir Bimbingan</th>
              <th class="px-4 py-3 text-xs font-medium text-[#64748b]">Status MBKM</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#e2e8f0]">
            <template x-for="(row, idx) in filteredStudents" :key="row.nim">
              <tr class="hover:bg-slate-50/50 transition-colors">
                <!-- No -->
                <td class="px-4 py-3 text-xs text-[#64748b] text-center" x-text="idx + 1"></td>

                <!-- Nama (Stacked: Avatar + Nama di atas, NIM di bawah) -->
                <td class="px-4 py-3">
                  <div class="flex items-center gap-3">
                    <div class="h-9 w-9 rounded-full bg-[#1063B9] text-white flex items-center justify-center font-semibold text-xs shrink-0 overflow-hidden">
                      <img
                        src="/assets/landingpage/img/dosen/default.png"
                        alt="Avatar"
                        class="w-full h-full object-cover"
                        onerror="this.style.display='none'"
                      />
                      <i data-lucide="user" class="w-4 h-4"></i>
                    </div>
                    <div class="min-w-0">
                      <div class="font-medium text-sm text-[#0f172a] truncate" x-text="row.nama"></div>
                      <div class="text-xs text-[#64748b]" x-text="row.nim"></div>
                    </div>
                  </div>
                </td>

                <!-- Kontak (Stacked: Email di atas, No HP di bawah) -->
                <td class="px-4 py-3">
                  <div class="flex flex-col gap-1 text-sm">
                    <div class="flex items-center gap-1.5">
                      <i data-lucide="mail" class="h-3.5 w-3.5 text-[#64748b] shrink-0"></i>
                      <span class="text-xs text-[#0f172a] truncate" x-text="row.email"></span>
                    </div>
                    <div class="flex items-center gap-1.5">
                      <i data-lucide="phone" class="h-3.5 w-3.5 text-[#64748b] shrink-0"></i>
                      <span class="text-xs text-[#64748b]" x-text="row.telepon"></span>
                    </div>
                  </div>
                </td>

                <!-- Terakhir Bimbingan -->
                <td class="px-4 py-3">
                  <span class="text-xs text-[#64748b]" x-text="row.terakhirBimbingan"></span>
                </td>

                <!-- Status MBKM -->
                <td class="px-4 py-3">
                  <template x-if="row.statusVariant === 'konversi'">
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-xs font-semibold bg-green-100 text-green-700 border border-green-300" x-text="row.statusMbkm"></span>
                  </template>
                  <template x-if="row.statusVariant === 'reguler'">
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-xs font-semibold bg-amber-100 text-amber-700 border border-amber-300" x-text="row.statusMbkm"></span>
                  </template>
                </td>
              </tr>
            </template>
          </tbody>
        </table>

        <!-- Empty state saat pencarian tidak ditemukan -->
        <div x-show="filteredStudents.length === 0" class="py-10 text-center text-[#64748b] text-sm">
          Tidak ada mahasiswa bimbingan yang sesuai pencarian.
        </div>
      </div>
    </div>

    <!-- 4. Footer Pagination (Persis seperti di screenshot) -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mt-4 text-xs text-[#64748b]">
      <div>
        Page 1 of 1 (<span x-text="filteredStudents.length"></span> total items)
      </div>

      <div class="flex items-center gap-2">
        <!-- Pagination Buttons -->
        <div class="flex items-center gap-1">
          <button
            type="button"
            disabled
            class="h-8 w-8 flex items-center justify-center border border-[#e2e8f0] rounded-md bg-white text-[#94a3b8] cursor-not-allowed"
          >
            <i data-lucide="chevron-left" class="w-4 h-4"></i>
          </button>

          <button
            type="button"
            class="h-8 px-3 flex items-center justify-center rounded-md bg-[#1063B9] text-white font-medium text-xs"
          >
            1
          </button>

          <button
            type="button"
            disabled
            class="h-8 w-8 flex items-center justify-center border border-[#e2e8f0] rounded-md bg-white text-[#94a3b8] cursor-not-allowed"
          >
            <i data-lucide="chevron-right" class="w-4 h-4"></i>
          </button>
        </div>

        <!-- Show items dropdown -->
        <div class="relative">
          <button
            type="button"
            class="h-8 px-3 border border-[#e2e8f0] rounded-md bg-white text-xs text-[#0f172a] flex items-center gap-2 hover:bg-gray-50"
          >
            <span>Show 5 items</span>
            <i data-lucide="chevron-down" class="w-3.5 h-3.5 text-[#64748b]"></i>
          </button>
        </div>
      </div>
    </div>
  </div>
</DosenShell>
