---
import PortalHero from '../components/portal/PortalHero.astro';
import PortalCardAkademik from '../components/portal/PortalCardAkademik.astro';
import PortalCardLayanan from '../components/portal/PortalCardLayanan.astro';
import PortalCardMbkm from '../components/portal/PortalCardMbkm.astro';
import PortalFooter from '../components/portal/PortalFooter.astro';
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Portal Apps | Fakultas Ilmu Komputer UDINUS</title>
    <script is:inline>
      tailwind = {
        config: {
          corePlugins: { preflight: false },
          theme: {
            extend: {
              fontFamily: {
                sans: ['Inter', 'system-ui', '-apple-system', 'sans-serif'],
              },
              colors: {
                primary: { 50: '#F1F7FE', 100: '#E2EEFC', 200: '#BFDBF8', 300: '#86BEF3', 400: '#1E7FD9', 500: '#1E7FD9', 600: '#1063B9', 700: '#114D91', 800: '#10447C', 900: '#133A67', 950: '#0D2544' },
                secondary: { 50: '#FEFAEC', 100: '#FCEEC9', 200: '#F8DB8F', 300: '#F4BD45', 400: '#F2AB2D', 500: '#F3BC45', 600: '#D0670F' }
              }
            }
          }
        }
      };
    </script>
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <script is:inline src="https://unpkg.com/lucide@latest"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter%3Awght%40100..900&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      *, ::before, ::after {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      a {
        text-decoration: none;
      }
    </style>
  </head>
  <body style="background-color: #ffffffff">
    <div
      data-pencil-name="1920w default"
      class="box-border w-[1920px] shrink-0 h-fit flex flex-col gap-0 justify-between items-start bg-[#ffffffff] [background-image:linear-gradient(124.249deg,_#f8fafcff_0%,_#f1f7feff_100%)] bg-no-repeat bg-[length:100%_100%]"
    >
      <PortalHero />

      <div
        data-pencil-name="div.flex-1"
        class="box-border w-full h-fit shrink-0 flex flex-row gap-0 p-[0px_192px] justify-start items-center"
      >
        <div
          data-pencil-name="div.container"
          class="box-border [flex:1_1_0] h-fit flex flex-col gap-0 p-[64px_192px] justify-start items-start"
        >
          <div data-pencil-name="div.flex" class="box-border w-full h-[727.25px] shrink-0 relative">
            <PortalCardAkademik />
            <PortalCardLayanan />
            <PortalCardMbkm />
          </div>
        </div>
      </div>

      <PortalFooter />
    </div>

    <script is:inline>
      lucide.createIcons();
    </script>
  </body>
</html>
