---
// src/pages/mahasiswa/sidang.astro
import MahasiswaShell from '../../layouts/MahasiswaShell.astro';

// Data Pengajuan Sidang MBKM
const sidangData = {
  status: 'Sudah Terjadwal',
  // Card 1: Informasi MBKM
  judulMBKM: 'Pengembangan Sistem Dashboard Monitoring Magang Berbasis Web',
  perusahaan: 'PT Telkom Indonesia',
  posisi: 'Fullstack Developer',
  periodeMulai: 'Minggu, 23 Agustus 2026',
  periodeSelesai: 'Sabtu, 21 November 2026',
  alamatPerusahaan: 'Jl. Pahlawan No. 10, Pleburan, Kec. Semarang Selatan, Kota Semarang, Jawa Tengah 50241',
  dosenPembimbing: 'Dosen A11 - Dr. Ricardus Anggi, M.Kom',
  linkSuratDiterima: 'https://drive.google.com/file/d/demo-surat-magang/view',

  // Card 2: Informasi Penyelia
  penyelia: {
    nama: 'Budi Santoso, S.Kom.',
    posisi: 'Senior Lead Software Engineer',
    perusahaan: 'PT Telkom Indonesia',
    telepon: '081234567891',
    nilaiEvaluasi: '90'
  },

  // Card 3: Dokumen Pendukung
  berkas: [
    {
      nama: 'Laporan_Akhir_MBKM_A11.2020.00001.pdf',
      kategori: 'Draf Laporan Akhir MBKM',
      ukuran: '4.8 MB',
      status: 'Terverifikasi DPL'
    },
    {
      nama: 'Lembar_Penilaian_Evaluasi_Penyelia.pdf',
      kategori: 'Formulir Nilai Pembimbing Lapangan',
      ukuran: '1.5 MB',
      status: 'Nilai: 90 (A)'
    },
    {
      nama: 'Sertifikat_Penyelesaian_Magang_Telkom.pdf',
      kategori: 'Sertifikat Resmi Kontributor',
      ukuran: '1.2 MB',
      status: 'Terverifikasi Kontributor'
    },
    {
      nama: 'Rekap_Logbook_Kegiatan_MBKM.pdf',
      kategori: 'Rekapitulasi Logbook Mingguan',
      ukuran: '850 KB',
      status: 'Lengkap (100%)'
    }
  ],
  folderDrive: 'https://drive.google.com/drive/folders/berkas-sidang-mbkm-a11-2020-00001',

  // Jadwal & Tim Penguji
  jadwal: {
    tanggal: 'Kamis, 15 Januari 2027',
    waktu: '09:00 - 10:30 WIB',
    lokasi: 'Lab Bengkel Koding (Gedung H Lt. 5) & Google Meet Daring',
    ruang: 'Ruang Sidang H.5.2',
    linkMeet: 'https://meet.google.com/mbkm-sidang-a11'
  },
  penguji: [
    {
      inisial: 'RA',
      nama: 'Dr. Ricardus Anggi, M.Kom',
      peran: 'Penguji Akademis 1 & DPL MBKM',
      bobot: '40%',
      bg: 'bg-blue-50 text-[#1063B9]'
    },
    {
      inisial: 'EM',
      nama: 'Dr. Ir. Edi Mulyanto, M.Kom',
      peran: 'Penguji Akademis 2 (Kaprodi / Reviewer)',
      bobot: '30%',
      bg: 'bg-emerald-50 text-emerald-700'
    },
    {
      inisial: 'BS',
      nama: 'Budi Santoso, S.Kom.',
      peran: 'Penilai Kinerja Kontributor (Penyelia PT Telkom)',
      bobot: '30%',
      bg: 'bg-amber-50 text-amber-700'
    }
  ]
};
---

<MahasiswaShell
  title="Pengajuan Sidang MBKM | Mahasiswa - FIK Udinus"
  activeNav="sidang"
  pageTitle="Pengajuan Sidang"
  breadcrumb="Pengajuan Sidang"
>
  <div class="space-y-6">
    <!-- Header Halaman -->
    <div>
      <h1 class="text-[22px] font-bold text-[#09090b] tracking-tight">Pengajuan Sidang</h1>
      <p class="text-[13px] text-[#71717a] mt-0.5">Berikut adalah halaman untuk mengajukan sidang MBKM.</p>
    </div>

    <!-- Banner Status: Pengajuan Sidang Sudah Terjadwal -->
    <div class="bg-white border border-[#e4e4e7] rounded-xl p-5 shadow-2xs flex items-center justify-between flex-wrap gap-4">
      <div class="flex items-center gap-3.5">
        <!-- Icon Container Kalender -->
        <div class="w-10 h-10 rounded-lg bg-gray-50 border border-[#e4e4e7] flex items-center justify-center shrink-0">
          <i data-lucide="calendar" class="w-5 h-5 text-[#3f3f46]"></i>
        </div>

        <div class="flex items-center gap-3 flex-wrap">
          <h2 class="text-[15px] font-bold text-[#09090b]">Pengajuan Sidang Sudah Terjadwal</h2>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-[#ecfdf5] text-[#15803d] border border-[#bbf7d0]">
            {sidangData.status}
          </span>
        </div>
      </div>
    </div>

    <!-- CARD 1: Informasi MBKM -->
    <div class="bg-white border border-[#e4e4e7] rounded-xl p-6 shadow-2xs space-y-6">
      <!-- Card Header -->
      <div class="flex items-center gap-3 pb-2 border-b border-[#f4f4f5]">
        <div class="w-10 h-10 rounded-lg bg-blue-50 text-[#1063B9] flex items-center justify-center shrink-0">
          <i data-lucide="file-text" class="w-5 h-5"></i>
        </div>
        <div>
          <h2 class="text-[16px] font-bold text-[#09090b]">Informasi MBKM</h2>
          <p class="text-[12px] text-[#71717a]">Detail lengkap mengenai MBKM yang telah dilaksanakan</p>
        </div>
      </div>

      <!-- Field 1: Judul MBKM -->
      <div>
        <label class="flex items-center gap-2 text-xs font-semibold text-[#09090b] mb-1.5">
          <span class="w-2 h-2 rounded-full bg-[#1063B9] inline-block shrink-0"></span>
          <span>Judul MBKM <span class="text-red-500">*</span></span>
        </label>
        <input
          type="text"
          readonly
          value={sidangData.judulMBKM}
          class="w-full px-3.5 py-2.5 bg-gray-50/70 border border-[#e4e4e7] rounded-lg text-xs font-medium text-[#09090b] focus:outline-none focus:ring-1 focus:ring-[#1063B9]"
        />
      </div>

      <!-- Grid 2 Kolom: Nama Perusahaan & Posisi Magang -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Nama Perusahaan -->
        <div>
          <label class="flex items-center gap-2 text-xs font-semibold text-[#09090b] mb-1.5">
            <i data-lucide="building-2" class="w-3.5 h-3.5 text-[#1063B9]"></i>
            <span>Nama Perusahaan <span class="text-red-500">*</span></span>
          </label>
          <input
            type="text"
            readonly
            value={sidangData.perusahaan}
            class="w-full px-3.5 py-2.5 bg-gray-50/70 border border-[#e4e4e7] rounded-lg text-xs font-medium text-[#09090b] focus:outline-none focus:ring-1 focus:ring-[#1063B9]"
          />
        </div>

        <!-- Posisi Magang -->
        <div>
          <label class="flex items-center gap-2 text-xs font-semibold text-[#09090b] mb-1.5">
            <i data-lucide="user" class="w-3.5 h-3.5 text-[#1063B9]"></i>
            <span>Posisi Magang <span class="text-red-500">*</span></span>
          </label>
          <input
            type="text"
            readonly
            value={sidangData.posisi}
            class="w-full px-3.5 py-2.5 bg-gray-50/70 border border-[#e4e4e7] rounded-lg text-xs font-medium text-[#09090b] focus:outline-none focus:ring-1 focus:ring-[#1063B9]"
          />
        </div>
      </div>

      <!-- Kotak: Periode Magang -->
      <div class="p-4 bg-gray-50/50 border border-[#e4e4e7] rounded-xl space-y-3">
        <div class="space-y-0.5">
          <div class="flex items-center gap-2 text-xs font-semibold text-[#09090b]">
            <i data-lucide="calendar" class="w-3.5 h-3.5 text-[#1063B9]"></i>
            <span>Periode Magang</span>
          </div>
          <p class="text-[11px] text-[#71717a]">Tentukan tanggal mulai dan berakhirnya periode magang</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-1">
          <div>
            <label class="text-[11px] font-medium text-[#71717a] block mb-1">
              Tanggal Mulai <span class="text-red-500">*</span>
            </label>
            <div class="relative">
              <input
                type="text"
                readonly
                value={sidangData.periodeMulai}
                class="w-full px-3.5 py-2.5 bg-white border border-[#e4e4e7] rounded-lg text-xs font-medium text-[#09090b] pr-9"
              />
              <i data-lucide="chevron-down" class="w-4 h-4 text-[#71717a] absolute right-3 top-3 pointer-events-none"></i>
            </div>
          </div>

          <div>
            <label class="text-[11px] font-medium text-[#71717a] block mb-1">
              Tanggal Selesai <span class="text-red-500">*</span>
            </label>
            <div class="relative">
              <input
                type="text"
                readonly
                value={sidangData.periodeSelesai}
                class="w-full px-3.5 py-2.5 bg-white border border-[#e4e4e7] rounded-lg text-xs font-medium text-[#09090b] pr-9"
              />
              <i data-lucide="chevron-down" class="w-4 h-4 text-[#71717a] absolute right-3 top-3 pointer-events-none"></i>
            </div>
          </div>
        </div>
      </div>

      <!-- Alamat Perusahaan -->
      <div>
        <label class="flex items-center gap-2 text-xs font-semibold text-[#09090b] mb-1.5">
          <i data-lucide="map-pin" class="w-3.5 h-3.5 text-[#1063B9]"></i>
          <span>Alamat Perusahaan <span class="text-red-500">*</span></span>
        </label>
        <input
          type="text"
          readonly
          value={sidangData.alamatPerusahaan}
          class="w-full px-3.5 py-2.5 bg-gray-50/70 border border-[#e4e4e7] rounded-lg text-xs font-medium text-[#09090b]"
        />
      </div>

      <!-- Link Surat Diterima Magang -->
      <div>
        <label class="flex items-center gap-2 text-xs font-semibold text-[#09090b] mb-1.5">
          <i data-lucide="link-2" class="w-3.5 h-3.5 text-[#1063B9]"></i>
          <span>Link Surat Diterima Magang <span class="text-red-500">*</span></span>
        </label>
        <div class="relative">
          <input
            type="url"
            readonly
            value={sidangData.linkSuratDiterima}
            class="w-full px-3.5 py-2.5 bg-gray-50/70 border border-[#e4e4e7] rounded-lg text-xs font-medium text-[#09090b] pr-28"
          />
          <a
            href={sidangData.linkSuratDiterima}
            target="_blank"
            class="absolute right-2 top-2 px-2.5 py-1 bg-white hover:bg-gray-50 border border-[#e4e4e7] rounded text-[11px] font-medium text-[#1063B9] flex items-center gap-1 shadow-2xs"
          >
            <i data-lucide="external-link" class="w-3 h-3"></i>
            <span>Buka Link</span>
          </a>
        </div>
        <div class="flex items-center gap-1.5 text-[11px] text-[#71717a] mt-1.5">
          <i data-lucide="info" class="w-3.5 h-3.5 text-[#71717a] shrink-0"></i>
          <span>Pastikan link dapat diakses oleh dosen pembimbing</span>
        </div>
      </div>
    </div>

    <!-- CARD 2: Informasi Penyelia -->
    <div class="bg-white border border-[#e4e4e7] rounded-xl p-6 shadow-2xs space-y-6">
      <!-- Card Header -->
      <div class="flex items-center gap-3 pb-2 border-b border-[#f4f4f5]">
        <div class="w-10 h-10 rounded-lg bg-amber-50 border border-amber-200/60 text-amber-600 flex items-center justify-center shrink-0">
          <i data-lucide="user" class="w-5 h-5"></i>
        </div>
        <div>
          <h2 class="text-[16px] font-bold text-[#09090b]">Informasi Penyelia</h2>
          <p class="text-[12px] text-[#71717a]">Detail lengkap mengenai penyelia yang membimbing selama MBKM</p>
        </div>
      </div>

      <!-- Grid 2 Kolom: Nama Penyelia & Posisi Penyelia -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Nama Penyelia -->
        <div>
          <label class="flex items-center gap-2 text-xs font-semibold text-[#09090b] mb-1.5">
            <span class="w-2 h-2 rounded-full bg-amber-500 inline-block shrink-0"></span>
            <span>Nama Penyelia <span class="text-red-500">*</span></span>
          </label>
          <input
            type="text"
            readonly
            value={sidangData.penyelia.nama}
            class="w-full px-3.5 py-2.5 bg-gray-50/70 border border-[#e4e4e7] rounded-lg text-xs font-medium text-[#09090b]"
          />
        </div>

        <!-- Posisi Penyelia -->
        <div>
          <label class="flex items-center gap-2 text-xs font-semibold text-[#09090b] mb-1.5">
            <i data-lucide="star" class="w-3.5 h-3.5 text-amber-500"></i>
            <span>Posisi Penyelia <span class="text-red-500">*</span></span>
          </label>
          <input
            type="text"
            readonly
            value={sidangData.penyelia.posisi}
            class="w-full px-3.5 py-2.5 bg-gray-50/70 border border-[#e4e4e7] rounded-lg text-xs font-medium text-[#09090b]"
          />
        </div>
      </div>

      <!-- Grid 2 Kolom: Nama Perusahaan & Nomor Telepon -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Nama Perusahaan -->
        <div>
          <label class="flex items-center gap-2 text-xs font-semibold text-[#09090b] mb-1.5">
            <i data-lucide="building-2" class="w-3.5 h-3.5 text-amber-500"></i>
            <span>Nama Perusahaan <span class="text-red-500">*</span></span>
          </label>
          <input
            type="text"
            readonly
            value={sidangData.penyelia.perusahaan}
            class="w-full px-3.5 py-2.5 bg-gray-50/70 border border-[#e4e4e7] rounded-lg text-xs font-medium text-[#09090b]"
          />
        </div>

        <!-- Nomor Telepon -->
        <div>
          <label class="flex items-center gap-2 text-xs font-semibold text-[#09090b] mb-1.5">
            <i data-lucide="phone" class="w-3.5 h-3.5 text-amber-500"></i>
            <span>Nomor Telepon <span class="text-red-500">*</span></span>
          </label>
          <input
            type="text"
            readonly
            value={sidangData.penyelia.telepon}
            class="w-full px-3.5 py-2.5 bg-gray-50/70 border border-[#e4e4e7] rounded-lg text-xs font-medium text-[#09090b]"
          />
        </div>
      </div>

      <!-- Nilai Evaluasi dari Penyelia -->
      <div>
        <label class="flex items-center gap-2 text-xs font-semibold text-[#09090b] mb-1.5">
          <i data-lucide="star" class="w-3.5 h-3.5 text-amber-500"></i>
          <span>Nilai Evaluasi dari Penyelia <span class="text-red-500">*</span></span>
        </label>
        <input
          type="text"
          readonly
          value={sidangData.penyelia.nilaiEvaluasi}
          class="w-full px-3.5 py-2.5 bg-gray-50/70 border border-[#e4e4e7] rounded-lg text-xs font-medium text-[#09090b]"
        />
        <div class="flex items-center gap-1.5 text-[11px] text-[#71717a] mt-1.5">
          <i data-lucide="info" class="w-3.5 h-3.5 text-[#71717a] shrink-0"></i>
          <span>Nilai yang diberikan oleh penyelia berdasarkan performa selama magang</span>
        </div>
      </div>
    </div>

    <!-- CARD 3: Dokumen Pendukung (Sesuai Screenshot Referensi) -->
    <div class="bg-white border border-[#e4e4e7] rounded-xl p-6 shadow-2xs space-y-5">
      <!-- Card Header -->
      <div class="flex items-center gap-3 pb-2 border-b border-[#f4f4f5]">
        <div class="w-10 h-10 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0">
          <i data-lucide="file-text" class="w-5 h-5"></i>
        </div>
        <div>
          <h2 class="text-[16px] font-bold text-[#09090b]">Dokumen Pendukung</h2>
          <p class="text-[12px] text-[#71717a]">Upload dokumen yang diperlukan untuk pengajuan sidang</p>
        </div>
      </div>

      <!-- Item 1: Laporan Akhir MBKM -->
      <div class="p-5 bg-white border border-[#e4e4e7] rounded-xl space-y-3">
        <div class="flex items-start gap-3">
          <div class="w-9 h-9 rounded-lg bg-blue-50 text-[#1063B9] flex items-center justify-center shrink-0 mt-0.5">
            <i data-lucide="file-text" class="w-4 h-4"></i>
          </div>
          <div>
            <h3 class="text-[14px] font-bold text-[#09090b]">
              Laporan Akhir MBKM <span class="text-red-500">*</span>
            </h3>
            <p class="text-[12px] text-[#71717a]">Upload laporan akhir yang telah disusun sesuai dengan format yang ditentukan</p>
          </div>
        </div>

        <div>
          <input
            type="url"
            readonly
            value="https://drive.google.com/file/d/laporan-akhir-mbkm-a11.pdf"
            class="w-full px-3.5 py-2.5 bg-gray-50/70 border border-[#e4e4e7] rounded-lg text-xs font-medium text-[#09090b]"
          />
        </div>

        <div class="flex items-center gap-1.5 text-[11px] text-[#71717a]">
          <i data-lucide="check-circle-2" class="w-3.5 h-3.5 text-[#71717a]"></i>
          <span>Format: PDF</span>
        </div>
      </div>

      <!-- Item 2: Dokumen Evaluasi Penyelia -->
      <div class="p-5 bg-white border border-[#e4e4e7] rounded-xl space-y-3">
        <div class="flex items-start gap-3">
          <div class="w-9 h-9 rounded-lg bg-amber-50 text-amber-600 flex items-center justify-center shrink-0 mt-0.5">
            <i data-lucide="user" class="w-4 h-4"></i>
          </div>
          <div>
            <h3 class="text-[14px] font-bold text-[#09090b]">
              Dokumen Evaluasi Penyelia <span class="text-red-500">*</span>
            </h3>
            <p class="text-[12px] text-[#71717a]">Dokumen evaluasi atau sertifikat yang diberikan oleh penyelia di tempat magang</p>
          </div>
        </div>

        <div>
          <input
            type="url"
            readonly
            value="https://drive.google.com/file/d/lembar-nilai-penyelia.pdf"
            class="w-full px-3.5 py-2.5 bg-gray-50/70 border border-[#e4e4e7] rounded-lg text-xs font-medium text-[#09090b]"
          />
        </div>

        <div class="flex items-center gap-1.5 text-[11px] text-[#71717a]">
          <i data-lucide="check-circle-2" class="w-3.5 h-3.5 text-[#71717a]"></i>
          <span>Dokumen harus ditandatangani perusahaan</span>
        </div>
      </div>

      <!-- Item 3: Checklist Dokumen -->
      <div class="p-5 bg-[#f8fafc] border border-[#e4e4e7] rounded-xl space-y-2.5">
        <div class="flex items-center gap-2">
          <i data-lucide="alert-circle" class="w-4 h-4 text-[#3f3f46]"></i>
          <h4 class="text-[13px] font-bold text-[#09090b]">Checklist Dokumen</h4>
        </div>
        <ul class="text-[12px] text-[#52525b] space-y-1 pl-6 list-disc">
          <li>Pastikan semua dokumen dalam format PDF</li>
          <li>Link dokumen dapat diakses oleh dosen pembimbing</li>
          <li>Laporan akhir sesuai dengan template yang diberikan</li>
        </ul>
      </div>
    </div>

    <!-- CARD 4: Jadwal Sidang & Dosen Penguji -->
    <div class="bg-white border border-[#e4e4e7] rounded-xl p-6 shadow-2xs space-y-4">
      <div class="flex items-center justify-between pb-3 border-b border-[#f4f4f5] flex-wrap gap-2">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-lg bg-blue-50 text-[#1063B9] flex items-center justify-center">
            <i data-lucide="calendar-check" class="w-4 h-4"></i>
          </div>
          <div>
            <h3 class="text-[15px] font-bold text-[#09090b]">Jadwal Pelaksanaan Sidang & Tim Penguji</h3>
            <p class="text-xs text-[#71717a]">Pelaksanaan sidang evaluasi akhir MBKM.</p>
          </div>
        </div>
        <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-medium bg-[#ecfdf5] text-[#15803d] border border-[#bbf7d0]">
          Terkonfirmasi
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-3 text-xs">
        <div class="p-3 bg-gray-50 rounded-lg space-y-1">
          <span class="text-[#71717a] block text-[11px]">Hari & Tanggal</span>
          <span class="font-semibold text-[#09090b] text-[13px]">{sidangData.jadwal.tanggal}</span>
        </div>

        <div class="p-3 bg-gray-50 rounded-lg space-y-1">
          <span class="text-[#71717a] block text-[11px]">Waktu Pelaksanaan</span>
          <span class="font-semibold text-[#09090b] text-[13px]">{sidangData.jadwal.waktu}</span>
        </div>

        <div class="p-3 bg-gray-50 rounded-lg space-y-1">
          <span class="text-[#71717a] block text-[11px]">Ruang Sidang</span>
          <span class="font-semibold text-[#09090b] text-[13px]">{sidangData.jadwal.ruang}</span>
        </div>
      </div>

      <!-- Tautan Google Meet -->
      <div class="p-3 bg-blue-50/60 border border-blue-100 rounded-lg flex items-center justify-between flex-wrap gap-2">
        <div class="flex items-center gap-2">
          <i data-lucide="video" class="w-4 h-4 text-[#1063B9]"></i>
          <span class="text-xs font-semibold text-[#1063B9]">Tautan Google Meet:</span>
          <span class="text-xs text-[#3f3f46] font-medium">{sidangData.jadwal.linkMeet}</span>
        </div>
        <a
          href={sidangData.jadwal.linkMeet}
          target="_blank"
          class="text-xs font-semibold text-[#1063B9] hover:underline flex items-center gap-1"
        >
          Masuk Room <i data-lucide="external-link" class="w-3 h-3"></i>
        </a>
      </div>

      <!-- Tim Dosen Penguji & Penilai Kontributor -->
      <div class="pt-3 border-t border-[#f4f4f5] space-y-2.5">
        <h4 class="text-xs font-bold text-[#09090b] uppercase tracking-wider">Tim Penguji & Penilai MBKM</h4>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
          {sidangData.penguji.map((item) => (
            <div class="p-3 border border-[#e4e4e7] rounded-xl bg-white space-y-1.5 shadow-2xs">
              <div class="flex items-center justify-between">
                <div class={`w-7 h-7 rounded-md ${item.bg} flex items-center justify-center font-bold text-xs shrink-0`}>
                  {item.inisial}
                </div>
                <span class="text-xs font-semibold px-2 py-0.5 rounded bg-gray-100 text-[#3f3f46]">
                  Bobot {item.bobot}
                </span>
              </div>
              <div class="font-semibold text-[#09090b] text-xs leading-tight">{item.nama}</div>
              <div class="text-[11px] text-[#71717a]">{item.peran}</div>
            </div>
          ))}
        </div>
      </div>

      <!-- Tombol Aksi Bawah -->
      <div class="pt-4 border-t border-[#f4f4f5] flex items-center justify-end gap-3 flex-wrap">
        <button
          type="button"
          onclick="openRescheduleModal()"
          class="inline-flex items-center gap-1.5 px-4 py-2 bg-white hover:bg-gray-50 text-[#09090b] border border-[#e4e4e7] text-xs font-semibold rounded-lg shadow-2xs transition-colors"
        >
          <i data-lucide="clock" class="w-3.5 h-3.5 text-[#71717a]"></i>
          <span>Ajukan Reschedule</span>
        </button>
        <button
          type="button"
          onclick="cetakBukti()"
          class="inline-flex items-center gap-1.5 px-4 py-2 bg-[#1063B9] hover:bg-[#0E4F96] text-white text-xs font-semibold rounded-lg shadow-2xs transition-all active:scale-95"
        >
          <i data-lucide="printer" class="w-4 h-4"></i>
          <span>Cetak Bukti Pendaftaran Sidang</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Modal: Detail Jadwal Sidang -->
  <div id="modal-jadwal" class="hidden fixed inset-0 bg-black/40 backdrop-blur-xs z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-xl max-w-md w-full shadow-2xl border border-[#e4e4e7]">
      <div class="p-5 border-b border-[#e4e4e7] flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-lg bg-blue-50 text-[#1063B9] flex items-center justify-center">
            <i data-lucide="calendar" class="w-4 h-4"></i>
          </div>
          <div>
            <h3 class="text-[15px] font-bold text-[#09090b]">Informasi Sidang MBKM</h3>
            <p class="text-xs text-[#71717a]">Detail jadwal & instruksi pelaksanaan sidang.</p>
          </div>
        </div>
        <button type="button" onclick="closeJadwalModal()" class="text-[#71717a] hover:text-[#09090b] p-1">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>

      <div class="p-5 space-y-3.5 text-xs">
        <div class="p-3 bg-gray-50 rounded-lg space-y-1">
          <div class="text-[11px] text-[#71717a]">Hari, Tanggal & Jam</div>
          <div class="font-bold text-[#09090b] text-[13px]">{sidangData.jadwal.tanggal} &bull; {sidangData.jadwal.waktu}</div>
        </div>

        <div class="p-3 bg-gray-50 rounded-lg space-y-1">
          <div class="text-[11px] text-[#71717a]">Lokasi Ruangan</div>
          <div class="font-semibold text-[#09090b]">{sidangData.jadwal.lokasi}</div>
        </div>

        <div class="p-3 bg-amber-50 border border-amber-200/60 rounded-lg space-y-1 text-amber-900">
          <div class="font-semibold flex items-center gap-1.5">
            <i data-lucide="alert-circle" class="w-4 h-4 text-amber-700"></i>
            Tata Tertib Sidang MBKM
          </div>
          <p class="text-[11px] leading-relaxed text-amber-800">
            Mahasiswa diwajibkan hadir 15 menit sebelum sidang dimulai, mengenakan jas almamater resmi, kemeja putih, dan menyiapkan slide presentasi maksimal 15 slide (durasi presentasi 15 menit).
          </p>
        </div>
      </div>

      <div class="p-4 bg-gray-50 border-t border-[#e4e4e7] flex items-center justify-end rounded-b-xl">
        <button type="button" onclick="closeJadwalModal()" class="px-4 py-2 bg-[#1063B9] hover:bg-[#0E4F96] text-white text-xs font-semibold rounded-lg transition-colors">
          Tutup
        </button>
      </div>
    </div>
  </div>

  <!-- Modal: Reschedule Sidang -->
  <div id="modal-reschedule" class="hidden fixed inset-0 bg-black/40 backdrop-blur-xs z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-xl max-w-md w-full shadow-2xl border border-[#e4e4e7]">
      <div class="p-5 border-b border-[#e4e4e7] flex items-center justify-between">
        <div>
          <h3 class="text-[15px] font-bold text-[#09090b]">Pengajuan Reschedule Sidang</h3>
          <p class="text-xs text-[#71717a] mt-0.5">Permohonan penjadwalan ulang sidang MBKM.</p>
        </div>
        <button type="button" onclick="closeRescheduleModal()" class="text-[#71717a] hover:text-[#09090b] p-1">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>

      <form onsubmit="handleRescheduleSubmit(event)" class="p-5 space-y-4">
        <div>
          <label class="text-[12px] font-semibold text-[#09090b] block mb-1">Alasan Pengajuan <span class="text-red-500">*</span></label>
          <textarea rows="3" class="w-full px-3 py-2 border border-[#e4e4e7] rounded-lg text-xs focus:outline-none focus:ring-2 focus:ring-[#1063B9] resize-none" placeholder="Jelaskan alasan rescheduling secara jelas..." required></textarea>
        </div>

        <div>
          <label class="text-[12px] font-semibold text-[#09090b] block mb-1">Usulan Tanggal Alternatif <span class="text-red-500">*</span></label>
          <input type="date" class="w-full px-3 py-2 border border-[#e4e4e7] rounded-lg text-xs focus:outline-none focus:ring-2 focus:ring-[#1063B9]" required />
        </div>

        <div class="flex items-center justify-end gap-2 pt-3 border-t border-[#e4e4e7]">
          <button type="button" onclick="closeRescheduleModal()" class="px-4 py-2 border border-[#e4e4e7] text-[#09090b] text-xs font-semibold rounded-lg hover:bg-gray-50 transition-colors">
            Batal
          </button>
          <button type="submit" class="px-4 py-2 bg-[#1063B9] hover:bg-[#0E4F96] text-white text-xs font-semibold rounded-lg transition-colors">
            Kirim Permohonan
          </button>
        </div>
      </form>
    </div>
  </div>

  <script is:inline>
    function openJadwalModal() {
      const m = document.getElementById('modal-jadwal');
      if (m) m.classList.remove('hidden');
      if (window.lucide) window.lucide.createIcons();
    }

    function closeJadwalModal() {
      const m = document.getElementById('modal-jadwal');
      if (m) m.classList.add('hidden');
    }

    function openRescheduleModal() {
      const m = document.getElementById('modal-reschedule');
      if (m) m.classList.remove('hidden');
      if (window.lucide) window.lucide.createIcons();
    }

    function closeRescheduleModal() {
      const m = document.getElementById('modal-reschedule');
      if (m) m.classList.add('hidden');
    }

    function handleRescheduleSubmit(e) {
      e.preventDefault();
      alert('Permohonan penjadwalan ulang sidang MBKM berhasil dikirim ke Koordinator Program.');
      closeRescheduleModal();
    }

    function cetakBukti() {
      window.print();
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeJadwalModal();
        closeRescheduleModal();
      }
    });

    ['modal-jadwal', 'modal-reschedule'].forEach((id) => {
      const modal = document.getElementById(id);
      if (modal) {
        modal.addEventListener('click', (e) => {
          if (e.target === modal) modal.classList.add('hidden');
        });
      }
    });

    document.addEventListener('DOMContentLoaded', () => {
      if (window.lucide) {
        window.lucide.createIcons();
      }
    });
  </script>
</MahasiswaShell>
