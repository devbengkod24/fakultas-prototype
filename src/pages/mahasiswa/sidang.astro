---
// src/pages/mahasiswa/sidang.astro
import MahasiswaShell from "../../layouts/MahasiswaShell.astro";
import { cn } from "../../utils/cn";
import { sidangData } from "../../data/mahasiswa/sidangData";
import TabPengajuanBerkas from "../../components/mahasiswa/sidang/TabPengajuanBerkas.astro";
import TabJadwalHasil from "../../components/mahasiswa/sidang/TabJadwalHasil.astro";
import ModalSidang from "../../components/mahasiswa/sidang/ModalSidang.astro";
---

<MahasiswaShell
  title="Sidang Evaluasi | Mahasiswa - FIK Udinus"
  activeNav="sidang"
  pageTitle="Sidang Evaluasi"
  breadcrumb="Sidang Evaluasi"
>
  <section id="view-sidang" class={cn("space-y-6")} x-data="{ activeTab: 'pengajuan' }">
    <!-- Header Halaman -->
    <div>
      <h1 class="text-lg font-semibold text-[#09090b]">Sidang Evaluasi</h1>
      <p class="text-xs text-[#71717a] leading-relaxed mt-0.5">
        Pengajuan berkas persyaratan, jadwal pelaksanaan, dan hasil evaluasi akhir program MBKM.
      </p>
    </div>

    <!-- Banner Ringkasan Status -->
    <div class="rounded-xl border border-[#e4e4e7] bg-white p-5 flex items-center justify-between flex-wrap gap-4">
      <div class="flex items-center gap-3.5">
        <div class="w-10 h-10 rounded-lg bg-[#fafafa] border border-[#e4e4e7] flex items-center justify-center text-[#0655a7] shrink-0">
          <i data-lucide="calendar-check" class="w-4 h-4"></i>
        </div>
        <div class="flex items-center gap-3 flex-wrap">
          <h2 class="text-base font-semibold text-[#09090b]">Sidang Evaluasi Akhir MBKM</h2>
          <span class="bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs px-2.5 py-0.5 rounded-md font-semibold">
            {sidangData.status}
          </span>
        </div>
      </div>
    </div>

    <!-- Navigasi 2 Tab -->
    <div class="border-b border-[#e4e4e7]">
      <div class="flex items-center gap-8 overflow-x-auto">
        <button
          type="button"
          @click="activeTab = 'pengajuan'"
          :class="activeTab === 'pengajuan' ? 'text-[#0655a7] font-semibold border-b-2 border-[#0655a7]' : 'text-[#71717a] font-medium border-b-2 border-transparent hover:text-[#09090b]'"
          class="pb-3 pt-1 text-sm transition-colors whitespace-nowrap -mb-px cursor-pointer flex items-center gap-2"
        >
          <i data-lucide="file-check" class="w-4 h-4"></i>
          <span>Pengajuan Berkas Sidang</span>
        </button>

        <button
          type="button"
          @click="activeTab = 'jadwal-hasil'"
          :class="activeTab === 'jadwal-hasil' ? 'text-[#0655a7] font-semibold border-b-2 border-[#0655a7]' : 'text-[#71717a] font-medium border-b-2 border-transparent hover:text-[#09090b]'"
          class="pb-3 pt-1 text-sm transition-colors whitespace-nowrap -mb-px cursor-pointer flex items-center gap-2"
        >
          <i data-lucide="calendar-days" class="w-4 h-4"></i>
          <span>Jadwal & Hasil Evaluasi</span>
        </button>
      </div>
    </div>

    <!-- Tab 1: Pengajuan Berkas Sidang -->
    <div x-show="activeTab === 'pengajuan'" x-cloak>
      <TabPengajuanBerkas data={sidangData} />
    </div>

    <!-- Tab 2: Jadwal & Hasil Evaluasi -->
    <div x-show="activeTab === 'jadwal-hasil'" x-cloak>
      <TabJadwalHasil data={sidangData} />
    </div>

    <!-- Modals Terkait Sidang -->
    <ModalSidang data={sidangData} />
  </section>

  <!-- Skrip Runtime & Kontrak DOM -->
  <script is:inline>
    window.openJadwalModal = () => { const m = document.getElementById('modal-jadwal'); if (m) m.classList.remove('hidden'); if (window.lucide) window.lucide.createIcons(); };
    window.closeJadwalModal = () => { const m = document.getElementById('modal-jadwal'); if (m) m.classList.add('hidden'); };
    window.openRescheduleModal = () => { const m = document.getElementById('modal-reschedule'); if (m) m.classList.remove('hidden'); if (window.lucide) window.lucide.createIcons(); };
    window.closeRescheduleModal = () => { const m = document.getElementById('modal-reschedule'); if (m) m.classList.add('hidden'); };
    window.openModalUploadBerkas = () => { const m = document.getElementById('modal-upload-berkas'); if (m) m.classList.remove('hidden'); if (window.lucide) window.lucide.createIcons(); };
    window.closeModalUploadBerkas = () => {
      const m = document.getElementById('modal-upload-berkas');
      if (m) m.classList.add('hidden');
      const f = document.getElementById('form-upload-berkas');
      if (f) f.reset();
    };

    window.handleRescheduleSubmit = (e) => {
      if (e) e.preventDefault();
      alert('Permohonan penjadwalan ulang sidang berhasil diajukan ke Koordinator Program.');
      window.closeRescheduleModal();
    };

    window.handleUploadBerkasSubmit = (e) => {
      if (e) e.preventDefault();
      const fileInput = document.getElementById('upload-file-input');
      const file = fileInput && fileInput.files && fileInput.files[0];
      const nama = file ? file.name : 'Dokumen_Persyaratan_Sidang.pdf';
      const tbody = document.getElementById('table-berkas-sidang-body');
      if (tbody) {
        const rowCount = tbody.querySelectorAll('tr').length + 1;
        const tr = document.createElement('tr');
        tr.className = 'hover:bg-[#f4f4f5]/60 transition-colors';
        tr.innerHTML = `
          <td class="w-12 text-center text-xs font-medium text-[#71717a]">${rowCount}</td>
          <td class="px-4 py-3 font-medium text-xs text-[#09090b]">
            <div class="flex items-center gap-2">
              <i data-lucide="file" class="w-4 h-4 text-[#71717a] shrink-0"></i>
              <span class="truncate">${nama}</span>
            </div>
          </td>
          <td class="px-4 py-3 text-right">
            <a href="#" onclick="alert('Membuka berkas: ${nama}'); return false;" class="inline-flex items-center gap-1 text-xs font-semibold text-[#0655a7] hover:underline">
              <i data-lucide="eye" class="w-4 h-4"></i>
              <span>Lihat</span>
            </a>
          </td>
        `;
        tbody.appendChild(tr);
        if (window.lucide) window.lucide.createIcons();
      }
      alert(`Berkas "${nama}" berhasil diunggah.`);
      window.closeModalUploadBerkas();
    };

    window.cetakBukti = () => window.print();

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        window.closeJadwalModal();
        window.closeRescheduleModal();
        window.closeModalUploadBerkas();
      }
    });

    ['modal-jadwal', 'modal-reschedule', 'modal-upload-berkas'].forEach((id) => {
      const modal = document.getElementById(id);
      if (modal) {
        modal.addEventListener('click', (e) => {
          if (e.target === modal) modal.classList.add('hidden');
        });
      }
    });

    const initSidangForms = () => {
      const resched = document.getElementById('form-reschedule-sidang');
      if (resched && !resched.dataset.bound) {
        resched.dataset.bound = 'true';
        resched.addEventListener('submit', (e) => window.handleRescheduleSubmit(e));
      }
      const upload = document.getElementById('form-upload-berkas');
      if (upload && !upload.dataset.bound) {
        upload.dataset.bound = 'true';
        upload.addEventListener('submit', (e) => window.handleUploadBerkasSubmit(e));
      }
    };

    ['DOMContentLoaded', 'astro:page-load'].forEach((evt) => {
      document.addEventListener(evt, () => {
        if (window.lucide) window.lucide.createIcons();
        initSidangForms();
      });
    });
    initSidangForms();
  </script>
</MahasiswaShell>
