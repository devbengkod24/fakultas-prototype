---
// src/pages/mahasiswa/sidang.astro
import MahasiswaShell from '../../layouts/MahasiswaShell.astro';
---

<MahasiswaShell
  title="Sidang Evaluasi Akhir | Mahasiswa - FIK Udinus"
  activeNav="sidang"
  pageTitle="Sidang Evaluasi Akhir MBKM"
  breadcrumb="Sidang"
  subtitle="Pengajuan dan penilaian sidang evaluasi akhir dengan bobot terstandarisasi (40-30-30)."
>
  <div id="view-sidang" class="w-full">
<!-- Sidang Evaluasi Akhir MBKM (Sama Persis Pola KP: Bobot 40-30-30) -->
<div style="margin-bottom:24px;">

  <!-- Header Section -->
  <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-bottom:20px;">
    <div>
      <h2 style="font-size:18px;font-weight:700;color:#1e293b;display:flex;align-items:center;gap:8px;">
        <i data-lucide="calendar-check" style="color:var(--primary);width:20px;height:20px;"></i>
        Sidang Evaluasi Akhir MBKM
      </h2>
      <p style="font-size:13px;color:#64748b;margin-top:2px;">
        Pendaftaran sidang akhir, unggah Laporan Akhir MBKM, jadwal penguji &amp; mentor mitra, dan rekapitulasi nilai evaluasi akhir (40-30-30).
      </p>
    </div>
    <span class="badge badge-warning"><i data-lucide="clock" style="width:12px;height:12px;"></i> Sidang Dibuka: 20 Jan 2026</span>
  </div>

  <!-- Banner Alur Persyaratan Sidang -->
  <div class="alert alert-warning" style="margin-bottom:22px;padding:16px;border-radius:10px;background:#fffbeb;border-left:4px solid #d97706;">
    <div style="display:flex;gap:14px;align-items:flex-start;">
      <i data-lucide="alert-triangle" style="width:22px;height:22px;color:#d97706;flex-shrink:0;margin-top:2px;"></i>
      <div style="font-size:12.5px;color:#92400e;line-height:1.6;">
        <strong>Persyaratan Wajib Sebelum Mendaftar Sidang Akhir:</strong>
        <ol style="margin:6px 0 0 16px;padding:0;">
          <li>Logbook mingguan terisi &amp; disetujui DPL minimal <strong>13 dari 16 Minggu (&ge;80%)</strong>.</li>
          <li>Laporan Akhir MBKM dalam format PDF diunggah ke sistem &amp; tautan repositori/GDrive disertakan.</li>
          <li>Luaran wajib (Sertifikat Resmi Mitra atau LoA Publikasi Ilmiah) telah diunggah &amp; diverifikasi Koordinator.</li>
        </ol>
      </div>
    </div>
  </div>

  <!-- Form Pendaftaran Sidang & Unggah Laporan Akhir -->
  <div class="card" style="padding:22px;margin-bottom:22px;">
    <div class="card-header" style="margin-bottom:16px;">
      <span class="card-title" style="font-size:15px;display:flex;align-items:center;gap:8px;">
        <i data-lucide="file-up" style="color:var(--primary);width:18px;height:18px;"></i>
        Pendaftaran Sidang &amp; Unggah Laporan Akhir MBKM
      </span>
      <span class="badge" style="background:#fef3c7;color:#d97706;border:1px solid #fde68a;">Pendaftaran Dibuka 20 Jan 2026</span>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px;">
      <!-- Unggah PDF Laporan Akhir -->
      <div class="form-group">
        <label class="form-label">Unggah Draf Laporan Akhir MBKM (Format PDF) <span style="color:#dc2626;">*</span></label>
        <div style="border:2px dashed #cbd5e1;border-radius:10px;padding:20px;text-align:center;cursor:pointer;background:#f8fafc;transition:border-color 0.2s;" id="drop-laporan" onclick="document.getElementById('file-laporan-akhir').click()">
          <div style="width:44px;height:44px;border-radius:10px;background:#eff6ff;color:var(--primary);display:flex;align-items:center;justify-content:center;margin:0 auto 10px;">
            <i data-lucide="file-text" style="width:22px;height:22px;"></i>
          </div>
          <div style="font-size:13px;font-weight:600;color:#1e293b;">Klik untuk Unggah PDF Laporan</div>
          <div style="font-size:11px;color:#94a3b8;margin-top:4px;">Format PDF, Maks. 25 MB</div>
          <input type="file" id="file-laporan-akhir" accept=".pdf" style="display:none;" />
        </div>
      </div>

      <!-- Tautan Repositori / GDrive -->
      <div>
        <div class="form-group">
          <label class="form-label">Tautan Repositori Proyek (GitHub / GitLab) <span style="color:#dc2626;">*</span></label>
          <div style="position:relative;">
            <i data-lucide="git-branch" style="position:absolute;left:12px;top:50%;transform:translateY(-50%);width:15px;height:15px;color:#64748b;"></i>
            <input type="url" class="form-control" placeholder="https://github.com/username/project-mbkm" style="padding-left:36px;" />
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">Tautan Folder Laporan Google Drive <span style="color:#dc2626;">*</span></label>
          <div style="position:relative;">
            <i data-lucide="folder" style="position:absolute;left:12px;top:50%;transform:translateY(-50%);width:15px;height:15px;color:#64748b;"></i>
            <input type="url" class="form-control" placeholder="https://drive.google.com/drive/folders/..." style="padding-left:36px;" />
          </div>
        </div>
      </div>
    </div>

    <div style="display:flex;justify-content:flex-end;">
      <button class="btn btn-primary btn-lg" onclick="alert('Fitur pendaftaran sidang dibuka mulai 20 Januari 2026. Pastikan semua persyaratan logbook dan luaran wajib telah terpenuhi.')">
        <i data-lucide="calendar-plus"></i> Daftar Sidang Evaluasi Akhir
      </button>
    </div>
  </div>

  <!-- Jadwal & Daftar Dosen Penguji + Mentor Mitra Penilai -->
  <div class="grid grid-2" style="gap:18px;margin-bottom:22px;">
    <!-- Informasi Jadwal Sidang -->
    <div class="card" style="padding:22px;">
      <div class="card-header" style="margin-bottom:14px;">
        <span class="card-title" style="font-size:14px;display:flex;align-items:center;gap:8px;">
          <i data-lucide="calendar" style="color:var(--primary);"></i> Informasi Jadwal Pelaksanaan Sidang
        </span>
        <span class="badge" style="background:#fef3c7;color:#d97706;border:1px solid #fde68a;">Belum Dijadwalkan</span>
      </div>
      <div style="display:flex;flex-direction:column;gap:10px;font-size:13px;">
        <div style="display:flex;justify-content:space-between;border-bottom:1px solid #f1f5f9;padding-bottom:8px;">
          <span style="color:#64748b;">Periode Pendaftaran:</span>
          <span style="font-weight:600;">20 Jan — 03 Feb 2026</span>
        </div>
        <div style="display:flex;justify-content:space-between;border-bottom:1px solid #f1f5f9;padding-bottom:8px;">
          <span style="color:#64748b;">Pelaksanaan Sidang:</span>
          <span style="font-weight:600;">10 — 21 Feb 2026</span>
        </div>
        <div style="display:flex;justify-content:space-between;border-bottom:1px solid #f1f5f9;padding-bottom:8px;">
          <span style="color:#64748b;">Lokasi Sidang:</span>
          <span style="font-weight:600;">Lab Bengkel Koding / Daring</span>
        </div>
        <div style="display:flex;justify-content:space-between;">
          <span style="color:#64748b;">Tanggal Sidang Saya:</span>
          <span style="font-weight:700;color:#d97706;">Belum Ditentukan</span>
        </div>
      </div>
    </div>

    <!-- Daftar Penguji & Mentor Mitra -->
    <div class="card" style="padding:22px;">
      <div class="card-header" style="margin-bottom:14px;">
        <span class="card-title" style="font-size:14px;display:flex;align-items:center;gap:8px;">
          <i data-lucide="users" style="color:var(--primary);"></i> Dosen Penguji &amp; Mentor Mitra Penilai
        </span>
        <span class="badge badge-success">Ditetapkan</span>
      </div>
      <div style="display:flex;flex-direction:column;gap:10px;">
        <div style="display:flex;align-items:center;gap:12px;padding:10px;background:#f8fafc;border-radius:8px;">
          <div style="width:36px;height:36px;border-radius:8px;background:#eff6ff;color:var(--primary);display:flex;align-items:center;justify-content:center;font-weight:700;font-size:13px;flex-shrink:0;">RA</div>
          <div>
            <div style="font-size:13px;font-weight:700;color:#0f172a;">Dr. Ricardus Anggi, M.Kom</div>
            <div style="font-size:11px;color:#64748b;">Penguji Akademis 1 &bull; DPL Resmi UDI</div>
          </div>
          <span class="badge badge-primary" style="margin-left:auto;font-size:10px;">40%</span>
        </div>
        <div style="display:flex;align-items:center;gap:12px;padding:10px;background:#f8fafc;border-radius:8px;">
          <div style="width:36px;height:36px;border-radius:8px;background:#f0fdf4;color:#16a34a;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:13px;flex-shrink:0;">EM</div>
          <div>
            <div style="font-size:13px;font-weight:700;color:#0f172a;">Dr. Ir. Edi Mulyanto, M.Kom</div>
            <div style="font-size:11px;color:#64748b;">Penguji Akademis 2 &bull; Kaprodi</div>
          </div>
          <span class="badge badge-success" style="margin-left:auto;font-size:10px;">30%</span>
        </div>
        <div style="display:flex;align-items:center;gap:12px;padding:10px;background:#fffbeb;border-radius:8px;">
          <div style="width:36px;height:36px;border-radius:8px;background:#fef3c7;color:#d97706;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:13px;flex-shrink:0;">FN</div>
          <div>
            <div style="font-size:13px;font-weight:700;color:#0f172a;">Fajar Nugraha, S.Kom., M.T.</div>
            <div style="font-size:11px;color:#64748b;">Penilai Kinerja Mitra &bull; PIC Bengkel Koding</div>
          </div>
          <span class="badge badge-warning" style="margin-left:auto;font-size:10px;">30%</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Pratinjau Rekapitulasi Nilai Evaluasi Akhir (40-30-30) -->
  <div class="card" style="padding:22px;">
    <div class="card-header" style="margin-bottom:16px;">
      <span class="card-title" style="font-size:15px;display:flex;align-items:center;gap:8px;">
        <i data-lucide="bar-chart-3" style="color:var(--primary);width:18px;height:18px;"></i>
        Pratinjau Rekapitulasi Nilai Evaluasi Akhir (Formula Bobot 40-30-30)
      </span>
      <span class="badge badge-muted">Belum Tersedia</span>
    </div>

    <!-- Visualisasi Komponen Nilai -->
    <div class="grid grid-3" style="gap:14px;margin-bottom:18px;">
      <div style="padding:16px;background:#eff6ff;border:1px solid #bfdbfe;border-radius:10px;text-align:center;">
        <div style="font-size:28px;font-weight:800;color:var(--primary);">40%</div>
        <div style="font-size:13px;font-weight:700;color:#1e40af;margin-top:4px;">Nilai Laporan Akademis</div>
        <div style="font-size:11px;color:#3b82f6;margin-top:2px;">Kelengkapan &amp; kualitas laporan akhir</div>
        <div style="font-size:14px;font-weight:700;color:#94a3b8;margin-top:12px;font-style:italic;">— Menunggu —</div>
      </div>
      <div style="padding:16px;background:#f0fdf4;border:1px solid #bbf7d0;border-radius:10px;text-align:center;">
        <div style="font-size:28px;font-weight:800;color:#16a34a;">30%</div>
        <div style="font-size:13px;font-weight:700;color:#166534;margin-top:4px;">Nilai Penguji Akademis</div>
        <div style="font-size:11px;color:#22c55e;margin-top:2px;">Presentasi &amp; tanya jawab majelis</div>
        <div style="font-size:14px;font-weight:700;color:#94a3b8;margin-top:12px;font-style:italic;">— Menunggu —</div>
      </div>
      <div style="padding:16px;background:#fffbeb;border:1px solid #fde68a;border-radius:10px;text-align:center;">
        <div style="font-size:28px;font-weight:800;color:#d97706;">30%</div>
        <div style="font-size:13px;font-weight:700;color:#92400e;margin-top:4px;">Nilai Kinerja Mitra</div>
        <div style="font-size:11px;color:#f59e0b;margin-top:2px;">Penilaian PIC atas kontribusi proyek</div>
        <div style="font-size:14px;font-weight:700;color:#94a3b8;margin-top:12px;font-style:italic;">— Menunggu —</div>
      </div>
    </div>

    <!-- Nilai Akhir Final -->
    <div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;padding:16px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;">
      <div>
        <div style="font-size:13px;color:#64748b;margin-bottom:2px;">Nilai Akhir Evaluasi MBKM (Gabungan 40+30+30%):</div>
        <div style="font-size:28px;font-weight:800;color:#94a3b8;font-style:italic;">Belum Tersedia</div>
      </div>
      <div style="text-align:right;">
        <div style="font-size:12px;color:#64748b;margin-bottom:4px;">Nilai akan tersedia setelah sidang selesai dinilai</div>
        <span class="badge" style="background:#f3e8ff;color:#7c3aed;border:1px solid #e9d5ff;"><i data-lucide="clock" style="width:11px;height:11px;"></i> Menunggu Pelaksanaan Sidang</span>
      </div>
    </div>
  </div>

</div>

  </div>
</MahasiswaShell>
