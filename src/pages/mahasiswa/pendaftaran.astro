---
// src/pages/mahasiswa/pendaftaran.astro
import MahasiswaShell from "../../layouts/MahasiswaShell.astro";
import DetailStepper from "../../components/mahasiswa/pendaftaran/DetailStepper.astro";
import TahapPendaftaranReview from "../../components/mahasiswa/pendaftaran/TahapPendaftaranReview.astro";
import DetailSidebar from "../../components/mahasiswa/pendaftaran/DetailSidebar.astro";
import { mockDaftarFormMBKM } from "../../data/mahasiswa/pendaftaranData";
---

<MahasiswaShell
  title="Pendaftaran MBKM | Mahasiswa - FIK Udinus"
  activeNav="pendaftaran"
  pageTitle="Pendaftaran MBKM"
  breadcrumb="Status & Alur Pendaftaran"
>
  <div
    class="space-y-4"
    @mouseup.window="dragEnabledId = null"
    x-data={`{
      currentStage: new URLSearchParams(window.location.search).get('stage') || 'pendaftaran',
      selectedProgram: new URLSearchParams(window.location.search).get('program') || 'bk',
      expandedFormId: new URLSearchParams(window.location.search).get('program') || 'bk',
      hasilSubState: (new URLSearchParams(window.location.search).get('status') === 'belum_lolos') ? 'belum_lolos' : 'lolos',
      stages: ['pendaftaran', 'berkas', 'wawancara', 'hasil'],
      daftarFormMBKM: ${JSON.stringify(mockDaftarFormMBKM)},
      editingFormId: null,
      draggedIndex: null,
      isDragOver: null,
      dragEnabledId: null,
      setStage(s) { this.currentStage = s; },
      stageIndex(k) { return this.stages.indexOf(k); },
      isStepDone(k) { return this.stageIndex(this.currentStage) > this.stageIndex(k); },
      isStepActive(k) { return this.currentStage === k; },
      isStepPending(k) { return this.stageIndex(this.currentStage) < this.stageIndex(k); },
      toggleExpand(id) {
        this.expandedFormId = this.expandedFormId === id ? null : id;
        this.selectedProgram = id;
      },
      dragStart(e, idx) {
        this.draggedIndex = idx;
        e.dataTransfer.effectAllowed = 'move';
        e.dataTransfer.setData('text/plain', String(idx));
      },
      dragOver(e, idx) {
        if (this.draggedIndex === null) return;
        this.isDragOver = idx;
      },
      dragLeave(e, idx) {
        if (this.isDragOver === idx) this.isDragOver = null;
      },
      dragDrop(e, targetIdx) {
        if (this.draggedIndex === null || this.draggedIndex === targetIdx) {
          this.dragEnd();
          return;
        }
        const moved = this.daftarFormMBKM.splice(this.draggedIndex, 1)[0];
        this.daftarFormMBKM.splice(targetIdx, 0, moved);
        this.selectedProgram = moved.id;
        this.dragEnd();
      },
      dragEnd() {
        this.draggedIndex = null;
        this.isDragOver = null;
        this.dragEnabledId = null;
      },
      saveDokumenProgram(id) { this.editingFormId = null; alert('Dokumen berkas formulir berhasil diperbarui dan disimpan!'); },
      canAddLampiran(item) { return !item.isClosed && (!item.dokumen.lampiran || item.dokumen.lampiran.length < 3); },
      tambahLampiran(item) { if (!item.dokumen.lampiran) item.dokumen.lampiran = []; if (item.dokumen.lampiran.length < 3) { if (this.editingFormId !== item.id) this.editingFormId = item.id; item.dokumen.lampiran.push(''); } },
      hapusLampiran(item, idx) { if (item.dokumen.lampiran) item.dokumen.lampiran.splice(idx, 1); }
    }`}
  >
    <!-- Header Halaman (Selaras Dashboard) -->
    <header class="mb-4 flex flex-col sm:flex-row sm:items-center justify-between gap-4 shrink-0">
      <div>
        <h2 class="text-xl font-normal text-[#09090b] tracking-tight">Detail Status & Alur Pendaftaran MBKM</h2>
        <p class="text-sm text-[#71717a] mt-0.5">Pantau progres formulir pendaftaran, verifikasi berkas, wawancara, dan hasil akhir penempatan.</p>
      </div>
      <a
        href="/mahasiswa/dashboard"
        class="inline-flex items-center gap-1.5 h-8 px-3 border border-[#e4e4e7] bg-white hover:bg-[#f4f4f5] text-[#09090b] text-xs font-medium rounded-md transition-colors self-start sm:self-auto shrink-0 shadow-none"
      >
        <i data-lucide="arrow-left" class="w-3.5 h-3.5 text-[#71717a]"></i>
        <span>Kembali ke Dashboard</span>
      </a>
    </header>

    <!-- Stepper Tracker 5 Tahap -->
    <DetailStepper />

    <!-- Layout 2 Kolom (Selaras Grid Dashboard) -->
    <section class="grid gap-4 lg:grid-cols-3 items-start">
      <div class="lg:col-span-2">
        <TahapPendaftaranReview />
      </div>
      <aside>
        <DetailSidebar />
      </aside>
    </section>
  </div>
</MahasiswaShell>
