---
// src/pages/mahasiswa/pendaftaran.astro
import MahasiswaShell from '../../layouts/MahasiswaShell.astro';
---

<MahasiswaShell
  title="Form Pendaftaran MBKM | Mahasiswa - FIK Udinus"
  activeNav="pendaftaran"
  pageTitle="Form Pendaftaran MBKM (Filter 3 Tahap Mandatori)"
  breadcrumb="Form Pendaftaran"
  subtitle="Verifikasi prasyarat akademik, kelayakan EWS, dan unggah berkas pendaftaran MBKM."
>
  <div id="view-pendaftaran" class="w-full">
<!-- Form Pendaftaran MBKM (Filter 3 Tahap Mandatori & Standarisasi Kaku Sistem) -->
<div style="margin-bottom:24px;">

  <!-- Controller Uji Coba Status EWS (Simulator Kelayakan Akademik) -->
  <div style="background:#f8fafc;border:1px dashed #cbd5e1;border-radius:8px;padding:10px 14px;margin-bottom:18px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;font-size:12px;">
    <div style="display:flex;align-items:center;gap:6px;color:#475569;">
      <i data-lucide="sliders" style="width:14px;height:14px;color:var(--primary);"></i>
      <span><strong>Simulator Sistem EWS:</strong> Uji kondisi kelayakan mahasiswa</span>
    </div>
    <div style="display:flex;align-items:center;gap:8px;">
      <button class="btn btn-sm btn-outline" id="sim-btn-memenuhi" onclick="simulateEWS(true)" style="background:#ecfdf5;color:#047857;border-color:#a7f3d0;font-weight:600;">
        <i data-lucide="check" style="width:13px;height:13px;"></i> Status: Memenuhi Syarat (IPK 3.72, 104 SKS)
      </button>
      <button class="btn btn-sm btn-outline" id="sim-btn-tidak" onclick="simulateEWS(false)" style="color:#b91c1c;border-color:#fecaca;font-weight:600;">
        <i data-lucide="x" style="width:13px;height:13px;"></i> Simulasi: Tidak Memenuhi (Terkunci Otomatis)
      </button>
    </div>
  </div>

  <!-- KONDISI A: TIDAK LOLOS SYARAT (FORM TERKUNCI & PENDAFTARAN DIBATALKAN OTOMATIS) -->
  <div id="pendaftaran-locked-container" style="display:none;">
    <div class="alert alert-destructive" style="margin-bottom:20px;padding:18px;border-radius:10px;">
      <div style="display:flex;gap:14px;align-items:flex-start;">
        <div style="width:40px;height:40px;border-radius:8px;background:#fee2e2;color:#ef4444;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
          <i data-lucide="lock" style="width:22px;height:22px;"></i>
        </div>
        <div style="flex:1;">
          <div style="font-size:16px;font-weight:700;color:#991b1b;margin-bottom:4px;">
            Pendaftaran Terkunci Otomatis &mdash; Syarat Akademik Belum Terpenuhi
          </div>
          <div style="font-size:13px;color:#7f1d1d;line-height:1.6;">
            Sistem validasi terpadu Early Warning System (EWS) FIK mendeteksi bahwa profil akademik Anda belum memenuhi ambang batas minimum pendaftaran program Kampus Berdampak (MBKM):
            <div style="background:#fff;border:1px solid #fecaca;border-radius:6px;padding:10px 14px;margin:10px 0;">
              <ul style="margin:0 0 0 16px;padding:0;list-style:disc;font-size:12.5px;color:#b91c1c;">
                <li><strong>Total SKS Tempuh:</strong> Minimal &ge; 80 SKS (atau Semester &ge; 5). <em>Data Anda: 68 SKS (Semester 4)</em> &mdash; <span style="font-weight:700;">Belum Memenuhi</span></li>
                <li><strong>IPK Kumulatif:</strong> Minimal &ge; 3.00. <em>Data Anda: 2.85</em> &mdash; <span style="font-weight:700;">Belum Memenuhi</span></li>
              </ul>
            </div>
            Sesuai Standarisasi Kaku Sistem FIK, formulir terkunci secara permanen pada gelombang ini dan pendaftaran dibatalkan otomatis. Silakan konsultasikan progres perkuliahan Anda dengan Dosen Pembimbing Akademik (DPA) untuk persiapan gelombang berikutnya.
          </div>
          <div style="margin-top:14px;display:flex;gap:10px;">
            <a href="#dashboard" class="btn btn-sm btn-outline" style="background:#fff;">Kembali ke Dashboard</a>
            <button class="btn btn-sm btn-outline" onclick="simulateEWS(true)" style="background:#fff;color:var(--primary);">Coba Status Memenuhi Syarat</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- KONDISI B: LOLOS SYARAT (FILTER 3 TAHAP MANDATORI) -->
  <div id="pendaftaran-form-container">
    
    <!-- Stepper Header 3 Tahap Mandatori -->
    <div class="card" style="padding:16px 20px;margin-bottom:20px;">
      <div style="display:flex;align-items:center;justify-content:space-between;max-width:760px;margin:0 auto;position:relative;">
        <div style="position:absolute;top:18px;left:40px;right:40px;height:2px;background:#e2e8f0;z-index:1;"></div>
        <div id="stepper-progress-line" style="position:absolute;top:18px;left:40px;width:0%;height:2px;background:var(--primary);z-index:2;transition:width 0.3s ease;"></div>

        <!-- Step 1 Indicator -->
        <div class="step-item active" id="step-1-indicator" style="position:relative;z-index:3;text-align:center;width:80px;">
          <div class="step-circle" style="width:36px;height:36px;border-radius:50%;background:var(--primary);color:#fff;display:flex;align-items:center;justify-content:center;margin:0 auto 8px;font-weight:700;box-shadow:0 0 0 4px #eef2ff;">1</div>
          <div style="font-size:11px;font-weight:700;color:var(--primary);">Akademik</div>
        </div>

        <!-- Step 2 Indicator -->
        <div class="step-item" id="step-2-indicator" style="position:relative;z-index:3;text-align:center;width:80px;">
          <div class="step-circle" style="width:36px;height:36px;border-radius:50%;background:#fff;border:2px solid #e2e8f0;color:#64748b;display:flex;align-items:center;justify-content:center;margin:0 auto 8px;font-weight:700;">2</div>
          <div style="font-size:11px;font-weight:600;color:#64748b;">Berkas</div>
        </div>

        <!-- Step 3 Indicator -->
        <div class="step-item" id="step-3-indicator" style="position:relative;z-index:3;text-align:center;width:80px;">
          <div class="step-circle" style="width:36px;height:36px;border-radius:50%;background:#fff;border:2px solid #e2e8f0;color:#64748b;display:flex;align-items:center;justify-content:center;margin:0 auto 8px;font-weight:700;">3</div>
          <div style="font-size:11px;font-weight:600;color:#64748b;">SuReKom</div>
        </div>
      </div>
    </div>

    <form id="form-pendaftaran-mbkm" onsubmit="handleFinalSubmit(event)">
      
      <!-- TAHAP 1: IDENTITAS DIRI & SYARAT AKADEMIK (AUTO EWS) -->
      <div id="step-1-content" class="step-section">
        <div class="card" style="margin-bottom:20px;">
          <div style="border-bottom:1px solid #f1f5f9;padding-bottom:12px;margin-bottom:16px;display:flex;justify-content:space-between;align-items:center;">
            <h3 style="font-size:15px;font-weight:700;margin:0;display:flex;align-items:center;gap:8px;">
              <i data-lucide="user-check" style="width:18px;height:18px;color:var(--primary);"></i>
              Tahap 1: Syarat Akademik (Identitas Diri Database EWS/UDI)
            </h3>
            <span class="badge badge-success" style="font-size:10px;padding:2px 8px;">Auto-Verified</span>
          </div>

          <div class="grid grid-2" style="margin-bottom:20px;">
            <div class="form-group">
              <label class="form-label">Nomor Induk Mahasiswa (NIM)</label>
              <input type="text" class="form-control" value="A11.2022.14253" readonly style="background:#f8fafc;font-weight:600;color:#334155;" />
            </div>
            <div class="form-group">
              <label class="form-label">Nama Lengkap Mahasiswa</label>
              <input type="text" class="form-control" value="Ahmad Rizky Pratama" readonly style="background:#f8fafc;font-weight:600;color:#334155;" />
            </div>
            <div class="form-group">
              <label class="form-label">Program Studi / Fakultas</label>
              <input type="text" class="form-control" value="S1 Teknik Informatika — Fakultas Ilmu Komputer" readonly style="background:#f8fafc;font-weight:600;color:#334155;" />
            </div>
            <div class="form-group">
              <label class="form-label">Statistik Kelayakan Akademik (EWS)</label>
              <div style="background:#f0f9ff;border:1px solid #bae6fd;border-radius:6px;padding:8px 12px;display:flex;gap:12px;">
                <div style="text-align:center;">
                  <div style="font-size:10px;color:#0369a1;text-transform:uppercase;font-weight:700;">IPK</div>
                  <div style="font-size:14px;font-weight:800;color:#0c4a6e;">3.72</div>
                </div>
                <div style="width:1px;background:#bae6fd;"></div>
                <div style="text-align:center;">
                  <div style="font-size:10px;color:#0369a1;text-transform:uppercase;font-weight:700;">Total SKS</div>
                  <div style="font-size:14px;font-weight:800;color:#0c4a6e;">104 SKS</div>
                </div>
                <div style="width:1px;background:#bae6fd;"></div>
                <div style="text-align:center;">
                  <div style="font-size:10px;color:#0369a1;text-transform:uppercase;font-weight:700;">Semester</div>
                  <div style="font-size:14px;font-weight:800;color:#0c4a6e;">6</div>
                </div>
              </div>
            </div>
          </div>
          
          <div style="background:#f1f5f9;border-radius:8px;padding:12px 16px;font-size:12px;color:#475569;line-height:1.5;">
            <p style="margin:0;"><strong>Sistem Standarisasi Kaku:</strong> Data di atas disinkronisasi secara <em>real-time</em> dari database akademik. Mahasiswa tidak diizinkan mengubah data identitas secara manual pada formulir ini.</p>
          </div>

          <div style="margin-top:24px;display:flex;justify-content:flex-end;">
            <button type="button" class="btn btn-primary" onclick="nextStep(2)">
              Lanjut ke Tahap 2: Portofolio & Berkas
              <i data-lucide="arrow-right" style="width:16px;height:16px;"></i>
            </button>
          </div>
        </div>
      </div>

      <!-- TAHAP 2: PORTOFOLIO & BERKAS (SINGLE G-DRIVE LINK) -->
      <div id="step-2-content" class="step-section" style="display:none;">
        <div class="card" style="margin-bottom:20px;">
          <div style="border-bottom:1px solid #f1f5f9;padding-bottom:12px;margin-bottom:16px;">
            <h3 style="font-size:15px;font-weight:700;margin:0;display:flex;align-items:center;gap:8px;">
              <i data-lucide="folder-open" style="width:18px;height:18px;color:var(--primary);"></i>
              Tahap 2: Portofolio & Berkas Persyaratan
            </h3>
          </div>

          <div class="alert alert-info" style="margin-bottom:20px;font-size:12px;">
            <i data-lucide="info" style="width:18px;height:18px;"></i>
            <div>Masukkan <strong>satu tautan tunggal</strong> folder Google Drive yang berisi: CV ATS, Portofolio Karya, dan Sertifikat Keahlian. Pastikan izin akses disetel ke <strong>View-Only (Publik)</strong>.</div>
          </div>

          <div class="form-group">
            <label class="form-label">Tautan Folder Google Drive <span class="required">*</span></label>
            <div style="position:relative;">
              <i data-lucide="link" style="position:absolute;left:12px;top:11px;width:16px;height:16px;color:#94a3b8;"></i>
              <input type="url" class="form-control" id="drive-link" placeholder="https://drive.google.com/drive/folders/..." required style="padding-left:38px;" />
            </div>
            <p style="font-size:11px;color:#64748b;margin-top:6px;">Contoh: https://drive.google.com/drive/folders/1A2b3C4d5E6f7G8h9I0jK</p>
          </div>

          <div style="margin-top:24px;display:flex;justify-content:space-between;">
            <button type="button" class="btn btn-outline" onclick="nextStep(1)">
              <i data-lucide="arrow-left" style="width:16px;height:16px;"></i>
              Kembali
            </button>
            <button type="button" class="btn btn-primary" onclick="nextStep(3)">
              Lanjut ke Tahap 3: Kesepakatan & SuReKom
              <i data-lucide="arrow-right" style="width:16px;height:16px;"></i>
            </button>
          </div>
        </div>
      </div>

      <!-- TAHAP 3: KESEPAKATAN & PERMOHONAN SUREKOM -->
      <div id="step-3-content" class="step-section" style="display:none;">
        <div class="card" style="margin-bottom:20px;">
          <div style="border-bottom:1px solid #f1f5f9;padding-bottom:12px;margin-bottom:16px;">
            <h3 style="font-size:15px;font-weight:700;margin:0;display:flex;align-items:center;gap:8px;">
              <i data-lucide="file-signature" style="width:18px;height:18px;color:var(--primary);"></i>
              Tahap 3: Kesepakatan Program & Permohonan SuReKom
            </h3>
          </div>

          <!-- Butir Kesepakatan -->
          <div style="margin-bottom:24px;">
            <label class="form-label" style="margin-bottom:10px;display:block;">Pernyataan Kesepakatan Mahasiswa <span class="required">*</span></label>
            <div style="display:flex;flex-direction:column;gap:10px;">
              <label style="display:flex;gap:10px;padding:12px;border:1px solid #e2e8f0;border-radius:8px;cursor:pointer;background:#f8fafc;">
                <input type="checkbox" name="agreement" required style="width:18px;height:18px;margin-top:2px;" />
                <span style="font-size:12.5px;color:#334155;line-height:1.5;">Saya berkomitmen mengikuti seluruh rangkaian program mitra hingga selesai dan menaati peraturan akademik FIK UDINUS.</span>
              </label>
              <label style="display:flex;gap:10px;padding:12px;border:1px solid #e2e8f0;border-radius:8px;cursor:pointer;background:#f8fafc;">
                <input type="checkbox" name="agreement" required style="width:18px;height:18px;margin-top:2px;" />
                <span style="font-size:12.5px;color:#334155;line-height:1.5;">Saya bersedia melaporkan logbook kegiatan secara rutin dan melakukan konsultasi dengan Dosen Pembimbing Lapangan (DPL).</span>
              </label>
            </div>
          </div>

          <!-- Pemilihan Konversi Mata Kuliah -->
          <div style="margin-bottom:24px;">
            <div style="display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:10px;">
              <label class="form-label" style="margin-bottom:0;">Usulan Mata Kuliah Konversi (Maks. 20 SKS) <span class="required">*</span></label>
              <span id="sks-counter-badge" class="badge" style="background:#e0f2fe;color:#0369a1;font-weight:700;">0 / 20 SKS</span>
            </div>
            <div style="border:1px solid #e2e8f0;border-radius:8px;max-height:200px;overflow-y:auto;padding:8px;">
              <div style="display:flex;flex-direction:column;gap:4px;">
                <!-- Matkul Item 1 -->
                <label style="display:flex;align-items:center;justify-content:space-between;padding:8px 12px;border-radius:6px;cursor:pointer;border:1px solid transparent;" class="matkul-item">
                  <div style="display:flex;align-items:center;gap:10px;">
                    <input type="checkbox" class="matkul-checkbox" value="4" onchange="updateSKS()" />
                    <span style="font-size:12px;color:#334155;font-weight:600;">Kecerdasan Buatan & ML</span>
                  </div>
                  <span style="font-size:11px;font-weight:700;color:#64748b;">4 SKS</span>
                </label>
                <!-- Matkul Item 2 -->
                <label style="display:flex;align-items:center;justify-content:space-between;padding:8px 12px;border-radius:6px;cursor:pointer;border:1px solid transparent;" class="matkul-item">
                  <div style="display:flex;align-items:center;gap:10px;">
                    <input type="checkbox" class="matkul-checkbox" value="4" onchange="updateSKS()" />
                    <span style="font-size:12px;color:#334155;font-weight:600;">Pemrograman Web Lanjut</span>
                  </div>
                  <span style="font-size:11px;font-weight:700;color:#64748b;">4 SKS</span>
                </label>
                <!-- Matkul Item 3 -->
                <label style="display:flex;align-items:center;justify-content:space-between;padding:8px 12px;border-radius:6px;cursor:pointer;border:1px solid transparent;" class="matkul-item">
                  <div style="display:flex;align-items:center;gap:10px;">
                    <input type="checkbox" class="matkul-checkbox" value="3" onchange="updateSKS()" />
                    <span style="font-size:12px;color:#334155;font-weight:600;">Sistem Basis Data</span>
                  </div>
                  <span style="font-size:11px;font-weight:700;color:#64748b;">3 SKS</span>
                </label>
                <!-- Matkul Item 4 -->
                <label style="display:flex;align-items:center;justify-content:space-between;padding:8px 12px;border-radius:6px;cursor:pointer;border:1px solid transparent;" class="matkul-item">
                  <div style="display:flex;align-items:center;gap:10px;">
                    <input type="checkbox" class="matkul-checkbox" value="3" onchange="updateSKS()" />
                    <span style="font-size:12px;color:#334155;font-weight:600;">Analisis & Desain Sistem</span>
                  </div>
                  <span style="font-size:11px;font-weight:700;color:#64748b;">3 SKS</span>
                </label>
                <!-- Matkul Item 5 -->
                <label style="display:flex;align-items:center;justify-content:space-between;padding:8px 12px;border-radius:6px;cursor:pointer;border:1px solid transparent;" class="matkul-item">
                  <div style="display:flex;align-items:center;gap:10px;">
                    <input type="checkbox" class="matkul-checkbox" value="3" onchange="updateSKS()" />
                    <span style="font-size:12px;color:#334155;font-weight:600;">Etika Profesi TI</span>
                  </div>
                  <span style="font-size:11px;font-weight:700;color:#64748b;">3 SKS</span>
                </label>
                <!-- Matkul Item 6 -->
                <label style="display:flex;align-items:center;justify-content:space-between;padding:8px 12px;border-radius:6px;cursor:pointer;border:1px solid transparent;" class="matkul-item">
                  <div style="display:flex;align-items:center;gap:10px;">
                    <input type="checkbox" class="matkul-checkbox" value="3" onchange="updateSKS()" />
                    <span style="font-size:12px;color:#334155;font-weight:600;">Komputasi Awan</span>
                  </div>
                  <span style="font-size:11px;font-weight:700;color:#64748b;">3 SKS</span>
                </label>
              </div>
            </div>
          </div>

          <!-- Permohonan SuReKom -->
          <div style="background:#fff7ed;border:1px solid #ffedd5;border-radius:10px;padding:16px;">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">
              <h4 style="font-size:13px;font-weight:700;color:#9a3412;margin:0;display:flex;align-items:center;gap:8px;">
                <i data-lucide="file-text" style="width:16px;height:16px;"></i>
                Draft Permohonan SuReKom Dekanat
              </h4>
              <button type="button" class="btn btn-sm" style="background:#f97316;color:#fff;border:none;font-weight:700;font-size:11px;padding:4px 10px;" onclick="generateDraft()">
                Generate Draft
              </button>
            </div>
            <p style="font-size:11.5px;color:#c2410c;line-height:1.5;margin-bottom:0;" id="surekom-msg">Klik tombol <strong>Generate Draft</strong> untuk menyiapkan draf surat rekomendasi dekanat secara otomatis.</p>
          </div>

          <div style="margin-top:24px;display:flex;justify-content:space-between;">
            <button type="button" class="btn btn-outline" onclick="nextStep(2)">
              <i data-lucide="arrow-left" style="width:16px;height:16px;"></i>
              Kembali
            </button>
            <button type="submit" class="btn btn-primary" id="btn-submit-pendaftaran">
              Kirim Pendaftaran (Single-Application)
              <i data-lucide="send" style="width:16px;height:16px;"></i>
            </button>
          </div>
        </div>
      </div>

    </form>
  </div>
</div>

<script>
  // Logika Filter 3 Tahap Mandatori
  let currentPendaftaranStep = 1;
  let totalSKS = 0;
  let isDraftGenerated = false;

  function nextStep(step) {
    if (step === 3 && totalSKS === 0) {
      alert('Pilih minimal 1 mata kuliah konversi.');
      return;
    }
    
    // Hide all sections
    document.getElementById('step-1-content').style.display = 'none';
    document.getElementById('step-2-content').style.display = 'none';
    document.getElementById('step-3-content').style.display = 'none';
    
    // Show target section
    document.getElementById(`step-${step}-content`).style.display = 'block';
    
    // Update Stepper
    updateStepperUI(step);
    currentPendaftaranStep = step;
    
    if (typeof lucide !== 'undefined') lucide.createIcons();
  }

  function updateStepperUI(step) {
    const line = document.getElementById('stepper-progress-line');
    const width = (step - 1) * 50;
    line.style.width = `${width}%`;
    
    for (let i = 1; i <= 3; i++) {
      const indicator = document.getElementById(`step-${i}-indicator`);
      const circle = indicator.querySelector('.step-circle');
      const label = indicator.querySelector('div:last-child');
      
      if (i < step) {
        circle.style.background = '#10b981';
        circle.style.borderColor = '#10b981';
        circle.style.color = '#fff';
        circle.innerHTML = '<i data-lucide="check" style="width:18px;height:18px;"></i>';
        circle.style.boxShadow = 'none';
        label.style.color = '#10b981';
      } else if (i === step) {
        circle.style.background = 'var(--primary)';
        circle.style.borderColor = 'var(--primary)';
        circle.style.color = '#fff';
        circle.innerHTML = i;
        circle.style.boxShadow = '0 0 0 4px #eef2ff';
        label.style.color = 'var(--primary)';
        label.style.fontWeight = '700';
      } else {
        circle.style.background = '#fff';
        circle.style.borderColor = '#e2e8f0';
        circle.style.color = '#64748b';
        circle.innerHTML = i;
        circle.style.boxShadow = 'none';
        label.style.color = '#64748b';
        label.style.fontWeight = '600';
      }
    }
  }

  function updateSKS() {
    const checkboxes = document.querySelectorAll('.matkul-checkbox');
    totalSKS = 0;
    checkboxes.forEach(cb => {
      if (cb.checked) {
        totalSKS += parseInt(cb.value);
        cb.closest('.matkul-item').style.background = '#f0f9ff';
        cb.closest('.matkul-item').style.borderColor = '#bae6fd';
      } else {
        cb.closest('.matkul-item').style.background = 'transparent';
        cb.closest('.matkul-item').style.borderColor = 'transparent';
      }
    });
    
    const badge = document.getElementById('sks-counter-badge');
    badge.textContent = `${totalSKS} / 20 SKS`;
    
    if (totalSKS > 20) {
      badge.style.background = '#fee2e2';
      badge.style.color = '#b91c1c';
      document.getElementById('btn-submit-pendaftaran').disabled = true;
      document.getElementById('btn-submit-pendaftaran').style.opacity = '0.5';
    } else {
      badge.style.background = '#e0f2fe';
      badge.style.color = '#0369a1';
      document.getElementById('btn-submit-pendaftaran').disabled = false;
      document.getElementById('btn-submit-pendaftaran').style.opacity = '1';
    }
  }

  function generateDraft() {
    isDraftGenerated = true;
    const msg = document.getElementById('surekom-msg');
    msg.innerHTML = '<i data-lucide="check-circle" style="width:13px;height:13px;display:inline-block;vertical-align:middle;margin-right:4px;"></i> <strong>Draf Berhasil Di-generate!</strong> Dokumen draf SuReKom Dekanat siap dikirimkan bersama pendaftaran.';
    msg.style.color = '#15803d';
    if (typeof lucide !== 'undefined') lucide.createIcons();
  }

  function simulateEWS(eligible) {
    const locked = document.getElementById('pendaftaran-locked-container');
    const form = document.getElementById('pendaftaran-form-container');
    const btnOk = document.getElementById('sim-btn-memenuhi');
    const btnNo = document.getElementById('sim-btn-tidak');
    
    if (eligible) {
      locked.style.display = 'none';
      form.style.display = 'block';
      btnOk.style.background = '#ecfdf5';
      btnOk.style.borderColor = '#a7f3d0';
      btnNo.style.background = '#fff';
      btnNo.style.borderColor = '#fecaca';
      nextStep(1);
    } else {
      locked.style.display = 'block';
      form.style.display = 'none';
      btnOk.style.background = '#fff';
      btnOk.style.borderColor = '#a7f3d0';
      btnNo.style.background = '#fef2f2';
      btnNo.style.borderColor = '#fecaca';
    }
    if (typeof lucide !== 'undefined') lucide.createIcons();
  }

  function handleFinalSubmit(e) {
    e.preventDefault();
    if (!isDraftGenerated) {
      alert('Anda harus men-generate draf SuReKom terlebih dahulu!');
      return;
    }
    if (totalSKS > 20) {
      alert('Total SKS konversi tidak boleh melebihi 20 SKS!');
      return;
    }
    
    alert('Pendaftaran Berhasil Dikirim!\nAturan Single-Application Active: Anda tidak dapat membuat pendaftaran baru sampai proses ini selesai.');
    // Integrasi dengan status pendaftaran di dashboard
    if (window.setTrackingStatus) window.setTrackingStatus('pending');
    if (window.switchTab) window.switchTab('status');
  }
</script>

  </div>
</MahasiswaShell>
