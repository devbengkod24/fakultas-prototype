---
// src/pages/mahasiswa/dosen-pembimbing.astro
import MahasiswaShell from '../../layouts/MahasiswaShell.astro';
---

<MahasiswaShell
  title="Dosen Pembimbing | Mahasiswa - FIK Udinus"
  activeNav="dosen-pembimbing"
  pageTitle="Dosen Pembimbing Lapangan (DPL)"
  breadcrumb="Dosen Pembimbing"
>
  <section id="view-dosen-pembimbing" class="space-y-6">
    <!-- Header -->
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div>
        <h2 class="text-[20px] leading-[28px] font-normal text-[#09090b]">Dosen Pembimbing</h2>
        <p class="text-[14px] leading-[20px] text-[#71717a]">Informasi dosen pembimbing lapangan (DPL) dan jadwal bimbingan program MBKM.</p>
      </div>
    </div>

    <!-- DPL Section -->
    <div class="max-w-2xl">
      <!-- Card DPL -->
      <div class="p-5 bg-white border border-[#e4e4e7] rounded-[12px] shadow-2xs space-y-4">
        <div class="flex items-center gap-4">
          <div class="w-12 h-12 rounded-full bg-[#1063B9] text-white font-semibold text-lg flex items-center justify-center shrink-0">
            RA
          </div>
          <div>
            <h3 class="text-[15px] font-semibold text-[#09090b]">Dr. Ricardus Anggi Pramunendar, M.Kom</h3>
            <p class="text-[12px] text-[#71717a]">Dosen Pembimbing Lapangan (DPL)</p>
          </div>
        </div>
        <div class="space-y-2 text-[13px] text-[#71717a]">
          <p>Email: <a href="mailto:ricardus.anggi@dsn.dinus.ac.id" class="text-[#1063B9] hover:underline">ricardus.anggi@dsn.dinus.ac.id</a></p>
          <p>Bidang: Software Architecture, AI Systems</p>
        </div>
        <a href="https://wa.me/6281234567891" target="_blank" class="flex items-center justify-center gap-2 w-full py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold rounded-lg transition-colors">
          <i data-lucide="message-circle" class="w-4 h-4"></i> WhatsApp DPL
        </a>
      </div>
    </div>

    <!-- Jadwal Bimbingan Section -->
    <div class="bg-white border border-[#e4e4e7] rounded-[12px] p-5 shadow-2xs space-y-4">
      <h3 class="text-[14px] font-semibold text-[#09090b]">Jadwal Bimbingan</h3>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="p-4 bg-gray-50 rounded-lg border border-gray-100">
          <div class="text-xs font-semibold text-[#1063B9] uppercase mb-1">Senin</div>
          <div class="text-[14px] font-bold text-[#09090b]">10:00 — 11:30 WIB</div>
          <div class="text-[12px] text-[#71717a] mt-1">Konsultasi Progres Proyek (Daring)</div>
        </div>
        <div class="p-4 bg-gray-50 rounded-lg border border-gray-100">
          <div class="text-xs font-semibold text-[#1063B9] uppercase mb-1">Rabu</div>
          <div class="text-[14px] font-bold text-[#09090b]">13:00 — 14:00 WIB</div>
          <div class="text-[12px] text-[#71717a] mt-1">Review Logbook & DPL (Luring)</div>
        </div>
        <div class="p-4 bg-gray-50 rounded-lg border border-gray-100">
          <div class="text-xs font-semibold text-[#1063B9] uppercase mb-1">Jumat</div>
          <div class="text-[14px] font-bold text-[#09090b]">16:00 — 17:30 WIB</div>
          <div class="text-[12px] text-[#71717a] mt-1">Sprint Review (Luring)</div>
        </div>
      </div>
    </div>
  </section>
</MahasiswaShell>

