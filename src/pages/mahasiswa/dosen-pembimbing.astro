---
// src/pages/mahasiswa/dosen-pembimbing.astro
import MahasiswaShell from "../../layouts/MahasiswaShell.astro";
import { cn } from "../../utils/cn";
---

<MahasiswaShell
  title="Dosen Pembimbing | Mahasiswa - FIK Udinus"
  activeNav="dashboard"
  pageTitle="Dosen Pembimbing"
  breadcrumb="Dosen Pembimbing"
>
  <section id="view-dosen-pembimbing" class={cn("space-y-6")}>
    <div>
      <h1 class="text-lg font-semibold text-[#09090b]">Dosen Pembimbing</h1>
      <p class="text-xs text-[#71717a] leading-relaxed mt-0.5">
        Informasi pembimbing akademik dan bimbingan kegiatan MBKM mahasiswa.
      </p>
    </div>

    <div class="rounded-xl border border-[#e4e4e7] bg-white p-6 space-y-4 shadow-none">
      <div class="flex items-start gap-3.5">
        <div class="w-10 h-10 rounded-lg bg-[#fafafa] border border-[#e4e4e7] flex items-center justify-center text-[#0655a7] shrink-0">
          <i data-lucide="info" class="w-4 h-4"></i>
        </div>
        <div class="space-y-1 flex-1">
          <div class="flex items-center gap-2 flex-wrap">
            <h2 class="text-base font-semibold text-[#09090b]">Menu Dipindahkan ke Dashboard</h2>
            <span class="bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs px-2.5 py-0.5 rounded-md font-semibold">
              Terintegrasi
            </span>
          </div>
          <p class="text-sm font-medium text-[#71717a] leading-relaxed">
            Untuk merampingkan navigasi dan mempermudah pemantauan akademik, seluruh informasi Dosen Pembimbing, kontak, dan jadwal bimbingan kini telah dipusatkan langsung pada halaman utama Dashboard mahasiswa.
          </p>
        </div>
      </div>

      <div class="pt-3 border-t border-[#e4e4e7] flex items-center justify-between flex-wrap gap-3">
        <p class="text-xs text-[#71717a]">
          Silakan akses Dashboard untuk melihat kartu Dosen Pembimbing Anda.
        </p>
        <a
          href="/mahasiswa/dashboard"
          class="inline-flex items-center gap-2 h-9 px-4 rounded-md bg-[#0655a7] hover:bg-[#114d91] text-white text-xs font-semibold shadow-none transition-colors"
        >
          <i data-lucide="layout-dashboard" class="w-4 h-4"></i>
          <span>Buka Dashboard</span>
        </a>
      </div>
    </div>

    <div class="rounded-xl border border-[#e4e4e7] bg-white p-6 space-y-4">
      <div class="flex items-center justify-between pb-3 border-b border-[#e4e4e7]">
        <div class="flex items-center gap-2">
          <i data-lucide="user-check" class="w-4 h-4 text-[#0655a7]"></i>
          <h2 class="text-base font-semibold text-[#09090b]">Ringkasan Dosen Pembimbing</h2>
        </div>
        <span class="bg-[#f4f4f5] border border-[#e4e4e7] text-[#09090b] text-xs px-2.5 py-0.5 rounded-md font-semibold">
          Dospem Aktif
        </span>
      </div>

      <div class="flex items-start gap-4">
        <div class="w-12 h-12 rounded-lg bg-[#fafafa] border border-[#e4e4e7] text-[#0655a7] font-semibold text-base flex items-center justify-center shrink-0">
          AN
        </div>
        <div class="space-y-1 flex-1">
          <h3 class="text-base font-semibold text-[#09090b]">Adhitya Nugraha, S.Kom, M.CS</h3>
          <p class="text-xs text-[#71717a]">Dosen Pembimbing Program MBKM</p>
          <div class="pt-2 flex flex-wrap gap-4 text-xs text-[#71717a]">
            <span class="flex items-center gap-1.5">
              <i data-lucide="mail" class="w-4 h-4 text-[#71717a]"></i>
              <span class="text-[#09090b] font-medium">dosen.a11@udinus.ac.id</span>
            </span>
            <span class="flex items-center gap-1.5">
              <i data-lucide="building" class="w-4 h-4 text-[#71717a]"></i>
              <span class="text-[#09090b] font-medium">Fakultas Ilmu Komputer</span>
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>
</MahasiswaShell>
