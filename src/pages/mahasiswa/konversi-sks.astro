---
// src/pages/mahasiswa/konversi-sks.astro
import MahasiswaShell from "../../layouts/MahasiswaShell.astro";
---

<MahasiswaShell
  title="Konversi SKS MBKM | Mahasiswa - FIK Udinus"
  activeNav="konversi-sks"
  pageTitle="Konversi Mata Kuliah MBKM"
  breadcrumb="Konversi SKS"
>
  <div class="space-y-6" x-data="konversiFlow">
    <!-- Top Bar: Info & Tombol Reset Simulasi -->
    <div
      class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 bg-white border border-[#e4e4e7] rounded-xl p-4 shadow-2xs"
    >
      <div>
        <h2 class="text-base font-bold text-[#09090b]">
          Tahapan Konversi SKS Kampus Berdampak
        </h2>
        <p class="text-xs text-gray-500">
          Alur pengajuan, verifikasi mata kuliah ekuivalensi, hingga penerbitan
          pakta contributor.
        </p>
      </div>
      <button
        @click="resetSimulasi()"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold text-gray-600 bg-gray-100 hover:bg-gray-200 transition-colors"
        title="Reset kembali ke skenario 1 matkul decline untuk testing"
      >
        <i data-lucide="rotate-ccw" class="w-3.5 h-3.5"></i>
        <span>Reset Simulasi Demo</span>
      </button>
    </div>

    <!-- Stepper Progress Trail -->
    <div
      class="bg-white border border-[#e4e4e7] rounded-xl p-5 sm:p-6 shadow-2xs"
    >
      <div class="relative py-2">
        <div
          class="absolute top-5 left-[10%] right-[10%] h-1 bg-gray-100 rounded-full -translate-y-1/2 z-0"
        >
          <div
            class="h-full bg-[#1063B9] rounded-full transition-all duration-500"
            :style="`width: ${(currentStep - 1) * 25}%`"
          >
          </div>
        </div>

        <div class="grid grid-cols-5 relative z-10 text-[11px]">
          <template
            x-for="(step, i) in ['Pengajuan Pakta', 'Dikonfirmasi', 'Konversi SKS', 'Konfirmasi SKS', 'Pakta Contributor']"
            :key="i"
          >
            <div class="flex flex-col items-center text-center">
              <button
                type="button"
                @click="currentStep = i + 1; $nextTick(() => window.lucide && window.lucide.createIcons())"
                class="w-10 h-10 rounded-full flex items-center justify-center font-bold transition-all border-2 cursor-pointer hover:scale-105"
                :class="currentStep > i + 1 ? 'bg-white border-[#1063B9] text-[#1063B9]' : (currentStep === i + 1 ? 'bg-[#1063B9] border-[#1063B9] text-white ring-4 ring-blue-100' : 'bg-white border-[#e4e4e7] text-[#a1a1aa]')"
              >
                <i
                  x-show="currentStep > i + 1"
                  data-lucide="check"
                  class="w-5 h-5"></i>
                <span x-show="currentStep <= i + 1" x-text="i + 1"></span>
              </button>
              <span
                class="mt-2 font-medium text-[11px]"
                :class="currentStep === i + 1 ? 'text-[#1063B9] font-semibold' : (currentStep > i + 1 ? 'text-[#3f3f46]' : 'text-[#a1a1aa]')"
                x-text="step"></span>
            </div>
          </template>
        </div>
      </div>
    </div>

    <!-- CONTENT STEPS -->
    <div
      class="bg-white border border-[#e4e4e7] rounded-xl p-6 shadow-2xs min-h-[350px]"
    >
      <!-- STEP 1: PENGAJUAN PAKTA -->
      <div x-show="currentStep === 1" class="space-y-6" x-transition>
        <div class="flex items-center gap-2 pb-3 border-b border-[#e4e4e7]">
          <i data-lucide="file-text" class="w-5 h-5 text-[#1063B9]"></i>
          <h3 class="text-[15px] font-semibold text-[#09090b]">
            Tahap 1: Pengajuan Pakta Integritas
          </h3>
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          <div
            class="p-4 bg-blue-50/50 border border-blue-100 rounded-xl flex items-center justify-between"
          >
            <div class="flex items-center gap-3">
              <div
                class="w-10 h-10 bg-white rounded-lg flex items-center justify-center border border-blue-200"
              >
                <i data-lucide="file-down" class="text-[#1063B9] w-5 h-5"></i>
              </div>
              <div>
                <p class="text-sm font-bold text-[#09090b]">
                  Template Pakta Integritas
                </p>
                <p class="text-xs text-gray-500">
                  Unduh & lengkapi tanda tangan materai
                </p>
              </div>
            </div>
            <button
              class="bg-[#1063B9] hover:bg-[#0655a7] text-white px-4 py-2 rounded-lg text-xs font-bold transition-colors"
              >Download PDF</button
            >
          </div>
          <div class="space-y-4">
            <label class="text-sm font-bold block text-gray-800"
              >Upload Berkas Pakta (Scan PDF/JPG)</label
            >
            <div
              class="border-2 border-dashed border-gray-200 rounded-xl p-8 text-center hover:border-blue-400 transition-colors cursor-pointer bg-gray-50/50"
            >
              <i
                data-lucide="upload-cloud"
                class="w-10 h-10 text-[#1063B9] mx-auto mb-2"></i>
              <p class="text-xs font-semibold text-gray-700">
                Pakta_Integritas_Tandatangan.pdf
              </p>
              <p class="text-[11px] text-gray-400 mt-1">
                Berkas siap dikirimkan (2.4 MB)
              </p>
            </div>
          </div>
        </div>
        <div class="flex justify-end pt-4 border-t border-[#e4e4e7]">
          <button
            @click="submitPakta()"
            class="bg-[#1063B9] hover:bg-[#0655a7] text-white px-7 py-2.5 rounded-lg text-sm font-semibold transition-all"
          >
            Submit Pakta Integritas
          </button>
        </div>
      </div>

      <!-- STEP 2: DIKONFIRMASI -->
      <div x-show="currentStep === 2" class="space-y-6" x-transition>
        <div class="flex items-center gap-2 pb-3 border-b border-[#e4e4e7]">
          <i data-lucide="check-check" class="w-5 h-5 text-[#1063B9]"></i>
          <h3 class="text-[15px] font-semibold text-[#09090b]">
            Tahap 2: Verifikasi Pakta Integritas
          </h3>
        </div>
        <div
          class="p-5 bg-[#f4f7fc] border border-[#dbeafe] rounded-xl flex flex-col md:flex-row items-start md:items-center justify-between gap-4"
        >
          <div class="flex items-center gap-4">
            <div
              class="w-11 h-11 bg-white border border-[#e4e4e7] rounded-xl flex items-center justify-center shrink-0"
            >
              <i data-lucide="shield-check" class="w-5 h-5 text-[#1063B9]"></i>
            </div>
            <div>
              <div class="flex items-center gap-2">
                <h4 class="font-semibold text-[#09090b] text-sm">
                  Pakta Integritas Telah Diverifikasi
                </h4>
                <span
                  class="inline-flex items-center gap-1 px-2 py-0.5 bg-white border border-[#e4e4e7] text-[#3f3f46] text-[10px] font-semibold rounded-full"
                >
                  <i data-lucide="check" class="w-2.5 h-2.5 text-[#1063B9]"></i> Valid
                </span>
              </div>
              <p class="text-xs text-[#71717a] mt-0.5">
                Diverifikasi oleh: <span class="font-semibold text-[#3f3f46]"
                  >Nurul Anisa Sri Winarsih, M.Cs</span
                > — Koordinator MBKM FIK
              </p>
            </div>
          </div>
          <button
            @click="currentStep = 3; $nextTick(() => window.lucide && window.lucide.createIcons())"
            class="bg-[#1063B9] hover:bg-[#0655a7] text-white px-5 py-2 rounded-lg text-xs font-semibold transition-all flex items-center gap-2 shrink-0"
          >
            <span>Lanjut ke Konversi SKS</span>
            <i data-lucide="arrow-right" class="w-4 h-4"></i>
          </button>
        </div>
      </div>

      <!-- STEP 3: KONVERSI SKS -->
      <div x-show="currentStep === 3" class="space-y-5" x-transition>
        <div
          class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-3 border-b border-[#e4e4e7]"
        >
          <div class="flex items-center gap-2">
            <i data-lucide="layers" class="w-5 h-5 text-[#1063B9]"></i>
            <h3 class="text-[15px] font-semibold text-[#09090b]">
              Tahap 3: Penyusunan Konversi Mata Kuliah SKS
            </h3>
          </div>
          <div class="flex items-center gap-2">
            <span
              class="text-xs font-medium px-3 py-1 bg-[#fafafa] text-[#3f3f46] rounded-full border border-[#e4e4e7]"
            >
              Maks: <span x-text="maxSks"></span> SKS
            </span>
            <span
              class="text-xs font-semibold px-3 py-1 rounded-full border"
              :class="totalSks > maxSks ? 'bg-red-50 text-red-600 border-red-200' : 'bg-[#f4f7fc] text-[#1063B9] border-[#dbeafe]'"
            >
              Terpilih: <span x-text="totalSks"></span> / <span x-text="maxSks"
              ></span> SKS
            </span>
          </div>
        </div>

        <!-- Banner Panduan Status -->
        <template x-if="hasDeclined">
          <div
            class="p-3.5 bg-[#fafafa] border border-[#e4e4e7] rounded-xl flex items-start gap-3"
          >
            <i data-lucide="info" class="w-4 h-4 text-[#71717a] shrink-0 mt-0.5"
            ></i>
            <div class="text-xs text-[#3f3f46] leading-relaxed">
              <p class="font-semibold text-[#09090b]">
                Terdapat mata kuliah yang ditolak (Declined)
              </p>
              <p class="mt-0.5 text-[#71717a]">
                Mata kuliah yang <span class="font-medium text-[#09090b]"
                  >Disetujui</span
                > sudah terkunci. Klik <span class="font-medium text-[#09090b]"
                  >Ganti Matkul</span
                > pada baris yang Declined untuk memilih pengganti.
              </p>
            </div>
          </div>
        </template>

        <template
          x-if="!hasDeclined && konversiList.some(m => m.status === 'pending')"
        >
          <div
            class="p-3.5 bg-[#f4f7fc] border border-[#dbeafe] rounded-xl flex items-start gap-3"
          >
            <i data-lucide="info" class="w-4 h-4 text-[#1063B9] shrink-0 mt-0.5"
            ></i>
            <div class="text-xs text-[#3f3f46] leading-relaxed">
              <p class="font-semibold text-[#09090b]">
                Mata kuliah pengganti siap diajukan!
              </p>
              <p class="mt-0.5 text-[#71717a]">
                Klik tombol <span class="font-medium text-[#09090b]"
                  >"Ajukan Ulang Konversi"</span
                > di bawah untuk mengirim pembaruan ke koordinator.
              </p>
            </div>
          </div>
        </template>

        <!-- Table Mata Kuliah -->
        <div class="space-y-4">
          <div class="overflow-x-auto border border-[#e4e4e7] rounded-xl">
            <table class="w-full text-sm border-collapse">
              <thead
                class="bg-gray-50/80 text-gray-700 font-semibold text-xs border-b"
              >
                <tr>
                  <th class="p-3 text-left">Mata Kuliah Konversi</th>
                  <th class="p-3 text-center w-24">Bobot</th>
                  <th class="p-3 text-center w-40">Status Verifikasi</th>
                  <th class="p-3 text-center w-36">Aksi</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-[#e4e4e7]">
                <template
                  x-for="(item, index) in konversiList"
                  :key="item.kode"
                >
                  <tr class="hover:bg-[#fafafa] transition-colors">
                    <!-- Info Matkul -->
                    <td class="p-3.5">
                      <div class="flex items-center gap-2 flex-wrap">
                        <p
                          class="font-semibold text-[#09090b] text-sm"
                          x-text="item.nama"
                        >
                        </p>
                        <!-- Badge status kecil -->
                        <span
                          x-show="item.status === 'accept'"
                          class="inline-flex items-center gap-1 text-[10px] font-semibold px-2 py-0.5 border border-emerald-200 bg-emerald-50 text-emerald-700 rounded-full"
                        >
                          <i data-lucide="lock" class="w-2.5 h-2.5"></i> Terkunci
                        </span>
                      </div>
                      <p
                        class="text-[11px] text-[#71717a] font-mono mt-0.5"
                        x-text="item.kode"
                      >
                      </p>

                      <!-- Catatan Koordinator jika Ditolak -->
                      <template
                        x-if="item.status === 'decline' && item.catatan"
                      >
                        <div
                          class="mt-2 p-2.5 bg-[#fafafa] border border-[#e4e4e7] rounded-lg text-xs"
                        >
                          <p
                            class="font-semibold text-[#3f3f46] flex items-center gap-1 text-[11px] mb-0.5"
                          >
                            <i
                              data-lucide="message-square"
                              class="w-3 h-3 text-[#71717a]"></i> Catatan Koordinator:
                          </p>
                          <p class="text-[#71717a]" x-text="item.catatan"></p>
                        </div>
                      </template>
                    </td>

                    <!-- SKS -->
                    <td
                      class="p-3.5 text-center font-semibold text-[#3f3f46] text-sm"
                      x-text="`${item.sks} SKS`"></td>

                    <!-- Status -->
                    <td class="p-3.5 text-center">
                      <span
                        x-show="item.status === 'accept'"
                        class="inline-flex items-center gap-1 text-[10px] font-semibold px-2.5 py-1 border border-emerald-200 bg-emerald-50 text-emerald-700 rounded-full"
                      >
                        <i data-lucide="check" class="w-3 h-3"></i> Approved
                      </span>
                      <span
                        x-show="item.status === 'decline'"
                        class="inline-flex items-center gap-1 text-[10px] font-semibold px-2.5 py-1 border border-red-200 bg-red-50 text-red-600 rounded-full"
                      >
                        <i data-lucide="x" class="w-3 h-3"></i> Declined
                      </span>
                      <span
                        x-show="item.status === 'pending'"
                        class="inline-flex items-center gap-1 text-[10px] font-semibold px-2.5 py-1 border border-[#e4e4e7] bg-[#fafafa] text-[#71717a] rounded-full"
                      >
                        <i data-lucide="clock" class="w-3 h-3"></i> Siap Diajukan
                      </span>
                    </td>

                    <!-- Aksi -->
                    <td class="p-3.5 text-center">
                      <!-- Approved: Terkunci -->
                      <template x-if="item.status === 'accept'">
                        <div
                          class="inline-flex items-center gap-1.5 text-xs text-[#71717a] font-medium py-1.5 px-2.5 bg-[#fafafa] border border-[#e4e4e7] rounded-lg"
                          title="Mata kuliah telah disetujui, tidak dapat diedit"
                        >
                          <i data-lucide="lock" class="w-3.5 h-3.5"></i>
                          <span>Terkunci</span>
                        </div>
                      </template>

                      <!-- Declined: BISA Ganti -->
                      <template x-if="item.status === 'decline'">
                        <div class="flex items-center justify-center gap-1.5">
                          <button
                            type="button"
                            @click="openEdit(index)"
                            class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-[#1063B9] hover:bg-[#0655a7] text-white text-xs font-semibold rounded-lg transition-colors"
                            title="Ganti mata kuliah yang ditolak"
                          >
                            <i data-lucide="replace" class="w-3.5 h-3.5"></i>
                            <span>Ganti Matkul</span>
                          </button>
                        </div>
                      </template>

                      <!-- Pending: Bisa ubah atau hapus -->
                      <template x-if="item.status === 'pending'">
                        <div class="flex items-center justify-center gap-1.5">
                          <button
                            type="button"
                            @click="openEdit(index)"
                            class="inline-flex items-center gap-1.5 px-2.5 py-1.5 bg-white text-[#09090b] border border-[#e4e4e7] hover:bg-[#f4f4f5] text-xs font-medium rounded-lg transition-colors"
                            title="Ubah pilihan mata kuliah"
                          >
                            <i
                              data-lucide="pencil"
                              class="w-3.5 h-3.5 text-[#71717a]"></i>
                            <span>Ubah</span>
                          </button>
                          <button
                            type="button"
                            @click="removeMatkul(index)"
                            class="p-1.5 text-[#71717a] hover:text-red-500 hover:bg-[#fafafa] border border-[#e4e4e7] rounded-lg transition-colors"
                            title="Hapus mata kuliah"
                          >
                            <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                          </button>
                        </div>
                      </template>
                    </td>
                  </tr>
                </template>

                <tr x-show="konversiList.length === 0">
                  <td colspan="4" class="p-8 text-center text-[#71717a] text-xs"
                    >Belum ada mata kuliah yang dipilih</td
                  >
                </tr>
              </tbody>
              <tfoot class="bg-[#fafafa] border-t border-[#e4e4e7] text-xs">
                <tr>
                  <td class="p-3 text-right font-medium text-[#3f3f46]"
                    >Total SKS Terpilih:</td
                  >
                  <td
                    class="p-3 text-center font-semibold"
                    :class="totalSks > maxSks ? 'text-red-600' : 'text-[#1063B9]'"
                    x-text="`${totalSks} SKS`"></td>
                  <td colspan="2" class="p-3 text-right text-[#71717a]">
                    <span x-show="totalSks <= maxSks"
                      >Sisa kuota: <b
                        class="text-[#1063B9]"
                        x-text="`${maxSks - totalSks} SKS`"></b></span
                    >
                    <span
                      x-show="totalSks > maxSks"
                      class="text-red-600 font-semibold"
                      >Melebihi batas maksimal!</span
                    >
                  </td>
                </tr>
              </tfoot>
            </table>
          </div>

          <button
            type="button"
            @click="openAddModal()"
            class="w-full py-3 border-2 border-dashed border-[#e4e4e7] text-[#71717a] text-xs font-medium rounded-xl hover:border-[#1063B9]/30 hover:text-[#1063B9] hover:bg-[#f4f7fc]/50 transition-colors flex items-center justify-center gap-2"
          >
            <i data-lucide="plus-circle" class="w-4 h-4"></i>
            <span>Tambah Mata Kuliah Konversi Lainnya</span>
          </button>
        </div>

        <!-- Tombol Aksi Bawah Step 3 -->
        <div
          class="flex items-center justify-between pt-4 border-t border-[#e4e4e7]"
        >
          <button
            type="button"
            @click="currentStep = 4; $nextTick(() => window.lucide && window.lucide.createIcons())"
            class="text-xs font-medium text-[#71717a] hover:text-[#09090b] flex items-center gap-1 transition-colors"
          >
          </button>

          <button
            type="button"
            @click="submitKonversi()"
            class="bg-[#1063B9] hover:bg-[#0655a7] text-white px-7 py-2.5 rounded-lg text-sm font-semibold transition-all flex items-center gap-2"
          >
            <i data-lucide="send" class="w-4 h-4"></i>
            <span
              x-text="hasDeclined ? 'Perbaiki & Ajukan Ulang' : 'Ajukan Konversi SKS'"
            ></span>
          </button>
        </div>
      </div>

      <!-- STEP 4: KONFIRMASI SKS -->
      <div x-show="currentStep === 4" class="space-y-6" x-transition>
        <div
          class="flex items-center justify-between pb-3 border-b border-[#e4e4e7]"
        >
          <div class="flex items-center gap-2">
            <i data-lucide="clipboard-check" class="w-5 h-5 text-[#1063B9]"></i>
            <h3 class="text-[15px] font-semibold text-[#09090b]">
              Tahap 4: Status Konfirmasi Konversi SKS
            </h3>
          </div>
          <span class="text-xs text-[#71717a] font-medium"
            >Verifikasi oleh Koordinator MBKM</span
          >
        </div>

        <!-- List Kartu Matkul di Step 4 -->
        <div class="grid gap-3">
          <template x-for="(item, index) in konversiList" :key="item.kode">
            <div
              class="border border-[#e4e4e7] rounded-xl p-4 flex flex-col sm:flex-row gap-4 justify-between bg-white"
            >
              <div class="flex-1 space-y-1">
                <div class="flex items-center gap-2 flex-wrap">
                  <h4
                    class="font-semibold text-[#09090b] text-sm"
                    x-text="item.nama"
                  >
                  </h4>

                  <!-- Badge Status kecil -->
                  <span
                    x-show="item.status === 'accept'"
                    class="inline-flex items-center gap-1 text-[10px] font-semibold px-2 py-0.5 rounded-full border border-emerald-200 bg-emerald-50 text-emerald-700"
                  >
                    <i data-lucide="check" class="w-2.5 h-2.5"></i> Approved
                  </span>
                  <span
                    x-show="item.status === 'decline'"
                    class="inline-flex items-center gap-1 text-[10px] font-semibold px-2 py-0.5 rounded-full border border-red-200 bg-red-50 text-red-600"
                  >
                    <i data-lucide="x" class="w-2.5 h-2.5"></i> Declined
                  </span>
                  <span
                    x-show="item.status === 'pending'"
                    class="inline-flex items-center gap-1 text-[10px] font-semibold px-2 py-0.5 rounded-full border border-[#e4e4e7] bg-[#fafafa] text-[#71717a]"
                  >
                    <i data-lucide="clock" class="w-2.5 h-2.5"></i> Menunggu Konfirmasi
                  </span>
                </div>

                <p
                  class="text-xs text-[#71717a] font-mono"
                  x-text="`${item.kode} • Bobot: ${item.sks} SKS`"
                >
                </p>
              </div>

              <!-- Tombol Aksi di Step 4 -->
              <div
                class="flex items-center gap-2 self-start sm:self-center shrink-0"
              >
                <!-- Jika Approved: Terkunci -->
                <template x-if="item.status === 'accept'">
                  <div
                    class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white text-[#71717a] border border-[#e4e4e7] text-xs font-medium rounded-lg"
                  >
                    <i data-lucide="lock" class="w-3.5 h-3.5"></i>
                    <span>Disetujui (Terkunci)</span>
                  </div>
                </template>

                <!-- Jika Decline: Tombol Edit Matkul -->
                <template x-if="item.status === 'decline'">
                  <button
                    type="button"
                    @click="editFromStep4(index)"
                    class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white hover:bg-[#f4f4f5] border border-[#e4e4e7] text-[#09090b] text-xs font-medium rounded-lg transition-colors cursor-pointer"
                    title="Edit dan ganti matkul ini di Step 3"
                  >
                    <i data-lucide="pencil" class="w-3.5 h-3.5 text-[#71717a]"
                    ></i>
                    <span>Edit Matkul</span>
                  </button>
                </template>
              </div>
            </div>
          </template>
        </div>

        <div
          class="flex flex-col sm:flex-row items-center justify-between gap-3 pt-4 border-t border-[#e4e4e7]"
        >
          <button
            type="button"
            @click="currentStep = 3; $nextTick(() => window.lucide && window.lucide.createIcons())"
            class="text-xs font-medium text-[#71717a] hover:text-[#09090b] flex items-center gap-1 transition-colors"
          >
          </button>

          <button
            type="button"
            @click="submitKonfirmasi()"
            class="bg-[#1063B9] hover:bg-[#0655a7] text-white px-7 py-2.5 rounded-lg text-sm font-semibold transition-all flex items-center gap-2"
            :class="hasDeclined ? 'opacity-60 cursor-not-allowed' : ''"
          >
            <span>Pakta Contributor</span>
            <i data-lucide="arrow-right" class="w-4 h-4"></i>
          </button>
        </div>
      </div>

      <!-- STEP 5: PAKTA CONTRIBUTOR -->
      <div x-show="currentStep === 5" class="space-y-6" x-transition>
        <div
          class="flex flex-col items-center justify-center py-10 text-center"
        >
          <div
            class="w-14 h-14 bg-[#f4f7fc] border border-[#dbeafe] rounded-full flex items-center justify-center mb-4"
          >
            <i data-lucide="award" class="w-7 h-7 text-[#1063B9]"></i>
          </div>
          <h3 class="text-xl font-semibold text-[#09090b]">
            Konversi Mata Kuliah Berhasil Disetujui!
          </h3>
          <p class="text-sm text-[#71717a] max-w-md mt-2">
            Seluruh mata kuliah ekuivalensi (20 SKS) telah sah disahkan oleh
            Koordinator MBKM dan Ketua Program Studi.
          </p>

          <div
            class="mt-8 w-full max-w-lg p-6 border rounded-2xl bg-gray-50 space-y-4"
          >
            <div class="flex items-center justify-between text-left">
              <div class="flex items-center gap-3">
                <div
                  class="w-10 h-10 bg-red-100 text-red-600 rounded-lg flex items-center justify-center"
                >
                  <i data-lucide="file-check" class="w-5 h-5"></i>
                </div>
                <div>
                  <p class="text-sm font-bold text-gray-900">
                    Pakta_Contributor_Final_Signed.pdf
                  </p>
                  <p class="text-xs text-gray-500">
                    Disahkan oleh Dekan & Kaprodi FIK
                  </p>
                </div>
              </div>
              <button
                class="flex items-center gap-2 bg-[#1063B9] hover:bg-[#0655a7] text-white px-4 py-2 rounded-lg text-xs font-bold transition-colors"
              >
                <i data-lucide="download" class="w-4 h-4"></i>
                Unduh Berkas
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- MODAL EDIT / GANTI MATKUL (Khusus untuk matkul decline dengan matkul yang tidak dipilih) -->
    <div
      x-show="showEditModal"
      class="fixed inset-0 z-[60] flex items-center justify-center p-4 bg-black/50 backdrop-blur-xs"
      x-transition
      x-cloak
    >
      <div
        class="bg-white rounded-2xl w-full max-w-md p-6 shadow-2xl border space-y-4"
        @click.outside="showEditModal = false"
      >
        <div
          class="flex items-center justify-between pb-3 border-b border-[#e4e4e7]"
        >
          <div
            class="flex items-center gap-2 text-[#09090b] font-semibold text-sm"
          >
            <i data-lucide="replace" class="w-4 h-4 text-[#1063B9]"></i>
            <h3>Ganti Mata Kuliah yang Ditolak</h3>
          </div>
          <button
            @click="showEditModal = false"
            class="text-[#71717a] hover:text-[#09090b] p-1"
          >
            <i data-lucide="x" class="w-4 h-4"></i>
          </button>
        </div>

        <!-- Detail Matkul Yang Ditolak -->
        <div
          class="p-3 bg-[#fafafa] border border-[#e4e4e7] rounded-xl space-y-1"
        >
          <span
            class="text-[10px] font-semibold text-[#71717a] uppercase tracking-wider"
            >Mata Kuliah Ditolak:</span
          >
          <p
            class="text-sm font-semibold text-[#09090b]"
            x-text="editTarget?.nama"
          >
          </p>
          <p
            class="text-xs text-[#71717a] font-mono"
            x-text="`${editTarget?.kode} (${editTarget?.sks} SKS)`"
          >
          </p>
          <template x-if="editTarget?.catatan">
            <p
              class="text-[11px] text-[#71717a] mt-1 pt-1 border-t border-[#e4e4e7]"
              x-text="`Alasan: ${editTarget.catatan}`"
            >
            </p>
          </template>
        </div>

        <!-- Pemilihan Pengganti dari Matkul yang Belum Dipilih -->
        <div class="space-y-2">
          <label class="text-xs font-semibold text-[#09090b] block">
            Pilih Mata Kuliah Pengganti:
          </label>
          <select
            x-model="selectedMatkul"
            class="w-full p-3 border border-[#e4e4e7] rounded-xl bg-[#fafafa] text-xs font-medium focus:ring-2 focus:ring-[#1063B9] focus:bg-white outline-none text-[#09090b]"
          >
            <option value="">-- Pilih Mata Kuliah Pengganti --</option>
            <template x-for="m in unselectedMatkul" :key="m.kode">
              <option
                :value="m.kode"
                x-text="`${m.nama} (${m.sks} SKS) - ${m.kode}`"></option>
            </template>
          </select>
          <p class="text-[11px] text-gray-500 italic">
            * Hanya menampilkan mata kuliah kurikulum yang belum diambil dalam
            daftar konversi ini.
          </p>
        </div>

        <!-- Preview SKS Kalkulasi -->
        <template x-if="selectedReplacementMatkul">
          <div
            class="p-3 bg-[#f4f7fc] border border-[#dbeafe] rounded-xl text-xs space-y-1"
          >
            <div class="flex justify-between text-[#3f3f46]">
              <span>Bobot matkul pengganti:</span>
              <b x-text="`${selectedReplacementMatkul.sks} SKS`"></b>
            </div>
            <div class="flex justify-between text-[#3f3f46]">
              <span>Total SKS setelah diganti:</span>
              <b
                class="text-[#1063B9]"
                x-text="`${totalSks - (editTarget ? editTarget.sks : 0) + selectedReplacementMatkul.sks} / ${maxSks} SKS`"
              ></b>
            </div>
          </div>
        </template>

        <div class="flex gap-2 pt-2 border-t border-[#e4e4e7]">
          <button
            type="button"
            @click="showEditModal = false"
            class="flex-1 py-2.5 border border-[#e4e4e7] hover:bg-[#fafafa] rounded-xl font-medium text-xs text-[#3f3f46] transition-colors"
          >
            Batal
          </button>
          <button
            type="button"
            @click="confirmEdit()"
            :disabled="!selectedMatkul"
            class="flex-1 py-2.5 bg-[#1063B9] hover:bg-[#0655a7] disabled:opacity-50 disabled:cursor-not-allowed text-white rounded-xl font-semibold text-xs transition-colors"
          >
            Konfirmasi Ganti
          </button>
        </div>
      </div>
    </div>

    <!-- MODAL TAMBAH MATA KULIAH BARU -->
    <div
      x-show="showMatkulModal"
      class="fixed inset-0 z-[60] flex items-center justify-center p-4 bg-black/50 backdrop-blur-xs"
      x-transition
      x-cloak
    >
      <div
        class="bg-white rounded-2xl w-full max-w-md p-6 shadow-2xl border space-y-4"
        @click.outside="showMatkulModal = false"
      >
        <div class="flex items-center justify-between pb-2 border-b">
          <div
            class="flex items-center gap-2 text-[#1063B9] font-bold text-base"
          >
            <i data-lucide="plus-circle" class="w-5 h-5"></i>
            <h3>Tambah Mata Kuliah Konversi</h3>
          </div>
          <button
            @click="showMatkulModal = false"
            class="text-gray-400 hover:text-gray-600"
          >
            <i data-lucide="x" class="w-5 h-5"></i>
          </button>
        </div>

        <div class="space-y-2">
          <label class="text-xs font-bold text-gray-800 block">
            Pilih Mata Kuliah Tersedia:
          </label>
          <select
            x-model="selectedMatkul"
            class="w-full p-3 border border-gray-300 rounded-xl bg-gray-50 text-xs font-medium focus:ring-2 focus:ring-[#1063B9] focus:bg-white outline-none"
          >
            <option value="">-- Pilih Mata Kuliah --</option>
            <template x-for="m in unselectedMatkul" :key="m.kode">
              <option
                :value="m.kode"
                x-text="`${m.nama} (${m.sks} SKS) - ${m.kode}`"></option>
            </template>
          </select>
        </div>

        <div class="flex gap-2 pt-2 border-t">
          <button
            type="button"
            @click="showMatkulModal = false"
            class="flex-1 py-2.5 border border-gray-300 hover:bg-gray-50 rounded-xl font-bold text-xs text-gray-600 transition-colors"
          >
            Batal
          </button>
          <button
            type="button"
            @click="addMatkul()"
            :disabled="!selectedMatkul"
            class="flex-1 py-2.5 bg-[#1063B9] hover:bg-[#0655a7] disabled:opacity-50 disabled:cursor-not-allowed text-white rounded-xl font-bold text-xs transition-colors shadow-sm"
          >
            Tambahkan
          </button>
        </div>
      </div>
    </div>

    <!-- MODAL SUKSES -->
    <div
      x-show="showSuccessModal"
      class="fixed inset-0 z-[70] flex items-center justify-center p-4 bg-[#09090b]/60 backdrop-blur-sm"
      x-transition
      x-cloak
    >
      <div
        class="bg-white rounded-2xl w-full max-w-sm p-7 shadow-2xl text-center space-y-5"
        @click.outside="showSuccessModal = false"
      >
        <div
          class="w-16 h-16 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mx-auto ring-8 ring-emerald-50"
        >
          <i data-lucide="check-circle-2" class="w-8 h-8"></i>
        </div>
        <div>
          <h3 class="text-lg font-bold text-[#09090b]" x-text="successMessage">
          </h3>
          <p
            class="text-gray-500 mt-1.5 text-xs leading-relaxed"
            x-text="successSubMessage"
          >
          </p>
        </div>
        <button
          type="button"
          @click="showSuccessModal = false; $nextTick(() => window.lucide && window.lucide.createIcons())"
          class="w-full py-2.5 bg-[#1063B9] hover:bg-[#0655a7] text-white rounded-xl font-bold text-xs transition-colors shadow-sm"
        >
          Lanjutkan
        </button>
      </div>
    </div>
  </div>

  <script is:inline>
    function initKonversiFlow() {
      if (!window.Alpine) return;
      if (window._konversiFlowRegistered) return;
      window._konversiFlowRegistered = true;

      window.Alpine.data("konversiFlow", () => ({
        currentStep: 4,
        maxSks: 20,
        showMatkulModal: false,
        showEditModal: false,
        showSuccessModal: false,
        editTargetIndex: null,
        editTarget: null,
        selectedMatkul: "",
        successMessage: "",
        successSubMessage: "",

        konversiList: [
          {
            kode: "A11.54601",
            nama: "Proyek Perangkat Lunak",
            sks: 4,
            status: "decline",
            catatan:
              "Capaian pembelajaran tidak relevan dengan kompetensi program magang yang diambil.",
          },
          {
            kode: "A11.54602",
            nama: "Sistem Basis Data Lanjut",
            sks: 4,
            status: "accept",
            catatan: "",
          },
        ],

        availableMatkul: [
          { kode: "A11.54601", nama: "Proyek Perangkat Lunak", sks: 4 },
          { kode: "A11.54602", nama: "Sistem Basis Data Lanjut", sks: 4 },
          {
            kode: "A11.54603",
            nama: "Kapita Selekta Komputasi Cerdas",
            sks: 4,
          },
          {
            kode: "A11.54604",
            nama: "Metodologi Penelitian & Publikasi",
            sks: 3,
          },
          { kode: "A11.54605", nama: "Etika Profesi TI", sks: 3 },
          {
            kode: "A11.54101",
            nama: "Pemrograman Web Berbasis Komponen",
            sks: 4,
          },
          { kode: "A11.54102", nama: "Pengembangan Aplikasi Mobile", sks: 4 },
          {
            kode: "A11.54201",
            nama: "Komputasi Awan (Cloud Computing)",
            sks: 3,
          },
          {
            kode: "A11.54202",
            nama: "Keamanan Jaringan & Sistem Informasi",
            sks: 3,
          },
          {
            kode: "A11.54301",
            nama: "Data Mining & Business Intelligence",
            sks: 3,
          },
        ],

        get totalSks() {
          return this.konversiList.reduce((acc, curr) => acc + curr.sks, 0);
        },

        get hasDeclined() {
          return this.konversiList.some((m) => m.status === "decline");
        },

        get unselectedMatkul() {
          return this.availableMatkul.filter(
            (m) => !this.konversiList.some((k) => k.kode === m.kode),
          );
        },

        get selectedReplacementMatkul() {
          if (!this.selectedMatkul) return null;
          return (
            this.availableMatkul.find((m) => m.kode === this.selectedMatkul) ||
            null
          );
        },

        editFromStep4(index) {
          this.currentStep = 3;
          this.openEdit(index);
        },

        openEdit(index) {
          const target = this.konversiList[index];
          if (!target) return;
          if (target.status === "accept") {
            alert(
              "Mata kuliah ini telah disetujui (Approved) dan tidak dapat diedit!",
            );
            return;
          }
          this.editTargetIndex = index;
          this.editTarget = { ...target };
          this.selectedMatkul = "";
          this.showEditModal = true;
          this.$nextTick(() => window.lucide && window.lucide.createIcons());
        },

        confirmEdit() {
          if (!this.selectedMatkul) {
            alert("Silakan pilih mata kuliah pengganti!");
            return;
          }
          const replacement = this.availableMatkul.find(
            (m) => m.kode === this.selectedMatkul,
          );
          if (!replacement) return;

          const currentMatkulSks = this.editTarget ? this.editTarget.sks : 0;
          const projectedSks =
            this.totalSks - currentMatkulSks + replacement.sks;
          if (projectedSks > this.maxSks) {
            alert(
              "Total SKS akan menjadi " +
                projectedSks +
                " SKS, melebihi batas maksimal " +
                this.maxSks +
                " SKS!",
            );
            return;
          }

          this.konversiList[this.editTargetIndex] = {
            ...replacement,
            status: "pending",
            catatan: "",
          };

          this.showEditModal = false;
          this.selectedMatkul = "";
          this.editTarget = null;
          this.editTargetIndex = null;
          this.$nextTick(() => window.lucide && window.lucide.createIcons());
        },

        openAddModal() {
          if (this.unselectedMatkul.length === 0) {
            alert("Semua mata kuliah pilihan sudah ada dalam daftar konversi!");
            return;
          }
          this.selectedMatkul = "";
          this.showMatkulModal = true;
          this.$nextTick(() => window.lucide && window.lucide.createIcons());
        },

        addMatkul() {
          if (!this.selectedMatkul) {
            alert("Silakan pilih mata kuliah terlebih dahulu!");
            return;
          }
          const matkul = this.availableMatkul.find(
            (m) => m.kode === this.selectedMatkul,
          );
          if (!matkul) return;

          if (this.totalSks + matkul.sks > this.maxSks) {
            alert("Total SKS melebihi batas maksimal " + this.maxSks + " SKS!");
            return;
          }
          if (this.konversiList.some((m) => m.kode === matkul.kode)) {
            alert("Mata kuliah sudah ada di daftar konversi!");
            return;
          }

          this.konversiList.push({ ...matkul, status: "pending", catatan: "" });
          this.showMatkulModal = false;
          this.selectedMatkul = "";
          this.$nextTick(() => window.lucide && window.lucide.createIcons());
        },

        removeMatkul(index) {
          const item = this.konversiList[index];
          if (item.status === "accept") {
            alert(
              "Mata kuliah yang telah disetujui (Approved) tidak dapat dihapus!",
            );
            return;
          }
          if (
            confirm("Hapus mata kuliah " + item.nama + " dari daftar konversi?")
          ) {
            this.konversiList.splice(index, 1);
            this.$nextTick(() => window.lucide && window.lucide.createIcons());
          }
        },

        triggerSuccess(msg, subMsg, nextStep) {
          this.successMessage = msg;
          this.successSubMessage = subMsg || "";
          this.showSuccessModal = true;
          if (nextStep) this.currentStep = nextStep;
          this.$nextTick(() => window.lucide && window.lucide.createIcons());
        },

        submitPakta() {
          this.triggerSuccess(
            "Pakta Integritas Berhasil Diunggah!",
            "Dokumen Anda telah masuk ke sistem dan menunggu konfirmasi koordinator.",
            2,
          );
        },

        submitKonversi() {
          if (this.konversiList.length === 0) {
            alert("Pilih minimal 1 mata kuliah untuk konversi!");
            return;
          }
          if (this.hasDeclined) {
            alert(
              'Masih terdapat mata kuliah yang ditolak! Silakan klik tombol "Ganti Matkul" untuk memilih mata kuliah pengganti.',
            );
            return;
          }

          // Cek apakah submit pertama (semua masih pending)
          const allPending = this.konversiList.every(
            (m) => m.status === "pending",
          );

          if (allPending) {
            // Submit pertama: matkul pertama di-decline untuk demo
            this.konversiList = this.konversiList.map((item, index) => {
              if (index === 0) {
                return {
                  ...item,
                  status: "decline",
                  catatan:
                    "Capaian pembelajaran tidak relevan dengan kompetensi program magang yang diambil.",
                };
              }
              return { ...item, status: "accept", catatan: "" };
            });

            this.triggerSuccess(
              "Konversi SKS Berhasil Diajukan!",
              "Koordinator telah meninjau pengajuan Anda. Terdapat 1 mata kuliah yang perlu diganti — silakan cek di Tahap 4.",
              4,
            );
            return;
          }

          // Submit ulang setelah ganti matkul: semua disetujui
          this.konversiList = this.konversiList.map((item) => ({
            ...item,
            status: "accept",
            catatan: "",
          }));

          this.triggerSuccess(
            "Mata Kuliah Pengganti Disetujui!",
            "Seluruh mata kuliah konversi telah disetujui oleh Koordinator MBKM.",
            4,
          );
        },

        submitKonfirmasi() {
          if (this.hasDeclined) {
            alert(
              'Mohon perbaiki mata kuliah yang ditolak terlebih dahulu dengan menekan tombol "Edit Matkul"!',
            );
            return;
          }
          this.triggerSuccess(
            "Seluruh Mata Kuliah Telah Disetujui!",
            "Konversi SKS Anda dinyatakan sah. Silakan unduh dokumen Pakta Contributor.",
            5,
          );
        },

        resetSimulasi() {
          this.currentStep = 1;
          this.konversiList = [];
          this.selectedMatkul = "";
          this.editTargetIndex = null;
          this.editTarget = null;
          this.showEditModal = false;
          this.showMatkulModal = false;
          this.showSuccessModal = false;
          this.successMessage = "";
          this.successSubMessage = "";
          this.$nextTick(() => window.lucide && window.lucide.createIcons());
        },
      }));
    }

    document.addEventListener("alpine:init", initKonversiFlow);
    if (window.Alpine) {
      initKonversiFlow();
    }

    document.addEventListener("DOMContentLoaded", () => {
      if (window.lucide) window.lucide.createIcons();
    });
  </script>
</MahasiswaShell>
