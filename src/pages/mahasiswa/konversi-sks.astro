---
// src/pages/mahasiswa/konversi-sks.astro
import MahasiswaShell from "../../layouts/MahasiswaShell.astro";
import KonversiRoot from "../../components/mbkm/konversi/KonversiRoot.astro";
import KonversiStepper from "../../components/mbkm/konversi/KonversiStepper.astro";
import Step1PengajuanMatkul from "../../components/mbkm/konversi/Step1PengajuanMatkul.astro";
import Step2KonfirmasiMatkul from "../../components/mbkm/konversi/Step2KonfirmasiMatkul.astro";
import Step3KelompokMatkul from "../../components/mbkm/konversi/Step3KelompokMatkul.astro";
import Step4PaktaIntegritas from "../../components/mbkm/konversi/Step4PaktaIntegritas.astro";
import ModalGantiMatkul from "../../components/mbkm/konversi/ModalGantiMatkul.astro";
import KonversiLockedNotice from "../../components/mbkm/konversi/KonversiLockedNotice.astro";
---

<MahasiswaShell
  title="Makul Konversi | Mahasiswa - FIK Udinus"
  activeNav="konversi-sks"
  pageTitle="Makul Konversi Kampus Berdampak"
  breadcrumb="Makul Konversi"
>
  <KonversiRoot>
    <header class="mb-2 shrink-0 space-y-1">
      <div class="flex items-center gap-2.5 flex-wrap">
        <h2 class="text-xl font-normal text-[#09090b] tracking-tight">Makul Konversi</h2>
        <!-- Simulasi prototipe: keputusan Koordinator & posisi alur -->
        <select
          x-model="kondisiSimulasi"
          @change="setKondisi($event.target.value)"
          class="h-7 px-2 rounded-md border border-[#e4e4e7] bg-white text-xs font-medium text-[#09090b] focus:outline-none focus:ring-1 focus:ring-[#0655a7] cursor-pointer shadow-none"
        >
          <option value="pertama">1. Pengajuan Baru</option>
          <option value="menunggu">2. Menunggu Konfirmasi</option>
          <option value="tolak">3. Ada yang Ditolak</option>
          <option value="setuju">4. Semua Disetujui</option>
        </select>
      </div>
      <p class="text-sm text-[#71717a]">
        Program: <strong class="font-semibold text-[#09090b]">Bengkel Koding — Proyek Web & Mobile</strong> (20 SKS)
      </p>
    </header>

    <!-- Terkunci jika belum diterima -->
    <KonversiLockedNotice />

    <div x-show="$store.mahasiswaSim?.state === 'aktif'" class="space-y-4">
      <KonversiStepper />
      <Step1PengajuanMatkul />
      <Step2KonfirmasiMatkul />
      <Step3KelompokMatkul />
      <Step4PaktaIntegritas />
      <ModalGantiMatkul />
    </div>
  </KonversiRoot>
</MahasiswaShell>
