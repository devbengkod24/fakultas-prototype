---
// src/pages/mahasiswa/konversi-sks.astro
import MahasiswaShell from '../../layouts/MahasiswaShell.astro';
---

<MahasiswaShell
  title="Konversi SKS MBKM | Mahasiswa - FIK Udinus"
  activeNav="konversi-sks"
  pageTitle="Konversi Mata Kuliah MBKM"
  breadcrumb="Konversi SKS"
>
   <section id="view-konversi-sks" class="space-y-6">
    <!-- Header -->
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div>
        <h2 class="text-[20px] leading-[28px] font-normal text-[#09090b]">Konversi SKS</h2>
        <p class="text-[14px] leading-[20px] text-[#71717a]">Daftar mata kuliah ekuivalensi MBKM dan status persetujuan koordinator.</p>
      </div>
    </div>

    <!-- Tabel Konversi -->
    <div class="bg-white border border-[#e4e4e7] rounded-[12px] p-5 shadow-2xs">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs border-collapse">
          <thead>
            <tr class="bg-gray-50 text-[11px] font-semibold text-[#71717a] uppercase tracking-wider border-b border-[#e4e4e7]">
              <th class="py-2.5 px-3">Kode / Matkul</th>
              <th class="py-2.5 px-3">SKS</th>
              <th class="py-2.5 px-3">Dosen</th>
              <th class="py-2.5 px-3 text-right">Aksi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <!-- Row 1 -->
            <tr class="hover:bg-gray-50/70 transition-colors">
              <td class="py-3 px-3">
                <div class="font-medium text-[13px] text-[#09090b]">A11.54601</div>
                <div class="text-[12px] text-[#71717a]">Proyek Perangkat Lunak</div>
              </td>
              <td class="py-3 px-3">4 SKS</td>
              <td class="py-3 px-3 text-[#71717a]">Dr. Ricardus Anggi, M.Kom</td>
              <td class="py-3 px-3 text-right">
                <span class="text-gray-400 text-[11px]">Terkunci</span>
              </td>
            </tr>
            <!-- Row 2 -->
            <tr class="hover:bg-gray-50/70 transition-colors">
              <td class="py-3 px-3">
                <div class="font-medium text-[13px] text-[#09090b]">A11.54605</div>
                <div class="text-[12px] text-[#71717a]">Etika Profesi TI</div>
              </td>
              <td class="py-3 px-3">3 SKS</td>
              <td class="py-3 px-3 text-[#71717a]">Fajar Nugraha, M.T.</td>
              <td class="py-3 px-3 text-right">
                <button type="button" onclick="openEditModal('Etika Profesi TI')" class="px-2.5 py-1 bg-white hover:bg-gray-50 text-[#09090b] border border-[#e4e4e7] rounded text-xs font-medium transition-colors">
                  Ganti
                </button>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Modal Edit/Ganti -->
    <div id="modal-edit" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
      <div class="bg-white rounded-xl max-w-lg w-full p-5 shadow-2xl space-y-4">
        <h3 class="text-[16px] font-semibold text-[#09090b]">Ganti Mata Kuliah Konversi</h3>
        <p class="text-[13px] text-[#71717a]">Mata kuliah "Etika Profesi TI" ditolak. Silakan pilih mata kuliah pengganti sesuai ketentuan konversi.</p>
        <select class="w-full px-3 py-2 border border-[#e4e4e7] rounded-lg text-[13px]">
          <option>Komputasi Awan (3 SKS)</option>
          <option>Data Mining (3 SKS)</option>
        </select>
        <div class="flex items-center justify-end gap-2 pt-2">
          <button type="button" onclick="closeEditModal()" class="px-4 py-2 border border-[#e4e4e7] rounded-lg text-xs font-semibold">Batal</button>
          <button type="button" onclick="submitGanti()" class="px-4 py-2 bg-[#1063B9] text-white rounded-lg text-xs font-semibold">Ajukan Kembali</button>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    function openKonversiModal() { alert('Fitur ajukan konversi baru.'); }
    function openEditModal(matkul) { document.getElementById('modal-edit').classList.remove('hidden'); }
    function closeEditModal() { document.getElementById('modal-edit').classList.add('hidden'); }
    function submitGanti() { alert('Pengajuan kembali berhasil dikirim ke koordinator.'); closeEditModal(); }
  </script>
</MahasiswaShell>

