---
// src/pages/mahasiswa/konversi-sks.astro
import MahasiswaShell from '../../layouts/MahasiswaShell.astro';
---

<MahasiswaShell
  title="Matriks Konversi SKS Ekuivalensi | Mahasiswa - FIK Udinus"
  activeNav="konversi-sks"
  pageTitle="Matriks Konversi SKS Ekuivalensi MBKM"
  breadcrumb="Konversi SKS"
  subtitle="Tabel mata kuliah ekuivalensi (maksimal 20 SKS) yang telah diverifikasi dan dikunci resmi oleh Koordinator & Kaprodi."
>
  <div id="view-konversi-sks" class="w-full">
<!-- Konversi SKS — Matriks Ekuivalensi 20 SKS Terkunci oleh Koordinator & Kaprodi -->
<div style="margin-bottom:24px;">

  <!-- Header Section -->
  <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-bottom:20px;">
    <div>
      <h2 style="font-size:18px;font-weight:700;color:#1e293b;display:flex;align-items:center;gap:8px;">
        <i data-lucide="layers" style="color:var(--primary);width:20px;height:20px;"></i>
        Matriks Konversi SKS Ekuivalensi MBKM
      </h2>
      <p style="font-size:13px;color:#64748b;margin-top:2px;">
        Tabel mata kuliah ekuivalensi (maksimal 20 SKS) yang telah diverifikasi dan <strong>dikunci resmi</strong> oleh Koordinator MBKM &amp; Kaprodi.
      </p>
    </div>
    <div style="display:flex;align-items:center;gap:8px;">
      <span class="badge badge-success"><i data-lucide="lock" style="width:12px;height:12px;"></i> Dikunci Kaprodi — 11 Okt 2025</span>
    </div>
  </div>

  <!-- Info Banner Status Kunci Resmi -->
  <div class="alert alert-success" style="margin-bottom:22px;padding:16px;border-radius:10px;background:#f0fdf4;border-color:#16a34a;border-left:4px solid #16a34a;">
    <div style="display:flex;gap:14px;align-items:flex-start;">
      <div style="width:40px;height:40px;border-radius:8px;background:#dcfce7;color:#16a34a;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
        <i data-lucide="shield-check" style="width:22px;height:22px;"></i>
      </div>
      <div>
        <div style="font-size:15px;font-weight:700;color:#166534;margin-bottom:2px;">Draf Konversi SKS Telah Disahkan &amp; Dikunci Secara Resmi</div>
        <div style="font-size:12.5px;color:#14532d;line-height:1.5;">
          Koordinator MBKM <strong>Nurul Anisa Sri Winarsih, M.Cs</strong> dan Kaprodi <strong>Dr. Ir. Edi Mulyanto, M.Kom</strong> telah memverifikasi dan mengunci draf konversi Anda pada <strong>Sabtu, 11 Oktober 2025</strong>. Total <strong>20 SKS</strong> dari 5 mata kuliah ekuivalensi akan diinput ke KHS SIADIN setelah sidang akhir dan luaran wajib terpenuhi.
        </div>
      </div>
    </div>
  </div>

  <!-- Ringkasan Statistik -->
  <div class="grid grid-4" style="gap:12px;margin-bottom:22px;">
    <div style="padding:14px;background:#fff;border:1px solid #e2e8f0;border-left:4px solid var(--primary);border-radius:10px;">
      <div style="font-size:11px;color:#64748b;text-transform:uppercase;font-weight:600;">Total SKS Dikunci</div>
      <div style="font-size:22px;font-weight:700;color:var(--primary);margin-top:2px;">20 SKS</div>
      <div style="font-size:11px;color:#64748b;margin-top:2px;">Maks. 20 SKS/Semester</div>
    </div>
    <div style="padding:14px;background:#fff;border:1px solid #e2e8f0;border-left:4px solid #16a34a;border-radius:10px;">
      <div style="font-size:11px;color:#64748b;text-transform:uppercase;font-weight:600;">Jumlah Matkul</div>
      <div style="font-size:22px;font-weight:700;color:#16a34a;margin-top:2px;">5 MK</div>
      <div style="font-size:11px;color:#16a34a;margin-top:2px;">Sudah Diverifikasi</div>
    </div>
    <div style="padding:14px;background:#fff;border:1px solid #e2e8f0;border-left:4px solid #d97706;border-radius:10px;">
      <div style="font-size:11px;color:#64748b;text-transform:uppercase;font-weight:600;">Status Nilai</div>
      <div style="font-size:14px;font-weight:700;color:#d97706;margin-top:2px;">Menunggu</div>
      <div style="font-size:11px;color:#d97706;margin-top:2px;">Nilai Sidang Akhir</div>
    </div>
    <div style="padding:14px;background:#fff;border:1px solid #e2e8f0;border-left:4px solid #7c3aed;border-radius:10px;">
      <div style="font-size:11px;color:#64748b;text-transform:uppercase;font-weight:600;">Disahkan Oleh</div>
      <div style="font-size:13px;font-weight:700;color:#7c3aed;margin-top:2px;">Kaprodi + Koordinator</div>
      <div style="font-size:11px;color:#7c3aed;margin-top:2px;">11 Oktober 2025</div>
    </div>
  </div>

  <!-- Tabel Rincian Matriks Konversi SKS -->
  <div class="card" style="padding:22px;margin-bottom:22px;">
    <div class="card-header" style="margin-bottom:16px;">
      <span class="card-title" style="font-size:15px;display:flex;align-items:center;gap:8px;">
        <i data-lucide="table" style="color:var(--primary);width:18px;height:18px;"></i>
        Tabel Rincian Mata Kuliah Ekuivalensi
      </span>
      <span class="badge" style="background:#f3e8ff;color:#7c3aed;border:1px solid #e9d5ff;"><i data-lucide="lock" style="width:11px;height:11px;"></i> Terkunci — Tidak Dapat Diubah</span>
    </div>

    <div style="border:1px solid #e2e8f0;border-radius:8px;overflow-x:auto;">
      <table style="width:100%;border-collapse:collapse;font-size:13px;text-align:left;">
        <thead>
          <tr style="background:#f8fafc;border-bottom:1px solid #e2e8f0;color:#475569;">
            <th style="padding:10px 14px;">#</th>
            <th style="padding:10px 14px;">Kode Matkul</th>
            <th style="padding:10px 14px;">Nama Mata Kuliah Ekuivalensi</th>
            <th style="padding:10px 14px;text-align:center;">Bobot SKS</th>
            <th style="padding:10px 14px;">Capaian Pembelajaran (CPL)</th>
            <th style="padding:10px 14px;">Dosen Penanggung Jawab</th>
            <th style="padding:10px 14px;text-align:center;">Status Nilai</th>
          </tr>
        </thead>
        <tbody>
          <tr style="border-bottom:1px solid #f1f5f9;">
            <td style="padding:10px 14px;color:#94a3b8;font-weight:600;">1</td>
            <td style="padding:10px 14px;font-family:monospace;font-weight:700;color:var(--primary);">A11.54601</td>
            <td style="padding:10px 14px;font-weight:600;color:#0f172a;">Proyek Perangkat Lunak Terapan</td>
            <td style="padding:10px 14px;text-align:center;"><span class="badge badge-primary">4 SKS</span></td>
            <td style="padding:10px 14px;color:#64748b;font-size:12px;">Pengembangan Sistem &amp; Arsitektur Skala Industri</td>
            <td style="padding:10px 14px;color:#475569;font-size:12px;">Dr. Ricardus Anggi, M.Kom</td>
            <td style="padding:10px 14px;text-align:center;">
              <span class="badge" style="background:#f3e8ff;color:#7c3aed;border:1px solid #e9d5ff;font-size:10px;"><i data-lucide="clock" style="width:10px;height:10px;"></i> Menunggu Sidang</span>
            </td>
          </tr>
          <tr style="border-bottom:1px solid #f1f5f9;">
            <td style="padding:10px 14px;color:#94a3b8;font-weight:600;">2</td>
            <td style="padding:10px 14px;font-family:monospace;font-weight:700;color:var(--primary);">A11.54602</td>
            <td style="padding:10px 14px;font-weight:600;color:#0f172a;">Praktik Kerja &amp; Magang Berkelanjutan</td>
            <td style="padding:10px 14px;text-align:center;"><span class="badge badge-primary">6 SKS</span></td>
            <td style="padding:10px 14px;color:#64748b;font-size:12px;">Kompetensi Profesional Lapangan &amp; Agile</td>
            <td style="padding:10px 14px;color:#475569;font-size:12px;">Dr. Ricardus Anggi, M.Kom</td>
            <td style="padding:10px 14px;text-align:center;">
              <span class="badge" style="background:#f3e8ff;color:#7c3aed;border:1px solid #e9d5ff;font-size:10px;"><i data-lucide="clock" style="width:10px;height:10px;"></i> Menunggu Sidang</span>
            </td>
          </tr>
          <tr style="border-bottom:1px solid #f1f5f9;">
            <td style="padding:10px 14px;color:#94a3b8;font-weight:600;">3</td>
            <td style="padding:10px 14px;font-family:monospace;font-weight:700;color:var(--primary);">A11.54603</td>
            <td style="padding:10px 14px;font-weight:600;color:#0f172a;">Kapita Selekta Komputasi Cerdas</td>
            <td style="padding:10px 14px;text-align:center;"><span class="badge badge-primary">4 SKS</span></td>
            <td style="padding:10px 14px;color:#64748b;font-size:12px;">Adopsi Teknologi Modern &amp; Artificial Intelligence</td>
            <td style="padding:10px 14px;color:#475569;font-size:12px;">Fajar Nugraha, S.Kom., M.T.</td>
            <td style="padding:10px 14px;text-align:center;">
              <span class="badge" style="background:#f3e8ff;color:#7c3aed;border:1px solid #e9d5ff;font-size:10px;"><i data-lucide="clock" style="width:10px;height:10px;"></i> Menunggu Sidang</span>
            </td>
          </tr>
          <tr style="border-bottom:1px solid #f1f5f9;">
            <td style="padding:10px 14px;color:#94a3b8;font-weight:600;">4</td>
            <td style="padding:10px 14px;font-family:monospace;font-weight:700;color:var(--primary);">A11.54604</td>
            <td style="padding:10px 14px;font-weight:600;color:#0f172a;">Metodologi Penelitian &amp; Publikasi</td>
            <td style="padding:10px 14px;text-align:center;"><span class="badge badge-primary">3 SKS</span></td>
            <td style="padding:10px 14px;color:#64748b;font-size:12px;">Target Luaran Prosiding / Jurnal Terindeks</td>
            <td style="padding:10px 14px;color:#475569;font-size:12px;">Dr. Ricardus Anggi, M.Kom</td>
            <td style="padding:10px 14px;text-align:center;">
              <span class="badge" style="background:#f3e8ff;color:#7c3aed;border:1px solid #e9d5ff;font-size:10px;"><i data-lucide="clock" style="width:10px;height:10px;"></i> Menunggu Sidang</span>
            </td>
          </tr>
          <tr>
            <td style="padding:10px 14px;color:#94a3b8;font-weight:600;">5</td>
            <td style="padding:10px 14px;font-family:monospace;font-weight:700;color:var(--primary);">A11.54605</td>
            <td style="padding:10px 14px;font-weight:600;color:#0f172a;">Komunikasi Teknis &amp; Kepemimpinan</td>
            <td style="padding:10px 14px;text-align:center;"><span class="badge badge-primary">3 SKS</span></td>
            <td style="padding:10px 14px;color:#64748b;font-size:12px;">Soft-skills, Komunikasi Profesional &amp; Etika</td>
            <td style="padding:10px 14px;color:#475569;font-size:12px;">Fajar Nugraha, S.Kom., M.T.</td>
            <td style="padding:10px 14px;text-align:center;">
              <span class="badge" style="background:#f3e8ff;color:#7c3aed;border:1px solid #e9d5ff;font-size:10px;"><i data-lucide="clock" style="width:10px;height:10px;"></i> Menunggu Sidang</span>
            </td>
          </tr>
        </tbody>
        <tfoot>
          <tr style="background:#f8fafc;border-top:2px solid #e2e8f0;">
            <td colspan="3" style="padding:12px 14px;font-weight:700;color:#0f172a;text-align:right;">Total Konversi SKS:</td>
            <td style="padding:12px 14px;text-align:center;">
              <span class="badge badge-primary" style="font-size:13px;padding:4px 12px;font-weight:700;">20 SKS</span>
            </td>
            <td colspan="3" style="padding:12px 14px;font-size:12px;color:#64748b;">
              <i data-lucide="lock" style="width:12px;height:12px;display:inline-block;vertical-align:-1px;"></i>
              Nilai akan diinput ke KHS setelah sidang akhir &amp; luaran wajib terverifikasi.
            </td>
          </tr>
        </tfoot>
      </table>
    </div>
  </div>

  <!-- Informasi Pengesahan Formal -->
  <div class="grid grid-2" style="gap:16px;">
    <div class="card" style="padding:18px;border-left:4px solid #16a34a;">
      <div style="font-size:13px;font-weight:700;color:#166534;margin-bottom:8px;display:flex;align-items:center;gap:6px;">
        <i data-lucide="user-check" style="width:15px;height:15px;"></i> Verifikator Koordinator MBKM
      </div>
      <div style="font-size:13px;font-weight:700;color:#0f172a;">Nurul Anisa Sri Winarsih, M.Cs</div>
      <div style="font-size:12px;color:#64748b;margin-top:2px;">Koordinator MBKM FIK &bull; Disetujui 10 Okt 2025</div>
      <span class="badge badge-success" style="margin-top:10px;"><i data-lucide="check" style="width:11px;height:11px;"></i> Terverifikasi</span>
    </div>
    <div class="card" style="padding:18px;border-left:4px solid var(--primary);">
      <div style="font-size:13px;font-weight:700;color:#1e40af;margin-bottom:8px;display:flex;align-items:center;gap:6px;">
        <i data-lucide="shield" style="width:15px;height:15px;"></i> Pengesah Kaprodi
      </div>
      <div style="font-size:13px;font-weight:700;color:#0f172a;">Dr. Ir. Edi Mulyanto, M.Kom</div>
      <div style="font-size:12px;color:#64748b;margin-top:2px;">Kaprodi S1 Teknik Informatika &bull; Dikunci 11 Okt 2025</div>
      <span class="badge badge-primary" style="margin-top:10px;"><i data-lucide="lock" style="width:11px;height:11px;"></i> Disahkan &amp; Dikunci</span>
    </div>
  </div>

</div>

  </div>
</MahasiswaShell>
