---
// src/pages/mahasiswa/dashboard.astro
import MahasiswaShell from "../../layouts/MahasiswaShell.astro";
---

<MahasiswaShell
  title="Dashboard - Kampus Berdampak"
  activeNav="dashboard"
  pageTitle="Dashboard"
  breadcrumb="Dashboard"
>
  <div
    class="space-y-6"
    x-data="{
    copiedGlobal: false,
    copiedDospem: false,
    showOfferBanner: false,
    showPaktaModal: false,
    paktaSubmitted: false,
    copyLink(url, type) {
      if (!url) return;
      navigator.clipboard.writeText(url).then(() => {
        if (type === 'global') {
          this.copiedGlobal = true;
          setTimeout(() => this.copiedGlobal = false, 2000);
        } else {
          this.copiedDospem = true;
          setTimeout(() => this.copiedDospem = false, 2000);
        }
      });
    },
    acceptOffer() {
      this.showPaktaModal = true;
    },
    submitPakta() {
      this.paktaSubmitted = true;
      this.showPaktaModal = false;
    }
  }"
  >
    <!-- Header Sambutan -->
    <header class="flex items-start justify-between gap-4">
      <div>
        <h2 class="text-xl font-normal text-[#09090b] tracking-tight">
          Selamat Datang, Mhs TA KB A11 di prodi Teknik Informatika
        </h2>
        <p
          class="text-sm text-[#71717a] mt-1"
          x-text="$store.mahasiswaSim.state === 'aktif' ? 'Berikut adalah data-data yang dapat Anda akses.' : 'Berikut adalah data pendaftaran program MBKM yang Anda ajukan.'"
        >
          Berikut adalah data-data yang dapat Anda akses.
        </p>
      </div>
    </header>

    <!-- ==================================================== -->
    <!-- CARD SELAMAT DATANG MAHASISWA (TAMPIL DI SEMUA STATE) -->
    <!-- ==================================================== -->
    <div
      class="rounded-xl border border-[#e4e4e7] bg-white text-[#09090b] shadow-none p-6"
    >
      <div
        class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6"
      >
        <!-- Kolom Kiri: Nama, NIM, Semester -->
        <div class="space-y-3">
          <div>
            <h2 class="text-2xl font-bold text-[#09090b] mt-1">
              Muhammad Ilham Maulana
            </h2>
          </div>
          <div class="space-y-1.5">
            <div class="flex items-center gap-2">
              <i data-lucide="id-card" class="w-4 h-4 text-[#71717a]"></i>
              <span class="text-sm text-[#3f3f46]"
                >NIM: <strong class="font-semibold text-[#09090b]"
                  >A11.2020.00001</strong
                ></span
              >
            </div>
            <div class="flex items-center gap-2">
              <i data-lucide="layers" class="w-4 h-4 text-[#71717a]"></i>
              <span class="text-sm text-[#3f3f46]"
                >Semester: <strong class="font-semibold text-[#09090b]"
                  >7</strong
                ></span
              >
            </div>
            <div class="flex items-center gap-2">
              <i data-lucide="book-open" class="w-4 h-4 text-[#71717a]"></i>
              <span class="text-sm text-[#3f3f46]"
                >Program: <strong class="font-semibold text-[#09090b]"
                  >Teknik Informatika</strong
                ></span
              >
            </div>
          </div>
        </div>

        <!-- Kolom Kanan: Informasi Dosen Pembimbing -->
        <div
          class="rounded-lg bg-[#f4f7fc] border border-[#dbeafe] p-4 lg:min-w-[280px]"
        >
          <div class="flex items-start gap-3">
            <div
              class="w-12 h-12 rounded-full bg-blue-200 flex items-center justify-center shrink-0"
            >
              <i data-lucide="user-circle" class="w-6 h-6 text-[#0655a7]"></i>
            </div>
            <div class="flex-1 min-w-0">
              <p
                class="text-xs font-semibold text-[#71717a] uppercase tracking-wide"
              >
                Dosen Pembimbing
              </p>
              <h4 class="text-base font-semibold text-[#09090b] mt-0.5">
                Adhitya Nugraha, S.Kom, M.CS
              </h4>
              <p class="text-xs text-[#71717a] mt-1">
                Email: <span class="text-[#3f3f46] font-mono"
                  >dosen.a11@udinus.ac.id</span
                >
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ==================================================== -->
    <!-- STATE 1: PENDAFTARAN MULTI-PROGRAM (BELUM JOIN MBKM) -->
    <!-- (TIDAK ADA KARTU LOGBOOK / SIDANG / DOSPEM)          -->
    <!-- ==================================================== -->
    <div
      x-show="$store.mahasiswaSim.state === 'belum_daftar'"
      x-cloak
      class="space-y-6"
    >
      <!-- BANNER: Tawaran Mitra Diterima (Hanya Tampil Jika Diterima) -->
      <div
        x-show="showOfferBanner && !paktaSubmitted"
        class="rounded-xl border border-emerald-200 bg-emerald-50/80 p-4 text-emerald-950 flex flex-col sm:flex-row sm:items-center justify-between gap-3 transition-all"
      >
        <div class="flex items-start gap-3">
          <div
            class="w-5 h-5 rounded-full bg-emerald-100 border border-emerald-300 text-emerald-700 flex items-center justify-center shrink-0 mt-0.5"
          >
            <i data-lucide="party-popper" class="h-3.5 w-3.5 text-emerald-700"
            ></i>
          </div>
          <div>
            <h5 class="font-semibold text-emerald-950 text-sm">
              Selamat! Anda Diterima di Bengkel Koding
            </h5>
            <p class="text-xs text-emerald-800 mt-0.5">
              Mitra <strong>Laboratorium Bengkel Koding FIK</strong> telah menerima
              berkas Anda. Konfirmasi penerimaan ini untuk mengisi Pakta Integritas
              dan melanjutkan ke tahap pengajuan Konversi SKS.
            </p>
          </div>
        </div>
        <div class="flex items-center gap-2 shrink-0">
          <button
            type="button"
            @click="acceptOffer()"
            class="px-3.5 py-2 rounded-lg bg-[#0655a7] hover:bg-[#054587] text-white text-xs font-semibold transition-colors flex items-center gap-1.5 cursor-pointer"
          >
            <i data-lucide="check" class="w-3.5 h-3.5"></i>
            <span>Ambil Tawaran & Isi Pakta</span>
          </button>
        </div>
      </div>

      <!-- BANNER: Status Pakta Integritas Menunggu ACC Koordinator -->
      <div
        x-show="paktaSubmitted"
        class="rounded-xl border border-amber-200 bg-amber-50/80 p-4 text-amber-950 flex items-start gap-3 transition-all"
      >
        <div
          class="w-5 h-5 rounded-full bg-amber-100 border border-amber-300 text-amber-700 flex items-center justify-center shrink-0 mt-0.5"
        >
          <i data-lucide="clock" class="h-3.5 w-3.5 text-amber-700"></i>
        </div>
        <div class="text-sm leading-relaxed">
          <h5 class="font-semibold text-amber-950 mb-0.5">
            Pakta Integritas Berhasil Dikirim — Menunggu ACC Koordinator
          </h5>
          <p class="text-xs text-amber-800">
            Berkas Pakta Integritas program <strong>Bengkel Koding</strong> telah
            diunggah dan sedang dalam antrean persetujuan Koordinator MBKM Prodi.
            Setelah di-ACC, menu <strong>Konversi SKS</strong> akan terbuka untuk
            penyusunan matriks 20 SKS.
          </p>
        </div>
      </div>

      <!-- 4 Stat Cards: Informasi Konkret yang Dibutuhkan Mahasiswa Pendaftar -->
      <section class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
        <!-- Card 1: Status Pengajuan -->
        <div
          class="rounded-xl border border-[#e4e4e7] bg-white text-[#09090b] shadow-none"
        >
          <div
            class="flex flex-row items-center justify-between space-y-0 p-4 pb-2"
          >
            <h3 class="text-sm font-medium text-[#09090b]">Status Pengajuan</h3>
            <i data-lucide="file-text" class="h-4 w-4 text-[#71717a]"></i>
          </div>
          <div class="p-4 pt-0">
            <div
              class="text-xl font-semibold mb-2"
              :class="showOfferBanner ? 'text-emerald-600' : 'text-amber-600'"
              x-text="showOfferBanner ? '1 Tawaran Masuk' : 'Menunggu Review'"
            >
              Menunggu Review
            </div>
            <p
              class="text-xs text-[#71717a]"
              x-text="showOfferBanner ? 'Bengkel Koding (Siap Diambil)' : '2 Program sedang ditinjau mitra'"
            >
              2 Program sedang ditinjau mitra
            </p>
          </div>
        </div>

        <!-- Card 2: Jadwal Seleksi Terdekat -->
        <div
          class="rounded-xl border border-[#e4e4e7] bg-white text-[#09090b] shadow-none"
        >
          <div
            class="flex flex-row items-center justify-between space-y-0 p-4 pb-2"
          >
            <h3 class="text-sm font-medium text-[#09090b]">Jadwal Seleksi</h3>
            <i data-lucide="calendar-clock" class="h-4 w-4 text-[#71717a]"></i>
          </div>
          <div class="p-4 pt-0">
            <div class="text-base font-semibold mb-2 text-[#09090b]">
              20 - 22 Okt 2025
            </div>
            <p class="text-xs text-[#71717a]">
              Wawancara daring mitra Bengkel Koding
            </p>
          </div>
        </div>

        <!-- Card 3: Pengumuman Kelulusan -->
        <div
          class="rounded-xl border border-[#e4e4e7] bg-white text-[#09090b] shadow-none"
        >
          <div
            class="flex flex-row items-center justify-between space-y-0 p-4 pb-2"
          >
            <h3 class="text-sm font-medium text-[#09090b]">Pengumuman Hasil</h3>
            <i data-lucide="megaphone" class="h-4 w-4 text-[#71717a]"></i>
          </div>
          <div class="p-4 pt-0">
            <div class="text-base font-semibold mb-2 text-[#09090b]">
              25 Oktober 2025
            </div>
            <p class="text-xs text-[#71717a]">
              Batas akhir verifikasi kelulusan serentak
            </p>
          </div>
        </div>

        <!-- Card 4: Periode Aktif -->
        <div
          class="rounded-xl border border-[#e4e4e7] bg-white text-[#09090b] shadow-none overflow-hidden"
        >
          <div
            class="flex flex-row items-center justify-between space-y-0 p-4 pb-2"
          >
            <h3 class="text-sm font-medium text-[#09090b]">Periode Aktif</h3>
            <i data-lucide="calendar" class="h-4 w-4 text-[#71717a]"></i>
          </div>
          <div class="p-4 pt-0">
            <div class="text-lg font-semibold mb-2 text-[#09090b]">
              2026/2027
            </div>
            <div class="mt-2">
              <div
                class="flex items-center gap-2 text-sm font-medium text-[#09090b]"
              >
                <p>Gelombang Aktif</p>
              </div>
              <p class="text-xs text-[#71717a]">Gelombang 1 MBKM 2026/2027</p>
            </div>
          </div>
        </div>
      </section>

      <!-- TABEL FLAT LIST PENDAFTARAN (TANPA CARD DALAM CARD) -->
      <section class="grid gap-4 lg:grid-cols-3 items-start">
        <!-- Kolom Kiri: Tabel Program yang Diajukan Mahasiswa -->
        <div class="lg:col-span-2">
          <div
            class="rounded-xl border border-[#e4e4e7] bg-white text-[#09090b] shadow-none"
          >
            <div
              class="flex flex-col space-y-1.5 p-4 pb-3 border-b border-[#e4e4e7]"
            >
              <div class="flex items-center justify-between">
                <h3 class="text-base font-semibold text-[#09090b]">
                  Daftar Program MBKM yang Diajukan
                </h3>
                <a
                  href="/mahasiswa/pendaftaran"
                  class="inline-flex items-center gap-1.5 text-xs font-semibold text-[#0655a7] hover:underline"
                >
                  <i data-lucide="plus" class="w-3.5 h-3.5"></i>
                  <span>Daftar Program Lain</span>
                </a>
              </div>
              <p class="text-sm text-[#71717a]">
                Kelola formulir yang telah diajukan. Anda dapat mengedit berkas
                selama pendaftaran belum ditutup mitra.
              </p>
            </div>

            <!-- Tabel Flat List Murni -->
            <div class="overflow-x-auto">
              <table class="w-full text-left text-sm border-collapse">
                <thead>
                  <tr
                    class="border-b border-[#e4e4e7] bg-[#fafafa] text-xs font-semibold text-[#71717a]"
                  >
                    <th class="py-3 px-4">Program & Mitra</th>
                    <th class="py-3 px-4">Skema / SKS</th>
                    <th class="py-3 px-4">Tanggal Daftar</th>
                    <th class="py-3 px-4">Status Seleksi</th>
                    <th class="py-3 px-4 text-right">Aksi</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-[#e4e4e7]">
                  <!-- Program 1: Bengkel Koding -->
                  <tr class="hover:bg-gray-50/50 transition-colors">
                    <td class="py-3.5 px-4 font-medium text-[#09090b]">
                      <div class="font-semibold text-sm">
                        Bengkel Koding — Proyek Web & Mobile
                      </div>
                      <div class="text-xs text-[#71717a]">
                        Laboratorium Bengkel Koding FIK
                      </div>
                    </td>
                    <td class="py-3.5 px-4 text-xs text-[#3f3f46]">
                      <span class="font-medium">Proyek Industri</span>
                      <div class="text-[#71717a]">20 SKS</div>
                    </td>
                    <td class="py-3.5 px-4 text-xs text-[#71717a]">
                      10 Okt 2025
                    </td>
                    <td class="py-3.5 px-4">
                      <template x-if="!showOfferBanner">
                        <span
                          class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-200"
                        >
                          Menunggu Review
                        </span>
                      </template>
                      <template x-if="showOfferBanner && !paktaSubmitted">
                        <span
                          class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200"
                        >
                          Diterima Mitra
                        </span>
                      </template>
                      <template x-if="paktaSubmitted">
                        <span
                          class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold bg-blue-50 text-[#0655a7] border border-blue-200"
                        >
                          Menunggu ACC Pakta
                        </span>
                      </template>
                    </td>
                    <td class="py-3.5 px-4 text-right">
                      <div class="inline-flex items-center gap-1.5">
                        <a
                          href="/pendaftaran-mahasiswa?program=bk"
                          class="inline-flex items-center gap-1 px-2.5 py-1 text-xs font-medium rounded-md border border-[#e4e4e7] bg-white hover:bg-[#f4f4f5] text-[#09090b] transition-colors"
                          title="Edit Formulir Pendaftaran"
                        >
                          <i
                            data-lucide="edit-3"
                            class="w-3.5 h-3.5 text-[#71717a]"></i>
                          <span>Edit</span>
                        </a>
                        <template x-if="showOfferBanner && !paktaSubmitted">
                          <button
                            type="button"
                            @click="acceptOffer()"
                            class="inline-flex items-center gap-1 px-2.5 py-1 text-xs font-semibold rounded-md bg-[#0655a7] hover:bg-[#054587] text-white transition-colors cursor-pointer"
                          >
                            <span>Ambil</span>
                          </button>
                        </template>
                      </div>
                    </td>
                  </tr>

                  <!-- Program 2: IDSS Riset Decision Support -->
                  <tr
                    class="hover:bg-gray-50/50 transition-colors"
                    :class="paktaSubmitted ? 'opacity-40' : ''"
                  >
                    <td class="py-3.5 px-4 font-medium text-[#09090b]">
                      <div class="font-semibold text-sm">
                        IDSS — Riset Decision Support & AI
                      </div>
                      <div class="text-xs text-[#71717a]">
                        Lab Intelligent Decision Support System
                      </div>
                    </td>
                    <td class="py-3.5 px-4 text-xs text-[#3f3f46]">
                      <span class="font-medium">Publikasi / Riset</span>
                      <div class="text-[#71717a]">20 SKS</div>
                    </td>
                    <td class="py-3.5 px-4 text-xs text-[#71717a]">
                      15 Okt 2025
                    </td>
                    <td class="py-3.5 px-4">
                      <template x-if="!paktaSubmitted">
                        <span
                          class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-200"
                        >
                          Menunggu Review
                        </span>
                      </template>
                      <template x-if="paktaSubmitted">
                        <span
                          class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold bg-gray-100 text-gray-500 border border-gray-200"
                        >
                          Gugur (Withdrawn)
                        </span>
                      </template>
                    </td>
                    <td class="py-3.5 px-4 text-right">
                      <template x-if="!paktaSubmitted">
                        <a
                          href="/pendaftaran-mahasiswa?program=idss"
                          class="inline-flex items-center gap-1 px-2.5 py-1 text-xs font-medium rounded-md border border-[#e4e4e7] bg-white hover:bg-[#f4f4f5] text-[#09090b] transition-colors"
                          title="Edit Formulir Pendaftaran"
                        >
                          <i
                            data-lucide="edit-3"
                            class="w-3.5 h-3.5 text-[#71717a]"></i>
                          <span>Edit</span>
                        </a>
                      </template>
                      <template x-if="paktaSubmitted">
                        <span class="text-xs text-gray-400 italic"
                          >Tertutup</span
                        >
                      </template>
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>

            <div
              class="p-4 border-t border-[#e4e4e7] flex items-center justify-between text-xs text-[#71717a]"
            >
              <span
                >Format pengajuan multi-mitra dengan 1 kuota penerimaan resmi.</span
              >
              <a
                href="/mahasiswa/pendaftaran-detail"
                class="font-semibold text-[#0655a7] hover:underline"
              >
                Lihat Detail Berkas Pendaftaran &rarr;
              </a>
            </div>
          </div>
        </div>

        <!-- Kolom Kanan: Grup Global MBKM & Info Pendaftaran -->
        <div class="space-y-4">
          <!-- Grup Koordinasi MBKM (Hanya Grup Global, TANPA Dospem) -->
          <div
            class="rounded-xl border border-[#e4e4e7] bg-white text-[#09090b] shadow-none"
          >
            <div class="flex flex-col space-y-1.5 p-4 pb-2">
              <h3
                class="flex items-center gap-2 text-base font-semibold text-[#09090b]"
              >
                <i data-lucide="message-square" class="h-5 w-5 text-[#09090b]"
                ></i>
                Grup Koordinasi MBKM
              </h3>
              <p class="text-sm text-[#71717a]">
                Akses komunikasi resmi calon pendaftar
              </p>
            </div>
            <div class="p-4 pt-0 space-y-4">
              <div class="flex items-start gap-3">
                <div
                  class="flex size-10 items-center justify-center rounded-full bg-blue-100 shrink-0"
                >
                  <i data-lucide="message-square" class="size-4 text-blue-600"
                  ></i>
                </div>
                <div class="flex-1">
                  <h4 class="font-semibold text-[#09090b] text-sm mb-1">
                    Grup Pendaftar MBKM 2025
                  </h4>
                  <p class="text-xs text-[#71717a]">
                    Diskusi pengumuman seleksi dan koordinasi fakultas
                  </p>
                </div>
              </div>
              <div class="flex items-center gap-2">
                <div
                  class="flex-1 bg-gray-50 rounded-md p-2.5 px-3 border border-gray-200 min-w-0"
                >
                  <p
                    class="text-xs text-gray-600 font-medium truncate overflow-hidden"
                  >
                    https://chat.whatsapp.com/MBKM-Calon-2025
                  </p>
                </div>
                <button
                  type="button"
                  @click="copyLink('https://chat.whatsapp.com/MBKM-Calon-2025', 'global')"
                  class="h-9 w-9 p-0 rounded-md border border-gray-200 bg-white hover:bg-gray-50 flex items-center justify-center text-gray-700 cursor-pointer shrink-0 transition-colors"
                  title="Salin Tautan"
                >
                  <i x-show="!copiedGlobal" data-lucide="copy" class="h-4 w-4"
                  ></i>
                  <i
                    x-show="copiedGlobal"
                    data-lucide="check"
                    class="h-4 w-4 text-green-600"></i>
                </button>
              </div>
            </div>
          </div>

          <!-- Pengumuman Penting Seleksi -->
          <div
            class="rounded-xl border border-[#e4e4e7] bg-white text-[#09090b] shadow-none p-4"
          >
            <div
              class="text-sm font-medium mb-2 flex items-center gap-2 justify-between"
            >
              <span class="text-sm font-medium text-[#09090b]"
                >Pengumuman Penting</span
              >
              <i data-lucide="info" class="h-4 w-4 text-[#71717a]"></i>
            </div>
            <div
              class="flex flex-col items-center justify-center py-6 text-center"
            >
              <div class="rounded-full bg-gray-100 p-2 mb-2">
                <i data-lucide="info" class="h-4 w-4 text-[#71717a]"></i>
              </div>
              <h3 class="text-base font-medium text-[#09090b]">
                Tidak ada pengumuman
              </h3>
              <p class="text-xs text-[#71717a] mt-1 max-w-md">
                Belum ada pengumuman yang ditambahkan
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- MODAL PENGISIAN PAKTA INTEGRITAS -->
      <div
        x-show="showPaktaModal"
        class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4 backdrop-blur-xs"
        x-cloak
      >
        <div
          class="w-full max-w-lg rounded-xl border border-[#e4e4e7] bg-white p-6 shadow-xl space-y-5"
          @click.outside="showPaktaModal = false"
        >
          <div class="border-b border-[#e4e4e7] pb-3">
            <h3 class="text-lg font-semibold text-[#09090b]">
              Konfirmasi Penerimaan & Pakta Integritas
            </h3>
            <p class="text-xs text-[#71717a] mt-0.5">
              Program: Bengkel Koding — Proyek Web & Mobile
            </p>
          </div>

          <div class="space-y-3.5 text-xs text-[#3f3f46]">
            <p class="leading-relaxed">
              Dengan mengambil tawaran ini, Anda berkomitmen mengikuti kegiatan
              MBKM sampai selesai. Program pendaftaran lain yang Anda ajukan
              akan otomatis digugurkan oleh sistem.
            </p>

            <div
              class="rounded-lg border border-[#e4e4e7] bg-[#fafafa] p-3 space-y-2"
            >
              <span class="font-semibold text-[#09090b] block"
                >Surat Pakta Integritas Mahasiswa:</span
              >
              <div class="flex items-center justify-between">
                <span class="text-[#71717a]">Template Surat:</span>
