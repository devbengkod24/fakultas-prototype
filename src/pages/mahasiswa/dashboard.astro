---
// src/pages/mahasiswa/dashboard.astro
import MahasiswaShell from '../../layouts/MahasiswaShell.astro';
---

<MahasiswaShell
  title="Dashboard Mahasiswa | Kampus Berdampak FIK UDINUS"
  activeNav="dashboard"
  pageTitle="Dashboard Mahasiswa"
  breadcrumb="Dashboard"
>
  <section id="view-dashboard" class="space-y-6">
    <!-- Page Header (Standar Typography contributor) -->
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div>
        <h2 class="text-[20px] leading-[28px] font-normal text-[#09090b]">Dashboard Mahasiswa</h2>
        <p class="text-[14px] leading-[20px] text-[#71717a]">Informasi profil, kelayakan persyaratan umum MBKM, dan status pendaftaran program.</p>
      </div>
      <div class="flex items-center gap-2">
        <a href="/mahasiswa/pendaftaran" class="inline-flex items-center gap-2 px-4 py-2 bg-[#1063B9] hover:bg-[#0E4F96] text-white text-xs font-semibold rounded-lg shadow-2xs transition-all active:scale-[0.98]">
          <i data-lucide="file-text" class="w-4 h-4"></i>
          <span>Form Pendaftaran MBKM</span>
        </a>
      </div>
    </div>

    <!-- User Profile & Eligibility Overview Card -->
    <div class="p-5 bg-white border border-[#e4e4e7] rounded-[12px] shadow-2xs flex flex-col md:flex-row items-start md:items-center justify-between gap-5">
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 rounded-full bg-[#1063B9] text-white font-semibold text-lg flex items-center justify-center shrink-0">
          AR
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h3 class="text-[16px] font-semibold text-[#09090b]" id="mahasiswa-name">Ahmad Rizky Pratama</h3>
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[11px] font-medium bg-emerald-50 text-emerald-800 border border-emerald-200" id="badge-status-kelayakan">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Layak MBKM
            </span>
          </div>
          <p class="text-[13px] text-[#71717a] mt-0.5">NIM: A11.2022.14253 • Teknik Informatika (S1) • Semester 6</p>
        </div>
      </div>
      <div class="flex items-center gap-3 w-full md:w-auto border-t md:border-t-0 pt-3 md:pt-0 border-[#e4e4e7]">
        <button type="button" onclick="simulasiKelayakan(true)" class="px-3 py-1.5 bg-emerald-50 hover:bg-emerald-100 text-emerald-700 border border-emerald-200 text-xs font-semibold rounded-md transition-colors">
          Simulasi: Memenuhi
        </button>
        <button type="button" onclick="simulasiKelayakan(false)" class="px-3 py-1.5 bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 text-xs font-semibold rounded-md transition-colors">
          Simulasi: Tidak Memenuhi
        </button>
      </div>
    </div>

    <!-- 4 KPI Cards Persyaratan Umum MBKM -->
    <div>
      <div class="mb-3">
        <h3 class="text-[14px] font-semibold text-[#09090b]">Validasi Persyaratan Umum MBKM</h3>
        <p class="text-[12px] text-[#71717a]">Standar kelayakan mahasiswa untuk mendaftar program MBKM Fakultas Ilmu Komputer.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Card 1: Semester -->
        <div class="p-4 bg-white border border-[#e4e4e7] rounded-[12px] shadow-2xs flex flex-col justify-between">
          <div class="flex items-center justify-between text-[#71717a] text-xs mb-2">
            <span>Status Semester</span>
            <i data-lucide="calendar" class="w-4 h-4 text-[#1063B9]"></i>
          </div>
          <div class="text-[24px] font-bold text-[#09090b]" id="val-semester">Semester 6</div>
          <div class="flex items-center justify-between text-[12px] mt-2 pt-2 border-t border-gray-100">
            <span class="text-[#71717a]">Syarat: Smt 6, 7, atau 8</span>
            <span class="inline-flex items-center gap-1 font-semibold text-emerald-700 bg-emerald-50 px-1.5 py-0.5 rounded text-[11px]" id="badge-semester">
              <i data-lucide="check" class="w-3 h-3"></i> Memenuhi
            </span>
          </div>
        </div>

        <!-- Card 2: IPK Minimal 3.00 -->
        <div class="p-4 bg-white border border-[#e4e4e7] rounded-[12px] shadow-2xs flex flex-col justify-between">
          <div class="flex items-center justify-between text-[#71717a] text-xs mb-2">
            <span>IPK Kumulatif</span>
            <i data-lucide="award" class="w-4 h-4 text-[#1063B9]"></i>
          </div>
          <div class="text-[24px] font-bold text-[#09090b]" id="val-ipk">3.72</div>
          <div class="flex items-center justify-between text-[12px] mt-2 pt-2 border-t border-gray-100">
            <span class="text-[#71717a]">Syarat: Min. IPK 3.00</span>
            <span class="inline-flex items-center gap-1 font-semibold text-emerald-700 bg-emerald-50 px-1.5 py-0.5 rounded text-[11px]" id="badge-ipk">
              <i data-lucide="check" class="w-3 h-3"></i> Memenuhi
            </span>
          </div>
        </div>

        <!-- Card 3: Status Cuti -->
        <div class="p-4 bg-white border border-[#e4e4e7] rounded-[12px] shadow-2xs flex flex-col justify-between">
          <div class="flex items-center justify-between text-[#71717a] text-xs mb-2">
            <span>Riwayat Cuti</span>
            <i data-lucide="user-check" class="w-4 h-4 text-[#1063B9]"></i>
          </div>
          <div class="text-[24px] font-bold text-[#09090b]" id="val-cuti">Tidak Cuti</div>
          <div class="flex items-center justify-between text-[12px] mt-2 pt-2 border-t border-gray-100">
            <span class="text-[#71717a]">Syarat: Tidak Pernah Cuti</span>
            <span class="inline-flex items-center gap-1 font-semibold text-emerald-700 bg-emerald-50 px-1.5 py-0.5 rounded text-[11px]" id="badge-cuti">
              <i data-lucide="check" class="w-3 h-3"></i> Memenuhi
            </span>
          </div>
        </div>

        <!-- Card 4: SKS Ditempuh -->
        <div class="p-4 bg-white border border-[#e4e4e7] rounded-[12px] shadow-2xs flex flex-col justify-between">
          <div class="flex items-center justify-between text-[#71717a] text-xs mb-2">
            <span>SKS Ditempuh</span>
            <i data-lucide="book-open" class="w-4 h-4 text-[#1063B9]"></i>
          </div>
          <div class="text-[24px] font-bold text-[#09090b]" id="val-sks">104 SKS</div>
          <div class="flex items-center justify-between text-[12px] mt-2 pt-2 border-t border-gray-100">
            <span class="text-[#71717a]">Syarat: Min. 100 SKS</span>
            <span class="inline-flex items-center gap-1 font-semibold text-emerald-700 bg-emerald-50 px-1.5 py-0.5 rounded text-[11px]" id="badge-sks">
              <i data-lucide="check" class="w-3 h-3"></i> Memenuhi
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- Section: Status Pendaftaran Program MBKM -->
    <div class="bg-white border border-[#e4e4e7] rounded-[12px] p-5 shadow-2xs space-y-4">
      <div class="flex items-center justify-between pb-3 border-b border-[#e4e4e7]">
        <div>
          <h3 class="text-[14px] font-semibold text-[#09090b]">Status Pendaftaran Program MBKM</h3>
          <p class="text-[12px] text-[#71717a]">Daftar dan perkembangan pendaftaran program MBKM yang telah diajukan.</p>
        </div>
        <a href="/mahasiswa/status" class="text-xs text-[#1063B9] font-medium hover:underline flex items-center gap-1">
          <span>Lihat Detail Status</span>
          <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
        </a>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs border-collapse">
          <thead>
            <tr class="bg-gray-50 text-[11px] font-semibold text-[#71717a] uppercase tracking-wider border-b border-[#e4e4e7]">
              <th class="py-2.5 px-3">Program &amp; Mitra</th>
              <th class="py-2.5 px-3">Kategori</th>
              <th class="py-2.5 px-3">Tanggal Daftar</th>
              <th class="py-2.5 px-3">Status Pendaftaran</th>
              <th class="py-2.5 px-3">Perkembangan Pendaftaran</th>
              <th class="py-2.5 px-3 text-right">Aksi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <tr class="hover:bg-gray-50/70 transition-colors">
              <td class="py-3 px-3">
                <div class="font-medium text-[13px] text-[#09090b]">Magang Software Engineer</div>
                <div class="text-[12px] text-[#71717a]">PT Telkom Indonesia (Persero) Tbk</div>
              </td>
              <td class="py-3 px-3">
                <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-medium bg-blue-50 text-[#1063B9] border border-blue-100">
                  Magang Mandiri
                </span>
              </td>
              <td class="py-3 px-3 text-[#71717a]">
                10 Oktober 2025
              </td>
              <td class="py-3 px-3">
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[11px] font-medium bg-amber-50 text-amber-800 border border-amber-200">
                  <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> Menunggu Verifikasi
                </span>
              </td>
              <td class="py-3 px-3">
                <div class="w-full max-w-xs">
                  <div class="flex items-center justify-between text-[11px] text-[#71717a] mb-1">
                    <span>Tahap 1 dari 3</span>
                    <span class="font-medium text-[#09090b]">33%</span>
                  </div>
                  <div class="w-full h-1.5 bg-gray-100 rounded-full overflow-hidden">
                    <div class="h-full bg-[#1063B9] rounded-full" style="width: 33%"></div>
                  </div>
                  <span class="text-[11px] text-[#71717a] mt-1 block">Verifikasi Berkas Dekanat</span>
                </div>
              </td>
              <td class="py-3 px-3 text-right">
                <a href="/mahasiswa/status" class="px-2.5 py-1 bg-white hover:bg-gray-50 text-[#09090b] border border-[#e4e4e7] rounded text-xs font-medium transition-colors inline-block">
                  Detail
                </a>
              </td>
            </tr>
            <tr class="hover:bg-gray-50/70 transition-colors">
              <td class="py-3 px-3">
                <div class="font-medium text-[13px] text-[#09090b]">Studi Independen Fullstack Web</div>
                <div class="text-[12px] text-[#71717a]">PT Hacktiv8 Digital Indonesia</div>
              </td>
              <td class="py-3 px-3">
                <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-medium bg-purple-50 text-purple-700 border border-purple-100">
                  Studi Independen
                </span>
              </td>
              <td class="py-3 px-3 text-[#71717a]">
                15 Agustus 2025
              </td>
              <td class="py-3 px-3">
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[11px] font-medium bg-emerald-50 text-emerald-800 border border-emerald-200">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Selesai
                </span>
              </td>
              <td class="py-3 px-3">
                <div class="w-full max-w-xs">
                  <div class="flex items-center justify-between text-[11px] text-[#71717a] mb-1">
                    <span>Tahap 3 dari 3</span>
                    <span class="font-medium text-emerald-700">100%</span>
                  </div>
                  <div class="w-full h-1.5 bg-gray-100 rounded-full overflow-hidden">
                    <div class="h-full bg-emerald-500 rounded-full" style="width: 100%"></div>
                  </div>
                  <span class="text-[11px] text-emerald-700 mt-1 block">Program Telah Dikonversi</span>
                </div>
              </td>
              <td class="py-3 px-3 text-right">
                <a href="/mahasiswa/status" class="px-2.5 py-1 bg-white hover:bg-gray-50 text-[#09090b] border border-[#e4e4e7] rounded text-xs font-medium transition-colors inline-block">
                  Detail
                </a>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <script is:inline>
    function simulasiKelayakan(layak) {
      const badgeKelayakan = document.getElementById('badge-status-kelayakan');
      const bSemester = document.getElementById('badge-semester');
      const bIpk = document.getElementById('badge-ipk');
      const bCuti = document.getElementById('badge-cuti');
      const bSks = document.getElementById('badge-sks');

      const vSemester = document.getElementById('val-semester');
      const vIpk = document.getElementById('val-ipk');
      const vCuti = document.getElementById('val-cuti');
      const vSks = document.getElementById('val-sks');

      if (layak) {
        badgeKelayakan.className = "inline-flex items-center gap-1 px-2 py-0.5 rounded text-[11px] font-medium bg-emerald-50 text-emerald-800 border border-emerald-200";
        badgeKelayakan.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Layak MBKM';

        vSemester.textContent = 'Semester 6';
        vIpk.textContent = '3.72';
        vCuti.textContent = 'Tidak Cuti';
        vSks.textContent = '104 SKS';

        [bSemester, bIpk, bCuti, bSks].forEach(el => {
          el.className = 'inline-flex items-center gap-1 font-semibold text-emerald-700 bg-emerald-50 px-1.5 py-0.5 rounded text-[11px]';
          el.innerHTML = '<i data-lucide="check" class="w-3 h-3"></i> Memenuhi';
        });
      } else {
        badgeKelayakan.className = "inline-flex items-center gap-1 px-2 py-0.5 rounded text-[11px] font-medium bg-rose-50 text-rose-800 border border-rose-200";
        badgeKelayakan.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span> Belum Memenuhi';

        vSemester.textContent = 'Semester 4';
        vIpk.textContent = '2.85';
        vCuti.textContent = 'Pernah Cuti';
        vSks.textContent = '82 SKS';

        [bSemester, bIpk, bCuti, bSks].forEach(el => {
          el.className = 'inline-flex items-center gap-1 font-semibold text-rose-700 bg-rose-50 px-1.5 py-0.5 rounded text-[11px]';
          el.innerHTML = '<i data-lucide="x" class="w-3 h-3"></i> Belum Memenuhi';
        });
      }

      if (typeof lucide !== 'undefined') {
        lucide.createIcons();
      }
    }
  </script>
</MahasiswaShell>

