---
// src/pages/mahasiswa/dashboard.astro
import MahasiswaShell from "../../layouts/MahasiswaShell.astro";
import MahasiswaProfileCard from "../../components/mbkm/mahasiswa/MahasiswaProfileCard.astro";
import PendaftarRoadmapCard from "../../components/mbkm/mahasiswa/PendaftarRoadmapCard.astro";
import PendaftarProgramTable from "../../components/mbkm/mahasiswa/PendaftarProgramTable.astro";
import PendaftarSidebar from "../../components/mbkm/mahasiswa/PendaftarSidebar.astro";
import PaktaIntegritasModal from "../../components/mbkm/mahasiswa/PaktaIntegritasModal.astro";
import AktifStatCards from "../../components/mbkm/mahasiswa/AktifStatCards.astro";
import AktifLogbookCard from "../../components/mbkm/mahasiswa/AktifLogbookCard.astro";
import AktifSidebar from "../../components/mbkm/mahasiswa/AktifSidebar.astro";
---

<MahasiswaShell
  title="Dashboard - Kampus Berdampak"
  activeNav="dashboard"
  pageTitle="Dashboard"
  breadcrumb="Dashboard"
>
  <div
    class="space-y-4"
    x-data="{
    copiedGlobal: false,
    copiedDospem: false,
    showPaktaModal: false,
    activeMitraTab: 'bk',
    get showOfferBanner() {
      return $store.mahasiswaSim.pendaftarSubState === 'offered';
    },
    get paktaSubmitted() {
      return $store.mahasiswaSim.pendaftarSubState === 'submitted';
    },
    copyLink(url, type) {
      if (!url) return;
      navigator.clipboard.writeText(url).then(() => {
        if (type === 'global') {
          this.copiedGlobal = true;
          setTimeout(() => this.copiedGlobal = false, 2000);
        } else {
          this.copiedDospem = true;
          setTimeout(() => this.copiedDospem = false, 2000);
        }
      });
    },
    acceptOffer() {
      this.showPaktaModal = true;
    },
    submitPakta() {
      $store.mahasiswaSim.setPendaftarSubState('submitted');
      this.showPaktaModal = false;
    }
  }"
  >
    <!-- Header Sambutan (Format Standar Selaras Koordinator MBKM di Admin Dashboard) -->
    <header class="mb-4 flex items-start justify-between gap-4 shrink-0">
      <div>
        <h2 class="text-xl font-normal text-[#09090b] tracking-tight">
          Selamat Datang, Mahasiswa Kampus Berdampak di Fakultas Ilmu Komputer
        </h2>
        <p class="text-sm text-[#71717a] mt-0.5">
          Berikut adalah data-data dan ringkasan operasional yang dapat Anda akses.
        </p>
      </div>
    </header>

    <!-- Card Profil Mahasiswa & Dosen Pembimbing -->
    <MahasiswaProfileCard />

    <!-- STATE 1: PENDAFTARAN MULTI-PROGRAM (BELUM JOIN MBKM) -->
    <div
      x-show="$store.mahasiswaSim.state === 'belum_daftar'"
      x-cloak
      class="space-y-4"
    >
      <!-- Roadmap Stepper Trail: Tepat di Bawah Profil agar Langsung Ter-highlight -->
      <PendaftarRoadmapCard />
      <section class="grid gap-4 lg:grid-cols-3 items-stretch">
        <PendaftarProgramTable />
        <PendaftarSidebar />
      </section>
      <PaktaIntegritasModal />
    </div>

    <!-- STATE 2: DITERIMA & AKTIF -->
    <div
      x-show="$store.mahasiswaSim.state === 'aktif'"
      x-cloak
      class="space-y-4"
    >
      <AktifStatCards />
      <section class="grid gap-4 lg:grid-cols-3 items-stretch">
        <AktifLogbookCard />
        <AktifSidebar />
      </section>
    </div>
  </div>
</MahasiswaShell>
