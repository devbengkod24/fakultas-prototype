---
import MahasiswaShell from '../../layouts/MahasiswaShell.astro';
---

<MahasiswaShell
  title="Katalog Program Mitra Resmi | Kampus Berdampak - FIK Udinus"
  pageTitle="Katalog Program Mitra Resmi"
  subtitle="Eksplorasi formasi riset & industri resmi FIK Udinus."
  breadcrumb="Katalog Program"
  activeNav="eksplorasi"
>
<!-- Katalog Program MBKM Mitra Resmi (Diadopsi dari Pola BK) -->
<div style="margin-bottom:24px;">

  <!-- Banner Info Keterikatan Fase -->
  <div id="katalog-active-warning" style="display:none;margin-bottom:16px;">
    <div class="alert alert-warning">
      <i data-lucide="info" style="width:20px;height:20px;"></i>
      <div>
        <div class="alert-title">Anda Telah Berstatus Peserta Aktif MBKM</div>
        <div class="alert-desc">
          Sesuai aturan <em>Single-Application Active</em>, pendaftaran program baru dinonaktifkan karena Anda telah resmi diterima di mitra <strong>Bengkel Koding</strong>.
        </div>
      </div>
    </div>
  </div>

  <!-- Header Bar Katalog -->
  <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-bottom:16px;">
    <div>
      <h2 style="font-size:18px;font-weight:700;color:#1e293b;display:flex;align-items:center;gap:8px;">
        <i data-lucide="compass" style="color:var(--primary);width:20px;height:20px;"></i>
        Katalog Lowongan Program Mitra Resmi MBKM
      </h2>
      <p style="font-size:13px;color:#64748b;margin-top:2px;">
        Eksplorasi formasi resmi mitra laboratorium riset internal dan industri yang membuka gelombang pendaftaran semester ini.
      </p>
    </div>
    <div style="display:flex;align-items:center;gap:8px;">
      <span class="badge badge-success"><i data-lucide="calendar" style="width:12px;height:12px;"></i> Gelombang Aktif Genap 2025/2026</span>
    </div>
  </div>

  <!-- Search & Filter Controls: Skema Baku (Asistensi, Proyek, Publikasi/Riset) -->
  <div class="card" style="padding:14px 18px;margin-bottom:20px;">
    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;">
      <!-- Skema Baku Filter Tabs -->
      <div style="display:flex;align-items:center;gap:8px;overflow-x:auto;">
        <button class="btn btn-sm btn-primary filter-katalog-btn active" data-skema="all" onclick="filterKatalog('all', this)">Semua Skema</button>
        <button class="btn btn-sm btn-outline filter-katalog-btn" data-skema="asistensi" onclick="filterKatalog('asistensi', this)">Asistensi Pengajar</button>
        <button class="btn btn-sm btn-outline filter-katalog-btn" data-skema="proyek" onclick="filterKatalog('proyek', this)">Proyek Industri</button>
        <button class="btn btn-sm btn-outline filter-katalog-btn" data-skema="riset" onclick="filterKatalog('riset', this)">Publikasi / Riset</button>
      </div>

      <!-- Search Input -->
      <div style="display:flex;align-items:center;gap:8px;min-width:260px;">
        <div style="position:relative;width:100%;">
          <i data-lucide="search" style="position:absolute;left:10px;top:50%;transform:translateY(-50%);width:14px;height:14px;color:#94a3b8;"></i>
          <input type="text" id="search-katalog" class="form-control" placeholder="Cari mitra / tag keahlian..." style="padding:6px 12px 6px 32px;font-size:13px;" oninput="searchKatalog(this.value)" />
        </div>
      </div>
    </div>
  </div>

  <!-- Grid Kartu Program Mitra Lengkap -->
  <div class="grid grid-2" id="katalog-grid" style="gap:18px;">

    <!-- Program 1: Bengkel Koding (Proyek Industri) -->
    <div class="card katalog-card" data-skema="proyek" style="display:flex;flex-direction:column;justify-content:space-between;border:1px solid #e2e8f0;padding:20px;">
      <div>
        <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:10px;margin-bottom:12px;">
          <div style="display:flex;align-items:center;gap:12px;">
            <div style="width:44px;height:44px;border-radius:10px;background:#eff6ff;color:var(--primary);display:flex;align-items:center;justify-content:center;font-weight:800;font-size:16px;border:1px solid #bfdbfe;">
              BK
            </div>
            <div>
              <span class="badge badge-primary" style="font-size:10px;">Skema: Proyek Industri</span>
              <h3 style="font-size:16px;font-weight:700;color:#0f172a;margin-top:2px;">Bengkel Koding &mdash; Proyek Web &amp; Mobile</h3>
              <div style="font-size:12px;color:#64748b;">Mitra: Laboratorium Bengkel Koding FIK</div>
            </div>
          </div>
          <span class="badge badge-success">20 SKS</span>
        </div>

        <!-- Metadata Kuota, Durasi, Dosen Pembina -->
        <div style="display:flex;flex-direction:column;gap:6px;font-size:12px;margin-bottom:14px;background:#f8fafc;padding:10px 12px;border-radius:8px;border:1px solid #e2e8f0;">
          <div style="display:flex;justify-content:space-between;">
            <span style="color:#64748b;">Kuota Pendaftar:</span>
            <span style="font-weight:700;color:#16a34a;">Sisa 7 dari 20 Kursi</span>
          </div>
          <div style="display:flex;justify-content:space-between;">
            <span style="color:#64748b;">Durasi Kegiatan:</span>
            <span style="font-weight:600;color:#0f172a;">1 Semester (6 Bulan &bull; Ekuivalen 20 SKS)</span>
          </div>
          <div style="display:flex;justify-content:space-between;">
            <span style="color:#64748b;">Dosen Pembina Mitra:</span>
            <span style="font-weight:600;color:var(--primary);">Dr. Ricardus Anggi, M.Kom &amp; Fajar Nugraha, S.Kom</span>
          </div>
        </div>

        <!-- Checklist Rincian Kewajiban & Fasilitas Hak Mahasiswa -->
        <div style="margin-bottom:14px;font-size:12px;">
          <strong style="color:#1e293b;display:block;margin-bottom:4px;">Checklist Hak &amp; Kewajiban:</strong>
          <ul style="list-style:none;padding:0;display:flex;flex-direction:column;gap:4px;color:#475569;">
            <li style="display:flex;align-items:center;gap:6px;">
              <i data-lucide="check" style="width:13px;height:13px;color:#16a34a;"></i>
              <strong>Hak:</strong> Konversi penuh 20 SKS, sertifikat resmi mitra, &amp; workstation lab.
            </li>
            <li style="display:flex;align-items:center;gap:6px;">
              <i data-lucide="alert-circle" style="width:13px;height:13px;color:#d97706;"></i>
              <strong>Kewajiban:</strong> Presensi 80%, logbook mingguan, &amp; demo produk sprint 2 mingguan.
            </li>
          </ul>
        </div>

        <!-- Tag Keterampilan yang Dibutuhkan -->
        <div style="margin-bottom:16px;">
          <span style="font-size:11px;font-weight:600;color:#64748b;text-transform:uppercase;">Tag Keahlian:</span>
          <div style="display:flex;flex-wrap:wrap;gap:6px;margin-top:4px;">
            <span style="padding:2px 8px;background:#f1f5f9;border-radius:4px;font-size:11px;color:#334155;font-weight:500;">React / Next.js</span>
            <span style="padding:2px 8px;background:#f1f5f9;border-radius:4px;font-size:11px;color:#334155;font-weight:500;">Node.js / Express</span>
            <span style="padding:2px 8px;background:#f1f5f9;border-radius:4px;font-size:11px;color:#334155;font-weight:500;">PostgreSQL</span>
            <span style="padding:2px 8px;background:#f1f5f9;border-radius:4px;font-size:11px;color:#334155;font-weight:500;">Git &amp; Scrum</span>
          </div>
        </div>
      </div>

      <div style="display:flex;align-items:center;justify-content:space-between;border-top:1px solid #f1f5f9;padding-top:14px;">
        <span style="font-size:11px;color:#64748b;">Batas: 18 Okt 2025</span>
        <button class="btn btn-primary" onclick="selectProgramAndRegister('Bengkel Koding — Proyek Web & Mobile', 'proyek')">
          <i data-lucide="send"></i> Ajukan Pendaftaran &rarr;
        </button>
      </div>
    </div>

    <!-- Program 2: IDSS Lab (Publikasi / Riset) -->
    <div class="card katalog-card" data-skema="riset" style="display:flex;flex-direction:column;justify-content:space-between;border:1px solid #e2e8f0;padding:20px;">
      <div>
        <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:10px;margin-bottom:12px;">
          <div style="display:flex;align-items:center;gap:12px;">
            <div style="width:44px;height:44px;border-radius:10px;background:#faf5ff;color:#9333ea;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:16px;border:1px solid #e9d5ff;">
              ID
            </div>
            <div>
              <span class="badge" style="font-size:10px;background:#f3e8ff;color:#7e22ce;border:1px solid #d8b4fe;">Skema: Publikasi / Riset</span>
              <h3 style="font-size:16px;font-weight:700;color:#0f172a;margin-top:2px;">IDSS &mdash; Riset Decision Support &amp; AI</h3>
              <div style="font-size:12px;color:#64748b;">Mitra: Lab Intelligent Decision Support System</div>
            </div>
          </div>
          <span class="badge badge-success">20 SKS</span>
        </div>

        <div style="display:flex;flex-direction:column;gap:6px;font-size:12px;margin-bottom:14px;background:#f8fafc;padding:10px 12px;border-radius:8px;border:1px solid #e2e8f0;">
          <div style="display:flex;justify-content:space-between;">
            <span style="color:#64748b;">Kuota Pendaftar:</span>
            <span style="font-weight:700;color:#16a34a;">Sisa 4 dari 10 Kursi</span>
          </div>
          <div style="display:flex;justify-content:space-between;">
            <span style="color:#64748b;">Durasi Kegiatan:</span>
            <span style="font-weight:600;color:#0f172a;">1 Semester (6 Bulan &bull; Ekuivalen 20 SKS)</span>
          </div>
          <div style="display:flex;justify-content:space-between;">
            <span style="color:#64748b;">Dosen Pembina Mitra:</span>
            <span style="font-weight:600;color:var(--primary);">Prof. Dr. Supriadi, M.Kom &amp; Tim Dosen AI</span>
          </div>
        </div>

        <div style="margin-bottom:14px;font-size:12px;">
          <strong style="color:#1e293b;display:block;margin-bottom:4px;">Checklist Hak &amp; Kewajiban:</strong>
          <ul style="list-style:none;padding:0;display:flex;flex-direction:column;gap:4px;color:#475569;">
            <li style="display:flex;align-items:center;gap:6px;">
              <i data-lucide="check" style="width:13px;height:13px;color:#16a34a;"></i>
              <strong>Hak:</strong> Insentif publikasi seminar nasional, GPU cluster access, &amp; bimbingan naskah.
            </li>
            <li style="display:flex;align-items:center;gap:6px;">
              <i data-lucide="alert-circle" style="width:13px;height:13px;color:#d97706;"></i>
              <strong>Kewajiban:</strong> Target wajib 1 naskah submit prosiding/jurnal terindeks (LoA).
            </li>
          </ul>
        </div>

        <div style="margin-bottom:16px;">
          <span style="font-size:11px;font-weight:600;color:#64748b;text-transform:uppercase;">Tag Keahlian:</span>
          <div style="display:flex;flex-wrap:wrap;gap:6px;margin-top:4px;">
            <span style="padding:2px 8px;background:#f1f5f9;border-radius:4px;font-size:11px;color:#334155;font-weight:500;">Python &amp; Pandas</span>
            <span style="padding:2px 8px;background:#f1f5f9;border-radius:4px;font-size:11px;color:#334155;font-weight:500;">Scikit-Learn / PyTorch</span>
            <span style="padding:2px 8px;background:#f1f5f9;border-radius:4px;font-size:11px;color:#334155;font-weight:500;">LaTeX / Academic Writing</span>
          </div>
        </div>
      </div>

      <div style="display:flex;align-items:center;justify-content:space-between;border-top:1px solid #f1f5f9;padding-top:14px;">
        <span style="font-size:11px;color:#64748b;">Batas: 18 Okt 2025</span>
        <button class="btn btn-primary" onclick="selectProgramAndRegister('IDSS — Riset Decision Support & AI', 'riset')">
          <i data-lucide="send"></i> Ajukan Pendaftaran &rarr;
        </button>
      </div>
    </div>

    <!-- Program 3: Matic (Asistensi Pengajar) -->
    <div class="card katalog-card" data-skema="asistensi" style="display:flex;flex-direction:column;justify-content:space-between;border:1px solid #e2e8f0;padding:20px;">
      <div>
        <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:10px;margin-bottom:12px;">
          <div style="display:flex;align-items:center;gap:12px;">
            <div style="width:44px;height:44px;border-radius:10px;background:#fff7ed;color:#ea580c;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:16px;border:1px solid #fed7aa;">
              MA
            </div>
            <div>
              <span class="badge" style="font-size:10px;background:#ffedd5;color:#c2410c;border:1px solid #fdba74;">Skema: Asistensi Pengajar</span>
              <h3 style="font-size:16px;font-weight:700;color:#0f172a;margin-top:2px;">Matic &mdash; Asistensi Mentoring &amp; Desain</h3>
              <div style="font-size:12px;color:#64748b;">Mitra: Komunitas Laboratorium Multimedia Matic</div>
            </div>
          </div>
          <span class="badge badge-success">20 SKS</span>
        </div>

        <div style="display:flex;flex-direction:column;gap:6px;font-size:12px;margin-bottom:14px;background:#f8fafc;padding:10px 12px;border-radius:8px;border:1px solid #e2e8f0;">
          <div style="display:flex;justify-content:space-between;">
            <span style="color:#64748b;">Kuota Pendaftar:</span>
            <span style="font-weight:700;color:#16a34a;">Sisa 5 dari 12 Kursi</span>
          </div>
          <div style="display:flex;justify-content:space-between;">
            <span style="color:#64748b;">Durasi Kegiatan:</span>
            <span style="font-weight:600;color:#0f172a;">1 Semester (6 Bulan)</span>
          </div>
          <div style="display:flex;justify-content:space-between;">
            <span style="color:#64748b;">Dosen Pembina Mitra:</span>
            <span style="font-weight:600;color:var(--primary);">Affan Bachri, M.Cs &amp; Koordinator Lab Matic</span>
          </div>
        </div>

        <div style="margin-bottom:14px;font-size:12px;">
          <strong style="color:#1e293b;display:block;margin-bottom:4px;">Checklist Hak &amp; Kewajiban:</strong>
          <ul style="list-style:none;padding:0;display:flex;flex-direction:column;gap:4px;color:#475569;">
            <li style="display:flex;align-items:center;gap:6px;">
              <i data-lucide="check" style="width:13px;height:13px;color:#16a34a;"></i>
              <strong>Hak:</strong> Sertifikat mentor kompetensi, jejaring mahasiswa tingkat awal, &amp; fasilitas lab.
            </li>
            <li style="display:flex;align-items:center;gap:6px;">
              <i data-lucide="alert-circle" style="width:13px;height:13px;color:#d97706;"></i>
              <strong>Kewajiban:</strong> Pendampingan praktikum 4 kelas per minggu &amp; penyusunan modul ajar praktis.
            </li>
          </ul>
        </div>

        <div style="margin-bottom:16px;">
          <span style="font-size:11px;font-weight:600;color:#64748b;text-transform:uppercase;">Tag Keahlian:</span>
          <div style="display:flex;flex-wrap:wrap;gap:6px;margin-top:4px;">
            <span style="padding:2px 8px;background:#f1f5f9;border-radius:4px;font-size:11px;color:#334155;font-weight:500;">UI/UX (Figma)</span>
            <span style="padding:2px 8px;background:#f1f5f9;border-radius:4px;font-size:11px;color:#334155;font-weight:500;">HTML/CSS/JS Dasar</span>
            <span style="padding:2px 8px;background:#f1f5f9;border-radius:4px;font-size:11px;color:#334155;font-weight:500;">Public Speaking &amp; Mentoring</span>
          </div>
        </div>
      </div>

      <div style="display:flex;align-items:center;justify-content:space-between;border-top:1px solid #f1f5f9;padding-top:14px;">
        <span style="font-size:11px;color:#64748b;">Batas: 18 Okt 2025</span>
        <button class="btn btn-primary" onclick="selectProgramAndRegister('Matic — Asistensi Mentoring & Desain', 'asistensi')">
          <i data-lucide="send"></i> Ajukan Pendaftaran &rarr;
        </button>
      </div>
    </div>

    <!-- Program 4: Ryuje (Proyek Industri) -->
    <div class="card katalog-card" data-skema="proyek" style="display:flex;flex-direction:column;justify-content:space-between;border:1px solid #e2e8f0;padding:20px;">
      <div>
        <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:10px;margin-bottom:12px;">
          <div style="display:flex;align-items:center;gap:12px;">
            <div style="width:44px;height:44px;border-radius:10px;background:#f0fdf4;color:#16a34a;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:16px;border:1px solid #bbf7d0;">
              RY
            </div>
            <div>
              <span class="badge badge-primary" style="font-size:10px;">Skema: Proyek Industri</span>
              <h3 style="font-size:16px;font-weight:700;color:#0f172a;margin-top:2px;">Ryuje &mdash; Cloud &amp; DevOps Engineering</h3>
              <div style="font-size:12px;color:#64748b;">Mitra: PT Ryuje Solusi Digital (Industri)</div>
            </div>
          </div>
          <span class="badge badge-success">20 SKS</span>
        </div>

        <div style="display:flex;flex-direction:column;gap:6px;font-size:12px;margin-bottom:14px;background:#f8fafc;padding:10px 12px;border-radius:8px;border:1px solid #e2e8f0;">
          <div style="display:flex;justify-content:space-between;">
            <span style="color:#64748b;">Kuota Pendaftar:</span>
            <span style="font-weight:700;color:#16a34a;">Sisa 3 dari 8 Kursi</span>
          </div>
          <div style="display:flex;justify-content:space-between;">
            <span style="color:#64748b;">Durasi Kegiatan:</span>
            <span style="font-weight:600;color:#0f172a;">2 Semester (12 Bulan Opsi Lanjutan)</span>
          </div>
          <div style="display:flex;justify-content:space-between;">
            <span style="color:#64748b;">Dosen Pembina Mitra:</span>
            <span style="font-weight:600;color:var(--primary);">Nurul Anisa Sri Winarsih, M.Cs &amp; Tech Lead Ryuje</span>
          </div>
        </div>

        <div style="margin-bottom:14px;font-size:12px;">
          <strong style="color:#1e293b;display:block;margin-bottom:4px;">Checklist Hak &amp; Kewajiban:</strong>
          <ul style="list-style:none;padding:0;display:flex;flex-direction:column;gap:4px;color:#475569;">
            <li style="display:flex;align-items:center;gap:6px;">
              <i data-lucide="check" style="width:13px;height:13px;color:#16a34a;"></i>
              <strong>Hak:</strong> Pengalaman cloud nyata, sertifikasi industri mitra, &amp; fleksibilitas hybrid.
            </li>
            <li style="display:flex;align-items:center;gap:6px;">
              <i data-lucide="alert-circle" style="width:13px;height:13px;color:#d97706;"></i>
              <strong>Kewajiban:</strong> Menjaga NDA kode sumber klien &amp; penyelesaian pipeline automasi CI/CD.
            </li>
          </ul>
        </div>

        <div style="margin-bottom:16px;">
          <span style="font-size:11px;font-weight:600;color:#64748b;text-transform:uppercase;">Tag Keahlian:</span>
          <div style="display:flex;flex-wrap:wrap;gap:6px;margin-top:4px;">
            <span style="padding:2px 8px;background:#f1f5f9;border-radius:4px;font-size:11px;color:#334155;font-weight:500;">Linux / Bash</span>
            <span style="padding:2px 8px;background:#f1f5f9;border-radius:4px;font-size:11px;color:#334155;font-weight:500;">Docker &amp; Kubernetes</span>
            <span style="padding:2px 8px;background:#f1f5f9;border-radius:4px;font-size:11px;color:#334155;font-weight:500;">GitHub Actions / CI-CD</span>
          </div>
        </div>
      </div>

      <div style="display:flex;align-items:center;justify-content:space-between;border-top:1px solid #f1f5f9;padding-top:14px;">
        <span style="font-size:11px;color:#64748b;">Batas: 18 Okt 2025</span>
        <button class="btn btn-primary" onclick="selectProgramAndRegister('Ryuje — Cloud & DevOps Engineering', 'proyek')">
          <i data-lucide="send"></i> Ajukan Pendaftaran &rarr;
        </button>
      </div>
    </div>

  </div>
</div>

</MahasiswaShell>
