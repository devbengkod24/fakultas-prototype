---
// src/pages/mahasiswa/katalog.astro
import MahasiswaShell from '../../layouts/MahasiswaShell.astro';
---

<MahasiswaShell
  title="Katalog Program MBKM Kontributor | Mahasiswa - FIK Udinus"
  activeNav="katalog"
  pageTitle="Katalog Program MBKM Kontributor Resmi"
  breadcrumb="Katalog Program"
>
  <div id="view-katalog" class="w-full space-y-6">
    <!-- Header -->
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div>
        <h2 class="text-[20px] leading-[28px] font-normal text-[#09090b]">Katalog Program MBKM</h2>
        <p class="text-[14px] leading-[20px] text-[#71717a]">Eksplorasi program MBKM kontributor resmi yang tersedia untuk semester ini.</p>
      </div>
    </div>

    <!-- Grid Kartu Program -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6" id="katalog-grid">
      <!-- Program 1: Bengkel Koding -->
      <div class="bg-white border border-[#e4e4e7] rounded-xl overflow-hidden shadow-2xs flex flex-col">
        <div class="p-5 flex-1 space-y-4">
          <div class="flex items-start justify-between">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-lg bg-blue-50 text-[#0655a7] flex items-center justify-center font-bold border border-blue-100">BK</div>
              <div>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-medium bg-blue-50 text-[#0655a7] border border-blue-100 mb-1">Skema: Proyek Industri</span>
                <h3 class="text-[15px] font-bold text-[#09090b]">Bengkel Koding — Proyek Web & Mobile</h3>
                <p class="text-[12px] text-[#71717a]">Kontributor: Laboratorium Bengkel Koding FIK</p>
              </div>
            </div>
            <span class="text-[11px] font-bold text-emerald-600 bg-emerald-50 px-2 py-1 rounded">20 SKS</span>
          </div>

          <div class="space-y-2 text-[12px] py-3 border-y border-gray-50">
            <div class="flex justify-between"><span class="text-[#71717a]">Kuota Pendaftar:</span> <span class="font-semibold text-emerald-600">Sisa 7 dari 20 Kursi</span></div>
            <div class="flex justify-between"><span class="text-[#71717a]">Durasi Kegiatan:</span> <span class="font-medium text-[#09090b]">1 Semester (6 Bulan)</span></div>
            <div class="flex justify-between"><span class="text-[#71717a]">Dosen Pembina Kontributor:</span> <span class="font-medium text-[#1063B9]">Dr. Ricardus Anggi, M.Kom</span></div>
          </div>

          <div class="space-y-2">
            <h4 class="text-[11px] font-bold text-[#09090b] uppercase tracking-wider">Checklist Hak & Kewajiban:</h4>
            <ul class="text-[11px] space-y-1">
              <li class="flex items-start gap-2"><i data-lucide="check" class="w-3.5 h-3.5 text-emerald-500 mt-0.5"></i> <span class="text-[#71717a]"><strong class="text-[#09090b]">Hak:</strong> Konversi penuh 20 SKS, sertifikat, & workstation lab.</span></li>
              <li class="flex items-start gap-2"><i data-lucide="info" class="w-3.5 h-3.5 text-amber-500 mt-0.5"></i> <span class="text-[#71717a]"><strong class="text-[#09090b]">Kewajiban:</strong> Presensi 80%, logbook mingguan, & demo sprint.</span></li>
            </ul>
          </div>

          <div class="pt-2">
            <h4 class="text-[11px] font-bold text-[#09090b] uppercase tracking-wider mb-2">Tag Keahlian:</h4>
            <div class="flex flex-wrap gap-1.5">
              <span class="px-2 py-1 bg-gray-100 text-[#71717a] text-[10px] rounded-md">React / Next.js</span>
              <span class="px-2 py-1 bg-gray-100 text-[#71717a] text-[10px] rounded-md">Node.js / Express</span>
              <span class="px-2 py-1 bg-gray-100 text-[#71717a] text-[10px] rounded-md">PostgreSQL</span>
            </div>
          </div>
        </div>
        <div class="px-5 py-3 bg-gray-50 border-t border-[#e4e4e7] flex items-center justify-between">
          <span class="text-[11px] text-[#71717a]">Batas: 18 Okt 2025</span>
          <button type="button" onclick="openPendaftaranForm('Bengkel Koding — Proyek Web & Mobile')" class="inline-flex items-center gap-2 px-4 py-2 bg-[#1063B9] hover:bg-[#0E4F96] text-white text-xs font-semibold rounded-lg shadow-2xs transition-all active:scale-[0.95]">
            <i data-lucide="send" class="w-4 h-4"></i>
            <span>Detail Pendaftaran</span>
          </button>
        </div>
      </div>

      <!-- Program 2: IDSS -->
      <div class="bg-white border border-[#e4e4e7] rounded-xl overflow-hidden shadow-2xs flex flex-col">
        <div class="p-5 flex-1 space-y-4">
          <div class="flex items-start justify-between">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-lg bg-purple-50 text-purple-700 flex items-center justify-center font-bold border border-purple-100">ID</div>
              <div>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-medium bg-purple-50 text-purple-700 border border-purple-100 mb-1">Skema: Publikasi / Riset</span>
                <h3 class="text-[15px] font-bold text-[#09090b]">IDSS — Riset Decision Support & AI</h3>
                <p class="text-[12px] text-[#71717a]">Kontributor: Lab Intelligent Decision Support System</p>
              </div>
            </div>
            <span class="text-[11px] font-bold text-emerald-600 bg-emerald-50 px-2 py-1 rounded">20 SKS</span>
          </div>

          <div class="space-y-2 text-[12px] py-3 border-y border-gray-50">
            <div class="flex justify-between"><span class="text-[#71717a]">Kuota Pendaftar:</span> <span class="font-semibold text-emerald-600">Sisa 4 dari 10 Kursi</span></div>
            <div class="flex justify-between"><span class="text-[#71717a]">Durasi Kegiatan:</span> <span class="font-medium text-[#09090b]">1 Semester (6 Bulan)</span></div>
            <div class="flex justify-between"><span class="text-[#71717a]">Dosen Pembina Kontributor:</span> <span class="font-medium text-[#1063B9]">Prof. Dr. Supriadi, M.Kom</span></div>
          </div>

          <div class="space-y-2">
            <h4 class="text-[11px] font-bold text-[#09090b] uppercase tracking-wider">Checklist Hak & Kewajiban:</h4>
            <ul class="text-[11px] space-y-1">
              <li class="flex items-start gap-2"><i data-lucide="check" class="w-3.5 h-3.5 text-emerald-500 mt-0.5"></i> <span class="text-[#71717a]"><strong class="text-[#09090b]">Hak:</strong> Insentif publikasi, GPU cluster access, & bimbingan naskah.</span></li>
              <li class="flex items-start gap-2"><i data-lucide="info" class="w-3.5 h-3.5 text-amber-500 mt-0.5"></i> <span class="text-[#71717a]"><strong class="text-[#09090b]">Kewajiban:</strong> Target wajib 1 naskah submit prosiding/jurnal (LoA).</span></li>
            </ul>
          </div>

          <div class="pt-2">
            <h4 class="text-[11px] font-bold text-[#09090b] uppercase tracking-wider mb-2">Tag Keahlian:</h4>
            <div class="flex flex-wrap gap-1.5">
              <span class="px-2 py-1 bg-gray-100 text-[#71717a] text-[10px] rounded-md">Python & Pandas</span>
              <span class="px-2 py-1 bg-gray-100 text-[#71717a] text-[10px] rounded-md">Scikit-Learn / PyTorch</span>
              <span class="px-2 py-1 bg-gray-100 text-[#71717a] text-[10px] rounded-md">LaTeX</span>
            </div>
          </div>
        </div>
        <div class="px-5 py-3 bg-gray-50 border-t border-[#e4e4e7] flex items-center justify-between">
          <span class="text-[11px] text-[#71717a]">Batas: 18 Okt 2025</span>
          <button type="button" onclick="openPendaftaranForm('IDSS — Riset Decision Support & AI')" class="inline-flex items-center gap-2 px-4 py-2 bg-[#1063B9] hover:bg-[#0E4F96] text-white text-xs font-semibold rounded-lg shadow-2xs transition-all active:scale-[0.95]">
            <i data-lucide="send" class="w-4 h-4"></i>
            <span>Detail Pendaftaran</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Modal Form Pendaftaran (dengan 4 status cards) -->
    <div id="modal-pendaftaran" class="hidden fixed inset-0 bg-black/60 z-50 flex items-center justify-center p-4 backdrop-blur-sm">
      <div class="bg-white rounded-2xl w-full max-w-5xl max-h-[95vh] overflow-hidden flex flex-col shadow-2xl">
        <!-- Header -->
        <div class="bg-white border-b border-[#e4e4e7] p-5 flex items-center justify-between">
          <div>
            <h3 class="text-[18px] font-bold text-[#09090b]">Formulir Pendaftaran MBKM</h3>
            <p class="text-[12px] text-[#71717a]" id="modal-program">Program: Bengkel Koding</p>
          </div>
          <button type="button" onclick="closePendaftaranForm()" class="w-8 h-8 flex items-center justify-center rounded-lg hover:bg-gray-100 transition-colors">
            <i data-lucide="x" class="w-5 h-5 text-[#71717a]"></i>
          </button>
        </div>

        <!-- Body -->
        <div class="flex-1 overflow-y-auto p-6 space-y-6 bg-[#fbfbfc]">
          <!-- Status Pendaftaran (4 Cards) -->
          <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
            <div class="p-4 bg-emerald-50 border border-emerald-200 rounded-xl flex flex-col items-center text-center gap-2">
              <div class="w-8 h-8 rounded-full bg-emerald-500 text-white flex items-center justify-center font-bold text-xs">
                <i data-lucide="check" class="w-4 h-4"></i>
              </div>
              <div>
                <div class="text-[12px] font-bold text-emerald-800">Submit</div>
                <div class="text-[10px] text-emerald-600">Selesai</div>
              </div>
            </div>
            <div class="p-4 bg-white border border-[#e4e4e7] rounded-xl flex flex-col items-center text-center gap-2 opacity-60">
              <div class="w-8 h-8 rounded-full bg-gray-200 text-gray-600 flex items-center justify-center font-bold text-xs">2</div>
              <div>
                <div class="text-[12px] font-bold text-[#09090b]">Close</div>
                <div class="text-[10px] text-[#71717a]">18 Okt 2025</div>
              </div>
            </div>
            <div class="p-4 bg-white border border-[#e4e4e7] rounded-xl flex flex-col items-center text-center gap-2 opacity-60">
              <div class="w-8 h-8 rounded-full bg-gray-200 text-gray-600 flex items-center justify-center font-bold text-xs">3</div>
              <div>
                <div class="text-[12px] font-bold text-[#09090b]">Review</div>
                <div class="text-[10px] text-[#71717a]">On Progress</div>
              </div>
            </div>
            <div class="p-4 bg-white border border-[#e4e4e7] rounded-xl flex flex-col items-center text-center gap-2 opacity-60">
              <div class="w-8 h-8 rounded-full bg-gray-200 text-gray-600 flex items-center justify-center font-bold text-xs">4</div>
              <div>
                <div class="text-[12px] font-bold text-[#09090b]">Pengumuman</div>
                <div class="text-[10px] text-[#71717a]">Belum Ada</div>
              </div>
            </div>
          </div>

          <!-- Form Tabs (sama seperti admin) -->
          <div class="bg-white border border-[#e4e4e7] rounded-xl overflow-hidden">
            <div class="flex items-center gap-1 p-1 bg-gray-50 border-b border-[#e4e4e7]">
              <button onclick="switchFormTab('akademik')" id="tab-akademik" class="px-4 py-2 text-[12px] font-semibold rounded-lg bg-white shadow-sm text-[#1063B9]">Syarat Akademik</button>
              <button onclick="switchFormTab('berkas')" id="tab-berkas" class="px-4 py-2 text-[12px] font-semibold rounded-lg text-[#71717a] hover:bg-gray-100">Berkas & Portofolio</button>
              <button onclick="switchFormTab('konversi')" id="tab-konversi" class="px-4 py-2 text-[12px] font-semibold rounded-lg text-[#71717a] hover:bg-gray-100">Ekuivalensi SKS</button>
            </div>

            <div class="p-6">
              <!-- Tab 1: Akademik (Read Only) -->
              <div id="tab-content-akademik" class="space-y-4">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div class="space-y-1.5">
                    <label class="text-[11px] font-bold text-[#09090b] uppercase">NIM</label>
                    <input type="text" value="A11.2022.14253" readonly class="w-full h-10 px-3 rounded-lg border border-[#e4e4e7] bg-gray-50 text-[13px] font-medium" />
                  </div>
                  <div class="space-y-1.5">
                    <label class="text-[11px] font-bold text-[#09090b] uppercase">Nama Lengkap</label>
                    <input type="text" value="Ahmad Rizky Pratama" readonly class="w-full h-10 px-3 rounded-lg border border-[#e4e4e7] bg-gray-50 text-[13px] font-medium" />
                  </div>
                  <div class="space-y-1.5">
                    <label class="text-[11px] font-bold text-[#09090b] uppercase">IPK Kumulatif</label>
                    <input type="text" value="3.72" readonly class="w-full h-10 px-3 rounded-lg border border-[#e4e4e7] bg-gray-50 text-[13px] font-medium text-emerald-700" />
                  </div>
                  <div class="space-y-1.5">
                    <label class="text-[11px] font-bold text-[#09090b] uppercase">SKS Lulus</label>
                    <input type="text" value="104 SKS" readonly class="w-full h-10 px-3 rounded-lg border border-[#e4e4e7] bg-gray-50 text-[13px] font-medium text-emerald-700" />
                  </div>
                </div>
              </div>

              <!-- Tab 2: Berkas (Editable - Portofolio & CV only) -->
              <div id="tab-content-berkas" class="hidden space-y-4">
                <div class="p-4 bg-blue-50 border border-blue-200 rounded-lg text-[12px] text-[#0369a1] mb-4">
                  <i data-lucide="info" class="w-4 h-4 inline-block mr-1"></i>
                  Anda hanya dapat mengedit tautan Portofolio dan CV sebelum periode pendaftaran ditutup.
                </div>
                <div class="space-y-4">
                  <div class="space-y-1.5">
                    <label class="text-[11px] font-bold text-[#09090b] uppercase">Tautan Portofolio Karya <span class="text-red-500">*</span></label>
                    <input type="url" value="https://drive.google.com/portofolio-rizky" class="w-full h-10 px-3 rounded-lg border border-[#e4e4e7] bg-white text-[13px] focus:ring-2 focus:ring-[#1063B9] outline-none" />
                  </div>
                  <div class="space-y-1.5">
                    <label class="text-[11px] font-bold text-[#09090b] uppercase">Tautan CV (Curriculum Vitae) <span class="text-red-500">*</span></label>
                    <input type="url" value="https://drive.google.com/cv-rizky" class="w-full h-10 px-3 rounded-lg border border-[#e4e4e7] bg-white text-[13px] focus:ring-2 focus:ring-[#1063B9] outline-none" />
                  </div>
                </div>
              </div>

              <!-- Tab 3: Konversi (Read Only) -->
              <div id="tab-content-konversi" class="hidden space-y-4">
                <table class="w-full text-left text-xs border border-[#e4e4e7] rounded-lg overflow-hidden">
                  <thead class="bg-gray-50">
                    <tr>
                      <th class="p-3">Kode Matkul</th>
                      <th class="p-3">Nama Mata Kuliah</th>
                      <th class="p-3 text-center">SKS</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-gray-100">
                    <tr><td class="p-3 font-mono">A11.54601</td><td class="p-3 font-medium">Proyek Perangkat Lunak</td><td class="p-3 text-center">4</td></tr>
                    <tr><td class="p-3 font-mono">A11.54602</td><td class="p-3 font-medium">Sistem Basis Data Lanjut</td><td class="p-3 text-center">4</td></tr>
                    <tr><td class="p-3 font-mono">A11.54605</td><td class="p-3 font-medium">Etika Profesi TI</td><td class="p-3 text-center">3</td></tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>

        <!-- Footer -->
        <div class="bg-white border-t border-[#e4e4e7] p-5 flex items-center justify-end gap-3">
          <button type="button" onclick="closePendaftaranForm()" class="px-5 py-2 border border-[#e4e4e7] text-[#09090b] text-xs font-bold rounded-xl hover:bg-gray-50 transition-colors">
            Batal
          </button>
          <button type="button" onclick="savePendaftaran()" class="px-6 py-2 bg-[#1063B9] hover:bg-[#0E4F96] text-white text-xs font-bold rounded-xl shadow-lg transition-all active:scale-[0.98]">
            Kirim Pendaftaran
          </button>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    function openPendaftaranForm(programName) {
      document.getElementById('modal-program').textContent = 'Program: ' + programName;
      document.getElementById('modal-pendaftaran').classList.remove('hidden');
      document.body.classList.add('overflow-hidden');
      switchFormTab('akademik');
      if (typeof lucide !== 'undefined') lucide.createIcons();
    }

    function closePendaftaranForm() {
      document.getElementById('modal-pendaftaran').classList.add('hidden');
      document.body.classList.remove('overflow-hidden');
    }

    function switchFormTab(tab) {
      const tabs = ['akademik', 'berkas', 'konversi'];
      tabs.forEach(t => {
        const btn = document.getElementById('tab-' + t);
        const content = document.getElementById('tab-content-' + t);
        if (t === tab) {
          btn.classList.add('bg-white', 'shadow-sm', 'text-[#1063B9]');
          btn.classList.remove('text-[#71717a]');
          content.classList.remove('hidden');
        } else {
          btn.classList.remove('bg-white', 'shadow-sm', 'text-[#1063B9]');
          btn.classList.add('text-[#71717a]');
          content.classList.add('hidden');
        }
      });
    }

    function savePendaftaran() {
      alert('Pendaftaran berhasil dikirim! Apabila Anda diterima pada salah satu program, pendaftaran lainnya akan ditolak secara otomatis.');
      closePendaftaranForm();
    }
  </script>
</MahasiswaShell>
