---
// src/pages/mahasiswa/pendaftaran-detail.astro
import MahasiswaShell from '../../layouts/MahasiswaShell.astro';
---

<MahasiswaShell
  title="Detail Pendaftaran MBKM | Mahasiswa - FIK Udinus"
  activeNav="pendaftaran"
  pageTitle="Detail Pendaftaran MBKM"
  breadcrumb="Detail Pendaftaran"
>
  <div class="w-full space-y-6">
    <!-- Header -->
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div>
        <h2 class="text-[20px] leading-[28px] font-normal text-[#09090b]">Formulir Pendaftaran MBKM</h2>
        <p class="text-[14px] leading-[20px] text-[#71717a]">Program: Bengkel Koding — Proyek Web & Mobile</p>
      </div>
      <a href="/mahasiswa/pendaftaran" class="inline-flex items-center gap-2 px-4 py-2 border border-[#e4e4e7] bg-white hover:bg-gray-50 text-[#09090b] text-xs font-semibold rounded-lg shadow-2xs transition-colors">
        <i data-lucide="arrow-left" class="w-4 h-4"></i>
        <span>Kembali</span>
      </a>
    </div>

    <!-- Stepper Progress Trail (Tahapan Pendaftaran MBKM) -->
    <div class="bg-white border border-[#e4e4e7] rounded-xl p-5 sm:p-6 shadow-2xs">
      <div class="flex items-center justify-between pb-4 mb-4 border-b border-[#f4f4f5]">
        <div class="flex items-center gap-2">
          <div class="w-2 h-2 rounded-full bg-emerald-500"></div>
          <span class="text-xs font-semibold text-[#09090b]">Tahapan Pendaftaran & Seleksi MBKM</span>
        </div>
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-blue-50 text-[#1063B9] border border-blue-200">
          <span class="w-1.5 h-1.5 rounded-full bg-[#1063B9] animate-pulse"></span>
          Tahap Saat Ini: Review Berkas
        </span>
      </div>

      <div class="relative py-2">
        <!-- Connector Background Line Between Circles -->
        <div class="absolute top-5 left-[12.5%] right-[12.5%] h-1 bg-gray-100 rounded-full -translate-y-1/2 z-0">
          <!-- Active Gradient Progress Fill Line (spans across completed steps) -->
          <div class="h-full bg-gradient-to-r from-emerald-500 via-emerald-500 to-[#1063B9] rounded-full transition-all duration-500" style="width: 66.6%;"></div>
        </div>

        <!-- 4 Step Circular Nodes Grid -->
        <div class="grid grid-cols-4 relative z-10">
          <!-- Step 1: Submit (Completed) -->
          <div class="flex flex-col items-center text-center group cursor-default">
            <div class="w-10 h-10 rounded-full bg-emerald-500 text-white flex items-center justify-center font-bold text-sm shadow-sm ring-4 ring-emerald-50 group-hover:scale-105 transition-transform">
              <i data-lucide="check" class="w-5 h-5 stroke-[2.5]"></i>
            </div>
            <div class="mt-3 space-y-0.5">
              <div class="text-[13px] font-bold text-emerald-800">Submit</div>
              <div class="text-[11px] font-medium text-emerald-600">10 Okt 2025</div>
              <span class="inline-block mt-1 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                Selesai
              </span>
            </div>
          </div>

          <!-- Step 2: Close (Completed / Closed) -->
          <div class="flex flex-col items-center text-center group cursor-default">
            <div class="w-10 h-10 rounded-full bg-emerald-500 text-white flex items-center justify-center font-bold text-sm shadow-sm ring-4 ring-emerald-50 group-hover:scale-105 transition-transform">
              <i data-lucide="check" class="w-5 h-5 stroke-[2.5]"></i>
            </div>
            <div class="mt-3 space-y-0.5">
              <div class="text-[13px] font-bold text-emerald-800">Close</div>
              <div class="text-[11px] font-medium text-[#71717a]">18 Okt 2025</div>
              <span class="inline-block mt-1 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                Ditutup
              </span>
            </div>
          </div>

          <!-- Step 3: Review (Active / On Progress) -->
          <div class="flex flex-col items-center text-center group cursor-default">
            <div class="w-10 h-10 rounded-full bg-[#1063B9] text-white flex items-center justify-center font-bold text-sm shadow-sm ring-4 ring-blue-100 group-hover:scale-105 transition-transform">
              <i data-lucide="clock" class="w-4 h-4"></i>
            </div>
            <div class="mt-3 space-y-0.5">
              <div class="text-[13px] font-bold text-[#1063B9]">Review</div>
              <div class="text-[11px] font-medium text-[#1063B9]">On Progress</div>
              <span class="inline-block mt-1 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-blue-50 text-[#1063B9] border border-blue-200">
                Sedang Ditinjau
              </span>
            </div>
          </div>

          <!-- Step 4: Pengumuman (Upcoming) -->
          <div class="flex flex-col items-center text-center group cursor-default opacity-60">
            <div class="w-10 h-10 rounded-full bg-white border-2 border-gray-300 text-gray-500 flex items-center justify-center font-bold text-sm ring-4 ring-white group-hover:scale-105 transition-transform">
              <span>4</span>
            </div>
            <div class="mt-3 space-y-0.5">
              <div class="text-[13px] font-bold text-[#09090b]">Pengumuman</div>
              <div class="text-[11px] text-[#71717a]">Belum Ada</div>
              <span class="inline-block mt-1 px-2 py-0.5 rounded-full text-[10px] font-medium bg-gray-100 text-gray-600 border border-gray-200">
                Menunggu
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Form Pendaftaran (Semua Jadi Satu Section) -->
    <div class="bg-white border border-[#e4e4e7] rounded-xl shadow-2xs overflow-hidden">
      <div class="p-6 space-y-8">
        
        <!-- Bagian 1: Syarat Akademik -->
        <section class="space-y-4">
          <div class="flex items-center gap-2 pb-2 border-b border-gray-100">
            <i data-lucide="graduation-cap" class="w-5 h-5 text-[#1063B9]"></i>
            <h3 class="text-[15px] font-bold text-[#09090b]">Syarat Akademik</h3>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="space-y-1.5">
              <label class="text-[11px] font-bold text-[#09090b] uppercase tracking-wider">Nomor Induk Mahasiswa (NIM)</label>
              <input type="text" value="A11.2022.14253" readonly class="w-full h-10 px-3 rounded-lg border border-[#e4e4e7] bg-gray-50 text-[13px] font-medium text-[#71717a]" />
            </div>
            <div class="space-y-1.5">
              <label class="text-[11px] font-bold text-[#09090b] uppercase tracking-wider">Nama Lengkap Mahasiswa</label>
              <input type="text" value="Ahmad Rizky Pratama" readonly class="w-full h-10 px-3 rounded-lg border border-[#e4e4e7] bg-gray-50 text-[13px] font-medium text-[#71717a]" />
            </div>
            <div class="space-y-1.5">
              <label class="text-[11px] font-bold text-[#09090b] uppercase tracking-wider">Indeks Prestasi Kumulatif (IPK)</label>
              <input type="text" value="3.72" readonly class="w-full h-10 px-3 rounded-lg border border-[#e4e4e7] bg-gray-50 text-[13px] font-medium text-emerald-700" />
            </div>
            <div class="space-y-1.5">
              <label class="text-[11px] font-bold text-[#09090b] uppercase tracking-wider">Total SKS Lulus</label>
              <input type="text" value="104 SKS" readonly class="w-full h-10 px-3 rounded-lg border border-[#e4e4e7] bg-gray-50 text-[13px] font-medium text-emerald-700" />
            </div>
          </div>
        </section>

        <!-- Bagian 2: Berkas & Portofolio (Editable) -->
        <section class="space-y-4">
          <div class="flex items-center gap-2 pb-2 border-b border-gray-100">
            <i data-lucide="folder-open" class="w-5 h-5 text-[#1063B9]"></i>
            <h3 class="text-[15px] font-bold text-[#09090b]">Berkas & Portofolio</h3>
          </div>
          <div class="p-4 bg-blue-50/50 border border-blue-100 rounded-lg text-[12px] text-[#0369a1] flex gap-3">
            <i data-lucide="info" class="w-4 h-4 shrink-0 mt-0.5"></i>
            <p>Anda hanya diperbolehkan mengedit tautan Portofolio dan Curriculum Vitae (CV) selama periode pendaftaran masih dibuka.</p>
          </div>
          <div class="grid grid-cols-1 gap-4">
            <div class="space-y-1.5">
              <label class="text-[11px] font-bold text-[#09090b] uppercase tracking-wider">Tautan Portofolio Karya <span class="text-red-500">*</span></label>
              <div class="relative">
                <i data-lucide="link" class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-[#71717a]"></i>
                <input type="url" value="https://drive.google.com/portofolio-rizky" class="w-full h-10 pl-10 pr-3 rounded-lg border border-[#e4e4e7] bg-white text-[13px] focus:ring-2 focus:ring-[#1063B9] focus:border-[#1063B9] outline-none transition-all" placeholder="https://..." />
              </div>
            </div>
            <div class="space-y-1.5">
              <label class="text-[11px] font-bold text-[#09090b] uppercase tracking-wider">Tautan Curriculum Vitae (CV) <span class="text-red-500">*</span></label>
              <div class="relative">
                <i data-lucide="file-text" class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-[#71717a]"></i>
                <input type="url" value="https://drive.google.com/cv-rizky" class="w-full h-10 pl-10 pr-3 rounded-lg border border-[#e4e4e7] bg-white text-[13px] focus:ring-2 focus:ring-[#1063B9] focus:border-[#1063B9] outline-none transition-all" placeholder="https://..." />
              </div>
            </div>
          </div>
        </section>

        <!-- Bagian 3: Ekuivalensi Mata Kuliah -->
        <section class="space-y-4">
          <div class="flex items-center gap-2 pb-2 border-b border-gray-100">
            <i data-lucide="book-open-check" class="w-5 h-5 text-[#1063B9]"></i>
            <h3 class="text-[15px] font-bold text-[#09090b]">Ekuivalensi Mata Kuliah</h3>
          </div>
          <div class="overflow-hidden border border-[#e4e4e7] rounded-xl">
            <table class="w-full text-left text-xs">
              <thead class="bg-gray-50 border-b border-[#e4e4e7]">
                <tr>
                  <th class="p-3 font-bold text-[#09090b] uppercase tracking-wider">Kode Matkul</th>
                  <th class="p-3 font-bold text-[#09090b] uppercase tracking-wider">Nama Mata Kuliah</th>
                  <th class="p-3 text-center font-bold text-[#09090b] uppercase tracking-wider">SKS</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100 text-[13px]">
                <tr>
                  <td class="p-3 font-mono text-[#71717a]">A11.54601</td>
                  <td class="p-3 font-medium text-[#09090b]">Proyek Perangkat Lunak</td>
                  <td class="p-3 text-center text-[#09090b]">4</td>
                </tr>
                <tr>
                  <td class="p-3 font-mono text-[#71717a]">A11.54602</td>
                  <td class="p-3 font-medium text-[#09090b]">Sistem Basis Data Lanjut</td>
                  <td class="p-3 text-center text-[#09090b]">4</td>
                </tr>
                <tr>
                  <td class="p-3 font-mono text-[#71717a]">A11.54605</td>
                  <td class="p-3 font-medium text-[#09090b]">Etika Profesi TI</td>
                  <td class="p-3 text-center text-[#09090b]">3</td>
                </tr>
              </tbody>
              <tfoot class="bg-gray-50 font-bold border-t border-[#e4e4e7]">
                <tr>
                  <td colspan="2" class="p-3 text-right text-[#09090b]">Total SKS Konversi</td>
                  <td class="p-3 text-center text-[#1063B9]">11 SKS</td>
                </tr>
              </tfoot>
            </table>
          </div>
        </section>

      </div>

      <!-- Action Footer -->
      <div class="p-6 bg-gray-50 border-t border-[#e4e4e7] flex flex-wrap items-center justify-between gap-4">
        <p class="text-[12px] text-[#71717a]">Pastikan seluruh data yang Anda masukkan sudah benar sebelum menyimpan perubahan.</p>
        <div class="flex items-center gap-3">
          <button type="button" onclick="window.history.back()" class="px-5 py-2.5 border border-[#e4e4e7] bg-white hover:bg-gray-100 text-[#09090b] text-[13px] font-bold rounded-xl transition-all active:scale-[0.98]">
            Batal
          </button>
          <button type="button" onclick="alert('Perubahan Berhasil Disimpan!')" class="px-6 py-2.5 bg-[#1063B9] hover:bg-[#0E4F96] text-white text-[13px] font-bold rounded-xl shadow-lg shadow-blue-100 transition-all active:scale-[0.98]">
            Simpan Perubahan
          </button>
        </div>
      </div>
    </div>
  </div>
</MahasiswaShell>
