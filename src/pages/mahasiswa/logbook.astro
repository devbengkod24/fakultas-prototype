---
import MahasiswaShell from '../../layouts/MahasiswaShell.astro';
---

<MahasiswaShell
  title="Logbook Kegiatan Mingguan | Kampus Berdampak - FIK Udinus"
  pageTitle="Logbook Kegiatan Mingguan"
  subtitle="Jurnal mingguan, unggah tautan bukti kerja GDrive, & catatan review DPL."
  breadcrumb="Logbook Kegiatan"
  activeNav="logbook"
>
<!-- Logbook Kegiatan Mingguan (Sama Persis Pola KP: Jurnal Mingguan + Review DPL) -->
<div style="margin-bottom:24px;">

  <!-- Header Bar dengan Tombol Isi Logbook Mingguan -->
  <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-bottom:20px;">
    <div>
      <h2 style="font-size:18px;font-weight:700;color:#1e293b;display:flex;align-items:center;gap:8px;">
        <i data-lucide="book-open" style="color:var(--primary);width:20px;height:20px;"></i>
        Logbook Kegiatan Mingguan MBKM
      </h2>
      <p style="font-size:13px;color:#64748b;margin-top:2px;">
        Rekap jurnal kegiatan 1–16 minggu di industri/lab, bukti kerja GDrive, dan status verifikasi DPL per entri.
      </p>
    </div>
    <div style="display:flex;align-items:center;gap:8px;">
      <span class="badge badge-primary"><i data-lucide="calendar" style="width:12px;height:12px;"></i> Minggu ke-2 berjalan</span>
      <button class="btn btn-primary" onclick="document.getElementById('modal-logbook-mbkm').style.display='flex'">
        <i data-lucide="plus"></i> Isi Logbook Mingguan
      </button>
    </div>
  </div>

  <!-- Statistik Ringkasan Logbook -->
  <div class="grid grid-4" style="gap:12px;margin-bottom:22px;">
    <div style="padding:14px;background:#fff;border:1px solid #e2e8f0;border-left:4px solid var(--primary);border-radius:10px;">
      <div style="font-size:11px;color:#64748b;text-transform:uppercase;font-weight:600;">Total Minggu</div>
      <div style="font-size:22px;font-weight:700;color:#0f172a;margin-top:2px;">16</div>
      <div style="font-size:11px;color:#64748b;margin-top:2px;">Target Kegiatan</div>
    </div>
    <div style="padding:14px;background:#fff;border:1px solid #e2e8f0;border-left:4px solid #16a34a;border-radius:10px;">
      <div style="font-size:11px;color:#64748b;text-transform:uppercase;font-weight:600;">Disetujui DPL</div>
      <div style="font-size:22px;font-weight:700;color:#16a34a;margin-top:2px;">1</div>
      <div style="font-size:11px;color:#16a34a;margin-top:2px;">Terverifikasi</div>
    </div>
    <div style="padding:14px;background:#fff;border:1px solid #e2e8f0;border-left:4px solid #d97706;border-radius:10px;">
      <div style="font-size:11px;color:#64748b;text-transform:uppercase;font-weight:600;">Menunggu Review</div>
      <div style="font-size:22px;font-weight:700;color:#d97706;margin-top:2px;">1</div>
      <div style="font-size:11px;color:#d97706;margin-top:2px;">Pending Verifikasi</div>
    </div>
    <div style="padding:14px;background:#fff;border:1px solid #e2e8f0;border-left:4px solid #94a3b8;border-radius:10px;">
      <div style="font-size:11px;color:#64748b;text-transform:uppercase;font-weight:600;">Belum Diisi</div>
      <div style="font-size:22px;font-weight:700;color:#94a3b8;margin-top:2px;">14</div>
      <div style="font-size:11px;color:#94a3b8;margin-top:2px;">Wajib Dilengkapi</div>
    </div>
  </div>

  <!-- Progress Bar Pengisian Logbook -->
  <div class="card" style="padding:16px;margin-bottom:22px;">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;">
      <span style="font-size:13px;font-weight:600;color:#1e293b;display:flex;align-items:center;gap:6px;">
        <i data-lucide="trending-up" style="width:15px;height:15px;color:var(--primary);"></i>
        Progres Pengisian Logbook
      </span>
      <span style="font-size:13px;font-weight:700;color:var(--primary);">2 / 16 Minggu (12.5%)</span>
    </div>
    <div style="background:#e2e8f0;border-radius:99px;height:10px;overflow:hidden;">
      <div style="width:12.5%;background:linear-gradient(90deg,var(--primary),#1e7fd9);height:100%;border-radius:99px;transition:width 0.3s;"></div>
    </div>
    <div style="font-size:11px;color:#64748b;margin-top:6px;">Minimal 80% kehadiran efektif (≥13 minggu terisi dan disetujui) untuk lolos persyaratan sidang akhir.</div>
  </div>

  <!-- Tabel Rekap Logbook Mingguan dengan Status Verifikasi DPL -->
  <div class="card" style="padding:22px;">
    <div class="card-header" style="margin-bottom:16px;">
      <span class="card-title" style="font-size:15px;display:flex;align-items:center;gap:8px;">
        <i data-lucide="table" style="color:var(--primary);width:18px;height:18px;"></i>
        Tabel Rekap Jurnal Kegiatan Mingguan
      </span>
      <span class="badge badge-primary">Genap 2025/2026</span>
    </div>

    <div style="border:1px solid #e2e8f0;border-radius:8px;overflow-x:auto;">
      <table style="width:100%;border-collapse:collapse;font-size:13px;text-align:left;">
        <thead>
          <tr style="background:#f8fafc;border-bottom:1px solid #e2e8f0;color:#475569;">
            <th style="padding:10px 14px;width:80px;">Minggu ke-</th>
            <th style="padding:10px 14px;">Rentang Tanggal</th>
            <th style="padding:10px 14px;">Ringkasan Aktivitas</th>
            <th style="padding:10px 14px;">Bukti GDrive</th>
            <th style="padding:10px 14px;text-align:center;">Status Verifikasi DPL</th>
            <th style="padding:10px 14px;text-align:center;">Aksi</th>
          </tr>
        </thead>
        <tbody>

          <!-- Minggu 1 — Disetujui -->
          <tr style="border-bottom:1px solid #f1f5f9;">
            <td style="padding:10px 14px;text-align:center;">
              <span style="width:36px;height:36px;border-radius:50%;background:#dcfce7;color:#16a34a;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:12px;margin:0 auto;">1</span>
            </td>
            <td style="padding:10px 14px;color:#475569;font-size:12px;">06 — 10 Okt 2025</td>
            <td style="padding:10px 14px;">
              <div style="font-weight:600;color:#0f172a;margin-bottom:2px;">Kick-off &amp; Setup Repositori Proyek</div>
              <div style="font-size:11.5px;color:#64748b;">Inisialisasi repo GitHub, konfigurasi CI/CD, dan riset kebutuhan sistem modul Dashboard.</div>
            </td>
            <td style="padding:10px 14px;">
              <a href="https://drive.google.com/drive/folders/1xxx" target="_blank" style="color:var(--primary);text-decoration:none;font-size:12px;display:flex;align-items:center;gap:4px;">
                <i data-lucide="external-link" style="width:12px;height:12px;"></i> Buka Folder
              </a>
            </td>
            <td style="padding:10px 14px;text-align:center;">
              <span class="badge badge-success"><i data-lucide="check-circle" style="width:11px;height:11px;"></i> Disetujui DPL</span>
            </td>
            <td style="padding:10px 14px;text-align:center;">
              <button class="btn btn-sm btn-outline" onclick="showLogbookDetail(1)" style="font-size:11px;">
                <i data-lucide="eye" style="width:12px;height:12px;"></i> Detail
              </button>
            </td>
          </tr>

          <!-- Minggu 2 — Menunggu Verifikasi -->
          <tr style="border-bottom:1px solid #f1f5f9;background:#fffbeb;">
            <td style="padding:10px 14px;text-align:center;">
              <span style="width:36px;height:36px;border-radius:50%;background:#fef3c7;color:#d97706;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:12px;margin:0 auto;">2</span>
            </td>
            <td style="padding:10px 14px;color:#475569;font-size:12px;">13 — 17 Okt 2025</td>
            <td style="padding:10px 14px;">
              <div style="font-weight:600;color:#0f172a;margin-bottom:2px;">Pengembangan Fitur Autentikasi &amp; RBAC</div>
              <div style="font-size:11.5px;color:#64748b;">Implementasi JWT Auth, Role-Based Access Control, dan unit testing endpoint API.</div>
            </td>
            <td style="padding:10px 14px;">
              <a href="https://drive.google.com/drive/folders/1yyy" target="_blank" style="color:var(--primary);text-decoration:none;font-size:12px;display:flex;align-items:center;gap:4px;">
                <i data-lucide="external-link" style="width:12px;height:12px;"></i> Buka Folder
              </a>
            </td>
            <td style="padding:10px 14px;text-align:center;">
              <span class="badge badge-warning"><i data-lucide="clock" style="width:11px;height:11px;"></i> Menunggu Review</span>
            </td>
            <td style="padding:10px 14px;text-align:center;">
              <button class="btn btn-sm btn-outline" onclick="showLogbookDetail(2)" style="font-size:11px;">
                <i data-lucide="eye" style="width:12px;height:12px;"></i> Detail
              </button>
            </td>
          </tr>

          <!-- Minggu 3–16 — Belum Diisi -->
          <tr style="background:#f8fafc;">
            <td style="padding:10px 14px;text-align:center;" colspan="6">
              <div style="display:flex;align-items:center;justify-content:center;gap:8px;color:#94a3b8;font-size:12.5px;padding:8px 0;">
                <i data-lucide="lock" style="width:14px;height:14px;"></i>
                Minggu 3–16 belum dapat diisi (mengikuti jadwal pelaksanaan kegiatan MBKM di lapangan).
                <button class="btn btn-sm btn-outline" onclick="document.getElementById('modal-logbook-mbkm').style.display='flex'" style="font-size:11px;">+ Isi Logbook Berikutnya</button>
              </div>
            </td>
          </tr>

        </tbody>
      </table>
    </div>
  </div>

</div>

<!-- ═══ MODAL: Isi Logbook Mingguan ═══ -->
<div id="modal-logbook-mbkm" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.45);z-index:1000;align-items:center;justify-content:center;padding:24px;">
  <div style="background:#fff;border-radius:14px;width:100%;max-width:700px;max-height:90vh;overflow-y:auto;padding:28px;box-shadow:0 20px 50px rgba(0,0,0,0.2);">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;">
      <div>
        <h3 style="font-size:18px;font-weight:700;color:#0f172a;display:flex;align-items:center;gap:8px;">
          <i data-lucide="book-plus" style="color:var(--primary);"></i> Isi Logbook Mingguan
        </h3>
        <p style="font-size:12px;color:#64748b;margin-top:2px;">Entri akan diteruskan ke DPL untuk verifikasi dalam 1×24 jam.</p>
      </div>
      <button onclick="document.getElementById('modal-logbook-mbkm').style.display='none'" style="border:none;background:none;cursor:pointer;color:#94a3b8;padding:4px;">
        <i data-lucide="x" style="width:22px;height:22px;"></i>
      </button>
    </div>

    <form onsubmit="submitLogbookMBKM(event)">
      <div class="grid grid-2" style="gap:14px;margin-bottom:14px;">
        <div class="form-group">
          <label class="form-label">Pilihan Minggu ke- <span style="color:#dc2626;">*</span></label>
          <select class="form-control" id="logbook-minggu-ke" required>
            <option value="3">Minggu ke-3 (20 — 24 Okt 2025)</option>
            <option value="4">Minggu ke-4 (27 — 31 Okt 2025)</option>
            <option value="5">Minggu ke-5 (03 — 07 Nov 2025)</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Rentang Tanggal Pelaksanaan <span style="color:#dc2626;">*</span></label>
          <input type="text" class="form-control" id="logbook-tanggal" value="20 Oktober 2025 — 24 Oktober 2025" required />
        </div>
      </div>

      <div class="form-group">
        <label class="form-label">Rincian Aktivitas / Pekerjaan yang Diselesaikan <span style="color:#dc2626;">*</span></label>
        <textarea class="form-control" id="logbook-aktivitas" rows="4" placeholder="Deskripsikan secara spesifik pekerjaan, fitur, atau modul yang dikerjakan minggu ini..." required style="resize:vertical;"></textarea>
      </div>

      <div class="grid grid-2" style="gap:14px;margin-bottom:14px;">
        <div class="form-group">
          <label class="form-label">Kendala yang Dihadapi</label>
          <textarea class="form-control" id="logbook-kendala" rows="3" placeholder="Tuliskan hambatan teknis, non-teknis, atau ketidaksesuaian jadwal..." style="resize:vertical;"></textarea>
        </div>
        <div class="form-group">
          <label class="form-label">Solusi / Tindak Lanjut</label>
          <textarea class="form-control" id="logbook-solusi" rows="3" placeholder="Bagaimana kendala tersebut diatasi atau rencana penyelesaian ke depan..." style="resize:vertical;"></textarea>
        </div>
      </div>

      <div class="form-group">
        <label class="form-label">Tautan Bukti Kerja / Dokumentasi Google Drive <span style="color:#dc2626;">*</span></label>
        <div style="position:relative;">
          <i data-lucide="folder" style="position:absolute;left:12px;top:50%;transform:translateY(-50%);width:15px;height:15px;color:#64748b;"></i>
          <input type="url" class="form-control" id="logbook-bukti-gdrive" placeholder="https://drive.google.com/drive/folders/..." required style="padding-left:36px;" />
        </div>
        <small style="font-size:11px;color:#64748b;margin-top:4px;display:block;">Wajib berisi screenshot hasil kerja, commit log, atau dokumentasi aktivitas. Akses: View-Only.</small>
      </div>

      <div style="display:flex;justify-content:flex-end;gap:10px;margin-top:20px;">
        <button type="button" onclick="document.getElementById('modal-logbook-mbkm').style.display='none'" class="btn btn-outline">Batal</button>
        <button type="submit" class="btn btn-primary"><i data-lucide="send"></i> Kirim Logbook ke DPL</button>
      </div>
    </form>
  </div>
</div>

</MahasiswaShell>
