---
// src/pages/mahasiswa/logbook.astro
import MahasiswaShell from '../../layouts/MahasiswaShell.astro';

// Mock data riwayat logbook mingguan
const logbookList = [
  {
    id: 1,
    minggu: 1,
    periodeHari: 'Senin - Jumat, 7 - 11 Sep 2026',
    kegiatan: 'Onboarding lingkungan kerja di PT Telkom Indonesia, pengenalan struktur tim pengembang, serta analisis kebutuhan awal sistem dashboard monitoring.',
    hasilTeks: 'Tersusun dokumen spesifikasi kebutuhan fungsional (SRS) versi awal dan setup repository proyek bersama tim.',
    hasilFoto: 'https://placehold.co/600x360/eff6ff/1063B9?text=Dokumentasi+Minggu+1'
  },
  {
    id: 2,
    minggu: 2,
    periodeHari: 'Senin - Jumat, 14 - 18 Sep 2026',
    kegiatan: 'Perancangan wireframe antarmuka pengguna (UI/UX) dan pemodelan skema basis data untuk modul pelaporan peserta magang.',
    hasilTeks: 'Desain mockup halaman utama di Figma selesai disetujui penyelia lapangan dan ERD basis data telah difinalisasi.',
    hasilFoto: 'https://placehold.co/600x360/eff6ff/1063B9?text=Wireframe+Minggu+2'
  },
  {
    id: 3,
    minggu: 3,
    periodeHari: 'Senin - Jumat, 21 - 25 Sep 2026',
    kegiatan: 'Implementasi REST API autentikasi pengguna, manajemen peran, serta integrasi endpoint data kegiatan mingguan.',
    hasilTeks: 'Seluruh endpoint CRUD dasar berjalan sesuai kontrak API dan telah lulus pengujian unit menggunakan Postman.',
    hasilFoto: ''
  },
  {
    id: 4,
    minggu: 4,
    periodeHari: 'Senin - Jumat, 28 Sep - 2 Okt 2026',
    kegiatan: 'Pengembangan komponen antarmuka front-end dashboard monitoring, integrasi grafik progres, dan koneksi ke API back-end.',
    hasilTeks: 'Halaman dashboard interaktif dan tabel monitoring dapat menampilkan data secara dinamis dengan responsivitas mobile.',
    hasilFoto: 'https://placehold.co/600x360/eff6ff/1063B9?text=Implementasi+UI+Minggu+4'
  },
  {
    id: 5,
    minggu: 5,
    periodeHari: 'Senin - Jumat, 5 - 9 Okt 2026',
    kegiatan: 'Pengujian fungsional menyeluruh (UAT), perbaikan bug tampilan pada perangkat layar kecil, serta penyusunan dokumentasi teknis aplikasi.',
    hasilTeks: 'Aplikasi siap dipresentasikan pada evaluasi internal mitra dengan seluruh temuan bug mayor telah terselesaikan.',
    hasilFoto: 'https://placehold.co/600x360/eff6ff/1063B9?text=Pengujian+UAT+Minggu+5'
  }
];
---

<MahasiswaShell
  title="Logbook Kegiatan | Mahasiswa - FIK Udinus"
  activeNav="logbook"
  pageTitle="Daftar Logbook Kegiatan"
  breadcrumb="Logbook Kegiatan"
>
  <div class="space-y-6">
    <!-- Header Halaman -->
    <div>
      <h1 class="text-[22px] font-bold text-[#09090b] tracking-tight">Daftar Logbook Kegiatan</h1>
      <p class="text-[13px] text-[#71717a] mt-0.5">Berikut adalah daftar logbook kegiatan mingguan mahasiswa.</p>
    </div>

    <!-- State: Terkunci saat belum diterima -->
    <div
      x-show="$store.mahasiswaSim?.state === 'belum_daftar'"
      x-cloak
      class="rounded-xl border border-[#e4e4e7] bg-white p-8 sm:p-12 text-center space-y-4 shadow-none"
    >
      <div class="w-14 h-14 rounded-full bg-amber-50 border border-amber-200 text-amber-600 flex items-center justify-center mx-auto shadow-2xs">
        <i data-lucide="lock" class="w-7 h-7 text-amber-600"></i>
      </div>

      <div class="max-w-md mx-auto space-y-1.5">
        <h3 class="text-base font-semibold text-[#09090b]">
          Akses Logbook Kegiatan Belum Terbuka
        </h3>
        <p class="text-xs text-[#71717a] leading-relaxed">
          Menu Logbook Kegiatan hanya dapat diakses setelah pendaftaran Kampus Berdampak Anda dinyatakan diterima.
        </p>
      </div>

      <div class="pt-2">
        <a
          href="/mahasiswa/dashboard"
          class="inline-flex items-center gap-2 h-9 px-4 rounded-md bg-[#0655a7] hover:bg-[#114d91] text-white text-xs font-semibold transition-colors shadow-none"
        >
          <i data-lucide="layout-dashboard" class="w-4 h-4"></i>
          <span>Buka Dashboard</span>
        </a>
      </div>
    </div>

    <!-- Konten Utama (Hanya tampil jika sudah diterima) -->
    <div x-show="$store.mahasiswaSim?.state !== 'belum_daftar'" x-cloak class="space-y-6">
    <!-- Kartu Profil Mahasiswa & Progres Kerja Praktek -->
    <div class="bg-white border border-[#e4e4e7] rounded-xl p-6 shadow-2xs">
      <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-6">
        <!-- Kolom Kiri: Avatar & Biodata -->
        <div class="flex items-start gap-4">
          <!-- Avatar Lingkaran Inisial -->
          <div class="w-16 h-16 rounded-full bg-[#f4f4f5] border border-[#e4e4e7] flex items-center justify-center shrink-0">
            <span class="text-[20px] font-semibold text-[#3f3f46]">MB</span>
          </div>

          <!-- Rincian Mahasiswa -->
          <div class="space-y-1">
            <h2 class="text-[18px] font-bold text-[#09090b] leading-tight">Mahasiswa Kampus Berdampak</h2>
            <p class="text-[13px] text-[#71717a]">A11.2020.00001</p>
            <p class="text-[13px] text-[#3f3f46]">Dosen Pembimbing: Dosen A11</p>

            <!-- Status Badge -->
            <div class="pt-1">
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-[11px] font-medium bg-[#ecfdf5] text-[#15803d] border border-[#bbf7d0]">
                Selesai
              </span>
            </div>

            <!-- Total Logbook & Minggu Terakhir -->
            <div class="pt-3 space-y-1.5">
              <div class="flex items-center gap-2 text-[13px] text-[#3f3f46]">
                <i data-lucide="file-text" class="w-4 h-4 text-[#71717a]"></i>
                <span>Total Kegiatan: <strong class="font-semibold text-[#09090b]" id="total-kegiatan-count">{logbookList.length}</strong></span>
              </div>
              <div class="flex items-center gap-2 text-[13px] text-[#3f3f46]">
                <i data-lucide="calendar-range" class="w-4 h-4 text-[#71717a]"></i>
                <span>Minggu Terakhir: <strong class="font-semibold text-[#09090b]" id="minggu-terakhir-count">{logbookList[logbookList.length - 1]?.minggu ?? 0}</strong></span>
              </div>
            </div>
          </div>
        </div>

        <!-- Kolom Kanan: Tombol Aksi & Progres Bar -->
        <div class="flex flex-col justify-between items-start lg:items-end self-stretch gap-6 lg:min-w-[340px]">
          <!-- Baris Tombol Aksi -->
          <div class="flex items-center gap-2.5">
            <button
              type="button"
              onclick="openTambahModal()"
              class="inline-flex items-center gap-1.5 px-3.5 py-2 bg-[#1063B9] hover:bg-[#0E4F96] text-white text-xs font-semibold rounded-lg shadow-2xs transition-all active:scale-95 cursor-pointer"
            >
              <i data-lucide="plus" class="w-3.5 h-3.5 stroke-[2.5]"></i>
              <span>Tambah Logbook</span>
            </button>
            <button
              type="button"
              onclick="openFolderModal()"
              class="inline-flex items-center gap-1.5 px-3.5 py-2 bg-white hover:bg-gray-50 text-[#09090b] border border-[#e4e4e7] text-xs font-semibold rounded-lg shadow-2xs transition-colors cursor-pointer"
            >
              <i data-lucide="edit-3" class="w-3.5 h-3.5 text-[#71717a]"></i>
              <span>Edit Folder Kampus Berdampak</span>
            </button>
          </div>

          <!-- Progress Kerja Praktek -->
          <div class="w-full space-y-1.5 mt-auto">
            <div class="flex items-center justify-between text-xs font-medium">
              <span class="text-[#3f3f46]">Progress Kerja Praktek</span>
              <span class="text-[#09090b] font-semibold">100%</span>
            </div>
            <div class="w-full h-2 bg-gray-100 rounded-full overflow-hidden">
              <div class="h-full bg-[#1063B9] rounded-full w-full transition-all duration-500"></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Bagian Riwayat Kegiatan -->
    <div class="pt-2">
      <h2 class="text-[17px] font-bold text-[#09090b] mb-4">Riwayat Kegiatan</h2>

      <!-- Timeline List -->
      <div class="space-y-4 relative" id="timeline-container">
        {logbookList.map((item, index) => {
          const isLast = index === logbookList.length - 1;
          return (
            <div class="relative flex items-start gap-4">
              <!-- Garis Penghubung Vertikal Antar Step -->
              {!isLast && (
                <div class="absolute left-3.5 top-7 -bottom-4 w-[1.5px] bg-[#e4e4e7] -translate-x-1/2 z-0"></div>
              )}

              <!-- Lingkaran Penomoran -->
              <div class="relative z-10 w-7 h-7 rounded-full bg-[#eff6ff] text-[#1063B9] text-xs font-semibold flex items-center justify-center shrink-0 border border-[#bfdbfe]">
                {item.minggu}
              </div>

              <!-- Kartu Kegiatan Accordion -->
              <div class="flex-1 bg-white border border-[#e4e4e7] rounded-xl p-5 shadow-2xs hover:border-[#cbd5e1] transition-colors">
                <!-- Header Kartu (Klik untuk buka/tutup accordion) -->
                <div
                  class="flex items-start justify-between cursor-pointer select-none group"
                  onclick={`toggleAccordion(${item.id})`}
                >
                  <div class="space-y-1">
                    <div class="flex items-center gap-2.5">
                      <h3 class="text-[15px] font-bold text-[#09090b] group-hover:text-[#1063B9] transition-colors">
                        Minggu ke-{item.minggu}
                      </h3>
                    </div>
                    <p class="text-[12px] text-[#71717a]">Periode: {item.periodeHari}</p>
                  </div>

                  <button
                    type="button"
                    class="p-1 text-[#71717a] hover:text-[#09090b] rounded transition-transform duration-200"
                    id={`chevron-${item.id}`}
                  >
                    <i data-lucide="chevron-down" class="w-4 h-4"></i>
                  </button>
                </div>

                <!-- Konten Rincian Kegiatan (Collapsible Body) -->
                <div id={`content-${item.id}`} class="mt-4 pt-4 border-t border-[#f4f4f5] space-y-3">
                  <!-- Periode Hari -->
                  <div class="flex items-center gap-1.5 text-xs text-[#71717a]">
                    <i data-lucide="calendar" class="w-3.5 h-3.5 text-[#71717a]"></i>
                    <span class="font-medium text-[#52525b]">{item.periodeHari}</span>
                  </div>

                  <!-- Kegiatan -->
                  <div class="space-y-1">
                    <div class="text-[11px] font-semibold uppercase tracking-wide text-[#71717a]">Kegiatan</div>
                    <p class="text-[13px] text-[#27272a] leading-relaxed">
                      {item.kegiatan}
                    </p>
                  </div>

                  <!-- Hasil (Artikel: Kalimat dan/atau Foto) -->
                  <div class="space-y-2 pt-1">
                    <div class="text-[11px] font-semibold uppercase tracking-wide text-[#71717a]">Hasil</div>
                    <p class="text-[13px] text-[#27272a] leading-relaxed">
                      {item.hasilTeks}
                    </p>

                    {item.hasilFoto && (
                      <div class="pt-1">
                        <button
                          type="button"
                          onclick={`openDocModal('Minggu ke-${item.minggu}', '${item.periodeHari}', '${item.hasilTeks.replace(/'/g, "\\'")}', '${item.hasilFoto}')`}
                          class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white hover:bg-gray-50 text-[#09090b] border border-[#e4e4e7] rounded-lg text-xs font-medium shadow-2xs transition-colors cursor-pointer"
                        >
                          <i data-lucide="image" class="w-3.5 h-3.5 text-[#71717a]"></i>
                          <span>Lihat Foto Hasil</span>
                        </button>
                      </div>
                    )}
                  </div>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
    </div>
  </div>

  <!-- Modal: Tambah Logbook -->
  <div id="modal-tambah-logbook" class="hidden fixed inset-0 bg-black/40 backdrop-blur-xs z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-xl max-w-lg w-full max-h-[90vh] overflow-y-auto shadow-2xl border border-[#e4e4e7]">
      <div class="sticky top-0 bg-white border-b border-[#e4e4e7] p-5 flex items-center justify-between">
        <div>
          <h3 class="text-[16px] font-bold text-[#09090b]">Tambah Logbook Kegiatan</h3>
          <p class="text-xs text-[#71717a] mt-0.5">Catat kegiatan mingguan dan hasil yang dicapai.</p>
        </div>
        <button type="button" onclick="closeTambahModal()" class="text-[#71717a] hover:text-[#09090b] p-1 cursor-pointer">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>

      <form id="form-tambah-logbook" onsubmit="handleTambahSubmit(event)" class="p-5 space-y-4">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <label for="input-minggu" class="text-[12px] font-semibold text-[#09090b] block mb-1">
              Minggu <span class="text-red-500">*</span>
            </label>
            <input
              id="input-minggu"
              type="number"
              min="1"
              step="1"
              value="6"
              placeholder="Contoh: 6"
              class="w-full px-3 py-2 border border-[#e4e4e7] rounded-lg text-xs focus:outline-none focus:ring-2 focus:ring-[#1063B9]"
              required
            />
          </div>

          <div class="sm:col-span-2">
            <label for="input-periode-hari" class="text-[12px] font-semibold text-[#09090b] block mb-1">
              Periode Hari <span class="text-red-500">*</span>
            </label>
            <input
              id="input-periode-hari"
              type="text"
              placeholder="Contoh: Senin - Jumat, 12 - 16 Okt 2026"
              class="w-full px-3 py-2 border border-[#e4e4e7] rounded-lg text-xs focus:outline-none focus:ring-2 focus:ring-[#1063B9]"
              required
            />
          </div>
        </div>

        <div>
          <label for="input-kegiatan" class="text-[12px] font-semibold text-[#09090b] block mb-1">
            Kegiatan <span class="text-red-500">*</span>
          </label>
          <textarea
            id="input-kegiatan"
            rows="3"
            class="w-full px-3 py-2 border border-[#e4e4e7] rounded-lg text-xs focus:outline-none focus:ring-2 focus:ring-[#1063B9] resize-none"
            placeholder="Uraikan kegiatan yang dilaksanakan selama minggu ini"
            required
          ></textarea>
        </div>

        <div>
          <label for="input-hasil-teks" class="text-[12px] font-semibold text-[#09090b] block mb-1">
            Hasil
          </label>
          <textarea
            id="input-hasil-teks"
            rows="3"
            class="w-full px-3 py-2 border border-[#e4e4e7] rounded-lg text-xs focus:outline-none focus:ring-2 focus:ring-[#1063B9] resize-none"
            placeholder="Tuliskan artikel singkat atau kalimat hasil dari capaian kegiatan"
          ></textarea>
        </div>

        <div>
          <label for="input-hasil-foto" class="text-[12px] font-semibold text-[#09090b] block mb-1">
            Foto Hasil <span class="text-[#71717a] font-normal">(Opsional jika sudah mengisi teks)</span>
          </label>
          <input
            id="input-hasil-foto"
            type="file"
            accept="image/*"
            class="w-full text-xs text-[#09090b] file:mr-3 file:py-1.5 file:px-3 file:rounded-md file:border file:border-[#e4e4e7] file:text-xs file:font-semibold file:bg-white file:text-[#09090b] hover:file:bg-[#f4f4f5] file:cursor-pointer p-1.5 border border-[#e4e4e7] rounded-lg bg-[#fafafa]"
          />
          <p class="text-[11px] text-[#71717a] mt-1">Unggah foto dokumentasi kegiatan/hasil (JPG, PNG, WebP).</p>
        </div>

        <div class="flex items-center justify-end gap-2 pt-4 border-t border-[#e4e4e7]">
          <button type="button" onclick="closeTambahModal()" class="px-4 py-2 border border-[#e4e4e7] text-[#09090b] text-xs font-semibold rounded-lg hover:bg-gray-50 transition-colors cursor-pointer">
            Batal
          </button>
          <button type="submit" class="px-4 py-2 bg-[#1063B9] hover:bg-[#0E4F96] text-white text-xs font-semibold rounded-lg transition-colors cursor-pointer">
            Simpan Logbook
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal: Edit Folder Kampus Berdampak -->
  <div id="modal-folder-Kampus Berdampak" class="hidden fixed inset-0 bg-black/40 backdrop-blur-xs z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-xl max-w-md w-full shadow-2xl border border-[#e4e4e7]">
      <div class="border-b border-[#e4e4e7] p-5 flex items-center justify-between">
        <div>
          <h3 class="text-[16px] font-bold text-[#09090b]">Edit Folder Kampus Berdampak</h3>
          <p class="text-xs text-[#71717a] mt-0.5">Tautan repositori Google Drive berkas kerja praktek.</p>
        </div>
        <button type="button" onclick="closeFolderModal()" class="text-[#71717a] hover:text-[#09090b] p-1 cursor-pointer">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>

      <form onsubmit="handleFolderSubmit(event)" class="p-5 space-y-4">
        <div>
          <label class="text-[12px] font-semibold text-[#09090b] block mb-1">Tautan Folder Google Drive <span class="text-red-500">*</span></label>
          <input
            id="input-folder-url"
            type="url"
            value="https://drive.google.com/drive/folders/kerja-praktek-a11-2020-00001"
            class="w-full px-3 py-2 border border-[#e4e4e7] rounded-lg text-xs focus:outline-none focus:ring-2 focus:ring-[#1063B9]"
            required
          />
          <p class="text-[11px] text-[#71717a] mt-1">Semua dokumen revisi dan laporan kerja praktek disatukan di folder ini.</p>
        </div>

        <div class="flex items-center justify-end gap-2 pt-4 border-t border-[#e4e4e7]">
          <button type="button" onclick="closeFolderModal()" class="px-4 py-2 border border-[#e4e4e7] text-[#09090b] text-xs font-semibold rounded-lg hover:bg-gray-50 transition-colors cursor-pointer">
            Batal
          </button>
          <button type="submit" class="px-4 py-2 bg-[#1063B9] hover:bg-[#0E4F96] text-white text-xs font-semibold rounded-lg transition-colors cursor-pointer">
            Simpan Perubahan
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal: Lihat Foto Hasil -->
  <div id="modal-lihat-dokumen" class="hidden fixed inset-0 bg-black/40 backdrop-blur-xs z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-xl max-w-md w-full shadow-2xl border border-[#e4e4e7]">
      <div class="border-b border-[#e4e4e7] p-5 flex items-center justify-between">
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-lg bg-blue-50 text-[#1063B9] flex items-center justify-center">
            <i data-lucide="image" class="w-4 h-4"></i>
          </div>
          <div>
            <h3 class="text-[15px] font-bold text-[#09090b]" id="doc-modal-title">Hasil Kegiatan</h3>
            <p class="text-xs text-[#71717a]" id="doc-modal-date">Senin - Jumat, 7 - 11 Sep 2026</p>
          </div>
        </div>
        <button type="button" onclick="closeDocModal()" class="text-[#71717a] hover:text-[#09090b] p-1 cursor-pointer">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>

      <div class="p-5 space-y-4">
        <div>
          <div class="text-[11px] font-semibold text-[#71717a] uppercase mb-1">Foto Dokumentasi</div>
          <div class="rounded-lg overflow-hidden border border-[#e4e4e7] bg-gray-50">
            <img id="doc-modal-img" src="" alt="Foto hasil kegiatan" class="w-full h-48 object-cover" />
          </div>
        </div>

        <div>
          <div class="text-[11px] font-semibold text-[#71717a] uppercase mb-1">Ringkasan Hasil</div>
          <p class="text-xs text-[#52525b] leading-relaxed p-3 bg-gray-50 border border-[#e4e4e7] rounded-lg" id="doc-modal-desc"></p>
        </div>
      </div>

      <div class="p-4 bg-gray-50 border-t border-[#e4e4e7] flex items-center justify-end gap-2 rounded-b-xl">
        <button type="button" onclick="closeDocModal()" class="px-4 py-2 border border-[#e4e4e7] text-[#09090b] text-xs font-semibold rounded-lg hover:bg-white transition-colors cursor-pointer">
          Tutup
        </button>
      </div>
    </div>
  </div>

  <script is:inline>
    // Accordion Toggle
    function toggleAccordion(id) {
      const content = document.getElementById('content-' + id);
      const chevron = document.getElementById('chevron-' + id);
      if (!content || !chevron) return;

      const isHidden = content.classList.contains('hidden');
      if (isHidden) {
        content.classList.remove('hidden');
        chevron.style.transform = 'rotate(0deg)';
      } else {
        content.classList.add('hidden');
        chevron.style.transform = 'rotate(-180deg)';
      }
    }

    // Modal Tambah Logbook
    function openTambahModal() {
      const modal = document.getElementById('modal-tambah-logbook');
      if (modal) modal.classList.remove('hidden');
      if (window.lucide) window.lucide.createIcons();
    }

    function closeTambahModal() {
      const modal = document.getElementById('modal-tambah-logbook');
      if (modal) modal.classList.add('hidden');
    }

    function escapeHtml(str) {
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function handleTambahSubmit(event) {
      event.preventDefault();
      const minggu = parseInt(document.getElementById('input-minggu').value, 10);
      const periodeHari = document.getElementById('input-periode-hari').value.trim();
      const kegiatan = document.getElementById('input-kegiatan').value.trim();
      const hasilTeks = document.getElementById('input-hasil-teks').value.trim();
      const fotoInput = document.getElementById('input-hasil-foto');
      const fotoFile = fotoInput && fotoInput.files && fotoInput.files[0];

      if (!hasilTeks && !fotoFile) {
        alert('Mohon isi hasil kegiatan berupa teks/kalimat dan/atau unggah foto.');
        return;
      }

      const container = document.getElementById('timeline-container');
      const newId = Date.now();
      const fotoUrl = fotoFile ? URL.createObjectURL(fotoFile) : '';

      if (container) {
        // Tambahkan garis penghubung ke item terakhir sebelumnya jika belum ada
        const lastItem = container.lastElementChild;
        if (lastItem && !lastItem.querySelector('.timeline-connector')) {
          const line = document.createElement('div');
          line.className = 'timeline-connector absolute left-3.5 top-7 -bottom-4 w-[1.5px] bg-[#e4e4e7] -translate-x-1/2 z-0';
          lastItem.insertBefore(line, lastItem.firstChild);
        }

        const safePeriode = escapeHtml(periodeHari);
        const safeKegiatan = escapeHtml(kegiatan);
        const safeHasil = escapeHtml(hasilTeks);

        const wrapper = document.createElement('div');
        wrapper.className = 'relative flex items-start gap-4';
        wrapper.innerHTML = `
          <div class="relative z-10 w-7 h-7 rounded-full bg-[#eff6ff] text-[#1063B9] text-xs font-semibold flex items-center justify-center shrink-0 border border-[#bfdbfe]">
            ${minggu}
          </div>
          <div class="flex-1 bg-white border border-[#e4e4e7] rounded-xl p-5 shadow-2xs hover:border-[#cbd5e1] transition-colors">
            <div class="flex items-start justify-between cursor-pointer select-none group" onclick="toggleAccordion(${newId})">
              <div class="space-y-1">
                <div class="flex items-center gap-2.5">
                  <h3 class="text-[15px] font-bold text-[#09090b] group-hover:text-[#1063B9] transition-colors">Minggu ke-${minggu}</h3>
                </div>
                <p class="text-[12px] text-[#71717a]">Periode: ${safePeriode}</p>
              </div>
              <button type="button" class="p-1 text-[#71717a] hover:text-[#09090b] rounded transition-transform duration-200" id="chevron-${newId}">
                <i data-lucide="chevron-down" class="w-4 h-4"></i>
              </button>
            </div>
            <div id="content-${newId}" class="mt-4 pt-4 border-t border-[#f4f4f5] space-y-3">
              <div class="flex items-center gap-1.5 text-xs text-[#71717a]">
                <i data-lucide="calendar" class="w-3.5 h-3.5 text-[#71717a]"></i>
                <span class="font-medium text-[#52525b]">${safePeriode}</span>
              </div>
              <div class="space-y-1">
                <div class="text-[11px] font-semibold uppercase tracking-wide text-[#71717a]">Kegiatan</div>
                <p class="text-[13px] text-[#27272a] leading-relaxed">${safeKegiatan}</p>
              </div>
              <div class="space-y-2 pt-1">
                <div class="text-[11px] font-semibold uppercase tracking-wide text-[#71717a]">Hasil</div>
                <p class="text-[13px] text-[#27272a] leading-relaxed">${safeHasil}</p>
                ${fotoUrl ? `
                  <div class="pt-1">
                    <button type="button" onclick="openDocModal('Minggu ke-${minggu}', '${safePeriode}', '${safeHasil}', '${fotoUrl}')" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white hover:bg-gray-50 text-[#09090b] border border-[#e4e4e7] rounded-lg text-xs font-medium shadow-2xs transition-colors cursor-pointer">
                      <i data-lucide="image" class="w-3.5 h-3.5 text-[#71717a]"></i>
                      <span>Lihat Foto Hasil</span>
                    </button>
                  </div>
                ` : ''}
              </div>
            </div>
          </div>
        `;
        container.appendChild(wrapper);

        const totalEl = document.getElementById('total-kegiatan-count');
        if (totalEl) totalEl.textContent = String(container.children.length);
        const mingguEl = document.getElementById('minggu-terakhir-count');
        if (mingguEl) mingguEl.textContent = String(minggu);
        if (window.lucide) window.lucide.createIcons();
      }

      alert(`Logbook Minggu ke-${minggu} berhasil disimpan!`);
      const form = document.getElementById('form-tambah-logbook');
      if (form) form.reset();
      const mingguInput = document.getElementById('input-minggu');
      if (mingguInput) mingguInput.value = String(minggu + 1);
      closeTambahModal();
    }

    // Modal Edit Folder Kampus Berdampak
    function openFolderModal() {
      const modal = document.getElementById('modal-folder-Kampus Berdampak');
      if (modal) modal.classList.remove('hidden');
      if (window.lucide) window.lucide.createIcons();
    }

    function closeFolderModal() {
      const modal = document.getElementById('modal-folder-Kampus Berdampak');
      if (modal) modal.classList.add('hidden');
    }

    function handleFolderSubmit(event) {
      event.preventDefault();
      alert('Tautan Folder Google Drive Kerja Praktek berhasil diperbarui!');
      closeFolderModal();
    }

    // Modal Lihat Foto Hasil
    function openDocModal(title, periode, hasilTeks, fotoUrl) {
      const titleEl = document.getElementById('doc-modal-title');
      const dateEl = document.getElementById('doc-modal-date');
      const descEl = document.getElementById('doc-modal-desc');
      const imgEl = document.getElementById('doc-modal-img');

      if (titleEl) titleEl.textContent = title;
      if (dateEl) dateEl.textContent = periode;
      if (descEl) descEl.textContent = hasilTeks;
      if (imgEl) imgEl.src = fotoUrl;

      const modal = document.getElementById('modal-lihat-dokumen');
      if (modal) modal.classList.remove('hidden');
      if (window.lucide) window.lucide.createIcons();
    }

    function closeDocModal() {
      const modal = document.getElementById('modal-lihat-dokumen');
      if (modal) modal.classList.add('hidden');
    }

    // Close modals on Escape key or backdrop click
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeTambahModal();
        closeFolderModal();
        closeDocModal();
      }
    });

    ['modal-tambah-logbook', 'modal-folder-Kampus Berdampak', 'modal-lihat-dokumen'].forEach((modalId) => {
      const modal = document.getElementById(modalId);
      if (modal) {
        modal.addEventListener('click', (e) => {
          if (e.target === modal) {
            modal.classList.add('hidden');
          }
        });
      }
    });

    // Re-initialize Lucide icons on load
    document.addEventListener('DOMContentLoaded', () => {
      if (window.lucide) {
        window.lucide.createIcons();
      }
    });
  </script>
</MahasiswaShell>
