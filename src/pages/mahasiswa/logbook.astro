---
// src/pages/mahasiswa/logbook.astro
import MahasiswaShell from '../../layouts/MahasiswaShell.astro';
---

<MahasiswaShell
  title="Logbook Kegiatan Mingguan | Mahasiswa - FIK Udinus"
  activeNav="logbook"
  pageTitle="Logbook Kegiatan Mingguan MBKM"
  breadcrumb="Logbook Kegiatan"
>
  <section id="view-logbook" class="space-y-6">
    <!-- Header -->
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div>
        <h2 class="text-[20px] leading-[28px] font-normal text-[#09090b]">Logbook Kegiatan Mingguan</h2>
        <p class="text-[14px] leading-[20px] text-[#71717a]">Pencatatan aktivitas mingguan program MBKM.</p>
      </div>
      <div class="flex items-center gap-2">
        <button type="button" onclick="openLogbookModal()" class="inline-flex items-center gap-2 px-4 py-2 bg-[#1063B9] hover:bg-[#0E4F96] text-white text-xs font-semibold rounded-lg shadow-2xs transition-all active:scale-[0.98]">
          <i data-lucide="plus" class="w-4 h-4"></i> Isi Logbook
        </button>
      </div>
    </div>

    <!-- Riwayat Logbook -->
    <div class="bg-white border border-[#e4e4e7] rounded-[12px] p-5 shadow-2xs space-y-4">
      <div class="flex items-center justify-between pb-3 border-b border-[#e4e4e7]">
        <div>
          <h3 class="text-[14px] font-semibold text-[#09090b]">Riwayat Logbook Kegiatan</h3>
          <p class="text-[12px] text-[#71717a]">Daftar pencatatan kegiatan mingguan MBKM.</p>
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs border-collapse">
          <thead>
            <tr class="bg-gray-50 text-[11px] font-semibold text-[#71717a] uppercase tracking-wider border-b border-[#e4e4e7]">
              <th class="py-2.5 px-3">Minggu</th>
              <th class="py-2.5 px-3">Rentang Tanggal</th>
              <th class="py-2.5 px-3">Aktivitas</th>
              <th class="py-2.5 px-3">Bukti</th>
              <th class="py-2.5 px-3 text-right">Aksi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <!-- Logbook 1 -->
            <tr class="hover:bg-gray-50/70 transition-colors">
              <td class="py-3 px-3">
                <div class="flex items-center gap-2">
                  <div class="w-8 h-8 rounded-full bg-blue-50 text-blue-700 flex items-center justify-center font-bold text-xs">1</div>
                  <span class="font-medium text-[#09090b]">Minggu 1</span>
                </div>
              </td>
              <td class="py-3 px-3 text-[#71717a]">06 - 10 Okt 2025</td>
              <td class="py-3 px-3">
                <div class="font-medium text-[13px] text-[#09090b]">Kick-off & Setup Repositori</div>
                <div class="text-[11px] text-[#71717a]">Inisialisasi repo GitHub dan CI/CD</div>
              </td>
              <td class="py-3 px-3">
                <a href="https://drive.google.com/" target="_blank" class="text-[#1063B9] hover:underline flex items-center gap-1 text-[11px]">
                  <i data-lucide="external-link" class="w-3 h-3"></i> GDrive
                </a>
              </td>
              <td class="py-3 px-3 text-right">
                <button type="button" onclick="viewDetail(1)" class="px-2.5 py-1 bg-white hover:bg-gray-50 text-[#09090b] border border-[#e4e4e7] rounded text-xs font-medium transition-colors">
                  Detail
                </button>
              </td>
            </tr>

            <!-- Logbook 2 -->
            <tr class="hover:bg-gray-50/70 transition-colors">
              <td class="py-3 px-3">
                <div class="flex items-center gap-2">
                  <div class="w-8 h-8 rounded-full bg-blue-50 text-blue-700 flex items-center justify-center font-bold text-xs">2</div>
                  <span class="font-medium text-[#09090b]">Minggu 2</span>
                </div>
              </td>
              <td class="py-3 px-3 text-[#71717a]">13 - 17 Okt 2025</td>
              <td class="py-3 px-3">
                <div class="font-medium text-[13px] text-[#09090b]">Fitur Autentikasi & RBAC</div>
                <div class="text-[11px] text-[#71717a]">JWT Auth, Role-Based Access Control</div>
              </td>
              <td class="py-3 px-3">
                <a href="https://drive.google.com/" target="_blank" class="text-[#1063B9] hover:underline flex items-center gap-1 text-[11px]">
                  <i data-lucide="external-link" class="w-3 h-3"></i> GDrive
                </a>
              </td>
              <td class="py-3 px-3 text-right">
                <button type="button" onclick="viewDetail(2)" class="px-2.5 py-1 bg-white hover:bg-gray-50 text-[#09090b] border border-[#e4e4e7] rounded text-xs font-medium transition-colors">
                  Detail
                </button>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Modal: Detail Logbook (View/Edit) -->
  <div id="modal-detail-logbook" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-xl max-w-2xl w-full max-h-[90vh] overflow-y-auto shadow-2xl">
      <div class="sticky top-0 bg-white border-b border-[#e4e4e7] p-5 flex items-center justify-between">
        <h3 class="text-[16px] font-semibold text-[#09090b]">Detail Logbook Minggu</h3>
        <button type="button" onclick="closeDetailModal()" class="text-[#71717a] hover:text-[#09090b]">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>
      <div class="p-5 space-y-4" id="detail-content">
        <!-- Content will be populated dynamically -->
      </div>
      <div class="sticky bottom-0 bg-white border-t border-[#e4e4e7] p-4 flex items-center justify-end gap-2">
        <button type="button" onclick="closeDetailModal()" class="px-4 py-2 border border-[#e4e4e7] text-[#09090b] text-xs font-semibold rounded-lg hover:bg-gray-50 transition-colors">
          Tutup
        </button>
        <button type="button" onclick="editLogbook()" class="px-4 py-2 bg-[#1063B9] hover:bg-[#0E4F96] text-white text-xs font-semibold rounded-lg transition-colors">
          Edit
        </button>
      </div>
    </div>
  </div>

  <!-- Modal: Isi Logbook (Form Input) -->
  <div id="modal-logbook" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-xl max-w-3xl w-full max-h-[90vh] overflow-y-auto shadow-2xl">
      <div class="sticky top-0 bg-white border-b border-[#e4e4e7] p-5 flex items-center justify-between">
        <h3 class="text-[16px] font-semibold text-[#09090b]">Isi Logbook Mingguan</h3>
        <button type="button" onclick="closeLogbookModal()" class="text-[#71717a] hover:text-[#09090b]">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>
      <form onsubmit="submitLogbook(event)" class="p-5 space-y-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="form-group">
            <label class="text-[12px] font-medium text-[#09090b] block mb-1">Minggu Ke- <span class="text-red-500">*</span></label>
            <select class="w-full px-3 py-2 border border-[#e4e4e7] rounded-lg text-[13px] focus:outline-none focus:ring-2 focus:ring-[#1063B9]" required>
              <option value="3">Minggu 3</option>
              <option value="4">Minggu 4</option>
              <option value="5">Minggu 5</option>
            </select>
          </div>
          <div class="form-group">
            <label class="text-[12px] font-medium text-[#09090b] block mb-1">Rentang Tanggal <span class="text-red-500">*</span></label>
            <input type="text" class="w-full px-3 py-2 border border-[#e4e4e7] rounded-lg text-[13px] focus:outline-none focus:ring-2 focus:ring-[#1063B9]" placeholder="20 - 24 Okt 2025" required />
          </div>
        </div>

        <div class="form-group">
          <label class="text-[12px] font-medium text-[#09090b] block mb-1">Rincian Aktivitas <span class="text-red-500">*</span></label>
          <textarea rows="4" class="w-full px-3 py-2 border border-[#e4e4e7] rounded-lg text-[13px] focus:outline-none focus:ring-2 focus:ring-[#1063B9] resize-y" placeholder="Deskripsikan pekerjaan yang diselesaikan minggu ini..." required></textarea>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="form-group">
            <label class="text-[12px] font-medium text-[#09090b] block mb-1">Kendala yang Dihadapi</label>
            <textarea rows="3" class="w-full px-3 py-2 border border-[#e4e4e7] rounded-lg text-[13px] focus:outline-none focus:ring-2 focus:ring-[#1063B9] resize-y" placeholder="Hambatan teknis atau non-teknis..."></textarea>
          </div>
          <div class="form-group">
            <label class="text-[12px] font-medium text-[#09090b] block mb-1">Solusi / Tindak Lanjut</label>
            <textarea rows="3" class="w-full px-3 py-2 border border-[#e4e4e7] rounded-lg text-[13px] focus:outline-none focus:ring-2 focus:ring-[#1063B9] resize-y" placeholder="Cara mengatasi kendala..."></textarea>
          </div>
        </div>

        <div class="form-group">
          <label class="text-[12px] font-medium text-[#09090b] block mb-1">Tautan Bukti Kegiatan (Google Drive) <span class="text-red-500">*</span></label>
          <input type="url" class="w-full px-3 py-2 border border-[#e4e4e7] rounded-lg text-[13px] focus:outline-none focus:ring-2 focus:ring-[#1063B9]" placeholder="https://drive.google.com/..." required />
          <p class="text-[11px] text-[#71717a] mt-1">Screenshot hasil kerja, commit log, atau dokumentasi aktivitas.</p>
        </div>

        <div class="flex items-center justify-end gap-2 pt-4 border-t border-[#e4e4e7]">
          <button type="button" onclick="closeLogbookModal()" class="px-4 py-2 border border-[#e4e4e7] text-[#09090b] text-xs font-semibold rounded-lg hover:bg-gray-50 transition-colors">
            Batal
          </button>
          <button type="submit" class="px-4 py-2 bg-[#1063B9] hover:bg-[#0E4F96] text-white text-xs font-semibold rounded-lg transition-colors">
            Kirim Logbook
          </button>
        </div>
      </form>
    </div>
  </div>

  <script is:inline>
    const logbooks = {
      1: {
        minggu: 1,
        tanggal: '06 - 10 Okt 2025',
        aktivitas: 'Kick-off & Setup Repositori Proyek',
        deskripsi: 'Inisialisasi repo GitHub, konfigurasi CI/CD, dan riset kebutuhan sistem modul Dashboard.',
        kendala: '-',
        solusi: '-',
        bukti: 'https://drive.google.com/drive/folders/1xxx'
      },
      2: {
        minggu: 2,
        tanggal: '13 - 17 Okt 2025',
        aktivitas: 'Pengembangan Fitur Autentikasi & RBAC',
        deskripsi: 'Implementasi JWT Auth, Role-Based Access Control, dan unit testing endpoint API.',
        kendala: 'Kompleksitas integrasi OAuth2',
        solusi: 'Review dokumentasi dan konsultasi dengan mentor',
        bukti: 'https://drive.google.com/drive/folders/1yyy'
      }
    };

    let currentLogbookId = null;

    function viewDetail(id) {
      currentLogbookId = id;
      const data = logbooks[id];
      if (!data) return;

      const content = `
        <div class="space-y-4">
          <div class="grid grid-cols-2 gap-4">
            <div class="p-3 bg-gray-50 rounded-lg">
              <div class="text-[11px] text-[#71717a] mb-1">Minggu Ke-</div>
              <div class="text-[15px] font-semibold text-[#09090b]">Minggu ${data.minggu}</div>
            </div>
            <div class="p-3 bg-gray-50 rounded-lg">
              <div class="text-[11px] text-[#71717a] mb-1">Rentang Tanggal</div>
              <div class="text-[15px] font-semibold text-[#09090b]">${data.tanggal}</div>
            </div>
          </div>
          <div class="space-y-2">
            <h4 class="text-[12px] font-bold text-[#09090b] uppercase">Aktivitas</h4>
            <div class="text-[14px] text-[#09090b] font-medium">${data.aktivitas}</div>
            <p class="text-[13px] text-[#71717a]">${data.deskripsi}</p>
          </div>
          <div class="space-y-2">
            <h4 class="text-[12px] font-bold text-[#09090b] uppercase">Kendala</h4>
            <p class="text-[13px] text-[#71717a]">${data.kendala}</p>
          </div>
          <div class="space-y-2">
            <h4 class="text-[12px] font-bold text-[#09090b] uppercase">Solusi</h4>
            <p class="text-[13px] text-[#71717a]">${data.solusi}</p>
          </div>
          <div class="space-y-2">
            <h4 class="text-[12px] font-bold text-[#09090b] uppercase">Bukti Kegiatan</h4>
            <a href="${data.bukti}" target="_blank" class="flex items-center gap-2 text-[#1063B9] hover:underline text-[13px]">
              <i data-lucide="external-link" class="w-4 h-4"></i>
              ${data.bukti}
            </a>
          </div>
        </div>
      `;
      document.getElementById('detail-content').innerHTML = content;
      document.getElementById('modal-detail-logbook').classList.remove('hidden');
      
      if (typeof lucide !== 'undefined') lucide.createIcons();
    }

    function closeDetailModal() {
      document.getElementById('modal-detail-logbook').classList.add('hidden');
      currentLogbookId = null;
    }

    function editLogbook() {
      closeDetailModal();
      openLogbookModal();
    }

    function openLogbookModal() {
      document.getElementById('modal-logbook').classList.remove('hidden');
      if (typeof lucide !== 'undefined') lucide.createIcons();
    }

    function closeLogbookModal() {
      document.getElementById('modal-logbook').classList.add('hidden');
    }

    function submitLogbook(event) {
      event.preventDefault();
      alert('Logbook berhasil dikirim ke dosen pembimbing untuk verifikasi!');
      closeLogbookModal();
    }
  </script>
</MahasiswaShell>
