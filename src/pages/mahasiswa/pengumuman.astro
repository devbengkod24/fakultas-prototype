---
// src/pages/mahasiswa/pengumuman.astro
import MahasiswaShell from '../../layouts/MahasiswaShell.astro';
---

<MahasiswaShell
  title="Papan Pengumuman MBKM | Mahasiswa - FIK Udinus"
  activeNav="pengumuman"
  pageTitle="Pengumuman & Informasi Program"
  breadcrumb="Pengumuman"
>
  <section id="view-pengumuman" class="space-y-6">
    <!-- Header -->
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div>
        <h2 class="text-[20px] leading-[28px] font-normal text-[#09090b]">Pengumuman & Informasi</h2>
        <p class="text-[14px] leading-[20px] text-[#71717a]">Informasi terkait perubahan status pendaftaran, koordinasi MBKM, serta revisi mata kuliah konversi.</p>
      </div>
    </div>

    <!-- Announcement List -->
    <div class="grid grid-cols-1 gap-4">
      <!-- Announcement: Revisi Konversi -->
      <div class="p-5 bg-white border border-[#e4e4e7] rounded-[12px] shadow-2xs border-l-4 border-l-amber-500">
        <div class="flex items-start justify-between gap-4">
          <div class="flex-1">
            <div class="flex items-center gap-2 mb-2">
              <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-medium bg-amber-50 text-amber-800 border border-amber-200">Revisi Konversi</span>
              <span class="text-[12px] text-[#71717a]">18 Okt 2025</span>
            </div>
            <h3 class="text-[15px] font-semibold text-[#09090b] mb-1">Penting: Revisi Mata Kuliah Konversi SKS</h3>
            <p class="text-[13px] text-[#71717a]">Ditemukan ketidaksesuaian pada mata kuliah ekuivalensi program Magang Mandiri. Mohon cek kembali tabel konversi SKS dan segera lakukan edit pada sistem sebelum 20 Oktober 2025.</p>
          </div>
          <a href="/mahasiswa/konversi-sks" class="text-xs font-medium text-[#1063B9] hover:underline whitespace-nowrap">Edit Konversi</a>
        </div>
      </div>

      <!-- Announcement: Perubahan Status -->
      <div class="p-5 bg-white border border-[#e4e4e7] rounded-[12px] shadow-2xs border-l-4 border-l-[#1063B9]">
        <div class="flex items-start justify-between gap-4">
          <div class="flex-1">
            <div class="flex items-center gap-2 mb-2">
              <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-medium bg-blue-50 text-[#1063B9] border border-blue-100">Status Pendaftaran</span>
              <span class="text-[12px] text-[#71717a]">15 Okt 2025</span>
            </div>
            <h3 class="text-[15px] font-semibold text-[#09090b] mb-1">Status Lamaran Telah Diperbarui</h3>
            <p class="text-[13px] text-[#71717a]">Status pendaftaran program "Magang Software Engineer" di PT Telkom Indonesia telah berubah menjadi "Menunggu Verifikasi".</p>
          </div>
          <a href="/mahasiswa/status" class="text-xs font-medium text-[#1063B9] hover:underline whitespace-nowrap">Lihat Status</a>
        </div>
      </div>

      <!-- Announcement: Pengumuman Coordinator -->
      <div class="p-5 bg-white border border-[#e4e4e7] rounded-[12px] shadow-2xs border-l-4 border-l-emerald-500">
        <div class="flex items-start justify-between gap-4">
          <div class="flex-1">
            <div class="flex items-center gap-2 mb-2">
              <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-medium bg-emerald-50 text-emerald-800 border border-emerald-200">Informasi Koordinasi</span>
              <span class="text-[12px] text-[#71717a]">10 Okt 2025</span>
            </div>
            <h3 class="text-[15px] font-semibold text-[#09090b] mb-1">Jadwal Pembekalan MBKM</h3>
            <p class="text-[13px] text-[#71717a]">Koordinator MBKM Fakultas mengundang seluruh mahasiswa untuk mengikuti pembekalan teknis pendaftaran yang akan dilaksanakan pada 22 Oktober 2025.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</MahasiswaShell>


