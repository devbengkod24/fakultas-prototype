---
import MitraShell from '../../layouts/MitraShell.astro';
---

<MitraShell activeNav="anggota" breadcrumbTitle="Anggota Binaan" title="Anggota Binaan | Kampus Berdampak FIK UDINUS">
  <div class="mt-5 space-y-4">
    <!-- Tab Switcher: Mahasiswa Binaan vs Dosen Pembina -->
    <div class="flex items-center gap-2 border-b border-[#e4e4e7] pb-3">
      <button
        type="button"
        id="tab-btn-mahasiswa"
        onclick="switchAnggotaTab('mahasiswa')"
        class="inline-flex items-center gap-2 px-4 py-2 text-xs font-semibold rounded-lg bg-[#1063B9] text-white shadow-2xs transition-all"
      >
        <i data-lucide="user" class="w-4 h-4"></i>
        <span>Mahasiswa Binaan</span>
      </button>
      <button
        type="button"
        id="tab-btn-dosen"
        onclick="switchAnggotaTab('dosen')"
        class="inline-flex items-center gap-2 px-4 py-2 text-xs font-medium rounded-lg text-gray-600 hover:text-gray-900 hover:bg-gray-100 transition-all"
      >
        <i data-lucide="graduation-cap" class="w-4 h-4"></i>
        <span>Dosen Pembina</span>
      </button>
    </div>

    <!-- VIEW 1: MAHASISWA BINAAN (mahasiswa.html 100% SAMA PERSIS) -->
    <section id="view-mahasiswa" class="view-panel space-y-6">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
          <h2 class="text-[20px] leading-[28px] font-normal text-[#09090b]">Data Mahasiswa Binaan</h2>
          <p class="text-[14px] leading-[20px] text-[#71717a]">Daftar mahasiswa aktif bimbingan tugas akhir dan riset lab yang telah terdaftar dalam program binaan.</p>
        </div>
        <button type="button" onclick="openDirectAssignModal()" class="inline-flex items-center gap-2 px-4 py-2 bg-[#1063B9] hover:bg-[#0E4F96] text-white text-xs font-semibold rounded-lg shadow-2xs transition-all active:scale-[0.98]">
          <i data-lucide="user-plus" class="w-4 h-4"></i>
          <span>+ Direct Assign Mahasiswa</span>
        </button>
      </div>

      <!-- Toolbar Filter & Search -->
      <div class="flex flex-col sm:flex-row items-center justify-between gap-3">
        <div class="inline-flex p-1 bg-gray-100 rounded-lg border border-[#e4e4e7] text-xs">
          <button type="button" onclick="filterMahasiswaTable('semua', this)" class="mhs-filter-btn px-3 py-1.5 font-semibold rounded bg-white text-[#09090b] shadow-2xs">
            Semua Mahasiswa (<span id="countMhsAll">6</span>)
          </button>
          <button type="button" onclick="filterMahasiswaTable('direct', this)" class="mhs-filter-btn px-3 py-1.5 font-medium rounded text-gray-600 hover:text-gray-900">
            Direct Assign (3)
          </button>
          <button type="button" onclick="filterMahasiswaTable('mandiri', this)" class="mhs-filter-btn px-3 py-1.5 font-medium rounded text-gray-600 hover:text-gray-900">
            Lolos Mandiri (3)
          </button>
        </div>

        <div class="relative w-full sm:w-64">
          <i data-lucide="search" class="w-3.5 h-3.5 text-gray-400 absolute left-3 top-1/2 -translate-y-1/2"></i>
          <input type="text" id="searchMahasiswaInput" onkeyup="searchMahasiswa()" placeholder="Cari nama atau NIM..." class="w-full pl-8 pr-3 py-1.5 text-xs bg-white border border-gray-300 rounded-lg focus:border-[#1063B9] outline-none" />
        </div>
      </div>

      <!-- Tabel Data Mahasiswa Binaan -->
      <div class="bg-white border border-[#e4e4e7] rounded-[12px] shadow-2xs overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs border-collapse">
            <thead>
              <tr class="bg-gray-50 text-[11px] font-semibold text-[#71717a] uppercase tracking-wider border-b border-[#e4e4e7]">
                <th class="py-3 px-4">Mahasiswa</th>
                <th class="py-3 px-4">Jalur Intake</th>
                <th class="py-3 px-4">Fokus Riset / Tugas Akhir</th>
                <th class="py-3 px-4">Paket SKS</th>
                <th class="py-3 px-4">Status Prodi</th>
                <th class="py-3 px-4 text-right">Aksi</th>
              </tr>
            </thead>
            <tbody id="mahasiswaTableBody" class="divide-y divide-gray-100">
              <tr class="mhs-row hover:bg-gray-50/70 transition-colors" data-intake="direct" data-name="Dimas Wahyu Saputra" data-nim="A11.2022.14101">
                <td class="py-3.5 px-4">
                  <div class="font-medium text-[13px] text-[#09090b]">Dimas Wahyu Saputra</div>
                  <div class="text-[12px] text-[#71717a]">A11.2022.14101 • TI-S1</div>
                </td>
                <td class="py-3.5 px-4">
                  <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-gray-100 text-gray-700 border border-gray-200">
                    Direct Assign
                  </span>
                </td>
                <td class="py-3.5 px-4">
                  <span class="font-medium text-gray-800">Deteksi Cacat Permukaan Logam Menggunakan YOLOv8</span>
                  <div class="text-[#71717a] text-[11px]">Bimbingan Tugas Akhir</div>
                </td>
                <td class="py-3.5 px-4">
                  <span class="font-semibold text-[#1063B9]">20 SKS</span>
                  <div class="text-[#71717a] text-[11px]">5 Mata Kuliah</div>
                </td>
                <td class="py-3.5 px-4">
                  <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[11px] font-medium bg-emerald-50 text-emerald-700 border border-emerald-200">
                    <i data-lucide="check" class="w-3 h-3 text-emerald-600"></i> Disetujui Prodi
                  </span>
                </td>
                <td class="py-3.5 px-4 text-right">
                  <button type="button" onclick="showToast('Rincian Mahasiswa', 'Membuka profil akademik Dimas Wahyu Saputra')" class="px-2.5 py-1 text-xs text-[#1063B9] hover:bg-blue-50 rounded border border-blue-200 font-medium">
                    Rincian
                  </button>
                </td>
              </tr>

              <tr class="mhs-row hover:bg-gray-50/70 transition-colors" data-intake="direct" data-name="Siti Nurhaliza" data-nim="A11.2022.14150">
                <td class="py-3.5 px-4">
                  <div class="font-medium text-[13px] text-[#09090b]">Siti Nurhaliza</div>
                  <div class="text-[12px] text-[#71717a]">A11.2022.14150 • TI-S1</div>
                </td>
                <td class="py-3.5 px-4">
                  <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-gray-100 text-gray-700 border border-gray-200">
                    Direct Assign
                  </span>
                </td>
                <td class="py-3.5 px-4">
                  <span class="font-medium text-gray-800">Segmentasi Citra Medis USG Tiroid dengan Attention U-Net</span>
                  <div class="text-[#71717a] text-[11px]">Bimbingan Tugas Akhir</div>
                </td>
                <td class="py-3.5 px-4">
                  <span class="font-semibold text-[#1063B9]">20 SKS</span>
                  <div class="text-[#71717a] text-[11px]">5 Mata Kuliah</div>
                </td>
                <td class="py-3.5 px-4">
                  <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[11px] font-medium bg-emerald-50 text-emerald-700 border border-emerald-200">
                    <i data-lucide="check" class="w-3 h-3 text-emerald-600"></i> Disetujui Prodi
                  </span>
                </td>
                <td class="py-3.5 px-4 text-right">
                  <button type="button" onclick="showToast('Rincian Mahasiswa', 'Membuka profil akademik Siti Nurhaliza')" class="px-2.5 py-1 text-xs text-[#1063B9] hover:bg-blue-50 rounded border border-blue-200 font-medium">
                    Rincian
                  </button>
                </td>
              </tr>

              <tr class="mhs-row hover:bg-gray-50/70 transition-colors" data-intake="mandiri" data-name="Bagus Wicaksono" data-nim="A11.2022.14205">
                <td class="py-3.5 px-4">
                  <div class="font-medium text-[13px] text-[#09090b]">Bagus Wicaksono</div>
                  <div class="text-[12px] text-[#71717a]">A11.2022.14205 • TI-S1</div>
                </td>
                <td class="py-3.5 px-4">
                  <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-blue-50 text-blue-700 border border-blue-200">
                    Lolos Mandiri
                  </span>
                </td>
                <td class="py-3.5 px-4">
                  <span class="font-medium text-gray-800">Optimasi Hyperparameter Transformer untuk NLP Bahasa Jawa</span>
                  <div class="text-[#71717a] text-[11px]">Riset Mandiri Lab</div>
                </td>
                <td class="py-3.5 px-4">
                  <span class="font-semibold text-[#1063B9]">20 SKS</span>
                  <div class="text-[#71717a] text-[11px]">5 Mata Kuliah</div>
                </td>
                <td class="py-3.5 px-4">
                  <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[11px] font-medium bg-emerald-50 text-emerald-700 border border-emerald-200">
                    <i data-lucide="check" class="w-3 h-3 text-emerald-600"></i> Disetujui Prodi
                  </span>
                </td>
                <td class="py-3.5 px-4 text-right">
                  <button type="button" onclick="showToast('Rincian Mahasiswa', 'Membuka profil akademik Bagus Wicaksono')" class="px-2.5 py-1 text-xs text-[#1063B9] hover:bg-blue-50 rounded border border-blue-200 font-medium">
                    Rincian
                  </button>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- VIEW 2: DOSEN PEMBINA (dosen.html 100% SAMA PERSIS) -->
    <section id="view-dosen" class="view-panel space-y-6 hidden">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
          <h2 class="text-[20px] leading-[28px] font-normal text-[#09090b]">Data Dosen Pembina</h2>
          <p class="text-[14px] leading-[20px] text-[#71717a]">Daftar dosen pembimbing akademik dan riset yang ditugaskan mengampu program binaan ini.</p>
        </div>
        <button type="button" onclick="openAddDosenModal()" class="inline-flex items-center gap-2 px-4 py-2 bg-[#1063B9] hover:bg-[#0E4F96] text-white text-xs font-semibold rounded-lg shadow-2xs transition-all active:scale-[0.98]">
          <i data-lucide="user-plus" class="w-4 h-4"></i>
          <span>+ Tambah Dosen Pembina</span>
        </button>
      </div>

      <!-- Tabel Dosen Pembina -->
      <div class="bg-white border border-[#e4e4e7] rounded-[12px] shadow-2xs overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs border-collapse">
            <thead>
              <tr class="bg-gray-50 text-[11px] font-semibold text-[#71717a] uppercase tracking-wider border-b border-[#e4e4e7]">
                <th class="py-3 px-4">Dosen Pembimbing</th>
                <th class="py-3 px-4">NPP / NIDN</th>
                <th class="py-3 px-4">Bidang Kajian Utama</th>
                <th class="py-3 px-4">Alokasi Kuota Bimbingan</th>
                <th class="py-3 px-4">Status Pengampu</th>
                <th class="py-3 px-4 text-right">Aksi</th>
              </tr>
            </thead>
            <tbody id="dosenTableBody" class="divide-y divide-gray-100">
              <tr class="hover:bg-gray-50/70 transition-colors">
                <td class="py-3.5 px-4">
                  <div class="flex items-center gap-2.5">
                    <div class="w-8 h-8 rounded-full bg-primary-100 text-[#114D91] font-bold text-xs flex items-center justify-center shrink-0 border border-primary-200">
                      RA
                    </div>
                    <div>
                      <div class="font-medium text-[13px] text-[#09090b] leading-tight">Dr. Ricardus Anggi, M.Kom.</div>
                      <div class="text-[11px] text-[#71717a]">ricardus.anggi@dsn.dinus.ac.id</div>
                    </div>
                  </div>
                </td>
                <td class="py-3.5 px-4 text-xs text-[#71717a]">
                  0686.11.2001.289
                </td>
                <td class="py-3.5 px-4 text-gray-800">
                  Computer Vision &amp; Deep Learning
                </td>
                <td class="py-3.5 px-4">
                  <div class="flex items-center gap-2">
                    <span class="font-medium text-[#09090b]">4 / 6 Mahasiswa</span>
                    <span class="text-[10px] text-emerald-700 font-medium bg-emerald-50 px-1.5 py-0.5 rounded border border-emerald-200">Sisa 2</span>
                  </div>
                </td>
                <td class="py-3.5 px-4">
                  <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-emerald-50 text-emerald-700 border border-emerald-200">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Koordinator Lab
                  </span>
                </td>
                <td class="py-3.5 px-4 text-right">
                  <button type="button" onclick="showToast('Data Dosen', 'Membuka pengaturan bimbingan dosen')" class="px-2.5 py-1 text-xs text-[#1063B9] hover:bg-blue-50 rounded border border-blue-200 font-medium">
                    Kelola
                  </button>
                </td>
              </tr>

              <tr class="hover:bg-gray-50/70 transition-colors">
                <td class="py-3.5 px-4">
                  <div class="flex items-center gap-2.5">
                    <div class="w-8 h-8 rounded-full bg-primary-100 text-[#114D91] font-bold text-xs flex items-center justify-center shrink-0 border border-primary-200">
                      AK
                    </div>
                    <div>
                      <div class="font-medium text-[13px] text-[#09090b] leading-tight">Dr. Aris Kusumawati, M.Cs.</div>
                      <div class="text-[11px] text-[#71717a]">aris.kusumawati@dsn.dinus.ac.id</div>
                    </div>
                  </div>
                </td>
                <td class="py-3.5 px-4 text-xs text-[#71717a]">
                  0686.11.2005.312
                </td>
                <td class="py-3.5 px-4 text-gray-800">
                  Natural Language Processing &amp; Text Mining
                </td>
                <td class="py-3.5 px-4">
                  <div class="flex items-center gap-2">
                    <span class="font-medium text-[#09090b]">2 / 4 Mahasiswa</span>
                    <span class="text-[10px] text-emerald-700 font-medium bg-emerald-50 px-1.5 py-0.5 rounded border border-emerald-200">Sisa 2</span>
                  </div>
                </td>
                <td class="py-3.5 px-4">
                  <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-blue-50 text-blue-700 border border-blue-200">
                    <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span> Pembimbing Riset
                  </span>
                </td>
                <td class="py-3.5 px-4 text-right">
                  <button type="button" onclick="showToast('Data Dosen', 'Membuka pengaturan bimbingan dosen')" class="px-2.5 py-1 text-xs text-[#1063B9] hover:bg-blue-50 rounded border border-blue-200 font-medium">
                    Kelola
                  </button>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>
  </div>

  <script is:inline>
    function switchAnggotaTab(tab) {
      const mhsPanel = document.getElementById("view-mahasiswa");
      const dsnPanel = document.getElementById("view-dosen");
      const mhsBtn = document.getElementById("tab-btn-mahasiswa");
      const dsnBtn = document.getElementById("tab-btn-dosen");
      const navMhs = document.getElementById("nav-mahasiswa");
      const navDsn = document.getElementById("nav-dosen");

      if (tab === 'dosen') {
        if (mhsPanel) mhsPanel.classList.add("hidden");
        if (dsnPanel) dsnPanel.classList.remove("hidden");
        if (mhsBtn) {
          mhsBtn.className = "inline-flex items-center gap-2 px-4 py-2 text-xs font-medium rounded-lg text-gray-600 hover:text-gray-900 hover:bg-gray-100 transition-all";
        }
        if (dsnBtn) {
          dsnBtn.className = "inline-flex items-center gap-2 px-4 py-2 text-xs font-semibold rounded-lg bg-[#1063B9] text-white shadow-2xs transition-all";
        }
        if (navMhs) {
          navMhs.className = "nav-item relative flex items-center px-4 py-2 rounded-lg text-[13px] text-[#3f3f46] font-normal hover:bg-black/5 hover:text-[#09090b] transition-colors w-full text-left no-underline";
          navMhs.querySelector(".active-indicator")?.classList.add("hidden");
          const icon = navMhs.querySelector(".nav-icon");
          if (icon) {
            icon.classList.remove("text-[#0655a7]");
            icon.classList.add("text-[#71717a]");
          }
        }
        if (navDsn) {
          navDsn.className = "nav-item relative flex items-center px-4 py-2 rounded-lg text-[13px] text-[#0655a7] font-medium bg-transparent hover:bg-black/5 transition-colors w-full text-left no-underline";
          navDsn.querySelector(".active-indicator")?.classList.remove("hidden");
          const icon = navDsn.querySelector(".nav-icon");
          if (icon) {
            icon.classList.remove("text-[#71717a]");
            icon.classList.add("text-[#0655a7]");
          }
        }
        const badge = document.getElementById("breadcrumbBadge");
        if (badge) badge.textContent = "Anggota / Dosen Pembina";
        if (window.location.hash !== '#dosen') {
          history.replaceState(null, '', '#dosen');
        }
      } else {
        if (dsnPanel) dsnPanel.classList.add("hidden");
        if (mhsPanel) mhsPanel.classList.remove("hidden");
        if (dsnBtn) {
          dsnBtn.className = "inline-flex items-center gap-2 px-4 py-2 text-xs font-medium rounded-lg text-gray-600 hover:text-gray-900 hover:bg-gray-100 transition-all";
        }
        if (mhsBtn) {
          mhsBtn.className = "inline-flex items-center gap-2 px-4 py-2 text-xs font-semibold rounded-lg bg-[#1063B9] text-white shadow-2xs transition-all";
        }
        if (navDsn) {
          navDsn.className = "nav-item relative flex items-center px-4 py-2 rounded-lg text-[13px] text-[#3f3f46] font-normal hover:bg-black/5 hover:text-[#09090b] transition-colors w-full text-left no-underline";
          navDsn.querySelector(".active-indicator")?.classList.add("hidden");
          const icon = navDsn.querySelector(".nav-icon");
          if (icon) {
            icon.classList.remove("text-[#0655a7]");
            icon.classList.add("text-[#71717a]");
          }
        }
        if (navMhs) {
          navMhs.className = "nav-item relative flex items-center px-4 py-2 rounded-lg text-[13px] text-[#0655a7] font-medium bg-transparent hover:bg-black/5 transition-colors w-full text-left no-underline";
          navMhs.querySelector(".active-indicator")?.classList.remove("hidden");
          const icon = navMhs.querySelector(".nav-icon");
          if (icon) {
            icon.classList.remove("text-[#71717a]");
            icon.classList.add("text-[#0655a7]");
          }
        }
        const badge = document.getElementById("breadcrumbBadge");
        if (badge) badge.textContent = "Anggota / Mahasiswa Binaan";
        if (window.location.hash !== '#mahasiswa' && window.location.hash !== '') {
          history.replaceState(null, '', '#mahasiswa');
        }
      }
      if (typeof lucide !== 'undefined') lucide.createIcons();
    }

    function checkInitialTab() {
      if (window.location.hash === '#dosen') {
        switchAnggotaTab('dosen');
      } else {
        switchAnggotaTab('mahasiswa');
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener("DOMContentLoaded", checkInitialTab);
    } else {
      checkInitialTab();
    }

    window.addEventListener('hashchange', checkInitialTab);
  </script>
</MitraShell>
