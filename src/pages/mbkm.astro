---
// src/pages/mbkm.astro
import FtcNavbar from '../components/common/FtcNavbar.astro';
import FtcFooter from '../components/common/FtcFooter.astro';
import MbkmHero from '../components/mbkm/katalog/MbkmHero.astro';
import MbkmTypeFilter from '../components/mbkm/katalog/MbkmTypeFilter.astro';
import MbkmCardGrid from '../components/mbkm/katalog/MbkmCardGrid.astro';
import '../styles/global.css';
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Katalog Program Kampus Berdampak (MBKM) - FTC UDINUS</title>
    <link rel="icon" type="image/png" href="/assets/images/logo-dinus.png" />

    <!-- Google Fonts FTC v2: Poppins & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Poppins:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Tailwind CDN Browser Token Extension & Lucide Icons -->
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4" is:inline></script>
    <script src="https://unpkg.com/lucide@latest" is:inline></script>

    <style is:global>
      body {
        font-family: 'Poppins', sans-serif;
      }
      .font-mono {
        font-family: 'JetBrains Mono', monospace;
      }

      /* Split-badge utility FTC v2 */
      .split-badge {
        display: inline-flex;
        align-items: center;
        border-radius: 0.5rem;
        overflow: hidden;
        box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
        max-width: 100%;
      }
      .split-badge-left {
        background-color: #f5a623;
        color: #072f57;
        font-weight: 800;
        font-size: 0.75rem;
        line-height: 1rem;
        padding: 0.375rem 0.625rem;
        flex-shrink: 0;
        letter-spacing: 0.05em;
      }
      .split-badge-right {
        background-color: #0b4d8c;
        color: #ffffff;
        font-weight: 600;
        font-size: 0.75rem;
        line-height: 1rem;
        padding: 0.375rem 0.875rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        flex-shrink: 0;
      }

      /* Card selection state */
      .program-card.is-selected {
        border-color: #0b4d8c !important;
        box-shadow: 0 0 0 2px rgba(11, 77, 140, 0.25), 0 4px 6px -1px rgba(0, 0, 0, 0.1) !important;
      }
    </style>
  </head>
  <body class="min-h-screen flex flex-col bg-slate-50 text-slate-800 antialiased selection:bg-amber-100 selection:text-amber-900">
    <FtcNavbar activeNav="mbkm" />

    <main class="flex-1 w-full">
      <MbkmHero />

      <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
        <MbkmTypeFilter />
        <MbkmCardGrid />
      </section>
    </main>

    <FtcFooter />
  </body>
</html>
