---
// src/pages/pendaftaran-mahasiswa.astro
import RegistrationStepper from '../components/mbkm/pendaftaran/RegistrationStepper.astro';
import StepIdentitas from '../components/mbkm/pendaftaran/StepIdentitas.astro';
import StepDokumen from '../components/mbkm/pendaftaran/StepDokumen.astro';
import StepKonfirmasi from '../components/mbkm/pendaftaran/StepKonfirmasi.astro';
import DetailFooter from '../components/mbkm/detail/DetailFooter.astro';
---

<!doctype html>
<html lang="id" class="h-full scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pendaftaran MBKM — FIK UDINUS</title>
    <meta name="description" content="Formulir pendaftaran MBKM FIK UDINUS dengan tiga tahap mandatori." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <script is:inline>
      tailwind.config = { theme: { extend: {
        fontFamily: { sans: ["Inter", "system-ui", "-apple-system", "sans-serif"] },
        colors: {
          primary: { 50: "#F1F7FE", 100: "#E2EEFC", 200: "#BFDBF8", 300: "#86BEF3", 400: "#1E7FD9", 500: "#1E7FD9", 600: "#1063B9", 700: "#114D91", 800: "#10447C", 900: "#133A67", 950: "#0D2544" },
          secondary: { 50: "#FEFAEC", 100: "#FCEEC9", 200: "#F8DB8F", 300: "#F4BD45", 400: "#F2AB2D", 500: "#F3BC45" }
        }
      } } };
    </script>
    <script is:inline src="https://unpkg.com/lucide@latest"></script>
    <style is:global>
      body { font-family: Inter, system-ui, sans-serif; }
      .focus-ring:focus-visible { outline: 2px solid #1e7fd9; outline-offset: 2px; }
      .step-indicator { transition: all 0.2s ease; color: #6b7280; cursor: pointer; }
      .step-indicator .step-number { border: 4px solid #fff; background-color: #f3f4f6; color: #6b7280; transition: all 0.25s ease; }
      .step-indicator.active, .step-indicator.completed { color: #114d91; }
      .step-indicator.active .step-number, .step-indicator.completed .step-number { background-color: #1063b9; color: #fff; box-shadow: 0 0 0 3px #bfdbfe; }
    </style>
  </head>
  <body class="min-h-screen flex flex-col bg-gray-50 text-gray-900 antialiased">
    <section class="bg-gradient-to-br from-[#0D2544] via-[#114D91] to-[#1063B9] text-white">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-9 sm:py-12 text-center">
        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight">Formulir Pendaftaran</h1>
        <p class="mt-4 max-w-2xl mx-auto text-sm sm:text-base leading-7 text-blue-100">
          Lengkapi tiga tahap pendaftaran secara berurutan, mulai dari data akademik, pengumpulan portofolio, hingga persetujuan program.
        </p>
      </div>
    </section>
    <main class="flex-1 w-full max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="mb-4">
        <a href="/detail-mbkm" class="focus-ring inline-flex items-center gap-2 text-sm font-semibold text-gray-600 hover:text-primary-700 transition-colors group">
          <i data-lucide="arrow-left" class="w-4 h-4 text-gray-400 group-hover:text-primary-700 group-hover:-translate-x-0.5 transition-all"></i>
          <span>Kembali ke Detail Program</span>
        </a>
      </div>
      <RegistrationStepper>
        <StepIdentitas />
        <StepDokumen />
        <StepKonfirmasi />
      </RegistrationStepper>
    </main>
    <DetailFooter />
  </body>
</html>
