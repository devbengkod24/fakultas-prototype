    <script is:inline>
      document.addEventListener("DOMContentLoaded", () => {
        // ------------------------------------------------
        // Daftar input dokumen Tahap 2 (dirender dinamis)
        // ------------------------------------------------
        const DOCUMENT_FIELDS = [
          {
            id: "cv-url",
            name: "cvUrl",
            icon: "file-text",
            label: "CV ATS (PDF)",
            hint: "Tautan Google Drive yang mengarah langsung ke file CV ATS dalam format PDF.",
            placeholder: "https://drive.google.com/file/d/...",
          },
          {
            id: "portfolio-url",
            name: "portfolioUrl",
            icon: "briefcase-business",
            label: "Portofolio",
            hint: "Tautan portofolio sesuai platform tempat karya dipublikasikan, misalnya GitHub, Behance, Figma, atau website pribadi.",
            placeholder: "https://github.com/username atau https://behance.net/username",
          },
          {
            id: "certificate-url",
            name: "certificateUrl",
            icon: "award",
            label: "Sertifikat / Bukti Pengalaman",
            hint: "Tautan Google Drive yang mengarah langsung ke file sertifikat atau bukti pengalaman.",
            placeholder: "https://drive.google.com/file/d/...",
          },
        ];

        const documentInputs = document.getElementById("document-inputs");

        function renderDocumentInputs() {
          documentInputs.innerHTML = DOCUMENT_FIELDS.map(
            (field, index) => `
            <div class="rounded-xl border border-gray-200 p-5">
              <div class="flex items-start gap-3">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-primary-50 text-primary-700">
                  <i data-lucide="${field.icon}" class="h-5 w-5"></i>
                </div>
                <div class="min-w-0 flex-1">
                  <label for="${field.id}" class="block text-sm font-semibold text-gray-900">
                    ${index + 1}. ${field.label}
                  </label>
                  <p class="mt-1 text-sm leading-6 text-gray-500">${field.hint}</p>
                  <input
                    id="${field.id}"
                    name="${field.name}"
                    type="url"
                    inputmode="url"
                    placeholder="${field.placeholder}"
                    class="mt-3 w-full rounded-lg border border-gray-300 bg-white px-3.5 py-3 text-sm"
                  />
                </div>
              </div>
            </div>`,
          ).join("");

          if (window.lucide) lucide.createIcons();
        }

        // ------------------------------------------------
        // Elemen umum
        // ------------------------------------------------
        const form = document.getElementById("registration-form");
        const stepSections = [
          document.getElementById("step-1"),
          document.getElementById("step-2"),
          document.getElementById("step-3"),
        ];
        const stepButtons = [...document.querySelectorAll("[data-step]")];
        const progressLabel = document.getElementById("progress-label");
        const progressBar = document.getElementById("progress-bar");
        const prevButton = document.getElementById("prev-button");
        const nextButton = document.getElementById("next-button");
        const nextLabel = document.getElementById("next-label");
        const submitButton = document.getElementById("submit-button");
        const successScreen = document.getElementById("success-screen");
        const registrationPanel = document.getElementById("registration-panel");
        const formNavigation = document.getElementById("form-navigation");

        const studentName = document.getElementById("student-name");
        const studentNim = document.getElementById("student-nim");

        let currentStep = 1;

        // ------------------------------------------------
        // Navigasi tahap (tanpa validasi)
        // ------------------------------------------------
        function updateNavigation() {
          stepSections.forEach((section, index) => {
            section.hidden = index + 1 !== currentStep;
          });

          stepButtons.forEach((button, index) => {
            const step = index + 1;
            const circle = button.querySelector(".step-number");

            button.classList.toggle("active", step === currentStep);
            button.classList.toggle("completed", step < currentStep);
            circle.textContent = step < currentStep ? "✓" : String(step);

            if (step === currentStep) {
              button.setAttribute("aria-current", "step");
            } else {
              button.removeAttribute("aria-current");
            }
          });

          progressLabel.textContent = `Tahap ${currentStep} dari 3`;
          progressBar.style.width = `${(currentStep / 3) * 100}%`;

          prevButton.classList.toggle("invisible", currentStep === 1);
          prevButton.disabled = currentStep === 1;

          nextButton.classList.toggle("hidden", currentStep === 3);
          nextLabel.textContent = `Lanjut ke Tahap ${currentStep + 1}`;

          submitButton.classList.toggle("hidden", currentStep !== 3);
          submitButton.classList.toggle("inline-flex", currentStep === 3);
        }

        function goToStep(step) {
          if (step < 1 || step > 3) return;
          currentStep = step;
          updateNavigation();
          window.scrollTo({ top: 0, behavior: "smooth" });
        }

        stepButtons.forEach((button) => {
          button.addEventListener("click", () => goToStep(Number(button.dataset.step)));
        });
        nextButton.addEventListener("click", () => goToStep(currentStep + 1));
        prevButton.addEventListener("click", () => goToStep(currentStep - 1));

        // ------------------------------------------------
        // Submit (simulasi, tanpa validasi)
        // ------------------------------------------------
        form.addEventListener("submit", (event) => {
          event.preventDefault();

          document.getElementById("success-name").textContent =
            studentName.value.trim() || "-";
          document.getElementById("success-nim").textContent =
            studentNim.value.trim() || "-";

          form.hidden = true;
          registrationPanel.hidden = true;
          formNavigation.hidden = true;
          successScreen.hidden = false;

          if (window.lucide) lucide.createIcons();
          window.scrollTo({ top: 0, behavior: "smooth" });
        });

        document.getElementById("restart-button").addEventListener("click", () => {
          form.reset();

          form.hidden = false;
          registrationPanel.hidden = false;
          formNavigation.hidden = false;
          successScreen.hidden = true;

          goToStep(1);
        });

        // ------------------------------------------------
        // Inisialisasi
        // ------------------------------------------------
        renderDocumentInputs();
        updateNavigation();
        if (window.lucide) lucide.createIcons();
      });
    </script>
  </body>
</html>