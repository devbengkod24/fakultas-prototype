<!doctype html>
<html lang="id" class="h-full scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Pendaftaran MBKM — FIK UDINUS</title>
    <meta
      name="description"
      content="Formulir pendaftaran MBKM FIK UDINUS dengan tiga tahap mandatori."
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
    />

    <!-- Tailwind CSS CDN (v3) -->
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <script is:inline>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              sans: ["Inter", "system-ui", "-apple-system", "sans-serif"],
            },
            colors: {
              primary: {
                50: "#F1F7FE",
                100: "#E2EEFC",
                200: "#BFDBF8",
                300: "#86BEF3",
                400: "#1E7FD9",
                500: "#1E7FD9",
                600: "#1063B9",
                700: "#114D91",
                800: "#10447C",
                900: "#133A67",
                950: "#0D2544",
              },
              secondary: {
                50: "#FEFAEC",
                100: "#FCEEC9",
                200: "#F8DB8F",
                300: "#F4BD45",
                400: "#F2AB2D",
                500: "#F3BC45",
              },
            },
          },
        },
      };
    </script>

    <!-- Lucide Icons CDN -->
    <script is:inline src="https://unpkg.com/lucide@latest"></script>

    <style is:global>
      body {
        font-family: Inter, system-ui, sans-serif;
      }
      .focus-ring:focus-visible {
        outline: 2px solid #1e7fd9;
        outline-offset: 2px;
      }
      .step-indicator {
        transition: all 0.2s ease;
        color: #6b7280;
        cursor: pointer;
      }
      .step-indicator .step-number {
        border: 4px solid #fff;
        background-color: #f3f4f6;
        color: #6b7280;
        transition: all 0.25s ease;
      }
      /* Status aktif atau sudah lewat (selesai) dua-duanya konsisten biru */
      .step-indicator.active,
      .step-indicator.completed {
        color: #114d91;
      }
      .step-indicator.active .step-number,
      .step-indicator.completed .step-number {
        background-color: #1063b9;
        color: #fff;
        box-shadow: 0 0 0 3px #bfdbfe;
      }
    </style>
  </head>

  <body class="min-h-screen flex flex-col bg-gray-50 text-gray-900 antialiased">
    <section
      class="bg-gradient-to-br from-[#0D2544] via-[#114D91] to-[#1063B9] text-white"
    >
      <div
        class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-9 sm:py-12 text-center"
      >
        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight">
          Formulir Pendaftaran
        </h1>

        <p
          class="mt-4 max-w-2xl mx-auto text-sm sm:text-base leading-7 text-blue-100"
        >
          Lengkapi tiga tahap pendaftaran secara berurutan, mulai dari data
          akademik, pengumpulan portofolio, hingga persetujuan program.
        </p>
      </div>
    </section>

    <main class="flex-1 w-full max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <!-- Tombol Kembali ke Detail Program (Opsi C: di atas Stepper) -->
      <div class="mb-4">
        <a
          href="/detail-mbkm"
          class="focus-ring inline-flex items-center gap-2 text-sm font-semibold text-gray-600 hover:text-primary-700 transition-colors group"
        >
          <i
            data-lucide="arrow-left"
            class="w-4 h-4 text-gray-400 group-hover:text-primary-700 group-hover:-translate-x-0.5 transition-all"
          ></i>
          <span>Kembali ke Detail Program</span>
        </a>
      </div>

      <section
        id="registration-panel"
        class="rounded-xl border border-gray-200 bg-white p-5 sm:p-7"
      >
        <div class="relative mx-auto max-w-2xl py-1">
          <!-- Connecting Progress Track running behind the nodes -->
          <div
            class="absolute left-[16.66%] right-[16.66%] top-5 -translate-y-1/2 h-1 bg-gray-200 rounded-full"
            aria-hidden="true"
          >
            <!-- Progress Fill Bar -->
            <div
              id="progress-bar"
              class="h-full bg-primary-600 rounded-full transition-all duration-300 ease-out"
              style="width: 0%"
            >
            </div>
          </div>

          <!-- Step Buttons Grid (Centered, 3 columns) -->
          <div class="relative z-10 grid grid-cols-3">
            <button
              type="button"
              data-step="1"
              class="step-indicator active focus-ring group flex flex-col items-center text-center"
              aria-current="step"
            >
              <span
                class="step-number flex h-10 w-10 items-center justify-center rounded-full text-sm font-bold shadow-xs"
              >
                1
              </span>
              <span class="mt-2 text-xs sm:text-sm font-semibold leading-5">
                Identitas
              </span>
            </button>

            <button
              type="button"
              data-step="2"
              class="step-indicator focus-ring group flex flex-col items-center text-center"
            >
              <span
                class="step-number flex h-10 w-10 items-center justify-center rounded-full text-sm font-bold shadow-xs"
              >
                2
              </span>
              <span class="mt-2 text-xs sm:text-sm font-semibold leading-5">
                Dokumen
              </span>
            </button>

            <button
              type="button"
              data-step="3"
              class="step-indicator focus-ring group flex flex-col items-center text-center"
            >
              <span
                class="step-number flex h-10 w-10 items-center justify-center rounded-full text-sm font-bold shadow-xs"
              >
                3
              </span>
              <span class="mt-2 text-xs sm:text-sm font-semibold leading-5">
                Persetujuan
              </span>
            </button>
          </div>
        </div>
      </section>

      <form id="registration-form" class="mt-6 space-y-6" novalidate>
        <!-- ========================================== -->
        <!-- TAHAP 1: IDENTITAS & DATA STUDI            -->
        <!-- ========================================== -->
        <section id="step-1" class="step-content space-y-6">
          <!-- KELOMPOK 1: IDENTITAS MAHASISWA -->
          <div class="rounded-xl border border-gray-200 bg-white p-5 sm:p-7">
            <!-- Header section -->
            <div class="border-b border-gray-100 pb-4">
              <h3 class="text-lg font-bold text-gray-900">
                Identitas Mahasiswa
              </h3>
              <p class="mt-1 text-sm text-gray-500">
                Lengkapi data diri mahasiswa.
              </p>
            </div>

            <!-- Grid 4 Fields: Nama, NIM, Email, No. Telepon -->
            <div class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2">
              <div>
                <label
                  for="student-name"
                  class="mb-2 block text-sm font-semibold text-gray-700"
                >
                  Nama Lengkap
                </label>
                <input
                  id="student-name"
                  name="studentName"
                  type="text"
                  value="Faisal Rahman"
                  readonly
                  tabindex="-1"
                  aria-readonly="true"
                  class="w-full cursor-not-allowed rounded-lg border border-gray-200 bg-gray-50 px-3.5 py-3 text-sm font-medium text-gray-800 focus:outline-none"
                />
              </div>

              <div>
                <label
                  for="student-nim"
                  class="mb-2 block text-sm font-semibold text-gray-700"
                >
                  NIM
                </label>
                <input
                  id="student-nim"
                  name="nim"
                  type="text"
                  value="A11.2022.13901"
                  readonly
                  tabindex="-1"
                  aria-readonly="true"
                  class="w-full cursor-not-allowed rounded-lg border border-gray-200 bg-gray-50 px-3.5 py-3 text-sm font-medium text-gray-800 focus:outline-none"
                />
              </div>

              <div>
                <label
                  for="student-email"
                  class="mb-2 block text-sm font-semibold text-gray-700"
                >
                  Email Mahasiswa
                </label>
                <input
                  id="student-email"
                  name="email"
                  type="email"
                  value="111202213901@mhs.dinus.ac.id"
                  readonly
                  tabindex="-1"
                  aria-readonly="true"
                  class="w-full cursor-not-allowed rounded-lg border border-gray-200 bg-gray-50 px-3.5 py-3 text-sm font-medium text-gray-800 focus:outline-none"
                />
              </div>

              <div>
                <label
                  for="student-phone"
                  class="mb-2 block text-sm font-semibold text-gray-700"
                >
                  Nomor Telepon / WhatsApp
                </label>
                <input
                  id="student-phone"
                  name="phone"
                  type="tel"
                  inputmode="tel"
                  value="081234567890"
                  placeholder="Contoh: 081234567890"
                  class="w-full rounded-lg border border-gray-300 bg-white px-3.5 py-3 text-sm font-medium text-gray-900 transition focus:border-primary-600 focus:outline-none focus:ring-4 focus:ring-primary-100"
                />
              </div>
            </div>
          </div>

          <!-- KELOMPOK 2: DATA STUDI -->
          <div class="rounded-xl border border-gray-200 bg-white p-5 sm:p-7">
            <!-- Header section -->
            <div class="border-b border-gray-100 pb-4">
              <h3 class="text-lg font-bold text-gray-900">
                Data Studi
              </h3>
              <p class="mt-1 text-sm text-gray-500">
                Lengkapi data akademik mahasiswa
              </p>
            </div>

            <!-- Grid 4 Fields: Program Studi, Semester, IPK, SKS -->
            <div class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2">
              <div>
                <label
                  for="student-study"
                  class="mb-2 block text-sm font-semibold text-gray-700"
                >
                  Program Studi
                </label>
                <input
                  id="student-study"
                  name="studyProgram"
                  type="text"
                  value="Teknik Informatika - S1"
                  readonly
                  tabindex="-1"
                  aria-readonly="true"
                  class="w-full cursor-not-allowed rounded-lg border border-gray-200 bg-gray-50 px-3.5 py-3 text-sm font-medium text-gray-800 focus:outline-none"
                />
              </div>

              <div>
                <label
                  for="student-semester"
                  class="mb-2 block text-sm font-semibold text-gray-700"
                >
                  Semester Aktif
                </label>
                <input
                  id="student-semester"
                  name="semester"
                  type="text"
                  value="Semester 5"
                  readonly
                  tabindex="-1"
                  aria-readonly="true"
                  class="w-full cursor-not-allowed rounded-lg border border-gray-200 bg-gray-50 px-3.5 py-3 text-sm font-medium text-gray-800 focus:outline-none"
                />
              </div>

              <div>
                <label
                  for="student-ipk"
                  class="mb-2 block text-sm font-semibold text-gray-700"
                >
                  IPK Kumulatif
                </label>
                <input
                  id="student-ipk"
                  name="ipk"
                  type="text"
                  value="3.68"
                  readonly
                  tabindex="-1"
                  aria-readonly="true"
                  class="w-full cursor-not-allowed rounded-lg border border-gray-200 bg-gray-50 px-3.5 py-3 text-sm font-medium text-gray-800 focus:outline-none"
                />
              </div>

              <div>
                <label
                  for="student-sks"
                  class="mb-2 block text-sm font-semibold text-gray-700"
                >
                  SKS Tempuh
                </label>
                <input
                  id="student-sks"
                  name="sks"
                  type="text"
                  value="92 SKS"
                  readonly
                  tabindex="-1"
                  aria-readonly="true"
                  class="w-full cursor-not-allowed rounded-lg border border-gray-200 bg-gray-50 px-3.5 py-3 text-sm font-medium text-gray-800 focus:outline-none"
                />
              </div>
            </div>
          </div>
        </section>

        <!-- ========================================== -->
        <!-- TAHAP 2: BERKAS & DOKUMEN PENDUKUNG        -->
        <!-- ========================================== -->
        <section id="step-2" class="step-content space-y-6">
          <div class="rounded-xl border border-gray-200 bg-white p-5 sm:p-7">
            <!-- Header section persis seperti Tahap 1 -->
            <div class="border-b border-gray-100 pb-4">
              <h3 class="text-lg font-bold text-gray-900">
                Dokumen Pendaftaran
              </h3>
              <p class="mt-1 text-sm text-gray-500">
                Cantumkan tautan dokumen untuk proses pendaftaran. Pastikan akses tautan diatur ke publik.
              </p>
            </div>

            <!-- Form Berkas Utama -->
            <div class="mt-6 space-y-5">
              <!-- Dokumen 1: CV ATS (PDF) -->
              <div>
                <label
                  for="cv-url"
                  class="mb-2 block text-sm font-semibold text-gray-700"
                >
                  CV<span class="text-rose-500">*</span>
                </label>
                <input
                  id="cv-url"
                  name="cvUrl"
                  type="url"
                  inputmode="url"
                  placeholder="https://drive.google.com/file/d/..."
                  class="w-full rounded-lg border border-gray-300 bg-white px-3.5 py-3 text-sm font-medium text-gray-900 transition focus:border-primary-600 focus:outline-none focus:ring-4 focus:ring-primary-100"
                />
              </div>

              <!-- Dokumen 2: Portofolio -->
              <div>
                <label
                  for="portfolio-url"
                  class="mb-2 block text-sm font-semibold text-gray-700"
                >
                  Portofolio <span class="text-rose-500">*</span>
                </label>
                <input
                  id="portfolio-url"
                  name="portfolioUrl"
                  type="url"
                  inputmode="url"
                  placeholder="https://github.com/username atau https://behance.net/username"
                  class="w-full rounded-lg border border-gray-300 bg-white px-3.5 py-3 text-sm font-medium text-gray-900 transition focus:border-primary-600 focus:outline-none focus:ring-4 focus:ring-primary-100"
                />
              </div>

              <!-- Dokumen 3: Sertifikat / Bukti Pengalaman -->
              <div>
                <label
                  for="certificate-url"
                  class="mb-2 block text-sm font-semibold text-gray-700"
                >
                  Sertifikat<span class="text-rose-500">*</span>
                </label>
                <input
                  id="certificate-url"
                  name="certificateUrl"
                  type="url"
                  inputmode="url"
                  placeholder="https://drive.google.com/file/d/..."
                  class="w-full rounded-lg border border-gray-300 bg-white px-3.5 py-3 text-sm font-medium text-gray-900 transition focus:border-primary-600 focus:outline-none focus:ring-4 focus:ring-primary-100"
                />
              </div>

              <!-- Container untuk Lampiran Tambahan Dinamis (Lampiran 1 s.d. 3) -->
              <div id="additional-attachments" class="hidden space-y-5"></div>

              <!-- Tombol Tambahkan Lampiran -->
              <div>
                <button
                  type="button"
                  id="add-attachment-btn"
                  class="focus-ring inline-flex items-center gap-2 rounded-lg border border-dashed border-gray-300 bg-gray-50 hover:border-primary-400 hover:bg-primary-50/50 hover:text-primary-700 px-4 py-2 text-sm font-semibold text-gray-700 transition cursor-pointer"
                >
                  <i data-lucide="plus" class="w-4 h-4"></i>
                  <span>Tambah Lampiran</span>
                </button>
              </div>
            </div>
          </div>
        </section>

        <!-- ========================================== -->
        <!-- TAHAP 3: PERSETUJUAN PROGRAM               -->
        <!-- ========================================== -->
        <section id="step-3" class="step-content space-y-6">
          <div class="rounded-xl border border-gray-200 bg-white p-5 sm:p-7">
            <!-- Header section persis seperti Tahap 1 & 2 -->
            <div class="border-b border-gray-100 pb-4">
              <h3 class="text-lg font-bold text-gray-900">
                Persetujuan Program
              </h3>
              <p class="mt-1 text-sm text-gray-500">
                Centang seluruh pernyataan berikut untuk menyelesaikan pengajuan pendaftaran.
              </p>
            </div>

            <div class="mt-6 space-y-4">
              <label
                class="flex items-start gap-3 rounded-lg border border-gray-200 p-4 cursor-pointer hover:bg-gray-50 has-[:checked]:border-primary-600 has-[:checked]:bg-primary-50"
              >
                <input
                  id="agree-rights"
                  name="agreeRights"
                  type="checkbox"
                  class="mt-1 h-5 w-5 shrink-0 rounded border-gray-300 text-primary-600 focus:ring-primary-600"
                />
                <span class="flex-1">
                  <span class="block text-sm font-semibold text-gray-900">
                    Saya menyetujui ketentuan program
                  </span>
                  <span class="mt-1 block text-xs leading-5 text-gray-500">
                    Saya telah membaca dan memahami hak mahasiswa serta aturan
                    pelaksanaan program.
                  </span>
                </span>
              </label>

              <label
                class="flex items-start gap-3 rounded-lg border border-gray-200 p-4 cursor-pointer hover:bg-gray-50 has-[:checked]:border-primary-600 has-[:checked]:bg-primary-50"
              >
                <input
                  id="agree-obligations"
                  name="agreeObligations"
                  type="checkbox"
                  class="mt-1 h-5 w-5 shrink-0 rounded border-gray-300 text-primary-600 focus:ring-primary-600"
                />
                <span class="flex-1">
                  <span class="block text-sm font-semibold text-gray-900">
                    Saya bersedia memenuhi kewajiban program
                  </span>
                  <span class="mt-1 block text-xs leading-5 text-gray-500">
                    Saya bersedia mengikuti kegiatan, mematuhi peraturan program
                    dan kontributor, menjaga etika, serta menyelesaikan laporan dan
                    luaran sesuai ketentuan.
                  </span>
                </span>
              </label>

              <label
                class="flex items-start gap-3 rounded-lg border border-gray-200 p-4 cursor-pointer hover:bg-gray-50 has-[:checked]:border-primary-600 has-[:checked]:bg-primary-50"
              >
                <input
                  id="agree-data"
                  name="agreeData"
                  type="checkbox"
                  class="mt-1 h-5 w-5 shrink-0 rounded border-gray-300 text-primary-600 focus:ring-primary-600"
                />
                <span class="flex-1">
                  <span class="block text-sm font-semibold text-gray-900">
                    Saya menyatakan data dan dokumen yang diberikan benar
                  </span>
                  <span class="mt-1 block text-xs leading-5 text-gray-500">
                    Saya memahami bahwa data yang tidak sesuai dapat memengaruhi
                    proses verifikasi pengajuan.
                  </span>
                </span>
              </label>
            </div>
          </div>
        </section>

        <!-- NAVIGATION BUTTONS -->
        <div
          id="form-navigation"
          class="flex flex-col-reverse sm:flex-row sm:items-center sm:justify-end gap-3"
        >
          <button
            id="prev-button"
            type="button"
            class="focus-ring hidden items-center justify-center gap-2 rounded-lg border border-gray-300 bg-white px-5 py-3 text-sm font-semibold text-gray-700 hover:bg-gray-50"
          >
            <i data-lucide="arrow-left" class="w-4 h-4"></i>
            Kembali
          </button>

          <button
            id="next-button"
            type="button"
            class="focus-ring inline-flex items-center justify-center gap-2 rounded-lg bg-primary-600 px-5 py-3 text-sm font-semibold text-white hover:bg-primary-700"
          >
            <span id="next-label">Berikutnya</span>
            <i data-lucide="arrow-right" class="w-4 h-4"></i>
          </button>

          <button
            id="submit-button"
            type="submit"
            class="focus-ring hidden items-center justify-center gap-2 rounded-lg bg-primary-600 px-5 py-3 text-sm font-semibold text-white hover:bg-primary-700"
          >
            <i data-lucide="send" class="w-4 h-4"></i>
            Kirim Pengajuan
          </button>
        </div>
      </form>

      <!-- SUCCESS SCREEN -->
      <section
        id="success-screen"
        hidden
        class="rounded-xl border border-gray-200 bg-white p-6 sm:p-10 text-center"
      >
        <div
          class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-amber-100 text-amber-700"
        >
          <i data-lucide="check-circle-2" class="h-9 w-9"></i>
        </div>

        <span
          class="mt-5 inline-flex rounded-full bg-amber-50 px-3 py-1.5 text-xs font-bold text-amber-800"
        >
          SIMULASI BERHASIL
        </span>

        <h2 class="mt-4 text-2xl font-extrabold text-gray-900">
          Alur Pengajuan Selesai Diuji
        </h2>

        <p class="mx-auto mt-3 max-w-xl text-sm leading-7 text-gray-600">
          Seluruh tahap pada prototipe telah dilalui. Tidak ada data yang
          dikirim ke server. Integrasi backend diperlukan agar pengajuan
          memperoleh nomor registrasi dan masuk ke proses seleksi.
        </p>

        <div
          class="mx-auto mt-7 max-w-xl rounded-xl border border-gray-200 bg-gray-50 p-5 text-left"
        >
          <h3 class="font-bold text-gray-900">Ringkasan simulasi</h3>

          <dl class="mt-4 space-y-3 text-sm">
            <div class="flex justify-between gap-4">
              <dt class="text-gray-500">Nama</dt>
              <dd
                id="success-name"
                class="text-right font-semibold text-gray-900"
              >
              </dd>
            </div>
            <div class="flex justify-between gap-4">
              <dt class="text-gray-500">NIM</dt>
              <dd
                id="success-nim"
                class="text-right font-semibold text-gray-900"
              >
              </dd>
            </div>
          </dl>
        </div>

        <div class="mt-7 flex flex-col sm:flex-row justify-center gap-3">
          <button
            id="restart-button"
            type="button"
            class="focus-ring inline-flex items-center justify-center gap-2 rounded-lg bg-primary-600 px-5 py-3 text-sm font-semibold text-white hover:bg-primary-700"
          >
            <i data-lucide="rotate-ccw" class="w-4 h-4"></i>
            Ulangi Simulasi
          </button>

          <a
            href="/detail-mbkm"
            class="focus-ring inline-flex items-center justify-center gap-2 rounded-lg border border-gray-300 bg-white px-5 py-3 text-sm font-semibold text-gray-700 hover:bg-gray-50"
          >
            Kembali ke Detail Program
          </a>
        </div>
      </section>
    </main>

    <footer
      class="w-full max-w-full overflow-x-hidden bg-[linear-gradient(105.661deg,#114D91_0%,#1E7FD9_100%)] text-white"
    >
      <div
        class="w-full max-w-[1920px] mx-auto px-5 sm:px-8 lg:px-10 xl:px-16 2xl:px-24"
      >
        <!-- Footer main -->
        <div
          class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-[1.15fr_1.15fr_1fr_1fr] gap-8 xl:gap-10 py-10 xl:py-12"
        >
          <!-- Identitas & Kontak -->
          <div class="min-w-0">
            <div class="flex items-center gap-3">
              <img
                src="/assets/images/logo-dinus.png"
                alt="Logo Universitas Dian Nuswantoro"
                class="w-14 h-14 shrink-0 object-contain"
              />
              <div
                class="flex flex-col leading-[1.15] font-extrabold tracking-[0.3px] text-white text-[14px]"
              >
                <span>UNIVERSITAS</span>
                <span>DIAN NUSWANTORO</span>
              </div>
            </div>

            <p
