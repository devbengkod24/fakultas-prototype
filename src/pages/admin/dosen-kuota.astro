---
// src/pages/admin/dosen-kuota.astro
import AdminShell from "../../layouts/AdminShell.astro";
---

<AdminShell currentTab="dosen-kuota">
  <section
    id="section-dosen-kuota"
    class="flex flex-col flex-1 min-h-0 gap-4 pr-1 overflow-y-auto tab-content"
    x-data="{
      searchQuery: '',
      prodiFilter: 'semua',
      statusFilter: 'semua',
      isEditModalOpen: false,
      currentDosen: { nama: '', nidn: '', prodi: '', terpakai: 0, batasMaks: 8 },
      editBatasInput: 8,
      dosenList: [
        { id: 1, nama: 'Dr. M. Arief Soeleman, M.Kom', nidn: '0612047801', prodi: 'Teknik Informatika', terpakai: 6, batasMaks: 8 },
        { id: 2, nama: 'Affandy, Ph.D', nidn: '0617087502', prodi: 'Teknik Informatika', terpakai: 8, batasMaks: 8 },
        { id: 3, nama: 'Christy Atika Sari, M.Kom', nidn: '0629038401', prodi: 'Sistem Informasi', terpakai: 4, batasMaks: 8 },
        { id: 4, nama: 'Eko Hari Rachmawanto, M.Kom', nidn: '0601058201', prodi: 'Teknik Informatika', terpakai: 5, batasMaks: 8 },
        { id: 5, nama: 'Ajib Susanto, M.Kom', nidn: '0627047701', prodi: 'Sistem Informasi', terpakai: 7, batasMaks: 10 },
        { id: 6, nama: 'Dr. Guruh Fajar Shidik, S.Kom., M.Cs', nidn: '0619078301', prodi: 'Teknik Informatika', terpakai: 3, batasMaks: 8 },
        { id: 7, nama: 'Heru Agus Santoso, Ph.D', nidn: '0605087101', prodi: 'Sains Data', terpakai: 2, batasMaks: 6 },
      ],
      openModalEdit(dosen) {
        this.currentDosen = dosen;
        this.editBatasInput = dosen.batasMaks;
        this.isEditModalOpen = true;
      },
      saveKuota() {
        const val = parseInt(this.editBatasInput);
        if (isNaN(val) || val < 0) {
          alert('Batas maksimal kuota tidak valid!');
          return;
        }
        this.currentDosen.batasMaks = val;
        this.isEditModalOpen = false;
      },
      getProgress(d) {
        if (!d.batasMaks || d.batasMaks === 0) return 0;
        return Math.min(100, Math.round((d.terpakai / d.batasMaks) * 100));
      },
      getSisaSlot(d) {
        return Math.max(0, d.batasMaks - d.terpakai);
      },
      getStatus(d) {
        const progress = this.getProgress(d);
        if (progress >= 100) return 'penuh';
        if (progress >= 60) return 'waspada';
        return 'aman';
      },
      get filteredDosen() {
        return this.dosenList.filter(d => {
          const matchSearch = d.nama.toLowerCase().includes(this.searchQuery.toLowerCase()) ||
                              d.nidn.includes(this.searchQuery) ||
                              d.prodi.toLowerCase().includes(this.searchQuery.toLowerCase());
          const matchProdi = this.prodiFilter === 'semua' || d.prodi === this.prodiFilter;
          const status = this.getStatus(d);
          const matchStatus = this.statusFilter === 'semua' || status === this.statusFilter;
          return matchSearch && matchProdi && matchStatus;
        });
      },
      get totalTerpakai() {
        return this.dosenList.reduce((acc, d) => acc + d.terpakai, 0);
      },
      get countAman() {
        return this.dosenList.filter(d => this.getStatus(d) === 'aman').length;
      },
      get countWaspada() {
        return this.dosenList.filter(d => this.getStatus(d) === 'waspada').length;
      },
      get countPenuh() {
        return this.dosenList.filter(d => this.getStatus(d) === 'penuh').length;
      }
    }"
  >
    <!-- Quick Info / Stat Cards Kuota Style KP -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
      <div class="p-3 bg-white border border-[#e4e4e7] rounded-xl flex items-center gap-3">
        <div class="w-8 h-8 rounded-lg bg-blue-50 text-[#0655a7] flex items-center justify-center shrink-0">
          <i data-lucide="users" class="w-4 h-4"></i>
        </div>
        <div>
          <div class="text-[10px] text-[#71717a] font-medium">Total Bimbingan Terisi</div>
          <div class="text-sm font-bold text-[#09090b]"><span x-text="totalTerpakai"></span> Mahasiswa</div>
        </div>
      </div>
      <div class="p-3 bg-white border border-[#e4e4e7] rounded-xl flex items-center gap-3">
        <div class="flex items-center justify-center w-8 h-8 rounded-lg bg-emerald-50 text-emerald-600 shrink-0">
          <i data-lucide="check-circle-2" class="w-4 h-4"></i>
        </div>
        <div>
          <div class="text-[10px] text-[#71717a] font-medium">Dosen Kuota Aman (&lt;60%)</div>
          <div class="text-sm font-bold text-[#09090b]"><span x-text="countAman"></span> Dosen</div>
        </div>
      </div>
      <div class="p-3 bg-white border border-[#e4e4e7] rounded-xl flex items-center gap-3">
        <div class="flex items-center justify-center w-8 h-8 rounded-lg bg-amber-50 text-amber-600 shrink-0">
          <i data-lucide="alert-triangle" class="w-4 h-4"></i>
        </div>
        <div>
          <div class="text-[10px] text-[#71717a] font-medium">Mendekati Penuh (60-89%)</div>
          <div class="text-sm font-bold text-amber-700"><span x-text="countWaspada"></span> Dosen</div>
        </div>
      </div>
      <div class="p-3 bg-white border border-[#e4e4e7] rounded-xl flex items-center gap-3">
        <div class="flex items-center justify-center w-8 h-8 rounded-lg text-rose-600 bg-rose-50 shrink-0">
          <i data-lucide="alert-octagon" class="w-4 h-4"></i>
        </div>
        <div>
          <div class="text-[10px] text-[#71717a] font-medium">Kapasitas Penuh (100%)</div>
          <div class="text-sm font-bold text-[#09090b]"><span x-text="countPenuh"></span> Dosen</div>
        </div>
      </div>
    </div>

    <!-- Toolbar Filter & Search Sesuai Standar KP -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
      <div class="flex flex-wrap items-center gap-2 w-full sm:w-auto">
        <!-- Search Input -->
        <div class="relative w-full sm:w-72 md:w-80">
          <i data-lucide="search" class="w-4 h-4 text-[#71717a] absolute left-3 top-1/2 -translate-y-1/2"></i>
          <input
            type="text"
            x-model="searchQuery"
            placeholder="Cari dosen atau NIDN..."
            class="h-9 w-full rounded-md border border-[#e4e4e7] bg-white pl-9 pr-3 text-sm text-[#09090b] placeholder:text-[#71717a] focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
          />
        </div>

        <!-- Filter Prodi -->
        <select
          x-model="prodiFilter"
          class="h-9 px-3 rounded-md border border-[#e4e4e7] bg-white text-xs text-[#09090b] focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
        >
          <option value="semua">Semua Program Studi</option>
          <option value="Teknik Informatika">Teknik Informatika</option>
          <option value="Sistem Informasi">Sistem Informasi</option>
          <option value="Sains Data">Sains Data</option>
        </select>

        <!-- Filter Status -->
        <select
          x-model="statusFilter"
          class="h-9 px-3 rounded-md border border-[#e4e4e7] bg-white text-xs text-[#09090b] focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
        >
          <option value="semua">Semua Status</option>
          <option value="aman">Aman (&lt;60%)</option>
          <option value="waspada">Waspada (60-89%)</option>
          <option value="penuh">Penuh (100%)</option>
        </select>
      </div>
    </div>

    <!-- Tabel Kuota Dosen (Kolom Aksi Dihapus, Kolom Kuota Menggunakan Kotak Interaktif Opsi A) -->
    <div class="rounded-md border border-[#e4e4e7] overflow-hidden bg-white">
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="border-b border-[#e4e4e7] bg-[#fafafa]">
            <tr>
              <th class="h-10 w-12 px-3 text-center font-medium text-[#71717a] text-xs">No</th>
              <th class="h-10 px-4 text-left font-medium text-[#71717a] text-xs">Dosen Pembimbing</th>
              <th class="h-10 px-4 text-left font-medium text-[#71717a] text-xs">Prodi</th>
              <th class="h-10 px-4 text-left font-medium text-[#71717a] text-xs w-48">Progress Beban Kuota</th>
              <th class="h-10 px-4 text-center font-medium text-[#71717a] text-xs">Terpakai</th>
              <th class="h-10 px-4 text-center font-medium text-[#71717a] text-xs">Kuota</th>
              <th class="h-10 px-4 text-center font-medium text-[#71717a] text-xs">Sisa Slot</th>
              <th class="h-10 px-4 text-center font-medium text-[#71717a] text-xs">Status Kuota</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#e4e4e7]">
            <template x-for="(dosen, idx) in filteredDosen" :key="dosen.id">
              <tr class="hover:bg-[#f4f4f5]/60 transition-colors">
                <td class="h-12 px-3 text-center text-[#71717a] text-xs" x-text="idx + 1"></td>
                <td class="h-12 px-4">
                  <div class="flex items-center gap-3">
                    <div class="h-9 w-9 rounded-full bg-[#f4f4f5] text-[#0655a7] font-semibold text-xs flex items-center justify-center shrink-0 border border-[#e4e4e7]">
                      <span x-text="dosen.nama.replace('Dr. ', '').charAt(0)"></span>
                    </div>
                    <div class="flex flex-col">
                      <span class="font-semibold text-[#09090b] text-sm" x-text="dosen.nama"></span>
                      <span class="text-xs text-[#71717a]" x-text="'NIDN: ' + dosen.nidn"></span>
                    </div>
                  </div>
                </td>
                <td class="h-12 px-4 text-xs text-[#09090b]" x-text="dosen.prodi"></td>
                <td class="h-12 px-4">
                  <div class="flex items-center gap-2">
                    <div class="w-full h-2 overflow-hidden bg-[#e4e4e7] rounded-full">
                      <div
                        class="h-full rounded-full transition-all duration-300"
                        :class="getProgress(dosen) >= 100 ? 'bg-rose-500' : (getProgress(dosen) >= 60 ? 'bg-amber-500' : 'bg-emerald-500')"
                        :style="`width: ${getProgress(dosen)}%`"
                      ></div>
                    </div>
                    <span
                      class="text-xs font-semibold w-10 text-right"
                      :class="getProgress(dosen) >= 100 ? 'text-rose-600' : (getProgress(dosen) >= 60 ? 'text-amber-600' : 'text-emerald-600')"
                      x-text="getProgress(dosen) + '%'"
                    ></span>
                  </div>
                </td>
                <td class="h-12 px-4 text-center font-semibold text-[#09090b] text-sm" x-text="dosen.terpakai"></td>

                <!-- Kolom Kuota Style Opsi A: Tampilan Sesuai Gambar 7 (Kotak + Hover Affordance) -->
                <td class="h-12 px-4 text-center">
                  <div class="flex justify-center">
                    <button
                      type="button"
                      @click="openModalEdit(dosen)"
                      class="group relative inline-flex items-center justify-center h-8 min-w-[56px] px-3 rounded-md border border-[#e4e4e7] bg-white hover:border-[#0655a7] hover:bg-blue-50/40 transition-all shadow-none cursor-pointer"
                      title="Klik untuk menyesuaikan kuota"
                    >
                      <span class="text-xs font-semibold text-[#09090b] group-hover:text-[#0655a7]" x-text="dosen.batasMaks"></span>
                      <i data-lucide="pencil" class="w-3 h-3 text-[#0655a7] opacity-0 group-hover:opacity-100 transition-opacity ml-1.5 -mr-0.5"></i>
                    </button>
                  </div>
                </td>

                <td class="h-12 px-4 text-center font-semibold text-xs" :class="getSisaSlot(dosen) === 0 ? 'text-rose-600' : 'text-emerald-600'" x-text="getSisaSlot(dosen) + ' Slot'"></td>
                <td class="h-12 px-4 text-center">
                  <template x-if="getStatus(dosen) === 'penuh'">
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-rose-100 text-rose-800">
                      Penuh (100%)
                    </span>
                  </template>
                  <template x-if="getStatus(dosen) === 'waspada'">
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-amber-100 text-amber-800" x-text="'Waspada (' + getProgress(dosen) + '%)'">
                    </span>
                  </template>
                  <template x-if="getStatus(dosen) === 'aman'">
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-emerald-100 text-emerald-800" x-text="'Aman (' + getProgress(dosen) + '%)'">
                    </span>
                  </template>
                </td>
              </tr>
            </template>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Standardized Pagination Sesuai Standar KP -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-2 pt-1">
      <div class="text-xs text-[#71717a]">Menampilkan 1 - 7 dari 48 dosen</div>
      <div class="flex items-center gap-2">
        <button
          type="button"
          disabled
          class="h-8 w-8 flex items-center justify-center rounded-md border border-[#e4e4e7] bg-white text-[#71717a] opacity-50 cursor-not-allowed hover:bg-gray-50"
        >
          <i data-lucide="chevron-left" class="w-4 h-4"></i>
        </button>
        <button
          type="button"
          class="h-8 w-8 flex items-center justify-center rounded-md bg-[#0655a7] text-white font-semibold text-xs shadow-none"
        >
          1
        </button>
        <button
          type="button"
          class="h-8 w-8 flex items-center justify-center rounded-md border border-[#e4e4e7] bg-white text-[#09090b] font-medium text-xs hover:bg-[#f4f4f5]"
        >
          2
        </button>
        <button
          type="button"
          class="h-8 w-8 flex items-center justify-center rounded-md border border-[#e4e4e7] bg-white text-[#09090b] font-medium text-xs hover:bg-[#f4f4f5]"
        >
          3
        </button>
        <button
          type="button"
          class="h-8 w-8 flex items-center justify-center rounded-md border border-[#e4e4e7] bg-white text-[#09090b] hover:bg-[#f4f4f5]"
        >
          <i data-lucide="chevron-right" class="w-4 h-4"></i>
        </button>
        <select
          class="h-8 rounded-md border border-[#e4e4e7] bg-white px-2 text-xs text-[#09090b] focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
        >
          <option value="10">Show 10 items</option>
          <option value="25">Show 25 items</option>
          <option value="50">Show 50 items</option>
        </select>
      </div>
    </div>

    <!-- Modal 1: Sesuaikan Kuota Dosen (PERSIS SESUAI GAMBAR 6 REFERENSI USER) -->
    <div
      x-show="isEditModalOpen"
      x-cloak
      class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4"
    >
      <div
        @click.outside="isEditModalOpen = false"
        class="w-full max-w-md rounded-2xl bg-white p-6 shadow-2xl border border-[#e4e4e7] space-y-4"
      >
        <!-- Header Modal: Judul & Subtitle Nama Dosen & Tombol X -->
        <div class="flex items-start justify-between">
          <div class="flex flex-col">
            <h3 class="text-base font-bold text-[#09090b]">Sesuaikan Kuota Dosen</h3>
            <p class="text-xs text-[#71717a] mt-0.5" x-text="currentDosen.nama"></p>
          </div>
          <button
            type="button"
            @click="isEditModalOpen = false"
            class="h-7 w-7 rounded-md hover:bg-[#f4f4f5] text-[#71717a] flex items-center justify-center -mr-1 -mt-1 transition-colors"
          >
            <i data-lucide="x" class="w-4 h-4"></i>
          </button>
        </div>

        <!-- Box Info Biru: Mahasiswa Terpakai Saat Ini: X Mahasiswa -->
        <div class="rounded-xl bg-[#f0f7ff] border border-[#dbeafe] px-4 py-3 text-left">
          <p class="text-xs font-semibold text-[#0655a7]">
            Mahasiswa Terpakai Saat Ini: <span class="font-bold" x-text="currentDosen.terpakai"></span> Mahasiswa
          </p>
        </div>

        <!-- Input Field: Batas Maksimal Kuota * -->
        <div class="space-y-1.5 text-left">
          <label class="block text-xs font-semibold text-[#09090b]">
            Batas Maksimal Kuota <span class="text-rose-500">*</span>
          </label>
          <input
            type="number"
            min="0"
            x-model="editBatasInput"
            @keydown.enter="saveKuota()"
            class="h-10 w-full rounded-lg border border-[#e4e4e7] bg-white px-3 text-sm text-[#09090b] focus:outline-none focus:ring-1 focus:ring-[#0655a7] focus:border-[#0655a7]"
            placeholder="Masukkan batas kuota..."
          />
        </div>

        <!-- Footer Action Buttons: Batal & Simpan Perubahan Sesuai Gambar 6 -->
        <div class="flex items-center justify-end gap-2.5 pt-2">
          <button
            type="button"
            @click="isEditModalOpen = false"
            class="h-9 px-4 rounded-lg border border-[#e4e4e7] bg-white hover:bg-[#f4f4f5] text-xs font-medium text-[#09090b] transition-colors"
          >
            Batal
          </button>
          <button
            type="button"
            @click="saveKuota()"
            class="h-9 px-4 rounded-lg bg-[#0655a7] hover:bg-[#0655a7]/90 text-white text-xs font-semibold shadow-none transition-colors"
          >
            Simpan Perubahan
          </button>
        </div>
      </div>
    </div>
  </section>
</AdminShell>
