---
// src/pages/admin/dosen-kuota.astro
import AdminShell from "../../layouts/AdminShell.astro";
---

<AdminShell currentTab="dosen-kuota">
  <section
    id="section-dosen-kuota"
    class="flex flex-col flex-1 min-h-0 gap-4 pr-1 overflow-y-auto tab-content"
    x-data="{
      searchQuery: '',
      sortOption: 'default',
      statusFilter: 'semua',
      isEditModalOpen: false,
      currentDosen: { nama: '', nidn: '', kuota: 0, diterima: 0 },
      editKuotaInput: 0,
      dosenList: [
        { id: 1,  nama: 'ERLIN DOLPHINA, SH, MM',      nidn: '0686.11.1994.047', kuota: 5, jumlahAjuan: 4, diterima: 4, ditolak: 0 },
        { id: 2,  nama: 'HERU LESTIAWAN, M.Kom',       nidn: '0686.11.1996.097', kuota: 3, jumlahAjuan: 5, diterima: 2, ditolak: 0 },
        { id: 3,  nama: 'NOOR AGENG SETIYANTO, M.Kom', nidn: '0686.11.1997.125', kuota: 5, jumlahAjuan: 4, diterima: 4, ditolak: 0 },
        { id: 4,  nama: 'ERNA ZUNI ASTUTI, M.Kom',     nidn: '0686.11.1997.132', kuota: 5, jumlahAjuan: 4, diterima: 4, ditolak: 0 },
        { id: 5,  nama: 'FERI AGUSTINA, M.Kom',        nidn: '0686.11.1997.141', kuota: 3, jumlahAjuan: 3, diterima: 2, ditolak: 0 },
        { id: 6,  nama: 'SUPRAYOGI, M.Kom',            nidn: '0686.11.1998.148', kuota: 2, jumlahAjuan: 1, diterima: 1, ditolak: 0 },
        { id: 7,  nama: 'L.BUDI HANDOKO, M.Kom',       nidn: '0686.11.1999.186', kuota: 3, jumlahAjuan: 2, diterima: 2, ditolak: 0 },
        { id: 8,  nama: 'IFAN RIZQA, M.Kom',           nidn: '0686.11.2001.267', kuota: 2, jumlahAjuan: 1, diterima: 1, ditolak: 0 },
        { id: 9,  nama: 'SLAMET SUDARYANTO N., ST',    nidn: '0686.11.2009.361', kuota: 2, jumlahAjuan: 1, diterima: 1, ditolak: 0 },
        { id: 10, nama: 'UMI ROSYIDAH, S.Kom, M.T',    nidn: '0686.11.2009.372', kuota: 3, jumlahAjuan: 2, diterima: 2, ditolak: 0 },
      ],
      getSisa(d) {
        return Math.max(0, d.kuota - d.diterima);
      },
      getStatus(d) {
        return this.getSisa(d) > 0 ? 'tersedia' : 'penuh';
      },
      openModalEdit(dosen) {
        this.currentDosen = dosen;
        this.editKuotaInput = dosen.kuota;
        this.isEditModalOpen = true;
      },
      saveKuota() {
        const val = parseInt(this.editKuotaInput);
        if (isNaN(val) || val < 0) {
          alert('Kuota tidak valid!');
          return;
        }
        this.currentDosen.kuota = val;
        this.isEditModalOpen = false;
      },
      get filteredDosen() {
        let list = this.dosenList.filter(d => {
          const matchSearch = d.nama.toLowerCase().includes(this.searchQuery.toLowerCase()) ||
                              d.nidn.includes(this.searchQuery);
          const matchStatus = this.statusFilter === 'semua' || this.getStatus(d) === this.statusFilter;
          return matchSearch && matchStatus;
        });
        if (this.sortOption === 'nama_asc') list = [...list].sort((a, b) => a.nama.localeCompare(b.nama));
        if (this.sortOption === 'nama_desc') list = [...list].sort((a, b) => b.nama.localeCompare(a.nama));
        return list;
      },
      get totalDosen() {
        return this.dosenList.length;
      },
      get totalKuota() {
        return this.dosenList.reduce((acc, d) => acc + d.kuota, 0);
      },
      get totalTerpakai() {
        return this.dosenList.reduce((acc, d) => acc + d.diterima, 0);
      },
      get totalSisa() {
        return this.dosenList.reduce((acc, d) => acc + this.getSisa(d), 0);
      }
    }"
  >
    <!-- Stat Cards Ringkasan Kuota -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
      <!-- Dosen Aktif -->
      <div class="rounded-xl bg-[#EFF4FE] px-4 py-3.5 flex items-center gap-3">
        <div class="w-9 h-9 rounded-lg bg-white/70 flex items-center justify-center shrink-0">
          <i data-lucide="users" class="w-[18px] h-[18px] text-[#3B6FD4]"></i>
        </div>
        <div class="flex flex-col leading-tight">
          <span class="text-lg font-semibold text-[#3B6FD4]" x-text="totalDosen"></span>
          <span class="text-xs text-[#6B7A90]">Dosen Aktif</span>
        </div>
      </div>

      <!-- Total Kuota -->
      <div class="rounded-xl bg-[#EDFAF1] px-4 py-3.5 flex items-center gap-3">
        <div class="w-9 h-9 rounded-lg bg-white/70 flex items-center justify-center shrink-0">
          <i data-lucide="check-circle" class="w-[18px] h-[18px] text-[#22A45D]"></i>
        </div>
        <div class="flex flex-col leading-tight">
          <span class="text-lg font-semibold text-[#22A45D]" x-text="totalKuota"></span>
          <span class="text-xs text-[#6B7A90]">Total Kuota</span>
        </div>
      </div>

      <!-- Terpakai -->
      <div class="rounded-xl bg-[#FEF6E9] px-4 py-3.5 flex items-center gap-3">
        <div class="w-9 h-9 rounded-lg bg-white/70 flex items-center justify-center shrink-0">
          <i data-lucide="clock" class="w-[18px] h-[18px] text-[#E09B26]"></i>
        </div>
        <div class="flex flex-col leading-tight">
          <span class="text-lg font-semibold text-[#E09B26]" x-text="totalTerpakai"></span>
          <span class="text-xs text-[#6B7A90]">Terpakai</span>
        </div>
      </div>

      <!-- Sisa Kuota -->
      <div class="rounded-xl bg-[#F4F0FD] px-4 py-3.5 flex items-center gap-3">
        <div class="w-9 h-9 rounded-lg bg-white/70 flex items-center justify-center shrink-0">
          <i data-lucide="clipboard-list" class="w-[18px] h-[18px] text-[#8B5CF6]"></i>
        </div>
        <div class="flex flex-col leading-tight">
          <span class="text-lg font-semibold text-[#8B5CF6]" x-text="totalSisa"></span>
          <span class="text-xs text-[#6B7A90]">Sisa Kuota</span>
        </div>
      </div>
    </div>

    <!-- Toolbar Filter & Search -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
      <div class="relative w-full sm:w-72">
        <i data-lucide="search" class="w-4 h-4 text-[#71717a] absolute left-3 top-1/2 -translate-y-1/2"></i>
        <input
          type="text"
          x-model="searchQuery"
          placeholder="Cari nama dosen..."
          class="h-10 w-full rounded-lg border border-[#e4e4e7] bg-white pl-9 pr-3 text-sm text-[#09090b] placeholder:text-[#71717a] focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
        />
      </div>

      <div class="flex items-center gap-2">
        <select
          x-model="sortOption"
          class="h-10 px-3 pr-8 rounded-lg border border-[#e4e4e7] bg-white text-sm text-[#09090b] focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
        >
          <option value="default">Default</option>
          <option value="nama_asc">Nama (A - Z)</option>
          <option value="nama_desc">Nama (Z - A)</option>
        </select>

        <select
          x-model="statusFilter"
          class="h-10 px-3 pr-8 rounded-lg border border-[#e4e4e7] bg-white text-sm text-[#09090b] focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
        >
          <option value="semua">Semua Status</option>
          <option value="tersedia">Tersedia</option>
          <option value="penuh">Penuh</option>
        </select>
      </div>
    </div>

    <!-- Tabel Kuota Dosen -->
    <div class="rounded-lg border border-[#e4e4e7] overflow-hidden bg-white">
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="border-b border-[#e4e4e7] bg-[#fafafa]">
            <tr>
              <th class="h-11 px-4 font-medium text-sm w-16 text-center text-[#71717a]">No</th>
              <th class="h-11 px-4 font-medium text-sm text-left text-[#71717a]">
                <button
                  type="button"
                  @click="sortOption = sortOption === 'nama_asc' ? 'nama_desc' : 'nama_asc'"
                  class="inline-flex items-center gap-1.5 hover:text-[#09090b] transition-colors cursor-pointer"
                >
                  <span>Nama Dosen</span>
                  <i data-lucide="arrow-up-down" class="w-3.5 h-3.5"></i>
                </button>
              </th>
              <th class="h-11 px-4 font-medium text-sm text-left text-[#71717a]">Kuota</th>
              <th class="h-11 px-4 font-medium text-sm text-left text-[#71717a]">Jumlah Ajuan</th>
              <th class="h-11 px-4 font-medium text-sm text-left text-[#71717a]">Ajuan Diterima</th>
              <th class="h-11 px-4 font-medium text-sm text-left text-[#71717a]">Ajuan Ditolak</th>
              <th class="h-11 px-4 font-medium text-sm text-left text-[#71717a]">Sisa Kuota</th>
              <th class="h-11 px-4 font-medium text-sm text-left text-[#71717a]">Status</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#e4e4e7]">
            <template x-for="(dosen, idx) in filteredDosen" :key="dosen.id">
              <tr class="hover:bg-[#fafafa] transition-colors">
                <td class="h-[68px] px-4 text-center text-sm text-[#3f3f46]" x-text="idx + 1"></td>
                <td class="h-[68px] px-4 text-sm">
                  <div class="flex items-center gap-3">
                    <div class="h-9 w-9 rounded-full bg-[#f4f4f5] text-[#52525b] font-medium text-sm flex items-center justify-center shrink-0">
                      <span x-text="dosen.nama.charAt(0)"></span>
                    </div>
                    <div class="flex flex-col leading-tight gap-1">
                      <span class="font-semibold text-[#09090b] text-sm tracking-tight" x-text="dosen.nama"></span>
                      <span class="text-[13px] text-[#71717a]" x-text="dosen.nidn"></span>
                    </div>
                  </div>
                </td>
                <td class="h-[68px] px-4 text-sm">
                  <button
                    type="button"
                    @click="openModalEdit(dosen)"
                    class="inline-flex items-center justify-center h-8 min-w-[56px] px-3 rounded-md border border-[#e4e4e7] bg-white hover:border-[#0655a7] hover:bg-blue-50/40 text-sm font-medium text-[#09090b] transition-colors cursor-pointer"
                    title="Klik untuk menyesuaikan kuota"
                    x-text="dosen.kuota"
                  ></button>
                </td>
                <td class="h-[68px] px-4 text-left text-sm text-[#3f3f46]" x-text="dosen.jumlahAjuan"></td>
                <td class="h-[68px] px-4 text-left text-sm text-[#3f3f46]" x-text="dosen.diterima"></td>
                <td class="h-[68px] px-4 text-left text-sm text-[#3f3f46]" x-text="dosen.ditolak"></td>
                <td class="h-[68px] px-4 text-left text-sm text-[#3f3f46]" x-text="getSisa(dosen)"></td>
                <td class="h-[68px] px-4 text-sm">
                  <template x-if="getStatus(dosen) === 'tersedia'">
                    <span class="inline-flex items-center px-2.5 py-1 rounded-md border border-[#BBF7D0] bg-[#DCFCE7] text-[13px] font-medium text-[#15803D]">
                      Tersedia
                    </span>
                  </template>
                  <template x-if="getStatus(dosen) === 'penuh'">
                    <span class="inline-flex items-center px-2.5 py-1 rounded-md border border-[#FECDD3] bg-[#FFE4E6] text-[13px] font-medium text-[#BE123C]">
                      Penuh
                    </span>
                  </template>
                </td>
              </tr>
            </template>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Modal Sesuaikan Kuota Dosen -->
    <div
      x-show="isEditModalOpen"
      x-cloak
      class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4"
    >
      <div
        @click.outside="isEditModalOpen = false"
        class="w-full max-w-md rounded-2xl bg-white p-6 shadow-2xl border border-[#e4e4e7] space-y-4"
      >
        <div class="flex items-start justify-between">
          <div class="flex flex-col">
            <h3 class="text-base font-bold text-[#09090b]">Sesuaikan Kuota Dosen</h3>
            <p class="text-xs text-[#71717a] mt-0.5" x-text="currentDosen.nama"></p>
          </div>
          <button
            type="button"
            @click="isEditModalOpen = false"
            class="h-7 w-7 rounded-md hover:bg-[#f4f4f5] text-[#71717a] flex items-center justify-center -mr-1 -mt-1 transition-colors"
          >
            <i data-lucide="x" class="w-4 h-4"></i>
          </button>
        </div>

        <div class="rounded-xl bg-[#f0f7ff] border border-[#dbeafe] px-4 py-3 text-left">
          <p class="text-xs font-semibold text-[#0655a7]">
            Ajuan Diterima Saat Ini: <span class="font-bold" x-text="currentDosen.diterima"></span> Mahasiswa
          </p>
        </div>

        <div class="space-y-1.5 text-left">
          <label class="block text-xs font-semibold text-[#09090b]">
            Kuota Maksimal <span class="text-rose-500">*</span>
          </label>
          <input
            type="number"
            min="0"
            x-model="editKuotaInput"
            @keydown.enter="saveKuota()"
            class="h-10 w-full rounded-lg border border-[#e4e4e7] bg-white px-3 text-sm text-[#09090b] focus:outline-none focus:ring-1 focus:ring-[#0655a7] focus:border-[#0655a7]"
            placeholder="Masukkan kuota..."
          />
        </div>

        <div class="flex items-center justify-end gap-2.5 pt-2">
          <button
            type="button"
            @click="isEditModalOpen = false"
            class="h-9 px-4 rounded-lg border border-[#e4e4e7] bg-white hover:bg-[#f4f4f5] text-xs font-medium text-[#09090b] transition-colors"
          >
            Batal
          </button>
          <button
            type="button"
            @click="saveKuota()"
            class="h-9 px-4 rounded-lg bg-[#0655a7] hover:bg-[#0655a7]/90 text-white text-xs font-semibold shadow-none transition-colors"
          >
            Simpan Perubahan
          </button>
        </div>
      </div>
    </div>
  </section>
</AdminShell>
