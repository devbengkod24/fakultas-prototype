---
// src/pages/admin/dosen-kuota.astro
import AdminShell from "../../layouts/AdminShell.astro";
---

<AdminShell currentTab="dosen-kuota">
<section
            id="section-dosen-kuota" x-show="$store.mbkm.currentSection === 'dosen-kuota'"
            class="flex flex-col flex-1 hidden min-h-0 gap-4 pr-1 overflow-y-auto tab-content"
          >
            <div class="flex flex-col gap-2.5 sm:flex-row sm:items-center sm:justify-between pb-0.5">
              <div>
                <h2 class="text-base font-semibold text-[#09090b]">Monitoring Kuota Dosen Pembimbing</h2>
                <p class="text-[11px] text-[#71717a]">
                  Pengawasan kapasitas beban bimbingan maksimal dosen per semester aktif (Batas standar: 8 - 10
                  mahasiswa per dosen).
                </p>
              </div>
              <div class="flex items-center gap-2">
                <button
                  type="button"
                  onclick="openModalSetBatasKuota()"
                  class="px-3.5 py-1.5 rounded-lg bg-[#0655a7] hover:bg-[#114d91] text-white text-xs font-semibold flex items-center gap-1.5 shadow-2xs transition-colors shrink-0"
                >
                  <i data-lucide="sliders" class="w-3.5 h-3.5"></i>
                  <span>Atur Batas Kuota Fakultas</span>
                </button>
              </div>
            </div>

            <!-- Quick Info / Stat Cards Kuota -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
              <div class="p-3 bg-white border border-[#e4e4e7] rounded-xl flex items-center gap-3 shadow-2xs">
                <div class="w-8 h-8 rounded-lg bg-blue-50 text-[#0655a7] flex items-center justify-center shrink-0">
                  <i data-lucide="users" class="w-4 h-4"></i>
                </div>
                <div>
                  <div class="text-[10px] text-[#71717a] font-medium">Total Bimbingan Terisi</div>
                  <div class="text-sm font-bold text-[#09090b]">186 Mahasiswa</div>
                </div>
              </div>
              <div class="p-3 bg-white border border-[#e4e4e7] rounded-xl flex items-center gap-3 shadow-2xs">
                <div
                  class="flex items-center justify-center w-8 h-8 rounded-lg bg-emerald-50 text-emerald-600 shrink-0"
                >
                  <i data-lucide="check-circle-2" class="w-4 h-4"></i>
                </div>
                <div>
                  <div class="text-[10px] text-[#71717a] font-medium">Dosen Kuota Aman (&lt;60%)</div>
                  <div class="text-sm font-bold text-[#09090b]">24 Dosen</div>
                </div>
              </div>
              <div class="p-3 bg-white border border-[#e4e4e7] rounded-xl flex items-center gap-3 shadow-2xs">
                <div class="flex items-center justify-center w-8 h-8 rounded-lg bg-amber-50 text-amber-600 shrink-0">
                  <i data-lucide="alert-triangle" class="w-4 h-4"></i>
                </div>
                <div>
                  <div class="text-[10px] text-[#71717a] font-medium">Mendekati Penuh (60-89%)</div>
                  <div class="text-sm font-bold text-amber-700">18 Dosen</div>
                </div>
              </div>
              <div class="p-3 bg-white border border-[#e4e4e7] rounded-xl flex items-center gap-3 shadow-2xs">
                <div class="flex items-center justify-center w-8 h-8 rounded-lg text-rose-600 bg-rose-50 shrink-0">
                  <i data-lucide="alert-octagon" class="w-4 h-4"></i>
                </div>
                <div>
                  <div class="text-[10px] text-[#71717a] font-medium">Kapasitas Penuh (100%)</div>
                  <div class="text-sm font-bold text-[#09090b]">6 Dosen</div>
                </div>
              </div>
            </div>

            <!-- Tabel Kuota Dosen -->
            <div class="overflow-x-auto rounded-xl border border-[#e4e4e7]">
              <table class="w-full text-xs text-left border-collapse">
                <thead class="bg-[#fafafa] border-b border-[#e4e4e7] text-[#3f3f46]">
                  <tr>
                    <th class="w-12 px-2.5 py-2 font-semibold text-center text-[11px]">No</th>
                    <th class="px-3 py-2 font-semibold text-[11px]">Dosen Pembimbing</th>
                    <th class="px-3 py-2 font-semibold text-[11px]">Prodi</th>
                    <th class="w-48 px-3 py-2 font-semibold text-[11px]">Progress Beban Kuota</th>
                    <th class="px-3 py-2 font-semibold text-center text-[11px]">Terpakai</th>
                    <th class="px-3 py-2 font-semibold text-center text-[11px]">Batas Maks</th>
                    <th class="px-3 py-2 font-semibold text-center text-[11px]">Sisa Slot</th>
                    <th class="px-3 py-2 font-semibold text-center text-[11px]">Status Kuota</th>
                    <th class="w-24 px-3 py-2 font-semibold text-center text-[11px]">Aksi</th>
                  </tr>
                </thead>
                <tbody id="dosen-kuota-tbody-embed" class="divide-y divide-[#e4e4e7] bg-white">
                  <tr class="transition-colors hover:bg-blue-50/30">
                    <td class="px-2.5 py-2.5 text-center text-[#71717a]">1</td>
                    <td class="px-3 py-2.5">
                      <div class="font-semibold text-[#09090b]">Dr. M. Arief Soeleman, M.Kom</div>
                      <div class="text-[10px] text-[#71717a]">NIDN: 0612047801</div>
                    </td>
                    <td class="px-3 py-2.5 text-[#3f3f46]">Teknik Informatika</td>
                    <td class="px-3 py-2.5">
                      <div class="flex items-center gap-2">
                        <div class="w-full h-2 overflow-hidden bg-gray-100 rounded-full">
                          <div class="h-full rounded-full bg-amber-500" style="width: 75%"></div>
                        </div>
                        <span class="text-[11px] font-bold text-amber-700 w-8 text-right">75%</span>
                      </div>
                    </td>
                    <td class="px-3 py-2.5 text-center font-bold text-[#09090b]">6</td>
                    <td class="px-3 py-2.5 text-center text-[#71717a]">8</td>
                    <td class="px-3 py-2.5 text-center font-bold text-emerald-600">2 Slot</td>
                    <td class="px-3 py-2.5 text-center">
                      <span
                        class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-amber-50 text-amber-700 border border-amber-200"
                      >
                        Waspada (75%)
                      </span>
                    </td>
                    <td class="px-3 py-2.5 text-center">
                      <button
                        type="button"
                        onclick="openModalEditBatasDosen('Dr. M. Arief Soeleman, M.Kom', 8, 6)"
                        class="px-2 py-1 rounded-md border border-[#e4e4e7] bg-white hover:bg-gray-50 text-[#0655a7] font-semibold text-[11px] shadow-2xs"
                      >
                        Ubah Kuota
                      </button>
                    </td>
                  </tr>
                  <tr class="transition-colors hover:bg-blue-50/30">
                    <td class="px-2.5 py-2.5 text-center text-[#71717a]">2</td>
                    <td class="px-3 py-2.5">
                      <div class="font-semibold text-[#09090b]">Affandy, Ph.D</div>
                      <div class="text-[10px] text-[#71717a]">NIDN: 0617087502</div>
                    </td>
                    <td class="px-3 py-2.5 text-[#3f3f46]">Teknik Informatika</td>
                    <td class="px-3 py-2.5">
                      <div class="flex items-center gap-2">
                        <div class="w-full h-2 overflow-hidden bg-gray-100 rounded-full">
                          <div class="h-full rounded-full bg-rose-500" style="width: 100%"></div>
                        </div>
                        <span class="text-[11px] font-bold text-rose-700 w-8 text-right">100%</span>
                      </div>
                    </td>
                    <td class="px-3 py-2.5 text-center font-bold text-[#09090b]">8</td>
                    <td class="px-3 py-2.5 text-center text-[#71717a]">8</td>
                    <td class="px-3 py-2.5 text-center font-bold text-rose-600">0 Slot</td>
                    <td class="px-3 py-2.5 text-center">
                      <span
                        class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-rose-50 text-rose-700 border border-rose-200"
                      >
                        Penuh (100%)
                      </span>
                    </td>
                    <td class="px-3 py-2.5 text-center">
                      <button
                        type="button"
                        onclick="openModalEditBatasDosen('Affandy, Ph.D', 8, 8)"
                        class="px-2 py-1 rounded-md border border-[#e4e4e7] bg-white hover:bg-gray-50 text-[#0655a7] font-semibold text-[11px] shadow-2xs"
                      >
                        Ubah Kuota
                      </button>
                    </td>
                  </tr>
                  <tr class="transition-colors hover:bg-blue-50/30">
                    <td class="px-2.5 py-2.5 text-center text-[#71717a]">3</td>
                    <td class="px-3 py-2.5">
                      <div class="font-semibold text-[#09090b]">Christy Atika Sari, M.Kom</div>
                      <div class="text-[10px] text-[#71717a]">NIDN: 0629038401</div>
                    </td>
                    <td class="px-3 py-2.5 text-[#3f3f46]">Sistem Informasi</td>
                    <td class="px-3 py-2.5">
                      <div class="flex items-center gap-2">
                        <div class="w-full h-2 overflow-hidden bg-gray-100 rounded-full">
                          <div class="h-full rounded-full bg-emerald-500" style="width: 50%"></div>
                        </div>
                        <span class="text-[11px] font-bold text-emerald-700 w-8 text-right">50%</span>
                      </div>
                    </td>
                    <td class="px-3 py-2.5 text-center font-bold text-[#09090b]">4</td>
                    <td class="px-3 py-2.5 text-center text-[#71717a]">8</td>
                    <td class="px-3 py-2.5 text-center font-bold text-emerald-600">4 Slot</td>
                    <td class="px-3 py-2.5 text-center">
                      <span
                        class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200"
                      >
                        Aman (50%)
                      </span>
                    </td>
                    <td class="px-3 py-2.5 text-center">
                      <button
                        type="button"
                        onclick="openModalEditBatasDosen('Christy Atika Sari, M.Kom', 8, 4)"
                        class="px-2 py-1 rounded-md border border-[#e4e4e7] bg-white hover:bg-gray-50 text-[#0655a7] font-semibold text-[11px] shadow-2xs"
                      >
                        Ubah Kuota
                      </button>
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>

            <!-- Pagination & Info -->
            <div class="flex flex-col sm:flex-row items-center justify-between gap-2 pt-0.5">
              <div class="text-[11px] text-[#71717a]">Menampilkan 1 - 5 dari 48 dosen</div>
              <div class="flex items-center gap-2.5">
                <div class="flex items-center gap-1">
                  <button
                    type="button"
                    class="flex items-center justify-center w-8 h-8 rounded-lg border border-[#e4e4e7] bg-white text-[#71717a] hover:bg-gray-50 text-xs transition-colors"
                    title="Sebelumnya"
                  >
                    <i data-lucide="chevron-left" class="w-4 h-4"></i>
                  </button>
                  <button
                    type="button"
                    class="flex items-center justify-center w-8 h-8 rounded-lg bg-[#0655a7] text-white font-semibold text-xs shadow-2xs"
                  >
                    1
                  </button>
                  <button
                    type="button"
                    class="flex items-center justify-center w-8 h-8 rounded-lg border border-[#e4e4e7] bg-white text-[#71717a] hover:bg-gray-50 text-xs transition-colors"
                    title="Selanjutnya"
                  >
                    <i data-lucide="chevron-right" class="w-4 h-4"></i>
                  </button>
                </div>
                <div class="relative">
                  <select
                    class="appearance-none pl-3 pr-8 py-1.5 text-xs font-medium text-[#09090b] bg-white border border-[#0655a7] rounded-lg focus:outline-none cursor-pointer"
                  >
                    <option value="10">Show 10 items</option>
                    <option value="25">Show 25 items</option>
                    <option value="50">Show 50 items</option>
                  </select>
                  <i
                    data-lucide="chevron-down"
                    class="w-3.5 h-3.5 text-[#09090b] absolute right-2.5 top-1/2 -translate-y-1/2 pointer-events-none"
                  ></i>
                </div>
              </div>
            </div>
          </section>
</AdminShell>
