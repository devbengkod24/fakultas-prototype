---
import AdminShell from '../../layouts/AdminShell.astro';
---

<AdminShell currentTab="surekom">
  <section
    id="section-surekom"
    class="flex flex-col flex-1 min-h-0 gap-4 pr-1 overflow-y-auto tab-content"
  >
<!-- ==================================================== -->
<!-- FRAGMEN BERKAS MANDIRI: SURAT REKOMENDASI (SUREKOM) -->
<!-- Validasi Surat Rekomendasi Mahasiswa MBKM           -->
<!-- ==================================================== -->

<div class="space-y-4">
  <!-- Filter & Search Toolbar (Sesuai Standar SearchControl fakultas-fe) -->
  <div class="mb-2 flex flex-col lg:flex-row lg:items-center justify-between gap-3">
    <!-- Search Box -->
    <div class="relative w-full lg:w-80">
      <i data-lucide="search" class="w-4 h-4 text-[#71717a] absolute left-3 top-1/2 -translate-y-1/2"></i>
      <input
        type="text"
        id="search-surekom"
        oninput="handleSearchSurekom(this.value)"
        placeholder="Cari mahasiswa, NIM, atau program..."
        class="h-9 w-full rounded-md border border-[#e4e4e7] bg-white pl-9 pr-3 text-sm text-[#09090b] placeholder:text-[#71717a] focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
      />
    </div>

    <!-- Filters Group -->
    <div class="flex flex-wrap items-center gap-2">
      <!-- Filter Status -->
      <select
        id="filter-surekom-status"
        onchange="handleFilterSurekomStatus(this.value)"
        class="h-9 px-3 rounded-md border border-[#e4e4e7] bg-white text-xs font-medium text-[#09090b] focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
      >
        <option value="semua">Semua Status</option>
        <option value="pending" selected>Menunggu Validasi</option>
        <option value="approved">Disetujui</option>
        <option value="rejected">Ditolak</option>
      </select>

      <!-- Filter Program / Mitra -->
      <select
        id="filter-surekom-program"
        onchange="handleFilterSurekomProgram(this.value)"
        class="h-9 px-3 rounded-md border border-[#e4e4e7] bg-white text-xs font-medium text-[#09090b] focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
      >
        <option value="semua">Semua Program & Mitra</option>
        <option value="Kegiatan Wirausaha">Kegiatan Wirausaha</option>
        <option value="Magang Berdampak">Magang Berdampak</option>
        <option value="Studi Independen">Studi Independen</option>
        <option value="Bangkit Academy">Bangkit Academy</option>
        <option value="Dicoding Indonesia">Dicoding Indonesia</option>
        <option value="Kampus Mengajar">Kampus Mengajar</option>
        <option value="Riset / Penelitian">Riset / Penelitian</option>
      </select>

      <!-- Filter Program Studi -->
      <select
        id="filter-surekom-prodi"
        onchange="handleFilterSurekomProdi(this.value)"
        class="h-9 px-3 rounded-md border border-[#e4e4e7] bg-white text-xs font-medium text-[#09090b] focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
      >
        <option value="semua">Semua Program Studi</option>
        <option value="TEKNIK INFORMATIKA S1">S1 Teknik Informatika</option>
        <option value="SISTEM INFORMASI S1">S1 Sistem Informasi</option>
        <option value="DESAIN KOMUNIKASI VISUAL S1">S1 DKV</option>
        <option value="ILMU KOMUNIKASI S1">S1 Ilmu Komunikasi</option>
      </select>
    </div>
  </div>

  <!-- Tabel Validasi Surekom (Sesuai DataTable di fakultas-fe) -->
  <div class="rounded-md border border-[#e4e4e7] overflow-hidden bg-white">
    <table class="w-full text-sm">
      <thead class="border-b border-[#e4e4e7] bg-[#fafafa]">
        <tr>
          <th class="h-10 w-12 px-3 text-center font-medium text-[#71717a] text-xs">No</th>
          <th class="h-10 px-4 text-left font-medium text-[#71717a] text-xs">Mahasiswa</th>
          <th class="h-10 px-4 text-left font-medium text-[#71717a] text-xs">Program & Mitra Tujuan</th>
          <th class="h-10 px-4 text-left font-medium text-[#71717a] text-xs">Syarat EWS (Akademik)</th>
          <th class="h-10 px-4 text-center font-medium text-[#71717a] text-xs">Status</th>
          <th class="h-10 px-4 text-center font-medium text-[#71717a] text-xs">Tanggal Pengajuan</th>
          <th class="h-10 w-28 px-4 text-center font-medium text-[#71717a] text-xs">Aksi</th>
        </tr>
      </thead>
      <tbody id="surekom-table-tbody" class="divide-y divide-[#e4e4e7]">
        <!-- Populated dynamically via renderSurekomTable() -->
      </tbody>
    </table>
  </div>

  <!-- Footer Informasi & Pagination di Bawah -->
  <div class="pt-2 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[#71717a]">
    <div id="surekom-table-info">Menampilkan permohonan surat rekomendasi</div>
    <div id="surekom-pagination-controls" class="flex items-center gap-1">
      <!-- Pagination buttons generated dynamically -->
    </div>
  </div>
</div>

  </section>
</AdminShell>
