---
// src/pages/admin/form-pendaftaran.astro
import AdminShell from '../../layouts/AdminShell.astro';
import TabIdentitasStudi from '../../components/admin/form-pendaftaran/TabIdentitasStudi.astro';
import TabDokumenPendaftaran from '../../components/admin/form-pendaftaran/TabDokumenPendaftaran.astro';
import TabPersetujuanProgram from '../../components/admin/form-pendaftaran/TabPersetujuanProgram.astro';

const headerActions = `
  <div class="flex items-center gap-2.5 shrink-0">
    <a
      href="/pendaftaran-mahasiswa"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 h-9 px-3.5 text-xs font-semibold rounded-lg border border-gray-300 bg-white hover:bg-gray-50 text-gray-700 transition-all shadow-2xs"
    >
      <i data-lucide="external-link" class="w-3.5 h-3.5 text-gray-500"></i>
      <span>Pratinjau Formulir Mahasiswa</span>
    </a>
    <button
      type="button"
      onclick="handleSaveFormPendaftaran()"
      class="inline-flex items-center justify-center gap-2 h-9 px-4 text-xs font-bold rounded-lg bg-[#0655a7] hover:bg-[#114D91] text-white shadow-2xs transition-all active:scale-95 cursor-pointer"
    >
      <i data-lucide="save" class="w-3.5 h-3.5"></i>
      <span>Simpan Perubahan</span>
    </button>
  </div>
`;
---

<AdminShell
  currentTab="form-pendaftaran"
  pageTitle="Form Pendaftaran Mahasiswa"
  subtitle="Konfigurasi tahapan identitas, dokumen pendaftaran, dan persetujuan komitmen pendaftar."
  actionButton={headerActions}
>
  <section
    id="section-form-pendaftaran"
    class="flex flex-col flex-1 min-h-0 gap-6 pr-1 overflow-y-auto tab-content font-sans"
  >
    <!-- Navigasi 3 Tab CMS Formulir Pendaftaran (Tanpa Icon & Tanpa Nomor) -->
    <div class="w-full border-b border-gray-200">
      <div class="flex items-center gap-2 overflow-x-auto" role="tablist">
        <button
          type="button"
          id="btn-form-tab-identitas"
          onclick="switchFormTab('identitas')"
          role="tab"
          aria-selected="true"
          class="form-tab-btn inline-flex items-center px-5 py-3 text-sm font-semibold border-b-2 border-primary-600 text-primary-700 transition-colors shrink-0 cursor-pointer"
        >
          <span>Identitas &amp; Data Studi</span>
        </button>

        <button
          type="button"
          id="btn-form-tab-dokumen"
          onclick="switchFormTab('dokumen')"
          role="tab"
          aria-selected="false"
          class="form-tab-btn inline-flex items-center px-5 py-3 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-900 transition-colors shrink-0 cursor-pointer"
        >
          <span>Dokumen Pendaftaran</span>
        </button>

        <button
          type="button"
          id="btn-form-tab-persetujuan"
          onclick="switchFormTab('persetujuan')"
          role="tab"
          aria-selected="false"
          class="form-tab-btn inline-flex items-center px-5 py-3 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-900 transition-colors shrink-0 cursor-pointer"
        >
          <span>Persetujuan Program</span>
        </button>
      </div>
    </div>

    <!-- PANE 1: TAHAP 1 - IDENTITAS & DATA STUDI -->
    <div id="form-tab-content-identitas" class="form-tab-pane space-y-6">
      <TabIdentitasStudi />
    </div>

    <!-- PANE 2: TAHAP 2 - DOKUMEN PENDAFTARAN -->
    <div id="form-tab-content-dokumen" class="form-tab-pane space-y-6 hidden">
      <TabDokumenPendaftaran />
    </div>

    <!-- PANE 3: TAHAP 3 - PERSETUJUAN PROGRAM -->
    <div id="form-tab-content-persetujuan" class="form-tab-pane space-y-6 hidden">
      <TabPersetujuanProgram />
    </div>

    <!-- Hidden compatibility elements for _controller.js -->
    <div class="hidden" aria-hidden="true">
      <button type="button" id="btn-form-tab-akademik"></button>
      <button type="button" id="btn-form-tab-berkas"></button>
      <button type="button" id="btn-form-tab-konversi"></button>
      <button type="button" id="btn-form-tab-surekom"></button>
      <div id="form-tab-content-akademik"></div>
      <div id="form-tab-content-berkas"></div>
      <div id="form-tab-content-konversi"></div>
      <div id="form-tab-content-surekom"></div>
      <input type="hidden" id="cfg-konversi-sks-max" value="20" />
      <input type="hidden" id="cfg-durasi-minimal" value="5" />
      <input type="hidden" id="cfg-ipk-min" value="3.00" />
      <input type="hidden" id="cfg-semester-min" value="5" />
      <input type="hidden" id="cfg-sks-min" value="80" />
      <textarea id="cfg-surekom-template" class="hidden"></textarea>
      <input type="hidden" id="cfg-surekom-cutoff" value="" />
      <button type="button" id="toggle-cfg-ttdDigital"></button>
      <button type="button" id="toggle-cfg-paktaIntegritas"></button>
      <button type="button" id="toggle-cfg-wajibDrafMk"></button>
    </div>
  </section>

  <!-- Script Penyelarasan Tab Switcher -->
  <script is:inline>
    function switchFormTab(tabId) {
      // Alias dukungan tab
      if (tabId === 'akademik') tabId = 'identitas';
      if (tabId === 'berkas') tabId = 'dokumen';
      if (tabId === 'konversi' || tabId === 'surekom') tabId = 'persetujuan';

      const tabs = ['identitas', 'dokumen', 'persetujuan'];
      tabs.forEach((t) => {
        const btn = document.getElementById('btn-form-tab-' + t);
        const pane = document.getElementById('form-tab-content-' + t);
        if (t === tabId) {
          if (btn) {
            btn.className = 'form-tab-btn inline-flex items-center px-5 py-3 text-sm font-semibold border-b-2 border-primary-600 text-primary-700 transition-colors shrink-0 cursor-pointer';
            btn.setAttribute('aria-selected', 'true');
          }
          if (pane) pane.classList.remove('hidden');
        } else {
          if (btn) {
            btn.className = 'form-tab-btn inline-flex items-center px-5 py-3 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-900 transition-colors shrink-0 cursor-pointer';
            btn.setAttribute('aria-selected', 'false');
          }
          if (pane) pane.classList.add('hidden');
        }
      });
      if (typeof lucide !== 'undefined') lucide.createIcons();
    }

    function handleSaveFormPendaftaran() {
      alert('Konfigurasi formulir pendaftaran mahasiswa berhasil disimpan!');
    }

    document.addEventListener('DOMContentLoaded', () => {
      if (typeof lucide !== 'undefined') lucide.createIcons();
    });
  </script>
</AdminShell>
