---
// src/pages/admin/konversi.astro
import AdminShell from '../../layouts/AdminShell.astro';
import ModalVerifikasiKonversi from '../../components/admin/modals/ModalVerifikasiKonversi.astro';
---

<AdminShell currentTab="konversi">
  <section
    id="section-konversi"
    class="flex flex-col flex-1 min-h-0 space-y-4 pr-1 overflow-y-auto tab-content font-sans"
    x-data="{
      searchQuery: '',
      statusFilter: 'semua',
      currentPage: 1,
      pageSize: 10,

      isVerifOpen: false,
      verifTarget: null,
      verifRows: [],
      verifCatatan: '',

      toast: { show: false, message: '' },

      konversiList: [
        {
          id: 1, nim: 'A11.2022.13901', nama: 'Faisal Rahman', mitra: 'Bengkel Koding', sks: 20, status: 'Disetujui',
          matkul: [
            { kode: 'A11.54403', nama: 'Rekayasa Perangkat Lunak Lanjut', sks: 4, aktivitas: 'Sprint Planning dan Agile Scrum Architecture' },
            { kode: 'A11.54608', nama: 'Pemrograman Web Berbasis Komponen', sks: 4, aktivitas: 'Frontend React dan Next.js Microservices' },
            { kode: 'A11.54701', nama: 'Magang Industri dan Studi Terapan', sks: 6, aktivitas: 'Full-time Placement di Bengkel Koding' },
            { kode: 'A11.54502', nama: 'Komunikasi Profesional dan Etika Profesi', sks: 2, aktivitas: 'Daily Standup dan Client Stakeholder Review' },
            { kode: 'A11.54804', nama: 'Proyek Capstone MBKM', sks: 4, aktivitas: 'Deliverable Platform Aplikasi Production' }
          ]
        },
        {
          id: 2, nim: 'A11.2022.14012', nama: 'Rizky Aditya Pratama', mitra: 'PT Matic Edukasi Mandiri', sks: 24, status: 'Belum Ditinjau',
          matkul: [
            { kode: 'A11.54403', nama: 'Rekayasa Perangkat Lunak Lanjut', sks: 4, aktivitas: 'Sprint Planning Produk EdTech' },
            { kode: 'A11.54608', nama: 'Pemrograman Web Berbasis Komponen', sks: 4, aktivitas: 'Frontend Vue dan Nuxt Modular' },
            { kode: 'A11.54609', nama: 'Basis Data Terdistribusi', sks: 4, aktivitas: 'Desain Skema Multi-tenant LMS' },
            { kode: 'A11.54701', nama: 'Magang Industri dan Studi Terapan', sks: 6, aktivitas: 'Full-time Placement di PT Matic Edukasi Mandiri' },
            { kode: 'A11.54502', nama: 'Komunikasi Profesional dan Etika Profesi', sks: 2, aktivitas: 'Sosialisasi Produk dan Demo Klien' },
            { kode: 'A11.54804', nama: 'Proyek Capstone MBKM', sks: 4, aktivitas: 'Deliverable Modul Learning Management System' }
          ]
        },
        {
          id: 3, nim: 'A11.2020.13158', nama: 'Tarissa Aura Azzahra', mitra: 'PT Tokopedia', sks: 20, status: 'Revisi',
          matkul: [
            { kode: 'A11.54403', nama: 'Rekayasa Perangkat Lunak Lanjut', sks: 4, aktivitas: 'Microservices Order Management' },
            { kode: 'A11.54608', nama: 'Pemrograman Web Berbasis Komponen', sks: 4, aktivitas: 'Frontend React Design System' },
            { kode: 'A11.54701', nama: 'Magang Industri dan Studi Terapan', sks: 6, aktivitas: 'Full-time Placement di PT Tokopedia' },
            { kode: 'A11.54502', nama: 'Komunikasi Profesional dan Etika Profesi', sks: 2, aktivitas: 'Squad Ritual dan Review Berkala' },
            { kode: 'A11.54804', nama: 'Proyek Capstone MBKM', sks: 4, aktivitas: 'Deliverable Fitur Checkout' }
          ]
        },
        {
          id: 4, nim: 'A12.2022.09842', nama: 'Nabila Zahra Putri', mitra: 'Ryuje Tech Solusindo', sks: 15, status: 'Disetujui',
          matkul: [
            { kode: 'A11.54403', nama: 'Rekayasa Perangkat Lunak Lanjut', sks: 4, aktivitas: 'Sprint Planning Produk Internal' },
            { kode: 'A11.54608', nama: 'Pemrograman Web Berbasis Komponen', sks: 4, aktivitas: 'Frontend Laravel Livewire' },
            { kode: 'A11.54701', nama: 'Magang Industri dan Studi Terapan', sks: 5, aktivitas: 'Full-time Placement di Ryuje Tech Solusindo' },
            { kode: 'A11.54502', nama: 'Komunikasi Profesional dan Etika Profesi', sks: 2, aktivitas: 'Dokumentasi Teknis dan Review Klien' }
          ]
        },
        {
          id: 5, nim: 'A11.2021.13450', nama: 'Dimas Wahyu Nugroho', mitra: 'PT Bank Central Asia Tbk', sks: 12, status: 'Revisi',
          matkul: [
            { kode: 'A11.54403', nama: 'Rekayasa Perangkat Lunak Lanjut', sks: 4, aktivitas: 'Sprint Planning Core Banking' },
            { kode: 'A11.54609', nama: 'Basis Data Terdistribusi', sks: 4, aktivitas: 'Optimasi Query Transaksi Harian' },
            { kode: 'A11.54502', nama: 'Komunikasi Profesional dan Etika Profesi', sks: 2, aktivitas: 'Koordinasi Vendor dan Dokumentasi' },
            { kode: 'A11.54901', nama: 'Keamanan Informasi', sks: 2, aktivitas: 'Implementasi Standar OWASP' }
          ]
        },
        {
          id: 6, nim: 'A12.2022.09911', nama: 'Siti Aminah', mitra: 'Shopee Indonesia', sks: 20, status: 'Belum Ditinjau',
          matkul: [
            { kode: 'A11.54403', nama: 'Rekayasa Perangkat Lunak Lanjut', sks: 4, aktivitas: 'Sprint Planning Marketplace' },
            { kode: 'A11.54608', nama: 'Pemrograman Web Berbasis Komponen', sks: 4, aktivitas: 'Frontend React Native Web' },
            { kode: 'A11.54701', nama: 'Magang Industri dan Studi Terapan', sks: 6, aktivitas: 'Full-time Placement di Shopee Indonesia' },
            { kode: 'A11.54502', nama: 'Komunikasi Profesional dan Etika Profesi', sks: 2, aktivitas: 'Squad Ritual dan Stakeholder Review' },
            { kode: 'A11.54804', nama: 'Proyek Capstone MBKM', sks: 4, aktivitas: 'Deliverable Fitur Seller Center' }
          ]
        }
      ],

      get filteredList() {
        return this.konversiList.filter(item => {
          const matchStatus = this.statusFilter === 'semua' || item.status === this.statusFilter;
          const q = this.searchQuery.trim().toLowerCase();
          const matchSearch = q === '' ||
            item.nama.toLowerCase().includes(q) ||
            item.nim.toLowerCase().includes(q) ||
            item.mitra.toLowerCase().includes(q);
          return matchStatus && matchSearch;
        });
      },

      get paginatedList() {
        const start = (this.currentPage - 1) * this.pageSize;
        return this.filteredList.slice(start, start + this.pageSize);
      },

      get totalPages() {
        return Math.max(1, Math.ceil(this.filteredList.length / this.pageSize));
      },

      get verifTotalSks() {
        return this.verifRows.reduce((sum, r) => sum + r.sks, 0);
      },

      get verifAllChecked() {
        return this.verifRows.length > 0 && this.verifRows.every(r => r.checked);
      },

      openVerifikasi(item) {
        this.verifTarget = item;
        this.verifRows = (item.matkul || []).map(m => ({ ...m, checked: item.status === 'Disetujui' }));
        this.verifCatatan = item.catatan || '';
        this.isVerifOpen = true;
        this.reinitLucide();
      },

      closeVerifikasi() {
        this.isVerifOpen = false;
        this.verifTarget = null;
        this.verifRows = [];
        this.verifCatatan = '';
      },

      toggleAllVerif() {
        const next = !this.verifAllChecked;
        this.verifRows.forEach(r => { r.checked = next; });
      },

      submitVerifikasi(mode) {
        if (!this.verifTarget) return;

        const target = this.verifTarget;
        const nama = target.nama;

        if (mode === 'setuju') {
          target.status = 'Disetujui';
          target.catatan = this.verifCatatan.trim();
          target.matkul.forEach(m => { m.disetujui = true; });
          this.closeVerifikasi();
          this.showToast(`Konversi ${this.verifTotalSks} SKS untuk ${nama} berhasil disahkan.`);
          return;
        }

        target.status = 'Revisi';
        target.catatan = this.verifCatatan.trim();
        this.verifRows.forEach((r, i) => {
          target.matkul[i].disetujui = r.checked;
        });
        this.closeVerifikasi();
        this.showToast(`Revisi dikirim ke ${nama}. Mahasiswa harus mengajukan ulang konversi.`);
      },

      showToast(message) {
        this.toast = { show: true, message };
        this.reinitLucide();
        window.clearTimeout(this._toastTimer);
        this._toastTimer = window.setTimeout(() => {
          this.toast = { show: false, message: '' };
        }, 3500);
      },

      reinitLucide() {
        this.$nextTick(() => {
          if (typeof lucide !== 'undefined') lucide.createIcons();
        });
      }
    }"
  >
    <!-- Toolbar: Pencarian & Filter Status -->
    <div class="flex flex-col sm:flex-row gap-3 items-stretch sm:items-center justify-between">
      <div class="w-full sm:w-80">
        <div class="relative w-full">
          <i data-lucide="search" class="absolute left-3 top-1/2 transform -translate-y-1/2 w-4 h-4 text-[#71717a]"></i>
          <input
            type="text"
            x-model="searchQuery"
            @input="currentPage = 1; reinitLucide()"
            placeholder="Cari mahasiswa, NIM, atau mitra..."
            class="w-full h-10 pl-9 pr-9 rounded-md border border-[#e4e4e7] bg-white text-sm text-[#09090b] placeholder:text-[#71717a] focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
          />
          <button
            type="button"
            x-show="searchQuery.length > 0"
            @click="searchQuery = ''; currentPage = 1; reinitLucide()"
            class="absolute right-3 top-1/2 transform -translate-y-1/2 text-[#71717a] hover:text-[#09090b] cursor-pointer"
          >
            <i data-lucide="x" class="w-4 h-4"></i>
          </button>
        </div>
      </div>

      <div class="w-full sm:w-[200px] flex-shrink-0 sm:ml-auto">
        <div class="relative">
          <select
            x-model="statusFilter"
            @change="currentPage = 1; reinitLucide()"
            class="h-10 w-full rounded-md border border-[#e4e4e7] bg-white px-3 pr-8 text-sm text-[#09090b] focus:outline-none focus:ring-1 focus:ring-[#0655a7] cursor-pointer appearance-none"
          >
            <option value="semua">Semua Status</option>
            <option value="Belum Ditinjau">Belum Ditinjau</option>
            <option value="Disetujui">Disetujui</option>
            <option value="Revisi">Revisi</option>
          </select>
          <i data-lucide="chevron-down" class="w-4 h-4 text-[#71717a] absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none"></i>
        </div>
      </div>
    </div>

    <!-- Empty State -->
    <template x-if="filteredList.length === 0">
      <div class="flex flex-col items-center justify-center py-12 text-center h-[calc(100vh-300px)] bg-white rounded-md border border-[#e4e4e7]">
        <div class="rounded-full bg-[#f4f4f5] p-3 mb-4">
          <i data-lucide="arrow-left-right" class="h-6 w-6 text-[#71717a]"></i>
        </div>
        <h3 class="text-lg font-medium text-[#09090b]">Tidak ada data konversi</h3>
        <p class="text-sm text-[#71717a] mt-1 max-w-md">
          Belum ada usulan konversi SKS yang cocok dengan pencarian.
        </p>
      </div>
    </template>

    <!-- Tabel Konversi SKS -->
    <div class="rounded-lg border border-[#e4e4e7] overflow-hidden bg-white" x-show="filteredList.length > 0">
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="bg-[#fafafa] border-b border-[#e4e4e7]">
            <tr>
              <th class="h-11 px-4 font-semibold text-xs w-12 text-center text-[#71717a]">No.</th>
              <th class="h-11 px-4 font-semibold text-xs text-left text-[#71717a] min-w-[200px]">Mahasiswa</th>
              <th class="h-11 px-4 font-semibold text-xs text-left text-[#71717a] min-w-[180px]">MBKM</th>
              <th class="h-11 px-4 font-semibold text-xs text-center text-[#71717a] w-24">SKS</th>
              <th class="h-11 px-4 font-semibold text-xs text-center text-[#71717a] min-w-[140px]">Status</th>
              <th class="h-11 px-4 font-semibold text-xs text-center text-[#71717a] w-32">Aksi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#e4e4e7]">
            <template x-for="(item, idx) in paginatedList" :key="item.id">
              <tr class="hover:bg-[#f4f4f5]/60 transition-colors">
                <td class="h-[68px] px-2 text-center text-xs font-medium text-[#71717a] w-12" x-text="((currentPage - 1) * pageSize) + (idx + 1)"></td>

                <td class="h-[68px] px-4 text-sm">
                  <div class="flex items-center gap-3">
                    <div class="h-9 w-9 rounded-full bg-[#f4f4f5] text-[#0655a7] font-semibold text-xs flex items-center justify-center shrink-0 border border-[#e4e4e7]">
                      <span x-text="item.nama.charAt(0)"></span>
                    </div>
                    <div class="flex flex-col leading-tight gap-0.5">
                      <span class="font-semibold text-[#09090b] text-sm" x-text="item.nama"></span>
                      <span class="text-xs text-[#71717a]" x-text="item.nim"></span>
                    </div>
                  </div>
                </td>

                <td class="h-[68px] px-4 text-sm text-[#09090b]" x-text="item.mitra"></td>

                <td class="h-[68px] px-4 text-center text-sm font-semibold text-[#0655a7]" x-text="`${item.sks} SKS`"></td>

                <td class="h-[68px] px-4 text-center text-sm">
                  <template x-if="item.status === 'Disetujui'">
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-xs font-semibold bg-emerald-50 border border-emerald-200 text-emerald-800">
                      Disetujui
                    </span>
                  </template>
                  <template x-if="item.status === 'Revisi'">
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-xs font-semibold bg-amber-50 border border-amber-200 text-amber-800">
                      Revisi
                    </span>
                  </template>
                  <template x-if="item.status === 'Belum Ditinjau'">
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-xs font-medium bg-[#f4f4f5] border border-[#e4e4e7] text-[#71717a]">
                      Belum Ditinjau
                    </span>
                  </template>
                </td>

                <td class="h-[68px] px-4 text-center text-sm">
                  <button
                    type="button"
                    @click="openVerifikasi(item)"
                    class="h-8 px-3.5 inline-flex items-center justify-center rounded-md bg-[#0655a7] hover:bg-[#114D91] text-white text-xs font-semibold shadow-none transition-colors cursor-pointer"
                  >
                    <span>Verifikasi</span>
                  </button>
                </td>
              </tr>
            </template>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Standardized Pagination Sesuai Screenshot 1 & Design System -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-2 pt-1" x-show="filteredList.length > 0">
      <div class="text-xs text-[#71717a]" x-text="'Menampilkan ' + (filteredList.length === 0 ? 0 : ((currentPage - 1) * pageSize + 1)) + ' - ' + Math.min(currentPage * pageSize, filteredList.length) + ' dari ' + filteredList.length + ' data'"></div>
      <div class="flex items-center gap-1.5">
        <button
          type="button"
          @click="if (currentPage > 1) { currentPage--; reinitLucide(); }"
          :disabled="currentPage <= 1"
          :class="currentPage <= 1 ? 'opacity-50 cursor-not-allowed hover:bg-white text-[#71717a]' : 'hover:bg-[#f4f4f5] text-[#09090b]'"
          class="h-8 w-8 flex items-center justify-center rounded-md border border-[#e4e4e7] bg-white text-xs transition-colors cursor-pointer"
          title="Halaman Sebelumnya"
        >
          <i data-lucide="chevron-left" class="w-4 h-4"></i>
        </button>

        <template x-for="p in totalPages" :key="p">
          <button
            type="button"
            @click="currentPage = p; reinitLucide()"
            :class="currentPage === p ? 'bg-[#0655a7] text-white font-semibold shadow-none' : 'border border-[#e4e4e7] bg-white text-[#09090b] font-medium hover:bg-[#f4f4f5]'"
            class="h-8 w-8 flex items-center justify-center rounded-md text-xs transition-colors cursor-pointer"
            x-text="p"
          ></button>
        </template>

        <button
          type="button"
          @click="if (currentPage < totalPages) { currentPage++; reinitLucide(); }"
          :disabled="currentPage >= totalPages"
          :class="currentPage >= totalPages ? 'opacity-50 cursor-not-allowed hover:bg-white text-[#71717a]' : 'hover:bg-[#f4f4f5] text-[#09090b]'"
          class="h-8 w-8 flex items-center justify-center rounded-md border border-[#e4e4e7] bg-white text-xs transition-colors cursor-pointer"
          title="Halaman Selanjutnya"
        >
          <i data-lucide="chevron-right" class="w-4 h-4"></i>
        </button>

        <select
          x-model.number="pageSize"
          @change="currentPage = 1; reinitLucide()"
          class="h-8 rounded-md border border-[#e4e4e7] bg-white px-2 text-xs text-[#09090b] focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
        >
          <option value="5">Show 5 items</option>
          <option value="10">Show 10 items</option>
          <option value="25">Show 25 items</option>
          <option value="50">Show 50 items</option>
        </select>
      </div>
    </div>

    <!-- Modal Verifikasi Konversi -->
    <ModalVerifikasiKonversi />

    <!-- Toast -->
    <div
      x-show="toast.show"
      x-cloak
      x-transition.opacity.duration.200ms
      class="fixed bottom-6 right-6 z-[60] flex items-start gap-2.5 rounded-lg border border-green-400/60 bg-green-50 px-4 py-3 shadow-lg max-w-sm"
    >
      <i data-lucide="check-circle-2" class="h-4 w-4 text-green-600 mt-0.5 shrink-0"></i>
      <p class="text-xs font-medium text-green-700 leading-relaxed" x-text="toast.message"></p>
    </div>
  </section>
</AdminShell>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    if (typeof lucide !== 'undefined') lucide.createIcons();
  });
</script>
