---
// src/pages/admin/konversi.astro
import AdminShell from "../../layouts/AdminShell.astro";
---

<AdminShell currentTab="konversi">
<section
            id="section-konversi" x-show="$store.mbkm.currentSection === 'konversi'"
            class="flex flex-col flex-1 hidden min-h-0 gap-4 pr-1 overflow-y-auto tab-content"
          >
            <div class="flex flex-col gap-2.5 sm:flex-row sm:items-center sm:justify-between pb-0.5">
              <div>
                <h2 class="text-base font-semibold text-[#09090b]">Telaah & Pengesahan Konversi SKS</h2>
                <p class="text-[11px] text-[#71717a]">
                  Verifikasi ekuivalensi usulan mata kuliah terhadap Capaian Pembelajaran Lulusan (CPL) kurikulum
                  program studi.
                </p>
              </div>
              <div class="flex items-center gap-2">
                <button
                  type="button"
                  onclick="openModalInfoSkemaSks()"
                  class="px-3 py-1.5 rounded-lg border border-[#e4e4e7] bg-white hover:bg-gray-50 text-[#09090b] text-xs font-semibold flex items-center gap-1.5 shadow-2xs transition-colors shrink-0"
                >
                  <i data-lucide="help-circle" class="w-3.5 h-3.5 text-[#0655a7]"></i>
                  <span>Panduan 5 Skema SKS</span>
                </button>
                <button
                  type="button"
                  onclick="kunciKonversiMassal()"
                  class="px-3.5 py-1.5 rounded-lg bg-[#0655a7] hover:bg-[#114d91] text-white text-xs font-semibold flex items-center gap-1.5 shadow-2xs transition-colors shrink-0"
                >
                  <i data-lucide="lock" class="w-3.5 h-3.5"></i>
                  <span>Sahkan & Kunci Terpilih</span>
                </button>
              </div>
            </div>

            <!-- Banner Info 5 Skema SKS Dinamis -->
            <div class="flex items-start gap-3 p-3 border border-blue-200 bg-blue-50/70 rounded-xl">
              <div
                class="w-7 h-7 rounded-lg bg-blue-100 text-[#0655a7] flex items-center justify-center shrink-0 mt-0.5"
              >
                <i data-lucide="info" class="w-4 h-4"></i>
              </div>
              <div class="flex-1 text-xs">
                <div class="font-semibold text-[#0655a7] text-[13px]">
                  Ketentuan Batas Konversi SKS Dinamis Fakultas
                </div>
                <p class="text-[11px] text-[#3f3f46] mt-0.5">
                  Penetapan batas SKS konversi MBKM mengacu pada 5 skema resmi:
                  <span class="inline-flex font-semibold text-[#09090b]">10-12 SKS</span> (Magang Pendek),
                  <span class="inline-flex font-semibold text-[#09090b]">Maks 12 SKS</span> (Studi Independen Tertentu),
                  <span class="inline-flex font-semibold text-[#09090b]">Maks 15 SKS</span> (Kewirausahaan/Riset),
                  <span class="inline-flex font-semibold text-[#09090b]">Maks 20 SKS</span> (MSIB/Kampus Mengajar
                  Standar), dan <span class="inline-flex font-semibold text-[#09090b]">Maks 24 SKS</span> (Magang
                  Industri Full-time + Publikasi).
                </p>
              </div>
            </div>

            <!-- Tabel Konversi SKS -->
            <div class="overflow-x-auto rounded-xl border border-[#e4e4e7]">
              <table class="w-full text-xs text-left border-collapse">
                <thead class="bg-[#fafafa] border-b border-[#e4e4e7] text-[#3f3f46]">
                  <tr>
                    <th class="w-10 px-2.5 py-2 font-semibold text-center text-[11px]">
                      <input type="checkbox" onchange="toggleSelectAllKonversi(this)" class="rounded text-[#0655a7]" />
                    </th>
                    <th class="px-3 py-2 font-semibold text-[11px]">Mahasiswa & Prodi</th>
                    <th class="px-3 py-2 font-semibold text-[11px]">Program / Mitra</th>
                    <th class="px-3 py-2 font-semibold text-[11px]">Skema SKS Dipilih</th>
                    <th class="px-3 py-2 font-semibold text-center text-[11px]">Usulan SKS</th>
                    <th class="px-3 py-2 font-semibold text-[11px]">Matkul Ekuivalensi</th>
                    <th class="px-3 py-2 font-semibold text-center text-[11px]">Status Konversi</th>
                    <th class="w-32 px-3 py-2 font-semibold text-center text-[11px]">Aksi</th>
                  </tr>
                </thead>
                <tbody id="konversi-tbody-embed" class="divide-y divide-[#e4e4e7] bg-white">
                  <tr class="transition-colors hover:bg-blue-50/30">
                    <td class="px-2.5 py-2.5 text-center">
                      <input type="checkbox" class="check-konversi-row rounded text-[#0655a7]" value="A11.2022.13901" />
                    </td>
                    <td class="px-3 py-2.5">
                      <div class="font-semibold text-[#09090b]">Faisal Rahman</div>
                      <div class="text-[10px] text-[#71717a]">A11.2022.13901 • Teknik Informatika</div>
                    </td>
                    <td class="px-3 py-2.5">
                      <div class="font-semibold text-[#3f3f46]">Bengkel Koding</div>
                      <div class="text-[10px] text-[#71717a]">Magang MSIB Kampus Merdeka</div>
                    </td>
                    <td class="px-3 py-2.5">
                      <span
                        class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-blue-50 text-[#0655a7] border border-blue-200"
                      >
                        Maks 20 SKS
                      </span>
                    </td>
                    <td class="px-3 py-2.5 text-center">
                      <span class="font-bold text-[#0655a7]">20</span>
                      <span class="text-[10px] text-[#71717a]">/ 20 SKS</span>
                    </td>
                    <td class="px-3 py-2.5">
                      <div class="text-[11px] font-medium text-[#3f3f46]">5 Mata Kuliah Terpetakan</div>
                      <div class="text-[10px] text-emerald-700">CPL Capaian: 100% Sesuai</div>
                    </td>
                    <td class="px-3 py-2.5 text-center">
                      <span
                        class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-amber-50 text-amber-700 border border-amber-200"
                      >
                        Review Tim CPL
                      </span>
                    </td>
                    <td class="px-3 py-2.5 text-center">
                      <div class="flex items-center justify-center gap-1">
                        <button
                          type="button"
                          onclick="
                            openModalTelaahKonversi(
                              'Faisal Rahman',
                              'A11.2022.13901',
                              'Teknik Informatika',
                              'Bengkel Koding',
                              '20 SKS',
                              20,
                              5
                            )
                          "
                          class="px-2 py-1 rounded-md border border-[#e4e4e7] bg-white hover:bg-gray-50 text-[#0655a7] font-semibold text-[11px] shadow-2xs"
                        >
                          Telaah
                        </button>
                        <button
                          type="button"
                          onclick="kunciKonversiIndividu('A11.2022.13901', 'Faisal Rahman')"
                          class="px-2 py-1 rounded-md bg-[#0655a7] hover:bg-[#114d91] text-white font-semibold text-[11px] shadow-2xs flex items-center gap-1"
                        >
                          <i data-lucide="lock" class="w-3 h-3"></i>
                          <span>Kunci</span>
                        </button>
                      </div>
                    </td>
                  </tr>
                  <tr class="transition-colors hover:bg-blue-50/30">
                    <td class="px-2.5 py-2.5 text-center">
                      <input type="checkbox" class="check-konversi-row rounded text-[#0655a7]" value="A11.2022.14012" />
                    </td>
                    <td class="px-3 py-2.5">
                      <div class="font-semibold text-[#09090b]">Rizky Aditya Pratama</div>
                      <div class="text-[10px] text-[#71717a]">A11.2022.14012 • Teknik Informatika</div>
                    </td>
                    <td class="px-3 py-2.5">
                      <div class="font-semibold text-[#3f3f46]">PT Matic</div>
                      <div class="text-[10px] text-[#71717a]">Magang Industri + Luaran Publikasi</div>
                    </td>
                    <td class="px-3 py-2.5">
                      <span
                        class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-purple-50 text-purple-700 border border-purple-200"
                      >
                        Maks 24 SKS
                      </span>
                    </td>
                    <td class="px-3 py-2.5 text-center">
                      <span class="font-bold text-purple-700">24</span>
                      <span class="text-[10px] text-[#71717a]">/ 24 SKS</span>
                    </td>
                    <td class="px-3 py-2.5">
                      <div class="text-[11px] font-medium text-[#3f3f46]">6 Mata Kuliah Terpetakan</div>
                      <div class="text-[10px] text-purple-700">+ 1 Publikasi Ilmiah SINTA</div>
                    </td>
                    <td class="px-3 py-2.5 text-center">
                      <span
                        class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200"
                      >
                        Disetujui Kaprodi
                      </span>
                    </td>
                    <td class="px-3 py-2.5 text-center">
                      <div class="flex items-center justify-center gap-1">
                        <button
                          type="button"
                          onclick="
                            openModalTelaahKonversi(
                              'Rizky Aditya Pratama',
                              'A11.2022.14012',
                              'Teknik Informatika',
                              'PT Matic',
                              '24 SKS',
                              24,
                              6
                            )
                          "
                          class="px-2 py-1 rounded-md border border-[#e4e4e7] bg-white hover:bg-gray-50 text-[#0655a7] font-semibold text-[11px] shadow-2xs"
                        >
                          Telaah
                        </button>
                        <button
                          type="button"
                          onclick="kunciKonversiIndividu('A11.2022.14012', 'Rizky Aditya Pratama')"
                          class="px-2 py-1 rounded-md bg-[#0655a7] hover:bg-[#114d91] text-white font-semibold text-[11px] shadow-2xs flex items-center gap-1"
                        >
                          <i data-lucide="lock" class="w-3 h-3"></i>
                          <span>Kunci</span>
                        </button>
                      </div>
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>

            <!-- Pagination & Info -->
            <div class="flex flex-col sm:flex-row items-center justify-between gap-2 pt-0.5">
              <div class="text-[11px] text-[#71717a]">Menampilkan 1 - 5 dari 28 usulan konversi SKS</div>
              <div class="flex items-center gap-2.5">
                <div class="flex items-center gap-1">
                  <button
                    type="button"
                    class="flex items-center justify-center w-8 h-8 rounded-lg border border-[#e4e4e7] bg-white text-[#71717a] hover:bg-gray-50 text-xs transition-colors"
                    title="Sebelumnya"
                  >
                    <i data-lucide="chevron-left" class="w-4 h-4"></i>
                  </button>
                  <button
                    type="button"
                    class="flex items-center justify-center w-8 h-8 rounded-lg bg-[#0655a7] text-white font-semibold text-xs shadow-2xs"
                  >
                    1
                  </button>
                  <button
                    type="button"
                    class="flex items-center justify-center w-8 h-8 rounded-lg border border-[#e4e4e7] bg-white text-[#71717a] hover:bg-gray-50 text-xs transition-colors"
                    title="Selanjutnya"
                  >
                    <i data-lucide="chevron-right" class="w-4 h-4"></i>
                  </button>
                </div>
                <div class="relative">
                  <select
                    class="appearance-none pl-3 pr-8 py-1.5 text-xs font-medium text-[#09090b] bg-white border border-[#0655a7] rounded-lg focus:outline-none cursor-pointer"
                  >
                    <option value="10">Show 10 items</option>
                    <option value="25">Show 25 items</option>
                    <option value="50">Show 50 items</option>
                  </select>
                  <i
                    data-lucide="chevron-down"
                    class="w-3.5 h-3.5 text-[#09090b] absolute right-2.5 top-1/2 -translate-y-1/2 pointer-events-none"
                  ></i>
                </div>
              </div>
            </div>
          </section>
</AdminShell>
