---
// src/pages/admin/data-mahasiswa.astro
import AdminShell from '../../layouts/AdminShell.astro';
---

<AdminShell currentTab="mhs-data">
  <section
    id="section-mhs-data"
    class="flex flex-col flex-1 min-h-0 gap-4 pr-1 overflow-y-auto tab-content"
    x-data="{
      searchQuery: '',
      sortOption: 'nama_asc',
      isImportModalOpen: false,
      selectedFile: null,
      get filteredStudents() {
        const q = (this.searchQuery || '').toLowerCase();
        let list = this.students.filter(s =>
          (s.nama || '').toLowerCase().includes(q) || (s.nim || '').includes(q)
        );
        switch (this.sortOption) {
          case 'nama_asc':  list = [...list].sort((a, b) => a.nama.localeCompare(b.nama)); break;
          case 'nama_desc': list = [...list].sort((a, b) => b.nama.localeCompare(a.nama)); break;
          case 'nim_asc':   list = [...list].sort((a, b) => a.nim.localeCompare(b.nim)); break;
          case 'nim_desc':  list = [...list].sort((a, b) => b.nim.localeCompare(a.nim)); break;
          case 'dosen_asc': list = [...list].sort((a, b) => (a.dosen || '').localeCompare(b.dosen || '')); break;
          case 'dosen_none':
            list = [...list].sort((a, b) => {
              const aEmpty = !a.dosen || a.dosen === '-';
              const bEmpty = !b.dosen || b.dosen === '-';
              return aEmpty === bEmpty ? 0 : aEmpty ? -1 : 1;
            });
            break;
        }
        return list;
      },
      students: [
        { no: 1, nama: 'Faisal Rahman', nim: 'A11.2022.13901', email: 'faisal.rahman@mhs.dinus.ac.id', telepon: '081234567890', dosen: 'Dr. M. Arief Soeleman, M.Kom', kodePeriode: '20261', tahunAjaran: '2026/2027', status: 'konversi' },
        { no: 2, nama: 'Nabila Zahra Putri', nim: 'A12.2022.09842', email: 'nabila.zahra@mhs.dinus.ac.id', telepon: '082198765432', dosen: 'Christy Atika Sari, M.Kom', kodePeriode: '20261', tahunAjaran: '2026/2027', status: 'konversi' },
        { no: 3, nama: 'Rizky Aditya Pratama', nim: 'A11.2022.14012', email: 'rizky.aditya@mhs.dinus.ac.id', telepon: '085712349876', dosen: 'Eko Hari Rachmawanto, M.Kom', kodePeriode: '20261', tahunAjaran: '2026/2027', status: 'reguler' },
        { no: 4, nama: 'Dewi Lestari Kusuma', nim: 'A14.2022.03211', email: 'dewi.lestari@mhs.dinus.ac.id', telepon: '087834561234', dosen: 'Ajib Susanto, M.Kom', kodePeriode: '20261', tahunAjaran: '2026/2027', status: 'reguler' },
        { no: 5, nama: 'Budi Santoso', nim: 'A11.2022.14150', email: 'budi.santoso@mhs.dinus.ac.id', telepon: '081399887766', dosen: '-', kodePeriode: '20261', tahunAjaran: '2026/2027', status: 'belum' },
      ]
    }"
  >
    <!-- Toolbar Style KP -->
    <div class="flex flex-col md:flex-row gap-3 items-start md:items-center justify-between">
      <!-- Search Input -->
      <div class="relative w-full sm:w-72 md:w-80">
        <i data-lucide="search" class="w-4 h-4 text-[#71717a] absolute left-3 top-1/2 -translate-y-1/2"></i>
        <input
          type="text"
          x-model="searchQuery"
          placeholder="Cari Mahasiswa..."
          class="h-9 w-full rounded-md border border-[#e4e4e7] bg-white pl-9 pr-3 text-sm text-[#09090b] placeholder:text-[#71717a] focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
        />
      </div>

      <!-- Action Buttons Right -->
      <div class="flex items-center gap-2 ml-auto flex-wrap">
        <!-- Sort Selector -->
        <select
          x-model="sortOption"
          class="h-9 rounded-md border border-[#e4e4e7] bg-white px-3 text-xs text-[#09090b] focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
        >
          <option value="nama_asc">Nama (A - Z)</option>
          <option value="nama_desc">Nama (Z - A)</option>
          <option value="nim_asc">NIM Terkecil</option>
          <option value="nim_desc">NIM Terbesar</option>
          <option value="dosen_asc">Dosen (A - Z)</option>
          <option value="dosen_none">Belum Ada Dosen</option>
        </select>

        <!-- Download Excel -->
        <button
          type="button"
          onclick="alert('Mengunduh data mahasiswa dalam format Excel (XLSX)...')"
          class="inline-flex items-center gap-2 h-9 px-3.5 rounded-md bg-white border border-[#e4e4e7] hover:bg-[#f4f4f5] text-xs font-medium text-[#09090b] transition-colors"
        >
          <i data-lucide="download" class="w-4 h-4 text-[#71717a]"></i>
          <span>Download Excel</span>
        </button>

        <!-- Dropdown Tambah Mahasiswa -->
        <div class="relative" x-data="{ openMenu: false }">
          <button
            type="button"
            @click="openMenu = !openMenu"
            @click.outside="openMenu = false"
            class="inline-flex items-center gap-2 h-9 px-3.5 rounded-md bg-[#0655a7] hover:bg-[#0655a7]/90 text-white text-xs font-medium shadow-none transition-colors"
          >
            <i data-lucide="plus" class="w-4 h-4"></i>
            <span>Tambah Mahasiswa</span>
            <i data-lucide="chevron-down" class="w-3.5 h-3.5 opacity-80"></i>
          </button>

          <div
            x-show="openMenu"
            x-cloak
            class="absolute right-0 mt-1 w-48 rounded-md border border-[#e4e4e7] bg-white py-1 shadow-md z-20 text-xs"
          >
            <button
              type="button"
              @click="openMenu = false; alert('Mengunduh template data mahasiswa...')"
              class="w-full flex items-center gap-2 px-3 py-2 text-left text-[#09090b] hover:bg-[#f4f4f5] transition-colors"
            >
              <i data-lucide="file-spreadsheet" class="w-4 h-4 text-emerald-600"></i>
              <span>Download Template</span>
            </button>
            <button
              type="button"
              @click="openMenu = false; isImportModalOpen = true"
              class="w-full flex items-center gap-2 px-3 py-2 text-left text-[#09090b] hover:bg-[#f4f4f5] transition-colors"
            >
              <i data-lucide="import" class="w-4 h-4 text-[#0655a7]"></i>
              <span>Import Mahasiswa</span>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Tabel Data Mahasiswa Style KP -->
    <div class="rounded-lg border border-[#e4e4e7] overflow-hidden bg-white">
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="border-b border-[#e4e4e7] bg-[#fafafa]">
            <tr>
              <th class="h-11 px-4 font-medium text-sm w-16 text-center text-[#71717a]">No</th>
              <th class="h-11 px-4 font-medium text-sm text-left text-[#71717a]">Nama</th>
              <th class="h-11 px-4 font-medium text-sm text-left text-[#71717a]">Kontak</th>
              <th class="h-11 px-4 font-medium text-sm text-left text-[#71717a]">Dosen Pembimbing</th>
              <th class="h-11 px-4 font-medium text-sm text-left text-[#71717a]">Periode</th>
              <th class="h-11 px-4 font-medium text-sm text-center text-[#71717a]">Status</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#e4e4e7]">
          <template x-for="(mhs, idx) in filteredStudents" :key="mhs.nim">
            <tr class="hover:bg-[#fafafa] transition-colors">
              <td class="h-[68px] px-4 text-center text-sm text-[#71717a]" x-text="idx + 1"></td>
              <td class="h-[68px] px-4 text-sm">
                <div class="flex items-center gap-3">
                  <div class="h-9 w-9 rounded-full bg-[#f4f4f5] text-[#0655a7] font-semibold text-xs flex items-center justify-center shrink-0 border border-[#e4e4e7]">
                    <span x-text="mhs.nama.charAt(0)"></span>
                  </div>
                  <div class="flex flex-col">
                    <span class="font-semibold text-[#09090b] text-sm" x-text="mhs.nama"></span>
                    <span class="text-xs text-[#71717a]" x-text="mhs.nim"></span>
                  </div>
                </div>
              </td>
              <td class="h-[68px] px-4 text-sm">
                <div class="flex flex-col gap-0.5 text-xs">
                  <div class="flex items-center gap-1.5 text-[#09090b]">
                    <i data-lucide="mail" class="w-3.5 h-3.5 text-[#71717a]"></i>
                    <span x-text="mhs.email"></span>
                  </div>
                  <div class="flex items-center gap-1.5 text-[#71717a]">
                    <i data-lucide="phone" class="w-3.5 h-3.5 text-[#71717a]"></i>
                    <span x-text="mhs.telepon"></span>
                  </div>
                </div>
              </td>
              <td class="h-[68px] px-4 text-sm text-[#09090b]" x-text="mhs.dosen"></td>
              <td class="h-[68px] px-4 text-sm">
                <div class="flex flex-col">
                  <span class="text-sm font-medium text-[#09090b]" x-text="mhs.kodePeriode"></span>
                  <span class="text-xs text-[#71717a]" x-text="mhs.tahunAjaran"></span>
                </div>
              </td>
              <td class="h-[68px] px-4 text-center text-sm">
                <template x-if="mhs.status === 'konversi'">
                  <span class="inline-flex items-center px-2 py-1 rounded text-xs font-medium bg-blue-100 text-blue-800">
                    Konversi
                  </span>
                </template>
                <template x-if="mhs.status === 'reguler'">
                  <span class="inline-flex items-center px-2 py-1 rounded text-xs font-medium bg-green-100 text-green-800">
                    Reguler
                  </span>
                </template>
                <template x-if="mhs.status === 'belum'">
                  <span class="inline-flex items-center px-2 py-1 rounded text-xs font-medium bg-gray-100 text-gray-500">
                    Belum Ada
                  </span>
                </template>
              </td>
            </tr>
          </template>
        </tbody>
      </table>
      </div>
    </div>

    <!-- Standardized Pagination Sesuai Screenshot 1 -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-2 pt-1">
      <div class="text-xs text-[#71717a]">Menampilkan 1 - 5 dari 186 data</div>
      <div class="flex items-center gap-2">
        <button
          type="button"
          disabled
          class="h-8 w-8 flex items-center justify-center rounded-md border border-[#e4e4e7] bg-white text-[#71717a] opacity-50 cursor-not-allowed hover:bg-gray-50"
        >
          <i data-lucide="chevron-left" class="w-4 h-4"></i>
        </button>
        <button
          type="button"
          class="h-8 w-8 flex items-center justify-center rounded-md bg-[#0655a7] text-white font-semibold text-xs shadow-none"
        >
          1
        </button>
        <button
          type="button"
          class="h-8 w-8 flex items-center justify-center rounded-md border border-[#e4e4e7] bg-white text-[#09090b] font-medium text-xs hover:bg-[#f4f4f5]"
        >
          2
        </button>
        <button
          type="button"
          class="h-8 w-8 flex items-center justify-center rounded-md border border-[#e4e4e7] bg-white text-[#09090b] font-medium text-xs hover:bg-[#f4f4f5]"
        >
          3
        </button>
        <button
          type="button"
          class="h-8 w-8 flex items-center justify-center rounded-md border border-[#e4e4e7] bg-white text-[#09090b] hover:bg-[#f4f4f5]"
        >
          <i data-lucide="chevron-right" class="w-4 h-4"></i>
        </button>
        <select
          class="h-8 rounded-md border border-[#e4e4e7] bg-white px-2 text-xs text-[#09090b] focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
        >
          <option value="10">Show 10 items</option>
          <option value="25">Show 25 items</option>
          <option value="50">Show 50 items</option>
        </select>
      </div>
    </div>

    <!-- Modal Import Mahasiswa -->
    <div
      x-show="isImportModalOpen"
      x-cloak
      class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4"
    >
      <div
        @click.outside="isImportModalOpen = false"
        class="w-full max-w-md rounded-xl bg-white p-6 shadow-xl border border-[#e4e4e7] space-y-4"
      >
        <div class="flex items-center justify-between">
          <h3 class="text-base font-semibold text-[#09090b]">Import Data Mahasiswa</h3>
          <button
            type="button"
            @click="isImportModalOpen = false"
            class="h-8 w-8 rounded-md hover:bg-[#f4f4f5] text-[#71717a] flex items-center justify-center"
          >
            <i data-lucide="x" class="w-4 h-4"></i>
          </button>
        </div>
        <p class="text-xs text-[#71717a] leading-relaxed">
          Gunakan file template Excel dengan format kolom resmi (NIM, Nama Mahasiswa, Email, No Telp). Data akan otomatis disinkronkan ke periode aktif.
        </p>
        <div class="rounded-lg border-2 border-dashed border-[#e4e4e7] p-6 text-center hover:border-[#0655a7] transition-colors cursor-pointer bg-[#fafafa]">
          <i data-lucide="upload-cloud" class="w-8 h-8 text-[#0655a7] mx-auto mb-2"></i>
          <p class="text-xs font-medium text-[#09090b]">Pilih atau seret file Excel ke sini</p>
          <p class="text-[10px] text-[#71717a] mt-1">Mendukung format .xlsx atau .xls (maks 5MB)</p>
        </div>
        <div class="flex items-center justify-end gap-2 pt-2">
          <button
            type="button"
            @click="isImportModalOpen = false"
            class="h-9 px-4 rounded-md border border-[#e4e4e7] text-xs font-medium text-[#71717a] hover:bg-[#f4f4f5]"
          >
            Batal
          </button>
          <button
            type="button"
            @click="isImportModalOpen = false; alert('Data mahasiswa berhasil diimport!')"
            class="h-9 px-4 rounded-md bg-[#0655a7] hover:bg-[#0655a7]/90 text-white text-xs font-medium"
          >
            Upload & Import
          </button>
        </div>
      </div>
    </div>
  </section>
</AdminShell>
