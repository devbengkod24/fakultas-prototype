---
// src/pages/admin/kontributor/kelola-program.astro
import AdminShell from '../../../layouts/AdminShell.astro';
import KontributorCms from '../../../components/admin/kontributor/KontributorCms.astro';

const cmsActions = `
  <div id="cms-header-action-btn" class="flex items-center gap-2.5 shrink-0">
    <a
      href="/admin/kontributor"
      class="inline-flex items-center gap-2 h-9 px-3.5 text-xs font-semibold rounded-lg border border-gray-300 bg-white hover:bg-gray-50 text-gray-700 transition-all shadow-2xs"
    >
      <i data-lucide="arrow-left" class="w-3.5 h-3.5 text-gray-500"></i>
      <span>Kembali</span>
    </a>
    <span id="cms-preview-badge" class="hidden inline-flex items-center gap-1.5 h-9 px-3 rounded-lg border border-amber-200 bg-amber-50 text-xs font-semibold text-amber-800">
      <i data-lucide="lock" class="w-3.5 h-3.5 text-amber-600"></i>
      <span>Mode Pratinjau (Read-Only)</span>
    </span>
    <a
      href="/detail-mbkm"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 h-9 px-3.5 text-xs font-semibold rounded-lg border border-gray-300 bg-white hover:bg-gray-50 text-gray-700 transition-all shadow-2xs"
    >
      <i data-lucide="external-link" class="w-3.5 h-3.5 text-gray-500"></i>
      <span>Pratinjau Halaman Detail</span>
    </a>
    <button
      type="button"
      onclick="handleSaveCmsHero()"
      id="btn-save-cms-top"
      class="inline-flex items-center justify-center gap-2 h-9 px-4 text-xs font-bold rounded-lg bg-[#0655a7] hover:bg-[#114D91] text-white shadow-2xs transition-all active:scale-95 cursor-pointer"
    >
      <i data-lucide="save" class="w-3.5 h-3.5"></i>
      <span>Simpan Perubahan</span>
    </button>
  </div>
`;
---

<AdminShell
  currentTab="kontributor"
  pageTitle="Kelola CMS"
  subtitle="Kelola konten publik halaman detail program (profil hero, timeline kegiatan, showcase, dan FAQ)."
  actionButton={cmsActions}
>
  <section
    id="section-kontributor-cms"
    class="flex flex-col flex-1 min-h-0 pr-1 overflow-y-auto tab-content font-sans"
  >
    <!-- Card Info Mitra: Persis Seperti di Detail Kontributor -->
    <div class="mb-5 rounded-xl border border-[#e4e4e7] bg-white p-5 flex items-start sm:items-center gap-4 shadow-none">
      <div id="cms-partner-avatar" class="h-14 w-14 rounded-xl border border-[#e4e4e7] bg-[#f4f4f5] text-[#09090b] font-semibold text-lg flex items-center justify-center shrink-0">
        DC
      </div>
      <div class="space-y-1">
        <div class="flex flex-wrap items-center gap-2">
          <h2 id="cms-partner-name" class="text-lg sm:text-xl font-semibold text-[#09090b]">
            PT. Presentologics (Dicoding Indonesia)
          </h2>
          <span id="cms-partner-badge" class="inline-flex items-center gap-1.5 rounded-md border border-[#e4e4e7] bg-[#f4f4f5] px-2.5 py-0.5 text-xs font-medium text-[#09090b]">
            <i data-lucide="globe" class="w-3.5 h-3.5 text-[#71717a]"></i>
            <span>Kontributor Eksternal</span>
          </span>
        </div>
        <p id="cms-partner-deskripsi" class="text-xs text-[#71717a] max-w-2xl leading-relaxed">
          Platform edukasi teknologi terakreditasi Kemendikbudristek untuk program pengembang AI dan cloud software engineering.
        </p>
        <div class="flex flex-wrap items-center gap-3 pt-1 text-xs text-[#71717a]">
          <div class="flex items-center gap-1.5">
            <i data-lucide="user" class="w-3.5 h-3.5 text-[#71717a]"></i>
            <span id="cms-partner-pic">Narenda Wicaksono</span>
          </div>
        </div>
      </div>
    </div>

    <KontributorCms standalone={true} />
  </section>
</AdminShell>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const hTitle = document.getElementById('header-page-title');
    if (hTitle) hTitle.textContent = 'Kelola CMS';
    const hSub = document.getElementById('header-page-subtitle');
    if (hSub) hSub.textContent = 'Kelola konten publik halaman detail program (profil hero, timeline kegiatan, showcase, dan FAQ).';
    if (typeof updateBreadcrumb === 'function') {
      updateBreadcrumb(['Kontributor', 'Kelola CMS']);
    }
  });
</script>
