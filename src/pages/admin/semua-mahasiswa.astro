---
// src/pages/admin/semua-mahasiswa.astro
import AdminShell from '../../layouts/AdminShell.astro';
---

<AdminShell currentTab="semua-mahasiswa">
  <section
    id="section-mhs-semua"
    class="flex flex-col flex-1 min-h-0 gap-4 pr-1 overflow-y-auto tab-content"
    x-data="{
      searchQuery: '',
      periodeFilter: 'semua',
      statusFilter: 'semua',
      students: [
        { no: 1, nama: 'Faisal Rahman', nim: 'A11.2022.13901', email: 'faisal.rahman@mhs.dinus.ac.id', telepon: '081234567890', dosen: 'Dr. M. Arief Soeleman, M.Kom', kodePeriode: '20261', tahunAjaran: '2026/2027', status: 'konversi' },
        { no: 2, nama: 'Nabila Zahra Putri', nim: 'A12.2022.09842', email: 'nabila.zahra@mhs.dinus.ac.id', telepon: '082198765432', dosen: 'Christy Atika Sari, M.Kom', kodePeriode: '20261', tahunAjaran: '2026/2027', status: 'konversi' },
        { no: 3, nama: 'Rizky Aditya Pratama', nim: 'A11.2022.14012', email: 'rizky.aditya@mhs.dinus.ac.id', telepon: '085712349876', dosen: 'Eko Hari Rachmawanto, M.Kom', kodePeriode: '20261', tahunAjaran: '2026/2027', status: 'reguler' },
        { no: 4, nama: 'Dewi Lestari Kusuma', nim: 'A14.2022.03211', email: 'dewi.lestari@mhs.dinus.ac.id', telepon: '087834561234', dosen: 'Ajib Susanto, M.Kom', kodePeriode: '20261', tahunAjaran: '2026/2027', status: 'reguler' },
        { no: 5, nama: 'Budi Santoso', nim: 'A11.2022.14150', email: 'budi.santoso@mhs.dinus.ac.id', telepon: '081399887766', dosen: '-', kodePeriode: '20261', tahunAjaran: '2026/2027', status: 'belum' },
      ],
      get filteredStudents() {
        const q = (this.searchQuery || '').toLowerCase();
        return this.students.filter(s => {
          const matchSearch = (s.nama || '').toLowerCase().includes(q) ||
                              (s.nim || '').includes(this.searchQuery) ||
                              (s.dosen || '').toLowerCase().includes(q);
          const matchStatus = this.statusFilter === 'semua' || s.status === this.statusFilter;
          const matchPeriode = this.periodeFilter === 'semua' || s.kodePeriode === this.periodeFilter;
          return matchSearch && matchStatus && matchPeriode;
        });
      }
    }"
  >
    <!-- Filter & Search Toolbar (Sesuai Standar SearchControl fakultas-fe) -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
      <div class="flex flex-wrap items-center gap-2 w-full sm:w-auto">
        <div class="relative w-full sm:w-72 md:w-80">
          <i data-lucide="search" class="w-4 h-4 text-[#71717a] absolute left-3 top-1/2 -translate-y-1/2"></i>
          <input
            type="text"
            x-model="searchQuery"
            placeholder="Cari mahasiswa, NIM, atau DPL..."
            class="h-9 w-full rounded-md border border-[#e4e4e7] bg-white pl-9 pr-3 text-sm text-[#09090b] placeholder:text-[#71717a] focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
          />
        </div>
        <select
          x-model="periodeFilter"
          class="h-9 px-3 rounded-md border border-[#e4e4e7] bg-white text-xs text-[#09090b] focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
        >
          <option value="semua">Semua Periode</option>
          <option value="20261">2026/2027 - Gasal</option>
          <option value="20252">2025/2026 - Genap</option>
          <option value="20251">2025/2026 - Gasal</option>
        </select>
        <select
          x-model="statusFilter"
          class="h-9 px-3 rounded-md border border-[#e4e4e7] bg-white text-xs text-[#09090b] focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
        >
          <option value="semua">Semua Status</option>
          <option value="konversi">Konversi</option>
          <option value="reguler">Reguler</option>
          <option value="belum">Belum Ada</option>
        </select>
      </div>
    </div>

    <!-- Tabel Semua Mahasiswa Style KP -->
    <div class="rounded-lg border border-[#e4e4e7] overflow-hidden bg-white">
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="border-b border-[#e4e4e7] bg-[#fafafa]">
            <tr>
              <th class="h-11 px-4 font-medium text-sm w-16 text-center text-[#71717a]">No</th>
              <th class="h-11 px-4 font-medium text-sm text-left text-[#71717a]">Nama</th>
              <th class="h-11 px-4 font-medium text-sm text-left text-[#71717a]">Kontak</th>
              <th class="h-11 px-4 font-medium text-sm text-left text-[#71717a]">Dosen Pembimbing</th>
              <th class="h-11 px-4 font-medium text-sm text-left text-[#71717a]">Periode</th>
              <th class="h-11 px-4 font-medium text-sm text-center text-[#71717a]">Status</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#e4e4e7]">
          <template x-for="(mhs, idx) in filteredStudents" :key="mhs.nim">
            <tr class="hover:bg-[#fafafa] transition-colors">
              <td class="h-[68px] px-4 text-center text-sm text-[#71717a]" x-text="idx + 1"></td>
              <td class="h-[68px] px-4 text-sm">
                <div class="flex items-center gap-3">
                  <div class="h-9 w-9 rounded-full bg-[#f4f4f5] text-[#0655a7] font-semibold text-xs flex items-center justify-center shrink-0 border border-[#e4e4e7]">
                    <span x-text="mhs.nama.charAt(0)"></span>
                  </div>
                  <div class="flex flex-col">
                    <span class="font-semibold text-[#09090b] text-sm" x-text="mhs.nama"></span>
                    <span class="text-xs text-[#71717a]" x-text="mhs.nim"></span>
                  </div>
                </div>
              </td>
              <td class="h-[68px] px-4 text-sm">
                <div class="flex flex-col gap-0.5 text-xs">
                  <div class="flex items-center gap-1.5 text-[#09090b]">
                    <i data-lucide="mail" class="w-3.5 h-3.5 text-[#71717a]"></i>
                    <span x-text="mhs.email"></span>
                  </div>
                  <div class="flex items-center gap-1.5 text-[#71717a]">
                    <i data-lucide="phone" class="w-3.5 h-3.5 text-[#71717a]"></i>
                    <span x-text="mhs.telepon"></span>
                  </div>
                </div>
              </td>
              <td class="h-[68px] px-4 text-sm text-[#09090b]" x-text="mhs.dosen"></td>
              <td class="h-[68px] px-4 text-sm">
                <div class="flex flex-col">
                  <span class="text-sm font-medium text-[#09090b]" x-text="mhs.kodePeriode"></span>
                  <span class="text-xs text-[#71717a]" x-text="mhs.tahunAjaran"></span>
                </div>
              </td>
              <td class="h-[68px] px-4 text-center text-sm">
                <template x-if="mhs.status === 'konversi'">
                  <span class="inline-flex items-center px-2 py-1 rounded text-xs font-medium bg-blue-100 text-blue-800">
                    Konversi
                  </span>
                </template>
                <template x-if="mhs.status === 'reguler'">
                  <span class="inline-flex items-center px-2 py-1 rounded text-xs font-medium bg-green-100 text-green-800">
                    Reguler
                  </span>
                </template>
                <template x-if="mhs.status === 'belum'">
                  <span class="inline-flex items-center px-2 py-1 rounded text-xs font-medium bg-gray-100 text-gray-500">
                    Belum Ada
                  </span>
                </template>
              </td>
            </tr>
          </template>
        </tbody>
      </table>
      </div>
    </div>

    <!-- Standardized Pagination Sesuai Screenshot 1 -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-2 pt-1">
      <div class="text-xs text-[#71717a]">Menampilkan 1 - 5 dari 186 data</div>
      <div class="flex items-center gap-2">
        <button
          type="button"
          disabled
          class="h-8 w-8 flex items-center justify-center rounded-md border border-[#e4e4e7] bg-white text-[#71717a] opacity-50 cursor-not-allowed hover:bg-gray-50"
        >
          <i data-lucide="chevron-left" class="w-4 h-4"></i>
        </button>
        <button
          type="button"
          class="h-8 w-8 flex items-center justify-center rounded-md bg-[#0655a7] text-white font-semibold text-xs shadow-none"
        >
          1
        </button>
        <button
          type="button"
          class="h-8 w-8 flex items-center justify-center rounded-md border border-[#e4e4e7] bg-white text-[#09090b] font-medium text-xs hover:bg-[#f4f4f5]"
        >
          2
        </button>
        <button
          type="button"
          class="h-8 w-8 flex items-center justify-center rounded-md border border-[#e4e4e7] bg-white text-[#09090b] font-medium text-xs hover:bg-[#f4f4f5]"
        >
          3
        </button>
        <button
          type="button"
          class="h-8 w-8 flex items-center justify-center rounded-md border border-[#e4e4e7] bg-white text-[#09090b] hover:bg-[#f4f4f5]"
        >
          <i data-lucide="chevron-right" class="w-4 h-4"></i>
        </button>
        <select
          class="h-8 rounded-md border border-[#e4e4e7] bg-white px-2 text-xs text-[#09090b] focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
        >
          <option value="10">Show 10 items</option>
          <option value="25">Show 25 items</option>
          <option value="50">Show 50 items</option>
        </select>
      </div>
    </div>
  </section>
</AdminShell>
