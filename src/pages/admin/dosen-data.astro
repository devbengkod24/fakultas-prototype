---
// src/pages/admin/dosen-data.astro
import AdminShell from "../../layouts/AdminShell.astro";
---

<AdminShell currentTab="dosen-data">
  <section
    id="section-dosen-data"
    class="flex flex-col flex-1 min-h-0 gap-4 pr-1 overflow-y-auto tab-content"
    x-data="{
      searchQuery: '',
      sortOption: 'nama_asc',
      currentPage: 1,
      pageSize: 5,
      isSyncing: false,
      isBulkModalOpen: false,
      dosenList: [
        { id: 1, nama: 'Dr. M. Arief Soeleman, M.Kom', npp: '0612047801', aktifPeriode: true, sisaKuota: 0, totalKuota: 8 },
        { id: 2, nama: 'Affandy, Ph.D', npp: '0617087502', aktifPeriode: true, sisaKuota: 0, totalKuota: 8 },
        { id: 3, nama: 'Christy Atika Sari, M.Kom', npp: '0629038401', aktifPeriode: true, sisaKuota: 0, totalKuota: 8 },
        { id: 4, nama: 'Eko Hari Rachmawanto, M.Kom', npp: '0615028201', aktifPeriode: true, sisaKuota: 0, totalKuota: 8 },
        { id: 5, nama: 'Ajib Susanto, M.Kom', npp: '0621057901', aktifPeriode: false, sisaKuota: 0, totalKuota: 8 },
        { id: 6, nama: 'Dr. Muljono, S.Si, M.Kom', npp: '0619087201', aktifPeriode: true, sisaKuota: 3, totalKuota: 8 },
        { id: 7, nama: 'Dr. Ricardus Anggi, M.Kom', npp: '0624018602', aktifPeriode: true, sisaKuota: 2, totalKuota: 8 },
      ],
      get filteredDosen() {
        const q = (this.searchQuery || '').toLowerCase();
        let list = this.dosenList.filter(d =>
          (d.nama || '').toLowerCase().includes(q) || (d.npp || '').includes(q)
        );
        if (this.sortOption === 'nama_asc') {
          list = [...list].sort((a, b) => a.nama.localeCompare(b.nama));
        } else if (this.sortOption === 'nama_desc') {
          list = [...list].sort((a, b) => b.nama.localeCompare(a.nama));
        } else if (this.sortOption === 'kuota_asc') {
          list = [...list].sort((a, b) => b.sisaKuota - a.sisaKuota);
        }
        return list;
      },
      get totalPages() {
        return Math.max(1, Math.ceil(this.filteredDosen.length / this.pageSize));
      },
      get paginatedDosen() {
        const start = (this.currentPage - 1) * this.pageSize;
        return this.filteredDosen.slice(start, start + this.pageSize);
      },
      toggleStatus(dosen) {
        dosen.aktifPeriode = !dosen.aktifPeriode;
      },
      syncData() {
        this.isSyncing = true;
        setTimeout(() => {
          this.isSyncing = false;
          alert('Sinkronisasi data dosen pembimbing dari SIADIN berhasil.');
        }, 800);
      }
    }"
  >
    <!-- Toolbar Style KP -->
    <div class="flex flex-col md:flex-row gap-2 items-start md:items-center justify-between">
      <!-- Search Input -->
      <div class="relative w-full sm:w-72 md:w-80">
        <i data-lucide="search" class="w-4 h-4 text-[#71717a] absolute left-3 top-1/2 -translate-y-1/2"></i>
        <input
          type="text"
          x-model="searchQuery"
          @input="currentPage = 1"
          placeholder="Cari Dosen..."
          class="h-9 w-full rounded-md border border-[#e4e4e7] bg-white pl-9 pr-3 text-sm text-[#09090b] placeholder:text-[#71717a] focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
        />
      </div>

      <!-- Action Buttons Right -->
      <div class="flex items-center gap-2 ml-auto flex-wrap">
        <select
          x-model="sortOption"
          @change="currentPage = 1"
          class="h-9 rounded-md border border-[#e4e4e7] bg-white px-3 text-xs text-[#09090b] focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
        >
          <option value="nama_asc">Nama (A - Z)</option>
          <option value="nama_desc">Nama (Z - A)</option>
          <option value="kuota_asc">Sisa Kuota Terbanyak</option>
        </select>

        <button
          type="button"
          @click="isBulkModalOpen = true"
          class="inline-flex items-center gap-2 h-9 px-4 text-xs font-semibold rounded-md bg-[#0655a7] hover:bg-[#114d91] text-white shadow-none transition-colors"
        >
          <i data-lucide="list-checks" class="w-4 h-4"></i>
          <span>Pilih Banyak</span>
        </button>

        <button
          type="button"
          @click="syncData()"
          :disabled="isSyncing"
          class="inline-flex items-center justify-center h-9 w-9 rounded-md border border-[#e4e4e7] bg-white hover:bg-[#f4f4f5] text-[#71717a] transition-colors"
          title="Sinkronisasi SIADIN"
        >
          <i data-lucide="refresh-ccw" class="w-4 h-4" :class="isSyncing ? 'animate-spin text-[#0655a7]' : ''"></i>
        </button>
      </div>
    </div>

    <!-- Tabel Data Dosen Style KP -->
    <div class="rounded-lg border border-[#e4e4e7] overflow-hidden bg-white">
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="border-b border-[#e4e4e7] bg-[#fafafa]">
            <tr>
              <th class="h-11 px-4 font-semibold text-xs w-12 text-center text-[#71717a]">No.</th>
              <th class="h-11 px-4 font-semibold text-xs text-left text-[#71717a]">Nama Dosen Pembimbing</th>
              <th class="h-11 px-4 font-semibold text-xs text-center text-[#71717a]">Status</th>
              <th class="h-11 px-4 font-semibold text-xs text-center text-[#71717a]">Plotting Mahasiswa</th>
              <th class="h-11 px-4 font-semibold text-xs w-24 text-center text-[#71717a]">Aksi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#e4e4e7]">
          <template x-for="(dosen, idx) in paginatedDosen" :key="dosen.id">
            <tr class="hover:bg-[#f4f4f5]/60 transition-colors">
              <td class="h-[68px] px-2 text-center text-xs font-medium text-[#71717a] w-12" x-text="((currentPage - 1) * pageSize) + (idx + 1)"></td>
              <td class="h-[68px] px-4 text-sm">
                <div class="flex items-center gap-3">
                  <div class="h-9 w-9 rounded-full bg-[#f4f4f5] text-[#0655a7] font-semibold text-xs flex items-center justify-center shrink-0 border border-[#e4e4e7]">
                    <span x-text="dosen.nama.charAt(0)"></span>
                  </div>
                  <div class="flex flex-col">
                    <span class="font-semibold text-[#09090b] text-sm" x-text="dosen.nama"></span>
                    <span class="text-xs text-[#71717a]" x-text="dosen.npp"></span>
                  </div>
                </div>
              </td>
              <td class="h-[68px] px-4 text-sm">
                <div class="flex items-center justify-center gap-2.5">
                  <button
                    type="button"
                    role="switch"
                    :aria-checked="dosen.aktifPeriode"
                    :aria-label="`Ubah status periode ${dosen.nama}`"
                    @click="toggleStatus(dosen)"
                    class="relative inline-flex h-[22px] w-[40px] shrink-0 items-center rounded-full transition-colors duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0655a7]/40 focus-visible:ring-offset-2"
                    :class="dosen.aktifPeriode ? 'bg-[#0655a7]' : 'bg-[#d4d4d8]'"
                  >
                    <span
                      class="inline-block h-[18px] w-[18px] rounded-full bg-white shadow-sm transition-transform duration-200"
                      :class="dosen.aktifPeriode ? 'translate-x-[20px]' : 'translate-x-[2px]'"
                    ></span>
                  </button>
                  <span
                    class="text-xs font-medium"
                    :class="dosen.aktifPeriode ? 'text-emerald-700' : 'text-[#71717a]'"
                    x-text="dosen.aktifPeriode ? 'Aktif' : 'Nonaktif'"
                  ></span>
                </div>
              </td>
              <td class="h-[68px] px-4 text-center text-sm">
                <template x-if="dosen.sisaKuota > 0">
                  <span class="inline-flex items-center gap-2 text-xs font-medium text-[#71717a]">
                    <i data-lucide="users" class="w-4 h-4 text-[#71717a] shrink-0"></i>
                    <span x-text="`Sisa kuota (${dosen.sisaKuota})`"></span>
                  </span>
                </template>
                <template x-if="dosen.sisaKuota === 0">
                  <span class="inline-flex items-center gap-2 text-xs font-medium text-amber-700">
                    <i data-lucide="users" class="w-4 h-4 text-amber-700 shrink-0"></i>
                    <span>Kuota Penuh</span>
                  </span>
                </template>
              </td>
              <td class="h-[68px] px-4 text-center text-sm">
                <div class="relative inline-block text-left" x-data="{ openAction: false }">
                  <button
                    type="button"
                    @click="openAction = !openAction"
                    @click.outside="openAction = false"
                    class="h-8 w-8 flex items-center justify-center rounded-md hover:bg-[#f4f4f5] text-[#71717a]"
                    title="Menu Aksi"
                  >
                    <i data-lucide="more-horizontal" class="w-4 h-4"></i>
                  </button>
                  <div
                    x-show="openAction"
                    x-cloak
                    class="absolute right-0 mt-1 w-32 rounded-md border border-[#e4e4e7] bg-white py-1 shadow-md z-20 text-xs"
                  >
                    <a
                      href="/admin/dosen-kuota"
                      class="flex items-center gap-2 px-3 py-1.5 text-left text-[#09090b] hover:bg-[#f4f4f5]"
                    >
                      <i data-lucide="eye" class="w-3.5 h-3.5 text-[#71717a]"></i>
                      <span>Detail</span>
                    </a>
                    <a
                      href="/admin/dosen-update"
                      class="flex items-center gap-2 px-3 py-1.5 text-left text-[#09090b] hover:bg-[#f4f4f5]"
                    >
                      <i data-lucide="pencil" class="w-3.5 h-3.5 text-[#71717a]"></i>
                      <span>Plotting</span>
                    </a>
                  </div>
                </div>
              </td>
            </tr>
          </template>
          <template x-if="paginatedDosen.length === 0">
            <tr>
              <td colspan="5" class="h-28 text-center text-xs text-[#71717a]">
                Tidak ada data dosen pembimbing yang cocok dengan kriteria pencarian.
              </td>
            </tr>
          </template>
        </tbody>
      </table>
      </div>
    </div>

    <!-- Standardized Pagination Sesuai Screenshot 1 & Design System -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-2 pt-1">
      <div class="text-xs text-[#71717a]" x-text="'Menampilkan ' + (filteredDosen.length === 0 ? 0 : ((currentPage - 1) * pageSize + 1)) + ' - ' + Math.min(currentPage * pageSize, filteredDosen.length) + ' dari ' + filteredDosen.length + ' data'"></div>
      <div class="flex items-center gap-1.5">
        <button
          type="button"
          @click="if (currentPage > 1) currentPage--"
          :disabled="currentPage <= 1"
          :class="currentPage <= 1 ? 'opacity-50 cursor-not-allowed hover:bg-white text-[#71717a]' : 'hover:bg-[#f4f4f5] text-[#09090b]'"
          class="h-8 w-8 flex items-center justify-center rounded-md border border-[#e4e4e7] bg-white text-xs transition-colors"
          title="Halaman Sebelumnya"
        >
          <i data-lucide="chevron-left" class="w-4 h-4"></i>
        </button>

        <template x-for="p in totalPages" :key="p">
          <button
            type="button"
            @click="currentPage = p"
            :class="currentPage === p ? 'bg-[#0655a7] text-white font-semibold shadow-none' : 'border border-[#e4e4e7] bg-white text-[#09090b] font-medium hover:bg-[#f4f4f5]'"
            class="h-8 w-8 flex items-center justify-center rounded-md text-xs transition-colors"
            x-text="p"
          ></button>
        </template>

        <button
          type="button"
          @click="if (currentPage < totalPages) currentPage++"
          :disabled="currentPage >= totalPages"
          :class="currentPage >= totalPages ? 'opacity-50 cursor-not-allowed hover:bg-white text-[#71717a]' : 'hover:bg-[#f4f4f5] text-[#09090b]'"
          class="h-8 w-8 flex items-center justify-center rounded-md border border-[#e4e4e7] bg-white text-xs transition-colors"
          title="Halaman Selanjutnya"
        >
          <i data-lucide="chevron-right" class="w-4 h-4"></i>
        </button>

        <select
          x-model.number="pageSize"
          @change="currentPage = 1"
          class="h-8 rounded-md border border-[#e4e4e7] bg-white px-2 text-xs text-[#09090b] focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
        >
          <option value="5">Show 5 items</option>
          <option value="10">Show 10 items</option>
          <option value="25">Show 25 items</option>
          <option value="50">Show 50 items</option>
        </select>
      </div>
    </div>

    <!-- Modal Pilih Banyak (Bulk Activation) -->
    <div
      x-show="isBulkModalOpen"
      x-cloak
      class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4"
    >
      <div
        @click.outside="isBulkModalOpen = false"
        class="w-full max-w-md rounded-xl bg-white p-6 shadow-xl border border-[#e4e4e7] space-y-4"
      >
        <div class="flex items-center justify-between">
          <h3 class="text-base font-semibold text-[#09090b]">Aktivasi Dosen Massal</h3>
          <button
            type="button"
            @click="isBulkModalOpen = false"
            class="h-8 w-8 rounded-md hover:bg-[#f4f4f5] text-[#71717a] flex items-center justify-center"
          >
            <i data-lucide="x" class="w-4 h-4"></i>
          </button>
        </div>
        <p class="text-xs text-[#71717a] leading-relaxed">
          Aktifkan atau nonaktifkan status seluruh dosen pembimbing terdaftar pada periode akademik saat ini secara serentak.
        </p>
        <div class="space-y-2 pt-2">
          <button
            type="button"
            @click="dosenList.forEach(d => d.aktifPeriode = true); isBulkModalOpen = false; alert('Semua dosen berhasil diaktifkan!')"
            class="w-full h-9 rounded-md bg-[#0655a7] text-white text-xs font-medium hover:bg-[#0655a7]/90 transition-colors"
          >
            Aktifkan Semua Dosen Terdaftar
          </button>
          <button
            type="button"
            @click="dosenList.forEach(d => d.aktifPeriode = false); isBulkModalOpen = false; alert('Semua dosen berhasil dinonaktifkan!')"
            class="w-full h-9 rounded-md border border-[#e4e4e7] bg-white text-xs font-medium text-[#71717a] hover:bg-[#f4f4f5] transition-colors"
          >
            Nonaktifkan Semua Dosen
          </button>
        </div>
      </div>
    </div>
  </section>
</AdminShell>
