---
// src/pages/admin/data-pengajuan.astro
import AdminShell from '../../layouts/AdminShell.astro';
---

<AdminShell
  currentTab="data-pengajuan"
  pageTitle="Data Pengajuan Sidang"
  subtitle="Lihat data mahasiswa yang mengajukan sidang KP."
>
  <section
    id="section-data-pengajuan"
    class="flex flex-col flex-1 min-h-0 space-y-4 pr-1 overflow-y-auto tab-content font-sans"
    x-data="{
      searchQuery: '',
      selectedGelombangId: 'all',
      selectedDokumen: null,
      isDokumenModalOpen: false,
      currentPage: 1,
      pageSize: 10,

      gelombangList: [
        { id: 'all', nama: 'Semua Gelombang' },
        { id: '1', nama: 'Gelombang 1' },
        { id: '2', nama: 'Gelombang 2' },
        { id: '3', nama: 'Gelombang 3' }
      ],

      pengajuanData: [
        {
          sidang_id: 1,
          pengajuan_sidang_id: 101,
          pembimbing: { id: 11, nama: 'Dr. M. Arief Soeleman, M.Kom' },
          mahasiswa: {
            id: 1001,
            nama: 'Faisal Rahman',
            nim: 'A11.2022.13901',
            judul: 'Implementasi Automated Multi-Cloud Infrastructure & Observability dengan Terraform dan Kubernetes pada PT Telkom'
          },
          dokumen: {
            laporan_akhir: 'https://drive.google.com/file/d/laporan-akhir-faisal/view',
            dokumen_penyelia: 'https://drive.google.com/file/d/evaluasi-penyelia-faisal/view'
          },
          nilai_penyelia: 92,
          gelombang: { id: 1, nama: 'Gelombang 1' },
          tanggal_pengajuan: '2026-06-03'
        },
        {
          sidang_id: 2,
          pengajuan_sidang_id: 102,
          pembimbing: { id: 12, nama: 'Affandy, Ph.D' },
          mahasiswa: {
            id: 1002,
            nama: 'Tarissa Aura Azzahra',
            nim: 'A11.2020.13158',
            judul: 'Optimasi Latency dan Throughput Microservices Payment Gateway Menggunakan Golang dan gRPC di Tokopedia'
          },
          dokumen: {
            laporan_akhir: 'https://drive.google.com/file/d/laporan-akhir-tarissa/view',
            dokumen_penyelia: 'https://drive.google.com/file/d/evaluasi-penyelia-tarissa/view'
          },
          nilai_penyelia: 95,
          gelombang: { id: 1, nama: 'Gelombang 1' },
          tanggal_pengajuan: '2026-06-05'
        },
        {
          sidang_id: 3,
          pengajuan_sidang_id: 103,
          pembimbing: { id: 13, nama: 'Christy Atika Sari, M.Kom' },
          mahasiswa: {
            id: 1003,
            nama: 'Nabila Zahra Putri',
            nim: 'A12.2022.09842',
            judul: 'Perancangan Pengalaman Pengguna Sistem Informasi Manajemen Inventaris Berbasis Design Thinking pada Ryuje Tech'
          },
          dokumen: {
            laporan_akhir: 'https://drive.google.com/file/d/laporan-akhir-nabila/view',
            dokumen_penyelia: 'https://drive.google.com/file/d/evaluasi-penyelia-nabila/view'
          },
          nilai_penyelia: 88,
          gelombang: { id: 1, nama: 'Gelombang 1' },
          tanggal_pengajuan: '2026-06-08'
        },
        {
          sidang_id: 4,
          pengajuan_sidang_id: 104,
          pembimbing: { id: 14, nama: 'Eko Hari Rachmawanto, M.Kom' },
          mahasiswa: {
            id: 1004,
            nama: 'Rizky Aditya Pratama',
            nim: 'A11.2022.14012',
            judul: 'Penerapan Honeytoken dan Intrusion Detection System Berbasis AI untuk Proteksi Server Pemerintahan Daerah'
          },
          dokumen: {
            laporan_akhir: 'https://drive.google.com/file/d/laporan-akhir-rizky/view',
            dokumen_penyelia: 'https://drive.google.com/file/d/evaluasi-penyelia-rizky/view'
          },
          nilai_penyelia: 90,
          gelombang: { id: 2, nama: 'Gelombang 2' },
          tanggal_pengajuan: '2026-06-22'
        },
        {
          sidang_id: 5,
          pengajuan_sidang_id: 105,
          pembimbing: { id: 11, nama: 'Dr. M. Arief Soeleman, M.Kom' },
          mahasiswa: {
            id: 1005,
            nama: 'Dimas Wahyu Nugroho',
            nim: 'A11.2021.13450',
            judul: 'Analisis Prediksi Fraud Transaksi Kartu Kredit Menggunakan Ensemble Machine Learning di BCA IT Division'
          },
          dokumen: {
            laporan_akhir: 'https://drive.google.com/file/d/laporan-akhir-dimas/view',
            dokumen_penyelia: 'https://drive.google.com/file/d/evaluasi-penyelia-dimas/view'
          },
          nilai_penyelia: 94,
          gelombang: { id: 2, nama: 'Gelombang 2' },
          tanggal_pengajuan: null
        }
      ],

      get filteredList() {
        return this.pengajuanData.filter(item => {
          const matchGel = this.selectedGelombangId === 'all' || (item.gelombang && item.gelombang.id.toString() === this.selectedGelombangId);
          const q = this.searchQuery.trim().toLowerCase();
          const matchSearch = q === '' ||
            (item.mahasiswa?.nama && item.mahasiswa.nama.toLowerCase().includes(q)) ||
            (item.mahasiswa?.nim && item.mahasiswa.nim.toLowerCase().includes(q)) ||
            (item.mahasiswa?.judul && item.mahasiswa.judul.toLowerCase().includes(q)) ||
            (item.pembimbing?.nama && item.pembimbing.nama.toLowerCase().includes(q));
          return matchGel && matchSearch;
        });
      },

      get paginatedList() {
        const start = (this.currentPage - 1) * this.pageSize;
        return this.filteredList.slice(start, start + this.pageSize);
      },

      get totalPages() {
        return Math.max(1, Math.ceil(this.filteredList.length / this.pageSize));
      },

      handleClearSearch() {
        this.searchQuery = '';
        this.currentPage = 1;
        this.reinitLucide();
      },

      handleGelombangChange() {
        this.currentPage = 1;
        this.reinitLucide();
      },

      openDokumen(item) {
        this.selectedDokumen = item;
        this.isDokumenModalOpen = true;
        this.reinitLucide();
      },

      formatDate(dateStr) {
        if (!dateStr) return '-';
        try {
          const d = new Date(dateStr);
          return d.toLocaleDateString('id-ID', {
            day: 'numeric',
            month: 'short',
            year: 'numeric'
          });
        } catch {
          return dateStr;
        }
      },

      reinitLucide() {
        this.$nextTick(() => {
          if (typeof lucide !== 'undefined') lucide.createIcons();
        });
      }
    }"
  >
    <!-- Toolbar: Sesuai DataPengajuanKoordinator di fakultas-fe -->
    <div class="flex flex-col sm:flex-row gap-2 sm:gap-4 items-stretch sm:items-center justify-between mb-3">
      <!-- Search Control (w-full sm:w-1/4) -->
      <div class="w-full sm:w-1/4 sm:flex-shrink-0">
        <div class="relative w-full">
          <i data-lucide="search" class="absolute left-3 top-1/2 transform -translate-y-1/2 w-4 h-4 text-[#71717a]"></i>
          <input
            type="text"
            x-model="searchQuery"
            @input="currentPage = 1; reinitLucide()"
            placeholder="Cari Mahasiswa..."
            class="w-full h-10 pl-9 pr-9 rounded-md border border-[#e4e4e7] bg-white text-sm text-[#09090b] placeholder:text-[#71717a] focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
          />
          <button
            type="button"
            x-show="searchQuery.length > 0"
            @click="handleClearSearch()"
            class="absolute right-3 top-1/2 transform -translate-y-1/2 text-[#71717a] hover:text-[#09090b] cursor-pointer"
          >
            <i data-lucide="x" class="w-4 h-4"></i>
          </button>
        </div>
      </div>

      <!-- GelombangSelector (w-full sm:w-[200px] flex-shrink-0 sm:ml-auto) -->
      <div class="w-full sm:w-[200px] flex-shrink-0 sm:ml-auto">
        <div class="relative">
          <select
            x-model="selectedGelombangId"
            @change="handleGelombangChange()"
            class="h-10 w-full rounded-md border border-[#e4e4e7] bg-white px-3 pr-8 text-sm text-[#09090b] focus:outline-none focus:ring-1 focus:ring-[#0655a7] cursor-pointer appearance-none"
          >
            <template x-for="g in gelombangList" :key="g.id">
              <option :value="g.id" x-text="g.nama"></option>
            </template>
          </select>
          <i data-lucide="chevron-down" class="w-4 h-4 text-[#71717a] absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none"></i>
        </div>
      </div>
    </div>

    <!-- Empty State jika tidak ada data -->
    <template x-if="filteredList.length === 0">
      <div class="flex flex-col items-center justify-center py-12 text-center h-[calc(100vh-320px)] bg-white rounded-md border border-[#e4e4e7]">
        <div class="rounded-full bg-[#f4f4f5] p-3 mb-4">
          <i data-lucide="calendar-check" class="h-6 w-6 text-[#71717a]"></i>
        </div>
        <h3 class="text-lg font-medium text-[#09090b]">Belum Ada Pengajuan Sidang</h3>
        <p class="text-sm text-[#71717a] mt-1 max-w-md">
          Data pengajuan sidang akan muncul setelah mahasiswa mengajukan sidang.
        </p>
      </div>
    </template>

    <!-- Table View: DataTable Sesuai DataPengajuanKoordinator di fakultas-fe -->
    <div class="rounded-lg border border-[#e4e4e7] overflow-hidden bg-white" x-show="filteredList.length > 0">
      <div class="relative w-full overflow-auto">
        <table class="w-full text-sm">
          <thead class="bg-[#fafafa] border-b border-[#e4e4e7]">
            <tr>
              <th class="h-11 px-4 font-semibold text-xs w-12 text-center text-[#71717a]">No.</th>
              <th class="h-11 px-4 font-semibold text-xs text-left text-[#71717a] min-w-[200px] max-w-[280px]">Mahasiswa</th>
              <th class="h-11 px-4 font-semibold text-xs text-left text-[#71717a] min-w-[180px]">Dosen Pembimbing</th>
              <th class="h-11 px-4 font-semibold text-xs text-left text-[#71717a] min-w-[300px]">Judul</th>
              <th class="h-11 px-4 font-semibold text-xs text-center text-[#71717a] min-w-[100px]">Dokumen</th>
              <th class="h-11 px-4 font-semibold text-xs text-center text-[#71717a] min-w-[100px]">Nilai Penyelia</th>
              <th class="h-11 px-4 font-semibold text-xs text-center text-[#71717a] min-w-[100px]">Gelombang</th>
              <th class="h-11 px-4 font-semibold text-xs text-center text-[#71717a] min-w-[140px]">Tanggal Pengajuan</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#e4e4e7]">
            <template x-for="(row, index) in paginatedList" :key="row.sidang_id">
              <tr class="hover:bg-[#f4f4f5]/60 transition-colors">
                <!-- No -->
                <td class="h-[68px] px-2 text-center text-xs font-medium text-[#71717a] w-12" x-text="((currentPage - 1) * pageSize) + (index + 1)"></td>

                <!-- Mahasiswa -->
                <td class="h-[68px] px-4 text-sm min-w-[200px] max-w-[280px]">
                  <div class="font-semibold truncate text-sm text-[#09090b]" x-text="row.mahasiswa?.nama"></div>
                  <div class="text-xs text-[#71717a]" x-text="row.mahasiswa?.nim"></div>
                </td>

                <!-- Pembimbing -->
                <td class="h-[68px] px-4 text-sm min-w-[180px]">
                  <template x-if="row.pembimbing && row.pembimbing.nama">
                    <div class="truncate text-sm font-medium text-[#09090b]" x-text="row.pembimbing.nama"></div>
                  </template>
                  <template x-if="!row.pembimbing || !row.pembimbing.nama">
                    <span class="inline-block text-xs text-[#71717a]">-</span>
                  </template>
                </td>

                <!-- Judul -->
                <td class="h-[68px] px-4 text-sm min-w-[300px]">
                  <div class="whitespace-normal break-words text-sm text-[#09090b] line-clamp-2" x-text="row.mahasiswa?.judul || '-'"></div>
                </td>

                <!-- Dokumen Button -->
                <td class="h-[68px] px-4 text-center text-sm min-w-[100px]">
                  <template x-if="row.dokumen?.laporan_akhir || row.dokumen?.dokumen_penyelia">
                    <button
                      type="button"
                      @click="openDokumen(row)"
                      class="h-8 px-3 inline-flex items-center justify-center rounded-md border border-[#e4e4e7] bg-white hover:bg-[#f4f4f5] text-xs font-medium text-[#09090b] transition-colors shadow-none cursor-pointer"
                    >
                      <i data-lucide="file-text" class="h-3.5 w-3.5 mr-1 text-[#0655a7]"></i>
                      <span>Lihat</span>
                    </button>
                  </template>
                  <template x-if="!row.dokumen?.laporan_akhir && !row.dokumen?.dokumen_penyelia">
                    <span class="text-xs text-[#71717a]">-</span>
                  </template>
                </td>

                <!-- Nilai Penyelia -->
                <td class="h-[68px] px-4 text-center text-sm min-w-[100px] font-semibold text-[#09090b]">
                  <span x-text="row.nilai_penyelia !== null && row.nilai_penyelia !== undefined ? row.nilai_penyelia : '-'"></span>
                </td>

                <!-- Gelombang -->
                <td class="h-[68px] px-4 text-center text-sm min-w-[100px] text-[#09090b]">
                  <span x-text="row.gelombang?.nama || '-'"></span>
                </td>

                <!-- Tanggal Pengajuan -->
                <td class="h-[68px] px-4 text-center text-sm min-w-[140px]">
                  <template x-if="row.tanggal_pengajuan">
                    <div class="whitespace-nowrap text-sm text-[#09090b]" x-text="formatDate(row.tanggal_pengajuan)"></div>
                  </template>
                  <template x-if="!row.tanggal_pengajuan">
                    <div class="flex items-center justify-center gap-1.5 text-xs text-[#71717a]">
                      <i data-lucide="calendar-check" class="h-3.5 w-3.5 shrink-0"></i>
                      <span>Belum ada jadwal</span>
                    </div>
                  </template>
                </td>
              </tr>
            </template>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Standardized Pagination Sesuai Screenshot 1 & Design System -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-2 pt-1" x-show="filteredList.length > 0">
      <div class="text-xs text-[#71717a]" x-text="'Menampilkan ' + (filteredList.length === 0 ? 0 : ((currentPage - 1) * pageSize + 1)) + ' - ' + Math.min(currentPage * pageSize, filteredList.length) + ' dari ' + filteredList.length + ' data'"></div>
      <div class="flex items-center gap-1.5">
        <button
          type="button"
          @click="if (currentPage > 1) { currentPage--; reinitLucide(); }"
          :disabled="currentPage <= 1"
          :class="currentPage <= 1 ? 'opacity-50 cursor-not-allowed hover:bg-white text-[#71717a]' : 'hover:bg-[#f4f4f5] text-[#09090b]'"
          class="h-8 w-8 flex items-center justify-center rounded-md border border-[#e4e4e7] bg-white text-xs transition-colors cursor-pointer"
          title="Halaman Sebelumnya"
        >
          <i data-lucide="chevron-left" class="w-4 h-4"></i>
        </button>

        <template x-for="p in totalPages" :key="p">
          <button
            type="button"
            @click="currentPage = p; reinitLucide()"
            :class="currentPage === p ? 'bg-[#0655a7] text-white font-semibold shadow-none' : 'border border-[#e4e4e7] bg-white text-[#09090b] font-medium hover:bg-[#f4f4f5]'"
            class="h-8 w-8 flex items-center justify-center rounded-md text-xs transition-colors cursor-pointer"
            x-text="p"
          ></button>
        </template>

        <button
          type="button"
          @click="if (currentPage < totalPages) { currentPage++; reinitLucide(); }"
          :disabled="currentPage >= totalPages"
          :class="currentPage >= totalPages ? 'opacity-50 cursor-not-allowed hover:bg-white text-[#71717a]' : 'hover:bg-[#f4f4f5] text-[#09090b]'"
          class="h-8 w-8 flex items-center justify-center rounded-md border border-[#e4e4e7] bg-white text-xs transition-colors cursor-pointer"
          title="Halaman Selanjutnya"
        >
          <i data-lucide="chevron-right" class="w-4 h-4"></i>
        </button>

        <select
          x-model.number="pageSize"
          @change="currentPage = 1; reinitLucide()"
          class="h-8 rounded-md border border-[#e4e4e7] bg-white px-2 text-xs text-[#09090b] focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
        >
          <option value="5">Show 5 items</option>
          <option value="10">Show 10 items</option>
          <option value="25">Show 25 items</option>
          <option value="50">Show 50 items</option>
        </select>
      </div>
    </div>

    <!-- Modal Dialog: Dokumen Mahasiswa (Sesuai Dialog di DataPengajuanKoordinator fakultas-fe) -->
    <div
      x-show="isDokumenModalOpen"
      x-cloak
      class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4 animate-in fade-in duration-150"
    >
      <div
        @click.outside="isDokumenModalOpen = false"
        class="w-full max-w-md rounded-xl bg-white p-6 shadow-xl border border-[#e4e4e7] space-y-4"
      >
        <div class="flex items-center justify-between pb-1 border-b border-[#e4e4e7]">
          <h3 class="text-base font-semibold leading-none tracking-tight text-[#09090b]">Dokumen Mahasiswa</h3>
          <button
            type="button"
            @click="isDokumenModalOpen = false"
            class="rounded-sm opacity-70 transition-opacity hover:opacity-100 text-[#71717a] hover:text-[#09090b] p-1 cursor-pointer"
          >
            <i data-lucide="x" class="w-4 h-4"></i>
          </button>
        </div>

        <template x-if="selectedDokumen">
          <div class="space-y-3">
            <p class="text-sm text-[#71717a]">
              <span class="font-medium text-[#09090b]" x-text="selectedDokumen.mahasiswa?.nama"></span> — <span x-text="selectedDokumen.mahasiswa?.nim"></span>
            </p>

            <div class="flex flex-col gap-2 pt-1">
              <template x-if="selectedDokumen.dokumen?.laporan_akhir">
                <a
                  :href="selectedDokumen.dokumen.laporan_akhir"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-2.5 p-3 rounded-lg border border-[#e4e4e7] hover:bg-[#f4f4f5] transition-colors group cursor-pointer text-[#09090b]"
                >
                  <i data-lucide="file-text" class="h-4 w-4 text-[#0655a7]"></i>
                  <span class="text-sm font-medium">Laporan Akhir</span>
                  <i data-lucide="external-link" class="h-3.5 w-3.5 ml-auto text-[#71717a] group-hover:text-[#09090b]"></i>
                </a>
              </template>

              <template x-if="selectedDokumen.dokumen?.dokumen_penyelia">
                <a
                  :href="selectedDokumen.dokumen.dokumen_penyelia"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-2.5 p-3 rounded-lg border border-[#e4e4e7] hover:bg-[#f4f4f5] transition-colors group cursor-pointer text-[#09090b]"
                >
                  <i data-lucide="file-text" class="h-4 w-4 text-[#0655a7]"></i>
                  <span class="text-sm font-medium">Dokumen Penyelia</span>
                  <i data-lucide="external-link" class="h-3.5 w-3.5 ml-auto text-[#71717a] group-hover:text-[#09090b]"></i>
                </a>
              </template>
            </div>
          </div>
        </template>
      </div>
    </div>
  </section>
</AdminShell>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    if (typeof lucide !== 'undefined') lucide.createIcons();
  });
</script>
