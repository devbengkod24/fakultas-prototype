---
import AdminShell from '../../layouts/AdminShell.astro';
---

<AdminShell currentTab="periode">
  <section
    id="section-periode"
    class="flex flex-col flex-1 min-h-0 gap-4 pr-1 overflow-y-auto tab-content"
  >
<!-- Top Toolbar: Button Sync Data & Filter Status (Sesuai Screenshot bimbingan-karir/periode-ajaran) -->
<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
  <div>
    <button
      type="button"
      onclick="handleSyncPeriodeData()"
      class="inline-flex items-center justify-center gap-2 h-9 px-4 text-sm font-medium rounded-md bg-[#0655a7] hover:bg-[#0655a7]/90 text-white transition-colors"
      id="btn-sync-periode"
    >
      <i data-lucide="refresh-cw" class="w-4 h-4" id="icon-sync-periode"></i>
      <span id="btn-sync-text">Sync Data</span>
    </button>
  </div>

  <div class="flex items-center gap-2">
    <span class="text-sm font-medium text-[#09090b]">Status:</span>
    <select
      id="filter-periode-status"
      onchange="handleFilterPeriodeStatus(this.value)"
      class="h-9 px-3 rounded-md border border-[#e4e4e7] bg-white text-sm text-[#09090b] focus:outline-none focus:ring-1 focus:ring-[#0655a7] w-[180px]"
    >
      <option value="all" selected>Semua Status</option>
      <option value="1">Aktif</option>
      <option value="0">Nonaktif</option>
    </select>
  </div>
</div>

<!-- Tabel Periode Ajaran (Sesuai DataTable di fakultas-fe) -->
<div class="rounded-lg border border-[#e4e4e7] overflow-hidden bg-white mt-4">
  <table class="w-full text-sm">
    <thead class="border-b border-[#e4e4e7] bg-[#fafafa]">
      <tr>
        <th class="h-11 px-4 font-medium text-sm text-left text-[#71717a]">Kode Periode</th>
        <th class="h-11 px-4 font-medium text-sm text-left text-[#71717a]">Tahun Ajaran</th>
        <th class="h-11 px-4 font-medium text-sm text-left text-[#71717a]">Tanggal Mulai MBKM</th>
        <th class="h-11 px-4 font-medium text-sm text-left text-[#71717a]">Tanggal Akhir MBKM</th>
        <th class="h-11 px-4 font-medium text-sm text-center text-[#71717a]">Status</th>
        <th class="h-11 px-4 font-medium text-sm w-20 text-center text-[#71717a]">Aksi</th>
      </tr>
    </thead>
    <tbody id="periode-table-tbody" class="divide-y divide-[#e4e4e7]">
      <!-- Populated dynamically via renderPeriodeData() -->
    </tbody>
  </table>
</div>

<!-- Pagination Footer (Page 1 of 9 (82 total items) - Persis Screenshot) -->
<div class="pt-4 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-[#71717a]">
  <div id="periode-table-info">Page 1 of 9 (82 total items)</div>
  <div class="flex items-center gap-3">
    <div id="periode-pagination-controls" class="flex items-center gap-1"></div>
    <select
      id="periode-per-page"
      onchange="handlePeriodePerPageChange(this.value)"
      class="h-8 px-2 text-xs rounded-md border border-[#e4e4e7] bg-white text-[#09090b] focus:outline-none"
    >
      <option value="10" selected>Show 10 items</option>
      <option value="20">Show 20 items</option>
      <option value="50">Show 50 items</option>
    </select>
  </div>
</div>

  </section>
</AdminShell>
