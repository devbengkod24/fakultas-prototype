---
import AdminShell from '../../layouts/AdminShell.astro';
---

<AdminShell currentTab="periode">
  <section
    id="section-periode"
    class="flex flex-col flex-1 min-h-0 gap-4 pr-1 overflow-y-auto tab-content"
  >
<!-- Top Toolbar: Button Sync Data & Filter Status (Sesuai Screenshot bimbingan-karir/periode-ajaran) -->
<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
  <div>
    <button
      type="button"
      onclick="handleSyncPeriodeData()"
      class="inline-flex items-center justify-center gap-2 h-9 px-4 text-xs font-semibold rounded-md bg-[#0655a7] hover:bg-[#114D91] text-white shadow-none transition-colors cursor-pointer"
      id="btn-sync-periode"
    >
      <i data-lucide="refresh-cw" class="w-4 h-4" id="icon-sync-periode"></i>
      <span id="btn-sync-text">Sync Data</span>
    </button>
  </div>

  <div class="flex items-center gap-2">
    <span class="text-xs font-semibold text-[#09090b]">Status:</span>
    <select
      id="filter-periode-status"
      onchange="handleFilterPeriodeStatus(this.value)"
      class="h-9 px-3 rounded-md border border-[#e4e4e7] bg-white text-xs text-[#09090b] focus:outline-none focus:ring-1 focus:ring-[#0655a7] w-[180px] cursor-pointer"
    >
      <option value="all" selected>Semua Status</option>
      <option value="1">Aktif</option>
      <option value="0">Nonaktif</option>
    </select>
  </div>
</div>

<!-- Tabel Periode Ajaran (Sesuai DataTable di fakultas-fe) -->
<div class="rounded-lg border border-[#e4e4e7] overflow-hidden bg-white mt-4">
  <table class="w-full text-sm">
    <thead class="border-b border-[#e4e4e7] bg-[#fafafa]">
      <tr>
        <th class="h-11 px-4 font-semibold text-xs w-12 text-center text-[#71717a]">No.</th>
        <th class="h-11 px-4 font-semibold text-xs text-left text-[#71717a]">Kode Periode</th>
        <th class="h-11 px-4 font-semibold text-xs text-left text-[#71717a]">Tahun Ajaran</th>
        <th class="h-11 px-4 font-semibold text-xs text-left text-[#71717a]">Tanggal Mulai MBKM</th>
        <th class="h-11 px-4 font-semibold text-xs text-left text-[#71717a]">Tanggal Akhir MBKM</th>
        <th class="h-11 px-4 font-semibold text-xs text-center text-[#71717a]">Status</th>
        <th class="h-11 px-4 font-semibold text-xs w-20 text-center text-[#71717a]">Aksi</th>
      </tr>
    </thead>
    <tbody id="periode-table-tbody" class="divide-y divide-[#e4e4e7]">
      <!-- Populated dynamically via renderPeriodeData() -->
    </tbody>
  </table>
</div>

<!-- Standardized Pagination Sesuai Screenshot 1 & Design System -->
<div class="flex flex-col sm:flex-row items-center justify-between gap-2 pt-1">
  <div id="periode-table-info" class="text-xs text-[#71717a]">Menampilkan 1 - 10 dari 82 data</div>
  <div class="flex items-center gap-1.5">
    <div id="periode-pagination-controls" class="flex items-center gap-1.5"></div>
    <select
      id="periode-per-page"
      onchange="handlePeriodePerPageChange(this.value)"
      class="h-8 rounded-md border border-[#e4e4e7] bg-white px-2 text-xs text-[#09090b] focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
    >
      <option value="5">Show 5 items</option>
      <option value="10" selected>Show 10 items</option>
      <option value="25">Show 25 items</option>
      <option value="50">Show 50 items</option>
    </select>
  </div>
</div>

  </section>
</AdminShell>
