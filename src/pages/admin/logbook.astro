---
// src/pages/admin/logbook.astro
import AdminShell from '../../layouts/AdminShell.astro';
---

<AdminShell currentTab="logbook">
  <section
    id="section-logbook"
    class="flex flex-col flex-1 min-h-0 gap-4 pr-1 overflow-y-auto tab-content"
    x-data="{
      viewMode: 'master', // 'master' or 'detail'
      searchQuery: '',
      selectedDosen: null,
      currentPage: 1,
      pageSize: 10,
      dosenList: [
        { id: 1,  nama: 'EDY MULYANTO',            npp: '0686.11.1993.040', bab1: 0, bab2: 0, bab3: 0, bab4: 0, bab5: 0, pending: 0, totalMhs: 2 },
        { id: 2,  nama: 'ERLIN DOLPHINA',          npp: '0686.11.1994.047', bab1: 0, bab2: 0, bab3: 0, bab4: 0, bab5: 0, pending: 0, totalMhs: 4 },
        { id: 3,  nama: 'EDI FAISAL',              npp: '0686.11.1994.057', bab1: 0, bab2: 0, bab3: 0, bab4: 0, bab5: 0, pending: 0, totalMhs: 1 },
        { id: 4,  nama: 'ACHMAD WAHID KURNIAWAN',  npp: '0686.11.1995.067', bab1: 0, bab2: 0, bab3: 0, bab4: 0, bab5: 0, pending: 0, totalMhs: 2 },
        { id: 5,  nama: 'ARIPIN',                  npp: '0686.11.1995.068', bab1: 0, bab2: 0, bab3: 0, bab4: 0, bab5: 0, pending: 0, totalMhs: 2 },
        { id: 6,  nama: 'AYU PERTIWI',             npp: '0686.11.1995.069', bab1: 0, bab2: 0, bab3: 0, bab4: 0, bab5: 0, pending: 0, totalMhs: 2 },
        { id: 7,  nama: 'NOVA RIJATI',             npp: '0686.11.1996.093', bab1: 0, bab2: 0, bab3: 0, bab4: 0, bab5: 0, pending: 0, totalMhs: 1 },
        { id: 8,  nama: 'T. SUTOJO',               npp: '0686.11.1996.094', bab1: 0, bab2: 0, bab3: 0, bab4: 0, bab5: 0, pending: 0, totalMhs: 3 },
        { id: 9,  nama: 'HERU LESTIAWAN',          npp: '0686.11.1996.097', bab1: 0, bab2: 0, bab3: 0, bab4: 0, bab5: 0, pending: 0, totalMhs: 2 },
        { id: 10, nama: 'USMAN SUDIBYO',           npp: '0686.11.1996.100', bab1: 0, bab2: 0, bab3: 0, bab4: 0, bab5: 0, pending: 0, totalMhs: 3 },
      ],
      get filteredDosen() {
        const q = (this.searchQuery || '').toLowerCase();
        return this.dosenList.filter(d => d.nama.toLowerCase().includes(q) || d.npp.includes(q));
      },
      get totalPages() {
        return Math.max(1, Math.ceil(this.filteredDosen.length / this.pageSize));
      },
      get paginatedDosen() {
        const start = (this.currentPage - 1) * this.pageSize;
        return this.filteredDosen.slice(start, start + this.pageSize);
      },
      studentDetails: [
        { no: 1, nama: 'Faisal Rahman', nim: 'A11.2022.13901', babTerakhir: 'Bab 4', totalBimbingan: 12, progress: 80, status: 'Aktif' },
        { no: 2, nama: 'Tarissa Aura Azzahra', nim: 'A11.2020.13158', babTerakhir: 'Bab 5', totalBimbingan: 16, progress: 100, status: 'Siap Sidang' },
        { no: 3, nama: 'Nabila Zahra Putri', nim: 'A12.2022.09842', babTerakhir: 'Bab 3', totalBimbingan: 9, progress: 60, status: 'Aktif' },
        { no: 4, nama: 'Rizky Aditya Pratama', nim: 'A11.2022.14012', babTerakhir: 'Bab 4', totalBimbingan: 11, progress: 75, status: 'Aktif' },
      ],
      openDetail(dosen) {
        this.selectedDosen = dosen;
        this.viewMode = 'detail';
      },
      backToMaster() {
        this.selectedDosen = null;
        this.viewMode = 'master';
      }
    }"
  >
    <!-- View 1: Master Rekap Dospem Style KP -->
    <div x-show="viewMode === 'master'" class="flex flex-col gap-4">
      <!-- Toolbar Filter & Search -->
      <div class="flex flex-col md:flex-row gap-3 items-start md:items-center justify-between">
        <div class="relative w-full sm:w-72 md:w-80">
          <i data-lucide="search" class="w-4 h-4 text-[#71717a] absolute left-3 top-1/2 -translate-y-1/2"></i>
          <input
            type="text"
            x-model="searchQuery"
            placeholder="Cari dosen pembimbing..."
            class="h-9 w-full rounded-md border border-[#e4e4e7] bg-white pl-9 pr-3 text-sm text-[#09090b] placeholder:text-[#71717a] focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
          />
        </div>
      </div>

      <!-- Tabel Master 10 Kolom Style KP -->
      <div class="rounded-lg border border-[#e4e4e7] overflow-hidden bg-white">
        <table class="w-full text-sm">
          <thead class="border-b border-[#e4e4e7] bg-[#fafafa]">
            <tr>
              <th class="h-11 px-4 font-semibold text-xs w-12 text-center text-[#71717a]">No.</th>
              <th class="h-11 px-4 font-semibold text-xs text-left text-[#71717a]">Nama Dosen Pembimbing</th>
              <th class="h-11 px-4 font-semibold text-xs text-center text-[#71717a]">Logbook Mhs.</th>
              <th class="h-11 px-4 font-semibold text-xs text-center text-[#71717a]">Bab 1</th>
              <th class="h-11 px-4 font-semibold text-xs text-center text-[#71717a]">Bab 2</th>
              <th class="h-11 px-4 font-semibold text-xs text-center text-[#71717a]">Bab 3</th>
              <th class="h-11 px-4 font-semibold text-xs text-center text-[#71717a]">Bab 4</th>
              <th class="h-11 px-4 font-semibold text-xs text-center text-[#71717a]">Bab 5</th>
              <th class="h-11 px-4 font-semibold text-xs text-center text-[#71717a]">Pending</th>
              <th class="h-11 px-4 font-semibold text-xs text-center text-[#71717a]">Total Mhs.</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#e4e4e7]">
            <template x-for="(dosen, idx) in paginatedDosen" :key="dosen.id">
              <tr class="hover:bg-[#f4f4f5]/60 transition-colors">
                <td class="h-[68px] px-2 text-center text-xs font-medium text-[#71717a] w-12" x-text="((currentPage - 1) * pageSize) + (idx + 1)"></td>
                <td class="h-[68px] px-4 text-sm">
                  <div class="flex flex-col leading-tight gap-0.5">
                    <span class="font-semibold text-[#09090b] text-sm" x-text="dosen.nama"></span>
                    <span class="text-xs text-[#71717a]" x-text="dosen.npp"></span>
                  </div>
                </td>
                <td class="h-[68px] px-4 text-center text-sm">
                  <button
                    type="button"
                    @click="openDetail(dosen)"
                    class="inline-flex items-center gap-2 h-8 px-3 rounded-md border border-[#0655a7]/40 bg-white hover:bg-blue-50/40 text-[#0655a7] text-xs font-medium transition-colors"
                  >
                    <span>Detail Logbook</span>
                    <i data-lucide="external-link" class="w-3.5 h-3.5"></i>
                  </button>
                </td>
                <td class="h-[68px] px-4 text-center text-sm text-[#09090b]" x-text="dosen.bab1"></td>
                <td class="h-[68px] px-4 text-center text-sm text-[#09090b]" x-text="dosen.bab2"></td>
                <td class="h-[68px] px-4 text-center text-sm text-[#09090b]" x-text="dosen.bab3"></td>
                <td class="h-[68px] px-4 text-center text-sm text-[#09090b]" x-text="dosen.bab4"></td>
                <td class="h-[68px] px-4 text-center text-sm text-[#09090b]" x-text="dosen.bab5"></td>
                <td class="h-[68px] px-4 text-center text-sm">
                  <template x-if="dosen.pending > 0">
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-xs font-semibold bg-amber-50 border border-amber-200 text-amber-800" x-text="dosen.pending"></span>
                  </template>
                  <template x-if="dosen.pending === 0">
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-xs font-medium bg-[#f4f4f5] border border-[#e4e4e7] text-[#71717a]">Belum Ada</span>
                  </template>
                </td>
                <td class="h-[68px] px-4 text-center text-sm font-semibold text-[#09090b]" x-text="dosen.totalMhs"></td>
              </tr>
            </template>
            <template x-if="paginatedDosen.length === 0">
              <tr>
                <td colspan="10" class="h-28 text-center text-xs text-[#71717a]">
                  Tidak ada data dosen pembimbing yang cocok dengan kriteria pencarian.
                </td>
              </tr>
            </template>
          </tbody>
        </table>
      </div>

      <!-- Standardized Pagination Sesuai Screenshot 1 & Design System -->
      <div class="flex flex-col sm:flex-row items-center justify-between gap-2 pt-1">
        <div class="text-xs text-[#71717a]" x-text="'Menampilkan ' + (filteredDosen.length === 0 ? 0 : ((currentPage - 1) * pageSize + 1)) + ' - ' + Math.min(currentPage * pageSize, filteredDosen.length) + ' dari ' + filteredDosen.length + ' data'"></div>
        <div class="flex items-center gap-1.5">
          <button
            type="button"
            @click="if (currentPage > 1) currentPage--"
            :disabled="currentPage <= 1"
            :class="currentPage <= 1 ? 'opacity-50 cursor-not-allowed hover:bg-white text-[#71717a]' : 'hover:bg-[#f4f4f5] text-[#09090b]'"
            class="h-8 w-8 flex items-center justify-center rounded-md border border-[#e4e4e7] bg-white text-xs transition-colors"
            title="Halaman Sebelumnya"
          >
            <i data-lucide="chevron-left" class="w-4 h-4"></i>
          </button>

          <template x-for="p in totalPages" :key="p">
            <button
              type="button"
              @click="currentPage = p"
              :class="currentPage === p ? 'bg-[#0655a7] text-white font-semibold shadow-none' : 'border border-[#e4e4e7] bg-white text-[#09090b] font-medium hover:bg-[#f4f4f5]'"
              class="h-8 w-8 flex items-center justify-center rounded-md text-xs transition-colors"
              x-text="p"
            ></button>
          </template>

          <button
            type="button"
            @click="if (currentPage < totalPages) currentPage++"
            :disabled="currentPage >= totalPages"
            :class="currentPage >= totalPages ? 'opacity-50 cursor-not-allowed hover:bg-white text-[#71717a]' : 'hover:bg-[#f4f4f5] text-[#09090b]'"
            class="h-8 w-8 flex items-center justify-center rounded-md border border-[#e4e4e7] bg-white text-xs transition-colors"
            title="Halaman Selanjutnya"
          >
            <i data-lucide="chevron-right" class="w-4 h-4"></i>
          </button>

          <select
            x-model.number="pageSize"
            @change="currentPage = 1"
            class="h-8 rounded-md border border-[#e4e4e7] bg-white px-2 text-xs text-[#09090b] focus:outline-none focus:ring-1 focus:ring-[#0655a7]"
          >
            <option value="5">Show 5 items</option>
            <option value="10">Show 10 items</option>
            <option value="25">Show 25 items</option>
            <option value="50">Show 50 items</option>
          </select>
        </div>
      </div>
    </div>

    <!-- View 2: Detail Mahasiswa Bimbingan per Dospem Style KP -->
    <div x-show="viewMode === 'detail'" class="flex flex-col gap-4" x-cloak>
      <div class="flex items-center justify-between pb-3 border-b border-[#e4e4e7]">
        <div class="flex items-center gap-3">
          <button
            type="button"
            @click="backToMaster()"
            class="h-8 w-8 rounded-md border border-[#e4e4e7] bg-white hover:bg-[#f4f4f5] text-[#71717a] flex items-center justify-center"
            title="Kembali ke Rekap Dosen"
          >
            <i data-lucide="arrow-left" class="w-4 h-4"></i>
          </button>
          <div>
            <h2 class="text-base font-semibold text-[#09090b]" x-text="`Daftar Logbook Mahasiswa Binaan: ${selectedDosen?.nama || ''}`"></h2>
            <p class="text-xs text-[#71717a]" x-text="`NPP: ${selectedDosen?.npp || '-'} • Total ${selectedDosen?.totalMhs || 0} Mahasiswa Binaan`"></p>
          </div>
        </div>
        <button
          type="button"
          @click="backToMaster()"
          class="px-3 py-1.5 rounded-md border border-[#e4e4e7] bg-white text-xs font-medium text-[#71717a] hover:bg-[#f4f4f5] flex items-center gap-1.5"
        >
          <i data-lucide="x" class="w-3.5 h-3.5"></i>
          <span>Tutup Detail</span>
        </button>
      </div>

      <!-- Tabel Detail 8 Kolom Style KP -->
      <div class="rounded-lg border border-[#e4e4e7] overflow-hidden bg-white">
        <table class="w-full text-sm">
          <thead class="border-b border-[#e4e4e7] bg-[#fafafa]">
            <tr>
              <th class="h-11 px-4 font-semibold text-xs w-12 text-center text-[#71717a]">No.</th>
              <th class="h-11 px-4 font-semibold text-xs text-left text-[#71717a]">Mahasiswa</th>
              <th class="h-11 px-4 font-semibold text-xs text-center text-[#71717a]">NIM</th>
              <th class="h-11 px-4 font-semibold text-xs text-center text-[#71717a]">Bab Terakhir</th>
              <th class="h-11 px-4 font-semibold text-xs text-center text-[#71717a]">Total Bimbingan</th>
              <th class="h-11 px-4 font-semibold text-xs text-center text-[#71717a]">Progress</th>
              <th class="h-11 px-4 font-semibold text-xs text-center text-[#71717a]">Status</th>
              <th class="h-11 px-4 font-semibold text-xs w-24 text-center text-[#71717a]">Aksi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#e4e4e7]">
            <template x-for="(m, idx) in studentDetails" :key="m.nim">
              <tr class="hover:bg-[#f4f4f5]/60 transition-colors">
                <td class="h-[68px] px-2 text-center text-xs font-medium text-[#71717a] w-12" x-text="idx + 1"></td>
                <td class="h-[68px] px-4 text-sm">
                  <div class="flex items-center gap-3">
                    <div class="h-9 w-9 rounded-full bg-[#f4f4f5] text-[#0655a7] font-semibold text-xs flex items-center justify-center shrink-0 border border-[#e4e4e7]">
                      <span x-text="m.nama.charAt(0)"></span>
                    </div>
                    <span class="font-semibold text-[#09090b] text-sm" x-text="m.nama"></span>
                  </div>
                </td>
                <td class="h-[68px] px-4 text-center text-xs text-[#71717a]" x-text="m.nim"></td>
                <td class="h-[68px] px-4 text-center text-sm">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-xs font-semibold bg-blue-50 border border-blue-200 text-[#0655a7]" x-text="m.babTerakhir"></span>
                </td>
                <td class="h-[68px] px-4 text-center font-medium text-sm text-[#09090b]" x-text="`${m.totalBimbingan} kali`"></td>
                <td class="h-[68px] px-4 text-sm">
                  <div class="flex items-center gap-2">
                    <div class="flex-1 h-2 rounded-full bg-[#f4f4f5] overflow-hidden">
                      <div class="h-full bg-[#0655a7] rounded-full" :style="`width: ${m.progress}%`"></div>
                    </div>
                    <span class="text-xs font-medium text-[#71717a]" x-text="`${m.progress}%`"></span>
                  </div>
                </td>
                <td class="h-[68px] px-4 text-center text-sm">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-xs font-semibold bg-emerald-50 border border-emerald-200 text-emerald-800" x-text="m.status"></span>
                </td>
                <td class="h-[68px] px-4 text-center text-sm">
                  <button
                    type="button"
                    @click="alert(`Menampilkan rincian entri logbook mahasiswa ${m.nama}`)"
                    class="h-8 px-3 rounded-md border border-[#e4e4e7] bg-white hover:bg-[#f4f4f5] text-xs font-medium text-[#0655a7] transition-colors"
                  >
                    Rincian
                  </button>
                </td>
              </tr>
            </template>
          </tbody>
        </table>
      </div>
    </div>
  </section>
</AdminShell>
