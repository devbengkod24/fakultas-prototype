---
import LandingNavbar from '../components/landing/LandingNavbar.astro';
import LandingHero from '../components/landing/LandingHero.astro';
import LandingStats from '../components/landing/LandingStats.astro';
import LandingSambutanDekan from '../components/landing/LandingSambutanDekan.astro';
import LandingProgramStudi from '../components/landing/LandingProgramStudi.astro';
import LandingBeritaKegiatan from '../components/landing/LandingBeritaKegiatan.astro';
import LandingFasilitasAlumni from '../components/landing/LandingFasilitasAlumni.astro';
import LandingSubPages from '../components/landing/LandingSubPages.astro';
import LandingProdiDedicated from '../components/landing/LandingProdiDedicated.astro';
import LandingFooter from '../components/landing/LandingFooter.astro';
import LandingModals from '../components/landing/LandingModals.astro';
import LandingScripts from '../components/landing/LandingScripts.astro';
---

<!DOCTYPE html>
<html lang="id" class="scroll-smooth intro">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#083460" />
    <title>Fakultas Teknologi Cerdas (FTC) — Universitas Dian Nuswantoro</title>

    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
        href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;600;700&family=Poppins:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet" />
    <script is:inline src="https://unpkg.com/lucide@latest"></script>

    <!--
    =====================================================================
    PANDUAN MIGRASI KE NEXT.JS + TAILWIND CSS + SHADCN/UI + LUCIDE-REACT
    =====================================================================
    1. Variabel warna menggunakan format HSL Shadcn di :root
    2. Kapsul Section Header (.section-capsule) menggunakan desain
       kapsul biru tua + dot kuning sesuai identitas pilihan.
    3. Dot-matrix pattern (.bg-dot-matrix) & Blended Grid (.bg-grid-blend)
       menggunakan pure CSS tanpa tabrakan dengan class warna Tailwind.

    DAFTAR MICRO-INTERAKSI (untuk referensi saat migrasi ke React):
    - Hero: entrance berurutan sekali saat load, crossfade slider, pause saat hover, swipe di HP
    - Statistik: count-up saat terlihat di layar
    - Tab Prodi / filter Kegiatan / Publikasi: kartu muncul bertahap saat konten berganti
    - Carousel berita: fade antar slide, indikator animasi, swipe di HP
    - Navbar: bayangan muncul saat scroll, progress bar scroll, menu mobile membuka halus
    - Tombol: feedback tekan, panah bergeser saat hover
    - Gambar: fade-in setelah dimuat (+ lazy loading)
    - Salin tautan: ikon berubah + toast
    - Tombol "kembali ke atas" muncul setelah scroll
    - Semua animasi mati otomatis jika user mengaktifkan "reduce motion"
    =====================================================================
  -->

    <script is:inline>
        tailwind.config = {
            theme: {
                container: {
                    center: true,
                    padding: { DEFAULT: '1rem', sm: '1.5rem', lg: '2rem' },
                    screens: { '2xl': '1280px' },
                },
                extend: {
                    fontFamily: {
                        sans: ['"Poppins"', 'system-ui', '-apple-system', 'sans-serif'],
                        mono: ['"JetBrains Mono"', 'monospace'],
                    },
                    colors: {
                        border: 'hsl(var(--border) / <alpha-value>)',
                        input: 'hsl(var(--input) / <alpha-value>)',
                        ring: 'hsl(var(--ring) / <alpha-value>)',
                        background: 'hsl(var(--background) / <alpha-value>)',
                        foreground: 'hsl(var(--foreground) / <alpha-value>)',
                        primary: {
                            DEFAULT: 'hsl(var(--primary) / <alpha-value>)',
                            foreground: 'hsl(var(--primary-foreground) / <alpha-value>)',
                        },
                        secondary: {
                            DEFAULT: 'hsl(var(--secondary) / <alpha-value>)',
                            foreground: 'hsl(var(--secondary-foreground) / <alpha-value>)',
                        },
                        muted: {
                            DEFAULT: 'hsl(var(--muted) / <alpha-value>)',
                            foreground: 'hsl(var(--muted-foreground) / <alpha-value>)',
                        },
                        accent: {
                            DEFAULT: 'hsl(var(--accent) / <alpha-value>)',
                            foreground: 'hsl(var(--accent-foreground) / <alpha-value>)',
                        },
                        card: {
                            DEFAULT: 'hsl(var(--card) / <alpha-value>)',
                            foreground: 'hsl(var(--card-foreground) / <alpha-value>)',
                        },
                        info: 'hsl(var(--info) / <alpha-value>)',
                        gold: {
                            DEFAULT: 'hsl(var(--gold) / <alpha-value>)',
                            foreground: 'hsl(var(--gold-foreground) / <alpha-value>)',
                        },
                        deep: 'hsl(var(--deep) / <alpha-value>)',
                    },
                    borderRadius: {
                        xl: 'calc(var(--radius) + 4px)',
                        lg: 'var(--radius)',
                        md: 'calc(var(--radius) - 2px)',
                        sm: 'calc(var(--radius) - 4px)',
                    },
                },
            },
        }
    </script>

    <style is:inline>
        :root {
            --theme-primary: #0b4d8c;
            --theme-deep: #072f57;
            --theme-soft: #e0f2fe;
            --background: 0 0% 100%;
            --foreground: 215 35% 13%;
            --card: 0 0% 100%;
            --card-foreground: 215 35% 13%;
            --primary: 212 79% 32%;
            /* #114D91 */
            --primary-foreground: 0 0% 100%;
            --secondary: 216 24% 96%;
            /* #F3F5F8 */
            --secondary-foreground: 215 35% 13%;
            --muted: 216 24% 96%;
            /* #F3F5F8 */
            --muted-foreground: 215 16% 42%;
            --accent: 214 32% 94%;
            --accent-foreground: 212 79% 32%;
            --border: 214 20% 89%;
            --input: 214 20% 89%;
            --ring: 207 88% 41%;
            --radius: 0.75rem;
            /* Custom Brand Tokens */
            --info: 207 88% 41%;
            /* #0C71C3 */
            --gold: 41 90% 57%;
            /* #F5B82E */
            --gold-foreground: 215 45% 12%;
            --deep: 211 85% 20%;
            /* #083460 - Warna kapsul & navy pekat */
        }

        html {
            -webkit-text-size-adjust: 100%;
        }

        body {
            font-family: 'Poppins', system-ui, -apple-system, sans-serif;
            /* Pengaman: cegah scroll horizontal di HP kalau ada elemen dekoratif yang keluar layar */
            overflow-x: clip;
        }

        /* 1. Dot Matrix Pattern (Untuk belakang foto Sambutan Dekan & dalam kartu Prodi) */
        .bg-dot-matrix {
            background-image: radial-gradient(rgba(17, 77, 145, 0.18) 1.5px, transparent 1.5px);
            background-size: 16px 16px;
        }

        .bg-dot-matrix-subtle {
            background-image: radial-gradient(rgba(17, 77, 145, 0.10) 1.25px, transparent 1.25px);
            background-size: 14px 14px;
        }

        /* 2. Blended Technical Grid (Untuk background section Prodi agar nge-blend halus) */
        .bg-grid-blend {
            display: none;
        }

        /* ================================================================
           MICRO-INTERAKSI & POLISH
        ================================================================ */

        /* --- Touch & fokus keyboard --- */
        button,
        a,
        [role="tab"] {
            -webkit-tap-highlight-color: transparent;
            touch-action: manipulation;
        }

        :focus-visible {
            outline: 2px solid hsl(var(--ring));
            outline-offset: 2px;
        }

        .bg-deep :focus-visible,
        .bg-primary :focus-visible,
        footer :focus-visible {
            outline-color: hsl(var(--gold));
        }

        .bg-deep .btn:focus-visible,
        .bg-primary .btn:focus-visible {
            --tw-ring-color: hsl(var(--gold));
        }

        /* --- Keyframes --- */
        @keyframes pageIn {
            from {
                opacity: 0;
            }

            to {
                opacity: 1;
            }
        }

        @keyframes rise {
            from {
                opacity: 0;
                transform: translateY(14px);
            }

            to {
                opacity: 1;
                transform: none;
            }
        }

        @keyframes pop {
            from {
                opacity: 0;
                transform: translateY(10px) scale(.985);
            }

            to {
                opacity: 1;
                transform: none;
            }
        }

        /* fill-mode "backwards" supaya efek hover (translate/scale) tidak terkunci setelah animasi selesai */
        .page-view:not(.hidden) {
            animation: pageIn .35s ease backwards;
        }

        .fade-swap {
            animation: pageIn .25s ease backwards;
        }

        .pop {
            animation: pop .4s cubic-bezier(.2, .7, .2, 1) backwards;
            animation-delay: calc(var(--i, 0) * 60ms);
        }

        /* Entrance hero: hanya sekali saat halaman pertama dibuka (class .intro dilepas via JS) */
        .intro .rise {
            animation: rise .65s cubic-bezier(.2, .7, .2, 1) backwards;
            animation-delay: calc(var(--i, 0) * 80ms);
        }

        /* --- Gambar fade-in setelah dimuat --- */
        img.img-fade {
            opacity: 0;
            transition: opacity .45s ease, transform .5s cubic-bezier(.4, 0, .2, 1);
        }

        img.img-fade.loaded {
            opacity: 1;
        }

        /* --- Slider hero & carousel berita --- */
        .hero-fade {
            transition: opacity .25s ease;
        }

        .is-out {
            opacity: 0 !important;
        }

        .news-fade {
            transition: opacity .2s ease, transform .2s ease;
        }

        .news-out .news-fade {
            opacity: 0;
            transform: translateY(6px);
        }

        /* Area sentuh dot slider diperbesar tanpa mengubah tampilan */
        .dot-hit::after {
            content: '';
            position: absolute;
            inset: -10px -4px;
        }

        /* --- Header: bayangan saat scroll, progress bar --- */
        #site-header {
            transition: box-shadow .25s ease;
        }

        #site-header.is-scrolled {
            box-shadow: 0 6px 20px -10px rgba(8, 52, 96, .35);
        }

        /* --- Menu mobile membuka halus --- */
        .mnav {
            grid-template-rows: 0fr;
            transition: grid-template-rows .3s ease;
        }

        .mnav.open {
            grid-template-rows: 1fr;
        }

        .mnav>div {
            min-height: 0;
            overflow: hidden;
            visibility: hidden;
            transition: visibility 0s linear .3s;
        }

        .mnav.open>div {
            visibility: visible;
            transition-delay: 0s;
        }

        /* --- Panah bergeser saat hover (icon Lucide jadi <svg>) --- */
        svg[class*="lucide-arrow-right"],
        svg[class*="lucide-arrow-left"],
        svg[class*="lucide-chevron-right"],
        svg[class*="lucide-arrow-up-right"] {
            transition: transform .2s cubic-bezier(.2, .7, .2, 1);
        }

        .btn:hover>svg[class*="lucide-arrow-right"],
        a:hover>svg[class*="lucide-arrow-right"],
        button:hover>svg[class*="lucide-arrow-right"],
        .group:hover svg[class*="lucide-arrow-right"],
        button:hover>svg[class*="lucide-chevron-right"] {
            transform: translateX(3px);
        }

        button:hover>svg[class*="lucide-arrow-left"] {
            transform: translateX(-3px);
        }

        .btn:hover>svg[class*="lucide-arrow-up-right"] {
            transform: translate(2px, -2px);
        }

        /* --- Kartu Inovasi terpilih (tanpa layout shift) --- */
        .inovasi-card:not(.is-active):hover {
            border-color: hsl(var(--info) / .5);
        }

        .inovasi-card.is-active {
            border-color: hsl(var(--gold));
            box-shadow: 0 0 0 1px hsl(var(--gold)), 0 1px 3px rgba(15, 23, 42, 0.03);
        }

        /* --- Hover lift (hanya perangkat dengan mouse) --- */
        @media (hover: hover) {
            .hover-lift {
                transition: transform .3s ease, box-shadow .3s ease;
            }

            .hover-lift:hover {
                transform: translateY(-4px);
            }

            .share-btn:hover {
                transform: translateY(-2px);
            }
        }

        .share-btn {
            transition: transform .2s ease, opacity .2s ease, background-color .2s ease;
        }

        .share-btn:active {
            transform: scale(.92);
        }

        /* --- Footer link --- */
        footer ul a {
            display: inline-block;
            transition: color .15s ease, transform .2s ease;
        }

        footer ul a:hover {
            transform: translateX(3px);
        }

        /* --- Kembali ke atas & toast --- */
        .to-top {
            position: fixed;
            right: 1rem;
            bottom: calc(1rem + env(safe-area-inset-bottom, 0px));
            z-index: 50;
            display: flex;
            height: 2.75rem;
            width: 2.75rem;
            align-items: center;
            justify-content: center;
            border-radius: 9999px;
            background: hsl(var(--deep));
            color: #fff;
            box-shadow: 0 8px 24px -8px rgba(8, 52, 96, .55);
            opacity: 0;
            transform: translateY(10px);
            pointer-events: none;
            transition: opacity .25s ease, transform .25s ease, background-color .2s ease;
        }

        .to-top.show {
            opacity: 1;
            transform: none;
            pointer-events: auto;
        }

        .to-top:hover {
            background: hsl(var(--primary));
        }

        .to-top:active {
            transform: scale(.92);
        }

        .toast {
            position: fixed;
            left: 50%;
            bottom: calc(1.5rem + env(safe-area-inset-bottom, 0px));
            z-index: 70;
            max-width: calc(100vw - 2rem);
            border-radius: .625rem;
            background: hsl(var(--deep));
            padding: .625rem 1rem;
            font-size: .8125rem;
            font-weight: 600;
            color: #fff;
            box-shadow: 0 12px 30px -10px rgba(8, 52, 96, .6);
            opacity: 0;
            transform: translate(-50%, 12px);
            pointer-events: none;
            transition: opacity .25s ease, transform .25s ease;
        }

        .toast.show {
            opacity: 1;
            transform: translate(-50%, 0);
        }

        .no-scrollbar {
            scrollbar-width: none;
        }

        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }

        /* --- Scroll behavior & offset untuk sticky header --- */
        html {
            scroll-behavior: smooth;
            scroll-padding-top: 80px;
        }

        /* --- Hormati preferensi "reduce motion" --- */
        @media (prefers-reduced-motion: reduce) {
            html {
                scroll-behavior: auto !important;
            }

            *,
            *::before,
            *::after {
                animation-duration: .01ms !important;
                animation-iteration-count: 1 !important;
                animation-delay: 0ms !important;
                transition-duration: .01ms !important;
            }
        }
    </style>

    <style is:inline type="text/tailwindcss">
        @layer components {
      /* ---- Shadcn Button Variants ---- */
      .btn {
        @apply inline-flex h-10 items-center justify-center gap-2 whitespace-nowrap rounded-lg px-5 text-sm font-semibold transition-all duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 active:scale-[0.97];
      }
      .btn-lg { @apply h-12 px-6 text-[15px]; }
      .btn-sm { @apply h-9 px-3.5 text-[13px]; }
      .btn-default { @apply bg-deep text-white hover:bg-primary shadow-sm hover:shadow-md; }
      .btn-gold { @apply bg-gold text-gold-foreground font-bold hover:brightness-95 shadow-sm hover:shadow-md; }
      .btn-outline { @apply border border-input bg-background text-foreground hover:bg-accent hover:text-accent-foreground; }
      .btn-outline-light { @apply border border-white/30 bg-white/5 text-white hover:bg-white/15; }

      /* ---- Shadcn Badge Variants ---- */
      .badge { @apply inline-flex items-center gap-1.5 rounded-md px-2.5 py-0.5 text-xs font-semibold transition-colors; }
      .badge-gold { @apply rounded-full bg-gold px-3 py-1 font-extrabold text-gold-foreground; }
      .badge-soft { @apply bg-primary/10 text-primary; }
      .badge-info { @apply bg-info/10 text-info; }
      .badge-outline { @apply border border-border bg-background text-muted-foreground; }

      /* ---- Shadcn Card ---- */
      .card { @apply rounded-xl border border-border bg-card text-card-foreground shadow-[0_1px_3px_rgba(15,23,42,0.03)]; }

            /* ---- Desain Baru Section Header Badge (Split-Block Badge 2 Bagian) ---- */
      .split-badge {
        @apply mb-4 inline-flex items-center rounded-lg overflow-hidden shadow-sm max-w-full;
      }
      .split-badge-left {
        @apply bg-[#f5a623] text-[#072f57] font-extrabold text-xs px-2.5 py-1.5 shrink-0 tracking-wider;
      }
      .split-badge-right {
        @apply text-white font-semibold text-xs px-3.5 py-1.5 uppercase tracking-wider shrink-0;
        background-color: var(--theme-primary, #0b4d8c);
      }

      /* ---- Legacy Section Capsule Compat ---- */
      .section-capsule {
        @apply mb-4 inline-flex max-w-full items-center gap-2.5 rounded-lg bg-deep px-3.5 py-1.5 text-xs font-bold uppercase leading-snug tracking-wider text-white shadow-sm;
      }
      .section-capsule::before {
        content: '';
        @apply h-2.5 w-2.5 shrink-0 rounded-full bg-gold;
      }
      .section-capsule-light {
        @apply mb-4 inline-flex max-w-full items-center gap-2.5 rounded-lg bg-white px-3.5 py-1.5 text-xs font-extrabold uppercase leading-snug tracking-wider text-deep shadow-sm;
      }
      .section-capsule-light::before {
        content: '';
        @apply h-2.5 w-2.5 shrink-0 rounded-full bg-gold;
      }

      /* ---- Tabs Program Studi: grid 2x2 di HP, 1 baris rapi di layar >= sm ---- */
      .prodi-tablist {
        @apply grid w-full grid-cols-2 gap-1 rounded-xl border border-slate-200/90 bg-slate-100/90 p-1.5 backdrop-blur-sm sm:inline-flex sm:w-auto sm:flex-nowrap sm:items-center;
      }
      .prodi-trigger {
        @apply whitespace-nowrap rounded-lg px-3 py-2 text-center text-xs sm:px-4 sm:text-sm font-semibold text-slate-600 transition-all hover:text-deep active:scale-[0.97];
      }
      .prodi-trigger[data-state="active"] {
        @apply bg-deep font-bold text-white shadow-sm hover:text-white;
      }

      /* ---- Sub-tab Inovasi & tab Publikasi ---- */
      .inovasi-subtab {
        @apply shrink-0 whitespace-nowrap border-b-2 border-transparent px-4 py-3.5 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground sm:px-5;
      }
      .inovasi-subtab[aria-selected="true"] { @apply border-primary font-bold text-primary hover:text-primary; }
      .pub-tab {
        @apply rounded-md py-2 text-xs font-semibold text-muted-foreground transition hover:text-foreground;
      }
      .pub-tab[aria-selected="true"] { @apply bg-deep font-bold text-white shadow-sm hover:text-white; }

      /* ---- Filter Pills ---- */
      .pill { @apply inline-flex items-center gap-1.5 rounded-full border border-border bg-background px-4 py-1.5 text-sm font-medium text-muted-foreground transition-all hover:border-primary/40 hover:text-primary active:scale-[0.96]; }
      .pill[data-state="active"] { @apply border-gold bg-gold font-bold text-gold-foreground shadow-sm; }

      /* ---- Navigation Link ---- */
      .nav-link { @apply rounded-lg px-3.5 py-2 text-sm font-medium text-slate-600 transition-colors hover:bg-accent hover:text-primary active:scale-[0.97]; }
      .nav-link[data-active="true"] { @apply bg-accent/80 font-bold text-primary; }

      /* Dedicated style untuk navbar Prodi saat scrollspy aktif */
      #prodi-site-header .nav-link {
        transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
      }
      #prodi-site-header .nav-link[data-active="true"] {
        background-color: var(--theme-soft, #e1f0fc) !important;
        color: var(--theme-deep, #033863) !important;
        font-weight: 700 !important;
        box-shadow: 0 1px 2px rgba(3, 56, 99, 0.08);
      }
      #prodi-mobile-nav .nav-link[data-active="true"] {
        background-color: var(--theme-soft, #e1f0fc) !important;
        color: var(--theme-deep, #033863) !important;
        font-weight: 700 !important;
        border-left: 3px solid var(--theme-primary, #02569b);
      }

      /* ---- Section Typography ---- */
      .section-title { @apply text-3xl font-extrabold tracking-tight text-deep sm:text-[38px] sm:leading-[1.15]; }
      .section-desc { @apply mt-3 max-w-2xl text-[15px] leading-relaxed text-muted-foreground; }
    }

    /* ---- Alumni Marquee Ticker ---- */
    @keyframes alumniScroll {
      0% {
        transform: translate3d(0, 0, 0);
      }
      100% {
        transform: translate3d(-50%, 0, 0);
      }
    }

    .alumni-marquee-container {
      position: relative;
      width: 100%;
      overflow: hidden;
      padding-top: 0.5rem;
      padding-bottom: 1.5rem;
      -webkit-mask-image: linear-gradient(to right, transparent 0%, black 6%, black 94%, transparent 100%);
      mask-image: linear-gradient(to right, transparent 0%, black 6%, black 94%, transparent 100%);
    }

    .alumni-marquee-track {
      display: flex;
      width: max-content;
      gap: 1.5rem;
      animation: alumniScroll 45s linear infinite;
      will-change: transform;
    }

    .alumni-marquee-track:hover {
      animation-play-state: paused;
    }
  </style>

</head>
<body class="bg-background text-foreground antialiased selection:bg-gold selection:text-deep">
    <LandingNavbar />
    
    <!-- VIEW 1: BERANDA (LANDING PAGE UTAMA) -->
    <main id="page-beranda" class="page-view">
        <LandingHero />
        <LandingStats />
        <LandingSambutanDekan />
        <LandingProgramStudi />
        <LandingBeritaKegiatan />
        <LandingFasilitasAlumni />
    </main>

    <!-- VIEW 2: SUB-HALAMAN PROFIL, KEUNGGULAN, INOVASI, PUBLIKASI, PENGUMUMAN, BERITA, DETAIL -->
    <LandingSubPages />

    <!-- VIEW BARU: LANDING PAGE PRODI MULTI-TENANT -->
    <LandingProdiDedicated />

    <!-- FOOTER FAKULTAS -->
    <LandingFooter />

    <!-- MODALS & FLOATING WIDGETS -->
    <LandingModals />

    <!-- INTERACTIVE SCRIPTS -->
    <LandingScripts />
</body>
</html>
