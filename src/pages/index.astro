---
import LandingNavbar from '../components/landing/LandingNavbar.astro';
import LandingHero from '../components/landing/LandingHero.astro';
import LandingBeritaKegiatan from '../components/landing/LandingBeritaKegiatan.astro';
import LandingSambutanDekan from '../components/landing/LandingSambutanDekan.astro';
import LandingProgramStudi from '../components/landing/LandingProgramStudi.astro';
import LandingFooter from '../components/landing/LandingFooter.astro';
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      tailwind = {
        config: {
          corePlugins: { preflight: false },
          theme: {
            extend: {
              fontFamily: { sans: ['Inter', 'system-ui', '-apple-system', 'sans-serif'] },
              colors: {
                primary: {
                  50: '#F1F7FE', 100: '#E2EEFC', 200: '#BFDBF8', 300: '#86BEF3', 400: '#1E7FD9',
                  500: '#1E7FD9', 600: '#1063B9', 700: '#114D91', 800: '#10447C', 900: '#133A67', 950: '#0D2544',
                },
                secondary: {
                  50: '#FEFAEC', 100: '#FCEEC9', 200: '#F8DB8F', 300: '#F4BD45', 400: '#F2AB2D', 500: '#F3BC45', 600: '#D0670F',
                }
              }
            }
          }
        }
      };
    </script>
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <script is:inline src="https://unpkg.com/lucide@latest"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter%3Aital%2Cwght%400%2C100..900%3B1%2C100..900&display=swap" rel="stylesheet" />
    <style is:global>
      *, ::before, ::after { box-sizing: border-box; }
      body { margin: 0; min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: flex-start; }
      html, body { margin: 0; padding: 0; width: 100%; overflow-x: hidden; background-color: #ffffffff; }
      a { text-decoration: none; }
      [data-pencil-name="Frame"] { transform-origin: top center; }
    </style>
  </head>
  <body style="background-color: #ffffffff">
    <div data-pencil-name="Frame" class="box-border w-[1920px] h-[5855.266px] opacity-[100] bg-[#ffffffff] relative">
      <div data-pencil-name="FIK UDINUS Main Page Container" class="box-border w-[1920px] h-[5855.266px] opacity-[100] absolute left-0 top-0 bg-[#ffffffff] [z-index:0]">
        <LandingHero />
        <LandingSambutanDekan />
        <LandingProgramStudi />
        <LandingFooter />
      </div>
      <LandingBeritaKegiatan />
      <LandingNavbar />
    </div>
    <script is:inline>
      (function () {
        function autoScale() {
          const frame = document.querySelector('[data-pencil-name="Frame"]');
          if (!frame) return;
          const vw = document.documentElement.clientWidth || window.innerWidth;
          if (vw < 1920) {
            const scale = vw / 1920;
            if ('zoom' in frame.style) { frame.style.zoom = scale; }
            else { frame.style.transformOrigin = 'top left'; frame.style.transform = 'scale(' + scale + ')'; document.body.style.height = (5855.266 * scale) + 'px'; }
          } else {
            if ('zoom' in frame.style) { frame.style.zoom = '1'; }
            else { frame.style.transform = 'none'; document.body.style.height = 'auto'; }
          }
        }
        window.addEventListener('resize', autoScale);
        window.addEventListener('orientationchange', autoScale);
        document.addEventListener('DOMContentLoaded', autoScale);
        autoScale();
      })();
      if (typeof lucide !== 'undefined') lucide.createIcons();
    </script>
  </body>
</html>
